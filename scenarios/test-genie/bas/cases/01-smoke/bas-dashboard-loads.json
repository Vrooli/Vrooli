{
  "metadata": {
    "name": "test-genie-dashboard-loads",
    "description": "Observer smoke workflow for the Test Genie dashboard. It opens the live scenario and asserts the dashboard header so the delegated workflow phase has executable self-check evidence.",
    "requirement": "TESTGENIE-ORCH-P0",
    "labels": {
      "reset": "none",
      "purpose": "operator-ui-smoke"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "test-genie",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open Test Genie dashboard"
        }
      }
    },
    {
      "id": "assert-page-loaded",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/dashboard.header",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "stringValue": "Test Genie"
          },
          "case_sensitive": true,
          "timeout_ms": 10000,
          "failure_message": "Test Genie dashboard header did not render"
        },
        "metadata": {
          "label": "Dashboard header visible"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-dashboard",
      "target": "assert-page-loaded",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
