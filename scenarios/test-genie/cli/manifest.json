{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "test-genie",
  "description": "Authoritative CLI contract for Test Genie. Normal Connect-RPC commands are declared here; durable or streaming lifecycle commands are declared in exceptions[] until they can be represented by a normal primitive.",
  "groups": [
    {
      "name": "runtime-root",
      "description": "Scenario-local compatibility and operator commands exposed at the CLI root",
      "flat": true,
      "commands": [
        {"name":"evidence-cutover","description":"Plan or confirmation-gate one offline evidence and SQLite archive or rebuild","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["filesystem:read","filesystem:write"]}},
        {"name":"run-tests","description":"Trigger the scenario-local test runner","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"registry","description":"Manage playbook registries","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["filesystem:read"]}},
        {"name":"requirements","description":"Inspect and sync scenario requirements","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["filesystem:read"]}},
        {"name":"provider-contract","description":"Validate provider maturity assessment contracts","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["filesystem:read"]}},
        {"name":"health","description":"Show Test Genie self-health","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"phases","description":"Inspect phase catalog, applicability, and execution plans","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"fleet","description":"Show fleet-wide health over stored runs","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"playbooks-seed","description":"Manage the playbooks seed lifecycle","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"space","description":"Emit the validation coverage-space denominator","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true}}
      ]
    },
    {
      "name": "runs",
      "description": "Inspect and manage recorded and live Test Genie runs",
      "commands": [
        {
          "name": "list",
          "description": "List recorded test runs",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "status",
              "description": "Optional run status filter"
            },
            {
              "name": "limit",
              "description": "Maximum runs to return"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "ListRuns"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "semantics": {
            "kind": "query",
            "verdict": {
              "path": "runs",
              "pass": "nonempty",
              "fail": "empty"
            }
          }
        },
        {
          "name": "show",
          "description": "Show one recorded test run",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetRun"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "semantics": {
            "kind": "verify",
            "verdict": {
              "path": "status",
              "pass": "passed",
              "fail": "failed"
            }
          }
        },
        {
          "name": "delete",
          "description": "Delete a recorded test run",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "force",
              "bool": true,
              "description": "Delete even if pinned"
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "DeleteRun"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "pin",
          "description": "Pin a recorded test run for comparison",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "by",
              "required": true,
              "description": "Pin owner identifier",
              "bind": {
                "field": "pinned_by"
              }
            },
            {
              "name": "reason",
              "description": "Reason for the pin"
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "PinRun"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "unpin",
          "description": "Remove a pin from a recorded test run",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "by",
              "required": true,
              "description": "Pin owner identifier",
              "bind": {
                "field": "pinned_by"
              }
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "UnpinRun"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "compare",
          "description": "Compare two recorded test runs",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "phase",
              "description": "Restrict comparison to one phase"
            }
          ],
          "positionals": [
            {
              "name": "left_run_id",
              "required": true,
              "description": "Baseline run id",
              "bind": {
                "field": "run_id_a"
              }
            },
            {
      "name": "right_run_id",
      "required": true,
      "description": "Candidate run id",
      "bind": {
        "field": "run_id_b"
      }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "CompareRuns"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "cost",
          "description": "Show measured phase cost and reliability exclusions",
          "flags": [
            {
              "name": "scenario",
              "description": "Optional scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "window",
              "description": "Look-back duration (for example 168h or 7d)",
              "bind": {
                "field": "window_seconds"
              }
            },
            {
              "name": "compare-window",
              "description": "Optional preceding comparison duration",
              "bind": {
                "field": "compare_window_seconds"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetCostReport"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "freshness",
          "description": "Check whether a scenario changed since its last relevant run",
          "flags": [
            {
      "name": "scenario",
      "description": "Scenario id",
      "local_only": true
            },
            {
              "name": "phases",
              "description": "Comma-separated phases to check"
            }
          ],
          "positionals": [
            {
              "name": "scenario_arg",
              "description": "Scenario id",
              "bind": {
                "field": "target"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "CheckFreshness"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "findings",
          "description": "Show the per-phase maturity standing (Phase Capability Contract) from a run's findings.json",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "description": "Run id (defaults to the latest run)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetRunFindings"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "self-health",
          "description": "Show Test Genie self-health",
          "flags": [
            {
              "name": "window-days",
              "description": "Reliability ledger look-back window in days"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetSelfHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "operational"
          }
        },
        {
          "name": "fleet-health",
          "description": "Show fleet-wide health over stored runs",
          "flags": [
            {
              "name": "window-days",
              "description": "Fleet aggregation look-back window in days"
            },
            {
              "name": "roster",
              "bool": true,
              "description": "Include fleet roster details",
              "bind": {
                "field": "include_roster"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetFleetHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "operational"
          }
        },
        {
          "name": "abort",
          "description": "Abort a live server-owned run",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "AbortRun"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "status",
          "description": "Show live status for a server-owned run",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetRunStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "operational"
          }
        },
        {
          "name": "artifacts",
          "description": "List the typed, opaque artifact catalog for a run",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            },
            {
              "name": "kinds",
              "description": "Optional comma-separated artifact kinds"
            },
            {
              "name": "phase",
              "description": "Optional producing phase",
              "bind": {
                "field": "producing_phase"
              }
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "ListRunArtifacts"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "artifact",
          "description": "Show typed metadata and opaque access path for one run artifact",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id",
              "bind": {"field": "target"}
            }
          ],
          "positionals": [
            {
              "name": "run_id",
              "required": true,
              "description": "Run id"
            },
            {
              "name": "artifact_id",
              "required": true,
              "description": "Opaque artifact id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RunsService",
            "method": "GetRunArtifact"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "validation",
      "description": "Create, observe, explain, and control durable validation receipts",
      "commands": [
        {
          "name": "create",
          "description": "Create or attach to validation work from a protobuf-JSON intent file",
          "flags": [{"name":"intent-file","required":true,"description":"Path to a ValidationIntent protobuf-JSON document","bind":{"field":"intent","kind":"json_file"},"bind_waiver":"The validation CLI reads the file and decodes its protobuf JSON into ValidationIntent."}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"CreateValidation"},
          "governance": {"effect":"write","run_eligible":true,"permissions":["network:internal","filesystem:read"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "get",
          "description": "Get one durable validation receipt",
          "positionals": [{"name":"receipt_id","required":true,"description":"Validation receipt id"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"GetValidation"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "wait",
          "description": "Block once for terminal receipt state, an explicit later revision, or a bounded timeout",
          "flags": [
            {"name":"wait-id","required":true,"description":"Unique observer attachment id"},
            {"name":"timeout","default":"30m","description":"Bounded wait duration"},
            {"name":"after-revision","default":"0","description":"Optional revision cursor; zero waits for terminal state"}
          ],
          "positionals": [{"name":"receipt_id","required":true,"description":"Validation receipt id"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"WaitValidation"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        },
        {
          "name": "list",
          "description": "List durable validation receipts",
          "flags": [
            {"name":"caller","description":"Caller scenario","bind":{"field":"caller_scenario"}},
            {"name":"execution","description":"Caller execution id","bind":{"field":"caller_execution_id"}},
            {"name":"plan","description":"Plan id","bind":{"field":"plan_id"}},
            {"name":"page-size","default":"50","description":"Maximum receipts"},
            {"name":"page-token","description":"Continuation token"}
          ],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"ListValidations"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "cancel-wait",
          "description": "Detach one named observer without cancelling validation work",
          "flags": [{"name":"wait-id","required":true,"description":"Observer attachment id"}],
          "positionals": [{"name":"receipt_id","required":true,"description":"Validation receipt id"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"CancelValidationWait"},
          "governance": {"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "abort",
          "description": "Explicitly abort validation producer work",
          "flags": [
            {"name":"reason","required":true,"description":"Operator reason"},
            {"name":"requested-by","required":true,"description":"Requesting identity"}
          ],
          "positionals": [{"name":"receipt_id","required":true,"description":"Validation receipt id"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"AbortValidationWork"},
          "governance": {"effect":"destructive","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "explain",
          "description": "Explain receipt admission and next actions",
          "positionals": [{"name":"receipt_id","required":true,"description":"Validation receipt id"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"ExplainValidation"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        },
        {
          "name": "shadows-list",
          "description": "List bounded migration shadow comparisons",
          "flags": [{"name":"page-size","default":"100","description":"Maximum comparisons (1-500)"}],
          "binding": {"kind":"connect-rpc","service":"ValidationService","method":"ListValidationShadows"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        }
      ]
    },
    {
      "name": "remediate",
      "description": "Create and operate evidence-bound remediation jobs",
      "commands": [
        {"name":"create","description":"Create and launch an evidence-bound remediation job","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the completed execution"}],"flags":[{"name":"execution","required":true,"description":"Completed Test Genie execution UUID"},{"name":"findings","description":"Comma-separated stable finding IDs"},{"name":"requirements","description":"Comma-separated requirement IDs"},{"name":"role","required":true,"description":"Portable Agent Manager role reference"},{"name":"context","description":"Optional operator context"}],"binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"list","description":"List remediation jobs for a scenario","positionals":[{"name":"scenario","required":true,"description":"Scenario owning remediation jobs"}],"binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"show","description":"Show one remediation job and its lifecycle evidence","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the remediation job"},{"name":"job_id","required":true,"description":"Remediation job id"}],"binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"cancel","description":"Cancel an active remediation job","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the remediation job"},{"name":"job_id","required":true,"description":"Remediation job id"}],"binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"recover","description":"Recover a durable pending launch without duplicating remote work","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the remediation job"},{"name":"job_id","required":true,"description":"Remediation job id"}],"binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"retry","description":"Start a retry after a terminal launch failure","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the remediation job"},{"name":"job_id","required":true,"description":"Remediation job id"}],"binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]},"architecture":{"primitive":"action"}},
        {"name":"verify","description":"Start server-owned verification for an agent-completed job","positionals":[{"name":"scenario","required":true,"description":"Scenario owning the remediation job"},{"name":"job_id","required":true,"description":"Remediation job id"}],"binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]},"architecture":{"primitive":"action"}}
      ]
    },
    {
      "name": "eligibility",
      "description": "Check routed test database eligibility",
      "commands": [
        {
          "name": "check",
          "description": "Check whether a scenario qualifies for routed test-db execution",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "EligibilityService",
            "method": "Check"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "provider-contract",
      "description": "Run provider contract checks",
      "commands": [
        {
          "name": "check",
          "description": "Check provider contract coverage",
          "positionals": [
            {"name": "phase_or_provider", "required": true, "description": "Phase or provider"},
            {"name": "scenario", "required": true, "description": "Target scenario"}
          ],
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "action"}
        }
      ]
    }
  ],
  "omitted": [
    {
      "service": "RunsService",
      "method": "GetPhaseArtifact",
      "reason": "artifact download surface; retained in the local runs command until upload/download primitives cover binary payloads"
    },
    {
      "service": "RunsService",
      "method": "ListRunVideos",
      "reason": "visual artifact browsing surface; retained in the local runs command pending generated proto-list registration"
    },
    {
      "service": "RunsService",
      "method": "ListRunVisuals",
      "reason": "visual artifact browsing surface; retained in the local runs command pending generated proto-list registration"
    },
    {
      "service": "RunsService",
      "method": "CompareRunVisuals",
      "reason": "visual artifact comparison surface; retained in the local runs command pending generated proto-list registration"
    },
    {
      "service": "RunsService",
      "method": "FindRun",
      "reason": "internal run lookup helper used by durable reattach flows, not a stable user-facing command"
    },
    {
      "service": "RunsService",
      "method": "StartRun",
      "reason": "covered by the top-level execute durable_run exception"
    },
    {
      "service": "RunsService",
      "method": "FollowRun",
      "reason": "covered by execute/runs wait durable follow semantics; streaming commands require explicit special-case evidence"
    },
    {
