{
  "$schema": "../schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for test-genie scenario",
    "last_updated": "2025-12-02T00:00:00Z"
  },
  "version": "1.0.0",
  "structure": {
    "additional_dirs": [
      "ui"
    ],
    "additional_files": [
      "api/main.go",
      "cli/main.go"
    ]
  },
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "warning",
        "cli": "warning"
      },
      "unmatched_code_components": "warning"
    }
  },
  "unit": {
    "policy_profile": {
      "version": "2.0.0",
      "template": {
        "id": "react-vite",
        "scenario_class": "react-vite"
      },
      "required_roles": [
        {
          "role": "api",
          "policy_class": "go_service",
          "match": {
            "surface_id": "api",
            "kind": "api",
            "path": "api",
            "language": "go"
          }
        },
        {
          "role": "cli",
          "policy_class": "go_cli",
          "match": {
            "surface_id": "cli",
            "kind": "cli",
            "path": "cli",
            "language": "go"
          }
        },
        {
          "role": "ui",
          "policy_class": "react_vite_ui",
          "match": {
            "surface_id": "ui",
            "kind": "ui",
            "path": "ui",
            "language": "typescript",
            "framework": "vitest"
          }
        }
      ],
      "policy_classes": {
        "go_service": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "api/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        },
        "go_cli": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "cli/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        },
        "react_vite_ui": {
          "language": "typescript",
          "framework": "vitest",
          "package_manager": "pnpm",
          "coverage": {
            "minimum_percent": 85,
            "mode": "both",
            "provider": "v8",
            "reporters": [
              "text",
              "json-summary",
              "json"
            ]
          },
          "test_utils": {
            "required_roots": [
              "ui/src/test-utils"
            ],
            "production_import_ban": true,
            "canonical_render_helper": "ui/src/test-utils/renderWithProviders.tsx"
          },
          "projection": {
            "required_files": [
              "ui/vite.config.ts",
              "ui/src/test-setup.ts",
              "ui/src/test-utils/renderWithProviders.tsx"
            ],
            "required_scripts": [
              "test",
              "test:coverage"
            ],
            "settings": {
              "environment": "jsdom",
              "setup_files": [
                "./src/test-setup.ts"
              ],
              "coverage_provider": "v8"
            }
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "react-vitest",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        }
      },
      "customization": {
        "mode": "monotonic",
        "waivers": []
      },
      "runner_profiles": {
        "default": {
          "cpu_weight": 1,
          "memory_bytes": 536870912,
          "max_workers": 1,
          "timeout_seconds": 600,
          "no_output_timeout_seconds": 60,
          "sharding": "none",
          "network": "allow",
          "filesystem": "workspace"
        }
      }
    }
  },
  "docs": {
    "markdown": {
      "enabled": true
    },
    "mermaid": {
      "enabled": true,
      "strict": true
    },
    "links": {
      "enabled": true,
      "ignore": [
        "http://localhost:*"
      ],
      "max_concurrency": 6,
      "timeout_ms": 5000,
      "strict_external": false
    },
    "absolute_paths": {
      "enabled": true,
      "allow": [
        "/api/"
      ]
    }
  },
  "integration": {
    "_comment": "Integration phase configuration. WebSocket URL is derived from the runtime API URL following @vrooli/api-base conventions. See: packages/api-base/docs/concepts/websocket-support.md",
    "websocket": {
      "enabled": false,
      "path": "/api/v1/ws",
      "max_connection_ms": 2000
    }
  },
  "playbooks": {
    "enabled": true,
    "bas": {
      "timeout_ms": 30000,
      "launch_timeout_ms": 60000
    },
    "execution": {
      "stop_on_first_failure": false,
      "default_step_timeout_ms": 30000
    },
    "artifacts": {
      "screenshots": true,
      "dom_snapshots": true,
      "retain_on_success": false
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true
      }
    }
  },
  "phases": {
    "tidiness": {
      "budgets": {
        "ratchet": true,
        "duplication_line_debt": 7551,
        "baseline_duplication_line_debt": 7552,
        "long_files": 25,
        "baseline_long_files": 26,
        "complexity_over_threshold": 300,
        "baseline_complexity_over_threshold": 301,
        "coupling_over_threshold": 6,
        "baseline_coupling_over_threshold": 7,
        "debt_markers": 0,
        "baseline_debt_markers": 1,
        "reserve": 1,
        "reserve_reason": "Measured fleet seed reserves one observed unit while successor cleanup earns each stricter budget."
      }
    }
  }
}
