{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "status": "string",
          "readiness": "boolean",
          "dependencies": "object"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "test-genie status"
      }
    },
    {
      "id": "search_scenario_requirements",
      "path": "/api/v1/search/scenario-requirements",
      "method": "POST",
      "summary": "Search one scenario's owner requirement status",
      "description": "Performs a bounded query over one explicitly scoped scenario's Test Genie requirement view. Preserves generated time and unknown live status; recorded requirement status is not proof of a current passing run.",
      "category": "requirements",
      "request": {
        "type": "object",
        "content_type": "application/json",
        "required": ["query", "scenario"],
        "properties": {
          "query": "string",
          "scenario": "string (one exact scenario slug from scenario:<slug> scope)",
          "limit": "integer (optional; capped at 25)"
        }
      },
      "response": {
        "type": "object",
        "content_type": "application/json",
        "properties": {
          "results": "array<RequirementSearchResult>",
          "generatedAt": "timestamp",
          "summary": "RequirementsSummary",
          "degradations": "array<RequirementSearchDegradation>"
        }
      },
      "examples": [
        {
          "name": "Search scoped scenario requirement status",
          "curl": "curl http://localhost:${API_PORT}/api/v1/search/scenario-requirements -H 'Content-Type: application/json' -d '{\"query\":\"requirements status summary\",\"scenario\":\"search-hub\",\"limit\":5}'"
        }
      ]
    },
    {
      "id": "frozen_replay_create",
      "path": "/vrooli.test_genie.v1.frozen_replay.FrozenReplayService/CreateFrozenReplayReceipt",
      "method": "POST",
      "summary": "Create an immutable three-way bounty replay receipt",
      "description": "Verifies preimage, blind candidate, and merged-reference Test Genie evidence before append-only receipt storage.",
      "category": "frozen-replay",
      "request": {
        "type": "object",
        "content_type": "application/proto+json",
        "required": ["idempotency_key", "adjudication"],
        "properties": {
          "idempotency_key": "string",
          "adjudication": "FrozenReplayAdjudication"
        }
      },
      "response": {
        "type": "object",
        "content_type": "application/proto+json",
        "properties": {
          "receipt": "FrozenReplayReceipt",
          "replayed": "boolean"
        }
      },
      "cli_mapping": {
        "command": "test-genie frozen-replay create"
      }
    },
    {
      "id": "frozen_replay_get",
      "path": "/vrooli.test_genie.v1.frozen_replay.FrozenReplayService/GetFrozenReplayReceipt",
      "method": "POST",
      "summary": "Get and verify an immutable bounty replay receipt",
      "description": "Reads a persisted receipt and checks its SHA-256 content seal.",
      "category": "frozen-replay",
      "request": {
        "type": "object",
        "content_type": "application/proto+json",
        "required": ["receipt_id"],
        "properties": {
          "receipt_id": "string"
        }
      },
      "response": {
        "type": "object",
        "content_type": "application/proto+json",
        "properties": {
          "receipt": "FrozenReplayReceipt"
        }
      },
      "cli_mapping": {
        "command": "test-genie frozen-replay get <receipt_id>"
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health",
      "endpoint_id": "health"
    },
    {
      "name": "frozen-replay create",
      "description": "Verify and store an immutable three-way bounty replay receipt",
      "endpoint_id": "frozen_replay_create"
    },
    {
      "name": "frozen-replay get",
      "description": "Read an immutable bounty replay receipt",
      "endpoint_id": "frozen_replay_get"
    }
  ]
}
