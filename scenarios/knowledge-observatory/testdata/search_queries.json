{
  "version": 1,
  "description": "Hand-labeled accuracy corpus for knowledge-observatory documentation search. Each case maps a natural-language query to the documentation file(s) a good retriever should surface. The Phase-7 harness asserts recall@5 >= 0.8 (a case passes when any expected_paths entry is in the top-5) and reports MRR@3 over primary_path. Paths are repo-relative with forward slashes, matching the SourceDoc.ID emitted by kodocsource. This is the Phase-3 seed that drove the markdown chunker design; Phase 7 expands and runs it.",
  "scoring": {
    "recall_at": 5,
    "recall_target": 0.8,
    "mrr_at": 3,
    "rule": "A case is satisfied when at least one expected_paths entry appears in the top-N results. MRR uses the rank of primary_path."
  },
  "cases": [
    {
      "id": "project-quickstart",
      "query": "how do I get started and set up vrooli for the first time",
      "scope": "global",
      "primary_path": "docs/QUICKSTART.md",
      "expected_paths": ["docs/QUICKSTART.md", "docs/CONTRIBUTING.md"],
      "notes": "Project-level onboarding doc."
    },
    {
      "id": "project-architecture",
      "query": "overall platform architecture and operating model",
      "scope": "global",
      "primary_path": "docs/concepts/ARCHITECTURE.md",
      "expected_paths": ["docs/concepts/ARCHITECTURE.md", "docs/concepts/ECOSYSTEM.md"],
      "notes": "Project concepts."
    },
    {
      "id": "project-glossary",
      "query": "shared vocabulary and definitions of platform terms",
      "scope": "global",
      "primary_path": "docs/concepts/GLOSSARY.md",
      "expected_paths": ["docs/concepts/GLOSSARY.md"],
      "notes": "Glossary by title/description."
    },
    {
      "id": "project-contributing",
      "query": "contributor workflow and how to submit changes",
      "scope": "global",
      "primary_path": "docs/CONTRIBUTING.md",
      "expected_paths": ["docs/CONTRIBUTING.md"],
      "notes": "Contributing guide."
    },
    {
      "id": "project-design-governance",
      "query": "design language system governance for scenario user interfaces",
      "scope": "global",
      "primary_path": "docs/design/README.md",
      "expected_paths": ["docs/design/README.md", "docs/design/governance.md", "docs/design/registry.md"],
      "notes": "Design canon docs."
    },
    {
      "id": "config-resources",
      "query": "configure local resources like postgres redis and qdrant",
      "scope": "global",
      "primary_path": "docs/configuration/resources.md",
      "expected_paths": ["docs/configuration/resources.md", "docs/configuration/README.md"],
      "notes": "Resource configuration."
    },
    {
      "id": "config-operating-mode",
