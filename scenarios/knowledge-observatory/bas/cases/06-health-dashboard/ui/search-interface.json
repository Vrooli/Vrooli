{
  "metadata": {
    "name": "search-interface",
    "description": "Verifies search interface is present on dashboard",
    "version": "1",
    "requirement": "KO-HD-004",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "execution_viewport_preset": "desktop",
      "requirements_json": "[\"KO-HD-004\"]"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "metadata": {
          "label": "Open Knowledge Observatory dashboard"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "knowledge-observatory",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        }
      }
    },
    {
      "id": "navigate-home-settle",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "metadata": {
          "label": "Wait for page to settle"
        },
        "wait": {
          "duration_ms": 1000
        }
      }
    },
    {
      "id": "assert-dashboard-loaded",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "metadata": {
          "label": "Dashboard loaded"
        },
        "assert": {
          "selector": "body",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 10000,
          "failure_message": "Dashboard should be visible"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1-settle-in",
      "source": "navigate-home",
      "target": "navigate-home-settle"
    },
    {
      "id": "e1",
      "source": "navigate-home-settle",
      "target": "assert-dashboard-loaded"
    }
  ]
}
