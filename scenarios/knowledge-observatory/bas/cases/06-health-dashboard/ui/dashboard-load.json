{
  "metadata": {
    "name": "dashboard-load",
    "description": "Verifies Knowledge Observatory dashboard loads with Matrix-style UI",
    "version": "1",
    "requirement": "KO-HD-001",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "execution_viewport_preset": "desktop",
      "requirements_json": "[\"KO-HD-001\"]"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "metadata": {
          "label": "Open Knowledge Observatory home page"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "knowledge-observatory",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        }
      }
    },
    {
      "id": "navigate-home-settle",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "metadata": {
          "label": "Wait for page to settle"
        },
        "wait": {
          "duration_ms": 1000
        }
      }
    },
    {
      "id": "assert-title",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "metadata": {
          "label": "Page title exists"
        },
        "assert": {
          "selector": "h1",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 10000,
          "failure_message": "Dashboard should display title"
        }
      }
    },
    {
      "id": "assert-content",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "metadata": {
          "label": "Page has content"
        },
        "assert": {
          "selector": "body",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 10000,
          "failure_message": "Dashboard should have body content"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1-settle-in",
      "source": "navigate-home",
      "target": "navigate-home-settle"
    },
    {
      "id": "e1",
      "source": "navigate-home-settle",
      "target": "assert-title"
    },
    {
      "id": "e2",
      "source": "assert-title",
      "target": "assert-content"
    }
  ]
}
