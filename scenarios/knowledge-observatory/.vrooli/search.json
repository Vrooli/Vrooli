{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "knowledge-observatory.docs",
      "provider_group": "knowledge-observatory",
      "bucket": "BUCKET_KNOW",
      "type": "doc",
      "description": "Project documentation across every scenario and the repo root — READMEs, guides, concept docs, runbooks, plans — searchable semantically by what each doc explains (for example \"how does the lifecycle system work\", \"sandbox architecture\"). Route here to find an explanation, guide, or reference that has already been written.",
      "scope": "SCOPE_PROJECT",
      "class": "local_index",
      "endpoint": {
        "http_json": {
          "scenario_id": "knowledge-observatory",
          "path": "/api/v1/search/query",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}},\"scope\":\"{{scope_kind}}\",\"target\":\"{{scope_value}}\"}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "knowledge-observatory",
          "path": "/api/v1/search/status",
          "method": "HTTP_METHOD_GET",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "reindex_endpoint": {
        "http_json": {
          "scenario_id": "knowledge-observatory",
          "path": "/api/v1/reindex/run",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"dry_run\":false,\"control_token\":\"{{control_token}}\"}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "relative_path",
        "title_field": "title",
        "score_field": "score",
        "snippet_field": "snippet",
        "path_field": "path",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "tuning": {
        "engine": "hybrid",
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": false,
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 50,
        "floor": {
          "max_gap": 0,
          "hard_floor": 0
        }
      },
      "scoring": {
        "recall_at": 5,
        "recall_target": 0.8,
        "mrr_at": 3,
        "deep_k": 50
      },
      "tests": {
        "suite_id": "knowledge-observatory.docs.starter",
        "name": "Knowledge-observatory docs — primary golden corpus",
        "description": "Hand-labeled documentation search corpus migrated from the old standalone testdata/search_queries.json into the provider search.json SSOT. Cases assert stable document paths (the provider id_field is relative_path) within recall_at; scoped cases preserve their scenario:path query scope through the shared GradeSuite harness.",
        "cases": [
          {
            "id": "project-quickstart",
            "query": "how do I get started and set up vrooli for the first time",
            "scope": "global",
            "tags": [
              "strong",
              "onboarding"
            ],
            "expect_ids": [
              "docs/QUICKSTART.md",
              "docs/CONTRIBUTING.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/QUICKSTART.md. Project-level onboarding doc."
          },
          {
            "id": "project-architecture",
            "query": "overall platform architecture and operating model",
            "scope": "global",
            "tags": [
              "strong",
              "concept"
            ],
            "expect_ids": [
              "docs/concepts/ARCHITECTURE.md",
              "docs/concepts/ECOSYSTEM.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/concepts/ARCHITECTURE.md. Project concepts."
          },
          {
            "id": "project-glossary",
            "query": "shared vocabulary and definitions of platform terms",
            "scope": "global",
            "tags": [
              "strong",
              "reference"
            ],
            "expect_ids": [
              "docs/concepts/GLOSSARY.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/concepts/GLOSSARY.md. Glossary by title/description."
          },
          {
            "id": "project-contributing",
            "query": "contributor workflow and how to submit changes",
            "scope": "global",
            "tags": [
              "strong",
              "workflow"
            ],
            "expect_ids": [
              "docs/CONTRIBUTING.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/CONTRIBUTING.md. Contributing guide."
          },
          {
            "id": "project-design-governance",
            "query": "design language system governance for scenario user interfaces",
            "scope": "global",
            "tags": [
              "strong",
              "design"
            ],
            "expect_ids": [
              "docs/design/README.md",
              "docs/design/governance.md",
              "docs/design/registry.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/design/README.md. Design canon docs."
          },
          {
            "id": "config-resources",
            "query": "configure local resources like postgres redis and qdrant",
            "scope": "global",
            "tags": [
              "hard",
              "configuration"
            ],
            "expect_ids": [
              "docs/configuration/resources.md",
              "docs/configuration/README.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/configuration/resources.md. Resource configuration."
          },
          {
            "id": "config-operating-mode",
            "query": "set the operating mode for the platform",
            "scope": "global",
            "tags": [
              "strong",
              "configuration"
            ],
            "expect_ids": [
              "docs/configuration/operating-mode.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/configuration/operating-mode.md. Operating mode config."
          },
          {
            "id": "config-secrets",
            "query": "how to manage secrets and credentials configuration",
            "scope": "global",
            "tags": [
              "strong",
              "configuration"
            ],
            "expect_ids": [
              "docs/configuration/secrets.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/configuration/secrets.md. Secrets config."
          },
          {
            "id": "config-profiles",
            "query": "environment profiles development production minimal",
            "scope": "global",
            "tags": [
              "strong",
              "configuration"
            ],
            "expect_ids": [
              "docs/configuration/profiles.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/configuration/profiles.md. Setup profiles."
          },
          {
            "id": "deployment-storage",
            "query": "where does deployment data get stored",
            "scope": "global",
            "tags": [
              "weak-real",
              "deployment"
            ],
            "expect_ids": [
              "docs/deployment/storage.md",
              "docs/deployment/README.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/deployment/storage.md. Deployment storage."
          },
          {
            "id": "development-proto",
            "query": "proto regeneration guide generated code buf schemas",
            "scope": "global",
            "tags": [
              "strong",
              "development"
            ],
            "expect_ids": [
              "docs/development/proto.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/development/proto.md. Proto regeneration guide."
          },
          {
            "id": "agent-layers",
            "query": "the layers of the agent system",
            "scope": "global",
            "tags": [
              "strong",
              "agent-system"
            ],
            "expect_ids": [
              "docs/agent-system/LAYERS.md",
              "docs/agent-system/PRIMITIVES.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/agent-system/LAYERS.md. Agent-system architecture."
          },
          {
            "id": "agent-skill-authoring",
            "query": "how to author a new skill for agents",
            "scope": "global",
            "tags": [
              "strong",
              "agent-system"
            ],
            "expect_ids": [
              "docs/agent-system/SKILL_AUTHORING.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/agent-system/SKILL_AUTHORING.md. Skill authoring."
          },
          {
            "id": "agent-promotion-ladder",
            "query": "promotion ladder for graduating agent capabilities",
            "scope": "global",
            "tags": [
              "strong",
              "agent-system"
            ],
            "expect_ids": [
              "docs/agent-system/PROMOTION_LADDER.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/agent-system/PROMOTION_LADDER.md. Promotion ladder."
          },
          {
            "id": "agent-deprecation-policy",
            "query": "policy for deprecating and removing capabilities",
            "scope": "global",
            "tags": [
              "strong",
              "agent-system"
            ],
            "expect_ids": [
              "docs/agent-system/DEPRECATION_POLICY.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/agent-system/DEPRECATION_POLICY.md. Deprecation policy."
          },
          {
            "id": "agent-shared-package-testing",
            "query": "how to test shared go packages",
            "scope": "global",
            "tags": [
              "strong",
              "agent-system"
            ],
            "expect_ids": [
              "docs/agent-system/SHARED_PACKAGE_TESTING.md"
            ],
            "expect_within_top_k": 5,
            "note": "Primary path: docs/agent-system/SHARED_PACKAGE_TESTING.md. Shared package testing."
          },
          {
            "id": "cli-health-architecture-scoped",
            "query": "architecture of the service",
            "scope": "scenario:cli-health",
            "tags": [
              "hard",
              "scope"
            ],
            "expect_ids": [
              "scenarios/cli-health/docs/concepts/ARCHITECTURE.md"
            ],
            "expect_within_top_k": 5,
            "note": "Scenario scope must keep this to cli-health, excluding the project ARCHITECTURE.md."
          },
          {
            "id": "cli-health-seams-scoped",
            "query": "testability seams and boundaries",
            "scope": "scenario:cli-health",
            "tags": [
              "strong",
              "scope"
            ],
            "expect_ids": [
              "scenarios/cli-health/docs/internal/SEAMS.md"
            ],
            "expect_within_top_k": 5,
            "note": "Scenario internal doc."
          },
          {
            "id": "cli-health-runbook-scoped",
            "query": "operational runbook for incidents",
            "scope": "scenario:cli-health",
            "tags": [
              "strong",
              "scope"
            ],
            "expect_ids": [
              "scenarios/cli-health/docs/operations/RUNBOOK.md",
              "scenarios/cli-health/docs/operations/OBSERVABILITY.md"
            ],
            "expect_within_top_k": 5,
            "note": "Operations doc."
          },
          {
            "id": "cli-health-monetization-scoped",
            "query": "monetization and go to market strategy",
            "scope": "scenario:cli-health",
            "tags": [
              "strong",
              "scope"
            ],
            "expect_ids": [
              "scenarios/cli-health/docs/business/MONETIZATION.md",
              "scenarios/cli-health/docs/business/GO-TO-MARKET.md"
            ],
            "expect_within_top_k": 5,
            "note": "Business docs."
          },
          {
            "id": "cli-health-error-handling-scoped",
            "query": "how errors are handled and classified",
            "scope": "scenario:cli-health",
            "tags": [
              "strong",
              "scope"
            ],
            "expect_ids": [
              "scenarios/cli-health/docs/internal/ERROR-HANDLING.md"
            ],
            "expect_within_top_k": 5,
            "note": "Error handling doc."
          },
          {
            "id": "path-scoped-concepts",
            "query": "architecture",
            "scope": "path:docs/concepts",
            "tags": [
              "strong",
              "scope"
            ],
            "expect_ids": [
              "docs/concepts/ARCHITECTURE.md"
            ],
            "expect_within_top_k": 5,
            "note": "Path-prefix scope confines results to docs/concepts/."
          },
          {
            "id": "gibberish-1",
            "query": "asdfqwer zxcvbnm qwertyuiop florbnax",
            "tags": [
              "gibberish"
            ],
            "expect_no_strong_hit": true,
            "expect_max_score": 0.55,
            "note": "Junk rejection: nonsense must not surface a confident hit."
          }
        ],
        "coverage": {
          "required_tag_groups": [
            {
              "id": "project-docs",
              "description": "Top-level project documentation and concepts.",
              "tags": [
                "onboarding",
                "concept",
                "reference"
              ],
              "min_reviewed_positive": 3
            },
            {
              "id": "configuration-operations",
              "description": "Configuration, deployment, and operational docs.",
              "tags": [
                "configuration",
                "deployment"
              ],
              "min_reviewed_positive": 4
            },
            {
              "id": "scoped-search",
              "description": "Scenario and path scoped documentation queries.",
              "tags": [
                "scope"
              ],
              "min_reviewed_positive": 4
            }
          ]
        }
      },
      "config_writable": false,
      "config_pinned_reason": "Hybrid-by-construction documentation search pins tuning in code and does not accept sweep write-back."
    }
  ]
}
