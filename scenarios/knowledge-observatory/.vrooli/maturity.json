      "exit_criteria": ["No content validator findings block documentation health"]
    },
    {
      "id": "L4",
      "name": "References and manifest coverage healthy",
      "description": "Bidirectional code/doc references and docs manifest coverage stay coherent as code and docs evolve.",
      "entry_criteria": ["Content validators pass"],
      "exit_criteria": ["No reference-integrity or manifest-coverage findings block documentation health"]
    },
    {
      "id": "L5",
      "name": "Fleet-ready documentation posture",
      "description": "Documentation health is clean enough for Test Genie delegation, provider maturity comparison, and reusable scenario onboarding.",
      "entry_criteria": ["References and manifest coverage are healthy"],
      "exit_criteria": ["No documentation-health findings block fleet validation"]
    }
  ],
