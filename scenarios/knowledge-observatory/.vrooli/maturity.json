      "exit_criteria": ["Manifest schema, contract kind, maturity values, stages, and document metadata validate"]
    },
    {
      "id": "L2",
      "name": "Required documentation placed",
      "description": "Required scenario documentation exists at contract-approved paths, without misplaced or missing docs.",
      "entry_criteria": ["Documentation contract is discoverable"],
      "exit_criteria": ["No required docs are missing or misplaced"]
    },
    {
      "id": "L3",
      "name": "Content and links healthy",
      "description": "Markdown, Mermaid, absolute paths, derived-count markers, and local/external links are healthy enough for operator and agent use.",
