      "id": "L0",
      "name": "No documentation target",
      "description": "Knowledge Observatory cannot resolve a scenario or documentation path for docs health validation.",
      "entry_criteria": ["Scenario id or docs path is provided"],
      "exit_criteria": ["The target scenario or path resolves to readable documentation input"]
    },
    {
      "id": "L1",
      "name": "Documentation contract discoverable",
      "description": "The target has a readable documentation manifest or an explicit fallback contract, with required contract fields present.",
