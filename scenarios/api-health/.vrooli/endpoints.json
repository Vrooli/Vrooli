{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.api_health.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.api_health.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's API readiness",
      "description": "Resolves a target scenario, classifies API applicability, optionally probes live /health, and returns API Health findings through the shared scenario-validation response.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "include_execution": "bool",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "metrics": "common.v1.ExecutionMetrics",
          "native_detail": "google.protobuf.Any",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid target path"
        }
      ],
      "examples": [
        {
          "name": "Validate scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"api-health\",\"include_execution\":true}'"
        }
      ]
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview deterministic API Health fixes",
      "description": "Dry-run deterministic API Health repairs for local mechanical findings.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "array<string>",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "array<scenario_validation.v1.FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid fix request"
        }
      ],
      "examples": [
        {
          "name": "Preview fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix -H 'Content-Type: application/json' -d '{\"scenario\":\"api-health\",\"rule_ids\":[\"api_health.raw_status_code\"]}'"
        }
      ]
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply deterministic API Health fixes",
      "description": "Apply deterministic API Health repairs selected explicitly by the caller.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "array<string>",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "array<scenario_validation.v1.FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid fix request"
        }
      ],
      "examples": [
        {
          "name": "Apply fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix -H 'Content-Type: application/json' -d '{\"scenario\":\"api-health\",\"rule_ids\":[\"api_health.raw_status_code\"]}'"
        }
      ]
    }
  ]
}
