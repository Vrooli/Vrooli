{
  "metadata": {
    "name": "experience-dashboard-spec-smoke",
    "description": "Generated observer smoke for active experience page dashboard.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "dashboard",
      "surface": "experience-dashboard"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "extraction-range",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_DOMCONTENTLOADED",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Dashboard" }
      }
    },
    {
      "id": "wait-dashboard-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.dashboard",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Dashboard page visible" }
      }
    },
    {
      "id": "assert-workbench-loading-region",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-experience-surface=\"workbench-data\"][data-experience-state=\"loading\"]",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Workbench announces data loading" }
      }
    },
    {
      "id": "assert-workbench-region-ready",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-experience-surface=\"workbench-data\"][data-experience-state=\"ready\"]",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 15000,
          "failure_message": "Challenge catalog and scoreboard should reach the ready state."
        },
        "metadata": { "label": "Workbench data reached its ready state" }
      }
    }
  ]
}
