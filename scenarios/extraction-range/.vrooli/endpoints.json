{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.extraction_range.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.extraction_range.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain JSON from the shared capability registry, read by lifecycle and operator tooling.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
      "id": "range_list_levels",
      "path": "/vrooli.extraction_range.v1.range.RangeService/ListLevels",
      "method": "POST",
      "summary": "List practice levels",
      "description": "Lists the data-defined extraction challenges, optionally filtered by family.",
      "category": "range",
      "response": {
        "type": "object",
        "properties": {
          "levels": "array<LevelSummary>"
        }
      }
    },
    {
      "id": "range_get_level",
      "path": "/vrooli.extraction_range.v1.range.RangeService/GetLevel",
      "method": "POST",
      "summary": "Get a practice level",
      "description": "Returns the task brief and owned practice-page URL without revealing its answer key.",
      "category": "range",
      "response": {
        "type": "object",
        "properties": {
          "level": "LevelSummary",
          "target_url": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Level does not exist"
        }
      ]
    },
    {
      "id": "range_submit",
      "path": "/vrooli.extraction_range.v1.range.RangeService/Submit",
      "method": "POST",
      "summary": "Score an extraction submission",
      "description": "Scores exact record matches with precision, recall and F1, attributed to the submitting tool.",
      "category": "range",
      "request": {
        "type": "object",
        "properties": {
          "level_id": "string",
          "records": "array<ExtractedRecord>",
          "tool": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "correct": "integer",
          "f1": "number",
          "passed": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Tool or level is missing or invalid"
        }
      ]
    },
    {
      "id": "range_scoreboard",
      "path": "/vrooli.extraction_range.v1.range.RangeService/Scoreboard",
      "method": "POST",
      "summary": "Read the practice scoreboard",
      "description": "Returns best scores by tool and level, optionally filtered by tool or family.",
      "category": "range",
      "response": {
        "type": "object",
        "properties": {
          "scores": "array<SubmitResponse>"
        }
      }
    }
  ]
}
