{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "prompt-manager.skill",
      "lifecycle": "production",
      "provider_group": "prompt-manager",
      "bucket": "BUCKET_DO",
      "type": "skill",
      "description": "High-traffic internal skills: reusable operating instructions, implementation guidance, debugging methods, and project workflows for agents working in Vrooli.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "index_timestamp_field": "finishedAt",
      "endpoint": {
        "http_json": {
          "scenario_id": "prompt-manager",
          "path": "/vrooli.prompt_manager.v1.aisearch.AISearchService/SearchSkills",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}},\"output\":\"results\"}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "prompt-manager",
          "path": "/vrooli.prompt_manager.v1.aisearch.AISearchService/GetReconcileStatus",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "name",
        "score_field": "score",
        "snippet_field": "description",
        "path_field": "id",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 20
      },
      "scoring": {"recall_at": 5, "recall_target": 0.8, "mrr_at": 3, "deep_k": 20},
      "tests": {
        "minimum": {"reviewed_positive": 1, "negative": 1},
        "suite_id": "prompt-manager.skill.primary",
        "name": "Prompt Manager skills — starter golden corpus",
        "description": "Starter reviewed cases for the high-traffic skill leaf. Cases are intentionally small and will be expanded through evals generate, reviewed, then promoted.",
        "cases": [
          {"id": "implementation-plan-guidance", "query": "how to write an implementation plan", "tags": ["strong", "planning"], "expect_ids": ["implementation-plan-authoring"], "expect_within_top_k": 5},
          {"id": "debugging-guidance", "query": "debug a non-obvious issue scientifically", "tags": ["strong", "debugging"], "expect_ids": ["scientific-debugging"], "expect_within_top_k": 5},
          {"id": "skills-gibberish", "query": "qzvplm krxnt nonsense", "tags": ["gibberish"], "expect_no_strong_hit": true, "expect_max_score": 0.3}
        ]
      }
    },
    {
      "provider_id": "prompt-manager.action",
      "lifecycle": "production",
      "provider_group": "prompt-manager",
      "bucket": "BUCKET_DO",
      "type": "action",
      "description": "High-traffic executable actions: reusable Vrooli operations and typed command capabilities discoverable by intent.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "index_timestamp_field": "finishedAt",
      "endpoint": {
        "http_json": {
          "scenario_id": "prompt-manager",
          "path": "/vrooli.prompt_manager.v1.aisearch.AISearchService/SearchActions",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "prompt-manager",
          "path": "/vrooli.prompt_manager.v1.aisearch.AISearchService/GetReconcileStatus",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "name",
        "score_field": "score",
        "snippet_field": "description",
        "path_field": "id",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 20
      },
      "scoring": {"recall_at": 5, "recall_target": 0.8, "mrr_at": 3, "deep_k": 20},
      "tests": {
        "minimum": {"reviewed_positive": 1, "negative": 1},
        "suite_id": "prompt-manager.action.primary",
        "name": "Prompt Manager actions — starter golden corpus",
        "description": "Starter reviewed cases for the action leaf. Cases are intentionally small and will be expanded through evals generate, reviewed, then promoted.",
        "cases": [
          {"id": "provider-contract-action", "query": "run provider contract tests", "tags": ["strong", "testing"], "expect_ids": ["test-genie.provider-contract"], "expect_within_top_k": 5},
          {"id": "scenario-operation-action", "query": "run a scenario operation", "tags": ["strong", "operations"], "expect_ids": ["scenario.status.show"], "expect_within_top_k": 5},
          {"id": "actions-gibberish", "query": "qzvplm krxnt nonsense", "tags": ["gibberish"], "expect_no_strong_hit": true, "expect_max_score": 0.3}
        ]
      }
    }
  ]
}
