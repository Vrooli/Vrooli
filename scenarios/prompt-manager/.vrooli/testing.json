{
  "$schema": "https://vrooli.com/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for prompt-manager",
    "last_updated": "2025-12-30T00:00:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "warning",
        "cli": "warning"
      },
      "unmatched_code_components": "warning"
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "languages": {
      "go": {},
      "node": {}
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      }
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true
      }
    }
  }
}
