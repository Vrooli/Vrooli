{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "prompt-manager",
    "displayName": "Personal Prompt Manager",
    "description": "File-based prompt storage and management tool with API access and web interface for organizing AI prompts",
    "version": "1.0.0",
    "type": "business-application",
    "category": "productivity",
    "tags": [
      "react-ui",
      "go-api",
      "prompt-management",
      "ai-tools",
      "productivity"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/prompt-manager"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 36235,
      "description": "React UI"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/prompt-manager-api"
            ]
          },
          {
            "type": "cli",
            "command": "prompt-manager"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o prompt-manager-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && pnpm run build; else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and UI server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./prompt-manager-api",
          "background": true,
          "description": "Start Go API server in background",
          "condition": {
            "file_exists": "api/prompt-manager-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "run-tests",
          "run": "test-genie execute prompt-manager --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'prompt-manager-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "scenarios": {
      "agent-manager": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Executes heartbeat runs via task/run API. Heartbeat system degrades when unavailable.",
        "degraded_behavior": "Scheduled heartbeat runs are skipped until agent-manager is available"
      }
    },
    "resources": {
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Metrics and test results storage (prompts stored in files)",
        "initialization": [
          {
            "file": "initialization/postgres/schema_v2.sql",
            "type": "schema"
          }
        ]
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Vector database for AI-powered semantic search (stores skill embeddings)",
        "degraded_behavior": "Semantic search features fall back to file-backed lookup only"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Local LLM for AI search embeddings (nomic-embed-text) and prompt testing (llama3.2)",
        "degraded_behavior": "Local embedding generation and prompt-evaluation flows are unavailable",
        "models": [
          "nomic-embed-text",
          "llama3.2"
        ]
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "prompt-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "prompt-manager"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  }
}
