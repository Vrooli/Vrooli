        "source-bounds"
      ],
      "notes": "Arrange related genuine regions spatially; connect only relationships supported by the product.",
      "antiPatterns": [
        "Decorative edges that imply unobserved integration."
      ],
      "implementationRefs": [
        "capture.md",
        "review.md",
        "examples.json"
      ]
    },
    {
      "id": "material-metaphor",
      "intent": [
        "broll",
        "materials",
        "atmosphere"
      ],
