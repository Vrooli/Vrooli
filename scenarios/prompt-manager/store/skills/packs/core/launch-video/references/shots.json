      ],
      "complexity": "low",
      "durationRange": [
        3,
        5
      ],
      "requires": [
        "shipped-logo",
        "approved-takeaway"
      ],
      "notes": "Resolve the visual motif into the brand; hold a single takeaway and destination.",
      "antiPatterns": [
        "Ending while type still arrives; an unverified download or availability claim."
      ],
      "implementationRefs": [
        "production.md",
        "upstream.md"
      ]
    },
    {
