      "implementationRefs": [
        "capture.md",
        "review.md",
        "examples.json"
      ]
    },
    {
      "id": "search-decision",
      "intent": [
        "search",
        "find",
        "proof"
      ],
      "media": [
        "moving-capture"
      ],
      "complexity": "medium",
      "durationRange": [
        3,
        7
      ],
