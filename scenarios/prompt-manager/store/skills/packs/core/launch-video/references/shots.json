        "real-3d"
      ],
      "complexity": "medium",
      "durationRange": [
        3,
        7
      ],
      "requires": [
        "approved-styleframe",
        "provenance"
      ],
      "notes": "Use light, material and silhouette to express a story idea; keep it distinct from product evidence.",
      "antiPatterns": [
