{
  "intake": [
    {
      "prefix": "validation-inbox/*",
      "taxonomy": "monetization-validation",
      "classifier_skill": "market-validation-triage"
    },
    {
      "prefix": "monetization-benchmark-adjacent-record/*",
      "taxonomy": "monetization-validation",
      "classifier_skill": "market-validation-triage",
      "source_team": "marketing-crew"
    }
  ],
  "required_read": [
    {
      "prefix": "monetization/market-scan/<slug>"
    }
  ],
  "evidence_consumed": [
    {
      "prefix": "challenge-report/*",
      "for_decisions": [
        "pricing-decision",
        "financial-model-assumption-update",
        "benchmark-update"
      ]
    },
    {
      "prefix": "challenge-resolution-record/*",
      "for_decisions": [
        "pricing-decision",
        "financial-model-assumption-update",
        "benchmark-update"
      ]
    }
  ],
  "output": [
    {
      "prefix": "monetization-benchmark-record/*",
      "destination_kind": "knowledge",
      "schema": "market-scan"
    },
    {
      "prefix": "monetization/market-scan/*",
      "destination_kind": "knowledge",
      "schema": "market-scan"
    }
  ],
  "decisions_owned": [
    "benchmark-update",
    "pricing-decision",
    "financial-model-assumption-update"
  ],
  "decisions_consumed": [
    "capability-gap"
  ],
  "raises_capability_gaps": true,
  "external_producers": [
    "operator",
    "vision-walk",
    "bookmark-intelligence-hub"
  ]
}
