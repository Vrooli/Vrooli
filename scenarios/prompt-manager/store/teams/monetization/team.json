          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          }
        ],
        "safetyCriticalRules": [
          "Do not edit canonical docs under docs/monetization directly; propose changes via work items.",
          "Do not aggregate other members into a synthetic monetization brief."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "headlinerCriteria": [
            "strong standalone appeal",
            "deployable today"
          ],
          "tier4Policy": "north-star; do not plan without explicit operator initiation"
        }
      },
      "opportunity-scout": {
        "lane": "Generate candidate SKUs, add-ons, services lines, and discovery channels; classify them, attach explicit revisit triggers, and maintain the candidate pool.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          }
        ],
        "safetyCriticalRules": [
          "Every candidate needs a concrete revisit trigger.",
          "Every idea needs both acquisition and retention hypotheses.",
          "Do not nominate Tier 4 hardware work without explicit operator initiation.",
          "Inbox triage must leave no entry under opportunity-inbox/* \u2014 promote (retag to monetization/opportunity/<slug>), observe (retag to scout-scan/YYYY-MM-DD), file work, or delete."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "ideasPerHeartbeat": "3-10 when signal supports it; fewer is valid during quiet signal",
          "destinationRule": [
            "strong signal plus clear fit -> work item",
            "plausible speculative idea -> knowledge entry under monetization/opportunity/<slug> with required front-matter (catalog, revisit_trigger, acquisition_hypothesis, retention_hypothesis)",
            "raw untriaged signal -> knowledge entry under opportunity-inbox/<signal-type>/<slug>",
            "weak or incoherent -> drop"
          ]
        }
      },
      "financial-tracker": {
        "lane": "Maintain the monetization ledger, classify operator-provided and telemetry-backed inputs, compute runway/default-alive deltas, and flag financial guardrail changes.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          }
        ],
        "safetyCriticalRules": [
          "Operator financial inputs enter through Money Ledger's /adapters surface; never fabricate an absent value or edit retired copies.",
          "Every numeric field must carry an honesty flag.",
          "Keep channels separate from revenue lines."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "servicesTimeGuardrailPercent": 30,
          "requiredHonestyFlags": [
            "fixed",
            "measured",
            "estimate",
            "aspirational",
            "pending-telemetry",
            "pending-operator",
            "stale"
          ]
        }
      },
      "market-validator": {
        "lane": "Capture external benchmarks, validate market assumptions, refresh stale comps, and propose benchmark/pricing/model updates for the active tier and bundle.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          }
        ],
        "safetyCriticalRules": [
          "Every captured value needs a source, date, and applicability flag.",
          "Deep research stays scoped to the active tier and bundle.",
          "Validation-inbox triage must leave no entry under validation-inbox/* \u2014 validate (retag to monetization-benchmark-record/<slug>), preserve adjacent evidence, file a work item, or delete.",
          "The staleness sweep enqueues but never re-fetches or resolves; resolution happens via the router and method skills only."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        }
      },
      "monetization-contrarian": {
        "lane": "Challenge monetization proposals against the seven failure modes and channel-activation guardrail; make skepticism visible without creating positive proposals. Also this team's shape sensor: hold the team against the target model's deviation catalogue and report deviations; never restructure.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          }
        ],
        "safetyCriticalRules": [
          "Do not create promotional or positive-action work items.",
          "Do not block work items directly; operator resolves them.",
          "Do not invent new failure modes on the fly; use framework-update work items."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "failureModes": [
            "catalog sprawl",
            "premature tier activation",
            "services trap",
            "retention-blind acquisition",
            "hallucinated metrics",
            "positioning drift",
            "marketing-default"
          ],
          "channelActivationGuardrail": [
            "activation trigger met",
            "telemetry present",
            "channel not confused with revenue line",
            "trust/safety prerequisites satisfied"
          ]
        }
      }
