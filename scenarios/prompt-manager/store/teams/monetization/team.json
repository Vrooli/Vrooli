    "members": {
      "catalog-strategist": {
        "lane": "Maintain the SKU, discovery-channel, delivery-tier, services-line, and scenario-role graph; propose promotions, mappings, retirements, and services lifecycle changes when triggers fire.",
        "allowedWrites": [
          {
            "kind": "knowledge"
