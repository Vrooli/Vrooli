        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "kind": "decision"
          },
          {
            "kind": "task"
          },
          {
            "base": "repo-root",
            "path": "VISION.md"
          },
          {
            "base": "repo-root",
            "path": "docs/concepts/ARCHITECTURE.md"
          }
        ],
        "safetyCriticalRules": [
          "Strictly read-only: do not create decisions, modify backlog items, trigger side effects, or choose answers for the operator."
        ],
        "readOnlyModeBehavior": {
          "skipNewDecisions": true,
          "stillWriteKnowledge": true,
          "stillRunSupersession": true,
          "stillWriteHandoff": true
