        "ownerMemberId": "portfolio-manager",
        "supersedesPrevious": true,
        "retention": "snapshot"
      },
      "outcome-snapshot-YYYY-MM-DD": {
        "ownerMemberId": "outcome-strategist",
        "supersedesPrevious": true,
        "retention": "snapshot"
      },
      "vision-walk/<date>/<slug>": {
        "ownerMemberId": "vision-walk-prep",
        "supersedesPrevious": false,
        "retention": "append-only"
      }
    },
    "members": {
      "portfolio-manager": {
        "lane": "Keep Swarm Manager initiative flow healthy; apply accepted portfolio decisions and propose bounded corrections.",
        "ownedDecisionContexts": [
          "initiative-portfolio",
          "initiative-supplement",
          "initiative-proposal",
          "initiative-readiness"
        ],
        "pendingOwnedDecisionCap": 3,
        "requiredKnowledgeTopics": [
          "decision-application/<decision-id>",
          "portfolio-snapshot-YYYY-MM-DD"
        ],
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "decision"
          },
          {
            "kind": "handoff"
          },
          {
            "kind": "task"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/director-swarm/"
          },
          {
            "base": "repo-root",
            "path": "VISION.md"
          },
          {
            "base": "repo-root",
            "path": "docs/concepts/ARCHITECTURE.md"
          }
        ],
        "safetyCriticalRules": [
          "Human approval is required before creating Swarm Manager backlog items unless an accepted decision explicitly authorizes the exact proposal.",
          "Do not deploy teams, trigger external execution, or make code changes."
        ],
        "readOnlyModeBehavior": {
          "skipNewDecisions": true,
          "stillWriteKnowledge": true,
          "stillRunSupersession": true,
          "stillWriteHandoff": true
        },
        "newDecisionCapPerHeartbeat": 3,
        "taskParameters": {
          "requiredScenarioCoverageCheck": "Run swarm-manager initiatives context before proposing scenario-scoped initiatives.",
          "acceptedDecisionMarkerTopic": "decision-application/<decision-id>"
        }
      },
      "outcome-strategist": {
        "lane": "Interpret Command Center outcomes when real metrics exist; otherwise produce blocked handoffs.",
        "ownedDecisionContexts": [
          "outcome-gap",
          "outcome-direction"
        ],
        "pendingOwnedDecisionCap": 3,
        "requiredKnowledgeTopics": [
          "outcome-snapshot-YYYY-MM-DD",
          "decision-application/<decision-id>"
        ],
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "decision"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "kind": "task"
          },
          {
            "base": "repo-root",
            "path": "docs/director-swarm/"
          },
          {
            "base": "repo-root",
            "path": "docs/concepts/ARCHITECTURE.md"
          }
        ],
        "safetyCriticalRules": [
          "Stay blocked until Command Center exposes stable outcome surfaces.",
          "Recommend; do not authorize portfolio changes."
        ],
        "readOnlyModeBehavior": {
          "skipNewDecisions": true,
          "stillWriteKnowledge": true,
          "stillRunSupersession": true,
          "stillWriteHandoff": true
        },
        "newDecisionCapPerHeartbeat": 3
      },
      "vision-walk-prep": {
