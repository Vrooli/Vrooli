      "showDecisionLogGuidance": true,
      "showKnowledgeLogGuidance": true,
      "requireHandoff": true
    }
  },
  "execution": {
    "queuePolicy": "bounded-parallel",
    "maxConcurrentRuns": 2
  },
  "decisionMode": "approval",
  "shared": {
    "path": "shared/",
    "mountHint": "readWrite"
  },
  "revision": 13,
  "createdAt": "2026-02-09T12:00:00Z",
  "updatedAt": "2026-04-22T11:17:21Z",
  "operatingContract": {
