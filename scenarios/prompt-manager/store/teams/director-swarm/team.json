{
  "kind": "team",
  "schemaVersion": 1,
  "id": "director-swarm",
  "displayName": "Director Swarm",
  "mission": "Keep Vrooli's initiative portfolio flowing through Swarm Manager and surface outcome-driven strategy as Command Center comes online.",
