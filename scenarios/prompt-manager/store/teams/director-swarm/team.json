        "ownerMemberIds": [
          "portfolio-manager"
        ],
        "description": "Proposed supporting backlog work under existing initiatives."
      },
      "initiative-proposal": {
        "ownerMemberIds": [
          "portfolio-manager"
        ],
        "description": "Candidate new initiatives for operator approval."
      },
      "initiative-readiness": {
        "ownerMemberIds": [
          "portfolio-manager"
        ],
        "description": "Judgment about whether backlog items are detailed enough to execute."
      },
      "outcome-gap": {
        "ownerMemberIds": [
          "outcome-strategist"
        ],
        "description": "Approval to build missing Command Center data pipelines."
      },
      "outcome-direction": {
        "ownerMemberIds": [
          "outcome-strategist"
        ],
        "description": "Outcome-driven recommendation that would change portfolio emphasis."
      },
      "vision-update": {
        "ownerMemberIds": [
          "vision-walk-prep"
        ],
        "externalAuthorizedRaisers": [
          "operator"
        ],
        "description": "Operator-authored vision or architecture canon drift signal; prep surfaces only."
      }
