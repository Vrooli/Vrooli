{
  "intake": [
    {
      "prefix": "bug-inbox/*",
      "taxonomy": "bug-report",
      "source_team": "*"
    }
  ],
  "required_read": [
    {
      "prefix": "bug-investigation-report/<slug>"
    }
  ],
  "evidence_consumed": [
    {
      "prefix": "challenge-report/*",
      "for_decisions": [
        "bug-resolution-proposal"
      ]
    }
  ],
  "output": [
    {
      "prefix": "bug-investigation-report/*",
      "destination_kind": "knowledge"
    }
  ],
  "decisions_owned": [
    "bug-resolution-proposal"
  ],
  "decisions_consumed": [
    "capability-gap"
  ],
  "raises_capability_gaps": true,
  "external_producers": [
    "report-bug"
  ]
}
