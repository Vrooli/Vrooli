{
  "required_read": [
    {
      "prefix": "team-audit/YYYY-MM-DD"
    },
    {
      "prefix": "agent-audit/YYYY-MM-DD"
    },
    {
      "prefix": "team-visited/<team-id>"
    },
    {
      "prefix": "agent-visited/<agent-id>"
    },
    {
      "prefix": "friction-report/prompt-team-agent-storage/<YYYY-MM-DD>/<slug>"
    }
  ],
  "evidence_consumed": [
    {
      "prefix": "challenge-report/*",
      "for_decisions": [
        "agent-improvement",
        "agent-deprecation",
        "team-structure-change",
        "team-deprecation",
        "capability-gap"
      ]
    },
    {
      "prefix": "challenge-resolution-record/*",
      "for_decisions": [
        "agent-improvement",
        "agent-deprecation",
        "team-structure-change",
        "team-deprecation",
        "capability-gap"
      ]
    }
  ],
  "output": [
    {
      "prefix": "team-audit/*",
      "destination_kind": "knowledge"
    },
    {
      "prefix": "agent-audit/*",
      "destination_kind": "knowledge"
    },
    {
      "prefix": "team-visited/*",
      "destination_kind": "knowledge"
    },
    {
      "prefix": "agent-visited/*",
      "destination_kind": "knowledge"
    }
  ],
  "decisions_owned": [
    "agent-improvement",
    "agent-deprecation",
    "team-structure-change",
    "team-deprecation",
    "capability-gap"
  ],
  "raises_capability_gaps": true,
  "external_producers": [
    "operator"
  ]
}
