    "members": {
      "brand-manager": {
        "lane": "Steward marketing and narrative canon, drain typed marketing-craft observations, and propose campaigns only when signal warrants.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/marketing/"
          },
          {
            "base": "repo-root",
            "path": "docs/narrative/"
          }
        ],
        "safetyCriticalRules": [
          "Do not review individual drafts; the producer drafts independently, and per-draft review belongs to the contrarian and the operator approval gate.",
          "Do not edit plan-of-record files directly; propose promotions, retirements, or canon edits through the relevant work item."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "narrativeCanonTriggers": [
            "approved work item changes positioning",
            "new SKU ships or launch window opens",
            "systematic drift across >=3 recent drafts",
            "typed marketing-craft observation reaches promotion threshold",
            "operator-flagged drift"
          ]
        }
      },
      "marketing-contrarian": {
        "lane": "Challenge pending marketing proposals against the failure-mode framework and run stale work item hygiene. Also this team's shape sensor: hold the team against the target model's deviation catalogue and report deviations; never restructure.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/marketing/"
          },
          {
            "base": "repo-root",
            "path": "docs/narrative/"
          }
        ],
        "safetyCriticalRules": [
          "Never generate positive-action work items.",
          "Do not invent new failure modes inside a challenge; propose framework-update instead.",
          "Do not relitigate resolved work items."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        },
        "taskParameters": {
          "failureModeFrameworkSource": "docs/marketing/strategy/STRATEGY.md#anti-patterns",
          "reviewPostTypeV1Status": true
        }
      },
      "producer": {
        "lane": "Sole draft producer. Draws open campaign work from content-desk, gathers the evidence that work needs, and drafts against it with every factual assertion declared as a claim. Lane is a field on the draft, not a member.",
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/marketing/"
          },
          {
            "base": "repo-root",
            "path": "docs/monetization/"
          },
          {
            "base": "repo-root",
            "path": "docs/narrative/"
          }
        ],
        "safetyCriticalRules": [
          "Never publish, and never approve your own draft. The operator is the only approver.",
          "Frame OSS self-host as deliberate brand credibility, not a revenue leak.",
          "Never frame subscriptions as paywalling core features.",
          "Never hallucinate engagement numbers.",
          "If a source system is unhealthy, raise capability work item instead of shipping partial claims.",
          "Audience and post-type proposals require at least three converging scans."
        ],
        "readOnlyModeBehavior": {
          "stillWriteKnowledge": true,
          "stillWriteHandoff": true
        }
