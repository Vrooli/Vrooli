    "decisionContexts": {
      "audience-update": {
        "ownerMemberIds": [
          "producer"
        ],
        "description": "Persona or audience canon revision backed by converging observations."
      },
      "brand-guideline-update": {
        "ownerMemberIds": [
          "brand-manager"
        ],
        "description": "Plan-of-record edit proposal across marketing or narrative canon."
      },
      "campaign-launch-proposal": {
        "ownerMemberIds": [
          "brand-manager"
        ],
        "description": "Multi-artifact campaign with theme, timing, channel mix, and acquisition/retention hypothesis."
      },
      "capability-gap": {
        "ownerMemberIds": [
          "producer"
        ],
        "description": "Missing scenario, skill, or tool capability blocks marketing work; consumed by director-swarm.",
        "externalAuthorizedRaisers": [
          "meta-optimization"
        ]
      },
      "channel-strategy-update": {
        "ownerMemberIds": [
          "producer"
        ],
        "description": "Strategic channel priority or activation update."
      },
      "channel-update": {
        "ownerMemberIds": [
          "brand-manager"
        ],
        "description": "Operational per-platform rule change based on publishing friction. Reassigned from publisher; moves to the scheduler team once account operations have a home."
      },
      "coverage-gap": {
        "ownerMemberIds": [
          "producer"
        ],
        "description": "Deployed or imminent SKU/app has stale or missing marketing coverage."
      },
      "decision-rejection-proposed": {
        "ownerMemberIds": [
          "marketing-contrarian"
        ],
        "description": "Contrarian recommends rejecting or revising a pending marketing proposal."
      },
      "framework-update": {
        "ownerMemberIds": [
          "marketing-contrarian"
        ],
        "description": "Marketing failure-mode framework needs a concrete update."
      },
      "hook-candidate-promotion": {
        "ownerMemberIds": [
