        ],
        "description": "Promote observed stable hooks into hook-library canon."
      },
      "post-type-proposal": {
        "ownerMemberIds": [
          "producer"
        ],
        "description": "New post-type doc plus paired skill proposal backed by format-trend scans."
      }
