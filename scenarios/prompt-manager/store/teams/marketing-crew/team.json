    "members": {
      "brand-manager": {
        "lane": "Steward marketing and narrative canon, curate the marketing notebook, and propose campaigns only when signal warrants.",
        "ownedDecisionContexts": [
          "campaign-launch-proposal",
          "brand-guideline-update",
          "notebook-promotion",
          "notebook-retirement"
        ],
        "pendingOwnedDecisionCap": 3,
        "allowedWrites": [
          {
            "kind": "knowledge"
          },
          {
            "kind": "decision"
          },
          {
            "kind": "handoff"
          }
        ],
        "forbiddenWrites": [
          {
            "base": "repo-root",
            "path": "docs/marketing/"
          },
          {
            "base": "repo-root",
            "path": "docs/narrative/"
          }
        ],
        "safetyCriticalRules": [
          "Do not review individual drafts before publisher; advertisers produce first-class drafts independently.",
          "Do not edit plan-of-record or notebook entries directly; propose promotions, retirements, or canon edits."
        ],
        "readOnlyModeBehavior": {
          "skipNewDecisions": true,
          "stillWriteKnowledge": true,
          "stillRunSupersession": true,
          "stillWriteHandoff": true
        },
        "newDecisionCapsByContext": {
          "campaign-launch-proposal": 1,
          "brand-guideline-update": 1,
          "notebook-promotion": 2,
          "notebook-retirement": 2
        },
        "taskParameters": {
          "narrativeCanonTriggers": [
            "accepted decision changes positioning",
            "new SKU ships or launch window opens",
            "systematic drift across >=3 recent drafts",
            "notebook entry reaches promotion threshold",
            "operator-flagged drift"
          ]
        }
      },
      "subscription-advertiser": {
        "lane": "Subscription-lane advertiser in the shared draft pipeline. Consumes subscription artifact requests, marketing evidence, canon, coverage, and publish state; writes campaign drafts plus coverage/capability proposals without editing canon or publishing.",
        "ownedDecisionContexts": [
          "content-publish-proposal",
          "coverage-gap",
          "capability-gap"
        ],
        "pendingOwnedDecisionCap": 3,
        "allowedWrites": [
          {
            "base": "team-shared",
            "path": "campaign-drafts.jsonl"
          },
          {
            "base": "repo-root",
            "path": "docs/marketing/notebook/"
          },
          {
            "kind": "knowledge"
          },
          {
            "kind": "decision"
          },
          {
            "kind": "handoff"
          }
        ],
