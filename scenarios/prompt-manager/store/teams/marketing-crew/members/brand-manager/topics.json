    {
      "prefix": "competitor-record/*"
    },
    {
      "prefix": "hook-record/*"
    },
    {
      "prefix": "channel-scan/*"
    },
    {
      "prefix": "format-scan/*"
    },
    {
      "prefix": "publish-log/*"
    },
    {
