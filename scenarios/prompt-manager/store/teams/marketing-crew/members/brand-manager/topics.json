{
  "intake": [
    {
      "prefix": "marketing/notebook/*",
      "taxonomy": "notebook-debt"
    }
  ],
  "required_read": [
    {
      "prefix": "brand-snapshot/YYYY-MM-DD"
    }
  ],
  "evidence_consumed": [
    {
      "prefix": "challenge-report/*",
      "for_decisions": [
        "campaign-launch-proposal",
        "brand-guideline-update",
        "notebook-promotion",
        "notebook-retirement"
      ]
    },
    {
      "prefix": "challenge-resolution-record/*",
      "for_decisions": [
        "campaign-launch-proposal",
        "brand-guideline-update",
        "notebook-promotion",
        "notebook-retirement"
      ]
    }
  ],
  "output": [
    {
      "prefix": "marketing-canon/*",
      "destination_kind": "por_file",
      "destination_path": "docs/marketing/STRATEGY.md"
    },
    {
      "prefix": "marketing-canon/*",
      "destination_kind": "por_file",
      "destination_path": "docs/marketing/AUDIENCES.md"
    },
    {
      "prefix": "brand-snapshot/*",
      "destination_kind": "knowledge"
    }
  ],
  "decisions_owned": [
    "campaign-launch-proposal",
    "brand-guideline-update",
    "notebook-promotion",
    "notebook-retirement"
  ],
  "decisions_consumed": [
    "capability-gap"
  ],
  "external_producers": [
    "operator",
    "vision-walk"
  ]
}
