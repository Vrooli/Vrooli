{
  "required_read": [
    {
      "prefix": "artifact-request/subscription/*"
    },
    {
      "prefix": "audience-scan/*"
    },
    {
      "prefix": "competitor-record/*"
    },
    {
      "prefix": "hook-record/*"
    },
    {
      "prefix": "workflow-scan/*"
    },
    {
      "prefix": "skill-scan/*"
    },
    {
      "prefix": "channel-scan/*"
    },
    {
      "prefix": "format-scan/*"
    },
    {
      "prefix": "publish-log/*"
    },
    {
      "prefix": "coverage-snapshot/*"
    },
    {
      "prefix": "subscription-ad-run/YYYY-MM-DD"
    }
  ],
  "evidence_consumed": [
    {
      "prefix": "challenge-report/*",
      "for_decisions": [
        "content-publish-proposal",
        "coverage-gap",
        "capability-gap"
      ]
    },
    {
      "prefix": "challenge-resolution-record/*",
      "for_decisions": [
        "content-publish-proposal",
        "coverage-gap",
        "capability-gap"
      ]
    }
  ],
  "output": [
    {
      "prefix": "campaign-draft/*",
      "destination_kind": "knowledge"
    },
    {
      "prefix": "subscription-ad-run/*",
      "destination_kind": "knowledge"
    }
  ],
  "decisions_owned": [
    "content-publish-proposal",
    "coverage-gap"
  ],
  "decisions_consumed": [
    "capability-gap"
  ],
  "raises_capability_gaps": true,
  "external_producers": [
    "operator",
    "vision-walk"
  ]
}
