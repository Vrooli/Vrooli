{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/team.schema.json",
  "title": "Team",
  "description": "A group with shared intent and org structure",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "displayName",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "team",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique identifier in kebab-case"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name"
    },
    "mission": {
      "type": "string",
      "maxLength": 500,
      "description": "Team's purpose statement"
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the team is enabled for scheduled heartbeats"
    },
    "spawnMode": {
      "type": "string",
      "enum": ["multi-process", "single-process"],
      "default": "multi-process",
      "description": "How the team is spawned: multi-process (separate agent per member) or single-process (one CC Team lead agent)"
    },
    "shared": {
      "type": "object",
      "description": "Team shared documents configuration",
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to shared docs folder"
        },
        "mountHint": {
          "type": "string",
          "enum": ["readOnly", "readWrite"],
          "default": "readOnly",
          "description": "Access mode hint for runtime"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for optimistic concurrency"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    }
  },
  "additionalProperties": false
}
