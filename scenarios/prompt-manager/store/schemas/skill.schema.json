{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/skill.schema.json",
  "title": "Skill",
  "description": "A reusable guidance document with declared requirements",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "name",
    "status",
    "entry",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "skill",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique identifier in kebab-case"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief description of the skill's purpose"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Contexts where the skill applies (e.g., steer, search)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Categorization tags"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for UI display"
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "archived"],
      "description": "Publication status"
    },
    "entry": {
      "type": "string",
      "description": "Path to the content file relative to skill folder"
    },
    "targetToolId": {
      "type": ["string", "null"],
      "description": "Optional tool/skill dependency"
    },
    "programmaticHome": {
      "type": ["string", "null"],
      "description": "Record-of-fact pointer (format 'engine:identifier', e.g. 'test-genie:architecture') set when this skill's detection has graduated into a programmatic engine. Null while the skill's detection is still agentic. Meaningful for steer skills; the quality-auditor derives its audit rotation from steer skills where this is null."
    },
    "requires": {
      "type": "object",
      "description": "Declared requirements for capability gating",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capabilityId", "verbs"],
            "properties": {
              "capabilityId": {
                "type": "string",
                "description": "Capability identifier (e.g., service.action)"
              },
              "verbs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["read", "write", "execute"]
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "Required permission verbs"
              }
            }
          }
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for optimistic concurrency"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    }
  },
  "additionalProperties": false
}
