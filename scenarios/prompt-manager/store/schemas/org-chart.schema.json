{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/org-chart.schema.json",
  "title": "OrgChart",
  "description": "Organizational hierarchy edges for a team",
  "type": "object",
  "required": ["kind", "schemaVersion", "teamId", "edges"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "org-chart",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Reference to parent team"
    },
    "edges": {
      "type": "array",
      "description": "Manager-report relationships",
      "items": {
        "type": "object",
        "required": ["managerAgentId", "reportAgentId"],
        "properties": {
          "managerAgentId": {
            "type": "string",
            "description": "Agent ID of the manager"
          },
          "reportAgentId": {
            "type": "string",
            "description": "Agent ID of the direct report"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
