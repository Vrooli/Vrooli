{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/action.schema.json",
  "title": "Action",
  "description": "A typed executable wrapper over exactly one Vrooli-controlled CLI command",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "name",
    "status",
    "owner",
    "command",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "action",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 96,
      "description": "Unique Action identifier, allowing dotted namespaces"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "archived"]
    },
    "owner": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["project", "scenario", "resource", "team"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "description": "Exact argv template; never a shell string"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "file", "path", "scenario", "team", "action"]
          },
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "enum": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "default": {},
          "pattern": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1
          },
          "allowMultiline": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "file", "path", "json"]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "filesystemRead": {
          "type": "boolean"
        },
        "filesystemWrite": {
          "type": "boolean"
        },
        "localhostNetwork": {
          "type": "boolean"
        },
        "externalNetwork": {
          "type": "boolean"
        },
        "apiRead": {
          "type": "boolean"
        },
        "apiWrite": {
          "type": "boolean"
        },
        "processStart": {
          "type": "boolean"
        },
        "processStop": {
          "type": "boolean"
        },
        "hostConfigure": {
          "type": "boolean"
        },
        "secretRead": {
          "type": "boolean"
        },
        "secretWrite": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "input": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "outputMode": {
          "type": "string",
          "enum": ["", "stdout", "json"]
        },
        "runEligible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["", "contract", "owner"]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
