{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment",
  "description": "An A/B test tying skill variants together with weighted traffic splitting",
  "type": "object",
  "required": ["kind", "schemaVersion", "id", "skillId", "name", "status", "arms", "revision", "createdAt", "updatedAt"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "experiment"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "skillId": {
      "type": "string",
      "description": "ID of the skill being tested"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "hypothesis": {
      "type": "string",
      "maxLength": 1000,
      "description": "What you expect to learn from this experiment"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "running", "concluded"]
    },
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["variantId", "weight"],
        "properties": {
          "variantId": {
            "type": "string",
            "description": "Variant ID or 'control' for the original SKILL.md"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "description": "Traffic weight (0-1, all arms must sum to 1.0)"
          }
        },
        "additionalProperties": false
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "concludedAt": {
      "type": "string",
      "format": "date-time"
    },
    "winnerVariantId": {
      "type": "string",
      "description": "Variant ID of the winner (set on conclusion)"
    },
    "notes": {
      "type": "string",
      "description": "Notes recorded when concluding the experiment"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
