{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/team-roles.schema.json",
  "title": "TeamRoles",
  "description": "Role definitions for a team",
  "type": "object",
  "required": ["kind", "schemaVersion", "teamId", "roles"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "team-roles",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Reference to parent team"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Role identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Human-readable role name"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "description": "Role responsibilities"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
