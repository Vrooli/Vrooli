{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/agent.schema.json",
  "title": "Agent",
  "description": "A persistent identity that can be assigned skills and team memberships",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "displayName",
    "status",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "agent",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique identifier in kebab-case"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "suspended"],
      "description": "Agent operational status"
    },
    "appearance": {
      "type": "object",
      "description": "Visual representation in 3D UI",
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Body color as hex"
        },
        "head": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Head color as hex"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Accent color as hex"
        }
      },
      "additionalProperties": false
    },
    "skillPins": {
      "type": "array",
      "description": "Inline skill pins for simple cases",
      "items": {
        "type": "object",
        "required": ["skillId"],
        "properties": {
          "skillId": {
            "type": "string",
            "description": "Reference to skill ID"
          },
          "version": {
            "type": "string",
            "default": "latest",
            "description": "Pinned version or 'latest'"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "object",
      "description": "Pointers to runtime state (owned by workspace-sandbox)",
      "properties": {
        "workspaceRef": {
          "type": "string",
          "description": "URI to workspace runtime state"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for optimistic concurrency"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    }
  },
  "additionalProperties": false
}
