{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/agent.schema.json",
  "title": "Agent",
  "description": "A persistent identity that can be assigned skills and team memberships",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "displayName",
    "status",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "agent",
      "description": "Entity type discriminator"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward compatibility"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique identifier in kebab-case"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Brief description of the agent's purpose"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "suspended"],
      "description": "Agent operational status"
    },
    "appearance": {
      "type": "object",
      "description": "Visual representation in 3D UI",
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Body color as hex"
        },
        "head": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Head color as hex"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Accent color as hex"
        }
      },
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "description": "Agent personality and behavior configuration",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Path to persona file (e.g., SOUL.md)"
        },
        "voice": {
          "type": "string",
          "enum": ["professional", "casual", "technical", "empathetic", "terse"],
          "description": "Communication style"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Personality traits (e.g., meticulous, security-focused)"
        },
        "systemPromptPrefix": {
          "type": "string",
          "description": "Optional inline prefix for simple cases"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "description": "Capability requirements and provisions",
      "properties": {
        "provides": {
          "type": "array",
          "description": "Capabilities this agent provides",
          "items": {
            "type": "object",
            "required": ["capabilityId"],
            "properties": {
              "capabilityId": {
                "type": "string",
                "description": "Capability identifier (e.g., code.review)"
              },
              "verbs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Allowed operations (e.g., execute, read)"
              }
            },
            "additionalProperties": false
          }
        },
        "requires": {
          "type": "array",
          "description": "Capabilities this agent requires",
          "items": {
            "type": "object",
            "required": ["capabilityId"],
            "properties": {
              "capabilityId": {
                "type": "string",
                "description": "Capability identifier (e.g., codebase.read)"
              },
              "verbs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Required operations"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "connectors": {
      "type": "array",
      "description": "External system connectors",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["scenario", "mcp", "api"],
            "description": "Connector type"
          },
          "id": {
            "type": "string",
            "description": "Connector identifier"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Whether this connector is enabled"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultProfileRef": {
      "type": "string",
      "description": "URI reference to default profile (e.g., agent-manager://profiles/default)"
    },
    "heartbeat": {
      "type": "object",
      "description": "Health monitoring configuration",
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30,
          "description": "Heartbeat interval in seconds"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 120,
          "description": "Timeout before considering agent unhealthy"
        },
        "maxMissedBeats": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Max missed heartbeats before marking inactive"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags for categorization"
    },
    "skillPins": {
      "type": "array",
      "description": "Inline skill pins for simple cases",
      "items": {
        "type": "object",
        "required": ["skillId"],
        "properties": {
          "skillId": {
            "type": "string",
            "description": "Reference to skill ID"
          },
          "version": {
            "type": "string",
            "default": "latest",
            "description": "Pinned version or 'latest'"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "object",
      "description": "Pointers to runtime state (owned by workspace-sandbox)",
      "properties": {
        "workspaceRef": {
          "type": "string",
          "description": "URI to workspace runtime state"
        }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number for optimistic concurrency"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last update timestamp"
    }
  },
  "additionalProperties": false
}
