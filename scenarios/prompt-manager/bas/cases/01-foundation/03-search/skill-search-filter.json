{
  "metadata": {
    "name": "skill-search-filter",
    "description": "Validate skill search filters update the empty state",
    "labels": {
      "reset": "none"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "prompt-manager",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open Prompt Manager"
        }
      }
    },
    {
      "id": "wait-sidebar",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.container",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for sidebar"
        }
      }
    },
    {
      "id": "wait-search-input",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.searchInput",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for search input"
        }
      }
    },
    {
      "id": "type-non-matching-query",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": {
          "selector": "@selector/sidebar.searchInput",
          "value": "zzzz-bas-no-match",
          "clear_first": true
        },
        "metadata": {
          "label": "Search for non-matching query"
        }
      }
    },
    {
      "id": "wait-filter-update",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 500
        },
        "metadata": {
          "label": "Wait for filter update"
        }
      }
    },
    {
      "id": "assert-empty-state",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/sidebar.emptyState",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 5000,
          "failure_message": "Empty state should appear for non-matching search"
        },
        "metadata": {
          "label": "Empty state visible"
        }
      }
    },
    {
      "id": "clear-search",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": {
          "selector": "@selector/sidebar.searchInput",
          "value": "",
          "clear_first": true
        },
        "metadata": {
          "label": "Clear search input"
        }
      }
    },
    {
      "id": "wait-clear-update",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 500
        },
        "metadata": {
          "label": "Wait for reset"
        }
      }
    },
    {
      "id": "assert-empty-state-cleared",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/sidebar.emptyState",
          "mode": "ASSERTION_MODE_NOT_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Empty state should clear after resetting search"
        },
        "metadata": {
          "label": "Empty state cleared"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-home",
      "target": "wait-sidebar",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "wait-sidebar",
      "target": "wait-search-input",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "wait-search-input",
      "target": "type-non-matching-query",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "type-non-matching-query",
      "target": "wait-filter-update",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "wait-filter-update",
      "target": "assert-empty-state",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "assert-empty-state",
      "target": "clear-search",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "clear-search",
      "target": "wait-clear-update",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "wait-clear-update",
      "target": "assert-empty-state-cleared",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
