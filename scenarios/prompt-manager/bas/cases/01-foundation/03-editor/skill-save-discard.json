{
  "metadata": {
    "name": "skill-save-discard",
    "description": "Validate saving and discarding skill edits updates editor state",
    "labels": {
      "reset": "none"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "prompt-manager",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open Prompt Manager"
        }
      }
    },
    {
      "id": "wait-sidebar",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.container",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for sidebar"
        }
      }
    },
    {
      "id": "wait-expand-all",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.expandAllButton",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for expand all"
        }
      }
    },
    {
      "id": "click-expand-all",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/sidebar.expandAllButton"
        },
        "metadata": {
          "label": "Expand all nodes"
        }
      }
    },
    {
      "id": "wait-skill-row",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.skillRow",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for skill row"
        }
      }
    },
    {
      "id": "open-first-skill",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/sidebar.skillRow"
        },
        "metadata": {
          "label": "Open first skill"
        }
      }
    },
    {
      "id": "wait-editor-header",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/editor.header",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for editor header"
        }
      }
    },
    {
      "id": "wait-name-display",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/editor.nameDisplay",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for skill name"
        }
      }
    },
    {
      "id": "store-original-name",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const original = document.querySelector('[data-testid=\"skill-editor-name-display\"]')?.textContent?.trim() || ''; window.__basOriginalSkillName = original; return original; })()",
          "store_result": "originalSkillName"
        },
        "metadata": {
          "label": "Store original skill name"
        }
      }
    },
    {
      "id": "store-updated-name",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
      "expression": "(() => { const rawBase = window.__basOriginalSkillName || document.querySelector('[data-testid=\"skill-editor-name-display\"]')?.textContent?.trim() || 'Skill'; const base = rawBase.replace(/\\s+BAS-\\d+(?:\\s+\\(discard\\))?/g, '').trim() || 'Skill'; const updated = `${base} BAS-${Date.now()}`; window.__basUpdatedSkillName = updated; return updated; })()",
          "store_result": "updatedSkillName"
        },
        "metadata": {
          "label": "Generate updated skill name"
        }
      }
    },
    {
      "id": "click-name-display",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/editor.nameDisplay"
        },
        "metadata": {
          "label": "Edit skill name"
        }
      }
    },
    {
      "id": "wait-name-input",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/editor.nameInput",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for name input"
        }
      }
    },
    {
      "id": "update-name",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const input = document.querySelector('[data-testid=\"skill-editor-name-input\"]'); if (!(input instanceof HTMLInputElement)) { throw new Error('Skill name input not found'); } const updated = window.__basUpdatedSkillName; if (!updated) { throw new Error('Updated skill name not prepared'); } const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value')?.set; if (!setter) { throw new Error('HTMLInputElement value setter unavailable'); } setter.call(input, updated); input.dispatchEvent(new Event('input', { bubbles: true })); input.dispatchEvent(new Event('change', { bubbles: true })); return input.value; })()"
        },
        "metadata": {
          "label": "Update skill name"
        }
      }
    },
    {
      "id": "commit-name-update",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": {
          "keys": [
            "Enter"
          ]
        },
        "metadata": {
          "label": "Commit skill name update"
        }
      }
    },
    {
      "id": "assert-unsaved-visible",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/editor.unsavedIndicator",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 5000,
          "failure_message": "Unsaved indicator should appear after editing"
        },
        "metadata": {
          "label": "Unsaved indicator visible"
        }
      }
    },
    {
      "id": "click-save",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/editor.saveButton"
        },
        "metadata": {
          "label": "Save skill"
        }
      }
    },
    {
      "id": "wait-save",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 1000
        },
        "metadata": {
          "label": "Wait for save"
        }
      }
    },
    {
      "id": "assert-unsaved-cleared",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/editor.unsavedIndicator",
          "mode": "ASSERTION_MODE_NOT_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Unsaved indicator should clear after save"
        },
        "metadata": {
          "label": "Unsaved indicator cleared"
        }
      }
    },
    {
      "id": "assert-name-saved",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const expected = window.__basUpdatedSkillName; const actual = document.querySelector('[data-testid=\"skill-editor-name-display\"]')?.textContent?.trim() || ''; if (!expected) { throw new Error('Updated skill name missing from window'); } if (actual !== expected) { throw new Error(`Skill name should reflect saved value (expected=${expected}, actual=${actual})`); } return true; })()"
        },
        "metadata": {
          "label": "Saved name visible"
        }
      }
    },
    {
      "id": "store-discard-name",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const base = window.__basUpdatedSkillName; if (!base) { throw new Error('Updated skill name missing before discard'); } const discard = `${base} (discard)`; window.__basDiscardSkillName = discard; return discard; })()",
          "store_result": "discardSkillName"
        },
        "metadata": {
          "label": "Generate discard name"
        }
      }
    },
    {
      "id": "click-name-display-again",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/editor.nameDisplay"
        },
        "metadata": {
          "label": "Edit skill name again"
        }
      }
    },
    {
      "id": "wait-name-input-again",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/editor.nameInput",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for name input"
        }
      }
    },
    {
      "id": "update-name-discard",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const input = document.querySelector('[data-testid=\"skill-editor-name-input\"]'); if (!(input instanceof HTMLInputElement)) { throw new Error('Skill name input not found'); } const discard = window.__basDiscardSkillName; if (!discard) { throw new Error('Discard skill name not prepared'); } const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value')?.set; if (!setter) { throw new Error('HTMLInputElement value setter unavailable'); } setter.call(input, discard); input.dispatchEvent(new Event('input', { bubbles: true })); input.dispatchEvent(new Event('change', { bubbles: true })); return input.value; })()"
        },
        "metadata": {
          "label": "Update name for discard"
        }
      }
    },
    {
      "id": "commit-discard-name-update",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": {
          "keys": [
            "Enter"
          ]
        },
        "metadata": {
          "label": "Commit discard name update"
        }
      }
    },
    {
      "id": "assert-unsaved-visible-discard",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/editor.unsavedIndicator",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 5000,
          "failure_message": "Unsaved indicator should appear before discard"
        },
        "metadata": {
          "label": "Unsaved indicator visible"
        }
      }
    },
    {
      "id": "open-actions-menu",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/editor.actionsMenu"
        },
        "metadata": {
          "label": "Open actions menu"
        }
      }
    },
    {
      "id": "wait-discard-action",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/editor.discardAction",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Wait for discard action"
        }
      }
    },
    {
      "id": "click-discard-action",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/editor.discardAction"
        },
        "metadata": {
          "label": "Discard changes"
        }
      }
    },
    {
      "id": "wait-discard",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 500
        },
        "metadata": {
          "label": "Wait for discard"
        }
      }
    },
    {
      "id": "assert-unsaved-cleared-discard",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/editor.unsavedIndicator",
          "mode": "ASSERTION_MODE_NOT_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Unsaved indicator should clear after discard"
        },
        "metadata": {
          "label": "Unsaved indicator cleared"
        }
      }
    },
    {
      "id": "assert-name-restored",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const expected = window.__basUpdatedSkillName; const actual = document.querySelector('[data-testid=\"skill-editor-name-display\"]')?.textContent?.trim() || ''; if (!expected) { throw new Error('Updated skill name missing before restore check'); } if (actual !== expected) { throw new Error(`Skill name should revert after discard (expected=${expected}, actual=${actual})`); } return true; })()"
        },
        "metadata": {
          "label": "Name restored after discard"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-home",
      "target": "wait-sidebar",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "wait-sidebar",
      "target": "wait-expand-all",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "wait-expand-all",
      "target": "click-expand-all",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "click-expand-all",
      "target": "wait-skill-row",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "wait-skill-row",
      "target": "open-first-skill",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "open-first-skill",
      "target": "wait-editor-header",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "wait-editor-header",
      "target": "wait-name-display",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "wait-name-display",
      "target": "store-original-name",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e9",
      "source": "store-original-name",
      "target": "store-updated-name",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e10",
      "source": "store-updated-name",
      "target": "click-name-display",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e11",
      "source": "click-name-display",
      "target": "wait-name-input",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e12",
      "source": "wait-name-input",
      "target": "update-name",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e13",
      "source": "update-name",
      "target": "commit-name-update",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e14",
      "source": "commit-name-update",
      "target": "assert-unsaved-visible",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e15",
      "source": "assert-unsaved-visible",
      "target": "click-save",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e16",
      "source": "click-save",
      "target": "wait-save",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e17",
      "source": "wait-save",
      "target": "assert-unsaved-cleared",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e18",
      "source": "assert-unsaved-cleared",
      "target": "assert-name-saved",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e19",
      "source": "assert-name-saved",
      "target": "store-discard-name",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e20",
      "source": "store-discard-name",
      "target": "click-name-display-again",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e21",
      "source": "click-name-display-again",
      "target": "wait-name-input-again",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e22",
      "source": "wait-name-input-again",
      "target": "update-name-discard",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e23",
      "source": "update-name-discard",
      "target": "commit-discard-name-update",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e24",
      "source": "commit-discard-name-update",
      "target": "assert-unsaved-visible-discard",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e25",
      "source": "assert-unsaved-visible-discard",
      "target": "open-actions-menu",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e26",
      "source": "open-actions-menu",
      "target": "wait-discard-action",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e27",
      "source": "wait-discard-action",
      "target": "click-discard-action",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e28",
      "source": "click-discard-action",
      "target": "wait-discard",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e29",
      "source": "wait-discard",
      "target": "assert-unsaved-cleared-discard",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e30",
      "source": "assert-unsaved-cleared-discard",
      "target": "assert-name-restored",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
