    { "id": "active-ready", "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "@selector/teamDashboard.root", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 30000 }, "metadata": { "label": "Wait for active dashboard" } } },
