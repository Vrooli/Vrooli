    "labels": { "reset": "none", "safety": "read-only", "fixture_only": "true", "routed_isolation": "true" },
    "requirement": "UX-CAMPAIGN-003",
    "execution_mode": "observer"
  },
  "settings": { "viewport_width": 1440, "viewport_height": 900 },
  "nodes": [
