{
  "metadata": {
    "name": "member-create",
    "description": "Validate member creation adds a new member row",
    "labels": {
      "reset": "none"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "prompt-manager",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open Prompt Manager"
        }
      }
    },
    {
      "id": "wait-sidebar",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/sidebar.container",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for sidebar"
        }
      }
    },
    {
      "id": "click-members-tab",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/sidebar.tabMembers"
        },
        "metadata": {
          "label": "Switch to members tab"
        }
      }
    },
    {
      "id": "wait-members-list",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/members.list",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for members list"
        }
      }
    },
    {
      "id": "count-initial-members",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const count = document.querySelectorAll('[data-testid=\"member-row\"]').length; window.__basInitialMemberCount = count; return count; })()",
          "store_result": "initialMemberCount"
        },
        "metadata": {
          "label": "Count initial members"
        }
      }
    },
    {
      "id": "click-new-member",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/members.newButton"
        },
        "metadata": {
          "label": "Create new member"
        }
      }
    },
    {
      "id": "wait-member-create",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 1500
        },
        "metadata": {
          "label": "Wait for member creation"
        }
      }
    },
    {
      "id": "count-final-members",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const count = document.querySelectorAll('[data-testid=\"member-row\"]').length; window.__basFinalMemberCount = count; return count; })()",
          "store_result": "finalMemberCount"
        },
        "metadata": {
          "label": "Count final members"
        }
      }
    },
    {
      "id": "verify-member-count",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const initial = Number(window.__basInitialMemberCount || 0); const final = Number(window.__basFinalMemberCount || 0); if (!(final === initial + 1)) { throw new Error('Expected member count to increase by 1 (initial=' + initial + ', final=' + final + ')'); } return true; })()"
        },
        "metadata": {
          "label": "Verify member count increased"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-home",
      "target": "wait-sidebar",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "wait-sidebar",
      "target": "click-members-tab",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "click-members-tab",
      "target": "wait-members-list",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "wait-members-list",
      "target": "count-initial-members",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "count-initial-members",
      "target": "click-new-member",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "click-new-member",
      "target": "wait-member-create",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "wait-member-create",
      "target": "count-final-members",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "count-final-members",
      "target": "verify-member-count",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
