{
  "name": "@audio-tools/embed",
  "version": "0.0.1",
  "description": "Adoptable React component surface for the audio-tools scenario (STT, TTS, voice controls, settings panels).",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
