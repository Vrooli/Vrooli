{
  "version": 1,
  "operations": [
    {
      "id": "transcode",
      "summary": "Re-encode audio into another container, sample rate, channel count, or bitrate.",
      "family": "transform",
      "engine": "audio",
      "mechanism": "compute",
      "transport": "unary",
      "ports": {
        "inputs": [{"name": "audio", "type": "bytes"}],
        "outputs": [{"name": "audio", "type": "bytes"}]
      },
      "params": [
        {"name": "audio", "type": "bytes", "control": "file", "required": true},
        {
          "name": "output_format",
          "type": "AudioFormat",
          "control": "select",
          "default": "wav",
          "options": [
            {"value": "wav", "labelKey": "diagnostics.formatWav"},
            {"value": "mp3", "labelKey": "diagnostics.formatMp3"},
            {"value": "flac", "labelKey": "diagnostics.formatFlac"},
            {"value": "ogg", "labelKey": "diagnostics.formatOgg"},
            {"value": "aac", "labelKey": "diagnostics.formatAac"}
          ]
        },
        {
          "name": "input_format",
          "type": "AudioFormat",
          "control": "select",
          "default": "",
          "advanced": true,
          "options": [
            {"value": "", "labelKey": "diagnostics.audioOps.optionAuto"},
            {"value": "wav", "labelKey": "diagnostics.formatWav"},
            {"value": "mp3", "labelKey": "diagnostics.formatMp3"},
            {"value": "flac", "labelKey": "diagnostics.formatFlac"},
            {"value": "ogg", "labelKey": "diagnostics.formatOgg"},
            {"value": "aac", "labelKey": "diagnostics.formatAac"}
          ]
        },
        {"name": "sample_rate", "type": "int32", "control": "number", "default": "0", "min": 0, "max": 192000, "step": 1, "unit": "Hz", "advanced": true},
        {"name": "channels", "type": "int32", "control": "number", "default": "0", "min": 0, "max": 8, "step": 1, "advanced": true},
        {"name": "bitrate", "type": "int32", "control": "number", "default": "0", "min": 0, "max": 512000, "step": 1000, "unit": "bps", "advanced": true}
      ],
      "cli": {
        "group": "audio",
        "verb": "transcode",
        "service": "AudioProcessingService",
        "method": "Transcode",
        "flags": [
          {"name": "input", "field": "audio", "required": true},
          {"name": "output", "localOnly": true, "required": true},
          {"name": "output-format", "field": "output_format", "default": "wav", "values": ["wav", "mp3", "flac", "ogg", "aac"]},
          {"name": "input-format", "field": "input_format"},
          {"name": "sample-rate", "field": "sample_rate"},
          {"name": "channels", "field": "channels"},
          {"name": "bitrate", "field": "bitrate"}
        ]
      },
      "presentation": {
        "panel": "diagnostics",
        "order": 10,
        "labelKey": "diagnostics.audioOps.transcode.label",
        "descKey": "diagnostics.audioOps.transcode.description"
      },
      "requires": ["ffmpeg"],
      "consent": "none"
    },
