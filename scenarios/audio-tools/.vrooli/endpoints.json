    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Operational liveness/readiness probe; load balancers and `curl` must reach it without a Connect client."
      }
    },
    {
      "id": "health_status.get_provider_health",
      "path": "/vrooli.audio_tools.v1.health_status.HealthStatusService/GetProviderHealth",
