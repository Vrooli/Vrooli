{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "audio-tools",
    "displayName": "Audio Tools",
    "description": "Shared audio capabilities: STT, TTS, summarization, audio processing, provider routing (BYOK/LPBS/Local)",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.1.0"
    },
    "generated_at": "2026-05-16T17:00:03Z",
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    },
    "manifest_sha": "bf981a854ff9ecb47f454d773e57bb1ee262138035e02d26bf5226c00b8961ea",
    "content_sha": "65a572a83cb605354b7482b2e2eacc02fbe131f2ea8a058878f9a5692fa84325"
  },
  "cli": {
    "enabled": true,
    "command": "audio-tools",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "invoke": {
      "kind": "installed_command",
      "command": "audio-tools"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "port": 20004
    }
  },
  "hostTools": [
    {
      "name": "ffmpeg",
      "required": false,
      "reason": "Transcode arbitrary audio uploads into Whisper-friendly formats during STT processing",
      "when": [
        "setup",
        "develop"
      ],
      "notes": "Audio transcoding falls back to passing raw audio when ffmpeg is unavailable"
    }
  ],
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/audio-tools-api"
            ]
          },
          {
            "type": "cli",
            "command": "audio-tools"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o audio-tools-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "cd ui && corepack pnpm install --ignore-workspace",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "cd ui && corepack pnpm --ignore-workspace run build",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && GOWORK=off go run .",
          "description": "Start Go API through the managed Go module lifecycle",
          "background": true,
          "condition": {
            "file_exists": "api/go.mod"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute audio-tools --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Lifecycle manager stops registered background processes",
      "steps": []
    }
  },
  "dependencies": {
    "resources": {
      "whisper": {
        "required": false,
        "notes": "Local STT tier (faster-whisper engine)"
      },
      "kyutai-stt": {
        "required": false,
        "notes": "Local streaming STT engine (Kyutai); selectable alongside whisper"
      },
      "kokoro": {
        "required": false,
        "notes": "Local TTS tier"
      },
      "speaker-verification": {
        "required": false,
        "notes": "Speaker enrollment + verification gate for the streaming STT path"
      },
      "ollama": {
        "required": false,
        "notes": "Local summarize tier"
      },
      "openrouter": {
        "type": "openrouter",
        "required": false,
        "notes": "Cloud summarize tier (BYOK); model resolved via OpenRouter policy role",
        "model_roles": [
          "summarize.default"
        ]
      },
      "postgres": {
        "required": false,
        "notes": "Optional usage history backend; sqlite is default"
      }
    },
    "scenarios": {
      "landing-page-business-suite": {
        "required": false,
        "notes": "LPBS tier; disabled by AUDIO_AI_ENABLE_VROOLI=false until execute/lpbs-audio-gateway-endpoints lands"
      }
    }
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/audio-tools.db",
    "AUDIO_WHISPER_URL": "http://localhost:8090",
    "AUDIO_KYUTAI_URL": "http://localhost:8094",
    "AUDIO_SPEAKER_URL": "http://localhost:11452",
    "AUDIO_KOKORO_URL": "http://localhost:8880",
    "AUDIO_OLLAMA_URL": "http://localhost:11434",
    "AUDIO_LPBS_BASE_URL": "",
    "AUDIO_AI_ENABLE_BYOK": "true",
    "AUDIO_AI_ENABLE_VROOLI": "false",
    "AUDIO_AI_ENABLE_LOCAL": "true",
    "AUDIO_TOOLS_ENABLE_STREAM_TEST_FAULTS": "false",
    "AUDIO_AVAIL_TTL_BYOK": "5m",
    "AUDIO_AVAIL_TTL_VROOLI": "30s"
  }
}
