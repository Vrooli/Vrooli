  "dependencies": {
    "resources": {
      "whisper": {
        "description": "Local STT tier (faster-whisper engine)",
        "required": false,
        "startup_policy": "ignore"
      },
      "kyutai-stt": {
        "description": "Optional Linux/CUDA streaming STT accelerator",
        "required": false,
        "startup_policy": "ignore"
      },
      "kokoro": {
        "degraded_behavior": "Audio Tools remains available; if Kale is unavailable, Kokoro is started on demand with a bounded, single-flight start and cooldown, and the TTS chain falls through to later provider tiers if startup fails.",
        "description": "Fallback text-to-speech resource started only when an auto TTS request needs Kokoro",
        "required": false,
        "startup_policy": "ignore"
      },
      "ollama": {
        "description": "Optional local model administration and evaluation; production summaries use AI Gateway",
        "required": false,
        "startup_policy": "ignore"
      },
      "openrouter": {
        "type": "openrouter",
        "required": false,
        "model_roles": [
          "summarize.default"
        ],
        "description": "Cloud summarize tier (BYOK); model resolved via OpenRouter policy role",
        "startup_policy": "try_start"
      },
      "kale-tts": {
        "degraded_behavior": "When the healthy Kale Nano runtime is unavailable, auto TTS starts Kokoro on demand and then falls through to later tiers if startup fails; explicit Kale selection requires the runtime.",
        "description": "CPU-only Kale Nano TTS candidate, conditionally selected by auto when its runtime is healthy",
        "enabled": true,
        "required": false,
        "startup_policy": "ignore"
      }
    },
    "scenarios": {
      "landing-page-business-suite": {
        "required": false,
        "startup_policy": "try_start",
        "degraded_behavior": "LPBS-backed audio routing remains unavailable while landing-page-business-suite is stopped; local and BYOK providers continue to serve supported requests.",
        "bundle_policy": "discover"
    },
    "ai-gateway": {
      "required": false,
      "startup_policy": "try_start",
      "degraded_behavior": "Gateway-backed summarize is unavailable while ai-gateway is stopped; locally configured and BYOK provider tiers remain available."
      }
    }
  },
  "environment": {
    "GOWORK": "off",
    "AUDIO_WHISPER_URL": "http://localhost:8090",
    "AUDIO_KYUTAI_URL": "http://localhost:8094",
    "AUDIO_SHERPA_URL": "http://localhost:8881",
    "AUDIO_TTS_BACKEND": "auto",
    "AUDIO_OLLAMA_URL": "http://localhost:11434",
    "AUDIO_AI_ENABLE_BYOK": "true",
    "AUDIO_AI_ENABLE_VROOLI": "false",
    "AUDIO_AI_ENABLE_LOCAL": "true",
    "AUDIO_TOOLS_ENABLE_STREAM_TEST_FAULTS": "false",
    "AUDIO_AVAIL_TTL_BYOK": "5m",
    "AUDIO_AVAIL_TTL_VROOLI": "30s"
  }
