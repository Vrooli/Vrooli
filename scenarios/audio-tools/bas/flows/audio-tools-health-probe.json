{
  "id": "ca7f4384-8ca2-401c-acdc-0ad2b26b1fa4",
  "project_id": "0238b793-8b5e-42ff-a42a-7b495da99b7f",
  "name": "audio-tools-health-probe",
  "folder_path": "/bas/flows",
  "description": "Smoke probe: boot the audio-tools UI, navigate to the Diagnostics surface, and confirm the capability self-test control renders. Non-media — drives no microphone or audio playback, so it runs deterministically in the BAS Playwright harness. Guards against the class of regression where the app shell or Diagnostics page fails to mount at all.",
  "tags": [
    "reset:none",
    "intent:functional"
  ],
  "version": 1,
  "created_at": "2026-07-12T16:40:18.976930563Z",
  "updated_at": "2026-07-12T16:40:18.976930563Z",
  "metadata": {
    "name": "audio-tools-health-probe",
    "description": "Read-only browser probe for the Audio Tools health surface.",
    "execution_mode": "observer"
  },
  "flow_definition": {
    "metadata": {
      "name": "audio-tools-health-probe",
      "description": "Observe the Diagnostics surface and confirm its self-test control renders.",
      "execution_mode": "observer"
    },
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "navigate-diagnostics",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_UNSPECIFIED",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_UNSPECIFIED",
            "scenario": "audio-tools",
            "scenario_path": "/diagnostics"
          },
          "metadata": {
            "label": "Navigate to /diagnostics"
          }
        }
      },
      {
        "id": "wait-suite-run",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/diagnostics.suiteRun",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the capability self-test control to render"
          }
        }
      },
      {
        "id": "assert-suite-run",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/diagnostics.suiteRun"
          },
          "metadata": {
            "label": "Assert the diagnostics suite control exists"
          }
        }
      },
      {
        "id": "capture-diagnostics",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": true
          },
          "metadata": {
            "label": "Capture the Diagnostics page"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-nav-wait",
        "source": "navigate-diagnostics",
        "target": "wait-suite-run",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "edge-wait-assert",
        "source": "wait-suite-run",
        "target": "assert-suite-run",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "edge-assert-capture",
        "source": "assert-suite-run",
        "target": "capture-diagnostics",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
