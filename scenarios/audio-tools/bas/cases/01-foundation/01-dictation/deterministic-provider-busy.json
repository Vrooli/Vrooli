{
  "id": "c8c21d1f-d648-4f31-a538-24e61ac4e6e0",
  "project_id": "0238b793-8b5e-42ff-a42a-7b495da99b7f",
  "name": "audio-tools-deterministic-provider-busy",
  "folder_path": "/bas/cases/01-foundation/01-dictation",
  "description": "Verifies that a WAV-backed Dictation Studio recording surfaces the typed provider-busy recovery failure without developer tools. Requires the dedicated fake-microphone driver and a server-owned routed-isolation lease.",
  "tags": [
    "reset:none",
    "requirements_json:[\"ATD-P0-005\"]",
    "media_fixture:microphone",
    "evidence_lane:deterministic_browser_fault"
  ],
  "version": 1,
  "created_at": "2026-07-12T16:40:18.970959178Z",
  "updated_at": "2026-07-12T16:40:18.970959178Z",
  "metadata": {
    "name": "audio-tools-deterministic-provider-busy",
    "description": "Verify Dictation Studio exposes typed provider-busy recovery through the product UI.",
    "labels": {
      "requires_confirmation": "true",
      "routed_isolation": "true"
    },
    "execution_mode": "mutating"
  },
  "flow_definition": {
    "metadata": {
      "name": "audio-tools-deterministic-provider-busy",
      "description": "Verify Dictation Studio exposes typed provider-busy recovery through the product UI.",
      "execution_mode": "mutating"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844,
      "browser_profile": {
        "extra_headers": {
          "X-Audio-Tools-STT-Fault": "provider_busy",
          "X-Vrooli-Test-Mode": "1"
        }
      },
      "fake_media": {
        "microphone_wav": "bas/fixtures/dictation-reference.wav"
      }
    },
    "nodes": [
      {
        "id": "navigate-dictation",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_UNSPECIFIED",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_UNSPECIFIED",
            "scenario": "audio-tools",
            "scenario_path": "/dictation-studio?stt_test_mode=1&stt_test_fault=provider_busy"
          },
          "metadata": {
            "label": "Open Dictation Studio"
          }
        }
      },
      {
        "id": "wait-recorder",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/dictationStudio.recordStart",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the recorder"
          }
        }
      },
      {
        "id": "start-fake-microphone",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/dictationStudio.recordStart"
          },
          "metadata": {
            "label": "Start WAV-backed capture under provider-busy fault"
          }
        }
      },
      {
        "id": "wait-provider-busy",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/dictationStudio.recordError",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the typed provider failure to reach the product UI"
          }
        }
      },
      {
        "id": "assert-provider-busy",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.recordError",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": {
              "string_value": "STT provider is busy"
            },
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Assert actionable provider-busy recovery feedback"
          }
        }
      },
      {
        "id": "capture-provider-busy",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": true
          },
          "metadata": {
            "label": "Capture product-visible provider-busy evidence"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "navigate-dictation",
        "target": "wait-recorder",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "wait-recorder",
        "target": "start-fake-microphone",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "start-fake-microphone",
        "target": "wait-provider-busy",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "wait-provider-busy",
        "target": "assert-provider-busy",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e5",
        "source": "assert-provider-busy",
        "target": "capture-provider-busy",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
