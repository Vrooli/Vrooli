  "flow_definition": {
    "metadata": {
      "name": "audio-tools-deterministic-five-cycle-microphone-reuse",
      "description": "Five consecutive WAV-backed fake-media press/speak/transcribe/stop cycles in one page and Chromium context; emulated product-path evidence only, not native microphone qualification.",
      "execution_mode": "mutating"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844,
      "fake_media": {
        "microphone_wav": "bas/fixtures/dictation-reference.wav"
      }
    },
    "nodes": [
      {
        "id": "navigate-dictation",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_UNSPECIFIED",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_UNSPECIFIED",
            "scenario": "audio-tools",
            "scenario_path": "/dictation-studio"
          },
          "metadata": {
            "label": "Open Dictation Studio once for all five cycles"
          }
        }
      },
      {
        "id": "wait-recorder",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/dictationStudio.recordStart",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the recorder"
          }
        }
      },
      {
        "id": "cycle-01-start",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/dictationStudio.recordStart"
          },
          "metadata": {
            "label": "Cycle 1: start WAV-backed fake-media microphone capture"
          }
        }
      },
      {
        "id": "cycle-01-active",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.recordStart",
            "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
            "timeout_ms": 15000,
            "expected": {
              "string_value": "true"
            },
            "attribute_name": "aria-pressed"
          },
          "metadata": {
            "label": "Cycle 1: assert microphone lifecycle is active"
          }
        }
      },
      {
        "id": "cycle-01-connected",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/dictationStudio.streamStatus",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 45000
          },
          "metadata": {
            "label": "Cycle 1: wait for PCM-v2 transport connection"
          }
        }
      },
      {
        "id": "cycle-01-transport-connected",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.streamStatus",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "timeout_ms": 15000,
            "expected": {
              "string_value": "Streaming transcription connected."
            }
          },
          "metadata": {
            "label": "Cycle 1: assert transport connection"
          }
        }
      },
      {
        "id": "cycle-01-speak",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 4000
          },
          "metadata": {
            "label": "Cycle 1: feed the checked-in five-word fake-media WAV"
