{
  "id": "69dccce3-902e-4771-9204-c4fd44676e11",
  "project_id": "0238b793-8b5e-42ff-a42a-7b495da99b7f",
  "name": "audio-tools-deterministic-incomplete-coverage",
  "folder_path": "/bas/cases/01-foundation/01-dictation",
  "description": "Verifies that a WAV-backed Dictation Studio recording exposes an unacknowledged terminal coverage failure through the product UI. The server fault is test-only and preserves the browser journal for recovery rather than presenting a false successful final result.",
  "tags": [
    "reset:none",
    "requirements_json:[\"ATD-P0-004\"]",
    "media_fixture:microphone",
    "evidence_lane:deterministic_browser_fault"
  ],
  "version": 1,
  "created_at": "2026-07-12T19:20:00Z",
  "updated_at": "2026-07-12T19:20:00Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844,
      "fake_media": {
        "microphone_wav": "bas/fixtures/dictation-reference.wav"
      }
    },
    "nodes": [
      {
        "id": "navigate-dictation",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_UNSPECIFIED",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_UNSPECIFIED",
            "scenario": "audio-tools",
            "scenario_path": "/dictation-studio?stt_test_mode=1&stt_test_fault=suppress_processed_ack"
          },
          "metadata": { "label": "Open Dictation Studio with the bounded incomplete-coverage fault" }
        }
      },
      {
        "id": "wait-recorder",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": { "selector": "@selector/dictationStudio.recordStart", "state": "WAIT_STATE_UNSPECIFIED", "timeout_ms": 15000 },
          "metadata": { "label": "Wait for the recorder" }
        }
      },
      {
        "id": "start-fake-microphone",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": { "selector": "@selector/dictationStudio.recordStart" },
          "metadata": { "label": "Start WAV-backed PCM capture" }
        }
      },
      {
        "id": "feed-fixture",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": { "duration_ms": 4000 },
          "metadata": { "label": "Allow the deterministic WAV fixture to generate durable PCM" }
        }
      },
      {
        "id": "assert-captured",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.turnCaptureStatus",
            "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
            "expected": { "string_value": "true" },
            "attribute_name": "data-has-captured-audio",
            "timeout_ms": 5000
          },
          "metadata": { "label": "Assert that audio exists before the terminal fault" }
        }
      },
      {
        "id": "stop-capture",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": { "selector": "@selector/dictationStudio.recordStart" },
          "metadata": { "label": "Request finalization with the acknowledgement-withholding fault armed" }
        }
      },
      {
        "id": "wait-incomplete-coverage",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": { "selector": "@selector/dictationStudio.recordError", "state": "WAIT_STATE_UNSPECIFIED", "timeout_ms": 15000 },
          "metadata": { "label": "Wait for the typed incomplete-coverage failure" }
        }
      },
      {
        "id": "assert-incomplete-coverage",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.recordError",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": { "string_value": "Audio processing acknowledgement was intentionally withheld" },
            "timeout_ms": 5000
          },
          "metadata": { "label": "Assert that the product reports unconfirmed audio coverage" }
        }
      },
      {
        "id": "assert-retained-terminal-reason",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/dictationStudio.turnDetails",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": { "string_value": "incomplete_coverage" },
            "timeout_ms": 5000
          },
          "metadata": { "label": "Assert that diagnostic state retains the incomplete-coverage terminal reason" }
        }
      },
      {
        "id": "capture-incomplete-coverage",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": { "full_page": true },
          "metadata": { "label": "Capture product-visible retained-audio recovery evidence" }
        }
      }
    ],
    "edges": [
      { "id": "e1", "source": "navigate-dictation", "target": "wait-recorder", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e2", "source": "wait-recorder", "target": "start-fake-microphone", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e3", "source": "start-fake-microphone", "target": "feed-fixture", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e4", "source": "feed-fixture", "target": "assert-captured", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e5", "source": "assert-captured", "target": "stop-capture", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e6", "source": "stop-capture", "target": "wait-incomplete-coverage", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e7", "source": "wait-incomplete-coverage", "target": "assert-incomplete-coverage", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e8", "source": "assert-incomplete-coverage", "target": "assert-retained-terminal-reason", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e9", "source": "assert-retained-terminal-reason", "target": "capture-incomplete-coverage", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" }
    ]
  }
}
