{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "signal-inbox",
  "description": "Signal Inbox CLI surface. Commands are generated-client wrappers over the SignalsService journal contract.",
  "groups": [
    {
      "name": "signals",
      "description": "Capture and read immutable external signals",
      "commands": [
        {
          "name": "capture",
          "description": "Capture one URL, text value, or uploaded-image payload reference",
          "flags": [
            {"name": "url", "description": "Source URL"},
            {"name": "text", "description": "Captured text"},
            {"name": "image-payload-ref", "description": "Previously uploaded opaque image payload reference"},
            {"name": "note", "description": "Capture-time note"}
          ],
          "binding": {"kind": "connect-rpc", "service": "SignalsService", "method": "CaptureSignal"},
          "architecture": {"primitive": "proto_mutation"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "get",
          "description": "Read one signal by id",
          "positionals": [{"name": "id", "required": true, "description": "Signal id"}],
          "binding": {"kind": "connect-rpc", "service": "SignalsService", "method": "GetSignal"},
          "architecture": {"primitive": "proto_list"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "list",
          "description": "List the full immutable signal corpus",
          "flags": [{"name": "page-size", "description": "Maximum rows to return"}],
          "binding": {"kind": "connect-rpc", "service": "SignalsService", "method": "ListSignals"},
          "architecture": {"primitive": "proto_list"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]}
        }
      ]
    },
    {
      "name": "categories",
      "description": "Manage operator-owned categories and review classifications",
      "commands": [
        {
          "name": "create",
          "description": "Create an operator-owned category",
          "flags": [{"name": "name", "description": "Category name", "required": true}, {"name": "description", "description": "Optional category description"}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "CreateCategory"},
          "architecture": {"primitive": "proto_mutation"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "list",
          "description": "List categories",
          "flags": [{"name": "include-retired", "description": "Include retired categories"}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "ListCategories"},
          "architecture": {"primitive": "proto_list"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "rename",
          "description": "Rename or describe an active category",
          "positionals": [{"name": "id", "required": true, "description": "Category id"}],
          "flags": [{"name": "name", "description": "New category name", "required": true}, {"name": "description", "description": "Optional category description"}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "RenameCategory"},
          "architecture": {"primitive": "proto_mutation"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "retire",
          "description": "Retire a category and retain its history",
          "positionals": [{"name": "id", "required": true, "description": "Category id"}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "RetireCategory"},
          "architecture": {"primitive": "proto_mutation"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "get-classification",
          "description": "Read the latest advisory and confirmed classification for a signal",
          "positionals": [{"name": "signal-id", "required": true, "description": "Signal id"}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "GetClassification"},
          "architecture": {"primitive": "proto_list"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]}
        },
        {
          "name": "confirm",
          "description": "Confirm or override a proposed category for a signal",
          "positionals": [{"name": "signal-id", "required": true, "description": "Signal id"}],
          "flags": [{"name": "category-id", "description": "Confirmed active category id", "required": true}],
          "binding": {"kind": "connect-rpc", "service": "CategoriesService", "method": "ConfirmClassification"},
          "architecture": {"primitive": "proto_mutation"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]}
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "exceptions": [],
  "omitted": []
}
