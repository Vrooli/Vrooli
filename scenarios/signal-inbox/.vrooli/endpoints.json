{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.signal_inbox.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.signal_inbox.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "categories_create",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/CreateCategory",
      "method": "POST",
      "summary": "Create category",
      "description": "Creates an operator-defined category at runtime.",
      "category": "categories",
      "request": {
        "type": "CreateCategoryRequest"
      },
      "response": {
        "type": "CreateCategoryResponse"
      }
    },
    {
      "id": "categories_list",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/ListCategories",
      "method": "POST",
      "summary": "List categories",
      "description": "Lists active categories, optionally including retired categories.",
      "category": "categories",
      "request": {
        "type": "ListCategoriesRequest"
      },
      "response": {
        "type": "ListCategoriesResponse"
      }
    },
    {
      "id": "categories_rename",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/RenameCategory",
      "method": "POST",
      "summary": "Rename category",
      "description": "Renames a non-reserved category.",
      "category": "categories",
      "request": {
        "type": "RenameCategoryRequest"
      },
      "response": {
        "type": "RenameCategoryResponse"
      }
    },
    {
      "id": "categories_retire",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/RetireCategory",
      "method": "POST",
      "summary": "Retire category",
      "description": "Retires a category and reassigns confirmed signals to the reserved fallback without deleting signals.",
      "category": "categories",
      "request": {
        "type": "RetireCategoryRequest"
      },
      "response": {
        "type": "RetireCategoryResponse"
      }
    },
    {
      "id": "categories_get_classification",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/GetClassification",
      "method": "POST",
      "summary": "Get classification",
      "description": "Returns the latest advisory or confirmed classification for a signal.",
      "category": "categories",
      "request": {
        "type": "GetClassificationRequest"
      },
      "response": {
        "type": "GetClassificationResponse"
      }
    },
    {
      "id": "categories_confirm_classification",
      "path": "/vrooli.signal_inbox.v1.categories.CategoriesService/ConfirmClassification",
      "method": "POST",
      "summary": "Confirm classification",
      "description": "Appends an operator confirmation or override while retaining the proposal.",
      "category": "categories",
      "request": {
        "type": "ConfirmClassificationRequest"
      },
      "response": {
        "type": "ConfirmClassificationResponse"
      }
    },
    {
      "id": "retrieval_search",
      "path": "/vrooli.signal_inbox.v1.retrieval.RetrievalService/Search",
      "method": "POST",
      "summary": "Search signals",
      "description": "Searches the full signal corpus; category and disposition only filter results and never index eligibility.",
      "category": "retrieval",
      "request": {
        "type": "SearchRequest"
      },
      "response": {
        "type": "SearchResponse"
      }
    },
    {
      "id": "retrieval_ambient",
      "path": "/vrooli.signal_inbox.v1.retrieval.RetrievalService/Ambient",
      "method": "POST",
      "summary": "Read ambient signals",
      "description": "Returns a budgeted unresolved view without changing corpus search eligibility.",
      "category": "retrieval",
      "request": {
        "type": "AmbientRequest"
      },
      "response": {
        "type": "AmbientResponse"
      }
    },
    {
      "id": "signals_capture",
      "path": "/vrooli.signal_inbox.v1.signals.SignalsService/CaptureSignal",
      "method": "POST",
      "summary": "Capture a signal",
      "description": "Appends a URL, text, or image reference to the immutable signal journal. The source kind is inferred from the populated payload.",
      "category": "signals",
      "request": {
        "type": "CaptureSignalRequest"
      },
      "response": {
        "type": "CaptureSignalResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Exactly one capture source is required"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Journal append failed"
        }
      ]
    },
    {
      "id": "signals_get",
      "path": "/vrooli.signal_inbox.v1.signals.SignalsService/GetSignal",
      "method": "POST",
      "summary": "Get a signal",
      "description": "Reads one immutable signal by id.",
      "category": "signals",
      "request": {
        "type": "GetSignalRequest"
      },
      "response": {
        "type": "GetSignalResponse"
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Signal does not exist"
        }
      ]
    },
    {
      "id": "signals_list",
      "path": "/vrooli.signal_inbox.v1.signals.SignalsService/ListSignals",
      "method": "POST",
      "summary": "List signals",
      "description": "Lists the journal newest first. Categories and disposition never filter this corpus read.",
      "category": "signals",
      "request": {
        "type": "ListSignalsRequest"
      },
      "response": {
        "type": "ListSignalsResponse"
      }
    },
    {
      "id": "signals_upload_image",
      "path": "/api/v1/signals/images",
      "method": "POST",
      "summary": "Upload image for capture",
      "description": "Stores opaque image bytes in BlobStore and returns a proto-typed payload reference for CaptureSignal.",
      "category": "signals",
      "request": {
        "type": "multipart/form-data"
      },
      "response": {
        "type": "UploadImageResponse"
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "multipart file bytes cannot be represented in a Connect request; response remains proto-typed",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.signal_inbox.v1.signals.UploadImageResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.signal_inbox.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "sources_list_adapters",
      "path": "/vrooli.signal_inbox.v1.sources.SourcesService/ListAdapters",
      "method": "POST",
      "summary": "List source adapters",
      "description": "Lists adapter risk tiers and durable enablement state.",
      "category": "sources",
      "request": {
        "type": "ListAdaptersRequest"
      },
      "response": {
        "type": "ListAdaptersResponse"
      }
    },
    {
      "id": "sources_set_enabled",
      "path": "/vrooli.signal_inbox.v1.sources.SourcesService/SetAdapterEnabled",
      "method": "POST",
      "summary": "Set adapter enabled",
      "description": "Explicitly enables or disables one adapter; higher-risk adapters ship disabled.",
      "category": "sources",
      "request": {
        "type": "SetAdapterEnabledRequest"
      },
      "response": {
        "type": "SetAdapterEnabledResponse"
      }
    },
    {
      "id": "sources_import_archive",
      "path": "/vrooli.signal_inbox.v1.sources.SourcesService/ImportArchive",
      "method": "POST",
      "summary": "Import archive",
      "description": "Imports an operator-supplied tier-zero archive through the shared journal capture path.",
      "category": "sources",
      "request": {
        "type": "ImportArchiveRequest"
      },
      "response": {
        "type": "ImportArchiveResponse"
      }
    },
    {
      "id": "triage_get",
      "path": "/vrooli.signal_inbox.v1.triage.TriageService/GetTriage",
      "method": "POST",
      "summary": "Get triage record",
      "description": "Returns the mutable disposition and append-only annotation thread for a signal.",
      "category": "triage",
      "request": {
        "type": "GetTriageRequest"
      },
      "response": {
        "type": "GetTriageResponse"
      }
    },
    {
      "id": "triage_set_disposition",
      "path": "/vrooli.signal_inbox.v1.triage.TriageService/SetDisposition",
      "method": "POST",
      "summary": "Set disposition",
      "description": "Updates the signal's single disposition without changing its journal entry or search eligibility.",
      "category": "triage",
      "request": {
        "type": "SetDispositionRequest"
      },
      "response": {
        "type": "SetDispositionResponse"
      }
    },
    {
      "id": "triage_add_annotation",
      "path": "/vrooli.signal_inbox.v1.triage.TriageService/AddAnnotation",
      "method": "POST",
      "summary": "Add annotation",
      "description": "Appends an operator, agent, or system annotation and optional typed outcome link.",
      "category": "triage",
      "request": {
        "type": "AddAnnotationRequest"
      },
      "response": {
        "type": "AddAnnotationResponse"
      }
    }
  ]
}
