{
  "name": "workspace-sandbox-ui",
  "version": "1.0.0",
  "description": "React + Vite front-end for Workspace Sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vrooli lifecycle protect -- vite",
    "build": "pnpm selector:manifest && vite build",
    "build:profile": "pnpm selector:manifest && vite build --mode profile",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "selector:manifest": "node scripts/generate-selector-manifest.mjs",
    "selector:check": "node scripts/generate-selector-manifest.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "@vrooli/ui-selectors": "file:../../../packages/ui-selectors",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.18.2",
    "lucide-react": "^0.424.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^3.21.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.44",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.6",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
