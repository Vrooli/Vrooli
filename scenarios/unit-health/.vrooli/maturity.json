      "name": "No reliable test surface",
      "description": "The target scenario cannot be resolved or has no discoverable test surface.",
      "entry_criteria": ["Scenario id or path is provided"],
      "exit_criteria": ["At least one testable workspace (Go module, TypeScript/Vite UI, or Python package) is discoverable"]
    },
    {
      "id": "L1",
      "name": "Test surfaces discovered",
      "description": "Unit Health can enumerate the testable workspaces of the scenario and explicitly report unsupported or undiscoverable ones.",
      "entry_criteria": ["Target path is readable"],
      "exit_criteria": ["Every discovered workspace either has a runnable test command or emits an explicit gap finding, and no test execution fails or hangs"]
    },
    {
      "id": "L2",
      "name": "Canonical test frameworks configured",
      "description": "Each workspace uses its canonical Vrooli test framework (Go go test, React/Vite Vitest, Python pytest) with a coverage-capable configuration.",
      "entry_criteria": ["Test surfaces are known"],
      "exit_criteria": ["No workspace emits a missing-framework, noncanonical-framework, or missing-coverage-config error"]
    },
    {
      "id": "L3",
      "name": "Testable architecture and shared test utilities",
      "description": "Tests are co-located, share test utilities, never import test helpers from production, and exercise injectable seams for time/env/http/logger/repository.",
      "entry_criteria": ["Canonical frameworks are configured"],
      "exit_criteria": ["No test-architecture contract emits an error"]
    },
    {
      "id": "L4",
      "name": "Coverage and edge-case depth",
      "description": "Coverage meets the scenario threshold and tests include positive, negative, and boundary cases rather than render-only or assertion-free checks.",
      "entry_criteria": ["Test architecture is sound"],
      "exit_criteria": ["No coverage or test-quality contract emits an error"]
    },
    {
      "id": "L5",
      "name": "Drift-gated, flake-aware, requirement-linked tests",
      "description": "Tests are stable (flake-aware), runtime-bounded, and linked to requirements so the scenario is fleet-ready for Test Genie delegation.",
      "entry_criteria": ["Coverage and quality baselines are clean"],
      "exit_criteria": ["No flake, runtime-growth, or untagged-requirement finding blocks fleet validation"]
    }
  ],
