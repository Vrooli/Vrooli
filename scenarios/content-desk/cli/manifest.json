{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "content-desk",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "campaigns",
      "description": "Manage campaign work context and artifact budget",
      "commands": [
        {
          "name": "list",
          "description": "List campaigns",
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignsService",
            "method": "ListCampaigns"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a proposed campaign with evidence and slots",
          "flags": [
            {
              "name": "name",
              "required": true,
              "description": "Campaign name"
            },
            {
              "name": "evidence-ref",
              "description": "Comma-separated evidence references",
              "bind": {
                "field": "evidence_refs"
              }
            },
            {
              "name": "slot",
              "description": "Comma-separated channel:format:capacity slots",
              "bind": {
                "field": "slots"
              }
            },
            {
              "name": "scenario",
              "description": "Comma-separated scenario names supported by this campaign",
              "bind": {
                "field": "scenario_names"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignsService",
            "method": "CreateCampaign"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "activate",
          "description": "Activate an evidence-backed campaign",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Campaign id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignsService",
            "method": "ActivateCampaign"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "launch-assets",
          "description": "Report launch assets, channels, and open slots for a scenario",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignsService",
            "method": "GetLaunchAssets"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "artifacts",
      "description": "Inspect draft lifecycle state",
      "commands": [
        {
          "name": "approve",
          "description": "Approve a reviewed draft after all gates pass",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Draft id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "ApproveDraft"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "create",
          "description": "Create a requested draft",
          "flags": [
            {
              "name": "campaign",
              "required": true,
              "description": "Campaign id",
              "bind": {
                "field": "campaign_id"
              }
            },
            {
              "name": "post-type",
              "required": true,
              "description": "Post type id",
              "bind": {
                "field": "post_type_id"
              }
            },
            {
              "name": "body",
              "description": "Initial draft body"
            },
            {
              "name": "channel",
              "required": true,
              "description": "Campaign slot channel"
            },
            {
              "name": "format",
              "required": true,
              "description": "Campaign slot format"
            },
            {
              "name": "lane",
              "required": true,
              "description": "Editorial coverage lane"
            },
            {
              "name": "sku",
              "required": true,
              "description": "SKU covered by this draft"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "CreateDraft"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "List drafts",
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "ListDrafts"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "transition",
          "description": "Apply a constrained draft lifecycle event",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Draft id"
            }
          ],
          "flags": [
            {
              "name": "event",
              "required": true,
              "description": "Lifecycle event"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "TransitionDraft"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "revise",
          "description": "Save an attributed draft revision",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Draft id"
            }
          ],
          "flags": [
            {
              "name": "body",
              "required": true,
              "description": "Revised draft body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "UpdateDraftBody"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "submit-release",
          "description": "Submit an approved draft to Channel Manager's durable release queue",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Draft id"
            }
          ],
          "flags": [
            {
              "name": "identity",
              "required": true,
              "description": "Channel Manager identity id",
              "bind": {
                "field": "identity_id"
              }
            },
            {
              "name": "lane",
              "required": true,
              "description": "Approved Channel Manager lane"
            },
            {
              "name": "idempotency-key",
              "required": true,
              "description": "Stable release idempotency key"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ArtifactsService",
            "method": "SubmitReleaseDraft"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "claims",
      "description": "Manage verifiable claims and evidence",
      "commands": [
        {
          "name": "list",
          "description": "List claims and verification states",
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "ListClaims"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a claim with durable evidence",
          "flags": [
            {
              "name": "statement",
              "required": true,
              "description": "Claim statement"
            },
            {
              "name": "kind",
              "required": true,
              "description": "quantitative, existence, status, capability, or novelty"
            },
            {
              "name": "evidence-kind",
              "required": true,
              "description": "citation or check"
            },
            {
              "name": "reference",
              "description": "Evidence reference"
            },
            {
              "name": "command",
              "description": "Re-runnable check command"
            },
            {
              "name": "expected-result",
              "description": "Expected check output"
            },
            {
              "name": "observed-at",
              "description": "RFC3339 time for novelty evidence"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "CreateClaim"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "cite",
          "description": "Attach a claim to an exact draft-body span",
          "flags": [
            {
              "name": "draft",
              "required": true,
              "description": "Draft id",
              "bind": {
                "field": "draft_id"
              }
            },
            {
              "name": "claim",
              "required": true,
              "description": "Claim id",
              "bind": {
                "field": "claim_id"
              }
            },
            {
              "name": "span-start",
              "required": true,
              "description": "Zero-based start offset"
            },
            {
              "name": "span-end",
              "required": true,
              "description": "Exclusive end offset"
            },
            {
              "name": "body",
              "required": true,
              "description": "Current draft body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "CiteClaim"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "verify",
          "description": "Run a claim's re-runnable check",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Claim id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "VerifyClaim"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "sweep",
          "description": "Verify every check-backed claim",
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "SweepClaims"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list-draft",
          "description": "List claims cited by one draft",
          "positionals": [
            {
              "name": "draft-id",
              "required": true,
              "description": "Draft id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClaimsService",
            "method": "ListDraftClaims"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "ledger",
      "description": "Inspect publish history",
      "commands": [
        {
          "name": "list",
          "description": "List publish records",
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "ListPublishRecords"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "contamination",
          "description": "List published records citing a claim that became stale or refuted",
          "positionals": [
            {
              "name": "claim-id",
              "required": true,
              "description": "Claim id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "ListContaminatedPublishRecords"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "coverage",
          "description": "List publish coverage by campaign, lane, channel, and SKU",
          "flags": [
            {
              "name": "stale-after-days",
              "required": true,
              "description": "Days without a publish before a cell is stale"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "ListCoverage"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "remediations",
          "description": "List active or historical correction actions for published content",
          "flags": [
            {
              "name": "publish-record-id",
              "description": "Optional publish record id"
            },
            {
              "name": "open-only",
              "description": "Show only unresolved remediation actions",
              "bool": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "ListRemediations"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "remediate",
          "description": "Record a corrective action for a contaminated published post",
          "flags": [
            {
              "name": "publish-record-id",
              "required": true,
              "description": "Published record to correct"
            },
            {
              "name": "kind",
              "required": true,
              "description": "correct_in_place, publish_correction, retract, or accept_and_annotate"
            },
            {
              "name": "note",
              "description": "Operator rationale and evidence reference"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "CreateRemediation"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "resolve-remediation",
          "description": "Resolve an open remediation while retaining its audit history",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Remediation id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "LedgerService",
            "method": "ResolveRemediation"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "posttypes",
      "description": "Manage post type activation",
      "commands": [
        {
          "name": "list",
          "description": "List post types",
          "binding": {
            "kind": "connect-rpc",
            "service": "PosttypesService",
            "method": "ListPostTypes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "register",
          "description": "Register or activate a post type",
          "flags": [
            {
              "name": "id",
              "required": true,
              "description": "Post type id"
            },
            {
              "name": "paired-skill",
              "required": true,
              "description": "Paired craft skill id"
            },
            {
              "name": "skill-exists",
              "description": "Confirm paired skill exists",
              "bool": true
            },
            {
              "name": "doc-v1",
              "description": "Confirm canon document is v1",
              "bool": true
            },
            {
              "name": "responsibilities-declared",
              "description": "Confirm responsibilities are declared",
              "bool": true
            },
            {
              "name": "failure-modes",
              "required": true,
              "description": "Comma-separated declared craft and policy failure modes"
            },
            {
              "name": "activate",
              "description": "Request activation",
              "bool": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PosttypesService",
            "method": "RegisterPostType"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "review",
      "description": "Manage re-runnable review outcomes",
      "commands": [
        {
          "name": "list",
          "description": "List review runs",
          "binding": {
            "kind": "connect-rpc",
            "service": "ReviewService",
            "method": "ListReviewRuns"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "record",
          "description": "Record a craft or policy verdict",
          "flags": [
            {
              "name": "draft",
              "required": true,
              "description": "Draft id",
              "bind": {
                "field": "draft_id"
              }
            },
            {
              "name": "mode",
              "required": true,
              "description": "Failure mode assessed",
              "local_only": true
            },
            {
              "name": "passed",
              "description": "Verdict passed",
              "bool": true,
              "local_only": true
            },
            {
              "name": "evidence",
              "description": "Re-runnable evidence",
              "bind": {
                "field": "verdicts"
              }
            },
            {
              "name": "finding",
              "description": "Finding when blocked",
              "local_only": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ReviewService",
            "method": "RecordReviewRun"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    }
  ],
  "measures": {
    "omitted": [
      {
        "domain": "draft_revisions",
        "reason": "Revisions are immutable audit evidence for a draft, not an independent operational entity; their history is inspected through the draft workbench rather than a scalar count."
      },
      {
        "domain": "campaigns",
        "reason": "Campaign reporting is implemented by the Content Desk coverage report, not a scalar measure during this migration."
      },
      {
        "domain": "drafts",
        "reason": "Draft queue state is an operational workbench surface; a scalar measure would obscure lifecycle status distribution."
      },
      {
        "domain": "claims",
        "reason": "Claim quality is gate-oriented and reported through verification state, not a scalar count."
      },
      {
        "domain": "review_runs",
        "reason": "Review outcomes are read per draft in the desk inspector; a scalar count does not represent blocking-versus-passing verdict quality."
      },
      {
        "domain": "ledger_remediations",
        "reason": "Remediation safety is assessed per contaminated publication and state, not by a scalar total that could hide unresolved high-severity records."
      }
    ],
    "domains": []
  },
  "exceptions": [],
  "omitted": [
    {
      "service": "ArtifactsService",
      "method": "RecordReleaseOutcome",
      "reason": "Inbound authenticated Channel Manager completion callback is an idempotent integration endpoint, not an operator CLI action."
    },
    {
      "service": "LedgerService",
      "method": "IngestMetricSample",
      "reason": "Inbound authenticated Channel Manager delivery is an idempotent integration callback, not an operator CLI action."
    },
    {
      "service": "ClaimsService",
      "method": "GetClaimCoverage",
      "reason": "The coverage map is a structured editor-review presentation returned with its draft body; a standalone CLI rendering would lose the accessible span context."
    },
    {
      "service": "ClaimsService",
      "method": "ExtractClaimProposals",
      "reason": "Extraction operates on the active editor body and its proposal list; the workbench preserves the review context needed before an operator decides."
    },
    {
      "service": "ClaimsService",
      "method": "ListClaimProposals",
      "reason": "Proposal state is an editor-bound review surface, not a standalone operational command."
    },
    {
      "service": "ClaimsService",
      "method": "DecideClaimProposal",
      "reason": "A proposal decision is made in the workbench beside the editable draft; a CLI command would lose that safety context."
    },
    {
      "service": "ArtifactsService",
      "method": "AttachReleasedAsset",
      "reason": "Attachment placement and accessible alt text are editor-bound authoring decisions. The workbench keeps the draft and visual position visible."
    },
    {
      "service": "ArtifactsService",
      "method": "ListDraftAttachments",
      "reason": "Attachment metadata is rendered in the draft authoring surface with its position and alt-text review context."
    },
    {
      "service": "ArtifactsService",
      "method": "CommissionAgentWork",
      "reason": "Agent commissioning is an editor-bound operator action: the workbench preserves the selected draft, the restricted action, and the resulting provenance without encouraging detached autonomous runs."
    },
    {
      "service": "ArtifactsService",
      "method": "GetAgentWorkResult",
      "reason": "Agent output is presented beside the selected editor so an operator can inspect it before adopting it; detached CLI output would lose that safety context."
    },
    {
      "service": "ArtifactsService",
      "method": "AdoptAgentSuggestion",
      "reason": "Adoption is an explicit editor action that keeps the suggested body, editable draft, and Agent Manager provenance visible together."
    },
    {
      "service": "SearchService",
      "method": "Search",
      "reason": "Search is an editor-assist surface whose source snippets and relevance context must remain beside the draft."
    },
    {
      "service": "SearchService",
      "method": "Status",
      "reason": "Provider readiness is presented in the editorial workbench alongside search results and recovery guidance."
    }
  ]
}
