{
  "metadata": {
    "name": "manual-operator-completes-warming-action",
    "description": "Creates a synthetic identity, starts its manual warming path, queues and completes an action with evidence, then records a reach observation. No platform account, credential, or browser automation is used.",
    "requirement": "CHANMGR-P0-015",
    "version": "1",
    "labels": {
      "reset": "full",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "seed": "bas/seeds/seed.go",
      "requirements_json": "[\"CHANMGR-P0-001\",\"CHANMGR-P0-005\",\"CHANMGR-P0-006\",\"CHANMGR-P0-015\",\"CHANMGR-P0-016\",\"CHANMGR-P0-019\"]"
    },
    "execution_mode": "mutating"
  },
  "settings": {"viewport_width": 1280, "viewport_height": 900},
  "nodes": [
    {"id":"open","action":{"type":"ACTION_TYPE_NAVIGATE","navigate":{"destination_type":"NAVIGATE_DESTINATION_TYPE_SCENARIO","scenario":"channel-manager","scenario_path":"/","wait_until":"NAVIGATE_WAIT_EVENT_NETWORKIDLE","timeout_ms":30000},"metadata":{"label":"Open manual operator console"}}},
    {"id":"identity","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/operator.identityInput","value":"bas-x-identity","clear_first":true},"metadata":{"label":"Enter synthetic identity"}}},
    {"id":"create","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/operator.createButton"},"metadata":{"label":"Create and start warming"}}},
    {"id":"wait-identity","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/operator.identityReady","state":"WAIT_STATE_VISIBLE","timeout_ms":10000},"metadata":{"label":"Wait for identity warming setup"}}},
    {"id":"queue","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/operator.queueButton"},"metadata":{"label":"Queue manual engagement"}}},
    {"id":"wait-action","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/operator.actionReady","state":"WAIT_STATE_VISIBLE","timeout_ms":10000},"metadata":{"label":"Wait for queued action"}}},
    {"id":"select-action","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/operator.dueAction"},"metadata":{"label":"Select the queued action for manual completion"}}},
    {"id":"evidence","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/operator.evidenceInput","value":"https://example.test/bas-proof","clear_first":true},"metadata":{"label":"Attach completion evidence"}}},
    {"id":"complete","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/operator.completeButton"},"metadata":{"label":"Record manual completion"}}},
    {"id":"reach","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/operator.reachInput","value":"120","clear_first":true},"metadata":{"label":"Enter reach observation"}}},
    {"id":"observe","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/operator.observeButton"},"metadata":{"label":"Record observation"}}},
    {"id":"assert","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"@selector/operator.status","mode":"ASSERTION_MODE_VISIBLE","timeout_ms":10000,"failure_message":"Manual operator workflow should report its saved observation"},"metadata":{"label":"Verify saved manual workflow"}}}
  ],
  "edges": [
    {"id":"e1","source":"open","target":"identity","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e2","source":"identity","target":"create","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e3","source":"create","target":"wait-identity","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e4","source":"wait-identity","target":"queue","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e5","source":"queue","target":"wait-action","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e6","source":"wait-action","target":"select-action","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e7","source":"select-action","target":"evidence","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e8","source":"evidence","target":"complete","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e9","source":"complete","target":"reach","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e10","source":"reach","target":"observe","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e11","source":"observe","target":"assert","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"}
  ]
}
