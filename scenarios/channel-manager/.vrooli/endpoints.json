{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.channel_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.channel_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "channel_manager_overview",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/GetOverview",
      "method": "POST",
      "summary": "Get channel manager overview",
      "description": "Returns identity and queued-action references without credential values.",
      "category": "channel-manager",
      "response": {
        "type": "object",
        "properties": {
          "actions": "array<Action>",
          "identities": "array<Identity>"
        }
      }
    },
    {
      "id": "channel_manager_eligibility",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/GetEligibility",
      "method": "POST",
      "summary": "Get identity lane eligibility",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_submit_release",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/SubmitRelease",
      "method": "POST",
      "summary": "Submit idempotent release",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_deliver_release",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/DeliverReleaseOutcome",
      "method": "POST",
      "summary": "Deliver completed release outcome to Content Desk",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_deliver_metric",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/DeliverMetricSample",
      "method": "POST",
      "summary": "Deliver metric sample to Content Desk",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_assign_automation",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/AssignAutomation",
      "method": "POST",
      "summary": "Assign an operator-approved BAS profile reference",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_dispatch_browser",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/DispatchBrowserAction",
      "method": "POST",
      "summary": "Dispatch a durable queued action to BAS",
      "description": "",
      "category": "channel-manager"
    },
    {
      "id": "channel_manager_browser_execution_review",
      "path": "/vrooli.channel_manager.v1.channelmanager.ChannelManagerService/GetBrowserExecutionReview",
      "method": "POST",
      "summary": "Review bounded BAS execution status and artifact references",
      "description": "",
      "category": "channel-manager"
    }
  ]
}
