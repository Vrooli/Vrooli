{
  "metadata": {
    "description": "Generated observer smoke for active experience page journal.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "journal",
      "surface": "experience-journal"
    },
    "name": "experience-journal-spec-smoke",
    "requirement": "OT-P0-002",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Journal"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "money-ledger",
          "scenario_path": "/journal",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-journal"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.reverseAction",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-journal-primary-binding"
    },
    {
      "action": {
        "metadata": { "label": "Manual entry action visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.manualEntry",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-journal-manual-entry"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
