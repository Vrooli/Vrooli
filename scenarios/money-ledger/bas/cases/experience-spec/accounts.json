{
  "metadata": {
    "description": "Generated observer smoke for active experience page accounts.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "accounts",
      "surface": "experience-accounts"
    },
    "name": "experience-accounts-spec-smoke",
    "requirement": "OT-P0-001",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Books \u0026 Accounts"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "money-ledger",
          "scenario_path": "/accounts",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-accounts"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.accountTable",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-accounts-primary-binding"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
