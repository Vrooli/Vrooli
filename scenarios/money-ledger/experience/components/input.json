{
  "schemaVersion": "1.0.0",
  "kind": "component-experience-contract",
  "component": {
    "id": "input",
    "title": "Input",
    "purpose": "Provide a token-bound text-entry control with stable text, search, and disabled behavior.",
    "storyRef": "../../library/components/Input/versions/1.1.0/story.json"
  },
  "states": [
    {
      "id": "text",
      "example": "text",
      "description": "Text field with a component-name placeholder."
    },
    {
      "id": "search",
      "example": "search",
      "description": "Search field for filtering components."
    },
    {
      "id": "disabled",
      "example": "disabled",
      "description": "Disabled field that preserves its displayed value."
    }
  ],
  "claims": [
    {
      "id": "text-field-present",
      "type": "element-present",
      "statement": "The text example renders a text-entry field.",
      "tier": "machine",
      "elements": ["field"],
      "states": ["text"]
    },
    {
      "id": "search-field-present",
      "type": "element-present",
      "statement": "The search example renders a text-entry field.",
      "tier": "machine",
      "elements": ["field"],
      "states": ["search"]
    },
    {
      "id": "disabled-field-present",
      "type": "element-present",
      "statement": "The disabled example still renders a text-entry field.",
      "tier": "machine",
      "elements": ["field"],
      "states": ["disabled"]
    },
    {
      "id": "disabled-field-prevents-editing",
      "type": "manual-review",
      "statement": "The disabled example cannot be edited while its displayed value remains available.",
      "tier": "manual",
      "elements": ["field"],
      "states": ["disabled"]
    }
  ],
  "elements": [
    {
      "id": "field",
      "role": "textbox",
      "description": "The native text-entry field."
    }
  ],
  "bindings": {
    "elements": {
      "field": { "selector": "[data-rcl-input]" }
    }
  }
}
