    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "ai-gateway",
    "displayName": "AI Gateway",
    "description": "Policy-driven AI inference gateway for routing scenario AI requests across local and hosted providers",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.5.0"
    },
    "generated_at": "2026-07-05T23:10:37Z",
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    },
    "manifest_sha": "9028ce71643a198490bc79397d83d05174a865c136005e26114ac80d4d557cb5",
    "content_sha": "9e2b2c88e6699f137699fd1819eb7819cbfeb76fe34f29f159fa4c1b300b372a"
  },
  "cli": {
    "enabled": true,
    "command": "ai-gateway",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "invoke": {
      "kind": "installed_command",
      "command": "ai-gateway"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/ai-gateway-api"
            ]
          },
          {
            "type": "cli",
            "command": "ai-gateway"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api \u0026\u0026 GOWORK=off go mod download \u0026\u0026 GOWORK=off go build -o ai-gateway-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api \u0026\u0026 ./ai-gateway-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/ai-gateway-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui \u0026\u0026 node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute ai-gateway --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'ai-gateway-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "Local inference provider for local-first gateway profiles",
        "model_roles": [
          "chat.default",
          "extract.structured",
          "locate.visual"
        ]
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": false,
        "description": "Hosted inference provider for remote-only and reviewed fallback profiles",
        "model_roles": [
          "chat.default",
          "extract.structured",
          "locate.visual"
        ]
      }
    }
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/openrouter",
        "field": "api-key",
        "env": "OPENROUTER_API_KEY",
        "label": "OpenRouter API key for hosted gateway fallback",
        "description": "Process-scoped credential consumed only by the resource-openrouter command invoked behind AI Gateway.",
        "required": false,
        "obtain_url": "https://openrouter.ai/keys"
      },
      {
        "logical_id": "vrooli/lpbs-account",
        "field": "refresh-token",
        "label": "Vrooli subscription session",
        "description": "Device-scoped refresh credential shared by bundled scenarios. AI Gateway keeps only a short-lived access token in memory.",
        "required": false
      }
    ]
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/ai-gateway.db"
  }
}
