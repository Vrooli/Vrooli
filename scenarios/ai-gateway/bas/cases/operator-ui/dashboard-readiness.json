{
  "metadata": {
    "name": "dashboard-readiness",
    "description": "Validate that the AI Gateway operator dashboard renders provider, routing, and conformance surfaces as the first screen.",
    "requirement": "AIGW-UI-DASHBOARD",
    "version": "1",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"AIGW-UI-DASHBOARD\"]"
      ,"spec_entry_id": "dashboard"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "ai-gateway",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to AI Gateway dashboard"
        }
      }
    },
    {
      "id": "wait-dashboard",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.dashboard",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Dashboard page is visible"
        }
      }
    },
    {
      "id": "assert-summary",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/dashboard.summary",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 10000,
          "failure_message": "Dashboard summary metrics should be visible"
        },
        "metadata": {
          "label": "Summary metrics are visible"
        }
      }
    },
    {
      "id": "assert-route-events",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/dashboard.routeEvents",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 10000,
          "failure_message": "Dashboard route evidence panel should be visible"
        },
        "metadata": {
          "label": "Route activity panel is visible"
        }
      }
    }
  ]
}
