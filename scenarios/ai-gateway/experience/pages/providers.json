{
  "$schema": "../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-page",
  "schemaVersion": "1.0.0",
  "page": {
    "id": "providers",
    "title": "Providers And Roles",
    "routes": ["/providers"],
    "purpose": "Show resource-owned roles, policy resolution, available models, smoke-test state, and cross-provider role gaps without making AI Gateway the model catalog source of truth.",
    "prd_refs": ["OT-P0-002", "OT-P0-003", "OT-P1-002"]
  },
  "priorities": [
    {
      "statement": "Separate resource-owned policy data from AI Gateway routing profiles."
    },
    {
      "statement": "Show unsupported or stale roles as actionable provider gaps."
    },
    {
      "statement": "Expose smoke-test results and timestamps alongside each provider role."
    }
  ],
  "states": [
    { "id": "default", "description": "Provider roles are grouped by resource-owned policy data." },
    { "id": "loading", "description": "Provider role inventory is loading." },
    { "id": "empty", "description": "No provider roles were returned." },
    { "id": "request-error", "description": "The provider inventory call failed." }
  ],
  "elements": [
    { "id": "providers-region", "role": "region", "name": "Providers and roles" },
    { "id": "provider-table", "role": "table", "description": "Provider role inventory table." },
    { "id": "provider-empty", "role": "note", "description": "No provider roles returned." },
    { "id": "provider-error", "role": "alert", "description": "Provider inventory error." }
  ],
  "claims": [
    {
      "id": "providers-region-present",
      "type": "element-present",
      "statement": "Provider inventory is presented as an operator region.",
      "tier": "machine",
      "elements": ["providers-region"],
      "states": ["default", "loading", "empty", "request-error"]
    },
    {
      "id": "provider-empty-covered",
      "type": "state-covered",
      "statement": "The empty provider inventory state renders dedicated copy instead of a blank table.",
      "tier": "machine",
      "states": ["empty"]
    }
  ],
  "bindings": {
    "elements": {
      "providers-region": { "testid": "page-providers" },
      "provider-table": { "testid": "providers-table" },
      "provider-empty": { "testid": "providers-empty" },
      "provider-error": { "testid": "providers-error" }
    }
  }
}
