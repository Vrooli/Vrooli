{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "decentralized-deploy",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.decentralized_deploy.v1.notes.NotesService",
            "method": "ListNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Note title"
            },
            {
              "name": "body",
              "description": "Note body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.decentralized_deploy.v1.notes.NotesService",
            "method": "CreateNote"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Note id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.decentralized_deploy.v1.notes.NotesService",
            "method": "GetNote"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            {
              "name": "window",
              "default": "this_week",
              "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)",
              "bind_waiver": "CLI resolves the canonical time-window token into the structured TimeWindow RPC message."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.decentralized_deploy.v1.notes.NotesService",
            "method": "CountNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    },
    {
      "name": "deployment",
      "description": "Deploy and manage the reference bundle through configured storage and naming adapters",
      "commands": [
        {
          "name": "deploy",
          "description": "Deploy the reference bundle",
          "flags": [
            {"name": "id", "required": true, "description": "Stable deployment id"},
            {"name": "name", "required": true, "description": "ENS or ArNS name to bind"},
            {"name": "compute-reference", "required": true, "description": "Compute Manager reference for the deployment"},
            {"name": "storage-provider", "default": "kubo", "description": "Storage adapter (kubo or turbo-sandbox)"}
          ],
          "binding": {"kind": "connect-rpc", "service": "vrooli.decentralized_deploy.v1.deployment.DeploymentService", "method": "Deploy"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "proto_mutation"}
        },
        {
          "name": "get",
          "description": "Read a persisted deployment receipt",
          "positionals": [{"name": "id", "required": true, "description": "Stable deployment id"}],
          "binding": {"kind": "connect-rpc", "service": "vrooli.decentralized_deploy.v1.deployment.DeploymentService", "method": "Get"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "proto_list"}
        },
        {
          "name": "resolve",
          "description": "Resolve content by its stored reference",
          "positionals": [{"name": "id", "required": true, "description": "Stable deployment id"}],
          "binding": {"kind": "connect-rpc", "service": "vrooli.decentralized_deploy.v1.deployment.DeploymentService", "method": "Resolve"},
          "governance": {"effect": "read", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "proto_list"}
        },
        {
          "name": "renew",
          "description": "Renew the configured storage and naming adapter records",
          "positionals": [{"name": "id", "required": true, "description": "Stable deployment id"}],
          "binding": {"kind": "connect-rpc", "service": "vrooli.decentralized_deploy.v1.deployment.DeploymentService", "method": "Renew"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "proto_mutation"}
        },
        {
          "name": "teardown",
          "description": "Remove deployment names and owned storage state",
          "positionals": [{"name": "id", "required": true, "description": "Stable deployment id"}],
          "binding": {"kind": "connect-rpc", "service": "vrooli.decentralized_deploy.v1.deployment.DeploymentService", "method": "Teardown"},
          "governance": {"effect": "write", "run_eligible": true, "permissions": ["network:internal"]},
          "architecture": {"primitive": "proto_mutation"}
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "notes",
        "stateful": true,
        "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier."
      }
    ]
  },
  "exceptions": [
    {
      "command": "notes attach",
      "class": "upload",
      "reason": "Multipart file upload is exposed through the notes REST attachment endpoint, while cli-manifest/v1 only models Connect-RPC bindings."
    }
  ],
  "omitted": []
}
