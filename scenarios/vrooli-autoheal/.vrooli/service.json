{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "vrooli-autoheal",
    "displayName": "Vrooli Autoheal",
    "description": "Self-healing supervisor that bootstraps, monitors, and auto-repairs Vrooli infrastructure across platforms",
    "version": "0.0.1",
    "type": "business-application",
    "category": "infrastructure",
    "tags": [
      "vrooli-helper",
      "emergency-response",
      "infrastructure",
      "self-healing",
      "watchdog",
      "health-monitoring",
      "cross-platform",
      "bootstrap",
      "auto-repair",
      "react-ui",
      "go-api",
      "typescript",
      "vite"
    ],
    "importance": "critical",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/vrooli-autoheal"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server for health status and configuration",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 36236,
      "description": "React dashboard for health visualization"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Autoheal service health checks",
      "startup_grace_period": 15000,
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/vrooli-autoheal-api"
            ]
          },
          {
            "type": "cli",
            "command": "vrooli-autoheal",
            "targets": [
              "vrooli-autoheal"
            ]
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && go mod download && go build -o vrooli-autoheal-api .",
          "description": "Build the Go API binary (vrooli-autoheal-api) for lifecycle orchestration"
        },
        {
          "name": "build-loop",
          "run": "cd cli/loop && go build -o ../vrooli-autoheal-loop .",
          "description": "Compile cross-platform Go loop binary for watchdog"
        },
        {
          "name": "install-ui-deps",
          "run": "cd ui && if [ -f package.json ]; then pnpm install --ignore-workspace; else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies"
        },
        {
          "name": "build-ui",
          "run": "cd ui && pnpm run build",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and UI server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./vrooli-autoheal-api",
          "background": true,
          "description": "Start Go API server",
          "condition": {
            "file_exists": "api/vrooli-autoheal-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite",
      "steps": [
        {
          "name": "run-tests",
          "run": "test-genie execute vrooli-autoheal --preset comprehensive",
          "description": "Run structure/unit/integration/business/performance phases"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'vrooli-autoheal-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'vrooli-autoheal.*server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "redis": {
        "type": "redis",
        "enabled": true,
        "required": false,
        "description": "Real-time status pub/sub (optional, fallback to polling)"
      }
    },
    "scenarios": {}
  },
  "cli": {
    "enabled": true,
    "command": "vrooli-autoheal",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "vrooli-autoheal"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  }
}
