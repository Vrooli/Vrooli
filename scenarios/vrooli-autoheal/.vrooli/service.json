{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "mode": "development",
  "storage": {
    "entries": {
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "vrooli-autoheal",
    "displayName": "Vrooli Autoheal",
    "description": "Self-healing supervisor that bootstraps, monitors, and auto-repairs Vrooli infrastructure across platforms",
    "version": "0.0.1",
    "type": "business-application",
    "category": "infrastructure",
    "capabilities": [
      "autoheal-health-monitoring",
      "autoheal-host-integrity",
      "autoheal-service-recovery",
      "autoheal-watchdog"
    ],
    "platform_capabilities": {
      "autoheal-health-monitoring": {
        "linux": {
          "status": "supported",
          "mechanism": "native-go-checks-and-vrooli-cli",
          "evidence": "autoheal API and scenario-check contract tests"
        },
        "macos": {
          "status": "experimental",
          "mechanism": "typed-vrooli-status-and-platform-go-log-backend",
          "evidence": "darwin cross-build and platform contract tests; no real-host qualification"
        },
        "windows": {
          "status": "experimental",
          "mechanism": "typed-vrooli-status-and-platform-go-log-backend",
          "evidence": "windows cross-build and platform contract tests; no real-host qualification"
        }
      },
      "autoheal-host-integrity": {
        "linux": {
          "status": "supported",
          "mechanism": "control-plane-hostinventory",
          "evidence": "hostinventory contract tests"
        },
        "macos": {
          "status": "unqualified",
          "mechanism": "hostinventory-probe-boundary-reports-not-applicable",
          "evidence": "typed unsupported result contract; no native host qualification"
        },
        "windows": {
          "status": "unqualified",
          "mechanism": "hostinventory-probe-boundary-reports-not-applicable",
          "evidence": "typed unsupported result contract; no native host qualification"
        }
      },
      "autoheal-service-recovery": {
        "linux": {
          "status": "supported",
          "mechanism": "platform-go-native-service-backend-and-setup-grant",
          "evidence": "service recovery unit tests"
        },
        "macos": {
          "status": "experimental",
          "mechanism": "platform-go-launchd-backend",
          "evidence": "darwin cross-build and backend contract tests; no real-host qualification"
        },
        "windows": {
          "status": "experimental",
          "mechanism": "platform-go-scheduled-task-backend",
          "evidence": "windows cross-build and backend contract tests; no real-host qualification"
        }
      },
      "autoheal-watchdog": {
        "linux": {
          "status": "supported",
          "mechanism": "platform-go-systemd-backend",
          "evidence": "Linux watchdog backend tests"
        },
        "macos": {
          "status": "experimental",
          "mechanism": "platform-go-launchd-backend",
          "evidence": "darwin cross-build and backend contract tests; no real-host qualification"
        },
        "windows": {
          "status": "experimental",
          "mechanism": "platform-go-scheduled-task-backend",
          "evidence": "windows cross-build and backend contract tests; no real-host qualification"
        }
      }
    },
    "tags": [
      "vrooli-helper",
      "emergency-response",
      "infrastructure",
      "self-healing",
      "watchdog",
      "health-monitoring",
      "cross-platform",
      "bootstrap",
      "auto-repair",
      "react-ui",
      "go-api",
      "typescript",
      "vite"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/vrooli-autoheal"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server for health status and configuration",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 21236,
      "description": "React dashboard for health visualization"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Autoheal service health checks",
      "startup_grace_period": 15000,
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    }
  },
  "hostTools": [
    {
      "name": "cloudflared",
      "required": true,
      "reason": "Infrastructure health checks and self-healing for the Cloudflare tunnel process",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ]
    },
    {
      "name": "vrooli",
      "required": false,
      "reason": "Structured scenario, resource, registry, and supervisor status is the authoritative monitoring input",
      "when": [
        "setup"
      ],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ]
    },
    {
      "name": "journalctl",
      "required": false,
      "reason": "Linux journal evidence backend; absent on other platforms is reported as unsupported",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "systemctl",
      "required": false,
      "reason": "Linux service observation and recovery backend; setup grants cover fixed recovery units",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "docker",
      "required": false,
      "reason": "Docker resource health is monitored when Docker is installed",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ]
    },
    {
      "name": "timedatectl",
      "required": false,
      "reason": "Linux clock synchronization observation; unsupported elsewhere",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "resolvectl",
      "required": false,
      "reason": "Linux resolver observation; unsupported elsewhere",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "apt-get",
      "required": false,
      "reason": "Optional Debian/Ubuntu package-event and remediation evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "apt-cache",
      "required": false,
      "reason": "Optional Debian/Ubuntu package candidate evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "dpkg-query",
      "required": false,
      "reason": "Optional Debian/Ubuntu package state evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "rpm",
      "required": false,
      "reason": "Optional Fedora/RHEL package state evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "dnf",
      "required": false,
      "reason": "Optional Fedora/RHEL package-event evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "pacman",
      "required": false,
      "reason": "Optional Arch package state evidence",
      "when": [
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "launchctl",
      "required": false,
      "reason": "macOS watchdog lifecycle backend",
      "when": [
        "develop"
      ],
      "platforms": [
        "macos"
      ]
    },
    {
      "name": "log",
      "required": false,
      "reason": "macOS unified-log backend",
      "when": [
        "develop"
      ],
      "platforms": [
        "macos"
      ]
    },
    {
      "name": "schtasks",
      "required": false,
      "reason": "Windows scheduled-task watchdog backend",
      "when": [
        "develop"
      ],
      "platforms": [
        "windows"
      ]
    },
    {
      "name": "powershell.exe",
      "required": false,
      "reason": "Windows event-log backend",
      "when": [
        "develop"
      ],
      "platforms": [
        "windows"
      ]
    }
  ],
  "hostSafeguards": [
    {
      "name": "autoheal_recovery_privileges",
      "required": false,
      "reason": "Setup-provisioned Linux grant for fixed autoheal service recovery actions; unsupported on macOS and Windows",
      "when": [
        "setup"
      ],
      "platforms": [
        "linux",
        "macos",
        "windows"
      ]
    }
  ],
  "dependencies": {
    "resources": {},
    "scenarios": {}
  },
  "cli": {
    "enabled": true,
    "command": "vrooli-autoheal",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "vrooli-autoheal"
    },
    "freshness": {
      "inputs": [
        "api/**",
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "environment": {
    "AUTOHEAL_NETWORK_TARGET": "dns.google:53",
    "AUTOHEAL_DNS_DOMAIN": "example.com",
    "AUTOHEAL_EXTERNAL_DNS_SERVER": "dns.google"
  },
  "retention": {
    "budgets": {
      "system_events": {
        "target": {
          "kind": "sqlite_table",
          "class": "data",
          "database": "autoheal.sqlite",
          "table": "system_events",
          "time_column": "occurred_at"
        },
        "max_age": "30d",
        "max_bytes": "2GiB",
        "pruner": "builtin",
        "rationale": "Host journal ingest. Volume is driven by host conditions Vrooli does not control - an AMDGPU driver fault emitted roughly 1000 lines per second for 17 days, producing 846M rows and 453 GB while the 30d horizon correctly deleted nothing. The byte ceiling is the real bound; the horizon alone is not one. 2GiB is an operator-approved starting figure, not a measured optimum - revisit once normal ingest volume is visible."
      },
      "health_results": {
        "target": {
          "kind": "sqlite_table",
          "class": "data",
          "database": "autoheal.sqlite",
          "table": "health_results",
          "time_column": "created_at"
        },
        "max_age": "30d",
        "pruner": "builtin",
        "rationale": "One row per health check per tick, and measured as the LARGEST table in this database: 12.2 GiB against system_events' 0.86 GiB after the 2026-07-31 remediation. An age bound alone was not a bound here either - the same failure this plan exists to fix, one table over. Each budget's ceiling applies to its own table and indexes.",
        "max_bytes": "2GiB"
      },
      "host_inventory_snapshots": {
        "target": {
          "kind": "sqlite_table",
          "class": "data",
          "database": "autoheal.sqlite",
          "table": "host_inventory_snapshots",
          "time_column": "collected_at"
        },
        "max_age": "90d",
        "pruner": "builtin",
        "rationale": "Full host inventory documents, written only when the fingerprint changes. Measured at 1.7 GiB, so the 90d horizon alone was already letting it drift; the ceiling bounds it.",
        "max_bytes": "1GiB"
      },
      "incident_observations": {
        "target": {
          "kind": "sqlite_table",
          "class": "data",
          "database": "autoheal.sqlite",
          "table": "incident_observations",
          "time_column": "observed_at"
        },
        "max_age": "90d",
        "pruner": "builtin",
        "rationale": "Incident forensics: one row per open incident per source check, throttled to a 30-minute quiet window unless the evidence changes. It had NO deletion path of any kind - no DELETE statement anywhere in the scenario and no ON DELETE CASCADE, so closing an incident never freed its observations and the table only ever grew. Measured at 0.249 GiB over 50 days (12,117 rows averaging 21 KB of evidence_json each, one incident alone holding 2,317), which is ~1 GiB/year at a healthy baseline. The rate is not the reason for the ceiling: growth scales with how many incidents are open, so it is fastest exactly when the fleet is broken and autoheal matters most. 90d keeps forensics across a full quarter of incident history; 512MiB is the bound for when that assumption stops holding.",
        "max_bytes": "512MiB"
      }
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "pnpm",
          "run",
          "start"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
