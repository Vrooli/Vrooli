{
  "name": "vrooli-autoheal-ui",
  "version": "1.0.0",
  "description": "React + Vite front-end for Vrooli Autoheal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vrooli lifecycle protect -- vite",
    "build": "pnpm run type-check && vite build $([ \"$VROOLI_BUILD_MODE\" = profile ] && echo --mode profile)",
    "build:profile": "pnpm run type-check && vite build --mode profile",
    "start": "vrooli lifecycle protect -- node server.js",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "^9.17.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "axe-core": "^4.10.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "express": "^4.22.1",
    "lucide-react": "^0.424.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.5.1",
    "shiki": "^3.22.0",
    "tailwind-merge": "^2.3.0",
    "typescript-eslint": "^8.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vrooli/vitest-requirement-reporter": "file:../../../packages/vitest-requirement-reporter",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@9.12.1",
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.9",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "path-to-regexp@0.1": "0.1.13",
      "flatted": "3.4.4",
      "ajv": "6.15.0",
      "js-yaml": "4.3.1",
      "lodash-es": "4.18.1",
      "rollup": "4.62.4",
      "ws": "8.21.2",
      "uuid": "11.1.1"
    }
  }
}
