  "metadata": {
    "description": "Signed-out offline packaged import of local PNG plate and mask, saved still preview, and ordinary rendered PNG export. The restart/reopen/edit phase is driven through the same-session owner endpoint described in the E7 offline-roundtrip proof recipe.",
    "execution_mode": "mutating",
    "labels": {"desktop_target":"true","requires_confirmation":"true","reset":"none","routed_isolation":"true","surface":"projects","required":"true","network_profile":"offline","restart_continuation":"bas/cases/desktop/offline-roundtrip-resume.json"},
    "name": "desktop-offline-png-roundtrip",
    "requirement": "DS-DESKTOP-PACKAGE",
    "version": "1"
  },
  "nodes": [
    {"id":"wait-projects","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[data-testid=\"projects-create-button\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":30000}}},
    {"id":"open-create","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"[data-testid=\"projects-create-button\"]"}}},
    {"id":"wait-project-dialog","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[role=\"dialog\"] [data-testid=\"projects-name-input\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":10000}}},
    {"id":"type-project","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"[data-testid=\"projects-name-input\"]","value":"Offline PNG round trip","clear_first":true}}},
    {"id":"confirm-project","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"[data-testid=\"confirm-create-project\"]"}}},
    {"id":"wait-project-link","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"article.studio-featured a[href^=\"/projects/\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":15000}}},
    {"id":"open-project","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"article.studio-featured a[href^=\"/projects/\"]"}}},
    {"id":"open-source-media","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"details.shot-source-intake > summary"}}},
    {"id":"upload-plate","action":{"type":"ACTION_TYPE_UPLOAD_FILE","upload_file":{"selector":"[data-testid=\"project-source-media-file\"]","file_paths":["/tmp/device-studio-offline-roundtrip-fixtures/scene-plate.png"]}}},
    {"id":"submit-plate","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"[data-testid=\"project-source-media-upload\"]"}}},
    {"id":"wait-plate","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[data-testid=\"project-source-media-image\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":30000}}},
    {"id":"upload-mask","action":{"type":"ACTION_TYPE_UPLOAD_FILE","upload_file":{"selector":"[data-testid=\"project-source-media-file\"]","file_paths":["/tmp/device-studio-offline-roundtrip-fixtures/active-mask.png"]}}},
    {"id":"submit-mask","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"[data-testid=\"project-source-media-upload\"]"}}},
    {"id":"wait-mask","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"button:has-text(\"active-mask.png\")","state":"WAIT_STATE_VISIBLE","timeout_ms":30000}}},
    {"id":"create-shot","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"[data-testid=\"new-shot-name\"]","value":"Offline still","clear_first":true}}},
    {"id":"submit-shot","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"form.shot-create button[type=submit]"}}},
    {"id":"wait-editor","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[data-testid=\"shot-editor\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":15000}}},
    {"id":"select-plate","action":{"type":"ACTION_TYPE_SELECT","select_option":{"selector":"label.shot-field:has-text(\"Scene plate\") select","label":"scene-plate.png"}}},
    {"id":"open-mask-fields","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"details:has(> summary:has-text(\"Masks and geometry\")) > summary"}}},
    {"id":"select-mask","action":{"type":"ACTION_TYPE_SELECT","select_option":{"selector":"label.shot-field:has-text(\"Active mask\") select","label":"active-mask.png"}}},
    {"id":"save-shot","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":".shot-actions button.studio-primary"}}},
    {"id":"wait-saved","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[role=\"status\"]:has-text(\"Saved revision\")","state":"WAIT_STATE_VISIBLE","timeout_ms":15000}}},
    {"id":"wait-preview","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[data-testid=\"shot-plate-preview\"] img","state":"WAIT_STATE_VISIBLE","timeout_ms":15000}}},
    {"id":"capture-preview","action":{"type":"ACTION_TYPE_SCREENSHOT","screenshot":{"full_page":false,"selector":"[data-testid=\"shot-plate-preview\"]"}}},
    {"id":"render-shot","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"button:has-text(\"Render saved revision\")"}}},
    {"id":"wait-render","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"a.shot-download","state":"WAIT_STATE_VISIBLE","timeout_ms":180000}}},
    {"id":"download-output","action":{"type":"ACTION_TYPE_DOWNLOAD","download":{"selector":"a.shot-download","save_path":"/tmp/device-studio-offline-roundtrip-export.png","timeout_ms":60000}}},
    {"id":"verify-output","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(() => {const link=document.querySelector('a.shot-download');const img=document.querySelector('[data-testid=\"shot-plate-preview\"] img');if(!link||!img||!link.href.endsWith('.png'))throw new Error('Saved plate preview or PNG export is missing');return {savedPlatePreview:!!img.complete,exportName:link.download,exportURLPresent:true};})()","store_result":"offline_png_roundtrip"}}},
    {"id":"quit-app","action":{"type":"ACTION_TYPE_KEYBOARD","keyboard":{"key":"F4","modifiers":["KEYBOARD_MODIFIER_ALT"]}}}
  ],
  "settings": {"viewport_width":1440,"viewport_height":900}
}
