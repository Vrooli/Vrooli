    {"id":"wait-projects","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"[data-testid=\"projects-create-button\"]","state":"WAIT_STATE_VISIBLE","timeout_ms":30000}},"execution_settings":{"continue_on_error":false}},
    {"id":"probe-external-network","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(async()=>{const url='http://192.0.2.1:81/offline-probe-initial';let csp=false;const onViolation=e=>{if(String(e.blockedURI).includes('192.0.2.1'))csp=true};document.addEventListener('securitypolicyviolation',onViolation);const controller=new AbortController();let timedOut=false,resolved=false,failure='';const timeout=setTimeout(()=>{timedOut=true;controller.abort()},2000);try{await fetch(url,{mode:'no-cors',credentials:'omit',cache:'no-store',signal:controller.signal});resolved=true}catch(error){failure=String(error)}finally{clearTimeout(timeout)}await new Promise(resolve=>setTimeout(resolve,0));document.removeEventListener('securitypolicyviolation',onViolation);const observed=performance.getEntriesByName(url).length>0;if(resolved||timedOut||csp||!observed)throw new Error('External TEST-NET denial not proven: '+JSON.stringify({resolved,timedOut,csp,resourceTimingObserved:observed,failure}));return {url,rejected:true,resourceTimingObserved:observed,error:failure}})()","store_result":"offline_external_probe_initial"}},"execution_settings":{"continue_on_error":false}},
