  "metadata": {
    "description": "Signed-out offline packaged import of local PNG scene plate, active mask, and screen image; save and render with explicit display geometry. The restart/reopen/edit phase is driven through the same-session owner endpoint described in the E7 offline-roundtrip proof recipe.",
    "execution_mode": "mutating",
    "labels": {"desktop_target":"true","requires_confirmation":"true","reset":"none","routed_isolation":"true","surface":"projects","required":"true","network_profile":"offline","restart_continuation":"bas/cases/desktop/offline-roundtrip-resume.json"},
