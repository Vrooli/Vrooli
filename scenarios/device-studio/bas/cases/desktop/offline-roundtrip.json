    {"id":"verify-output","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(() => {const link=document.querySelector('a.shot-download');const image=document.querySelector('.shot-final-stage img');if(!link||!image||!link.download.endsWith('.png')||!link.href.startsWith('blob:'))throw new Error('Verified PNG output, visible image, or PNG download name is missing');return {visibleOutput:!!image.complete,downloadName:link.download,outputURLScheme:new URL(link.href).protocol};})()","store_result":"offline_png_roundtrip"}},"execution_settings":{"continue_on_error":false}}
