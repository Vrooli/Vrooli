  "dynamicSelectors": {
    "projects.openButton": {
      "description": "Open action for one project by stable project id",
      "selectorPattern": "[data-testid=\"projects-open-${id}\"]",
      "testIdPattern": "projects-open-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "layout.navLink": {
      "description": "Primary navigation link by canonical nav key; the phone tab derives `-tab` from the same id",
      "selectorPattern": "[data-testid=\"layout-nav-${key}\"]",
      "testIdPattern": "layout-nav-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "layout.navTab": {
      "description": "Phone tab-bar item by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-${key}-tab\"]",
      "testIdPattern": "layout-nav-${key}-tab",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "media.selectButton": {
      "description": "Select one saved source image by stable media ID",
      "selectorPattern": "[data-testid=\"project-source-media-select-${id}\"]",
      "testIdPattern": "project-source-media-select-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    }
  },
