{
  "metadata": {
    "name": "device-studio-p3-media-import-reopen",
    "description": "Leased browser proof of source media import, saved selection and project reopen. Uses only the synthetic media-ui fixture; no rendered shot.",
    "version": "1",
    "execution_mode": "mutating"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 1000
  },
  "nodes": [
    {
      "id": "wait-create",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"projects-create-button\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait create"
        }
      }
    },
    {
      "id": "open-create",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid=\"projects-create-button\"]"
        },
        "metadata": {
          "label": "Open create"
        }
      }
    },
    {
      "id": "wait-name",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"projects-name-input\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait name"
        }
      }
    },
    {
      "id": "name-project",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": {
          "selector": "[data-testid=\"projects-name-input\"]",
          "value": "P3 source media browser proof 2026-10-20",
          "clear_first": true
        },
        "metadata": {
          "label": "Name project"
        }
      }
    },
    {
      "id": "create-project",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid=\"confirm-create-project\"]"
        },
        "metadata": {
          "label": "Create project"
        }
      }
    },
    {
      "id": "wait-project",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "article.studio-featured a.studio-continue",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait project"
        }
      }
    },
    {
      "id": "open-project",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "article.studio-featured a.studio-continue"
        },
        "metadata": {
          "label": "Open project"
        }
      }
    },
    {
      "id": "wait-media-panel",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"project-source-media\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait media panel"
        }
      }
    },
    {
      "id": "choose-fixture",
      "action": {
        "type": "ACTION_TYPE_UPLOAD_FILE",
        "upload_file": {
          "selector": "[data-testid=\"project-source-media-file\"]",
          "file_paths": [
            "/home/matthalloran8/Vrooli/scenarios/device-studio/docs/internal/goal/evidence/E2/media-ui/fixtures/ui-import-source.png"
          ],
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Choose fixture"
        }
      }
    },
    {
      "id": "submit-import",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid=\"project-source-media-upload\"]"
        },
        "metadata": {
          "label": "Submit import"
        }
      }
    },
    {
      "id": "wait-first-preview",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"project-source-media-image\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Wait first preview"
        }
      }
    },
    {
      "id": "back-to-projects",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "a[href=\"/\"]"
        },
        "metadata": {
          "label": "Back to projects"
        }
      }
    },
    {
      "id": "wait-project-after-back",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "article.studio-featured a.studio-continue",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait project after back"
        }
      }
    },
    {
      "id": "reopen-project",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "article.studio-featured a.studio-continue"
        },
        "metadata": {
          "label": "Reopen project"
        }
      }
    },
    {
      "id": "wait-saved-source",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid^=\"project-source-media-select-\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait saved source"
        }
      }
    },
    {
      "id": "select-saved-source",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid^=\"project-source-media-select-\"]"
        },
        "metadata": {
          "label": "Select saved source"
        }
      }
    },
    {
      "id": "wait-reopened-preview",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"project-source-media-image\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Wait reopened preview"
        }
      }
    },
    {
      "id": "assert-original-filename",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid=\"project-source-media-image\"]",
          "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
          "attribute_name": "alt",
          "expected": {
            "stringValue": "Imported source image: ui-import-source.png"
          },
          "case_sensitive": true,
          "timeout_ms": 10000,
          "failure_message": "The reopened saved source image is not selected and previewed."
        },
        "metadata": {
          "label": "Assert original filename"
        }
      }
    },
    {
      "id": "assert-decoded-dimensions",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid=\"project-source-media-preview\"]",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "stringValue": "1200 \u00d7 800"
          },
          "case_sensitive": true,
          "timeout_ms": 10000,
          "failure_message": "The imported source image dimensions are not shown."
        },
        "metadata": {
          "label": "Assert decoded dimensions"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "wait-create",
      "target": "open-create"
    },
    {
      "id": "e2",
      "source": "open-create",
      "target": "wait-name"
    },
    {
      "id": "e3",
      "source": "wait-name",
      "target": "name-project"
    },
    {
      "id": "e4",
      "source": "name-project",
      "target": "create-project"
    },
    {
      "id": "e5",
      "source": "create-project",
      "target": "wait-project"
    },
    {
      "id": "e6",
      "source": "wait-project",
      "target": "open-project"
    },
    {
      "id": "e7",
      "source": "open-project",
      "target": "wait-media-panel"
    },
    {
      "id": "e8",
      "source": "wait-media-panel",
      "target": "choose-fixture"
    },
    {
      "id": "e9",
      "source": "choose-fixture",
      "target": "submit-import"
    },
    {
      "id": "e10",
      "source": "submit-import",
      "target": "wait-first-preview"
    },
    {
      "id": "e11",
      "source": "wait-first-preview",
      "target": "back-to-projects"
    },
    {
      "id": "e12",
      "source": "back-to-projects",
      "target": "wait-project-after-back"
    },
    {
      "id": "e13",
      "source": "wait-project-after-back",
      "target": "reopen-project"
    },
    {
      "id": "e14",
      "source": "reopen-project",
      "target": "wait-saved-source"
    },
    {
      "id": "e15",
      "source": "wait-saved-source",
      "target": "select-saved-source"
    },
    {
      "id": "e16",
      "source": "select-saved-source",
      "target": "wait-reopened-preview"
    },
    {
      "id": "e17",
      "source": "wait-reopened-preview",
      "target": "assert-original-filename"
    },
    {
      "id": "e18",
      "source": "assert-original-filename",
      "target": "assert-decoded-dimensions"
    }
  ]
}
