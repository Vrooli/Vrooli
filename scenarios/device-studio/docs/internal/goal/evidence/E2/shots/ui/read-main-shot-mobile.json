{
  "metadata": {
    "name": "device-studio-d3-final-mobile-capture",
    "description": "Read-only lease-scoped mobile shot editor composition capture after conflict attempt.",
    "version": "1",
    "execution_mode": "EXECUTION_MODE_OBSERVER"
  },
  "settings": {
    "viewport_width": 430,
    "viewport_height": 932
  },
  "nodes": [
    {
      "id": "wait-workspace",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"shot-workspace\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait for saved shots"
        }
      }
    },
    {
      "id": "open-shot-management",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "details.shot-management > summary"
        },
        "metadata": {
          "label": "Open saved-shot selector"
        }
      }
    },
    {
      "id": "select-main-shot",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "nav.shot-list button:has-text(\"Daylight, held still\")"
        },
        "metadata": {
          "label": "Open calibrated phone shot"
        }
      }
    },
    {
      "id": "wait-shot-editor",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"shot-editor\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait for shot editor"
        }
      }
    },
    {
      "id": "assert-shot-name",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid=\"shot-name-input\"]",
          "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
          "attribute_name": "value",
          "expected": {
            "stringValue": "Daylight, held still"
          },
          "timeout_ms": 10000,
          "failure_message": "The selected main shot must be the calibrated held-still phone."
        },
        "metadata": {
          "label": "Assert selected shot"
        }
      }
    },
    {
      "id": "assert-scene-plate",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "img[alt=\"Scene plate: plate.png\"]",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 20000,
          "failure_message": "The retained v6 phone scene plate did not load."
        },
        "metadata": {
          "label": "Assert plate preview"
        }
      }
    },
    {
      "id": "assert-screen-source",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "img[alt=\"Screen source image: source-frame84.png\"]",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 20000,
          "failure_message": "The raw v4 phone app capture did not load as the screen source."
        },
        "metadata": {
          "label": "Assert raw source preview"
        }
      }
    },
    {
      "id": "capture-desktop-fold",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Desktop first viewport, collapsed geometry"
        }
      }
    },
    {
      "id": "capture-desktop-full",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Desktop full page, collapsed geometry"
        }
      }
    },
    {
      "id": "open-geometry",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "summary:has-text(\"Masks and calibration\")"
        },
        "metadata": {
          "label": "Expand calibration controls"
        }
      }
    },
    {
      "id": "capture-desktop-geometry",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Desktop full page with calibration controls expanded"
        }
      }
    }
  ],
  "edges": [
    {
      "source": "wait-workspace",
      "target": "open-shot-management"
    },
    {
      "source": "select-main-shot",
      "target": "wait-shot-editor"
    },
    {
      "source": "wait-shot-editor",
      "target": "assert-shot-name"
    },
    {
      "source": "assert-shot-name",
      "target": "assert-scene-plate"
    },
    {
      "source": "assert-scene-plate",
      "target": "assert-screen-source"
    },
    {
      "source": "assert-screen-source",
      "target": "capture-desktop-fold"
    },
    {
      "source": "capture-desktop-fold",
      "target": "capture-desktop-full"
    },
    {
      "source": "capture-desktop-full",
      "target": "open-geometry"
    },
    {
      "source": "open-geometry",
      "target": "capture-desktop-geometry"
    },
    {
      "source": "open-shot-management",
      "target": "select-main-shot"
    }
  ]
}
