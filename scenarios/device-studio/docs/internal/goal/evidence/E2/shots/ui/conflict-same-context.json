{
  "metadata": {
    "name": "device-studio-d3-same-context-conflict",
    "description": "Lease-scoped UI stale-revision conflict, explicit reapply, and save using one preserved browser page/editor context and browser-native input action.",
    "version": "1",
    "execution_mode": "EXECUTION_MODE_OBSERVER"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 1000
  },
  "nodes": [
    {
      "id": "wait-workspace",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"shot-workspace\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait for saved shots"
        }
      }
    },
    {
      "id": "open-shot-management",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "details.shot-management > summary"
        },
        "metadata": {
          "label": "Open saved-shot selector"
        }
      }
    },
    {
      "id": "select-blank-shot",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "nav.shot-list button:has-text(\"Unfinished study\")"
        },
        "metadata": {
          "label": "Open incomplete shot for draft conflict test"
        }
      }
    },
    {
      "id": "wait-shot-editor",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"shot-editor\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": {
          "label": "Wait for shot editor"
        }
      }
    },
    {
      "id": "assert-shot-name",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid=\"shot-name-input\"]",
          "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
          "expected": {
            "stringValue": "Unfinished study"
          },
          "timeout_ms": 15000,
          "failure_message": "The conflict test must begin from the intended blank shot.",
          "attribute_name": "value"
        },
        "metadata": {
          "label": "The conflict test must begin from the intended blank shot."
        }
      }
    },
    {
      "id": "edit-draft",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": {
          "selector": "label:has-text(\"Scene label\") input",
          "value": "UI draft retained after conflict",
          "clear_first": true
        },
        "metadata": {
          "label": "Type draft text while based on current incomplete revision"
        }
      }
    },
    {
      "id": "hold-for-remote-save",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "new Promise(resolve => setTimeout(() => resolve('ready-for-remote-save'), 45000))"
        },
        "metadata": {
          "label": "Keep the revision-1 editor buffer open for coordinated CLI save"
        }
      }
    },
    {
      "id": "save-stale-draft",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid=\"shot-editor\"] button:has-text(\"Save shot\")"
        },
        "metadata": {
          "label": "Submit the still-open revision-1 draft"
        }
      }
    },
    {
      "id": "assert-conflict",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[role=\"alert\"]",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "stringValue": "This shot changed elsewhere. Reload its latest revision before saving again. Your edits are preserved."
          },
          "timeout_ms": 15000,
          "failure_message": "The stale UI save must return the typed revision conflict and preserve the draft."
        },
        "metadata": {
          "label": "The stale UI save must return the typed revision conflict and preserve the draft."
        }
      }
    },
    {
      "id": "capture-conflict",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Capture conflict state with preserved draft"
        }
      }
    },
    {
      "id": "reapply-draft",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "button:has-text(\"Reapply my draft to latest\")"
        },
        "metadata": {
          "label": "Explicitly reapply the preserved draft to the latest revision"
        }
      }
    },
    {
      "id": "save-reapplied-draft",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid=\"shot-editor\"] button:has-text(\"Save shot\")"
        },
        "metadata": {
          "label": "Save explicitly reapplied draft"
        }
      }
    },
    {
      "id": "assert-saved-revision",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[role=\"status\"]",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "stringValue": "Saved revision 4"
          },
          "timeout_ms": 15000,
          "failure_message": "Reapplying the draft should save it as revision 4."
        },
        "metadata": {
          "label": "Assert saved revision 4"
        }
      }
    },
    {
      "id": "assert-draft-retained",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "label:has-text(\"Scene label\") input",
          "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
          "expected": {
            "stringValue": "UI draft retained after conflict"
          },
          "timeout_ms": 15000,
          "failure_message": "The explicit reapply must preserve the draft value.",
          "attribute_name": "value"
        },
        "metadata": {
          "label": "The explicit reapply must preserve the draft value."
        }
      }
    },
    {
      "id": "capture-saved",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Capture final saved state"
        }
      }
    }
  ],
  "edges": [
    {
      "source": "wait-workspace",
      "target": "open-shot-management"
    },
    {
      "source": "select-blank-shot",
      "target": "wait-shot-editor"
    },
    {
      "source": "wait-shot-editor",
      "target": "assert-shot-name"
    },
    {
      "source": "assert-shot-name",
      "target": "edit-draft"
    },
    {
      "source": "edit-draft",
      "target": "hold-for-remote-save"
    },
    {
      "source": "hold-for-remote-save",
      "target": "save-stale-draft"
    },
    {
      "source": "save-stale-draft",
      "target": "assert-conflict"
    },
    {
      "source": "assert-conflict",
      "target": "capture-conflict"
    },
    {
      "source": "capture-conflict",
      "target": "reapply-draft"
    },
    {
      "source": "reapply-draft",
      "target": "save-reapplied-draft"
    },
    {
      "source": "save-reapplied-draft",
      "target": "assert-saved-revision"
    },
    {
      "source": "assert-saved-revision",
      "target": "assert-draft-retained"
    },
    {
      "source": "assert-draft-retained",
      "target": "capture-saved"
    },
    {
      "source": "open-shot-management",
      "target": "select-blank-shot"
    }
  ]
}
