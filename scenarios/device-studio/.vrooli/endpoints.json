{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.device_studio.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Operational capability description probe returns a dynamic dependency and recovery report."
      }
    },
    {
      "id": "notes_list",
      "path": "/vrooli.device_studio.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_studio.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "notes_create",
      "path": "/vrooli.device_studio.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_studio.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ]
    },
    {
      "id": "notes_get",
      "path": "/vrooli.device_studio.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_studio.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "notes_count",
      "path": "/vrooli.device_studio.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_studio.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ]
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "UploadAttachmentResponse",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.device_studio.v1.notes.UploadAttachmentResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "projects_list",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/ListProjects",
      "method": "POST",
      "summary": "List projects",
      "description": "Returns a bounded page of local projects.",
      "category": "projects"
    },
    {
      "id": "projects_create",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/CreateProject",
      "method": "POST",
      "summary": "Create project",
      "description": "Creates an empty local project.",
      "category": "projects"
    },
    {
      "id": "projects_get",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/GetProject",
      "method": "POST",
      "summary": "Open project",
      "description": "Returns a local project by id.",
      "category": "projects"
    },
    {
      "id": "projects_rename",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/RenameProject",
      "method": "POST",
      "summary": "Rename project",
      "description": "Renames a project only when expected_revision matches; conflicts return ProjectConflict detail.",
      "category": "projects"
    },
    {
      "id": "projects_media_list",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/ListSourceMedia",
      "method": "POST",
      "summary": "List project source media",
      "description": "Returns a bounded page of imported source image metadata.",
      "category": "media"
    },
    {
      "id": "projects_media_get",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/GetSourceMedia",
      "method": "POST",
      "summary": "Get project source media",
      "description": "Returns typed metadata for one imported source image.",
      "category": "media"
    },
    {
      "id": "projects_media_import",
      "path": "/api/v1/projects/{project_id}/media",
      "method": "POST",
      "summary": "Import project source media",
      "description": "Imports one locally uploaded PNG or JPEG and returns typed metadata.",
      "category": "media",
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart carries the file bytes; the response is the proto-typed UploadSourceMediaResponse.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.device_studio.v1.projects.UploadSourceMediaResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "projects_media_content",
      "path": "/api/v1/projects/{project_id}/media/{media_id}/content",
      "method": "GET",
      "summary": "Fetch source image bytes",
      "description": "Serves a verified source image by opaque project and media ids for browser display.",
      "category": "media",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Serves opaque image bytes by identifiers; no generated client applies and content is digest-verified before response.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "shots_create",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/CreateShot",
      "method": "POST",
      "summary": "Create shot revision",
      "description": "Creates an immutable first shot revision in a project.",
      "category": "shots"
    },
    {
      "id": "shots_save",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/SaveShot",
      "method": "POST",
      "summary": "Save shot revision",
      "description": "Appends an immutable revision when expected_revision matches; conflicts return ShotConflict detail.",
      "category": "shots"
    },
    {
      "id": "shots_list",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ListShots",
      "method": "POST",
      "summary": "List shots",
      "description": "Returns a bounded keyset page of project shots.",
      "category": "shots"
    },
    {
      "id": "shots_get",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/GetShot",
      "method": "POST",
      "summary": "Get shot",
      "description": "Returns a shot and its immutable head revision.",
      "category": "shots"
    },
    {
      "id": "shots_revision_get",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/GetShotRevision",
      "method": "POST",
      "summary": "Get shot revision",
      "description": "Returns one immutable historical shot revision.",
      "category": "shots"
    },
    {
      "id": "shots_revision_list",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ListShotRevisions",
      "method": "POST",
      "summary": "List shot revisions",
      "description": "Returns a bounded page of immutable shot revisions.",
      "category": "shots"
    },
    {
      "id": "shots_compile",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/CompileShot",
      "method": "POST",
      "summary": "Compile shot",
      "description": "Resolves source media metadata, semantic digests, and render eligibility for an immutable revision.",
      "category": "shots"
    },
    {
      "id": "shots_validate",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ValidateShot",
      "method": "POST",
      "summary": "Validate shot draft",
      "description": "Validates typed shot fields without persisting a revision.",
      "category": "shots"
    }
  ]
}
