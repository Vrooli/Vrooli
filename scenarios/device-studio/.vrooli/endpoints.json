{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.device_studio.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Operational capability description probe returns a dynamic dependency and recovery report."
      }
    },
    {
      "id": "projects_list",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/ListProjects",
      "method": "POST",
      "summary": "List projects",
      "description": "Returns a bounded page of local projects.",
      "category": "projects"
    },
    {
      "id": "projects_create",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/CreateProject",
      "method": "POST",
      "summary": "Create project",
      "description": "Creates an empty local project.",
      "category": "projects"
    },
    {
      "id": "projects_get",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/GetProject",
      "method": "POST",
      "summary": "Open project",
      "description": "Returns a local project by id.",
      "category": "projects"
    },
    {
      "id": "projects_rename",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/RenameProject",
      "method": "POST",
      "summary": "Rename project",
      "description": "Renames a project only when expected_revision matches; conflicts return ProjectConflict detail.",
      "category": "projects"
    },
    {
      "id": "projects_media_list",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/ListSourceMedia",
      "method": "POST",
      "summary": "List project source media",
      "description": "Returns a bounded page of project-owned source image and recording metadata, including inspection readiness.",
      "category": "media"
    },
    {
      "id": "projects_media_get",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/GetSourceMedia",
      "method": "POST",
      "summary": "Get project source media",
      "description": "Returns typed metadata and inspection readiness for one source media item.",
      "category": "media"
    },
    {
      "id": "projects_media_clock_page",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/GetSourceMediaClockPage",
      "method": "POST",
      "summary": "Page inspected source clock",
      "description": "Returns a bounded digest-bound page of exact video-clock frame ordinals and PTS values plus the inspected rational time base.",
      "category": "media"
    },
    {
      "id": "projects_media_inspection_ensure",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/EnsureSourceMediaInspection",
      "method": "POST",
      "summary": "Ensure source media inspection",
      "description": "Idempotently submits or recovers the one inspection job for immutable source media.",
      "category": "media"
    },
    {
      "id": "projects_media_inspection_retry",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/RetrySourceMediaInspection",
      "method": "POST",
      "summary": "Retry source media inspection",
      "description": "Explicitly retries a settled failed or cancelled inspection using the expected job version.",
      "category": "media"
    },
    {
      "id": "projects_media_inspection_cancel",
      "path": "/vrooli.device_studio.v1.projects.ProjectsService/CancelSourceMediaInspection",
      "method": "POST",
      "summary": "Cancel source media inspection",
      "description": "Cancels one project-owned inspection at its expected job version and reconciles the exact native operation.",
      "category": "media"
    },
    {
      "id": "projects_media_import",
      "path": "/api/v1/projects/{project_id}/media",
      "method": "POST",
      "summary": "Import project source media",
      "description": "Streams one PNG, JPEG, MP4, QuickTime, WebM, or Matroska source and returns typed metadata; accepted recordings remain pending until inspected.",
      "category": "media",
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart carries the file bytes; the response is the proto-typed UploadSourceMediaResponse.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.device_studio.v1.projects.UploadSourceMediaResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "projects_media_content",
      "path": "/api/v1/projects/{project_id}/media/{media_id}/content",
      "method": "GET",
      "summary": "Fetch source media bytes",
      "description": "Serves digest-verified original source image or recording bytes by opaque project and media ids.",
      "category": "media",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Serves opaque source media bytes by identifiers; no generated client applies and content size and digest are verified while streaming.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "devices_candidate_save",
      "path": "/vrooli.device_studio.v1.devices.DevicesService/SaveDeviceCandidate",
      "method": "POST",
      "summary": "Save device candidate",
      "description": "Appends an immutable device candidate revision at the expected head. Candidate state does not imply qualification.",
      "category": "devices"
    },
    {
      "id": "devices_revision_get",
      "path": "/vrooli.device_studio.v1.devices.DevicesService/GetDeviceRevision",
      "method": "POST",
      "summary": "Get device revision",
      "description": "Returns one immutable device candidate revision after verifying its canonical digest.",
      "category": "devices"
    },
    {
      "id": "devices_head_get",
      "path": "/vrooli.device_studio.v1.devices.DevicesService/GetDeviceHead",
      "method": "POST",
      "summary": "Get device head",
      "description": "Returns the current immutable device candidate revision.",
      "category": "devices"
    },
    {
      "id": "devices_revision_list",
      "path": "/vrooli.device_studio.v1.devices.DevicesService/ListDeviceRevisions",
      "method": "POST",
      "summary": "List device revisions",
      "description": "Returns a bounded ascending page of immutable device revisions.",
      "category": "devices"
    },
    {
      "id": "devices_candidate_list",
      "path": "/vrooli.device_studio.v1.devices.DevicesService/ListDeviceCandidates",
      "method": "POST",
      "summary": "List device candidate heads",
      "description": "Returns one latest immutable candidate revision per device in stable identifier order.",
      "category": "devices"
    },
    {
      "id": "scenes_candidate_save",
      "path": "/vrooli.device_studio.v1.scenes.ScenesService/SaveSceneCandidate",
      "method": "POST",
      "summary": "Save scene candidate",
      "description": "Appends an immutable scene candidate revision at the expected head; external artifacts remain soft references and are not qualified by save.",
      "category": "scenes"
    },
    {
      "id": "scenes_revision_get",
      "path": "/vrooli.device_studio.v1.scenes.ScenesService/GetSceneRevision",
      "method": "POST",
      "summary": "Get scene revision",
      "description": "Returns one immutable scene candidate revision after canonical digest verification.",
      "category": "scenes"
    },
    {
      "id": "scenes_head_get",
      "path": "/vrooli.device_studio.v1.scenes.ScenesService/GetSceneHead",
      "method": "POST",
      "summary": "Get scene head",
      "description": "Returns the current immutable scene candidate revision.",
      "category": "scenes"
    },
    {
      "id": "scenes_revision_list",
      "path": "/vrooli.device_studio.v1.scenes.ScenesService/ListSceneRevisions",
      "method": "POST",
      "summary": "List scene revisions",
      "description": "Returns a bounded ascending page of immutable scene revisions.",
      "category": "scenes"
    },
    {
      "id": "scenes_candidate_list",
      "path": "/vrooli.device_studio.v1.scenes.ScenesService/ListSceneCandidates",
      "method": "POST",
      "summary": "List scene candidate heads",
      "description": "Returns one latest immutable candidate revision per scene in stable identifier order.",
      "category": "scenes"
    },
    {
      "id": "motions_candidate_save",
      "path": "/vrooli.device_studio.v1.motions.MotionsService/SaveMotionCandidate",
      "method": "POST",
      "summary": "Save motion candidate",
      "description": "Appends an immutable motion candidate revision at the expected head; local validity does not resolve external targets or qualify motion.",
      "category": "motions"
    },
    {
      "id": "motions_revision_get",
      "path": "/vrooli.device_studio.v1.motions.MotionsService/GetMotionRevision",
      "method": "POST",
      "summary": "Get motion revision",
      "description": "Returns one immutable motion candidate revision after canonical digest verification.",
      "category": "motions"
    },
    {
      "id": "motions_head_get",
      "path": "/vrooli.device_studio.v1.motions.MotionsService/GetMotionHead",
      "method": "POST",
      "summary": "Get motion head",
      "description": "Returns the current immutable motion candidate revision.",
      "category": "motions"
    },
    {
      "id": "motions_revision_list",
      "path": "/vrooli.device_studio.v1.motions.MotionsService/ListMotionRevisions",
      "method": "POST",
      "summary": "List motion revisions",
      "description": "Returns a bounded ascending page of immutable motion revisions.",
      "category": "motions"
    },
    {
      "id": "motions_candidate_list",
      "path": "/vrooli.device_studio.v1.motions.MotionsService/ListMotionCandidates",
      "method": "POST",
      "summary": "List motion candidate heads",
      "description": "Returns one latest immutable candidate revision per motion in stable identifier order.",
      "category": "motions"
    },
    {
      "id": "library_bundle_revision_list",
      "path": "/vrooli.device_studio.v1.library.LibraryCatalogService/ListBundleRevisions",
      "method": "POST",
      "summary": "List reviewed bundle revisions",
      "description": "Returns bounded, validated bundle and review metadata without exposing artifact storage keys or bytes.",
      "category": "library"
    },
    {
      "id": "library_bundle_revision_get",
      "path": "/vrooli.device_studio.v1.library.LibraryCatalogService/GetBundleRevision",
      "method": "POST",
      "summary": "Get a reviewed bundle revision",
      "description": "Returns one immutable bundle manifest and its digest-bound review metadata without artifact bytes.",
      "category": "library"
    },
    {
      "id": "physical_starter_initialize",
      "path": "/vrooli.device_studio.v1.physical.PhysicalStarterService/InitializeReviewedStarter",
      "method": "POST",
      "summary": "Initialize reviewed physical starter candidates",
      "description": "Publishes the fixed locally reviewed starter bytes through the Library and creates immutable unqualified candidate revisions on the active storage route.",
      "category": "physical"
    },
    {
      "id": "shots_create",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/CreateShot",
      "method": "POST",
      "summary": "Create shot revision",
      "description": "Creates an immutable first shot revision in a project.",
      "category": "shots"
    },
    {
      "id": "shots_save",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/SaveShot",
      "method": "POST",
      "summary": "Save shot revision",
      "description": "Appends an immutable revision when expected_revision matches; conflicts return ShotConflict detail.",
      "category": "shots"
    },
    {
      "id": "shots_list",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ListShots",
      "method": "POST",
      "summary": "List shots",
      "description": "Returns a bounded keyset page of project shots.",
      "category": "shots"
    },
    {
      "id": "shots_get",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/GetShot",
      "method": "POST",
      "summary": "Get shot",
      "description": "Returns a shot and its immutable head revision.",
      "category": "shots"
    },
    {
      "id": "shots_revision_get",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/GetShotRevision",
      "method": "POST",
      "summary": "Get shot revision",
      "description": "Returns one immutable historical shot revision.",
      "category": "shots"
    },
    {
      "id": "shots_revision_list",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ListShotRevisions",
      "method": "POST",
      "summary": "List shot revisions",
      "description": "Returns a bounded page of immutable shot revisions.",
      "category": "shots"
    },
    {
      "id": "shots_compile",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/CompileShot",
      "method": "POST",
      "summary": "Compile shot",
      "description": "Resolves source media metadata, semantic digests, and render eligibility for an immutable revision.",
      "category": "shots"
    },
    {
      "id": "shots_validate",
      "path": "/vrooli.device_studio.v1.shots.ShotsService/ValidateShot",
      "method": "POST",
      "summary": "Validate shot draft",
      "description": "Validates typed shot fields without persisting a revision.",
      "category": "shots"
    },
    {
      "id": "render_submit",
      "path": "/vrooli.device_studio.v1.shots.RenderJobsService/SubmitRender",
      "method": "POST",
      "summary": "Submit a render",
      "description": "Submits an immutable still render, video sample preview, or fixed-profile MP4 render to the shared durable local job ledger.",
      "category": "renders"
    },
    {
      "id": "render_sample_binding",
      "path": "/vrooli.device_studio.v1.shots.RenderJobsService/GetVideoSampleBinding",
      "method": "POST",
      "summary": "Get verified phone video sample claim",
      "description": "Returns a server-verified AUTO phone trim-start sample claim for saving into a new immutable shot revision; manual and browser previews do not produce saveable claims.",
      "category": "renders"
    },
    {
      "id": "render_get",
      "path": "/vrooli.device_studio.v1.shots.RenderJobsService/GetRender",
      "method": "POST",
      "summary": "Get render job",
      "description": "Reads a project-owned render job without advancing execution.",
      "category": "renders"
    },
    {
      "id": "render_list",
      "path": "/vrooli.device_studio.v1.shots.RenderJobsService/ListRenders",
      "method": "POST",
      "summary": "List render jobs",
      "description": "Returns a bounded project-scoped keyset page of render jobs.",
      "category": "renders"
    },
    {
      "id": "render_cancel",
      "path": "/vrooli.device_studio.v1.shots.RenderJobsService/CancelRender",
      "method": "POST",
      "summary": "Cancel render job",
      "description": "Requests cancellation using an expected job version.",
      "category": "renders"
    },
    {
      "id": "render_output_content",
      "path": "/api/v1/projects/{project_id}/renders/{render_id}/content",
      "method": "GET",
      "summary": "Fetch rendered output",
      "description": "Streams digest-verified PNG, sample PNG, or MP4 bytes for a succeeded project-owned render.",
      "category": "renders",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Streams verified opaque output bytes by project and job id; no filesystem path is exposed.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "proto_full_name": "vrooli.device_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    }
  ]
}
