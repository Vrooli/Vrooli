{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "scalable-app-cookbook",
    "displayName": "Scalable App Cookbook",
    "description": "Comprehensive architectural patterns cookbook for building maintainable, scalable applications",
    "version": "1.0.0",
    "tags": [
      "technical-reference",
      "architecture",
      "patterns",
      "scalability",
      "enterprise",
      "cookbook",
      "best-practices",
      "microservices",
      "design-patterns",
      "postgres-storage",
      "go-api",
      "documentation"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/scalable-app-cookbook"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Scalable app cookbook API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Scalable app cookbook web interface",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Scalable App Cookbook health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "postgres_connection",
          "type": "postgres",
          "target": "scalable_app_cookbook",
          "critical": true,
          "timeout": 3000,
          "interval": 60000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Initialize Scalable App Cookbook with database and pattern library",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/scalable-app-cookbook-api"
            ]
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          },
          {
            "type": "cli",
            "command": "scalable-app-cookbook",
            "targets": [
              "scalable-app-cookbook"
            ]
          },
          {
            "type": "resources",
            "populated": true
          }
        ]
      },
      "steps": [
        {
          "name": "install-ui-deps",
          "run": "cd ui && npm install",
          "description": "Install UI dependencies"
        },
        {
          "name": "build-ui",
          "run": "cd ui && npm run build",
          "description": "Build React UI"
        },
        {
          "name": "build-api",
          "run": "cd api && go mod download && go build -o scalable-app-cookbook-api .",
          "description": "Build Go API binary"
        }
      ]
    },
    "develop": {
      "description": "Start Scalable App Cookbook with production UI bundle",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./scalable-app-cookbook-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/scalable-app-cookbook-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.cjs",
          "description": "Start Express server with built React app",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Comprehensive phased testing for scalable-app-cookbook",
      "steps": [
        {
          "name": "run-phased-tests",
          "run": "test-genie execute scalable-app-cookbook --preset comprehensive",
          "description": "Execute phased scenario test suite"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "purpose": "Store architectural patterns, recipes, implementations, and search metadata"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "purpose": "Generate pattern explanations, recommendations, and code examples on demand"
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "scalable-app-cookbook",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "scalable-app-cookbook"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  }
}
