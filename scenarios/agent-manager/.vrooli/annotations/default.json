{
  "pack": {
    "name": "default",
    "version": "2026-11-20.6",
    "runtime": {
      "mode": "passive",
      "default_role": "decide.fast",
      "escalate_role": "decide.accurate",
      "escalation": {
        "enabled": true,
        "min_confidence": 0.55,
        "max_labels": 16
      },
      "batch": {
        "max_states": 8,
        "max_questions": 4
      },
      "backfill_horizon_days": 30,
      "budgets": {
        "max_runs_per_pass": 50,
        "max_decision_states_per_pass": 64,
        "max_seconds_per_pass": 90
      },
      "model_affinity": "laya",
      "digest_chars": 1200
    },
    "labels": [
      {
        "id": "run.type",
        "group": "run",
        "description": "What kind of work the run performed. Deterministic from workload identity; a decision model answers only the residual.",
        "scope": "run",
        "method": "deterministic",
        "rule": "workload_kind in ['workflow_node', 'scheduled', 'interactive', 'adhoc', 'imported'] ? (workload_kind == 'workflow_node' ? 'workflow' : workload_kind) : ''",
        "fallback": "decision",
        "question": {
          "type": "choice",
          "instructions": "The state describes one Agent Manager run. Classify what kind of work the run performed from workload.kind, harness_kind, run_mode and terminal evidence. Choose the single best option.",
          "options": [
            {
              "label": "workflow",
              "description": "One node of a declared workflow execution."
            },
            {
              "label": "scheduled",
              "description": "Work created by a schedule or recurring trigger."
            },
            {
              "label": "interactive",
              "description": "An operator-attached interactive terminal session."
            },
            {
              "label": "adhoc",
              "description": "A one-off run created directly, with no workflow or schedule."
            },
            {
              "label": "imported",
              "description": "A run imported from historical harness transcripts."
            }
          ]
        },
        "evidence": [
          {
            "source": "workload",
            "field": "kind"
          },
          {
            "source": "workload",
            "field": "key"
          },
          {
            "source": "terminal",
            "field": "status"
          }
        ],
        "sampling": {
          "rate": 1.0,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.95,
          "recall": 0.95,
          "min_gold": 100
        },
        "search": {
          "facet": "label:run.type",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": false,
          "cost_unit": "run",
          "importance": "low"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        }
      },
      {
        "id": "run.outcome",
        "group": "run",
        "description": "The run's terminal outcome, preferring the typed terminal pair and falling back to a decision model only when the terminal field is missing.",
        "scope": "run",
        "method": "deterministic",
        "rule": "(status == 'completed' || status == 'succeeded') ? 'completed' : (status == 'failed' ? 'failed' : (status == 'cancelled' ? 'cancelled' : (status == 'partial' ? 'partial' : '')))",
        "fallback": "decision",
        "question": {
          "type": "choice",
          "instructions": "The state describes one Agent Manager run. Classify its outcome from terminal status, terminal class, stop reason and the last operator/agent exchange. Choose the single best option.",
          "options": [
            {
              "label": "completed",
              "description": "The requested work finished successfully."
            },
            {
              "label": "failed",
              "description": "The run terminated because the work or executor failed."
            },
            {
              "label": "cancelled",
              "description": "The run stopped on an operator or lifecycle request."
            },
            {
              "label": "partial",
              "description": "Some requested work landed but the run did not complete it."
            }
          ]
        },
        "evidence": [
          {
            "source": "terminal",
            "field": "status"
          },
          {
            "source": "terminal",
            "field": "class"
          },
          {
            "source": "terminal",
            "field": "stop_reason"
          },
          {
            "source": "operator_messages",
            "field": "last_text"
          }
        ],
        "sampling": {
          "rate": 1.0,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.85,
          "recall": 0.85,
          "min_gold": 100
        },
        "search": {
          "facet": "label:run.outcome",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": false,
          "cost_unit": "run",
          "importance": "low"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        }
      },
      {
        "id": "agent.spinning",
        "group": "agent",
        "description": "The agent repeated work without making progress: re-reading the same paths, retrying failed commands, or burning turns with no new evidence.",
        "scope": "run",
        "method": "decision",
        "question": {
          "type": "noul",
          "instructions": "The state is a bounded digest of one coding-agent run. Decide whether the agent repeated work without making progress: it re-read the same file, re-ran the same command, or retried the same failing operation enough times to cost meaningful time. The tool block reports repeated_paths (the same path touched again), repeated_commands (the same command issued again), failed_commands and the number of distinct failures. Many *different* failures while the run keeps producing new results is normal debugging, not spinning.",
          "true_description": "The same path or command was repeated at least ten times, or the same failing operation was retried repeatedly while the run stalled without new results.",
          "false_description": "There is no evidence of substantial repeated work: failures were distinct, were worked around, or repetition stayed incidental to progress."
        },
        "evidence": [
          {
            "source": "timings",
            "field": "duration_min"
          },
          {
            "source": "tool_summary",
            "field": "failed_commands"
          },
          {
            "source": "tool_summary",
            "field": "repeated_paths"
          },
          {
            "source": "operator_messages",
            "field": "last_text"
          },
          {
            "source": "agent_text",
            "field": "last_text"
          }
        ],
        "candidates": "duration_min >= 8 || failed_commands >= 2 || repeated_paths >= 3 || repeated_commands >= 3",
        "sampling": {
          "rate": 0.35,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 40,
          "measured": {
            "precision": 0.13,
            "recall": 0.75,
            "gold": 47,
            "threshold": 0.6,
            "definition_hash": "065f9b82eacc8d39165818e839dfe9994d433bec26856365eac5fa7affb41fd9"
          }
        },
        "search": {
          "facet": "label:agent.spinning",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "high"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "agent_text_count > 0 || tool_calls > 0"
      },
      {
        "id": "agent.discovery_slow",
        "group": "agent",
        "description": "The agent took too long to find the right file, command or contract before it could act.",
        "scope": "run",
        "method": "decision",
        "question": {
          "type": "score",
          "instructions": "The state is a bounded digest of one coding-agent run. Score how much time the agent lost discovering where or how to act: repeated failed commands, retried tools, repeated path reads and a long time before the first tool call. 0 means discovery was quick and direct; 4 means discovery dominated the run.",
          "levels": [
            "0: found the target immediately",
            "1: minor searching, no material delay",
            "2: noticeable discovery cost",
            "3: most of the run was spent discovering the target",
            "4: discovery dominated and the run barely progressed"
          ]
        },
        "evidence": [
          {
            "source": "timings",
            "field": "time_to_first_tool_min"
          },
          {
            "source": "tool_summary",
            "field": "failures"
          },
          {
            "source": "tool_summary",
            "field": "repeated_paths"
          },
          {
            "source": "tool_summary",
            "field": "failed_tools"
          }
        ],
        "candidates": "duration_min >= 15 || tool_failures >= 3 || repeated_paths >= 2",
        "sampling": {
          "rate": 0.35,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 40
        },
        "search": {
          "facet": "label:agent.discovery_slow",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "medium",
          "min_score": 2
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "tool_calls > 0"
      },
      {
        "id": "agent.objective_lost",
        "group": "agent",
        "description": "The run kept working after its objective was no longer present. A deterministic step-back trigger is the prior; the decision model answers the residual.",
        "scope": "run",
        "method": "decision",
        "prior_rule": "'objective-lost' in stepback_triggers",
        "question": {
          "type": "noul",
          "instructions": "The state is a bounded digest of one coding-agent run. Does the evidence show that the agent lost the original objective: work continued on a stale or different goal, or a compaction omitted the objective and the turn kept going?",
          "true_description": "The run's work no longer matches the stated objective, or a step-back trigger shows the objective was lost.",
          "false_description": "The run stayed on its objective, or the evidence cannot establish that it was lost."
        },
        "evidence": [
          {
            "source": "deterministic_flags",
            "field": "stepback_triggers"
          },
          {
            "source": "deterministic_flags",
            "field": "compaction_count"
          },
          {
            "source": "operator_messages",
            "field": "text"
          },
          {
            "source": "agent_text",
            "field": "last_text"
          }
        ],
        "candidates": "compaction_count > 0 || duration_min >= 30",
        "sampling": {
          "rate": 0.5,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 30
        },
        "search": {
          "facet": "label:agent.objective_lost",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "high"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "operator_message_count > 0 || agent_text_count > 0"
      },
      {
        "id": "agent.scope_drift",
        "group": "agent",
        "description": "The run did work outside the requested scope: touching unrelated files, changing unrelated modules, or expanding the task without being asked.",
        "scope": "run",
        "method": "decision",
        "question": {
          "type": "noul",
          "instructions": "The state is a bounded digest of one coding-agent run. Does the evidence show scope drift: work on files or modules outside the requested task, or an unrequested expansion of the work?",
          "true_description": "The run changed or investigated work outside the stated scope without an operator request.",
          "false_description": "The run stayed within the requested scope, or the evidence cannot establish drift."
        },
        "evidence": [
          {
            "source": "operator_messages",
            "field": "text"
          },
          {
            "source": "agent_text",
            "field": "last_text"
          },
          {
            "source": "tool_summary",
            "field": "repeated_paths"
          },
          {
            "source": "terminal",
            "field": "status"
          }
        ],
        "candidates": "operator_message_count >= 3 && duration_min >= 10",
        "sampling": {
          "rate": 0.4,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 30
        },
        "search": {
          "facet": "label:agent.scope_drift",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "medium"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "operator_message_count > 0 && agent_text_count > 0"
      },
      {
        "id": "work.blocked_by_tool",
        "group": "work",
        "description": "The work was blocked by a tool failure or a broken tool contract. Existing tool findings are the prior.",
        "scope": "run",
        "method": "decision",
        "prior_rule": "size(tool_findings) > 0",
        "question": {
          "type": "noul",
          "instructions": "The state is a bounded digest of one coding-agent run. Was the work blocked by a tool: a command that failed and could not be worked around, a missing tool, or a broken tool contract?",
          "true_description": "A tool failure prevented or materially delayed the requested work.",
          "false_description": "Tools worked, or a failure was worked around without blocking the work."
        },
        "evidence": [
          {
            "source": "tool_summary",
            "field": "failures"
          },
          {
            "source": "tool_summary",
            "field": "failed_tools"
          },
          {
            "source": "tool_summary",
            "field": "last_error"
          },
          {
            "source": "deterministic_flags",
            "field": "tool_findings"
          }
        ],
        "candidates": "tool_failures >= 2 || failed_commands >= 1",
        "sampling": {
          "rate": 0.6,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 30
        },
        "search": {
          "facet": "label:work.blocked_by_tool",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "high"
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "tool_failures > 0 || failed_commands > 0 || size(tool_findings) > 0"
      },
      {
        "id": "interaction.misunderstanding",
        "group": "interaction",
        "description": "Operator and agent misread each other: the operator had to correct what the agent thought was meant. Existing correction signals are the prior.",
        "scope": "run",
        "method": "decision",
        "prior_rule": "'correction' in existing_signals && existing_signals['correction'] >= 0.6",
        "question": {
          "type": "noul",
          "instructions": "The state is a bounded digest of one coding-agent run. Did the operator and agent misunderstand each other: the operator corrected the agent's interpretation, restated the request, or rejected the agent's reading of the task?",
