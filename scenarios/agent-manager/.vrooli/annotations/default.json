          "false_description": "The exchange shows agreement, a new request, or no evidence of misunderstanding."
        },
        "evidence": [
          {
            "source": "existing_signals",
            "field": "probability",
            "label": "correction"
          },
          {
            "source": "operator_messages",
            "field": "text"
          },
          {
            "source": "agent_text",
            "field": "last_text"
          }
        ],
        "candidates": "operator_message_count >= 2",
        "sampling": {
          "rate": 0.4,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 30
        },
        "search": {
          "facet": "label:interaction.misunderstanding",
          "min_probability": 0.6
