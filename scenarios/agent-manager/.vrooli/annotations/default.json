      {
        "id": "operator.valence",
        "group": "operator",
        "description": "The operator's affect toward the run on a -2..+2 scale. This is the primary affect label; a coarse ordinal score is more robust on small local models than six-way emotion.",
        "scope": "run",
        "method": "decision",
        "question": {
          "type": "score",
          "instructions": "The state is a bounded digest of one coding-agent run, including the operator's messages and the agent text they responded to. Score the operator's affect toward the run from -2 (strongly negative) to +2 (strongly positive). Judge only what the operator's own messages show; do not infer a mood from the agent's text.",
          "levels": [
            "-2: strongly negative: angry, exasperated, or harshly critical",
            "-1: negative: frustrated or dissatisfied",
            "0: neutral or no affect",
            "+1: positive: satisfied or pleased",
            "+2: strongly positive: delighted or emphatic praise"
          ],
          "offset": -2
        },
        "evidence": [
          {
            "source": "operator_messages",
            "field": "text"
          },
          {
            "source": "agent_text",
            "field": "last_text"
          },
          {
            "source": "existing_signals",
            "field": "probability",
            "label": "frustration"
          },
          {
            "source": "existing_signals",
            "field": "probability",
            "label": "satisfaction"
          }
        ],
        "candidates": "operator_message_count >= 1",
        "sampling": {
          "rate": 0.5,
          "stratum": "candidate"
        },
        "gate": {
          "precision": 0.8,
          "recall": 0.7,
          "min_gold": 40
        },
        "search": {
          "facet": "label:operator.valence",
          "min_probability": 0.6
        },
        "friction": {
          "enabled": true,
          "min_probability": 0.6,
          "cost_unit": "run",
          "importance": "high",
          "max_score": -1
        },
        "compatibility": {
          "change": "breaking",
          "compatible_with": []
        },
        "require": "operator_message_count > 0 && workload_kind != 'workflow_node'"
      },
