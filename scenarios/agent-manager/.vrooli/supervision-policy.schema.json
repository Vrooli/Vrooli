{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vrooli://agent-manager/supervision-policy/v1",
  "title": "Immutable Agent Manager Supervision Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "event_count", "quiet_seconds", "friction_threshold", "terminal", "allowed_actions", "classifier_revision"],
  "properties": {
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "event_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "quiet_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "friction_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "terminal": {"type": "boolean"},
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["observe", "park", "nudge", "escalate", "wake_parent"]}
    },
    "classifier_revision": {"type": "string", "maxLength": 128},
    "evaluator_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
