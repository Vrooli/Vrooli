{
  "$schema": "../../../program-runtime/schemas/program-contract.schema.json",
  "name": "agent-manager.efficiency-report",
  "version": "1",
  "helpers": {"program": "1"},
  "purpose": "Read one bounded, deterministic invocation-efficiency report without inference or delegation.",
  "inputs": {
    "preset": {"type": "string", "default": "24h", "description": "Time window preset: 6h, 12h, 24h, 7d, or 30d."},
    "start": {"type": "string", "default": "", "description": "Optional RFC3339 lower bound."},
    "end": {"type": "string", "default": "", "description": "Optional RFC3339 upper bound."},
    "tag_prefix": {"type": "string", "default": "", "description": "Optional run tag prefix filter."},
    "group_by": {"type": "string", "default": "profile", "description": "Breakdown dimension."},
    "limit": {"type": "integer", "default": 20, "description": "Maximum rows per breakdown, range [1, 100]."},
    "compare": {"type": "string", "default": "", "description": "Optional equal-length comparison window: previous."}
  },
  "assumptions": [
    "Agent Manager is running and the durable invocation projection is reachable",
    "the projection excludes imported and interactive workloads from this operational cohort",
    "terminal status is evidence of lifecycle outcome only and does not establish usefulness",
    "previous-window deltas are directional comparisons and are not causal estimates"
  ],
  "invariants": [
    "the single efficiency binding is read-only and makes zero inference calls",
    "the report is bounded by the selected window, group dimension, and limit",
    "the caller treats partial and unavailable rows as unknown, never as zero"
  ],
  "bindings": [
    {"id": "agent-manager/measures/run-volume", "effect": "read"},
    {"id": "agent-manager/measures/run-success-rate", "effect": "read"},
    {"id": "agent-manager/measures/run-duration-statistics", "effect": "read"},
    {"id": "agent-manager/measures/run-cost", "effect": "read"},
    {"id": "agent-manager/measures/run-status-distribution", "effect": "read"},
    {"id": "agent-manager/measures/profile-breakdown", "effect": "read"},
    {"id": "agent-manager/measures/runner-breakdown", "effect": "read"},
    {"id": "agent-manager/measures/model-breakdown", "effect": "read"},
    {"id": "agent-manager/measures/tool-usage", "effect": "read"}
  ],
  "verbs": [],
  "outputs": {
    "status": {"enum": ["ok", "partial", "unavailable", "failed"]},
    "phase": {"enum": ["validate", "collect", "report"]},
    "signals": {"description": "The bounded efficiency response and its evidence."},
    "errors": {"classes": ["invalid_input", "binding_error", "stale_evidence", "scenario_unreachable", "deadline_exceeded", "kernel_runtime"]}
  },
  "budget": {"wall_ms": 15000, "async": false, "inference_calls": 0, "delegated_runs": 0, "materialize_limit": 100}
  ,"fixtures": [
    {
      "id": "invalid-compare",
      "inputs": {"compare": "current"},
      "expect": {"status": ["failed"], "errors": [{"class": "invalid_input"}]},
      "requires": []
    },
    {
      "id": "live-read",
      "inputs": {"preset": "24h", "group_by": "profile", "compare": "previous"},
      "expect": {"status": ["ok", "partial", "unavailable"]},
      "requires": ["agent-manager"]
    }
  ],
  "rung": "S3",
  "owner_skill": "reviewing-agent-run-efficiency"
}
