{
  "$schema": "../../../program-runtime/schemas/program-contract.schema.json",
  "name": "agent-manager.supervision-evaluate",
  "version": "1",
  "purpose": "Turn one finite watch snapshot, friction slice, child-summary set, immutable policy, and decision history into a bounded typed supervision recommendation.",
  "inputs": {
    "watch_id": {
      "type": "string",
      "description": "Optional durable watch to inspect when an event batch is not supplied."
    },
    "events": {
      "type": "array",
      "default": [],
      "description": "At most 64 event metadata rows conforming to schemas/supervision-evaluate.input.schema.json."
    },
    "friction_episodes": {
      "type": "array",
      "default": [],
      "description": "At most 16 bounded friction summaries; never transcript bodies."
    },
    "run_summaries": {
      "type": "array",
      "default": [],
      "description": "At most 32 durable child-state summaries."
    },
    "prior_decisions": {
      "type": "array",
      "default": [],
      "description": "At most eight prior decision summaries used only for context and deduplication evidence."
    },
    "policy": {
      "type": "object",
      "required": true,
      "description": "One immutable symbolic policy version with thresholds and allowed recommendation kinds."
    },
    "current_cursor": {
      "type": "string",
      "required": true,
      "description": "Opaque cursor at the start of this finite evaluation."
    },
    "proposed_next_cursor": {
      "type": "string",
      "required": true,
      "description": "Opaque cursor supplied by Agent Manager for successful consumption; the program never manufactures cursors."
    },
    "cursor_reset_required": {
      "type": "boolean",
      "default": false,
      "description": "Typed retention reset signal supplied by Agent Manager or the watch inspection binding."
    },
    "reset_reason": {
      "type": "string",
      "default": "",
      "description": "Bounded typed reset detail."
    },
    "allow_inference": {
      "type": "boolean",
      "default": true,
      "description": "When false, ambiguous evidence abstains and maps to a safe recommendation without inference."
    },
    "input_byte_budget": {
      "type": "integer",
      "default": 32768,
      "description": "Serialized input ceiling in bytes, range 1024 to 65536."
    }
  },
  "assumptions": [
    "Agent Manager owns watch state, cursor advancement, durable decisions, permissions, and action execution",
    "policy is immutable for the family execution and its version matches the watch policy version",
    "event, friction, run-summary, and decision inputs contain metadata and bounded summaries only",
    "watch inspection and action history are read-only and optional when the caller supplies a complete replay batch",
    "AI Gateway is called only after deterministic reset, terminal, failure, friction, count, and empty-batch predicates do not decide"
  ],
  "invariants": [
    "the program is finite and holds no durable watch, timer, cursor, or action authority",
    "no write or destructive binding is called and no grant permits unsafe actuation",
    "at most 64 events, 16 friction episodes, 32 child summaries, eight prior decisions, and 20 evidence IDs are materialized",
    "at most one schema-constrained inference call occurs and deterministic predicates always run first",
    "the program never manufactures or interprets an opaque cursor and returns only a caller-supplied cursor or a typed reset",
    "malformed, oversized, unavailable, abstaining, and budget-exhausted paths still print one bounded typed disposition",
    "the envelope is printed exactly once on every path"
  ],
  "bindings": [
    {
      "id": "agent-manager/watch/inspect",
      "effect": "read",
      "optional": true,
      "note": "Used only when watch_id is supplied without embedded events."
    },
    {
      "id": "agent-manager/watch/actions",
      "effect": "read",
      "optional": true,
      "note": "Reads at most eight prior action summaries for live context."
    },
    {
      "id": "ai-gateway/inference/run",
      "effect": "read",
      "optional": true,
      "via": "ai.classify",
      "note": "Used at most once for ambiguous compact evidence."
    }
  ],
  "verbs": [
    "gather",
    "ai.classify"
  ],
  "outputs": {
    "status": {
      "enum": [
        "ok",
        "unavailable",
        "refused",
        "failed"
      ]
    },
    "phase": {
      "enum": [
        "validate",
        "collect",
        "classify",
        "decide",
        "report"
      ]
    },
    "signals": {
      "disposition": "quiet, signal, terminal, cursor_reset, or unavailable",
      "classification": "closed supervision classification vocabulary from the output schema",
      "confidence": "deterministic 1.0, constrained classifier confidence, or null when unavailable",
      "abstained": "true when inference was disabled, unavailable, or explicitly abstained",
      "recommended_action": "one symbolic recommendation filtered through policy.allowed_actions; never an authorization",
      "next_cursor": "the caller-supplied opaque proposed cursor, current cursor on non-consuming paths, or null for reset",
      "cursor_reset": "true only when retained history cannot support the supplied cursor",
      "wake_condition": "bounded immediate, after-seconds, or terminal wake condition",
      "policy_version": "the immutable policy version evaluated",
      "inference_calls": "zero or one",
      "event_count": "bounded events evaluated",
      "friction_count": "bounded friction episodes evaluated",
      "run_count": "bounded durable child summaries evaluated"
    },
    "errors": {
      "classes": [
        "scenario_unreachable",
        "no_grant",
        "not_run_eligible",
        "inference_spend_exceeded",
        "delegated_run_spend_exceeded",
        "ambiguous_response",
        "invalid_input",
        "input_budget_exhausted",
        "deadline_exceeded",
        "binding_error",
        "classifier_unavailable",
        "classifier_invalid",
        "kernel_runtime"
      ]
    },
    "evidence": "at most 20 stable event, friction, run, decision, and action IDs; never bodies"
  },
  "budget": {
    "wall_ms": 60000,
    "inference_calls": 1,
    "delegated_runs": 0,
    "materialize_limit": 64
  },
