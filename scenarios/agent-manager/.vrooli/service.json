{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "6GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      },
      "api_data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned API data observed in the canonical API data directory.",
        "subpath": "api/data",
        "budget": {
          "max_bytes": "6GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "agent-manager",
    "displayName": "Agent Manager",
    "description": "Central orchestration and governance layer for running AI agents against the codebase in a controlled, reviewable, and extensible way",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api",
      "agent-orchestration",
      "sandbox-first",
      "policy-driven",
      "event-native",
      "task-management",
      "approval-workflow"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/agent-manager"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "runtime": {
    "kind": "long_running",
    "auto_restart_default": false
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "port": 18800,
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "port": 21238,
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 30000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": true
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "claude-code": {
        "type": "claude-code",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for Claude Code agent execution",
        "startup_policy": "try_start"
      },
      "codex": {
        "type": "codex",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for OpenAI Codex agent execution",
        "startup_policy": "try_start"
      },
      "opencode": {
        "type": "opencode",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for open-source code model execution",
        "startup_policy": "try_start"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "Local LLM for recommendation extraction from investigation outputs",
        "model_roles": [
          "code.local"
        ],
        "startup_policy": "try_start"
      }
    },
    "scenarios": {
      "workspace-sandbox": {
        "type": "scenario",
        "enabled": true,
        "required": true,
        "description": "Provides sandbox creation, diff generation, and patch application for isolated agent execution",
        "startup_policy": "must_start"
      },
      "vrooli-events": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Publishes non-blocking observed receipts for declared Agent Manager operations",
        "config": {
          "declarations": [
            ".vrooli/vrooli-events/receipt-capture.json"
          ]
        },
        "startup_policy": "try_start"
      }
    }
  },
  "environment": {
    "AM_SQLITE_PATH": "/home/matthalloran8/.vrooli/data/vrooli/agent-manager/agent-manager.db"
  },
  "cli": {
    "enabled": true,
    "command": "agent-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "agent-manager"
    },
    "freshness": {
      "inputs": [
        "api/**",
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "readiness": {
          "type": "http",
          "path": "/health",
          "timeout_ms": 90000
        },
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "depends_on": [
          {
            "component": "api",
            "wait": "ready"
          }
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
