{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "agent-manager",
    "displayName": "Agent Manager",
    "description": "Central orchestration and governance layer for running AI agents against the codebase in a controlled, reviewable, and extensible way",
    "platform_capabilities": {
      "agent-orchestration": {
        "linux": {
          "status": "build-verified",
          "mechanism": "native-go-agent-manager-api",
          "evidence": "Linux module and handler contract tests; host qualification is not claimed"
        },
        "macos": {
          "status": "unqualified",
          "mechanism": "portable-go-api-with-platform-guarded-host-probes",
          "evidence": "darwin cross-build; no real-host qualification"
        },
        "windows": {
          "status": "unqualified",
          "mechanism": "portable-go-api-with-platform-guarded-host-probes",
          "evidence": "windows cross-build; no real-host qualification"
        }
      }
    },
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api",
      "agent-orchestration",
      "sandbox-first",
      "policy-driven",
      "event-native",
      "task-management",
      "approval-workflow"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/agent-manager"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "port": 18800,
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "port": 21238,
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 30000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": true
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "claude-code": {
        "type": "claude-code",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for Claude Code agent execution",
        "startup_policy": "try_start"
      },
      "codex": {
        "type": "codex",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for OpenAI Codex agent execution",
        "startup_policy": "try_start"
      },
      "opencode": {
        "type": "opencode",
        "enabled": true,
        "required": false,
        "description": "Runner adapter for open-source code model execution",
        "startup_policy": "try_start"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "Local LLM for recommendation extraction from investigation outputs",
        "model_roles": [
          "code.local",
          "embedding.default"
        ],
        "startup_policy": "try_start",
        "degraded_behavior": "Semantic conversation retrieval is unavailable; SQLite FTS and bounded regex search remain operational."
      },
      "antigravity": {
        "type": "declared-resource",
        "enabled": true,
        "required": false,
        "description": "Optional Antigravity agent runner detected and governed by Scenario Dependency Analyzer.",
        "startup_policy": "try_start"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": false,
        "description": "Variant-isolated vector storage for the conversation recall index.",
        "startup_policy": "try_start",
        "degraded_behavior": "Semantic and hybrid vector legs are unavailable; SQLite FTS and bounded regex search remain operational."
      }
    },
    "scenarios": {
      "workspace-sandbox": {
        "type": "scenario",
        "enabled": true,
        "required": true,
        "description": "Provides sandbox creation, diff generation, and patch application for isolated agent execution",
        "startup_policy": "must_start"
      },
      "vrooli-events": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Publishes non-blocking observed receipts for declared Agent Manager operations",
        "config": {
          "declarations": [
            ".vrooli/vrooli-events/receipt-capture.json"
          ]
        },
        "startup_policy": "try_start"
      },
      "program-runtime": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "versionRange": ">=0.0.1",
        "description": "Executes bounded, deterministic-first cohort supervision evaluations",
        "startup_policy": "try_start",
        "degraded_behavior": "Watches preserve their cursors and emit an unavailable observation until Program Runtime recovers."
      },
      "source-ledger": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "versionRange": ">=0.0.1",
        "description": "Receives bounded supervision outcome projections while Agent Manager retains canonical state",
        "startup_policy": "try_start",
        "degraded_behavior": "Canonical outcomes remain durable in Agent Manager and report an explicit projection degradation reason."
      }
    }
  },
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data, including canonical runs/events and logically regenerable conversation-search projection tables, shares this SQLite container. The entry remains non-regenerable because canonical rows must never be reclaimed with the projection.",
        "budget": {
          "max_bytes": "6GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      },
      "api_data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned API data observed in the canonical API data directory.",
        "subpath": "api/data",
        "budget": {
          "max_bytes": "6GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      }
    },
    "rationale": "Canonical state is physically non-regenerable. Conversation-search catalog, FTS, checkpoint, generation, and content-free bounded telemetry tables are logical projections inside that protected SQLite file; they may be rebuilt or reclaimed only through domain-owned operations, and whole-file cleanup remains forbidden. The governed optional Qdrant dependency owns variant-isolated semantic generations under storage.Collection(\"conversation-search\"); failed shadows roll back and successful retired generations remain for reviewed rollback."
  },
  "runtime": {
    "kind": "long_running",
    "auto_restart_default": false
  },
  "generation": {
    "template": {
      "id": "react-vite"
    }
  },
  "environment": {
    "AM_SQLITE_PATH": "/home/matthalloran8/.vrooli/data/vrooli/agent-manager/agent-manager.db"
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/vrooli-events",
        "field": "agent-manager-webhook-secret",
        "label": "Agent Manager program-event webhook secret",
        "description": "Generated shared HMAC credential for receiving signed program-runtime events.",
        "required": false,
        "provisioning": "generated",
        "tiers": [
          "tier-1-local"
        ]
      }
    ]
  },
  "cli": {
    "enabled": true,
    "command": "agent-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "agent-manager"
    },
    "freshness": {
      "inputs": [
        "api/**",
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "readiness": {
          "type": "http",
          "path": "/health",
          "timeout_ms": 90000
        },
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "depends_on": [
          {
            "component": "api",
            "wait": "ready"
          }
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  },
  "skills": {
    "usage": {
      "source": "skills/agent-manager/SKILL.md",
      "programs": [
        "agent-manager.friction-digest",
        "agent-manager.conversation-recall",
        "agent-manager.supervision-evaluate",
        "agent-manager.supervision-case-read",
        "agent-manager.supervision-experiment-read"
      ]
    },
    "improve": {
      "source": "skills/agent-manager-improve/SKILL.md",
      "programs": [
        "agent-manager.setpoint-read",
        "agent-manager.friction-digest"
      ]
    },
    "feature": [
      {
        "source": "skills/investigating-agent-runs/SKILL.md"
      },
      {
        "source": "skills/reviewing-agent-run-efficiency/SKILL.md"
      },
      {
        "source": "skills/agent-manager-plan-family-supervision/SKILL.md",
        "programs": [
          "agent-manager.supervision-evaluate"
        ]
      }
    ],
    "learning": {
      "scope": "agent-manager-usage"
    },
    "contract": [
      {
        "source": "skills/agent-manager-process-investigation/SKILL.md"
      },
      {
        "source": "skills/agent-manager-process-investigation-apply/SKILL.md"
      }
    ]
  }
}
