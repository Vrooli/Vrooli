{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "agent-manager",
  "description": "Generated workflow operator commands. Routine inspection is metadata-only; payload results require explicit authorization.",
  "groups": [
    {
      "name": "workflow",
      "description": "Catalog, simulate, run, inspect, and control durable agent workflows",
      "commands": [
        {
          "name": "validate",
          "description": "Validate and canonicalize one workflow definition without writes",
          "flags": [{"name":"file","required":true,"description":"Workflow definition JSON"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ValidateWorkflow"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["filesystem:read"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "plan",
          "description": "Dry-run all scenario workflow sources without catalog writes",
          "flags": [{"name":"scenario","required":true,"description":"Owning scenario"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"PlanScenarioWorkflows"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        },
        {
          "name": "reconcile-scenario",
          "description": "Atomically reconcile all valid scenario-owned workflow sources",
          "flags": [{"name":"scenario","required":true,"description":"Owning scenario"},{"name":"dry-run","bool":true,"description":"Validate without writes"},{"name":"validate-only","bool":true,"description":"Validate sources only"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ReconcileScenarioWorkflows"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "reload",
          "description": "Reload and atomically activate one scenario's valid workflow source set",
          "flags": [{"name":"scenario","required":true,"description":"Owning scenario"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ReloadScenarioWorkflows"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "list",
          "description": "List immutable workflow revisions for an owner",
          "flags": [{"name":"owner","required":true,"description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"limit","description":"Maximum revisions"},{"name":"offset","description":"Revisions to skip"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ListWorkflowRevisions"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"},
          "measure": {"domain":"workflow","intent":"List durable workflow revisions for one owning scenario.","questions":["show workflow revisions for a scenario","list agent workflow definitions","which workflows does this scenario own"],"result":{"kind":"table","value_field":"revisions","unit":"workflow revisions","summary_template":"{count} workflow revisions"}}
        },
        {
          "name": "get",
          "description": "Get one immutable workflow revision by key or digest",
          "flags": [{"name":"owner","required":true,"description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"digest","description":"Pinned revision digest"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"GetWorkflowRevision"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "explain",
          "description": "Explain a workflow revision and its authored provenance",
          "flags": [{"name":"owner","required":true,"description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"digest","description":"Pinned revision digest"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ExplainWorkflow"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "simulate",
          "description": "Statically plan node identities, strategies, waits, joins, and child workflows without side effects",
          "flags": [{"name":"owner","required":true,"description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"digest","description":"Pinned revision digest"},{"name":"input-file","required":true,"description":"Workflow input JSON"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"SimulateWorkflow"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal","filesystem:read"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "start",
          "description": "Start an idempotent execution pinned to one immutable workflow revision",
          "flags": [{"name":"owner","required":true,"description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"digest","description":"Pinned revision digest"},{"name":"input-file","required":true,"description":"Workflow input JSON"},{"name":"idempotency-key","required":true,"description":"Replay-safe caller key"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"StartWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "execution-list",
          "description": "List bounded metadata-only workflow execution history",
          "flags": [{"name":"owner","description":"Owning scenario"},{"name":"key","description":"Workflow key"},{"name":"status","description":"Execution status"},{"name":"limit","description":"Maximum executions, bounded to 200"},{"name":"offset","description":"Executions to skip"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ListWorkflowExecutions"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "execution-runs",
          "description": "List durable node attempts and dispatched run identities for one workflow execution",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ListWorkflowExecutionRuns"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "execution-get",
          "description": "Inspect one execution with input and output redacted",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"GetWorkflowExecution"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "execution-result",
          "description": "Inspect input and output only after explicit operator authorization",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"explicitly-authorized","bool":true,"required":true,"description":"Confirm authorization to reveal payloads"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"GetWorkflowExecutionResult"},
          "governance": {"effect":"read","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        },
        {
          "name": "execution-advance",
          "description": "Reconcile one execution from its durable state without duplicating dispatched work",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"AdvanceWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "execution-wait",
          "description": "Block until an execution is terminal or the timeout elapses without polling; canceling the wait never cancels the execution",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"timeout-seconds","description":"Server-side wait bound in seconds (0 blocks until terminal)"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"WaitWorkflowExecution"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        },
        {
          "name": "trace",
          "description": "Inspect metadata-only attempt and durable journal history",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"after-sequence","description":"Only events after this sequence"},{"name":"limit","description":"Maximum journal events"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"GetWorkflowExecutionTrace"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"}
        },
        {
          "name": "signal",
          "description": "Deliver one typed, idempotent signal to the exact durable wait",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"signal","required":true,"description":"Expected signal name"},{"name":"payload-file","required":true,"description":"Typed JSON payload"},{"name":"idempotency-key","required":true,"description":"Replay-safe caller key"},{"name":"expected-version","description":"Optimistic concurrency version"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"SignalWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal","filesystem:read"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "cancel",
          "description": "Idempotently cancel an execution and propagate cancellation to active runs and children",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"idempotency-key","required":true,"description":"Replay-safe caller key"},{"name":"expected-version","description":"Optimistic concurrency version"},{"name":"reason","description":"Operator reason"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"CancelWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "retry",
          "description": "Retry the failed node using its durable attempt lineage and retry budget",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"idempotency-key","required":true,"description":"Replay-safe caller key"},{"name":"expected-version","description":"Optimistic concurrency version"},{"name":"reason","description":"Operator reason"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"RetryWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "resume",
          "description": "Resume a recoverable execution without creating duplicate node work",
          "positionals": [{"name":"execution_id","required":true,"description":"Workflow execution UUID"}],
          "flags": [{"name":"idempotency-key","required":true,"description":"Replay-safe caller key"},{"name":"expected-version","description":"Optimistic concurrency version"},{"name":"reason","description":"Operator reason"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ResumeWorkflowExecution"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
		}
      ]
    },
    {
      "name": "runtime-root",
      "description": "Top-level local command dispatchers",
      "flat": true,
      "commands": [
        {"name":"declarations","description":"Scenario declaration operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"events","description":"Typed operational event queries","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"findings","description":"Recurring investigation findings","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"health","description":"Health audit queries","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"maintenance","description":"Maintenance operations","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"ops","description":"Operational statistics","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"permission-policy","description":"Permission policy operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"profile","description":"Agent profile operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"role-policy","description":"Role policy operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"runner","description":"Runner operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"scenario-smoke","description":"Live scenario smoke validation","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"settings","description":"Settings operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"task","description":"Task operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"workflow","description":"Workflow operations","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}}
      ]
    },
    {
      "name": "declarations",
      "description": "Reconcile a scenario's unified profile + workflow declarations",
      "commands": [
        {
          "name": "reconcile-scenario",
          "description": "Reconcile a scenario's unified declaration block (profiles + workflows)",
          "flags": [{"name":"scenario","required":true,"description":"Owning scenario"},{"name":"dry-run","bool":true,"description":"Validate without writes"},{"name":"validate-only","bool":true,"description":"Validate sources only"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ReconcileScenarioDeclarations"},
          "governance": {"effect":"write","run_eligible":false,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_mutation"}
        },
        {
          "name": "plan",
          "description": "Dry-run all scenario declaration sources without writes",
          "flags": [{"name":"scenario","required":true,"description":"Owning scenario"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"PlanScenarioDeclarations"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"operational"}
        }
      ]
    },
    {
      "name": "profile",
      "description": "Agent profile inspection operations",
      "commands": [
        {
          "name": "list",
          "description": "List agent profiles with a bounded total count",
          "flags": [{"name":"limit","description":"Maximum profiles (1-100)"},{"name":"offset","description":"Profiles to skip"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ListProfiles"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"},
          "measure": {"domain":"profile","intent":"List agent profiles and their total count.","questions":["how many agent profiles exist","show agent profiles","list available agent profiles"],"result":{"kind":"table","value_field":"profiles","unit":"profiles","summary_template":"{total} agent profiles"}}
        }
      ]
    },
    {
      "name": "task",
      "description": "Task inspection operations",
      "commands": [
        {
          "name": "list",
          "description": "List tasks with optional status filtering and a bounded total count",
          "flags": [{"name":"status","description":"Task status filter"},{"name":"limit","description":"Maximum tasks (1-100)"},{"name":"offset","description":"Tasks to skip"}],
          "binding": {"kind":"connect-rpc","service":"AgentManagerService","method":"ListTasks"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"proto_list"},
          "measure": {"domain":"task","intent":"List durable agent tasks and their total count.","questions":["how many agent tasks exist","show agent tasks","list pending agent tasks"],"result":{"kind":"table","value_field":"tasks","unit":"tasks","summary_template":"{total} agent tasks"}}
        }
      ]
