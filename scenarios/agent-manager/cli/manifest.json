        {"name":"delete","description":"Delete a run","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"diff","description":"Inspect sandbox diff","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"get","description":"Get a run","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"get-by-tag","description":"Get a run by tag","binding":{"kind":"local"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]}},
        {"name":"investigate","description":"Create an investigation","binding":{"kind":"local"},"governance":{"effect":"write","run_eligible":false,"permissions":["network:internal"]}},
        {"name":"list","description":"List runs with bounded filters and a total count","flags":[{"name":"status","description":"Run status filter"},{"name":"task-id","description":"Task UUID filter"},{"name":"profile-id","description":"Profile UUID filter"},{"name":"tag-prefix","description":"Tag prefix filter"},{"name":"limit","description":"Maximum runs (1-100)"},{"name":"offset","description":"Runs to skip"}],"binding":{"kind":"connect-rpc","service":"AgentManagerService","method":"ListRuns"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"},"measure":{"domain":"run","intent":"List agent runs and their total count, optionally filtered by execution status or ownership.","questions":["how many agent runs exist","show failed agent runs","list agent runs for a profile"],"result":{"kind":"table","value_field":"runs","unit":"runs","summary_template":"{total} agent runs"}}},
