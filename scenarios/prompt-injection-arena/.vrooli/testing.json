{
  "$schema": "../../test-genie/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for prompt-injection-arena",
    "last_updated": "2025-11-06T23:58:54-05:00"
  },
  "version": "1.0.0",
  "unit": {
    "options": {
      "verbose": true
    },
    "policy_profile": {
      "version": "2.0.0",
      "template": {
        "id": "go-service-cli",
        "scenario_class": "go-service-cli"
      },
      "required_roles": [
        {
          "role": "api",
          "policy_class": "go_service",
          "match": {
            "surface_id": "api",
            "kind": "api",
            "path": "api",
            "language": "go"
          }
        },
        {
          "role": "cli",
          "policy_class": "go_cli",
          "match": {
            "surface_id": "cli",
            "kind": "cli",
            "path": "cli",
            "language": "go"
          }
        }
      ],
      "policy_classes": {
        "go_service": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "api/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        },
        "go_cli": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "cli/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        }
      },
      "customization": {
        "mode": "monotonic",
        "waivers": [
          {
            "finding": "UNIT_SURFACE_UNGOVERNED",
            "reason": "The scenario UI is a legacy Node static server, not a React/Vite test surface. Unit Health has no Node-static adapter; keep the surface visible while API/CLI unit policy remains enforced.",
            "owner": "prompt-injection-arena maintainers",
            "expires_at": "2026-12-31",
            "evidence": "unit-health validate prompt-injection-arena 2026-09-08: ui language=node framework=node; no supported Node-static unit adapter",
            "revisit": "Add a supported Node UI adapter or migrate the UI to a governed framework before expiry."
          }
        ]
      },
      "runner_profiles": {
        "default": {
          "cpu_weight": 1,
          "memory_bytes": 536870912,
          "max_workers": 1,
          "timeout_seconds": 600,
          "no_output_timeout_seconds": 60,
          "sharding": "none",
          "network": "allow",
          "filesystem": "workspace"
        }
      }
    }
  },
  "phases": {
    "tidiness": {
      "budgets": {
        "ratchet": true,
        "duplication_line_debt": 426,
        "baseline_duplication_line_debt": 427,
        "long_files": 1,
        "baseline_long_files": 2,
        "complexity_over_threshold": 19,
        "baseline_complexity_over_threshold": 20,
        "reserve": 1,
        "reserve_reason": "Measured fleet seed reserves one observed unit while successor cleanup earns each stricter budget."
      }
    }
  }
}
