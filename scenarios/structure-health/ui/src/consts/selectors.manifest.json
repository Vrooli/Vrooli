  "dynamicSelectors": {
    "fleet.profileRow": {
      "description": "Fleet profile row by profile id",
      "selectorPattern": "[data-testid=\"fleet-profile-row-${profileId}\"]",
      "testIdPattern": "fleet-profile-row-${profileId}",
      "params": [
        {
          "name": "profileId",
          "type": "string"
        }
      ]
    },
    "fleet.ruleRow": {
      "description": "Fleet rule row by rule id",
      "selectorPattern": "[data-testid=\"fleet-rule-row-${code}\"]",
      "testIdPattern": "fleet-rule-row-${code}",
      "params": [
        {
          "name": "code",
          "type": "string"
        }
      ]
    },
    "fleet.scenarioRow": {
      "description": "Fleet scenario row by scenario id",
      "selectorPattern": "[data-testid=\"fleet-scenario-row-${scenario}\"]",
      "testIdPattern": "fleet-scenario-row-${scenario}",
      "params": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    "fleet.targetRow": {
      "description": "Fleet target row by target id",
      "selectorPattern": "[data-testid=\"fleet-target-row-${kind}-${id}\"]",
      "testIdPattern": "fleet-target-row-${kind}-${id}",
      "params": [
        {
          "name": "kind",
          "type": "string"
        },
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.navLink": {
      "description": "App shell navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]",
      "testIdPattern": "layout-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "fleet",
            "validate",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    }
  },
