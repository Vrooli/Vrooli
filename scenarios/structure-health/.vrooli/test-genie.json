	        {
	          "id": "L3",
	          "name": "Target structure clean",
	          "status_label": "Complete",
	          "description": "The target emits no required structural findings.",
	          "capability_summary": "Cross-kind structural conformance is clean.",
          "next_unlock": "Maximum cross-kind structure maturity."
	        }
	      ]
