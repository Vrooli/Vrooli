{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {},
    "rationale": "No scenario-owned persistent directory was found in the canonical repository storage paths; the scenario uses external storage, generated test paths, or ephemeral runtime state."
  },
  "service": {
    "name": "graph-studio",
    "displayName": "Graph Studio",
    "description": "Unified platform for creating, validating, and converting all forms of graph-based visualizations and data structures",
    "version": "1.0.0",
    "tags": [
      "graphs",
      "diagrams",
      "mind-maps",
      "bpmn",
      "uml",
      "visualization",
      "knowledge-graphs",
      "workflow",
      "architecture",
      "plugin-system",
      "format-conversion",
      "go-api",
      "react-ui",
      "postgres-storage"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/graph-studio"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Graph Studio API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Graph Studio UI port",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Graph Studio health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 3000,
          "interval": 45000
        },
        {
          "name": "postgres_connection",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 60000
        }
      ],
      "timeout": 10000,
      "interval": 30000,
      "startup_grace_period": 15000
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "enabled": true,
        "required": true,
        "purpose": "Store graph metadata, relationships, and versioning",
        "database": "graph_studio"
      },
      "minio": {
        "enabled": true,
        "required": true,
        "purpose": "Store large graph files and visualization assets",
        "buckets": {
          "default_buckets": [
            "graph-files",
            "graph-renders",
            "graph-exports"
          ]
        }
      },
      "redis": {
        "enabled": false,
        "required": false,
        "purpose": "Cache frequently accessed graphs and session state",
        "fallback": "No caching, direct database queries"
      },
      "ollama": {
        "enabled": false,
        "required": false,
        "purpose": "AI-powered graph suggestions and natural language queries",
        "fallback": "Disable AI features"
      },
      "qdrant": {
        "enabled": false,
        "required": false,
        "purpose": "Vector search for semantic graph similarity",
        "fallback": "Keyword-based search only"
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "graph-studio",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "graph-studio"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "env": {
          "VROOLI_LIFECYCLE": "active",
          "LOG_LEVEL": "info",
          "CORS_ORIGINS": "http://localhost:${UI_PORT},http://127.0.0.1:${UI_PORT}",
          "MAX_GRAPH_SIZE": "10000",
          "PLUGIN_DIR": "./plugins"
        },
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "-e",
          "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{const n=p.join(process.cwd(),q.url==='/'?'index.html':q.url);f.readFile(n,(e,d)=>{if(!e){r.end(d);return}f.readFile('index.html',(fallback,html)=>{r.statusCode=fallback?404:200;r.end(fallback?'not found':html)})})}).listen(Number(process.env.UI_PORT),'0.0.0.0')"
        ],
        "cwd": "ui/dist",
        "env": {
          "VITE_APP_NAME": "Graph Studio"
        },
        "port": "ui"
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator that no Go code in this scenario currently opens. The declaration records intended caching, not a runtime requirement."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
