    { "id": "wait-operating-mode", "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "@selector/wizard.operatingMode", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 20000 }, "metadata": { "label": "Operating mode renders" } } },
