    { "id": "assert-welcome", "action": { "type": "ACTION_TYPE_ASSERT", "assert": { "selector": "@selector/wizard.next", "mode": "ASSERTION_MODE_VISIBLE", "timeout_ms": 10000, "failure_message": "Welcome must expose the Get Started action" }, "metadata": { "label": "Get Started is visible" } } },
