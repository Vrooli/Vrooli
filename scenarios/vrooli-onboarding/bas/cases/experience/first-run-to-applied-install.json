    { "id": "assert-scenario-search", "action": { "type": "ACTION_TYPE_ASSERT", "assert": { "selector": "@selector/wizard.scenarioSearch", "mode": "ASSERTION_MODE_VISIBLE", "timeout_ms": 10000, "failure_message": "Scenario search must be visible" }, "metadata": { "label": "Scenario search is visible" } } },
