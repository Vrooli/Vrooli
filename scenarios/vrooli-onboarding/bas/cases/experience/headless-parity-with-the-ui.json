  "edges": [{ "source": "open-scenarios", "target": "wait-scenarios" }, { "source": "wait-scenarios", "target": "assert-search" }, { "source": "assert-search", "target": "assert-rollup" }, { "source": "assert-rollup", "target": "open-validation" }, { "source": "open-validation", "target": "wait-validation" }, { "source": "wait-validation", "target": "assert-summary" }]
