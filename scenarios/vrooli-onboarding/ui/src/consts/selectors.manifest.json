  "dynamicSelectors": {
    "wizard.stepIndicator": {
      "description": "Step indicator circle by index",
      "selectorPattern": "[data-testid=\"step-indicator-${index}\"]",
      "testIdPattern": "step-indicator-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    },
    "wizard.scenarioCard": {
      "description": "Scenario card by scenario name",
      "selectorPattern": "[data-testid=\"scenario-card-${name}\"]",
      "testIdPattern": "scenario-card-${name}",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    "wizard.resourceCard": {
      "description": "Resource card by name",
      "selectorPattern": "[data-testid=\"resource-card-${name}\"]",
      "testIdPattern": "resource-card-${name}",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ]
    },
    "wizard.categoryToggle": {
      "description": "Select All / Deselect All toggle per category",
      "selectorPattern": "[data-testid=\"category-toggle-${category}\"]",
