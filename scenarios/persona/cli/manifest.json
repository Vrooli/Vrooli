            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "site",
              "required": true
            },
            {
              "name": "login-seam",
              "required": true
            },
            {
              "name": "recovery-path",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccountsService",
            "method": "LinkAccount"
