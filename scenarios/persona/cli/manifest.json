{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "persona",
  "description": "Typed operator and agent commands for persona identity, controlled channels, human handoffs, document custody and account linkage.",
  "groups": [
    {
      "name": "personas",
      "description": "Create and inspect durable legal-person records.",
      "commands": [
        {
          "name": "create",
          "description": "Create a persona with an immutable legal basis.",
          "flags": [
            {
              "name": "kind",
              "required": true,
              "description": "PERSONA_KIND_PERSONAL or PERSONA_KIND_BUSINESS.",
              "values": [
                "PERSONA_KIND_PERSONAL",
                "PERSONA_KIND_BUSINESS"
              ]
            },
            {
              "name": "legal-basis",
              "required": true,
              "description": "Inline JSON LegalBasis message.",
              "bind": {
                "field": "legal_basis",
                "kind": "json_inline"
              }
            },
            {
              "name": "display-name",
              "description": "Operator-facing display name."
            },
            {
              "name": "identifiers",
              "description": "Inline JSON array of Identifier messages.",
              "bind": {
                "field": "identifiers",
                "kind": "json_inline"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PersonasService",
            "method": "CreatePersona"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Read one persona without exposing credentials or document bytes.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PersonasService",
            "method": "GetPersona"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "list",
          "description": "List active personas, optionally including archived records.",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum records."
            },
            {
              "name": "include-archived",
              "bool": true,
              "description": "Include archived personas."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PersonasService",
            "method": "ListPersonas"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "archive",
          "description": "Archive a persona; records are never deleted.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PersonasService",
            "method": "ArchivePersona"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "health",
          "description": "Check persona dependencies and staleness findings.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PersonasService",
            "method": "CheckHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "access",
      "description": "Verify act-as authority, manage grants, resolve entitled metadata and issue attestations.",
      "commands": [
        {
          "name": "act-as",
          "description": "Act as a named persona through live agent-manager verification.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "action",
              "required": true,
              "description": "Named action being authorised."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "ActAs"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "resolve",
          "description": "Resolve only the persona fields entitled to the caller.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "field",
              "repeatable": true,
              "description": "Entitled field name; repeat as needed.",
              "bind": {
                "field": "fields"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "ResolvePersona"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "grant",
          "description": "Grant a named human act or propose authority.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "human-subject",
              "required": true
            },
            {
              "name": "level",
              "required": true,
              "values": [
                "GRANT_LEVEL_ACT",
                "GRANT_LEVEL_PROPOSE"
              ]
            },
            {
              "name": "source"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "CreateGrant"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list-grants",
          "description": "List the local ACL for one persona.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "ListGrants"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "remove-grant",
          "description": "Remove one persona grant.",
          "positionals": [
            {
              "name": "grant-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "RemoveGrant"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "attest",
          "description": "Issue a signed, bounded identity attestation.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "audience",
              "required": true
            },
            {
              "name": "expires-at-unix",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccessService",
            "method": "IssueAttestation"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "channels",
      "description": "Bind one controlled address per persona and retrieve one-time codes through the typed adapter seam.",
      "commands": [
        {
          "name": "bind",
          "description": "Bind a controlled email, SMS or device route without storing its secret.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "kind",
              "required": true,
              "values": [
                "CHANNEL_KIND_EMAIL",
                "CHANNEL_KIND_SMS",
                "CHANNEL_KIND_DEVICE"
              ]
            },
            {
              "name": "address",
              "required": true
            },
            {
              "name": "credential-ref"
            },
            {
              "name": "adapter"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChannelsService",
            "method": "BindChannel"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "List a persona's controlled channels.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChannelsService",
            "method": "ListChannels"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "send",
          "description": "Send from the persona's controlled address through the named adapter.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "channel-id",
              "required": true
            },
            {
              "name": "recipient",
              "required": true
            },
            {
              "name": "subject"
            },
            {
              "name": "body",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChannelsService",
            "method": "SendMessage"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "retrieve-code",
          "description": "Retrieve a one-time code only through the channel's named adapter.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "channel-id",
              "required": true
            },
            {
              "name": "purpose",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChannelsService",
            "method": "RetrieveCode"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "handoffs",
      "description": "Open, complete and resume human-only work from durable checkpoints.",
      "commands": [
        {
          "name": "open",
          "description": "Open a human handoff with a checkpoint of completed work.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "kind",
              "required": true
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "human-action",
              "required": true
            },
            {
              "name": "checkpoint",
              "required": true,
              "description": "Inline JSON Checkpoint message.",
              "bind": {
                "field": "checkpoint",
                "kind": "json_inline"
              }
            },
            {
              "name": "deadline",
              "description": "RFC3339 deadline."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "OpenHandoff"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Read one handoff and its current state.",
          "positionals": [
            {
              "name": "handoff-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "GetHandoff"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "list",
          "description": "List pending or completed handoffs for a persona.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "limit"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "ListHandoffs"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "complete",
          "description": "Record the irreducible human step as completed.",
          "flags": [
            {
              "name": "handoff-id",
              "required": true
            },
            {
              "name": "completed-by",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "CompleteHandoff"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "cancel",
          "description": "Cancel a handoff without silently dropping it.",
          "flags": [
            {
              "name": "handoff-id",
              "required": true
            },
            {
              "name": "cancelled-by",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "CancelHandoff"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "resume",
          "description": "Resume a completed handoff from its durable checkpoint.",
          "flags": [
            {
              "name": "handoff-id",
              "required": true
            },
            {
              "name": "run-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "ResumeHandoff"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "prepare-enrolment",
          "description": "Turn a blocked enrolment into an explicit human-only handoff.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "target",
              "required": true
            },
            {
              "name": "required-field",
              "repeatable": true,
              "required": true,
              "bind": {
                "field": "required_fields"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HandoffsService",
            "method": "PrepareEnrolment"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "documents",
      "description": "Bind document-manager records and release them only into named handoffs.",
      "commands": [
        {
          "name": "bind",
          "description": "Bind a document-manager record without copying content.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "document-id",
              "required": true
            },
            {
              "name": "document-kind",
              "required": true
            },
            {
              "name": "valid-until"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DocumentsService",
            "method": "BindDocument"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "List document bindings; content is never returned.",
          "positionals": [
            {
              "name": "persona-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DocumentsService",
            "method": "ListBindings"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "release",
          "description": "Release one bound document into its pre-declared handoff.",
          "flags": [
            {
              "name": "persona-id",
              "required": true
            },
            {
              "name": "document-id",
              "required": true
            },
            {
              "name": "handoff-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DocumentsService",
            "method": "ReleaseIntoHandoff"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ],
            "requires_confirmation": true
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
