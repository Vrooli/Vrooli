            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AccountsService",
            "method": "ListObligations"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
