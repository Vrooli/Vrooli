{
  "metadata": {
    "name": "experience-evidence-page",
    "description": "Dogfood experience page smoke: opens Evidence and asserts the verdict list binding renders.",
    "requirement": "OT-P0-005",
    "version": "1",
    "labels": {
      "reset": "none",
      "surface": "experience-evidence",
      "spec_entry_id": "evidence"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-evidence",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "experience-manager",
          "scenario_path": "/scenarios/experience-manager/pages/fleet/evidence",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Evidence" }
      }
    },
    {
      "id": "wait-verdicts",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/experience.evidence.verdictList",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Verdict list visible" }
      }
    }
  ]
}
