{
  "metadata": {
    "name": "experience-findings-page",
    "description": "Dogfood experience page smoke: opens Findings and asserts the findings list binding renders.",
    "requirement": "OT-P0-005",
    "version": "1",
    "labels": {
      "reset": "none",
      "surface": "experience-findings"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-findings",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "experience-manager",
          "scenario_path": "/findings",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Findings" }
      }
    },
    {
      "id": "wait-findings-list",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/experience.findings.findingsList",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Findings list visible" }
      }
    }
  ]
}
