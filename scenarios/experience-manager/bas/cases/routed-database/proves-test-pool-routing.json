{
  "metadata": {
    "name": "experience-manager-shell-smoke",
    "description": "Observer smoke workflow for the Experience Manager operator UI. It opens the live scenario, waits for the app shell, and asserts the application title so Test Genie's workflow phase has an executable self-check without relying on removed notes-template selectors.",
    "requirement": "REQ-EXPERIENCE-MANAGER-SMOKE",
    "version": "1",
    "labels": {
      "reset": "none",
      "purpose": "operator-ui-smoke",
      "requires_confirmation": "true",
      "routed_isolation": "true"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-shell",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "experience-manager",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Navigate to Experience Manager" }
      }
    },
    {
      "id": "wait-shell",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/layout.shell",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "App shell visible" }
      }
    },
    {
      "id": "assert-title",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/app.title",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": { "stringValue": "Experience Manager" },
          "case_sensitive": true,
          "timeout_ms": 10000,
          "failure_message": "Experience Manager title did not render on the operator shell."
        },
        "metadata": { "label": "Assert operator title renders" }
      }
    }
  ]
}
