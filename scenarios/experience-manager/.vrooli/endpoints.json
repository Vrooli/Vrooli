{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.experience_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.experience_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "studio_start_authoring_session",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/StartAuthoringSession",
      "method": "POST",
      "summary": "Start an experience spec authoring session",
      "description": "Creates a persisted authoring session for form-shaped experience/ edits.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "session": "AuthoringSession"
        }
      }
    },
    {
      "id": "studio_submit_page",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/SubmitPage",
      "method": "POST",
      "summary": "Submit a page form into an authoring session",
      "description": "Stores a typed PageForm draft for preview/apply.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "page": "PageForm",
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "page": "PageDraft",
          "session": "AuthoringSession"
        }
      }
    },
    {
      "id": "studio_preview_session",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/PreviewSession",
      "method": "POST",
      "summary": "Preview authoring session diffs",
      "description": "Computes file diffs and parser validation for the session without touching the target tree.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "diffs": "array<FileDiff>",
          "validation": "ValidateScenarioResponse"
        }
      }
    },
    {
      "id": "studio_apply_session",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/ApplySession",
      "method": "POST",
      "summary": "Apply an authoring session",
      "description": "Writes previewed experience/ files only after the parser reports zero error findings.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "diffs": "array<FileDiff>",
          "validation": "ValidateScenarioResponse"
        }
      }
    },
    {
      "id": "studio_discard_session",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/DiscardSession",
      "method": "POST",
      "summary": "Discard an authoring session",
      "description": "Deletes the persisted authoring session and its page drafts.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "discarded": "boolean"
        }
      }
    },
    {
      "id": "studio_list_spec",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/ListSpec",
      "method": "POST",
      "summary": "List experience spec documents",
      "description": "Lists pages and journeys from a scenario's parsed experience index.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "journeys": "array<SpecDocument>",
          "pages": "array<SpecDocument>"
        }
      }
    },
    {
      "id": "studio_show_spec",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/ShowSpec",
      "method": "POST",
      "summary": "Show a page spec",
      "description": "Returns one page document as JSON.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "page": "string",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "json": "string"
        }
      }
    },
    {
      "id": "studio_suggest_bindings",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/SuggestBindings",
      "method": "POST",
      "summary": "Suggest page bindings",
      "description": "Suggests testid/role bindings from existing spec bindings and latest reconciliation evidence.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int",
          "page": "string",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "suggestions": "array<BindingSuggestion>"
        }
      }
    },
    {
      "id": "studio_render_spec",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/RenderSpec",
      "method": "POST",
      "summary": "Render a deterministic page wireframe",
      "description": "Renders one page spec to stable HTML for workshop review. Image mode degrades to wireframe-only when image-tools is unavailable.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "mode": "string",
          "page": "string",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "artifact_path": "string",
          "degraded_reason": "string",
          "html": "string"
        }
      }
    },
    {
      "id": "studio_compare_variants",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/CompareVariants",
      "method": "POST",
      "summary": "Compare rendered page variants",
      "description": "Renders supplied page-form variants side by side as deterministic workshop HTML.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "mode": "string",
          "page": "string",
          "path": "string",
          "scenario": "string",
          "variants": "array<SpecVariant>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "artifact_path": "string",
          "html": "string",
          "variants": "array<RenderedVariant>"
        }
      }
    },
    {
      "id": "studio_promote_variant",
      "path": "/vrooli.experience_manager.v1.contract.StudioSessionService/PromoteVariant",
      "method": "POST",
      "summary": "Promote a page variant into the spec",
      "description": "Writes the selected variant through parser-clean apply semantics and returns diffs plus validation.",
      "category": "studio",
      "request": {
        "type": "object",
        "properties": {
          "page": "string",
          "path": "string",
          "scenario": "string",
          "variant": "SpecVariant"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "diffs": "array<FileDiff>",
          "validation": "ValidateScenarioResponse",
          "variant": "RenderedVariant"
        }
      }
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's experience contract (shared mount)",
      "description": "Parser-backed Test Genie ScenarioValidationService mount for scenario-experience-spec/v1 contracts.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional resolved path)",
          "scenario": "string (required, scenario slug)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "native_detail": "google.protobuf.Any (experience_manager.v1.contract.ExperienceContractReport)",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario path or experience contract cannot be parsed."
        }
      ]
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview deterministic experience-contract fixes",
      "description": "Phase 1 mount for deterministic fix previews. Returns Unimplemented until fixers land.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "rule_ids": "array<string> (optional filter)",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "boolean",
          "candidates": "array<FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Autofix lands in a later phase"
        }
      ]
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply deterministic experience-contract fixes",
      "description": "Phase 1 mount for deterministic fixes. Returns Unimplemented until fixers land.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "rule_ids": "array<string> (optional filter)",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "boolean",
          "candidates": "array<FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Autofix lands in a later phase"
        }
      ]
    },
    {
      "id": "contract_validate_scenario",
      "path": "/vrooli.experience_manager.v1.contract.ContractService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's experience contract (native detail)",
      "description": "Native experience contract validation for scenario-experience-spec/v1 contracts.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional resolved path)",
          "scenario": "string (required, scenario slug)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "report": "ExperienceContractReport",
          "scenario": "string",
          "status": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario path or experience contract cannot be parsed."
        }
      ]
    }
  ]
}
