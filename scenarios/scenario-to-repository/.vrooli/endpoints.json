{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.scenario_to_repository.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.scenario_to_repository.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
      "id": "source_analyze_closure",
      "path": "/vrooli.scenario_to_repository.v1.source.SourceRepositoryService/AnalyzeClosure",
      "method": "POST",
      "summary": "Analyze source closure",
      "description": "Resolves admitted scenario source and explicit runtime obligations without reading Git history.",
      "category": "source",
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid source root or closure"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Closure analysis failed"
        }
      ]
    },
    {
      "id": "source_assemble_export",
      "path": "/vrooli.scenario_to_repository.v1.source.SourceRepositoryService/AssembleExport",
      "method": "POST",
      "summary": "Assemble deterministic export",
      "description": "Builds a deterministic tar.gz source artifact after policy and closure checks.",
      "category": "source",
      "errors": [
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Policy or closure refused export"
        }
      ]
    },
    {
      "id": "source_verify_export",
      "path": "/vrooli.scenario_to_repository.v1.source.SourceRepositoryService/VerifyExport",
      "method": "POST",
      "summary": "Verify exact artifact",
      "description": "Checks the recorded archive digest and returns an attributable verification receipt.",
      "category": "source"
    },
    {
      "id": "source_prepare_publication",
      "path": "/vrooli.scenario_to_repository.v1.source.SourceRepositoryService/PreparePublication",
      "method": "POST",
      "summary": "Prepare human publication",
      "description": "Creates a bounded publication handoff and never writes a remote repository.",
      "category": "source",
      "errors": [
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Automated publication is prohibited"
        }
      ]
    },
    {
      "id": "source_get_distribution",
      "path": "/vrooli.scenario_to_repository.v1.source.SourceRepositoryService/GetDistribution",
      "method": "POST",
      "summary": "Get distribution",
      "description": "Reads durable distribution identity and its independent verification/publication standing.",
      "category": "source"
    }
  ]
}
