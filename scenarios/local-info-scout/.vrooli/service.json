{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "local-info-scout",
    "displayName": "Local Info Scout",
    "description": "Local information scout service with Go API",
    "version": "1.0.0",
    "tags": [
      "go-api"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/local-info-scout"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Local Info Scout API port",
      "range": "15000-19999",
      "port": 15050
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Local Info Scout health check configuration",
      "endpoints": {
        "api": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    },
    "setup": {
      "description": "Initialize Local Info Scout",
      "steps": [
        {
          "name": "generate-embeddings",
          "exec": [
            "vrooli",
            "resource",
            "qdrant",
            "embeddings",
            "refresh",
            "--force"
          ],
          "on_error": "continue",
          "description": "Generate code embeddings for AI assistance"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "redis": {
        "type": "redis",
        "enabled": true,
        "required": false,
        "purpose": "Optional response cache for outbound place and weather lookups. The scenario falls back to live lookups when Redis is absent."
      },
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": false
      },
      "searxng": {
        "type": "searxng",
        "enabled": false,
        "required": false
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (heuristic)"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (heuristic)",
        "model_roles": [
          "chat.small"
        ]
      }
    },
    "scenarios": {}
  },
  "cli": {
    "enabled": true,
    "command": "local-info-scout",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "local-info-scout"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator. The scenario opens a client when Redis is reachable and serves a working no-Redis path when it is not."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
