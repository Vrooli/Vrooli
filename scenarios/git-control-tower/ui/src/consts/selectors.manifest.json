  "dynamicSelectors": {
    "fileList.section": {
      "description": "File section by category (staged, unstaged, untracked, conflicts)",
      "selectorPattern": "[data-testid=\"file-section-${category}\"]",
      "testIdPattern": "file-section-${category}",
      "params": [
        {
          "name": "category",
          "type": "enum",
          "values": [
            "staged",
            "unstaged",
            "untracked",
            "conflicts"
          ]
        }
      ]
    },
    "fileList.sectionToggle": {
      "description": "File section toggle button",
      "selectorPattern": "[data-testid=\"file-section-toggle-${category}\"]",
      "testIdPattern": "file-section-toggle-${category}",
      "params": [
        {
          "name": "category",
          "type": "enum",
          "values": [
            "staged",
            "unstaged",
            "untracked",
            "conflicts"
          ]
        }
      ]
    },
    "fileList.fileItem": {
      "description": "File item by category",
      "selectorPattern": "[data-testid=\"file-item-${category}\"]",
      "testIdPattern": "file-item-${category}",
      "params": [
        {
          "name": "category",
          "type": "enum",
          "values": [
            "staged",
            "unstaged",
            "untracked",
            "conflicts"
          ]
        }
      ]
    },
    "fileList.fileAction": {
      "description": "File action button (stage/unstage)",
      "selectorPattern": "[data-testid=\"file-action-${category}\"]",
      "testIdPattern": "file-action-${category}",
      "params": [
        {
          "name": "category",
          "type": "enum",
          "values": [
            "staged",
            "unstaged",
            "untracked",
            "conflicts"
          ]
        }
      ]
    },
    "fileList.fileByPath": {
      "description": "File item by path",
      "selectorPattern": "[data-file-path=\"${path}\"]",
      "params": [
        {
          "name": "path",
          "type": "string"
        }
      ]
    },
    "diffViewer.hunk": {
      "description": "Diff hunk by index",
      "selectorPattern": "[data-testid=\"diff-hunk-${index}\"]",
      "testIdPattern": "diff-hunk-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    },
    "diffViewer.line": {
      "description": "Diff line",
      "selectorPattern": "[data-testid=\"diff-line\"]",
      "testIdPattern": "diff-line",
      "params": []
