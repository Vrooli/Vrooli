{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "dependencies": {
    "resources": {},
    "scenarios": {
      "workspace-sandbox": {
        "description": "Approved changes tracking and commit preview",
        "required": false
      },
      "browser-automation-studio": {
        "description": "Visual capture and screenshot comparison for scenario UIs",
        "required": false
      },
      "test-genie": {
        "description": "Automated test execution and reporting for scenarios",
        "required": false
      },
      "tidiness-manager": {
        "description": "Code quality analysis and tidiness scoring for scenarios",
        "required": false
      },
      "agent-manager": {
        "description": "AI agent orchestration and run management through Git Control Tower's declared role-only profile",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/reviewer.json"
            ]
          }
        },
        "required": false
      }
    }
  },
  "lifecycle": {
    "health": {
      "checks": [
        {
          "critical": true,
          "interval": 30000,
          "name": "api_endpoint",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 5000,
          "type": "http"
        },
        {
          "critical": false,
          "interval": 30000,
          "name": "ui_endpoint",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "type": "http"
        }
      ],
      "description": "Git Control Tower health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 10000
    },
    "version": "2.0.0"
  },
  "ports": {
    "api": {
      "description": "Git Control Tower API port",
      "env_var": "API_PORT",
      "port": 18710,
      "range": "15000-19999"
    },
    "ui": {
      "description": "Git Control Tower UI port",
      "env_var": "UI_PORT",
      "port": 21400,
      "range": "20000-24999"
    }
  },
  "cli": {
    "enabled": true,
    "command": "git-control-tower",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "git-control-tower"
    },
    "freshness": {
      "inputs": [
        "api/**",
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "service": {
    "category": "general",
    "description": "Agent-friendly git repository control plane (REST API + CLI + UI)",
    "displayName": "Git Control Tower",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "license": "MIT",
    "maintainers": [
      {
        "email": "support@vrooli.com",
        "name": "Vrooli Team",
        "url": "https://github.com/Vrooli"
      }
    ],
    "name": "git-control-tower",
    "parent": "vrooli",
    "repository": {
      "directory": "/scenarios/git-control-tower",
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli"
    },
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "tags": [
      "git",
      "version-control",
      "devtools",
      "automation"
    ],
    "type": "scenario",
    "version": "1.3.0"
  },
  "version": "2.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
