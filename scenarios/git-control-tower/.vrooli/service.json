{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "dependencies": {
    "resources": {
      "ollama": {
        "description": "AI-assisted commit message suggestions",
        "enabled": false,
        "required": false,
        "type": "ollama"
      },
      "redis": {
        "description": "Optional caching for diff/status operations",
        "enabled": false,
        "required": false,
        "type": "redis"
      },
      "resource-openrouter": {
        "description": "AI fallback for commit message suggestions",
        "enabled": false,
        "required": false,
        "type": "resource-openrouter"
      },
      "sqlite": {
        "description": "Audit log and metadata storage (local SQLite database)",
        "enabled": true,
        "required": true,
        "type": "sqlite"
      }
    }
  },
  "lifecycle": {
    "develop": {
      "description": "Start Git Control Tower services for development",
      "steps": [
        {
          "background": true,
          "condition": {
            "file_exists": "api/git-control-tower-api"
          },
          "description": "Start Go API server",
          "name": "start-api",
          "run": "cd api \u0026\u0026 ./git-control-tower-api"
        },
        {
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          },
          "description": "Serve production UI bundle",
          "name": "start-ui",
          "run": "cd ui \u0026\u0026 node server.js"
        },
        {
          "description": "Show API/UI URLs",
          "name": "show-urls",
          "run": "echo \"API: http://localhost:${API_PORT}/health\" \u0026\u0026 echo \"UI:  http://localhost:${UI_PORT}/\""
        }
      ]
    },
    "health": {
      "checks": [
        {
          "critical": true,
          "interval": 30000,
          "name": "api_endpoint",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 5000,
          "type": "http"
        },
        {
          "critical": false,
          "interval": 30000,
          "name": "ui_endpoint",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "type": "http"
        }
      ],
      "description": "Git Control Tower health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 10000
    },
    "setup": {
      "condition": {
        "checks": [
          {
            "targets": [
              "api/git-control-tower-api"
            ],
            "type": "binaries"
          },
          {
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src",
            "type": "ui-bundle"
          },
          {
            "command": "git-control-tower",
            "targets": [
              "git-control-tower"
            ],
            "type": "cli"
          }
        ]
      },
      "description": "Initialize Git Control Tower (build + install)",
      "steps": [
        {
          "condition": {
            "file_exists": "cli/install.sh"
          },
          "description": "Install CLI command globally",
          "name": "install-cli",
          "run": "bash cli/install.sh"
        },
        {
          "description": "Build Go API binary",
          "name": "build-api",
          "run": "cd api \u0026\u0026 go mod download \u0026\u0026 go build -o git-control-tower-api ."
        },
        {
          "condition": {
            "file_exists": "ui/package.json"
          },
          "description": "Install UI dependencies",
          "name": "install-ui-deps",
          "run": "cd ui \u0026\u0026 (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace)"
        },
        {
          "description": "Build production UI bundle",
          "name": "build-ui",
          "run": "cd ui \u0026\u0026 pnpm run build"
        },
        {
          "description": "Show API/UI URLs after setup",
          "name": "show-urls",
          "run": "echo \"✅ Setup complete\" \u0026\u0026 echo \"API: http://localhost:${API_PORT}/health\" \u0026\u0026 echo \"UI:  http://localhost:${UI_PORT}/\""
        }
      ]
    },
    "stop": {
      "description": "Stop all services gracefully"
    },
    "test": {
      "description": "Execute phased test suite",
      "steps": [
        {
          "condition": {
            "file_exists": "cli/install.sh"
          },
          "description": "Ensure CLI is available for integration checks",
          "name": "install-cli",
          "run": "bash cli/install.sh"
        },
        {
          "description": "Execute phased scenario test suite",
          "name": "run-phased-tests",
          "run": "test-genie execute git-control-tower --preset comprehensive --skip playbooks"
        }
      ]
    },
    "version": "2.0.0"
  },
  "ports": {
    "api": {
      "description": "Git Control Tower API port",
      "env_var": "API_PORT",
      "port": 18700,
      "range": "15000-19999"
    },
    "ui": {
      "description": "Git Control Tower UI port",
      "env_var": "UI_PORT",
      "port": 36400,
      "range": "35000-39999"
    }
  },
  "service": {
    "category": "general",
    "description": "Agent-friendly git repository control plane (REST API + CLI + UI)",
    "displayName": "Git Control Tower",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "license": "MIT",
    "maintainers": [
      {
        "email": "support@vrooli.com",
        "name": "Vrooli Team",
        "url": "https://github.com/Vrooli"
      }
    ],
    "name": "git-control-tower",
    "parent": "vrooli",
    "repository": {
      "directory": "/scenarios/git-control-tower",
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli"
    },
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "tags": [
      "git",
      "version-control",
      "devtools",
      "automation"
    ],
    "type": "scenario",
    "version": "1.3.0"
  },
  "version": "2.0.0"
}
