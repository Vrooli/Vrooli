    "skeleton": {
      "schema_version": "v0.1",
      "target": "desktop",
      "app": {
        "name": "git-control-tower",
        "version": "1.3.0",
        "description": "Agent-friendly git repository control plane (REST API + CLI + UI)"
      },
      "ipc": {
        "mode": "loopback-http",
        "host": "127.0.0.1",
        "port": 39200,
        "auth_token_path": "runtime/auth_token"
      },
      "telemetry": {
        "file": "telemetry/deployment-telemetry.jsonl"
      },
      "ports": {
        "default_range": {
          "min": 20000,
          "max": 24000
        }
      },
      "swaps": [
        {
          "original": "minio",
          "replacement": "filesystem-store",
          "reason": "Recommended bundle-safe alternative from dependency metadata"
        },
        {
          "original": "ollama",
          "replacement": "openrouter",
          "reason": "Recommended bundle-safe alternative from dependency metadata"
        },
        {
          "original": "postgres",
          "replacement": "sqlite",
          "reason": "Recommended bundle-safe alternative from dependency metadata"
        }
      ],
      "services": [
        {
          "id": "git-control-tower-api",
          "type": "api-binary",
          "description": "Bundled api process for git-control-tower",
          "binaries": {
            "darwin-x64": {
              "path": "bin/api/darwin-x64/git-control-tower-api"
            },
            "linux-x64": {
              "path": "bin/api/linux-x64/git-control-tower-api"
            },
            "win-x64": {
              "path": "bin/api/win-x64/git-control-tower-api.exe"
            }
          },
          "build": {
            "type": "go",
            "source_dir": "api",
            "entry_point": ".",
            "output_pattern": "bin/api/{{platform}}/git-control-tower-api{{ext}}",
            "env": {
              "CGO_ENABLED": "0"
            }
          },
          "env": {
            "API_PORT": "${git-control-tower-api.api}",
            "VROOLI_LIFECYCLE_MANAGED": "true"
          },
          "data_dirs": [
            "data/api"
          ],
          "log_dir": "logs/api",
          "ports": {
            "requested": [
              {
                "name": "api",
                "range": {
                  "min": 23100,
                  "max": 23200
                }
              }
            ]
          },
          "health": {
            "type": "http",
            "path": "/health",
            "port_name": "api",
            "interval_ms": 2000,
            "timeout_ms": 15000,
            "retries": 5
          },
          "readiness": {
            "type": "health_success",
            "port_name": "api",
            "timeout_ms": 30000
          }
        },
        {
          "id": "git-control-tower-cli",
          "type": "resource",
          "description": "cli component for git-control-tower",
          "binaries": {
            "darwin-x64": {
              "path": "bin/cli/darwin-x64/git-control-tower"
            },
            "linux-x64": {
              "path": "bin/cli/linux-x64/git-control-tower"
            },
            "win-x64": {
              "path": "bin/cli/win-x64/git-control-tower.exe"
            }
          },
          "build": {
            "type": "go",
            "source_dir": "cli",
            "entry_point": ".",
            "output_pattern": "bin/cli/{{platform}}/git-control-tower{{ext}}",
            "env": {
              "CGO_ENABLED": "0"
            }
          },
          "env": {
            "VROOLI_LIFECYCLE_MANAGED": "true"
          },
          "health": {
            "type": "command",
            "command": [
              "echo",
              "healthy"
            ],
            "interval_ms": 10000,
            "timeout_ms": 5000,
            "retries": 1
          },
          "readiness": {
            "type": "health_success",
            "port_name": "http",
            "timeout_ms": 5000
          }
        },
        {
          "id": "ui",
          "type": "ui-bundle",
          "description": "Production UI bundle for git-control-tower",
          "binaries": {
            "darwin-x64": {
              "path": "ui/dist/index.html"
            },
            "linux-x64": {
              "path": "ui/dist/index.html"
            },
            "win-x64": {
              "path": "ui/dist/index.html"
            }
          },
          "env": {
            "UI_PORT": "${ui.ui}",
            "VROOLI_LIFECYCLE_MANAGED": "true"
          },
          "log_dir": "logs/ui",
          "ports": {
            "requested": [
              {
                "name": "ui",
                "range": {
                  "min": 24100,
                  "max": 24200
                }
              }
            ]
          },
          "health": {
            "type": "http",
            "path": "/health",
            "port_name": "ui",
            "interval_ms": 2000,
            "timeout_ms": 10000,
            "retries": 3
          },
          "readiness": {
            "type": "health_success",
            "port_name": "ui",
            "timeout_ms": 20000
          },
          "assets": [
            {
              "path": "ui/dist/index.html",
              "sha256": "pending"
            }
          ],
          "critical": true
        }
      ]
    }
