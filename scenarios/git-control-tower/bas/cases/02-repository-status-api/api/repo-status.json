{
  "metadata": {
    "name": "Repository Status API",
    "description": "Validates RepoService.GetRepoStatus returns branch + file change summary",
    "tags": [
      "e2e",
      "api",
      "git",
      "status"
    ],
    "requirements": [
      "GCT-OT-P0-002A",
      "GCT-OT-P0-002B"
    ],
    "reset": "none",
    "execution_mode": "observer"
  },
  "settings": {},
  "nodes": [
    {
      "id": "status",
      "type": "http_request",
      "data": {
        "label": "POST RepoService.GetRepoStatus",
        "method": "POST",
        "url": "{{API_URL}}/vrooli.git_control_tower.v1.repo.RepoService/GetRepoStatus",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {},
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.repo_dir"
          },
          {
            "type": "json_path_exists",
            "path": "$.branchStatus.head"
          },
          {
            "type": "json_path_exists",
            "path": "$.files"
          },
          {
            "type": "json_path_exists",
            "path": "$.summary"
          },
          {
            "type": "json_path_exists",
            "path": "$.scopes"
          }
        ]
      }
    }
  ],
  "edges": []
}
