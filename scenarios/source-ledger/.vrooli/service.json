{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "source-ledger",
    "displayName": "Source Ledger",
    "description": "A scoped append-only source ledger with bounded recall, rebuildable compaction, and federated corpus search",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "budget": {
          "max_bytes": "4GiB",
          "rationale": "Measured starting ceiling for the append-only source ledger and its derived indexes. No max_age is declared because the journal is the non-regenerable authority."
        },
        "rationale": "Scenario-owned durable data observed in the canonical data directory."
      }
    },
    "rationale": "Source Ledger owns the durable journal and derived engine state; external resource databases are not claimed by this scenario."
  },
  "generation": {
