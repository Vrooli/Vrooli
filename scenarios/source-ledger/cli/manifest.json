          }
        },
        {
          "name": "mark-superseded",
          "description": "Mark an entry superseded by another",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "entry-id",
              "description": "Entry id"
            },
            {
              "name": "replacement-entry-id",
