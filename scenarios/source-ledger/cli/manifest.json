              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "enable",
          "description": "Enable a dry-run-verified rule",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
