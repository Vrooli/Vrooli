{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "source-ledger",
  "description": "Source Ledger operator CLI for named team scopes, append-only journal entries, bounded ambient wake, and scoped semantic recall.",
  "groups": [
    {
      "name": "scopes",
      "description": "Register and inspect team ledger scopes",
      "commands": [
        {
          "name": "create",
          "description": "Create or verify a named team scope",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Scope id"
            }
          ],
          "flags": [
            {
              "name": "label",
              "description": "Human-readable label"
            },
            {
              "name": "frontier-target",
              "description": "Compaction frontier target",
              "default": "16"
            },
            {
              "name": "wake-budget",
              "description": "Ambient wake line budget",
              "default": "96"
            },
            {
              "name": "wake-budget-chars",
              "description": "Ambient wake character budget",
              "default": "12000"
            },
            {
              "name": "max-entry-lines",
              "description": "Maximum lines per wake entry",
              "default": "2"
            },
            {
              "name": "max-entry-chars",
              "description": "Maximum characters per wake entry",
              "default": "200"
            },
            {
              "name": "facets-json",
              "description": "Facet vocabulary as a JSON array",
              "bind": {
                "field": "scope"
              },
              "bind_waiver": "facets-json is decoded by the CLI handler into Scope.facets"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScopesService",
            "method": "CreateScope"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "List registered team scopes and budgets",
          "binding": {
            "kind": "connect-rpc",
            "service": "ScopesService",
            "method": "ListScopes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "policy",
      "description": "Read and tune bounded context policy for one scope",
      "commands": [
        {
          "name": "show",
          "description": "Show effective policy, origin, and inherited defaults",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScopesService",
            "method": "GetPolicy"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "set",
          "description": "Set one or more explicit scope policy overrides",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "frontier-target",
              "description": "Compaction frontier target"
            },
            {
              "name": "wake-budget-lines",
              "description": "Whole-view line ceiling"
            },
            {
              "name": "wake-budget-chars",
              "description": "Whole-view character ceiling"
            },
            {
              "name": "max-entry-lines",
              "description": "Per-entry line ceiling"
            },
            {
              "name": "max-entry-chars",
              "description": "Per-entry character ceiling"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScopesService",
            "method": "SetPolicy"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "reset",
          "description": "Delete scope overrides and restore file-default inheritance",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScopesService",
            "method": "ResetPolicy"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "journal",
      "description": "Append durable team-corpus entries",
      "commands": [
        {
          "name": "note",
          "description": "Append a prose entry to a team scope",
          "positionals": [
            {
              "name": "body",
              "required": true,
              "description": "Entry prose"
            }
          ],
          "flags": [
            {
              "name": "scope",
              "description": "Team ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "kind",
              "description": "Entry kind"
            },
            {
              "name": "trigger",
              "description": "Why the entry was written"
            },
            {
              "name": "approach",
              "description": "Approach used"
            },
            {
              "name": "evidence",
              "description": "Evidence supporting the entry"
            },
            {
              "name": "outcome",
              "description": "Observed outcome"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "AppendEntry"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "Read immutable journal entries",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "limit",
              "description": "Maximum entries, 1-500",
              "default": "20"
            },
            {
              "name": "newest-first",
              "description": "Latest entries first; no cursor pagination",
              "bool": true
            },
            {
              "name": "kind",
              "description": "Exact kind; requires newest-first"
            },
            {
              "name": "cursor",
              "description": "Ascending continuation cursor"
            }
          ],
          "positionals": [],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "ListEntries"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "get",
          "description": "Read one immutable journal entry",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Entry id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "GetEntry"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "recall",
      "description": "Read bounded or semantic team context",
      "commands": [
        {
          "name": "recall",
          "description": "Search one team scope semantically",
          "positionals": [
            {
              "name": "query",
              "required": true,
              "description": "Semantic query"
            }
          ],
          "flags": [
            {
              "name": "scope",
              "description": "Team ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "limit",
              "description": "Maximum hits"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecallService",
            "method": "Recall"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "wake",
          "description": "Render bounded ambient context for one team scope",
          "flags": [
            {
              "name": "scope",
              "description": "Team ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "line-budget",
              "description": "Maximum line budget"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecallService",
            "method": "Wake"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "measures",
      "description": "Windowed source-ledger journal measures",
      "commands": [
        {
          "name": "appended",
          "description": "Count journal entries appended in a time window",
          "flags": [
            {
              "name": "window",
              "default": "this_week",
              "description": "Canonical time window token",
              "bind_waiver": "The CLI adapter converts the canonical time-window token into the structured measures.v1.TimeWindow RPC message before invoking CountEntries."
            },
            {
              "name": "scope",
              "default": "agent-memory",
              "description": "Ledger scope"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "CountEntries"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "measure": {
            "domain": "entries",
            "intent": "Number of immutable journal entries appended in a time window.",
            "questions": [
              "how many journal entries were appended",
              "source ledger append volume this week",
              "memory entries added last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "entries",
              "summary_template": "{count} journal entries appended ({window})"
            }
          }
        }
      ]
    },
    {
      "name": "forest",
      "description": "Inspect and compact a scope's rebuildable forest",
      "commands": [
        {
          "name": "frontier",
          "description": "Read the scored forest frontier",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "limit",
              "description": "Maximum frontier nodes",
              "default": "100"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ForestService",
            "method": "GetFrontier"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "compact",
          "description": "Run a bounded compaction pass",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "max-clusters",
              "description": "Maximum clusters; zero means until target",
              "default": "0"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ForestService",
            "method": "RunCompactionPass"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "rebuild",
          "description": "Rebuild the derived forest for a scope",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ForestService",
            "method": "RebuildForest"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "facets",
      "description": "Inspect and change scoped facet policy and assignments",
      "commands": [
        {
          "name": "list",
          "description": "List facets for a scope",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "ListFacets"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "unassigned",
          "description": "Count journal entries without a facet assignment",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "CountUnassigned"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "delete",
          "description": "Delete a facet with no assignments or rules",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "facet",
              "description": "Facet id",
              "bind": {
                "field": "facet_id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "DeleteFacet"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "set",
          "description": "Set a facet retention policy and residency",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "facet",
              "description": "Facet id",
              "bind": {
                "field": "facet_id"
              }
            },
            {
              "name": "retention-policy",
              "description": "retain, compact, expire-on-resolution, or pinned-or-review"
            },
            {
              "name": "compaction-eligible",
              "description": "Whether compaction may summarize this facet",
              "default": "false"
            },
            {
              "name": "resident-budget",
              "description": "Ambient resident entry budget",
              "default": "0"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "SetFacetPolicy"
          },
          "governance": {
            "effect": "write",
