            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "assign",
          "description": "Assign an entry to a facet",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "entry-id",
              "description": "Entry id"
            },
            {
              "name": "facet",
              "description": "Facet id",
              "bind": {
                "field": "facet_id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "AssignFacet"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "pin",
          "description": "Set an entry pin state",
          "flags": [
            {
              "name": "scope",
