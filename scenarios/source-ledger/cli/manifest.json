            },
            {
              "name": "entry-id",
              "description": "Entry id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "ResolveThread"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
