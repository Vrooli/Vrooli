            },
            {
              "name": "rule-id",
              "description": "Rule id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClassificationRulesService",
            "method": "DryRunRule"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
