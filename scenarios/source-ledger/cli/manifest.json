          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClassificationRulesService",
            "method": "ListRules"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a classification rule",
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            },
            {
              "name": "id",
              "description": "Rule id"
            },
            {
              "name": "priority",
              "description": "Lower values run first",
