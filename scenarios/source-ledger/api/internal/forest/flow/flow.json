{
  "schemaVersion": 6,
  "kind": "temporal",
  "flowId": "forest.compaction.pass",
  "domain": "forest",
  "description": "One all-or-nothing frontier compaction pass.",
  "model": {"module": "ForestCompactionWorkflow", "seed": "2026072901", "maxSteps": 5, "traceCount": 8, "verify": {"invariants": ["TypeOK", "TerminalClosure", "IllegalTransitionsPreserveState", "SummaryWriteIsAtomic"]}},
  "states": [
    {"id": "idle", "quint": "Idle", "initial": true},
    {"id": "scoring", "quint": "Scoring"},
    {"id": "summarizing", "quint": "Summarizing"},
    {"id": "written", "quint": "Written"}
  ],
  "events": [
    {"id": "score", "quint": "Score"},
    {"id": "summarize", "quint": "Summarize"},
    {"id": "write", "quint": "Write"},
    {"id": "fail", "quint": "Fail"},
    {"id": "finish", "quint": "Finish"}
  ],
  "transitionDefaults": {"invalid": {"to": "self", "wantError": true}, "terminal": {"to": "self", "wantError": true}},
  "transitions": [
    {"from": "idle", "event": "score", "to": "scoring"},
    {"from": "scoring", "event": "summarize", "to": "summarizing"},
    {"from": "summarizing", "event": "write", "to": "written"},
    {"from": "summarizing", "event": "fail", "to": "idle"},
    {"from": "written", "event": "finish", "to": "idle"}
  ],
  "invariants": [
    {"id": "type_ok", "quint": "TypeOK", "description": "Status remains in the declared state set."},
    {"id": "terminal_closure", "quint": "TerminalClosure", "description": "No terminal state can transition."},
    {"id": "illegal_transitions_preserve_state", "quint": "IllegalTransitionsPreserveState", "description": "Rejected transitions preserve status."},
    {"id": "summary_write_is_atomic", "quint": "SummaryWriteIsAtomic", "description": "Only the successful summarizing-to-written transition may make a summary visible."}
  ],
  "traces": [
    {"name": "successful_pass", "initial": "idle", "steps": [{"event": "score", "want": "scoring", "wantError": false}, {"event": "summarize", "want": "summarizing", "wantError": false}, {"event": "write", "want": "written", "wantError": false}, {"event": "finish", "want": "idle", "wantError": false}]},
    {"name": "summary_failure_leaves_no_write", "initial": "idle", "steps": [{"event": "score", "want": "scoring", "wantError": false}, {"event": "summarize", "want": "summarizing", "wantError": false}, {"event": "fail", "want": "idle", "wantError": false}]}
  ],
  "runtime": {"go": {"package": "flow", "statusType": "ForestCompactionStatus", "eventType": "ForestCompactionEvent", "constantPrefix": "ForestCompaction"}, "sideEffects": ["Candidate selection and inference happen before the database transaction.", "Summary and all tree edges commit in one transaction only after successful summarization and embedding."]},
  "replay": {"transition": {"function": "TransitionForestCompaction", "stateType": "ForestCompactionState", "statusField": "Status"}}
}

