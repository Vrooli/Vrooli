{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "scenario-dependency-analyzer",
  "description": "Governance manifest for the Scenario Dependency Analyzer CLI. Runtime command registration is still code-backed during the React-Vite migration; this manifest declares the Connect-backed surface first and documents deferred legacy command coverage.",
  "groups": [
    {
      "name": "dependency-health",
      "description": "Dependency readiness and governance validation",
      "commands": [
        {
          "name": "health",
          "description": "Validate dependency health for one scenario",
          "args": [
            {
              "name": "scenario",
              "description": "Scenario to validate",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            },
            {
              "name": "use-cache",
              "description": "Allow cached upstream facts",
              "default": "true"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyHealthService",
            "method": "ValidateDependencyHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "deps approved upsert",
          "description": "Preview or apply one dependency governance record from JSON",
          "args": [
            {
              "name": "record",
              "description": "ApprovedDependencyRecord JSON file supplied with --file",
              "required": false
            }
          ],
          "flags": [
            {
              "name": "file",
              "description": "Path to an ApprovedDependencyRecord JSON file"
            },
            {
              "name": "apply",
              "description": "Apply the change; default is dry-run preview",
              "default": "false"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "UpsertApprovedDependency"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write:.vrooli/dependencies/approved-dependencies.json"
            ]
          }
        },
        {
          "name": "deps approved approve",
          "description": "Preview or apply an approved dependency governance decision",
          "args": [
            {
              "name": "dependency",
              "description": "Dependency formatted as ecosystem/package",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "range",
              "description": "Approved version or version range",
              "default": "*"
            },
            {
              "name": "rationale",
              "description": "Approval rationale"
            },
            {
              "name": "surfaces",
              "description": "Comma-separated allowed surfaces"
            },
            {
              "name": "groups",
              "description": "Comma-separated allowed dependency groups"
            },
            {
              "name": "apply",
              "description": "Apply the change; default is dry-run preview",
              "default": "false"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "UpsertApprovedDependency"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write:.vrooli/dependencies/approved-dependencies.json"
            ]
          }
        },
        {
          "name": "deps approved deny",
          "description": "Preview or apply a denied dependency governance decision",
          "args": [
            {
              "name": "dependency",
              "description": "Dependency formatted as ecosystem/package",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "range",
              "description": "Denied version or version range",
              "default": "*"
            },
            {
              "name": "reason",
              "description": "Denial rationale"
            },
            {
              "name": "replacement",
              "description": "Replacement or remediation guidance"
            },
            {
              "name": "apply",
              "description": "Apply the change; default is dry-run preview",
              "default": "false"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "UpsertApprovedDependency"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write:.vrooli/dependencies/approved-dependencies.json"
            ]
          }
        }
      ]
    },
    {
      "name": "approved-dependencies",
      "description": "Approved third-party dependency governance memory",
      "commands": [
        {
          "name": "deps approved list",
          "description": "List approved dependency records with non-allowlist guidance",
          "flags": [
            {
              "name": "ecosystem",
              "description": "Filter by ecosystem"
            },
            {
              "name": "state",
              "description": "Filter by governance state"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "ListApprovedDependencies"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "deps approved search",
          "description": "Search approved dependency records without treating them as an exhaustive allowlist",
          "args": [
            {
              "name": "query",
              "description": "Search query",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "ecosystem",
              "description": "Filter by ecosystem"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "SearchApprovedDependencies"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "deps approved explain",
          "description": "Explain one approved dependency record",
          "args": [
            {
              "name": "dependency",
              "description": "Dependency formatted as ecosystem/package",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "ExplainApprovedDependency"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "deps approved validate",
          "description": "Validate one scenario or the whole fleet against dependency governance records",
          "args": [
            {
              "name": "scenario",
              "description": "Scenario to validate unless --all is set",
              "required": false
            }
          ],
          "flags": [
            {
              "name": "all",
              "description": "Validate every discovered scenario",
              "default": "false"
            },
            {
              "name": "policy-mode",
              "description": "Override registry policy mode: advisory, strict, or review_gate"
            },
            {
              "name": "json",
              "description": "Output raw JSON",
              "default": "false"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DependencyGovernanceService",
            "method": "ValidateApprovedDependencies"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "graph",
      "description": "Actual scenario interface graph operations",
      "commands": [
        {
          "name": "actual",
          "description": "Describe the actual scenario interface graph using the generated Connect contract",
          "flags": [
            {
              "name": "format",
              "description": "Output format",
              "default": "json"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "InterfaceGraphService",
            "method": "DescribeInterfaceGraph"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "scenario_dependencies",
        "stateful": true,
        "reason": "Dependency edges are persisted in SQLite and need a dedicated future count/table measure RPC; the current graph actual command returns a nested graph contract rather than a measures-shaped result."
      },
      {
        "domain": "scenario_metadata",
        "stateful": true,
        "reason": "Scenario metadata is persisted in SQLite and currently exposed through legacy REST/CLI commands; Connect measure coverage is deferred to the catalog contract migration."
      },
      {
        "domain": "optimization_recommendations",
        "stateful": true,
        "reason": "Optimization recommendations are persisted analysis outputs; Connect measure coverage is deferred to the optimization contract migration."
      }
    ],
    "omitted": [
      {
        "domain": "scenario_dependencies",
        "reason": "The graph actual command is the current read surface, but it returns a nested interface graph instead of a measure-shaped scalar/table. Add a dedicated Count/ListScenarioDependencies Connect RPC before removing this waiver."
      },
      {
        "domain": "scenario_metadata",
        "reason": "Catalog/scenarios commands are still REST-backed compatibility surfaces during Phase 4."
      },
      {
        "domain": "optimization_recommendations",
        "reason": "Optimization commands are still REST-backed compatibility surfaces during Phase 4."
      }
    ]
  },
  "omitted": []
}
