    {
      "provider_id": "scenario-dependency-analyzer.resource-inventory",
      "lifecycle": "experimental",
      "provider_group": "scenario-dependency-analyzer",
      "bucket": "BUCKET_STATE",
      "type": "inventory",
      "description": "Declared local resource inventory and anatomy from the canonical resource catalog and resource.json manifests: catalog slug/name, driver, ports, health-check shape, declared dependencies, and safe runtime shape. Route here for resource ports, driver, manifest checks, runtime configuration shape, and declared resource dependencies. This provider does not run probes; health and serving state are unknown. Catalog slug is canonical even when manifest name differs. Use the separate resources leaf for scenarios that consume a resource.",
      "routing_profile": {
        "answer_spaces": ["resource_inventory", "resource_anatomy"],
        "intents": ["inspect_resource", "identify_resource", "explain"],
        "positive_examples": [
          "what ports and driver does qdrant declare",
          "show reranker's declared health checks and runtime shape",
          "which local resource provides vector database and semantic search"
        ],
        "exclusions": [
          "is qdrant currently healthy or reachable",
          "which scenarios use qdrant",
          "install or start a resource"
        ]
      },
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/api/v1/resources/inventory/search",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/api/v1/health/analysis",
          "method": "HTTP_METHOD_GET",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "title",
        "score_field": "score",
        "snippet_field": "snippet",
        "path_field": "path",
        "score_scale": "SCORE_SCALE_RAW",
        "metadata_fields": {
          "resource": "resource",
          "evidence_basis": "evidenceBasis",
          "runtime_status_known": "runtimeStatusKnown"
        },
        "degradations_field": "degradations"
      },
      "performance": {"p95_ms": 1500, "degraded_rate_max": 0.2, "minimum_samples": 1, "telemetry_required": false},
      "tests": {
        "minimum": {"reviewed_positive": 3, "negative": 2},
