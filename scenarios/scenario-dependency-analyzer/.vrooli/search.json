{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "scenario-dependency-analyzer.dependencies",
      "provider_group": "scenario-dependency-analyzer",
      "bucket": "BUCKET_REUSE",
      "type": "dependency",
      "description": "Third-party dependency/package selection and governance — which package to use for a purpose (for example \"a React forms library\", \"a Go HTTP router\", \"image resizing\"), the approved version ranges, and which packages are denied or vulnerable. Route here for 'what dependency/package/library should I use for X' and 'is package Y approved'. Do NOT route here for prior-work records, CLI commands, skills, docs, or scenario status.",
      "scope": "SCOPE_PROJECT",
      "class": "local_index",
      "endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/vrooli.scenario_dependency_analyzer.v1.dependency_governance.DependencyGovernanceService/SearchApprovedDependencies",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/health",
          "method": "HTTP_METHOD_GET",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "records",
        "id_field": "packageName",
        "title_field": "packageName",
        "score_field": "relevanceScore",
        "snippet_field": "rationale",
        "path_field": "packageName",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "reindex_endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/vrooli.search_hub.v1.control.SearchControlService/Reindex",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scope\":\"{{scope}}\",\"dry_run\":false}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "config_endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/vrooli.search_hub.v1.control.SearchControlService/WriteConfig",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": true,
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 50,
        "floor": {
          "max_gap": 0,
          "hard_floor": 0.65
        }
      },
      "scoring": {},
      "performance": {
        "p95_ms": 1500,
        "degraded_rate_max": 0.05,
        "telemetry_required": true,
        "minimum_samples": 8
      },
      "tests": {
        "name": "scenario-dependency-analyzer dependencies — governance corpus",
        "description": "RANK-CENTRIC golden corpus for the dependency governance index: a purpose query should surface the approved package recorded for that purpose.",
        "cases": [
          {
            "id": "connect-rpc",
            "query": "connect rpc client and server",
            "tags": [
              "strong",
              "go",
              "package-governance"
            ],
            "expect_ids": [
              "@connectrpc/connect-web",
              "@connectrpc/connect",
              "connectrpc.com/connect"
            ],
            "expect_within_top_k": 5
          },
          {
            "id": "http-middleware",
            "query": "Go HTTP middleware for CORS logging and request handling",
            "tags": [
              "strong",
              "go",
              "http",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "github.com/gorilla/handlers"
            ],
            "expect_within_top_k": 5,
            "note": "Live verified 2026-07-12: the approved HTTP middleware record is the first dependency hit."
          },
          {
            "id": "sqlite-persistence",
            "query": "pure Go SQLite driver without CGO for local persistence",
            "tags": [
              "strong",
              "go",
              "storage",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "modernc.org/sqlite"
            ],
            "expect_within_top_k": 5,
            "note": "Live verified 2026-07-12 against the modernc SQLite governance record."
          },
          {
            "id": "sqlmock-testing",
            "query": "mock SQL database driver for Go unit tests",
            "tags": [
              "weak-real",
              "go",
              "testing",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "github.com/DATA-DOG/go-sqlmock"
            ],
            "expect_within_top_k": 5,
            "note": "Live verified 2026-07-12 against the focused SQL mock dependency record."
          },
          {
            "id": "container-integration-tests",
            "query": "run Go integration tests against real containers",
            "tags": [
              "hard",
              "go",
              "testing",
              "integration",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "github.com/testcontainers/testcontainers-go"
            ],
            "expect_within_top_k": 5,
            "note": "Live verified 2026-07-12: Testcontainers is returned for real-service integration testing."
          },
          {
            "id": "go-module-tools",
            "query": "official Go module-aware tooling library",
            "tags": [
              "weak",
              "go",
              "tooling",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "golang.org/x/mod"
            ],
            "expect_within_top_k": 5,
            "note": "Live verified 2026-07-12 against the Go module tooling dependency record."
          },
          {
            "id": "browser-connect-client",
            "query": "TypeScript browser client for Connect RPC APIs",
            "tags": [
              "strong",
              "typescript",
              "rpc",
              "package-governance",
              "reviewed-live"
            ],
            "expect_ids": [
              "@connectrpc/connect-web"
            ],
            "expect_within_top_k": 5,
            "note": "Reviewed companion to the Go Connect RPC case; the stable browser package is a distinct governed surface."
          },
          {
            "id": "gibberish-1",
            "query": "asdfqwer zxcvbnm qwertyuiop florbnax",
            "tags": [
              "gibberish"
            ],
            "expect_max_score": 0.65,
            "expect_no_strong_hit": true,
            "note": "Junk rejection: nonsense must not surface a confident hit."
          }
        ],
        "coverage": {
          "required_tag_groups": [
            {
              "id": "package-governance",
              "description": "Approved dependency lookup and package-purpose governance.",
              "tags": [
                "go",
                "package-governance"
              ],
              "min_reviewed_positive": 1
            }
          ]
        },
        "minimum": {
          "reviewed_positive": 1,
          "negative": 1
        }
      }
    },
    {
      "provider_id": "scenario-dependency-analyzer.scenarios",
      "provider_group": "scenario-dependency-analyzer",
      "bucket": "BUCKET_REUSE",
      "type": "scenarios",
      "description": "Scenario connection graph — what a scenario depends on and what depends on it (its reverse dependents). Route here for 'what does X depend on', 'what depends on X', 'X's dependencies / dependents', and the cross-scenario dependency/connection graph. Do NOT route here for a scenario's purpose, anatomy, responsibilities, or internal domains — that is architecture-cartographer's domain-map. Connection-only.",
      "scope": "SCOPE_PROJECT",
      "class": "local_index",
      "endpoint": {
        "http_json": {
          "scenario_id": "scenario-dependency-analyzer",
          "path": "/vrooli.scenario_dependency_analyzer.v1.graph.InterfaceGraphService/SearchInterfaceGraph",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
