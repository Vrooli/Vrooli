{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "5GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      },
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage is retained for 30 days and reclaimed by age; the window is the workload retention requirement."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "scenario-dependency-analyzer",
    "displayName": "Scenario Dependency Analyzer",
    "description": "Meta-intelligence capability for analyzing, visualizing, and optimizing scenario and resource dependencies within Vrooli",
    "version": "1.0.0",
    "tags": [
      "meta-intelligence",
      "dependency-analysis",
      "deployment-optimization",
      "architectural-intelligence",
      "capability-planning",
      "foundational-capability",
      "cross-scenario-multiplier",
      "go-api",
      "sqlite-storage",
      "claude-code-integration",
      "qdrant-vectors",
      "graph-visualization"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/scenario-dependency-analyzer"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.1.0"
    },
    "manifest_sha": "efce375640f074bcbd20e0463fd67d9b413778c930293dda319a6e2f21526fd5",
    "content_sha": "f26ae1ea5fb267b746c6ab7966468b0f3cebd1fc6631e78cbf6eac20fce1244e"
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Dependency analysis API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Dependency graph visualization UI port",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Scenario Dependency Analyzer health monitoring",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 3000,
          "interval": 60000
        },
        {
          "name": "dependency_analysis_test",
          "type": "http",
          "target": "http://localhost:${API_PORT}/api/v1/health/analysis",
          "critical": true,
          "timeout": 15000,
          "interval": 300000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 20000
    }
  },
  "dependencies": {
    "resources": {
      "claude-code": {
        "type": "claude-code",
        "enabled": true,
        "required": true,
        "purpose": "AI-powered analysis of scenario code, configurations, and proposed scenario descriptions",
        "startup_policy": "must_start"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "purpose": "Generate embeddings for semantic similarity matching against Qdrant",
        "model_roles": [
          "embedding.default"
        ],
        "startup_policy": "must_start"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "purpose": "Semantic similarity matching for proposed scenarios and dependency pattern recognition",
        "startup_policy": "must_start"
      },
      "redis": {
        "type": "redis",
        "enabled": false,
        "required": false,
        "purpose": "Cache frequently accessed dependency data and analysis results for performance optimization",
        "startup_policy": "try_start"
      }
    },
    "scenarios": {
      "proto-health": {
        "enabled": true,
        "required": true,
        "description": "Provides batch protobuf surface facts for actual cross-scenario interface graph attribution",
        "degraded_behavior": "Dependency graph analysis remains available without protobuf attribution, but interface-level evidence is marked incomplete until proto-health recovers.",
        "startup_policy": "must_start"
      },
      "code-facts": {
        "enabled": true,
        "required": true,
        "description": "Provides batch import facts used to build actual cross-scenario usage evidence",
        "degraded_behavior": "Dependency graph analysis remains available without import attribution, but cross-scenario usage evidence is marked incomplete until code-facts recovers.",
        "startup_policy": "must_start"
      }
    }
  },
  "environment": {},
  "cli": {
    "enabled": true,
    "command": "scenario-dependency-analyzer",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "scenario-dependency-analyzer"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui",
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator that no Go code in this scenario currently opens. The declaration records intended caching, not a runtime requirement."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
