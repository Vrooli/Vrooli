    {
      "id": "L0",
      "name": "No dependency graph",
      "description": "SDA cannot resolve dependency surfaces or runtime dependency metadata for the target scenario.",
      "entry_criteria": ["Scenario id is provided"],
      "exit_criteria": ["At least one dependency surface or explicit no-surface finding is emitted"]
    },
    {
      "id": "L1",
      "name": "Dependency surfaces known",
      "description": "SDA can identify package/module surfaces and reports unsupported or missing surfaces explicitly.",
      "entry_criteria": ["Target scenario is readable"],
      "exit_criteria": ["Dependency surfaces are discovered or intentionally reported as absent"]
    },
    {
      "id": "L2",
      "name": "Runtime dependencies reachable",
      "description": "Required resources and scenario dependencies are present, running, and healthy enough for local validation.",
      "entry_criteria": ["Dependency surfaces are known"],
      "exit_criteria": ["Required runtime resources and scenario dependencies are running and healthy"]
    },
    {
      "id": "L3",
      "name": "Package metadata governed",
      "description": "Dependency metadata is reproducible, package lockfiles are coherent, and release-age policy is enforced.",
      "entry_criteria": ["Runtime dependency checks pass"],
      "exit_criteria": ["Package managers, lockfiles, go.mod state, and release-age policy are healthy"]
    },
    {
      "id": "L4",
      "name": "Dependency governance current",
      "description": "Approved dependency registry, policy exceptions, security-health index status, and graph drift are current.",
      "entry_criteria": ["Package metadata checks pass"],
      "exit_criteria": ["Governance registry, security index, and declared-vs-observed graph evidence are current"]
    },
    {
      "id": "L5",
      "name": "Fleet-ready dependency posture",
      "description": "Dependency health is clean enough for Test Genie delegation and fleet-level maturity comparison.",
      "entry_criteria": ["Governance and graph drift checks pass"],
      "exit_criteria": ["No dependency-health findings block fleet validation"]
    }
  ],
