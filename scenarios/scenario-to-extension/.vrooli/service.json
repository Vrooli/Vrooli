{
  "service": {
    "name": "scenario-to-extension",
    "displayName": "Scenario To Extension",
    "parent": "vrooli",
    "type": "scenario",
    "category": "automation",
    "tags": [],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/scenario-to-extension"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "description": "Transform Vrooli scenarios into powerful browser extensions with content scripts, background services, and popup interfaces",
    "version": "1.0.0"
  },
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "api_data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned API data observed in the canonical API data directory.",
        "subpath": "api/data",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "health": {
      "description": "Scenario to Extension health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 3000,
          "interval": 45000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "purpose": "Store extension templates, build history, and deployment metadata",
        "access_method": "CLI via scenario API"
      },
      "redis": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "purpose": "Cache compiled extensions and build artifacts for faster generation",
        "access_method": "CLI via scenario API"
      }
    }
  },
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "cli": {
    "enabled": true,
    "command": "scenario-to-extension",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "scenario-to-extension"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
