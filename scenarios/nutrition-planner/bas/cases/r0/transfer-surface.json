{
  "metadata": {
    "name": "nutrition-planner-transfer-surface",
    "description": "Open the transfer center and verify native export and restore controls are reachable.",
    "requirement": "ACT-026",
    "version": "1",
    "labels": { "reset": "none", "surface": "transfer" },
    "execution_mode": "observer"
  },
  "settings": { "viewport_width": 1280, "viewport_height": 800 },
  "nodes": [
    {
      "id": "open-transfer",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "nutrition-planner",
          "scenario_path": "/transfer",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Transfer" }
      }
    },
    {
      "id": "assert-transfer",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.transfer",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 15000,
          "failure_message": "Transfer heading did not render"
        },
        "metadata": { "label": "Transfer surface is visible" }
      }
    }
  ]
}
