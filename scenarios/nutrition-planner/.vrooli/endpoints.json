        "proto_payloads": {
          "request": {
            "transport": "query",
            "conformance": "external_shape"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "text",
            "conformance": "external_shape"
          }
        }
      }
    },
