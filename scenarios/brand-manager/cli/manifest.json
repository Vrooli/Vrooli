{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "brand-manager",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "brands",
      "description": "Manage brand identities (CRUD + immutable version history)",
      "commands": [
        {
          "name": "list",
          "description": "List brands (newest-updated first)",
          "flags": [
            {
              "name": "name",
              "description": "Filter by case-insensitive name substring"
            },
            {
              "name": "limit",
              "description": "Maximum rows to return (default 100, max 500)"
            },
            {
              "name": "offset",
              "description": "Rows to skip (pagination)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "ListBrands"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "create",
          "description": "Create a brand",
          "flags": [
            {
              "name": "name",
              "required": true,
              "description": "Brand name"
            },
            {
              "name": "description",
              "description": "Brand description"
            },
            {
              "name": "notes",
              "description": "Authoring notes"
            },
            {
              "name": "display-name",
              "description": "Identity: display name"
            },
            {
              "name": "tagline",
              "description": "Identity: tagline"
            },
            {
              "name": "primary",
              "description": "Colors: primary (CSS color)"
            },
            {
              "name": "secondary",
              "description": "Colors: secondary (CSS color)"
            },
            {
              "name": "accent",
              "description": "Colors: accent (CSS color)"
            },
            {
              "name": "background",
              "description": "Colors: background (CSS color)"
            },
            {
              "name": "surface",
              "description": "Colors: surface (CSS color)"
            },
            {
              "name": "text",
              "description": "Colors: text (CSS color)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "CreateBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "get",
          "description": "Get a brand by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Brand id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "GetBrand"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "update",
          "description": "Update a brand (partial; only provided fields change)",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Brand id"
            }
          ],
          "flags": [
            {
              "name": "name",
              "description": "Brand name"
            },
            {
              "name": "description",
              "description": "Brand description"
            },
            {
              "name": "notes",
              "description": "Authoring notes"
            },
            {
              "name": "display-name",
              "description": "Identity: display name"
            },
            {
              "name": "tagline",
              "description": "Identity: tagline"
            },
            {
              "name": "primary",
              "description": "Colors: primary (CSS color)"
            },
            {
              "name": "secondary",
              "description": "Colors: secondary (CSS color)"
            },
            {
              "name": "accent",
              "description": "Colors: accent (CSS color)"
            },
            {
              "name": "background",
              "description": "Colors: background (CSS color)"
            },
            {
              "name": "surface",
              "description": "Colors: surface (CSS color)"
            },
            {
              "name": "text",
              "description": "Colors: text (CSS color)"
            },
            {
              "name": "expected-version",
              "description": "Optimistic lock: reject unless this matches the current version"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "UpdateBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "delete",
          "description": "Delete a brand (idempotent)",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Brand id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "DeleteBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "versions",
          "description": "List a brand's immutable version history",
          "positionals": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "BrandsService",
            "method": "ListBrandVersions"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "assignments",
      "description": "Assign brands to scenarios and inspect a scenario's branding status",
      "commands": [
        {
          "name": "list",
          "description": "List brand assignments (newest-applied first)",
          "flags": [
            {
              "name": "brand-id",
              "description": "Filter to assignments for one brand"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssignmentsService",
            "method": "ListAssignments"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "assign",
          "description": "Assign a brand to a scenario (upsert; pins the brand's current version)",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to apply"
            },
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario to brand"
            },
            {
              "name": "elements",
              "description": "Comma-separated applied elements (e.g. logo,colors)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssignmentsService",
            "method": "AssignBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "status",
          "description": "Show a scenario's branding status",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssignmentsService",
            "method": "GetScenarioStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "unassign",
          "description": "Remove a scenario's brand assignment (idempotent)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssignmentsService",
            "method": "UnassignScenario"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "assets",
      "description": "Upload, fetch, and remove brand asset files (logo, favicon, icon, …)",
      "commands": [
        {
          "name": "list",
          "description": "List brand assets (newest-uploaded first)",
          "flags": [
            {
              "name": "brand-id",
              "description": "Filter to assets for one brand"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssetsService",
            "method": "ListAssets"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "upload",
          "description": "Upload (or replace) a brand asset file from local disk",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id that owns the asset"
            },
            {
              "name": "file",
              "required": true,
              "description": "Path to the local file to upload"
            },
            {
              "name": "filename",
              "description": "Override the stored filename (defaults to the file's basename)"
            },
            {
              "name": "mime-type",
              "description": "Override the mime type (inferred from the extension when unset)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssetsService",
            "method": "UploadAsset"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        },
        {
          "name": "get",
          "description": "Show an asset's catalog entry by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Asset id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssetsService",
            "method": "GetAsset"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "download",
          "description": "Download an asset's bytes to a local file",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Asset id"
            }
          ],
          "flags": [
            {
              "name": "out",
              "description": "Output path (defaults to the stored filename in the working directory)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssetsService",
            "method": "DownloadAsset"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "delete",
          "description": "Delete an asset (idempotent)",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Asset id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AssetsService",
            "method": "DeleteAsset"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "generation",
      "description": "Generate brand text facets and images with the AI provider chain (Ollama → OpenRouter)",
      "commands": [
        {
          "name": "status",
          "description": "Report which AI providers are currently available",
          "binding": {
            "kind": "connect-rpc",
            "service": "GenerationService",
            "method": "GetProviderStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "elements",
          "description": "Generate brand text facets (colors, typography, voice) and apply them to a brand",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to generate facets for"
            },
            {
              "name": "elements",
              "required": true,
              "description": "Comma-separated facets: colors,typography,voice"
            },
            {
              "name": "model",
              "description": "Provider model/role override (optional)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GenerationService",
            "method": "GenerateBrandElements"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "image",
          "description": "Generate a brand image (logo or favicon) and store it as a brand asset",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to generate the image for"
            },
            {
              "name": "type",
              "required": true,
              "description": "Image type: logo or favicon"
            },
            {
              "name": "model",
              "description": "Provider model override (optional)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GenerationService",
            "method": "GenerateBrandImage"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "apply",
      "description": "Apply a brand identity into a target scenario source tree (CSS, manifest.json, logo/favicon)",
      "commands": [
        {
          "name": "preview",
          "description": "Preview which files applying a brand to a scenario would write (makes no changes)",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to apply"
            },
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name (its directory must exist)"
            },
            {
              "name": "elements",
              "description": "Comma-separated elements: colors,typography,identity,favicon,logo (default: all)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "PreviewApply"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "run",
          "description": "Apply a brand to a scenario source tree and record the assignment",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to apply"
            },
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name (its directory must exist)"
            },
            {
              "name": "elements",
              "description": "Comma-separated elements: colors,typography,identity,favicon,logo (default: all)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "ApplyBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        }
      ]
    },
    {
      "name": "discovery",
      "description": "Scan an existing scenario for branding state and import it as a brand",
      "commands": [
        {
          "name": "scan",
          "description": "Scan a scenario for branding state and show the draft brand it would import (makes no changes)",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name to scan (its directory must exist)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DiscoveryService",
            "method": "DiscoverScenario"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "import",
          "description": "Scan a scenario and create a new brand from the discovered branding state",
          "flags": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name to scan and import from (its directory must exist)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DiscoveryService",
            "method": "ImportBrand"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "design",
      "description": "Render a brand's identity as a canonical DESIGN.md document",
      "commands": [
        {
          "name": "generate",
          "description": "Render a brand as a DESIGN.md document and print the markdown (makes no changes)",
          "flags": [
            {
              "name": "brand-id",
              "required": true,
              "description": "Brand id to render"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DesignService",
            "method": "GenerateDesignLanguage"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "omitted": []
}
