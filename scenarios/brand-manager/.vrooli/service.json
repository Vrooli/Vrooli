    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "brand-manager"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/brand-manager-api"
            ]
          },
          {
            "type": "cli",
            "command": "brand-manager"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api \u0026\u0026 GOWORK=off go mod download \u0026\u0026 GOWORK=off go build -o brand-manager-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api \u0026\u0026 ./brand-manager-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/brand-manager-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui \u0026\u0026 node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute brand-manager --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'brand-manager-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "Primary AI provider for brand text + image generation (AIProviderChain); generation degrades gracefully when absent"
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": false,
        "description": "Fallback AI provider in the AIProviderChain when Ollama is unavailable or lacks a model. Text model resolves through an OpenRouter policy role.",
        "model_roles": ["chat.default"]
      }
    }
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/brand-manager.db",
    "OLLAMA_URL": "${OLLAMA_URL}",
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
  }
}
