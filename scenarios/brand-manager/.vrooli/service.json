    },
    "manifest_sha": "f70bc94203f839ba4825223e7d60f8c5cb8983442653a68a6f7f07d3726f00cd",
    "content_sha": "b0cdda3f0820dad3c8d1c4f2d147c2a1f9b4bd89f602cf99b8d244c491071898"
  },
  "cli": {
    "enabled": true,
    "command": "brand-manager",
    "adapter": {
