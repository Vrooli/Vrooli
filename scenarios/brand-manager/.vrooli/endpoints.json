{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.brand_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.brand_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "apply_preview",
      "path": "/vrooli.brand_manager.v1.apply.ApplyService/PreviewApply",
      "method": "POST",
      "summary": "Preview applying a brand to a scenario",
      "description": "Computes exactly which files applying a brand to a scenario would write (CSS, manifest.json, copied logo/favicon), WITHOUT touching the filesystem or recording an assignment.",
      "category": "apply",
      "request": {
        "type": "object",
        "properties": {
          "brand_id": "string (required, must exist)",
          "elements": "array<string> (subset of colors, typography, identity, favicon, logo; empty = all)",
          "scenario_name": "string (required, scenario directory must exist)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "array<ApplyAction>",
          "brand_version": "int32",
          "dry_run": "bool (always true)",
          "scenario": "string",
          "skipped": "array<SkipReason>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing brand_id or scenario_name"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such brand, or the scenario directory does not exist"
        }
      ],
      "examples": [
        {
          "name": "Preview apply",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.apply.ApplyService/PreviewApply -H 'Content-Type: application/json' -d '{\"brand_id\":\"abc123\",\"scenario_name\":\"web-console\"}'"
        }
      ]
    },
    {
      "id": "apply_brand",
      "path": "/vrooli.brand_manager.v1.apply.ApplyService/ApplyBrand",
      "method": "POST",
      "summary": "Apply a brand to a scenario",
      "description": "Writes the requested brand elements into the scenario's source tree (CSS custom properties, a manifest.json merge, copied logo/favicon bytes) and records the brand↔scenario assignment. Convergent: re-applying overwrites the same managed files.",
      "category": "apply",
      "request": {
        "type": "object",
        "properties": {
          "brand_id": "string (required, must exist)",
          "elements": "array<string> (subset of colors, typography, identity, favicon, logo; empty = all)",
          "scenario_name": "string (required, scenario directory must exist)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "array<ApplyAction>",
          "brand_version": "int32",
          "dry_run": "bool (always false)",
          "scenario": "string",
          "skipped": "array<SkipReason>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing brand_id or scenario_name"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such brand, or the scenario directory does not exist"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Writing a file or recording the assignment failed"
        }
      ],
      "examples": [
        {
          "name": "Apply brand",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.apply.ApplyService/ApplyBrand -H 'Content-Type: application/json' -d '{\"brand_id\":\"abc123\",\"scenario_name\":\"web-console\",\"elements\":[\"colors\",\"logo\"]}'"
        }
      ]
    },
    {
      "id": "assets_list",
      "path": "/vrooli.brand_manager.v1.assets.AssetsService/ListAssets",
      "method": "POST",
      "summary": "List brand assets",
      "description": "Returns asset catalog entries ordered newest-uploaded first, optionally filtered to one brand.",
      "category": "assets",
      "request": {
        "type": "object",
        "properties": {
          "brand_id": "string (optional filter; empty = all)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assets": "array<Asset>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List assets",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.assets.AssetsService/ListAssets -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "assets_upload",
      "path": "/vrooli.brand_manager.v1.assets.AssetsService/UploadAsset",
      "method": "POST",
      "summary": "Upload (or replace) a brand asset",
      "description": "Writes the file bytes and upserts the catalog row keyed by (brand_id, filename). Re-uploading the same filename replaces the bytes and keeps the asset id. The brand must exist, the mime type must be an allowed image type, and the payload must be non-empty and within 32 MiB.",
      "category": "assets",
      "request": {
        "type": "object",
        "properties": {
          "brand_id": "string (required, must exist)",
          "content": "bytes (required, non-empty, <= 32 MiB)",
          "filename": "string (required, bare basename)",
          "mime_type": "string (optional; inferred from extension when empty)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "asset": "Asset"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing/invalid field, unknown brand, unsupported mime, or oversized payload"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Blob write or repository failure"
        }
      ],
      "examples": [
        {
          "name": "Upload asset",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.assets.AssetsService/UploadAsset -H 'Content-Type: application/json' -d '{\"brand_id\":\"abc123\",\"filename\":\"logo.png\",\"content\":\"<base64>\"}'"
        }
      ]
    },
    {
      "id": "assets_get",
      "path": "/vrooli.brand_manager.v1.assets.AssetsService/GetAsset",
      "method": "POST",
      "summary": "Get an asset catalog entry by id",
      "description": "Returns the asset metadata matching the request id (no bytes; use DownloadAsset for bytes).",
      "category": "assets",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "asset": "Asset"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No asset with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get asset",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.assets.AssetsService/GetAsset -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "assets_download",
      "path": "/vrooli.brand_manager.v1.assets.AssetsService/DownloadAsset",
      "method": "POST",
      "summary": "Download an asset's bytes",
      "description": "Returns the stored file bytes plus its filename and mime type.",
      "category": "assets",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "content": "bytes",
          "filename": "string",
          "mime_type": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No asset with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Blob read or repository failure"
        }
      ],
      "examples": [
        {
          "name": "Download asset",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.assets.AssetsService/DownloadAsset -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "assets_delete",
      "path": "/vrooli.brand_manager.v1.assets.AssetsService/DeleteAsset",
      "method": "POST",
      "summary": "Delete an asset (idempotent)",
      "description": "Removes the catalog row and best-effort removes the on-disk file. Deleting a missing asset returns success.",
      "category": "assets",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object"
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Delete asset",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.assets.AssetsService/DeleteAsset -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
