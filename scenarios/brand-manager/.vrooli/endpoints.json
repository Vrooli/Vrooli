{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.brand_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.brand_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "brands_list",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/ListBrands",
      "method": "POST",
      "summary": "List brands",
      "description": "Returns brands ordered newest-updated first, with optional name-substring filter and pagination.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (default 100, max 500)",
          "name_contains": "string (case-insensitive substring filter)",
          "offset": "int32 (rows to skip)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "brands": "array<Brand>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List brands",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/ListBrands -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "brands_create",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/CreateBrand",
      "method": "POST",
      "summary": "Create a brand",
      "description": "Persists a new brand at version 1 and snapshots that version. Name is required.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "colors": "Colors",
          "identity": "Identity",
          "name": "string (required, non-whitespace)",
          "typography": "Typography",
          "voice": "Voice"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "brand": "Brand"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only name"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create brand",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/CreateBrand -H 'Content-Type: application/json' -d '{\"name\":\"Acme\"}'"
        }
      ]
    },
    {
      "id": "brands_get",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/GetBrand",
      "method": "POST",
      "summary": "Get a brand by id",
      "description": "Returns the brand matching the request id.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "brand": "Brand"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No brand with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get brand",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/GetBrand -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "brands_update",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/UpdateBrand",
      "method": "POST",
      "summary": "Update a brand (partial)",
      "description": "Merges non-empty fields onto the stored brand, increments the version, and snapshots it. expected_version (when > 0) enforces optimistic locking.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "expected_version": "int32 (optional optimistic lock)",
          "id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "brand": "Brand"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Resulting name is empty"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No brand with that id exists"
        },
        {
          "status": 409,
          "code": "failed_precondition",
          "description": "expected_version does not match current version"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Update brand",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/UpdateBrand -H 'Content-Type: application/json' -d '{\"id\":\"abc123\",\"description\":\"updated\"}'"
        }
      ]
    },
    {
      "id": "brands_delete",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/DeleteBrand",
      "method": "POST",
      "summary": "Delete a brand (idempotent)",
      "description": "Removes the brand. Deleting a missing brand returns success.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object"
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Delete brand",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/DeleteBrand -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "brands_versions",
      "path": "/vrooli.brand_manager.v1.brands.BrandsService/ListBrandVersions",
      "method": "POST",
      "summary": "List a brand's version history",
      "description": "Returns the brand's immutable version snapshots, newest-first.",
      "category": "brands",
      "request": {
        "type": "object",
        "properties": {
          "brand_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "versions": "array<BrandVersion>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List versions",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.brands.BrandsService/ListBrandVersions -H 'Content-Type: application/json' -d '{\"brand_id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "notes_list",
      "path": "/vrooli.brand_manager.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "notes_create",
      "path": "/vrooli.brand_manager.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ]
    },
    {
      "id": "notes_get",
      "path": "/vrooli.brand_manager.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "notes_count",
      "path": "/vrooli.brand_manager.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.brand_manager.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ]
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "UploadAttachmentResponse",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.brand_manager.v1.notes.UploadAttachmentResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.brand_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    }
  ]
}
