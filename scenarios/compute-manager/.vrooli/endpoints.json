{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.compute_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.compute_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "Returns each dependency this scenario declares in .vrooli/service.json together with a liveness verdict. An available verdict means the dependency scenario is running, never that this scenario can successfully call it.",
      "category": "capabilities",
      "examples": [
        {
          "name": "Describe capabilities",
          "curl": "curl http://localhost:${API_PORT}/api/v1/capabilities/describe"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Read by lifecycle and setup tooling before a generated Connect client exists; reports declared-dependency liveness, not product state.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.compute_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.compute_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "instance_request",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/RequestInstance",
      "method": "POST",
      "summary": "Request compute capacity",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_managed_acquire",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/AcquireInstance",
      "method": "POST",
      "summary": "Acquire approved deployment compute without Bridge enrollment",
      "description": "",
      "category": "instance",
      "request": {
        "type": "object",
        "properties": {
          "idempotency_key": "string (required; stable across retry)",
          "lifetime_seconds": "int64 (optional; defaults to 24 hours)",
          "profile_id": "string (web-console/staging)",
          "region": "string (nbg1 or fsn1)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "instance": "Persisted exact Compute Manager instance",
          "spend_receipt": "Persisted quote and admission receipt bound to the instance"
        }
      }
    },
    {
      "id": "instance_managed_acquire_receipt",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/GetAcquireReceipt",
      "method": "POST",
      "summary": "Read the persisted deployment acquisition receipt",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_managed_enroll",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/EnrollInstance",
      "method": "POST",
      "summary": "Idempotently enroll an acquired instance with Bridge",
      "description": "",
      "category": "instance",
      "request": {
        "type": "object",
        "properties": {
          "acquisition_idempotency_key": "string (required)",
          "idempotency_key": "string (required; stable across retry)",
          "instance_id": "string (required; exact persisted Compute Manager instance)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "instance": "Persisted exact Compute Manager instance",
          "receipt": "Persisted Bridge enrollment state and read-back identity"
        }
      }
    },
    {
      "id": "instance_managed_enrollment_receipt",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/GetEnrollmentReceipt",
      "method": "POST",
      "summary": "Read Bridge enrollment state by stable idempotency key",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_spend_receipt",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/GetSpendReceipt",
      "method": "POST",
      "summary": "Read persisted spend quote and admission receipt",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_list",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/ListInstances",
      "method": "POST",
