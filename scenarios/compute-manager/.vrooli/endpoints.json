    },
    {
      "id": "instance_extend",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/ExtendInstance",
      "method": "POST",
      "summary": "Extend instance lifetime",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_destroy",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/DestroyInstance",
      "method": "POST",
      "summary": "Destroy a compute instance",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_snapshot",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/SnapshotInstance",
      "method": "POST",
      "summary": "Snapshot an instance for test recovery",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_reset",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/ResetInstance",
      "method": "POST",
      "summary": "Reset an instance to a test snapshot",
      "description": "",
      "category": "instance"
    },
    {
      "id": "instance_adopt",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/AdoptInstance",
      "method": "POST",
      "summary": "Prepare an operator-owned VPS adoption",
      "description": "Stores a non-secret target record and an explicit declared monthly quote through shared spend admission. Region, offer identity and owner identity are server-derived from the verified human caller. This call never accepts the SSH credential and remains pending until the secure Onboarding and Bridge first-touch evidence is verified.",
      "category": "instance",
      "request": {
        "type": "object",
        "properties": {
          "currency": "string (required; ISO 4217 alpha code)",
          "display_name": "string (optional)",
          "host": "string (required; hostname or IP)",
          "idempotency_key": "string (required; stable across retry)",
          "monthly_cost_minor": "int64 (required; explicitly operator-declared monthly total in minor units)",
          "tax_basis": "string (required; pre-tax or tax-inclusive)",
          "user": "string (required; SSH user)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "instance": "Instance; adoption_state remains awaiting_secret until verified",
          "spend_receipt": "Persisted line items, source, freshness and cap decision"
        }
      }
    },
    {
      "id": "instance_adoption_first_touch",
      "path": "/vrooli.compute_manager.v1.instance.InstanceService/SubmitAdoptionCredential",
      "method": "POST",
      "summary": "Submit a one-time adopted-VPS credential through Onboarding",
      "description": "Restricted to the dedicated Compute Manager adopted-VPS first-touch service principal. Forwards the request-scoped SSH password to Bridge and returns only persisted lifecycle and read-back evidence. The credential is never persisted or included in a response.",
      "category": "instance",
      "request": {
        "type": "object",
        "properties": {
          "idempotency_key": "string (required; independent random key, not derived from the credential)",
          "instance_id": "string (required)",
          "ssh_password": "bytes (write-only, transient)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "evidence_verified": "boolean; true only after exact Bridge success read-back",
          "instance": "Persisted adoption record and Bridge evidence status"
        }
      }
    },
    {
