        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET serving opaque image bytes to a browser <img>/download; no generated client applies and the body is binary, not proto.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
