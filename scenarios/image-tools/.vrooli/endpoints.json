{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "image-tools status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "jobs_get",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/GetJob",
      "method": "POST",
      "summary": "Get a job by id",
      "description": "Returns the current durable-job record for one job id.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Get a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/GetJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_wait",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WaitJob",
      "method": "POST",
      "summary": "Wait for a job (block-once)",
      "description": "Blocks server-side until the job reaches a terminal state, then returns it. A client disconnect does not affect the job. This is the canonical wait verb — never poll GetJob in a loop.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job (terminal)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Wait for a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WaitJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs wait",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_list",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/ListJobs",
      "method": "POST",
      "summary": "List recent jobs",
      "description": "Returns recent durable jobs, newest first.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (0 = server default)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "jobs": "array<Job>"
        }
      },
      "examples": [
        {
          "name": "List jobs",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/ListJobs -H 'Content-Type: application/json' -d '{\"limit\":20}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs list",
        "args": [
          "--limit",
          "<n>"
        ]
      }
    },
    {
      "id": "jobs_cancel",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/CancelJob",
      "method": "POST",
      "summary": "Cancel a job",
      "description": "Aborts a job: a running job's context is canceled; a queued job is marked canceled immediately. Returns the post-cancel record.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Cancel a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/CancelJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs cancel",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_watch",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WatchJob",
      "method": "POST",
      "summary": "Watch a job's progress (server stream)",
      "description": "Server-streams progress events for a job until it reaches a terminal state. The latest known event is replayed first. Backs SSE-style live progress in the UI.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "stream",
        "properties": {
          "event": "ProgressEvent (stream)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Watch a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WatchJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs watch",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_list",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListModels",
      "method": "POST",
      "summary": "List models",
      "description": "Returns model registry entries, optionally filtered to one operation, with effective (overlay-aware) enabled state.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "operation": "string (optional; filter to one op)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "models": "array<Model>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation filter"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "List all models",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListModels -H 'Content-Type: application/json' -d '{}'"
        },
        {
          "name": "List upscale models",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListModels -H 'Content-Type: application/json' -d '{\"operation\":\"upscale\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models list",
        "args": [
          "--operation",
          "<op>"
        ]
      }
    },
    {
      "id": "models_get",
      "path": "/vrooli.image_tools.v1.models.ModelsService/GetModel",
      "method": "POST",
      "summary": "Get a model by id",
      "description": "Returns one model registry entry by id with effective enabled state.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model": "Model"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "Get a model",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/GetModel -H 'Content-Type: application/json' -d '{\"id\":\"sd-1.5\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_operations",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListOperations",
      "method": "POST",
      "summary": "List operations",
      "description": "Returns the registry operation vocabulary in declaration order.",
      "category": "models",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<string>"
        }
      },
      "examples": [
        {
          "name": "List operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models operations"
      }
    },
    {
      "id": "models_select",
      "path": "/vrooli.image_tools.v1.models.ModelsService/SelectModel",
      "method": "POST",
      "summary": "Preview model selection for an operation",
      "description": "Previews which enabled model would run for an operation on the probed host (honoring the per-op default and any override) without executing. Surfaces the hardware-fit reason and warnings.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "operation": "string (required; registry op)",
          "override_id": "string (optional; force a model id)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "gpu_viable": "bool",
          "model": "Model",
          "reason": "string",
          "warnings": "array<string>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation or invalid override"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "No enabled model can run for the operation on this host"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Host probe or model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "Select for upscale",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/SelectModel -H 'Content-Type: application/json' -d '{\"operation\":\"upscale\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models select",
        "args": [
          "<operation>",
          "--override",
          "<id>"
        ]
      }
    },
    {
      "id": "models_set_enabled",
      "path": "/vrooli.image_tools.v1.models.ModelsService/SetModelEnabled",
      "method": "POST",
      "summary": "Enable or disable a model",
      "description": "Toggles a model's runtime-enabled state, persisted in the SQLite overlay over the read-only seed catalog.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "enabled": "bool",
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model": "Model"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Enable a quality tier",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/SetModelEnabled -H 'Content-Type: application/json' -d '{\"id\":\"real-esrgan\",\"enabled\":true}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models enable",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_blocklist",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListBlocklist",
      "method": "POST",
      "summary": "List blocklisted models",
      "description": "Returns the license-encumbered models that must never be seeded or adopted, with the reason each is excluded.",
      "category": "models",
      "response": {
        "type": "object",
        "properties": {
          "entries": "array<BlocklistEntry>"
        }
      },
      "examples": [
        {
          "name": "List blocklist",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListBlocklist -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models blocklist"
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "jobs get",
      "description": "Get a durable job by id",
      "endpoint_id": "jobs_get"
    },
    {
      "name": "jobs wait",
      "description": "Block once until a job is terminal, then print it (no polling)",
      "endpoint_id": "jobs_wait"
    },
    {
      "name": "jobs list",
      "description": "List recent jobs, newest first (--limit N)",
      "endpoint_id": "jobs_list"
    },
    {
      "name": "jobs cancel",
      "description": "Cancel a running or queued job",
      "endpoint_id": "jobs_cancel"
    },
    {
      "name": "jobs watch",
      "description": "Stream a job's progress until it reaches a terminal state",
      "endpoint_id": "jobs_watch"
    },
    {
      "name": "models list",
      "description": "List model registry entries (--operation OP to filter)",
      "endpoint_id": "models_list"
    },
    {
      "name": "models get",
      "description": "Get a model registry entry by id",
      "endpoint_id": "models_get"
    },
    {
      "name": "models operations",
      "description": "List the registry operation vocabulary",
      "endpoint_id": "models_operations"
    },
    {
      "name": "models select",
      "description": "Preview which model would run for an operation on this host (--override ID)",
      "endpoint_id": "models_select"
    },
    {
      "name": "models enable",
      "description": "Enable or disable a model (persisted overlay over the seed catalog)",
      "endpoint_id": "models_set_enabled"
    },
    {
      "name": "models blocklist",
      "description": "List license-encumbered models excluded from the catalog",
      "endpoint_id": "models_blocklist"
    }
  ]
}
