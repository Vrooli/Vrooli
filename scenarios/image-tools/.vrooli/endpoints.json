{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.health.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "transport": "none",
            "conformance": "none"
          }
        }
      }
    },
    {
      "id": "ai_list_operations",
      "path": "/vrooli.image_tools.v1.ai.AIService/ListAIOperations",
      "method": "POST",
      "summary": "List AI generation & enhancement operations",
      "description": "Returns the model-backed operation catalog (which ops need an input image, which need a mask, which are prompt-driven) plus each op's seeded default model.",
      "category": "ai",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<AIOperationInfo>"
        }
      },
      "examples": [
        {
          "name": "List AI operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.ai.AIService/ListAIOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "ai_submit",
      "path": "/api/v1/ai/{operation}",
      "method": "POST",
      "summary": "Submit a model-backed AI operation",
      "description": "Submits one AI generation/enhancement op on optionally-uploaded image(s). The `file` part carries the input image (when required), `mask` carries a mask (inpaint/object_removal), and `params` carries AIParams as protojson. The op runs asynchronously on the durable job queue: the response (SubmitAIResponse) carries the job id + ETA + the resolved model/tier + any fallback warnings. Wait via the jobs verbs and fetch the output blob by the job's result ref.",
      "category": "ai",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form, missing required image/mask part, or invalid params"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown AI operation"
        },
        {
          "status": 409,
          "code": "invalid_request",
          "description": "Selected model is not installed (run `image-tools models install <id>`)"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "Image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "No enabled model fits this host, or the model override is invalid"
        },
        {
          "status": 503,
          "code": "internal",
          "description": "No standalone backend is available and BYOK is not enabled"
        }
      ],
      "examples": [
        {
          "name": "Generate from a prompt",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/ai/text_to_image' -F 'params={\"prompt\":\"a red bicycle\",\"width\":512,\"height\":512}'"
        },
        {
          "name": "Upscale an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/ai/upscale' -F file=@in.png -F 'params={\"scale\":4}'"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Image/mask bytes cannot ride a proto field; the request is multipart (file + mask + protojson params). Parameters stay proto-typed (AIParams) and the submit result is proto-typed (SubmitAIResponse).",
        "proto_payloads": {
          "request": {
            "proto_full_name": "vrooli.image_tools.v1.ai.AIParams",
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.ai.SubmitAIResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "analysis_list_operations",
      "path": "/vrooli.image_tools.v1.analysis.AnalysisService/ListAnalysisOperations",
      "method": "POST",
      "summary": "List image→data analysis operations",
      "description": "Returns the analysis operation catalog (ocr, nsfw_classify, probe) with each op's model-backing and default model.",
      "category": "analysis",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<AnalysisOperationInfo>"
        }
      },
      "examples": [
        {
          "name": "List analysis operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.analysis.AnalysisService/ListAnalysisOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "analysis_run",
      "path": "/api/v1/analysis/{operation}",
      "method": "POST",
      "summary": "Run an analysis operation on an uploaded image",
      "description": "Executes one analysis op (ocr / nsfw_classify / probe) on a multipart-uploaded image. The `file` part carries the image bytes; the structured result is returned as AnalyzeResponse (protojson). `probe` is pure-Go and always available; `ocr`/`nsfw_classify` require their backend + model installed.",
      "category": "analysis",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form or missing image part"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown analysis operation"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "Image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "Undecodable image"
        },
        {
          "status": 503,
          "code": "internal",
          "description": "Model-backed op's backend/model is not installed"
        }
      ],
      "examples": [
        {
          "name": "Probe an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/analysis/probe' -F file=@in.png"
        },
        {
          "name": "OCR an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/analysis/ocr' -F file=@scan.png"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Image bytes cannot ride a proto field; the request is multipart. The result metadata is proto-typed (AnalyzeResponse).",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.analysis.AnalyzeResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "diff_list_modes",
      "path": "/vrooli.image_tools.v1.diff.DiffService/ListDiffModes",
      "method": "POST",
      "summary": "List image-comparison modes",
      "description": "Returns the comparison modes the diff engine supports (pixel, perceptual), each with a one-line summary. Pure discovery (executes nothing).",
      "category": "diff",
      "response": {
        "type": "object",
        "properties": {
          "modes": "array<DiffModeInfo>"
        }
      },
      "examples": [
        {
          "name": "List diff modes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.diff.DiffService/ListDiffModes -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "diff_compare",
      "path": "/api/v1/diff/compare",
      "method": "POST",
      "summary": "Compare two images (pixel + perceptual diff)",
      "description": "Compares two uploaded images and returns DiffResult: a headline verdict, pixel metrics (changed-pixel fraction + MAE/RMSE/PSNR), perceptual metrics (pHash distance + structural similarity), and a heat-map overlay blob highlighting the changed regions. Pure-Go, no model — runs on any host. The `base` and `compare` parts carry the images; the `params` part carries DiffParams (protojson).",
      "category": "diff",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form, missing base/compare image part, or invalid params"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "An image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "An undecodable image"
        }
      ],
      "examples": [
        {
          "name": "Pixel-diff two images",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/diff/compare' -F base=@a.png -F compare=@b.png"
        },
        {
          "name": "Perceptual same-picture check",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/diff/compare' -F base=@a.png -F compare=@b.jpg -F 'params={\"mode\":\"DIFF_MODE_PERCEPTUAL\"}'"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Two image payloads cannot ride proto fields; the request is multipart. The result metadata is proto-typed (DiffResult).",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.diff.DiffResult",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "jobs_get",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/GetJob",
      "method": "POST",
      "summary": "Get a job by id",
      "description": "Returns the current durable-job record for one job id.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Get a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/GetJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ]
    },
    {
      "id": "jobs_wait",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WaitJob",
      "method": "POST",
      "summary": "Wait for a job (block-once)",
      "description": "Blocks server-side until the job reaches a terminal state, then returns it. A client disconnect does not affect the job. This is the canonical wait verb — never poll GetJob in a loop.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job (terminal)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Wait for a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WaitJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ]
    },
    {
      "id": "jobs_list",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/ListJobs",
      "method": "POST",
      "summary": "List recent jobs",
      "description": "Returns recent durable jobs, newest first.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (0 = server default)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "jobs": "array<Job>"
        }
      },
      "examples": [
        {
          "name": "List jobs",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/ListJobs -H 'Content-Type: application/json' -d '{\"limit\":20}'"
        }
      ]
    },
    {
      "id": "jobs_cancel",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/CancelJob",
      "method": "POST",
      "summary": "Cancel a job",
      "description": "Aborts a job: a running job's context is canceled; a queued job is marked canceled immediately. Returns the post-cancel record.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Cancel a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/CancelJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ]
    },
    {
      "id": "jobs_watch",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WatchJob",
      "method": "POST",
      "summary": "Watch a job's progress (server stream)",
      "description": "Server-streams progress events for a job until it reaches a terminal state. The latest known event is replayed first. Backs SSE-style live progress in the UI.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "stream",
        "properties": {
          "event": "ProgressEvent (stream)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Watch a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WatchJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ]
    },
    {
      "id": "looks_list",
      "path": "/vrooli.image_tools.v1.looks.LooksService/ListLooks",
      "method": "POST",
      "summary": "List Looks",
      "description": "Returns the Look/Style library (built-in + custom), optionally filtered by kind, built-ins first.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "kind": "LookKind (optional filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "looks": "array<Look>"
        }
      },
      "examples": [
        {
          "name": "List all Looks",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/ListLooks -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "looks_get",
      "path": "/vrooli.image_tools.v1.looks.LooksService/GetLook",
      "method": "POST",
      "summary": "Get a Look by id",
      "description": "Returns one Look (built-in or custom) by id.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "look": "Look"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No Look with that id"
        }
      ],
      "examples": [
        {
          "name": "Get the Noir look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/GetLook -H 'Content-Type: application/json' -d '{\"id\":\"noir\"}'"
        }
      ]
    },
    {
      "id": "looks_create",
      "path": "/vrooli.image_tools.v1.looks.LooksService/CreateLook",
      "method": "POST",
      "summary": "Create a custom Look",
      "description": "Persists a new custom Look. The id is slugified from the name when empty and must not collide with a built-in or existing custom Look.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "look": "Look (name + steps required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "look": "Look"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing name/steps or an unknown step operation"
        },
        {
          "status": 409,
          "code": "already_exists",
          "description": "Id collides with a built-in or existing custom Look"
        }
      ],
      "examples": [
        {
          "name": "Create a sepia Look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/CreateLook -H 'Content-Type: application/json' -d '{\"look\":{\"name\":\"Sepia\",\"kind\":\"LOOK_KIND_FILM\",\"steps\":[{\"operation\":\"filter\",\"kind\":\"STEP_KIND_DETERMINISTIC\",\"params\":{\"filter\":\"sepia\"}}]}}'"
        }
      ]
    },
    {
      "id": "looks_update",
      "path": "/vrooli.image_tools.v1.looks.LooksService/UpdateLook",
      "method": "POST",
      "summary": "Update a custom Look",
      "description": "Replaces a custom Look's mutable fields. Built-in Looks are read-only.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "look": "Look (id required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "look": "Look"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "failed_precondition",
          "description": "The Look is a read-only built-in"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No custom Look with that id"
        }
      ],
      "examples": [
        {
          "name": "Rename a custom Look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/UpdateLook -H 'Content-Type: application/json' -d '{\"look\":{\"id\":\"sepia\",\"name\":\"Warm Sepia\",\"steps\":[{\"operation\":\"filter\",\"kind\":\"STEP_KIND_DETERMINISTIC\",\"params\":{\"filter\":\"sepia\"}}]}}'"
        }
      ]
    },
    {
      "id": "looks_delete",
      "path": "/vrooli.image_tools.v1.looks.LooksService/DeleteLook",
      "method": "POST",
      "summary": "Delete a custom Look",
      "description": "Removes a custom Look. Built-in Looks cannot be deleted.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "deleted": "bool"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "failed_precondition",
          "description": "The Look is a read-only built-in"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No custom Look with that id"
        }
      ],
      "examples": [
        {
          "name": "Delete a custom Look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/DeleteLook -H 'Content-Type: application/json' -d '{\"id\":\"sepia\"}'"
        }
      ]
    },
    {
      "id": "looks_compile",
      "path": "/vrooli.image_tools.v1.looks.LooksService/CompileLook",
      "method": "POST",
      "summary": "Compile a Look into request shapes",
      "description": "Resolves a Look + subject/prompt into the ordered concrete op/AI request shapes (prompt template filled, params merged). The compose-seam; executes nothing.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "has_input": "bool",
          "look_id": "string",
          "prompt": "string",
          "subject": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "primary_prompt": "string",
          "requires_image": "bool",
          "requires_mask": "bool",
          "steps": "array<CompiledStep>",
          "warnings": "array<string>"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No Look with that id"
        }
      ],
      "examples": [
        {
          "name": "Compile the Anime look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/CompileLook -H 'Content-Type: application/json' -d '{\"look_id\":\"anime\",\"subject\":\"a golden retriever\",\"has_input\":true}'"
        }
      ]
    },
    {
      "id": "looks_render_preview",
      "path": "/vrooli.image_tools.v1.looks.LooksService/RenderPreview",
      "method": "POST",
      "summary": "Render a Look's preview thumbnail",
      "description": "Applies the Look's deterministic step chain to a built-in reference image, stores the preview as a blob, and (for custom Looks) records its thumbnail_ref. AI steps are deferred and reported.",
      "category": "looks",
      "request": {
        "type": "object",
        "properties": {
          "look_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "deferred_steps": "array<string>",
          "thumbnail_ref": "string (blob key)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No Look with that id"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Preview storage is not configured"
        }
      ],
      "examples": [
        {
          "name": "Preview the Polaroid look",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.looks.LooksService/RenderPreview -H 'Content-Type: application/json' -d '{\"look_id\":\"polaroid-600\"}'"
        }
      ]
    },
    {
      "id": "models_list",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListModels",
      "method": "POST",
      "summary": "List models",
      "description": "Returns model registry entries, optionally filtered to one operation, with effective (overlay-aware) enabled state.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "operation": "string (optional; filter to one op)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "models": "array<Model>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation filter"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "List all models",
