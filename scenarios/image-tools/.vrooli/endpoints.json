{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "image-tools status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.health.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "transport": "none",
            "conformance": "none"
          }
        }
      }
    },
    {
      "id": "ai_list_operations",
      "path": "/vrooli.image_tools.v1.ai.AIService/ListAIOperations",
      "method": "POST",
      "summary": "List AI generation & enhancement operations",
      "description": "Returns the model-backed operation catalog (which ops need an input image, which need a mask, which are prompt-driven) plus each op's seeded default model.",
      "category": "ai",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<AIOperationInfo>"
        }
      },
      "examples": [
        {
          "name": "List AI operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.ai.AIService/ListAIOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools ai list"
      }
    },
    {
      "id": "ai_submit",
      "path": "/api/v1/ai/{operation}",
      "method": "POST",
      "summary": "Submit a model-backed AI operation",
      "description": "Submits one AI generation/enhancement op on optionally-uploaded image(s). The `file` part carries the input image (when required), `mask` carries a mask (inpaint/object_removal), and `params` carries AIParams as protojson. The op runs asynchronously on the durable job queue: the response (SubmitAIResponse) carries the job id + ETA + the resolved model/tier + any fallback warnings. Wait via the jobs verbs and fetch the output blob by the job's result ref.",
      "category": "ai",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form, missing required image/mask part, or invalid params"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown AI operation"
        },
        {
          "status": 409,
          "code": "invalid_request",
          "description": "Selected model is not installed (run `image-tools models install <id>`)"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "Image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "No enabled model fits this host, or the model override is invalid"
        },
        {
          "status": 503,
          "code": "internal",
          "description": "No standalone backend is available and BYOK is not enabled"
        }
      ],
      "examples": [
        {
          "name": "Generate from a prompt",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/ai/text_to_image' -F 'params={\"prompt\":\"a red bicycle\",\"width\":512,\"height\":512}'"
        },
        {
          "name": "Upscale an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/ai/upscale' -F file=@in.png -F 'params={\"scale\":4}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools ai generate",
        "args": [
          "--prompt",
          "<prompt>",
          "--out",
          "<output>"
        ]
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Image/mask bytes cannot ride a proto field; the request is multipart (file + mask + protojson params). Parameters stay proto-typed (AIParams) and the submit result is proto-typed (SubmitAIResponse).",
        "proto_payloads": {
          "request": {
            "proto_full_name": "vrooli.image_tools.v1.ai.AIParams",
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.ai.SubmitAIResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "analysis_list_operations",
      "path": "/vrooli.image_tools.v1.analysis.AnalysisService/ListAnalysisOperations",
      "method": "POST",
      "summary": "List image→data analysis operations",
      "description": "Returns the analysis operation catalog (ocr, nsfw_classify, probe) with each op's model-backing and default model.",
      "category": "analysis",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<AnalysisOperationInfo>"
        }
      },
      "examples": [
        {
          "name": "List analysis operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.analysis.AnalysisService/ListAnalysisOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools analyze list"
      }
    },
    {
      "id": "analysis_run",
      "path": "/api/v1/analysis/{operation}",
      "method": "POST",
      "summary": "Run an analysis operation on an uploaded image",
      "description": "Executes one analysis op (ocr / nsfw_classify / probe) on a multipart-uploaded image. The `file` part carries the image bytes; the structured result is returned as AnalyzeResponse (protojson). `probe` is pure-Go and always available; `ocr`/`nsfw_classify` require their backend + model installed.",
      "category": "analysis",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form or missing image part"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown analysis operation"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "Image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "Undecodable image"
        },
        {
          "status": 503,
          "code": "internal",
          "description": "Model-backed op's backend/model is not installed"
        }
      ],
      "examples": [
        {
          "name": "Probe an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/analysis/probe' -F file=@in.png"
        },
        {
          "name": "OCR an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/analysis/ocr' -F file=@scan.png"
        }
      ],
      "cli_mapping": {
        "command": "image-tools analyze probe",
        "args": [
          "<input>"
        ]
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Image bytes cannot ride a proto field; the request is multipart. The result metadata is proto-typed (AnalyzeResponse).",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.analysis.AnalyzeResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "jobs_get",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/GetJob",
      "method": "POST",
      "summary": "Get a job by id",
      "description": "Returns the current durable-job record for one job id.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Get a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/GetJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_wait",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WaitJob",
      "method": "POST",
      "summary": "Wait for a job (block-once)",
      "description": "Blocks server-side until the job reaches a terminal state, then returns it. A client disconnect does not affect the job. This is the canonical wait verb — never poll GetJob in a loop.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job (terminal)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Wait for a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WaitJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs wait",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_list",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/ListJobs",
      "method": "POST",
      "summary": "List recent jobs",
      "description": "Returns recent durable jobs, newest first.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (0 = server default)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "jobs": "array<Job>"
        }
      },
      "examples": [
        {
          "name": "List jobs",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/ListJobs -H 'Content-Type: application/json' -d '{\"limit\":20}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs list",
        "args": [
          "--limit",
          "<n>"
        ]
      }
    },
    {
      "id": "jobs_cancel",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/CancelJob",
      "method": "POST",
      "summary": "Cancel a job",
      "description": "Aborts a job: a running job's context is canceled; a queued job is marked canceled immediately. Returns the post-cancel record.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "job": "Job"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Cancel a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/CancelJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs cancel",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "jobs_watch",
      "path": "/vrooli.image_tools.v1.jobs.JobsService/WatchJob",
      "method": "POST",
      "summary": "Watch a job's progress (server stream)",
      "description": "Server-streams progress events for a job until it reaches a terminal state. The latest known event is replayed first. Backs SSE-style live progress in the UI.",
      "category": "jobs",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "stream",
        "properties": {
          "event": "ProgressEvent (stream)"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No job with that id exists"
        }
      ],
      "examples": [
        {
          "name": "Watch a job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.jobs.JobsService/WatchJob -H 'Content-Type: application/json' -d '{\"id\":\"<job-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools jobs watch",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_list",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListModels",
      "method": "POST",
      "summary": "List models",
      "description": "Returns model registry entries, optionally filtered to one operation, with effective (overlay-aware) enabled state.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "operation": "string (optional; filter to one op)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "models": "array<Model>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation filter"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "List all models",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListModels -H 'Content-Type: application/json' -d '{}'"
        },
        {
          "name": "List upscale models",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListModels -H 'Content-Type: application/json' -d '{\"operation\":\"upscale\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models list",
        "args": [
          "--operation",
          "<op>"
        ]
      }
    },
    {
      "id": "models_get",
      "path": "/vrooli.image_tools.v1.models.ModelsService/GetModel",
      "method": "POST",
      "summary": "Get a model by id",
      "description": "Returns one model registry entry by id with effective enabled state.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model": "Model"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "Get a model",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/GetModel -H 'Content-Type: application/json' -d '{\"id\":\"sd-1.5\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_operations",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListOperations",
      "method": "POST",
      "summary": "List operations",
      "description": "Returns the registry operation vocabulary in declaration order.",
      "category": "models",
      "response": {
        "type": "object",
        "properties": {
          "operations": "array<string>"
        }
      },
      "examples": [
        {
          "name": "List operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models operations"
      }
    },
    {
      "id": "models_select",
      "path": "/vrooli.image_tools.v1.models.ModelsService/SelectModel",
      "method": "POST",
      "summary": "Preview model selection for an operation",
      "description": "Previews which enabled model would run for an operation on the probed host (honoring the per-op default and any override) without executing. Surfaces the hardware-fit reason and warnings.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "operation": "string (required; registry op)",
          "override_id": "string (optional; force a model id)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "gpu_viable": "bool",
          "model": "Model",
          "reason": "string",
          "warnings": "array<string>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation or invalid override"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "No enabled model can run for the operation on this host"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Host probe or model-state load failure"
        }
      ],
      "examples": [
        {
          "name": "Select for upscale",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/SelectModel -H 'Content-Type: application/json' -d '{\"operation\":\"upscale\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models select",
        "args": [
          "<operation>",
          "--override",
          "<id>"
        ]
      }
    },
    {
      "id": "models_set_enabled",
      "path": "/vrooli.image_tools.v1.models.ModelsService/SetModelEnabled",
      "method": "POST",
      "summary": "Enable or disable a model",
      "description": "Toggles a model's runtime-enabled state, persisted in the SQLite overlay over the read-only seed catalog.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "enabled": "bool",
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model": "Model"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Model-state persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Enable a quality tier",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/SetModelEnabled -H 'Content-Type: application/json' -d '{\"id\":\"real-esrgan\",\"enabled\":true}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models enable",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_blocklist",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListBlocklist",
      "method": "POST",
      "summary": "List blocklisted models",
      "description": "Returns the license-encumbered models that must never be seeded or adopted, with the reason each is excluded.",
      "category": "models",
      "response": {
        "type": "object",
        "properties": {
          "entries": "array<BlocklistEntry>"
        }
      },
      "examples": [
        {
          "name": "List blocklist",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListBlocklist -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models blocklist"
      }
    },
    {
      "id": "models_install",
      "path": "/vrooli.image_tools.v1.models.ModelsService/InstallModel",
      "method": "POST",
      "summary": "Install (download) a model",
      "description": "Downloads a model's weights as a durable job (checksum pinned on first download, free disk space checked first). Returns a job id + ETA; block once on jobs wait. An already-installed model returns already_installed=true with no job.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "already_installed": "bool",
          "eta_seconds": "int",
          "job_id": "string (empty when already installed)",
          "size_mb_approx": "int"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Install job submission failure"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Installation unavailable (read-only wiring)"
        }
      ],
      "examples": [
        {
          "name": "Install sd-1.5",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/InstallModel -H 'Content-Type: application/json' -d '{\"id\":\"sd-1.5\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models install",
        "args": [
          "<id>",
          "--wait"
        ]
      }
    },
    {
      "id": "models_remove",
      "path": "/vrooli.image_tools.v1.models.ModelsService/RemoveModel",
      "method": "POST",
      "summary": "Remove a model's weights",
      "description": "Deletes a model's downloaded weights and clears its install record. A custom local model is unlinked; its referenced path is never deleted.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "removed": "bool"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Weight removal failure"
        }
      ],
      "examples": [
        {
          "name": "Remove sd-1.5",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/RemoveModel -H 'Content-Type: application/json' -d '{\"id\":\"sd-1.5\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models remove",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "models_add_custom",
      "path": "/vrooli.image_tools.v1.models.ModelsService/AddCustomModel",
      "method": "POST",
      "summary": "Register a custom/local model",
      "description": "Registers a custom or fine-tuned local model merged on top of the read-only seed. The id must not collide with a seed model; a declared local path is verified to exist.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "download_url": "string (optional; remote source when local_path empty)",
          "local_path": "string (optional; local weights — installed by reference)",
          "model": "Model (id, operations, backend required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model": "Model"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id, seed-id collision, or missing local path"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Custom-entry persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Register a local upscaler",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/AddCustomModel -H 'Content-Type: application/json' -d '{\"model\":{\"id\":\"my-upscaler\",\"operations\":[\"upscale\"],\"backend\":\"onnxruntime\"},\"local_path\":\"/data/models/my-upscaler\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools models add-custom",
        "args": [
          "<id>",
          "--operation",
          "<op>",
          "--local-path",
          "<path>"
        ]
      }
    },
    {
      "id": "models_set_default",
      "path": "/vrooli.image_tools.v1.models.ModelsService/SetDefaultModel",
      "method": "POST",
      "summary": "Pin the default model for an operation",
      "description": "Pins (or clears, with empty model_id) the default model for an operation. Selection applies the pin when a request gives no explicit override.",
      "category": "models",
      "request": {
        "type": "object",
        "properties": {
          "model_id": "string (empty clears the pin)",
          "operation": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "model_id": "string",
          "operation": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown operation or model does not serve it"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No model with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Default persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Pin upscale default",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/SetDefaultModel -H 'Content-Type: application/json' -d '{\"operation\":\"upscale\",\"model_id\":\"real-esrgan\"}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools settings set-default",
        "args": [
          "<operation>",
          "<id>"
        ]
      }
    },
    {
      "id": "models_list_defaults",
      "path": "/vrooli.image_tools.v1.models.ModelsService/ListDefaults",
      "method": "POST",
      "summary": "List per-operation default models",
      "description": "Returns the effective default model per operation, marking whether it comes from the seed or an operator pin.",
      "category": "models",
      "response": {
        "type": "object",
        "properties": {
          "defaults": "array<OpDefault>"
        }
      },
      "examples": [
        {
          "name": "List defaults",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.models.ModelsService/ListDefaults -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools settings list"
      }
    },
    {
      "id": "ops_list_operations",
      "path": "/vrooli.image_tools.v1.ops.OpsService/ListOperations",
      "method": "POST",
      "summary": "List deterministic operations",
      "description": "Returns the deterministic operation catalog plus the formats the codec layer can decode and encode.",
      "category": "ops",
      "response": {
        "type": "object",
        "properties": {
          "decodable_formats": "array<string>",
          "encodable_formats": "array<string>",
          "operations": "array<OperationInfo>"
        }
      },
      "examples": [
        {
          "name": "List operations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.image_tools.v1.ops.OpsService/ListOperations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "image-tools ops list"
      }
    },
    {
      "id": "ops_run",
      "path": "/api/v1/ops/{operation}",
      "method": "POST",
      "summary": "Run a deterministic operation on an uploaded image",
      "description": "Executes one deterministic operation on a multipart-uploaded image. The `file` part carries the image bytes; the `params` part carries OpParams as protojson; an optional `overlay` part carries a watermark image. `output=bytes` (default) streams the result; `output=blob` returns RunOpResponse JSON; a `path` query writes the result to a caller-owned host path.",
      "category": "ops",
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Malformed multipart form, missing image part, or invalid params"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown operation"
        },
        {
          "status": 413,
          "code": "invalid_request",
          "description": "Image exceeds the ingest byte limit"
        },
        {
          "status": 422,
          "code": "invalid_request",
          "description": "Undecodable image or invalid operation parameters"
        }
      ],
      "examples": [
        {
          "name": "Resize an image",
          "curl": "curl -X POST 'http://localhost:${API_PORT}/api/v1/ops/resize?output=bytes' -F file=@in.png -F 'params={\"resize\":{\"width\":256}}' -o out.png"
        }
      ],
      "cli_mapping": {
        "command": "image-tools ops resize",
        "args": [
          "<input>",
          "--out",
          "<output>"
        ]
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Image bytes cannot ride a proto field; the request is multipart (file + protojson params). Parameters stay proto-typed (OpParams) and the result metadata is proto-typed (RunOpResponse).",
        "proto_payloads": {
          "request": {
            "proto_full_name": "vrooli.image_tools.v1.ops.OpParams",
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.image_tools.v1.ops.RunOpResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "ops_blob_get",
      "path": "/api/v1/blobs/{key}",
      "method": "GET",
      "summary": "Fetch a result blob",
      "description": "Serves the bytes of a managed result blob by key. Browser-facing binary fetch with no generated client; used by the UI to display op inputs/outputs.",
      "category": "ops",
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No blob with that key"
        }
      ],
      "examples": [
        {
          "name": "Fetch a blob",
          "curl": "curl http://localhost:${API_PORT}/api/v1/blobs/out/<id>.png -o out.png"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET serving opaque image bytes to a browser <img>/download; no generated client applies and the body is binary, not proto.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "proto_full_name": "vrooli.image_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    }
  ]
}
