{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "architecture-cartographer",
  "description": "Architecture Cartographer CLI surface. Schema-validated against cli-manifest/v1 and cross-validated against the per-domain Connect-RPC proto descriptors at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "domains",
      "description": "Derive a scenario's intended domain map from its on-disk sources (zero-config)",
      "commands": [
        {
          "name": "extract",
          "description": "Derive the domain map for a scenario from the extraction ladder",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DomainsService",
            "method": "ExtractDomains"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        },
        {
          "name": "show",
          "description": "Show the derived domain map for a scenario",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DomainsService",
            "method": "GetDomainMap"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        },
        {
          "name": "convergence",
          "description": "Report where a scenario's surfaces disagree on the domain set (advisory)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DomainsService",
            "method": "ConvergenceReport"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        }
      ]
    },
    {
      "name": "graph",
      "description": "Extract architecture graphs by composing language code-graph adapters",
      "commands": [
        {
          "name": "extract",
          "description": "Extract a normalized cross-language graph for a target scenario",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name (e.g., 'go-code-graph')"
            }
          ],
          "flags": [
            {
              "name": "idempotency-key",
              "description": "Idempotency-Key passthrough for caller-controlled dedupe"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "ExtractGraph"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        }
      ]
    },
    {
      "name": "audit",
      "description": "Run a CI-shaped drift audit — orchestrates graph extract (if needed), domains derivation, and conflicts detection, then maps the outcome to a process exit code",
      "commands": [
        {
          "name": "run",
          "description": "Audit a scenario for architectural drift and exit 0 (clean) / 1 (findings ≥ threshold) / 2 (tool error) / 3 (usage error)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "fail-on",
              "description": "Minimum severity that flips outcome to FINDINGS: info | warn (default) | error | blocker"
            },
            {
              "name": "include-types",
              "description": "Comma-separated whitelist of conflict types to include"
            },
            {
              "name": "exclude-types",
              "description": "Comma-separated blacklist of conflict types to exclude"
            },
            {
              "name": "allow-low-authority",
              "bool": true,
              "description": "Treat low/missing authority confidence (no curated DOMAINS.md) as clean; default fails the audit"
            },
            {
              "name": "skip-ts",
              "bool": true,
              "description": "Skip the TypeScript analysis layer; outcome becomes PARTIAL when TS was the only thing skipped (Go findings still drive outcome)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuditService",
            "method": "Run"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        },
        {
          "name": "run-all",
          "description": "Sweep every discoverable scenario and aggregate the audit reports",
          "flags": [
            {
              "name": "fail-on",
              "description": "Per-scenario severity threshold (info | warn | error | blocker)"
            },
            {
              "name": "include-types",
              "description": "Comma-separated whitelist of conflict types"
            },
            {
              "name": "exclude-types",
              "description": "Comma-separated blacklist of conflict types"
            },
            {
              "name": "include-scenarios",
              "description": "Comma-separated whitelist of scenario names"
            },
            {
              "name": "exclude-scenarios",
              "description": "Comma-separated blacklist of scenario names"
            },
            {
              "name": "concurrency",
              "description": "Worker pool size (default 4)"
            },
            {
              "name": "allow-low-authority",
              "bool": true,
              "description": "Treat low authority confidence as clean for every scenario in the sweep"
            },
            {
              "name": "allow-low-authority-scenarios",
              "description": "Comma-separated scenarios for which low/missing authority is treated as clean (per-scenario opt-out; ORed with --allow-low-authority)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuditService",
            "method": "RunAll"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        }
      ]
    },
    {
      "name": "conflicts",
      "description": "Detect, triage, and resolve architecture-drift conflicts — the agent-facing conflict workbench",
      "commands": [
        {
          "name": "detect",
          "description": "Run every registered Detector against a scenario's snapshot + manifest, persist, and list the conflicts",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "snapshot-id",
              "description": "Detect against a specific snapshot id (default: extract a fresh one)"
            },
            {
              "name": "idempotency-key",
              "description": "Idempotency-Key passthrough for caller-controlled dedupe"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "DetectConflicts"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List persisted conflicts for a scenario, filterable by type",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "type",
              "description": "Comma-separated conflict-type filter"
            },
            {
              "name": "page-size",
              "description": "Maximum conflicts to return"
            },
            {
              "name": "page-token",
              "description": "Pagination cursor from a prior response"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "ListConflicts"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "show",
          "description": "Show one persisted conflict with evidence and suggested fixes",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Conflict id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "GetConflict"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "validate",
          "description": "Re-run detection against the current resolution state and report cartographer-clean closure",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "ValidateConflicts"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "detectors",
          "description": "List the registered Detector plug-ins",
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "ListDetectors"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "resolvers",
          "description": "List the registered Resolver plug-ins",
          "binding": {
            "kind": "connect-rpc",
            "service": "ConflictsService",
            "method": "ListResolvers"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "signals",
      "description": "Score chunks, explain aggregator verdicts, and inspect the signal registry",
      "commands": [
        {
          "name": "score",
          "description": "Run every enabled Signal against a file's chunk and show the aggregated verdict",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            },
            {
              "name": "file",
              "required": true,
              "description": "File to score: either a snapshot file id (e.g. \"file:api/...\") or a repo-relative path (e.g. \"api/internal/graph/service.go\")"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SignalsService",
            "method": "ScoreChunk"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "explain",
          "description": "Explain a verdict with the full per-signal evidence breakdown",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            },
            {
              "name": "file",
              "required": true,
              "description": "File to explain: either a snapshot file id or a repo-relative path"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SignalsService",
            "method": "ExplainVerdict"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List registered Signals with default weights and enable/disable state",
          "flags": [
            {
              "name": "scenario",
              "description": "Reflect manifest-overlaid weights for this scenario"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SignalsService",
            "method": "ListSignals"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "boundaries",
          "description": "Show per-domain coupling/boundary-health scores (advisory)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SignalsService",
            "method": "BoundaryHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "analytics",
      "description": "Inspect the append-only analytics log, stats roll-up, placements, and operator overrides",
      "commands": [
        {
          "name": "events",
          "description": "Page the append-only analytics event log for a scenario",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "kind",
              "description": "Comma-separated EventKind filter (e.g. conflict_detected,override_recorded)"
            },
            {
              "name": "since",
              "description": "RFC3339 cutoff; only events at or after this time"
            },
            {
              "name": "page-size",
              "description": "Maximum events to return"
            },
            {
              "name": "page-token",
              "description": "Pagination cursor from a prior response"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AnalyticsService",
            "method": "ListEvents"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "stats",
          "description": "Show the analytics roll-up (verdict-success rate suppressed below the N>=5 threshold)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AnalyticsService",
            "method": "GetStats"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "placements",
          "description": "List placement-outcome rows for a scenario",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "outcome",
              "description": "Comma-separated outcome filter (auto_placed,suggested,overridden,rejected)"
            },
            {
              "name": "page-size",
              "description": "Maximum placements to return"
            },
            {
              "name": "page-token",
              "description": "Pagination cursor from a prior response"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AnalyticsService",
            "method": "ListPlacements"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "override-record",
          "description": "Record an operator override of a verdict",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "chunk-id",
              "required": true,
              "description": "Chunk the override applies to"
            },
            {
              "name": "verdict-domain",
              "required": true,
              "description": "Domain the aggregator recommended"
            },
            {
              "name": "chosen-domain",
              "required": true,
              "description": "Domain the operator chose instead"
            },
            {
              "name": "note",
              "description": "Operator note"
            },
            {
              "name": "verdict-event-id",
              "description": "Pointer to the original verdict_produced event"
            },
            {
              "name": "idempotency-key",
              "description": "Idempotency-Key passthrough for caller-controlled dedupe"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AnalyticsService",
            "method": "RecordOverride"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "apply",
      "description": "Plan and (in a later phase) execute per-domain conflict resolutions. v0.1 plans only; `apply run` is unimplemented.",
      "commands": [
        {
          "name": "plan",
          "description": "Deterministically derive the operation list that would resolve a domain's conflicts (v0.1: read-only, no toolchain)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            },
            {
              "name": "domain",
              "required": true,
              "description": "Domain to plan apply for"
            }
          ],
          "flags": [
            {
              "name": "conflict-id",
              "description": "Comma-separated conflict ids to plan for (default: every conflict assigned to the domain)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "PlanApply"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "run",
          "description": "Execute a planned apply. v0.1 always returns a capability-not-available message (execution lands in the apply-execution plan).",
          "positionals": [
            {
              "name": "plan_id",
              "required": true,
              "description": "Plan id from `apply plan`"
            }
          ],
          "flags": [
            {
              "name": "acknowledge",
              "bool": true,
              "description": "Acknowledge that v0.1 RunApply is unimplemented (reserved for the v0.2 opt-in)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "RunApply"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "history",
          "description": "List apply runs for a scenario (empty in v0.1)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "domain",
              "description": "Filter to one domain"
            },
            {
              "name": "page-size",
              "description": "Maximum runs to return"
            },
            {
              "name": "page-token",
              "description": "Pagination cursor from a prior response"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "ListApplyHistory"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "baseline",
          "description": "Show the toolchain build baseline (empty in v0.1; BuildGuard is unwired)",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "GetBuildBaseline"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "suppress",
          "description": "Write an in-repo // arch:allow marker sanctioning a finding as intentional",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            },
            {
              "name": "file",
              "required": true,
              "description": "Scenario-relative source file to mark"
            },
            {
              "name": "id",
              "required": true,
              "description": "Detector/type/subtype to allow (e.g., cycle, god_domain)"
            }
          ],
          "flags": [
            {
              "name": "reason",
              "required": true,
              "description": "Why this finding is intentional (mandatory)"
            },
            {
              "name": "expires",
              "description": "Optional expiry, e.g. until:2026-12-31"
            },
            {
              "name": "line",
              "description": "Optional 1-based insertion line (default: end of file)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ApplyService",
            "method": "WriteSuppression"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        }
      ]
    },
    {
      "name": "campaign",
      "description": "Track a scenario-improvement effort — ingest a test-genie audit, work the profile-ranked worklist, reconcile re-audits by stable id",
      "commands": [
        {
          "name": "create",
          "description": "Open a campaign for a scenario and ingest findings from a test-genie audit report",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Target scenario name"
            }
          ],
          "flags": [
            {
              "name": "name",
              "description": "Human label for the campaign"
            },
            {
              "name": "from-audit",
              "description": "Path to a test-genie --json SuiteExecutionResult (or - for stdin) whose findings are ingested"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignService",
            "method": "CreateCampaign"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List a scenario's campaigns (newest first), or every campaign when --scenario is omitted",
          "flags": [
            {
              "name": "scenario",
              "description": "Filter to one scenario (omit for all)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignService",
            "method": "ListCampaigns"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "status",
          "description": "Show a campaign's items and progress rollups",
          "positionals": [
            {
              "name": "campaign-id",
              "required": true,
              "description": "Campaign id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignService",
            "method": "GetCampaignStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "next",
          "description": "Show the profile-ranked worklist of open items (fast = cheapest path to green; balanced = legacy regressions→cycles→severity; long-term = structural root-causes first)",
          "positionals": [
            {
              "name": "campaign-id",
              "required": true,
              "description": "Campaign id"
            }
          ],
          "flags": [
            {
              "name": "profile",
              "description": "Ranking profile: fast | balanced (default) | long-term"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CampaignService",
            "method": "NextCampaignStep"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "resolve",
          "description": "Mark an item resolved with an operator note (the agent fixed it by hand)",
          "positionals": [
            {
              "name": "campaign-id",
              "required": true,
              "description": "Campaign id"
            }
          ],
          "flags": [
            {
              "name": "finding",
              "description": "Finding stable id (afid:...)"
            },
            {
              "name": "note",
              "description": "Operator note (recommended)"
            }
          ],
          "binding": {
