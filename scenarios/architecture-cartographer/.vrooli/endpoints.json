{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "analytics.list-events",
      "path": "/vrooli.architecture_cartographer.v1.analytics.AnalyticsService/ListEvents",
      "method": "POST",
      "summary": "List append-only events",
      "description": "Cursor-paginated event log with optional kind + since filters.",
      "category": "analytics"
    },
    {
      "id": "analytics.get-stats",
      "path": "/vrooli.architecture_cartographer.v1.analytics.AnalyticsService/GetStats",
      "method": "POST",
      "summary": "Get stats roll-up",
      "description": "Returns counts + verdict success rate with N<5 suppression.",
      "category": "analytics"
    },
    {
      "id": "analytics.list-placements",
      "path": "/vrooli.architecture_cartographer.v1.analytics.AnalyticsService/ListPlacements",
      "method": "POST",
      "summary": "List placement outcomes",
      "description": "Cursor-paginated placement rows for a scenario.",
      "category": "analytics"
    },
    {
      "id": "analytics.record-override",
      "path": "/vrooli.architecture_cartographer.v1.analytics.AnalyticsService/RecordOverride",
      "method": "POST",
      "summary": "Record an operator override",
      "description": "Appends an Override row. Honors Idempotency-Key and X-Dry-Run.",
      "category": "analytics"
    },
    {
      "id": "apply.plan",
      "path": "/vrooli.architecture_cartographer.v1.apply.ApplyService/PlanApply",
      "method": "POST",
      "summary": "Plan a per-domain apply",
      "description": "Deterministically derives the operation list from resolved/validated conflicts. v0.1 returns the plan envelope; RunApply is unimplemented.",
      "category": "apply"
    },
    {
      "id": "apply.run",
      "path": "/vrooli.architecture_cartographer.v1.apply.ApplyService/RunApply",
      "method": "POST",
      "summary": "Run an apply plan (v0.1: unimplemented)",
      "description": "Executes the supplied plan. v0.1 surfaces CodeUnimplemented; v0.2 wires the executor.",
      "category": "apply"
    },
    {
      "id": "apply.list-history",
      "path": "/vrooli.architecture_cartographer.v1.apply.ApplyService/ListApplyHistory",
      "method": "POST",
      "summary": "List apply runs",
      "description": "Cursor-paginated history of apply runs (empty in v0.1).",
      "category": "apply"
    },
    {
      "id": "apply.get-build-baseline",
      "path": "/vrooli.architecture_cartographer.v1.apply.ApplyService/GetBuildBaseline",
      "method": "POST",
      "summary": "Get the current build baseline",
      "description": "Returns the toolchain build-green snapshot. v0.1 returns an empty baseline.",
      "category": "apply"
    },
    {
      "id": "apply.write-suppression",
      "path": "/vrooli.architecture_cartographer.v1.apply.ApplyService/WriteSuppression",
      "method": "POST",
      "summary": "Write an in-repo suppression marker",
      "description": "Inserts a durable `// arch:allow` marker into a source file, sanctioning a finding as intentional. Safe, non-destructive (comment-only) write.",
      "category": "apply"
    },
    {
      "id": "audit.run",
      "path": "/vrooli.architecture_cartographer.v1.audit.AuditService/Run",
      "method": "POST",
      "summary": "Run a CI-shaped drift audit",
      "description": "Orchestrates graph extract (if needed), domains derivation, and conflicts detection; applies severity / type filters; returns a deterministic summary and exit code mapping.",
      "category": "audit"
    },
    {
      "id": "audit.run-all",
      "path": "/vrooli.architecture_cartographer.v1.audit.AuditService/RunAll",
      "method": "POST",
      "summary": "Sweep every discoverable scenario",
      "description": "Walks scenarios/*/.vrooli/service.json, runs Audit on each, and returns per-scenario reports plus a totals rollup. Honors include_scenarios / exclude_scenarios filters.",
      "category": "audit"
    },
    {
      "id": "validation.validate-scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate architecture posture",
      "description": "Runs the architecture audit in advisory mode and returns the shared scenario-validation response; the native AuditRunResponse is packed into native_detail.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "native_detail": "google.protobuf.Any<architecture_cartographer.v1.audit.AuditRunResponse>",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario is missing or invalid"
        }
      ],
      "examples": [
        {
          "name": "Validate architecture",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"proto-health\"}'"
        }
      ]
    },
    {
      "id": "campaign.create",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/CreateCampaign",
      "method": "POST",
      "summary": "Open a campaign and ingest findings",
      "description": "Opens a tracked scenario-improvement campaign and ingests the initial ArchitectureFinding set (all start detected).",
      "category": "campaign"
    },
    {
      "id": "campaign.list",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/ListCampaigns",
      "method": "POST",
      "summary": "List a scenario's campaigns",
      "description": "Returns the campaign headers for a scenario (newest first), or every campaign when scenario is empty.",
      "category": "campaign"
    },
    {
      "id": "campaign.status",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/GetCampaignStatus",
      "method": "POST",
      "summary": "Get campaign status",
      "description": "Returns the campaign plus every tracked item and rollup counts.",
      "category": "campaign"
    },
    {
      "id": "campaign.next",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/NextCampaignStep",
      "method": "POST",
      "summary": "Get the next worklist chunk",
      "description": "Returns the profile-ranked worklist of open items (fast / balanced / long-term).",
      "category": "campaign"
    },
    {
      "id": "campaign.resolve",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/ResolveItem",
      "method": "POST",
      "summary": "Mark an item resolved",
      "description": "Records that the agent fixed an item by hand, with an operator note.",
      "category": "campaign"
    },
    {
      "id": "campaign.apply",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/ApplyItem",
      "method": "POST",
      "summary": "Apply an item fix (status-only)",
      "description": "Records a hand-fix as a status-only transition. Auto-execution of file-op fixes stays deferred to the apply-execution plan.",
      "category": "campaign"
    },
    {
      "id": "campaign.reaudit",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/ReauditCampaign",
      "method": "POST",
      "summary": "Reconcile a re-audit",
      "description": "Reconciles a fresh findings set against the tracked set by stable id: absent→validated, present→stay, (re)appeared→regression.",
      "category": "campaign"
    },
    {
      "id": "campaign.close",
      "path": "/vrooli.architecture_cartographer.v1.campaign.CampaignService/CloseCampaign",
      "method": "POST",
      "summary": "Close a campaign",
      "description": "Marks the campaign closed.",
      "category": "campaign"
    },
    {
      "id": "conflicts.detect",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/DetectConflicts",
      "method": "POST",
      "summary": "Detect conflicts",
      "description": "Runs every registered Detector against a scenario's graph snapshot + manifest, persists the resulting Conflict envelopes, and emits one analytics event per detection.",
      "category": "conflicts"
    },
    {
      "id": "conflicts.list",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/ListConflicts",
      "method": "POST",
      "summary": "List persisted conflicts",
      "description": "Cursor-paginated list of stored conflicts, filterable by scenario and type.",
      "category": "conflicts"
    },
    {
      "id": "conflicts.get",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/GetConflict",
      "method": "POST",
      "summary": "Get one conflict",
      "description": "Returns the Conflict envelope for the supplied id.",
      "category": "conflicts"
    },
    {
      "id": "conflicts.validate",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/ValidateConflicts",
      "method": "POST",
      "summary": "Validate cartographer-clean closure",
      "description": "Returns outstanding conflicts and a clean=true gate when zero error-severity rows remain. Used by the dogfood test.",
      "category": "conflicts"
    },
    {
      "id": "conflicts.list-detectors",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/ListDetectors",
      "method": "POST",
      "summary": "List registered detectors",
      "description": "Returns the set of Detector plug-ins compiled into this binary.",
      "category": "conflicts"
    },
    {
      "id": "conflicts.list-resolvers",
      "path": "/vrooli.architecture_cartographer.v1.conflicts.ConflictsService/ListResolvers",
      "method": "POST",
      "summary": "List registered resolvers",
      "description": "Returns the set of Resolver plug-ins compiled into this binary.",
      "category": "conflicts"
    },
    {
      "id": "domains.extract",
      "path": "/vrooli.architecture_cartographer.v1.domains.DomainsService/ExtractDomains",
      "method": "POST",
      "summary": "Derive the domain map for a scenario",
      "description": "Walks the domain-extraction ladder (DOMAINS.md → api/internal folders → cli groups) and returns the canonical derived domain map with per-source provenance.",
      "category": "domains"
    },
    {
      "id": "domains.show",
      "path": "/vrooli.architecture_cartographer.v1.domains.DomainsService/GetDomainMap",
      "method": "POST",
      "summary": "Show the derived domain map",
      "description": "Returns the derived domain map for a scenario (re-derived per call; deterministic).",
      "category": "domains"
    },
    {
      "id": "domains.convergence",
      "path": "/vrooli.architecture_cartographer.v1.domains.DomainsService/ConvergenceReport",
      "method": "POST",
      "summary": "Report cross-surface domain convergence",
      "description": "Reports where a scenario's surfaces (DOMAINS.md, api folders, cli groups, ui features) disagree on the domain set. Advisory, never a hard gate.",
      "category": "domains"
    },
    {
      "id": "graph.extract",
      "path": "/vrooli.architecture_cartographer.v1.graph.GraphService/ExtractGraph",
      "method": "POST",
      "summary": "Extract and persist a graph snapshot",
      "description": "Delegates to the language code-graph adapter(s), normalizes, dedupes, and persists the resulting snapshot.",
      "category": "graph"
    },
    {
      "id": "graph.get",
      "path": "/vrooli.architecture_cartographer.v1.graph.GraphService/GetGraphSnapshot",
      "method": "POST",
      "summary": "Get a persisted snapshot by id",
      "description": "Returns the canonical-form GraphSnapshot for the supplied id.",
      "category": "graph"
    },
    {
      "id": "graph.list",
      "path": "/vrooli.architecture_cartographer.v1.graph.GraphService/ListGraphSnapshots",
      "method": "POST",
      "summary": "List persisted snapshots",
      "description": "Cursor-paginated list of persisted snapshots, optionally filtered by scenario.",
      "category": "graph"
    },
    {
      "id": "graph.clear",
      "path": "/vrooli.architecture_cartographer.v1.graph.GraphService/ClearGraphSnapshots",
      "method": "POST",
      "summary": "Clear cached snapshots",
      "description": "Removes cached snapshots for the scenario. Honors X-Dry-Run.",
      "category": "graph"
    },
    {
      "id": "graph.export",
      "path": "/vrooli.architecture_cartographer.v1.graph.GraphService/ExportGraph",
      "method": "POST",
      "summary": "Export snapshot bytes",
      "description": "Returns the persisted snapshot serialized as canonical-form JSON bytes for offline analysis or fixture authoring.",
      "category": "graph"
    },
    {
      "id": "signals.score",
      "path": "/vrooli.architecture_cartographer.v1.signals.SignalsService/ScoreChunk",
      "method": "POST",
      "summary": "Score a chunk",
      "description": "Runs every registered Signal on the chunk and aggregates them into a Verdict (auto_place / suggest / conflict).",
      "category": "signals"
    },
    {
      "id": "signals.explain",
      "path": "/vrooli.architecture_cartographer.v1.signals.SignalsService/ExplainVerdict",
      "method": "POST",
      "summary": "Explain a verdict",
      "description": "Returns the same Verdict shape as ScoreChunk with full per-signal evidence so operators can inspect the placement decision.",
      "category": "signals"
    },
    {
      "id": "signals.list",
      "path": "/vrooli.architecture_cartographer.v1.signals.SignalsService/ListSignals",
      "method": "POST",
      "summary": "List registered signals",
      "description": "Returns the set of Signal plug-ins, their default weights, and per-scenario manifest-overlaid weights when scenario is supplied.",
      "category": "signals"
    },
    {
      "id": "signals.boundaries",
      "path": "/vrooli.architecture_cartographer.v1.signals.SignalsService/BoundaryHealth",
      "method": "POST",
      "summary": "Domain boundary-health scores",
      "description": "Computes per-domain coupling metrics (efferent/afferent, instability, fan-out, stable-kernel) and a graded boundary-health score with advisory smells.",
      "category": "signals"
    }
  ]
}
