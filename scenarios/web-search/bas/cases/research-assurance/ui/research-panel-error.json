{
  "metadata": {
    "name": "research-panel-error",
    "description": "Verify an invalid evidence passage produces a visible, recoverable research error state.",
    "requirement": "REQ-P1-013",
    "version": "1",
    "labels": {"surface": "research", "viewport": "desktop", "result_state": "error", "requires_confirmation": "true", "routed_isolation": "true"},
    "execution_mode": "mutating"
  },
  "settings": {"viewport_width": 1440, "viewport_height": 900},
  "nodes": [
    {"id":"navigate-search","action":{"type":"ACTION_TYPE_NAVIGATE","navigate":{"destination_type":"NAVIGATE_DESTINATION_TYPE_SCENARIO","scenario":"web-search","scenario_path":"/search","wait_until":"NAVIGATE_WAIT_EVENT_NETWORKIDLE","timeout_ms":30000},"metadata":{"label":"Open the search and research surface"}}},
    {"id":"wait-panel","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/research.panel","state":"WAIT_STATE_VISIBLE","timeout_ms":15000},"metadata":{"label":"Wait for the research panel"}}},
    {"id":"input-invalid-id","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/research.passageId","value":"missing-passage-for-error-state","clear_first":true},"metadata":{"label":"Enter an unknown evidence passage ID"}}},
    {"id":"click-read","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/research.readPassage"},"metadata":{"label":"Request the unknown passage"}}},
    {"id":"assert-error","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"@selector/research.error","mode":"ASSERTION_MODE_VISIBLE","timeout_ms":15000,"failure_message":"An invalid evidence passage must expose a visible error state."},"metadata":{"label":"Verify the visible error state"}}}
  ],
  "edges": [
    {"id":"e1","source":"navigate-search","target":"wait-panel"},
    {"id":"e2","source":"wait-panel","target":"input-invalid-id"},
    {"id":"e3","source":"input-invalid-id","target":"click-read"},
    {"id":"e4","source":"click-read","target":"assert-error"}
  ]
}
