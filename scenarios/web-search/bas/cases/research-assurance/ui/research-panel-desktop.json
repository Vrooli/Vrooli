{
  "metadata": {
    "name": "research-panel-desktop",
    "description": "Verify the desktop research panel exposes an accessible query entry point and evidence passage control.",
    "requirement": "REQ-P1-013",
    "version": "1",
    "labels": {
      "surface": "research",
      "viewport": "desktop",
      "reset": "none",
      "requires_confirmation": "true",
      "routed_isolation": "true"
    },
    "execution_mode": "mutating"
  },
  "settings": { "viewport_width": 1440, "viewport_height": 900 },
  "nodes": [
    {
      "id": "navigate-search",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "web-search",
          "scenario_path": "/search",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open the search and research surface" }
      }
    },
    {
      "id": "wait-panel",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": { "selector": "@selector/research.panel", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 15000 },
        "metadata": { "label": "Wait for the research panel" }
      }
    },
    {
      "id": "input-query",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": { "selector": "@selector/research.query", "value": "What is the current PostgreSQL default port?", "clear_first": true },
        "metadata": { "label": "Enter a research question" }
      }
    },
    {
      "id": "assert-start",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": { "selector": "@selector/research.start", "mode": "ASSERTION_MODE_VISIBLE", "timeout_ms": 10000, "failure_message": "Research start control is not visible after entering a question." },
        "metadata": { "label": "Verify the research start control" }
      }
    },
    {
      "id": "assert-passage-input",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": { "selector": "@selector/research.passageId", "mode": "ASSERTION_MODE_VISIBLE", "timeout_ms": 10000, "failure_message": "Evidence passage lookup control is not visible." },
        "metadata": { "label": "Verify evidence passage lookup" }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-search", "target": "wait-panel" },
    { "id": "e2", "source": "wait-panel", "target": "input-query" },
    { "id": "e3", "source": "input-query", "target": "assert-start" },
    { "id": "e4", "source": "assert-start", "target": "assert-passage-input" }
  ]
}
