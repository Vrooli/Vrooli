{
  "metadata": {
    "name": "research-panel-keyboard",
    "description": "Verify keyboard focus moves through the research query and evidence controls in DOM order.",
    "requirement": "REQ-P1-013",
    "version": "1",
    "labels": {
      "surface": "research",
      "viewport": "desktop",
      "reset": "none",
      "requires_confirmation": "true",
      "routed_isolation": "true"
    },
    "execution_mode": "mutating"
  },
  "settings": { "viewport_width": 1440, "viewport_height": 900 },
  "nodes": [
    {
      "id": "navigate-search",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "web-search",
          "scenario_path": "/search",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open the search and research surface" }
      }
    },
    {
      "id": "wait-panel",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": { "selector": "@selector/research.panel", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 15000 },
        "metadata": { "label": "Wait for the research panel" }
      }
    },
    {
      "id": "enable-start",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": { "selector": "@selector/research.query", "value": "keyboard focus check", "clear_first": true },
        "metadata": { "label": "Enter a question to enable research" }
      }
    },
    {
      "id": "focus-query",
      "action": {
        "type": "ACTION_TYPE_FOCUS",
        "focus": { "selector": "@selector/research.query", "timeout_ms": 5000 },
        "metadata": { "label": "Focus the research query" }
      }
    },
    {
      "id": "tab-start",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": { "key": "Tab" },
        "metadata": { "label": "Move focus to start" }
      }
    },
    {
      "id": "assert-start-focus",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": { "selector": "@selector/research.start:focus", "mode": "ASSERTION_MODE_EXISTS", "timeout_ms": 5000, "failure_message": "Tab from the research query did not focus the start control." },
        "metadata": { "label": "Verify start receives focus" }
      }
    },
    {
      "id": "tab-passage",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": { "key": "Tab" },
        "metadata": { "label": "Move focus to passage lookup" }
      }
    },
    {
      "id": "assert-passage-focus",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": { "selector": "@selector/research.passageId:focus", "mode": "ASSERTION_MODE_EXISTS", "timeout_ms": 5000, "failure_message": "Tab from the start control did not focus the passage ID input." },
        "metadata": { "label": "Verify passage ID receives focus" }
      }
    },
    {
      "id": "enable-read",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": { "selector": "@selector/research.passageId", "value": "keyboard-check", "clear_first": true },
        "metadata": { "label": "Enter a passage ID to enable reading" }
      }
    },
    {
      "id": "tab-read-enabled",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": { "key": "Tab" },
        "metadata": { "label": "Move focus to enabled passage read" }
      }
    },
    {
      "id": "assert-read-focus",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": { "selector": "@selector/research.readPassage:focus", "mode": "ASSERTION_MODE_EXISTS", "timeout_ms": 5000, "failure_message": "Tab from the passage ID input did not focus the read passage control." },
        "metadata": { "label": "Verify read passage receives focus" }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-search", "target": "wait-panel" },
    { "id": "e2", "source": "wait-panel", "target": "enable-start" },
    { "id": "e3", "source": "enable-start", "target": "focus-query" },
    { "id": "e4", "source": "focus-query", "target": "tab-start" },
    { "id": "e5", "source": "tab-start", "target": "assert-start-focus" },
    { "id": "e6", "source": "assert-start-focus", "target": "tab-passage" },
    { "id": "e7", "source": "tab-passage", "target": "assert-passage-focus" },
    { "id": "e8", "source": "assert-passage-focus", "target": "enable-read" },
    { "id": "e9", "source": "enable-read", "target": "tab-read-enabled" },
    { "id": "e10", "source": "tab-read-enabled", "target": "assert-read-focus" }
  ]
}
