{
  "$schema": "../../../program-runtime/schemas/program-contract.schema.json",
  "name": "web-search.learning-read",
  "version": "1",
  "purpose": "Read fixed outcome-linked research cohorts with explicit reliability and no invented baseline.",
  "inputs": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "context_key": {
      "type": "string"
    }
  },
  "assumptions": [
    "Declared owner bindings are reachable. External answers require independent verification before claiming measured quality improvements."
  ],
  "invariants": [
    "One bounded envelope on every path.",
    "Unknown observations remain unknown.",
    "No retry or polling loops."
  ],
  "bindings": [
    {
      "id": "vrooli-memory/learning/measure",
      "effect": "read"
    }
  ],
  "verbs": [],
  "outputs": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed",
        "unavailable",
        "refused"
      ]
    },
    "phase": {
      "enum": [
        "validate",
        "collect",
        "act",
        "report"
      ]
    },
    "signals": {
      "cohorts": "At most ten comparable groups",
      "reliable": "Owner validity plus output completeness",
      "targets": "Null until comparable operator windows earn a baseline"
    },
    "errors": {
      "classes": [
        "invalid_input",
        "learning_unavailable"
      ]
    },
    "evidence": "Durable references, never raw source bodies"
  },
  "budget": {
    "wall_ms": 120000,
    "inference_calls": 0,
    "delegated_runs": 0,
    "materialize_limit": 10,
    "output_bytes": 65536
  },
  "fixtures": [
    {
      "id": "invalid-input",
      "inputs": {
        "unexpected": true
      },
      "expect": {
        "admission_error": "invalid_argument"
      }
    }
  ],
  "rung": "S3",
  "owner_skill": "web-search-improve",
  "memory": {
    "scope": "web-search-usage",
    "reads_in": "collect",
    "writes_in": "none",
    "entry_kinds": [
      "task-record"
    ]
  }
}
