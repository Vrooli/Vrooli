{
  "edges": [
    {
      "id": "e1",
      "source": "navigate-dashboard",
      "target": "click-project",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "click-project",
      "target": "open-card-view",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3a",
      "source": "open-card-view",
      "target": "click-new-workflow",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "click-new-workflow",
      "target": "select-ai-assisted",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6a",
      "source": "select-ai-assisted",
      "target": "assert-ai-modal-visible",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e11",
      "source": "click-manual-button",
      "target": "assert-modal-closed",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e13",
      "source": "assert-modal-closed",
      "target": "assert-builder-visible",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e14",
      "source": "assert-builder-visible",
      "target": "verify-url-changed",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e15",
      "source": "verify-url-changed",
      "target": "assert-palette-visible",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7-bridge-e9",
      "source": "assert-ai-modal-visible",
      "target": "click-manual-button",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ],
  "metadata": {
    "description": "Validates the 'Switch to Manual Builder' button in AI modal creates an empty workflow and loads the builder",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true"
    },
    "name": "Ai Modal Switch To Manual",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "click": { "selector": "@selector/workflows.creation.aiAssisted" },
        "metadata": { "label": "Choose AI-assisted workflow creation" },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "select-ai-assisted"
    },
    {
      "action": {
        "click": { "selector": "@selector/workflows.cardViewToggle" },
        "metadata": { "label": "Switch workflows to card view" },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "open-card-view"
    },
    {
      "action": {
        "metadata": {
          "label": "Open BAS dashboard"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "browser-automation-studio",
          "scenario_path": "/",
          "timeout_ms": 45000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-dashboard"
    },
    {
      "action": {
        "metadata": {
          "label": "Open deterministic Demo project"
        },
        "subflow": {
          "args": {
            "projectFolder": "${@params/projectFolder}",
            "projectName": "${@params/projectName}"
          },
          "workflow_path": "actions/open-demo-project.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "click-project"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.newButton"
        },
        "metadata": {
          "label": "Click New Workflow button"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-new-workflow"
    },
    {
      "action": {
        "assert": {
          "failure_message": "AI modal should appear",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "[role=\"dialog\"]",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "AI modal is visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-ai-modal-visible"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/ai.modal.switchToManualButton"
        },
        "metadata": {
          "label": "Click Switch to Manual Builder"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "resilience": {
          "success_selector": "@selector/workflowBuilder.canvas.root",
          "success_timeout_ms": 15000
        }
      },
      "id": "click-manual-button"
    },
    {
      "action": {
        "assert": {
          "failure_message": "AI modal should close after clicking manual builder button",
          "mode": "not_exists",
          "selector": "[role=\"dialog\"] h2",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "AI modal is closed"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-modal-closed"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Workflow builder should load after switching to manual",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/workflowBuilder.canvas.root",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Workflow builder canvas is visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-builder-visible"
    },
    {
      "action": {
        "evaluate": {
          "expression": "window.location.pathname.includes('/workflows/')",
          "store_result": "urlChangedToWorkflow"
        },
        "metadata": {
          "label": "Verify URL changed to workflow view"
        },
        "type": "ACTION_TYPE_EVALUATE"
      },
      "id": "verify-url-changed"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Node palette should be visible in builder",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/nodePalette.container",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Node palette is visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-palette-visible"
    }
  ],
  "settings": {
    "viewport_height": 1080,
    "viewport_width": 1920
  }
}
