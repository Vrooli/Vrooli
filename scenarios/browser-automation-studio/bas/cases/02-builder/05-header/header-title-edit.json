{
  "edges": [
    {
      "id": "e1",
      "source": "nav",
      "target": "open-projects",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "proj",
      "target": "open-card-view",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e1a",
      "source": "open-projects",
      "target": "proj",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2a",
      "source": "open-card-view",
      "target": "wait-workflows",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e-wait-work",
      "source": "wait-workflows",
      "target": "work",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "work",
      "target": "wait1",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "wait1",
      "target": "get-original",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "get-original",
      "target": "click-edit",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "click-edit",
      "target": "assert-input",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "assert-input",
      "target": "type-new",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "type-new",
      "target": "click-save",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e9",
      "source": "click-save",
      "target": "verify-saved",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ],
  "metadata": {
    "description": "Validates inline workflow title editing with save/cancel",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "full",
      "routed_isolation": "true",
      "seed": "bas/seeds/seed.go"
    },
    "name": "Header Title Edit",
    "version": "1"
  },
  "nodes": [
    {
      "action": { "click": { "selector": "@selector/dashboard.tabs.projects" }, "metadata": { "label": "Open Projects dashboard tab" }, "type": "ACTION_TYPE_CLICK" },
      "id": "open-projects"
    },
    {
      "action": { "click": { "selector": "@selector/workflows.cardViewToggle" }, "metadata": { "label": "Switch workflows to card view" }, "type": "ACTION_TYPE_CLICK" },
      "id": "open-card-view"
    },
    {
      "action": {
        "metadata": {
          "label": "Open BAS"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "browser-automation-studio",
          "scenario_path": "/",
          "timeout_ms": 45000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "nav"
    },
    {
      "action": {
        "metadata": {
          "label": "Open deterministic Demo project"
        },
        "subflow": {
          "args": {
            "projectFolder": "${@params/projectFolder}",
            "projectName": "${@params/projectName}"
          },
          "workflow_path": "actions/open-demo-project.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "proj"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for workflows"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/workflows.card",
          "timeout_ms": 10000
        }
      },
      "id": "wait-workflows"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.card:first-of-type"
        },
        "metadata": {
          "label": "Open workflow"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "work"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 3000
        }
      },
      "id": "wait1"
    },
    {
      "action": {
        "evaluate": {
          "expression": "document.querySelector('@selector/header.title.text')?.textContent?.trim() || ''",
          "store_result": "originalTitle"
        },
        "metadata": {
          "label": "Get original title"
        },
        "type": "ACTION_TYPE_EVALUATE"
      },
      "id": "get-original"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/header.title.editButton"
        },
        "metadata": {
          "label": "Click edit button"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-edit"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Title input should appear",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/header.title.input",
          "timeout_ms": 3000
        },
        "metadata": {
          "label": "Input visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-input"
    },
    {
      "action": {
        "input": {
          "clear_first": true,
          "selector": "@selector/header.title.input /*dup-1*/",
          "value": "Updated Workflow Title"
        },
        "metadata": {
          "label": "Type new title"
        },
        "type": "ACTION_TYPE_INPUT"
      },
      "id": "type-new"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/header.title.saveButton"
        },
        "metadata": {
          "label": "Save title"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-save"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Input should be hidden after save",
          "mode": "ASSERTION_MODE_NOT_EXISTS",
          "selector": "@selector/header.title.input /*dup-2*/",
          "timeout_ms": 3000
        },
        "metadata": {
          "label": "Input hidden"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "verify-saved"
    }
  ],
  "settings": {
    "viewport_height": 1080,
    "viewport_width": 1920
  }
}
