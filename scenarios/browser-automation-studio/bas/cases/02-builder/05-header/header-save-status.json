{
  "edges": [
    {
      "id": "e1",
      "source": "nav",
      "target": "open-projects",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "proj",
      "target": "open-card-view",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e1a",
      "source": "open-projects",
      "target": "proj",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2a",
      "source": "open-card-view",
      "target": "wait-workflows",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "work",
      "target": "assert-status",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "click-palette",
      "target": "click-canvas",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "click-canvas",
      "target": "wait-autosave",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e9",
      "source": "wait-autosave",
      "target": "check-saved-state",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e-wait-work",
      "source": "wait-workflows",
      "target": "work",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5-bridge-e6",
      "source": "assert-status",
      "target": "click-palette",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ],
  "metadata": {
    "description": "Validates save status indicator shows autosave state transitions",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true"
    },
    "name": "Header Save Status",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "click": {
          "selector": "@selector/dashboard.tabs.projects"
        },
        "metadata": {
          "label": "Open Projects dashboard tab"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "open-projects"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.cardViewToggle"
        },
        "metadata": {
          "label": "Switch workflows to card view"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "open-card-view"
    },
    {
      "action": {
        "metadata": {
          "label": "Open BAS"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "browser-automation-studio",
          "scenario_path": "/?tab=projects",
          "timeout_ms": 45000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "nav"
    },
    {
      "action": {
        "metadata": {
          "label": "Open deterministic Demo project"
        },
        "subflow": {
          "args": {
            "projectFolder": "${@params/projectFolder}",
            "projectName": "${@params/projectName}"
          },
          "workflow_path": "actions/open-demo-project.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "proj"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for workflows to load"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/workflows.card",
          "timeout_ms": 10000
        }
      },
      "id": "wait-workflows"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.card:first-of-type"
        },
        "metadata": {
          "label": "Open workflow"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "work"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Save status indicator should be visible",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/header.saveStatus.indicator",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Save status visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-status"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/nodePalette.cards.navigate"
        },
        "metadata": {
          "label": "Click navigate node"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-palette"
    },
    {
      "action": {
        "click": {
          "selector": ".react-flow__pane"
        },
        "metadata": {
          "label": "Click canvas to add"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-canvas"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for autosave"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 3000
        }
      },
      "id": "wait-autosave"
    },
    {
      "action": {
        "evaluate": {
          "expression": "(() => { const status = document.querySelector('@selector/header.saveStatus.indicator'); return status ? status.textContent || status.innerHTML : ''; })()",
          "store_result": "saveStatus"
        },
        "metadata": {
          "label": "Check for saved indicator"
        },
        "type": "ACTION_TYPE_EVALUATE"
      },
      "id": "check-saved-state"
    }
  ],
  "settings": {
    "viewport_height": 1080,
    "viewport_width": 1920
  }
}
