{
  "edges": [
    {
      "id": "fixture-open-project",
      "source": "fixture-call-open-project",
      "target": "fixture-open-workflows-tab",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-open-workflows-tab",
      "source": "fixture-open-workflows-tab",
      "target": "fixture-open-workflow-card-view",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-open-workflow-card-view",
      "source": "fixture-open-workflow-card-view",
      "target": "fixture-wait-for-workflows",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1",
      "source": "fixture-wait-for-workflows",
      "target": "fixture-assert-seed-workflow",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-2",
      "source": "fixture-assert-seed-workflow",
      "target": "fixture-click-demo-workflow",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-3",
      "source": "fixture-click-demo-workflow",
      "target": "fixture-assert-builder-loaded",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-builder-ready",
      "source": "fixture-assert-builder-loaded",
      "target": "fixture-assert-nodes",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ],
  "metadata": {
    "description": "Loads the demo project and opens the seeded workflow for builder interactions",
    "execution_mode": "mutating",
    "labels": {
      "fixture_id": "open-demo-workflow",
      "requirements_json": "[\"BAS-WORKFLOW-DEMO-SEED\"]",
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true",
      "seed_keys": "projectId,projectName,projectFolder,workflowId,workflowName",
      "seed_required": "true"
    },
    "name": "open-demo-workflow"
  },
  "nodes": [
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.tab"
        },
        "metadata": {
          "label": "Open project Workflows tab"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "timeout_ms": 10000
      },
      "id": "fixture-open-workflows-tab"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.cardViewToggle"
        },
        "metadata": {
          "label": "Switch project workflows to card view"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "timeout_ms": 10000
      },
      "id": "fixture-open-workflow-card-view"
    },
    {
      "action": {
        "metadata": {
          "label": "Open Demo project"
        },
        "subflow": {
          "args": {
            "projectFolder": {
              "string_value": "${@params/projectFolder}"
            },
            "projectId": {
              "string_value": "${@params/projectId}"
            },
            "projectName": {
              "string_value": "${@params/projectName}"
            }
          },
          "workflow_path": "actions/open-demo-project.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "fixture-call-open-project"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for workflows to load"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/workflows.card",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "fixture-wait-for-workflows"
    },
    {
      "action": {
        "assert": {
          "failure_message": "The deterministic Demo Smoke Workflow should exist. Ensure routed fixture setup completed.",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/workflows.cardByName(name=\"Demo Smoke Workflow\")",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Verify seed workflow exists"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "fixture-assert-seed-workflow"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/workflows.cardByName(name=\"Demo Smoke Workflow\")"
        },
        "metadata": {
          "label": "Open seeded workflow"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "timeout_ms": 10000
      },
      "id": "fixture-click-demo-workflow"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Workflow builder should be fully initialized and ready for automation. This indicates React Flow has completed its initialization, viewport calculations, and fitView animation.",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": "@selector/workflowBuilder.reactFlowReady",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Workflow builder fully initialized and interactive"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "fixture-assert-builder-loaded"
    },
    {
      "action": {
        "assert": {
          "failure_message": "Seeded workflow should render nodes",
          "mode": "ASSERTION_MODE_EXISTS",
          "selector": ".react-flow__node",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Seeded nodes are visible"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "fixture-assert-nodes"
    }
  ],
  "settings": {}
}
