{
  "edges": [
    {
      "id": "fixture-edge-0",
      "source": "fixture-seed-state",
      "target": "fixture-navigate-dashboard",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1",
      "source": "fixture-navigate-dashboard",
      "target": "fixture-dismiss-tutorial",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1b",
      "source": "fixture-dismiss-tutorial",
      "target": "fixture-click-projects-tab",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1c",
      "source": "fixture-click-projects-tab",
      "target": "fixture-wait-for-projects",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1a",
      "source": "fixture-wait-for-projects",
      "target": "fixture-assert-seed-project",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-1b",
      "source": "fixture-assert-seed-project",
      "target": "fixture-click-demo",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-2",
      "source": "fixture-click-demo",
      "target": "fixture-assert-demo-heading",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "fixture-edge-3",
      "source": "fixture-assert-demo-heading",
      "target": "fixture-wait-for-project-tabs",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ],
  "metadata": {
    "description": "Navigates to the BAS dashboard and opens the seeded demo project",
    "execution_mode": "mutating",
    "labels": {
      "fixture_id": "open-demo-project",
      "requirements_json": "[\"BAS-WORKFLOW-DEMO-SEED\"]",
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true",
      "seed_keys": "projectId,projectName,projectFolder",
      "seed_required": "true"
    },
    "name": "open-demo-project"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Load seed metadata"
        },
        "subflow": {
          "args": {
            "projectFolder": {
              "string_value": "${@params/projectFolder}"
            },
            "projectId": {
              "string_value": "${@params/projectId}"
            },
            "projectName": {
              "string_value": "${@params/projectName}"
            },
            "workflowId": {
              "string_value": "${@params/workflowId}"
            },
            "workflowName": {
              "string_value": "${@params/workflowName}"
            }
          },
          "workflow_path": "actions/load-seed-state.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "fixture-seed-state"
    },
    {
      "action": {
        "metadata": {
          "label": "Open BAS dashboard"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "browser-automation-studio",
          "scenario_path": "/",
          "timeout_ms": 45000,
          "url": "",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "fixture-navigate-dashboard"
    },
    {
      "action": {
        "metadata": {
          "label": "Dismiss onboarding tutorial if present"
        },
        "subflow": {
          "workflow_path": "actions/dismiss-tutorial.json"
        },
        "type": "ACTION_TYPE_SUBFLOW"
      },
      "id": "fixture-dismiss-tutorial"
    },
    {
      "action": {
        "click": {
          "selector": "@selector/dashboard.tabs.projects"
        },
        "metadata": {
          "label": "Navigate to Projects tab"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "timeout_ms": 5000
      },
      "id": "fixture-click-projects-tab"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for Projects tab to load"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/dashboard.newProjectButton",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "fixture-wait-for-projects"
    },
    {
      "action": {
        "assert": {
        "failure_message": "The deterministic Demo Browser Automations project should exist. Ensure routed fixture setup completed.",
          "mode": "ASSERTION_MODE_EXISTS",
        "selector": "@selector/projects.cardByName(name=\"Demo Browser Automations\")",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Verify seed project exists"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "fixture-assert-seed-project"
    },
    {
      "action": {
        "click": {
        "selector": "@selector/projects.cardByName(name=\"Demo Browser Automations\")"
        },
        "metadata": {
          "label": "Select demo project"
        },
        "type": "ACTION_TYPE_CLICK"
      },
      "execution_settings": {
        "resilience": {
          "success_selector": "@selector/breadcrumbs.project",
          "success_timeout_ms": 10000
        },
        "timeout_ms": 10000
      },
      "id": "fixture-click-demo"
    },
    {
      "action": {
        "assert": {
        "failure_message": "Project breadcrumb should be visible",
          "mode": "ASSERTION_MODE_EXISTS",
        "selector": "@selector/breadcrumbs.project",
          "timeout_ms": 5000
        },
        "metadata": {
        "label": "Verify project breadcrumb"
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "fixture-assert-demo-heading"
    },
    {
      "action": {
        "metadata": {
          "label": "Wait for project tabs"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/workflows.tab",
          "timeout_ms": 15000
        }
      },
      "id": "fixture-wait-for-project-tabs"
    }
  ],
  "settings": {}
}
