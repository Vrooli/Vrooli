{
  "name": "browser-automation-studio-ui",
  "version": "1.0.0",
  "description": "Visual browser automation workflow builder",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/bootstrap.js",
    "./bootstrap": "./dist/bootstrap.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vrooli lifecycle protect -- npx vite",
    "build": "pnpm run type-check && npx vite build $([ \"$VROOLI_BUILD_MODE\" = profile ] && echo --mode profile) && node ./scripts/gzip-dist.mjs",
    "build:profile": "pnpm run typecheck && npx vite build --mode profile && node ./scripts/gzip-dist.mjs",
    "preview": "npx vite preview",
    "test": "bash ./scripts/run-vitest.sh",
    "test:full": "BAS_VITEST_SUITE=full bash ./scripts/run-vitest.sh",
    "test:stores": "vitest run --project stores",
    "test:components": "vitest run --project components",
    "test:execution-viewer": "vitest run --project execution-viewer",
    "test:workflow-builder": "vitest run --project workflow-builder",
    "test:watch": "vitest",
    "test:coverage": "BAS_VITEST_SUITE=full bash ./scripts/run-vitest.sh --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@monaco-editor/react": "^4.7.0",
    "@reactflow/background": "^11.3.0",
    "@reactflow/controls": "^11.2.0",
    "@reactflow/core": "^11.10.1",
    "@reactflow/minimap": "^11.7.0",
    "@tanstack/react-query": "^5.17.0",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "@vrooli/proto-types": "file:../../../packages/proto/gen/typescript",
    "@vrooli/vitest-requirement-reporter": "file:../../../packages/vitest-requirement-reporter",
    "axe-core": "^4.12.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "express": "^5.1.0",
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "15.1.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.1",
    "react-split": "^2.0.14",
    "react-syntax-highlighter": "^15.5.0",
    "reactflow": "^11.10.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.23.8",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.0.11",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.0": "1.1.16",
      "brace-expansion@^5.0.0": "5.0.8",
      "js-yaml@^4.0.0": "4.3.0"
    }
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
