{
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@ghostery/adblocker-playwright": "^2.13.2",
    "@vrooli/proto-types": "file:../../../packages/proto/gen/typescript",
    "js-yaml": "4.3.2",
    "prom-client": "^15.1.0",
    "rebrowser-playwright": "1.52.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.21.1",
    "zod": "^3.22.4"
  },
  "description": "Type-safe Playwright driver for browser automation",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "\u003e=18.0.0"
  },
  "license": "MIT",
  "main": "dist/server.js",
  "name": "@vrooli/playwright-driver",
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.0": "1.1.18",
      "js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "rebrowser-playwright-core@1.52.0": "patches/rebrowser-playwright-core@1.52.0.patch"
    }
  },
  "scripts": {
    "browsers:ensure": "node scripts/ensure-browsers.mjs",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --external:rebrowser-playwright --external:winston --external:prom-client --external:uuid --external:zod --external:@bufbuild/protobuf --external:@bufbuild/protobuf/* --external:ws \u0026\u0026 node scripts/stage-browser-scripts.mjs \u0026\u0026 node scripts/ensure-browsers.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "node scripts/clean.mjs",
    "dev": "ts-node src/server.ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e:pipeline": "jest tests/integration/pipeline-e2e.test.ts --runInBand",
    "test:e2e:record-mode": "node tests/e2e/record-mode-e2e.mjs",
    "test:e2e:record-mode:contract": "node --test tests/e2e/record-mode-e2e.test.mjs",
    "test:integration": "jest tests/integration",
    "test:recording": "jest tests/unit/recording tests/integration/record-mode.test.ts tests/integration/timeline-validation.test.ts tests/integration/pipeline-e2e.test.ts",
    "test:selectors": "playwright test src/recording/validation/selectors.test.ts",
    "test:selectors:headed": "playwright test src/recording/validation/selectors.test.ts --headed",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "version": "2.0.0"
}
