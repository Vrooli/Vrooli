{
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@ghostery/adblocker-playwright": "^2.13.2",
    "@vrooli/proto-types": "file:../../../packages/proto/gen/typescript",
    "js-yaml": "4.3.2",
    "prom-client": "^15.1.0",
    "rebrowser-playwright": "1.52.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.21.1",
    "zod": "^3.22.4"
  },
  "description": "Type-safe Playwright driver for browser automation",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "main": "dist/server.js",
  "name": "@vrooli/playwright-driver",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.0": "1.1.18",
      "js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "rebrowser-playwright-core@1.52.0": "patches/rebrowser-playwright-core@1.52.0.patch"
    }
  },
  "scripts": {
    "browsers:ensure": "node scripts/ensure-browsers.mjs",
    "bundle:stage-browser": "node ../bundle/stage-browser-closure.mjs",
    "bundle:offline-create": "node ../bundle/offline-closure.mjs package",
    "bundle:offline-install": "node ../bundle/offline-closure.mjs install",
    "bundle:offline-rollback": "node ../bundle/offline-closure.mjs rollback",
    "bundle:offline-remove": "node ../bundle/offline-closure.mjs remove",
    "build": "node scripts/build.mjs",
    "build:profile": "node scripts/build.mjs --mode profile",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "node scripts/clean.mjs",
    "dev": "ts-node src/server.ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e:pipeline": "jest --config jest.integration.config.js tests/integration/pipeline-e2e.test.ts --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:journeys": "jest -c jest.journeys.config.js --runInBand",
    "test:recording": "jest --config jest.config.js tests/unit/recording && jest --config jest.integration.config.js tests/integration/record-mode.test.ts tests/integration/timeline-validation.test.ts tests/integration/pipeline-e2e.test.ts --runInBand",
    "test:selectors": "playwright test src/recording/validation/selectors.test.ts",
    "test:selectors:headed": "playwright test src/recording/validation/selectors.test.ts --headed",
    "test:unit": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "test:motion": "jest --config jest.motion.config.js --runInBand",
    "test:managed": "jest --config jest.managed.config.js --runInBand",
    "test:selection": "node scripts/check-test-selections.cjs",
    "test:audio-device": "jest --config jest.audio-device.config.js --runInBand"
  },
  "version": "2.0.0"
}
