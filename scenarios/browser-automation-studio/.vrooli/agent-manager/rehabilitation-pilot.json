{
  "schemaVersion": "agent-workflow/v1",
  "owner": "browser-automation-studio",
  "key": "browser-automation-studio/rehabilitation-pilot",
  "version": "1.1.0",
  "description": "One bounded BAS lifecycle repair followed by independent review and owner-bound qualification; rejected reviews terminate before the expensive qualification gate.",
  "trigger": {"initiators": ["programmatic"], "selfTrigger": {"mode": "deny"}},
  "inputSchema": {
    "type": "object",
    "properties": {
      "boundary": {"type": "string", "minLength": 1, "maxLength": 4096},
      "worker_instruction": {"type": "string", "minLength": 1, "maxLength": 8192},
      "required_rows": {"type": "array", "minItems": 1, "maxItems": 17, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
      "request_key": {"type": "string", "minLength": 1, "maxLength": 51},
      "invalidated_producers": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 128}},
      "retained_evidence_sets": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": true}}
    },
    "required": ["boundary", "worker_instruction", "required_rows", "request_key", "retained_evidence_sets"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {"result": {"type": "object", "additionalProperties": true}},
    "required": ["result"],
    "additionalProperties": false
  },
  "entryNode": "worker",
  "nodes": [
    {
      "id": "worker",
      "kind": "run",
      "run": {
        "profileKey": "prompt-manager/delivery-worker",
        "scopePathTemplate": "scenarios/browser-automation-studio",
      "promptRef": {
        "skillId": "browser-automation-studio-rehabilitation-worker"
      },
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "type": "object",
            "properties": {
              "changed": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 32},
              "verified": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 32},
              "remaining": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 32},
              "simplification": {"type": "string", "minLength": 1, "maxLength": 4096}
            },
            "required": ["changed", "verified", "remaining", "simplification"],
            "additionalProperties": false
          },
          "schemaRepairAttempts": 0
        },
        "bindings": [
          {"name": "boundary", "source": "workflow_input", "selector": "$.boundary", "limit": 1, "maxBytes": 4096, "renderAs": "text", "missingPolicy": "error"},
          {"name": "worker_instruction", "source": "workflow_input", "selector": "$.worker_instruction", "limit": 1, "maxBytes": 8192, "renderAs": "text", "missingPolicy": "error"},
          {"name": "required_rows", "source": "workflow_input", "selector": "$.required_rows", "limit": 1, "maxBytes": 8192, "renderAs": "json", "missingPolicy": "error"}
        ],
        "maxTurns": 16,
        "maxToolCalls": 24,
        "timeoutSeconds": 900,
        "sandboxConfig": {
          "mode": "protected",
          "autoApply": false,
          "networkMode": "none",
          "writePolicy": {"paths": [
            "api/main.go",
            "api/owner_cleanup.go",
            "api/owner_cleanup_test.go",
            "api/services/scheduler/scheduler.go",
            "api/services/scheduler/scheduler_test.go",
            "api/services/vision/claudecode_navigator.go",
            "api/services/vision/claudecode_navigator_test.go",
            "api/services/vision/navigator.go",
            "api/services/vision/playwright_navigator.go",
            "api/services/vision/playwright_navigator_test.go",
            "api/services/vision/redaction.go",
            "api/services/vision/redaction_test.go",
            "api/services/vision/session_history_test.go",
            "api/handlers/vision_navigation/connect_handler.go",
            "api/handlers/vision_navigation/connect_handler_test.go",
            "api/sidecar/supervisor/process.go",
            "api/sidecar/supervisor/supervisor.go",
            "api/sidecar/supervisor/supervisor_test.go",
            "playwright-driver/src/server.ts",
            "playwright-driver/src/session/manager.ts",
            "playwright-driver/src/session/session-reset.ts",
            "playwright-driver/src/session/session-teardown.ts",
            "playwright-driver/tests/helpers/playwright-mocks.ts",
            "playwright-driver/tests/unit/idempotency/session-idempotency.test.ts",
            "playwright-driver/tests/unit/session/manager.test.ts",
            "ui/src/api/visionNavigation.test.ts",
            "ui/src/domains/recording/ai-navigation/types.ts",
            "ui/src/domains/recording/ai-navigation/useAINavigation.ts",
            "ui/src/domains/recording/ai-navigation/useAINavigation.test.ts",
            "ui/src/domains/recording/ai-navigation/navigationEvents.ts",
            "ui/src/domains/recording/ai-navigation/runtimeRefs.ts",
            "ui/src/domains/recording/ai-navigation/useAINavigationCommands.ts",
            "ui/src/domains/recording/ai-navigation/useAINavigationEvents.ts",
            "ui/src/domains/recording/ai-navigation/useAINavigationRuntime.ts",
            "ui/src/domains/recording/ai-conversation/useAIConversation.ts",
            "ui/src/domains/recording/ai-conversation/useAIConversation.test.ts",
            "ui/src/domains/recording/sidebar/AIMessageBubble.tsx",
            "ui/src/domains/recording/sidebar/AIMessageBubble.test.tsx",
            "ui/src/domains/recording/sidebar/types.ts",
            "ui/src/domains/recording/utils/actionDisplay.ts",
            "ui/src/domains/recording/utils/actionDisplay.test.ts",
            "ui/src/domains/recording/api/RecordingApiService.ts",
            "ui/src/domains/recording/api/RecordingApiService.test.ts",
            "ui/src/domains/recording/api/schemas.ts"
          ]}
        }
      }
    },
    {
      "id": "review",
      "kind": "run",
      "run": {
        "profileKey": "prompt-manager/delivery-review",
      "promptRef": {
        "skillId": "browser-automation-studio-rehabilitation-review"
      },
        "reviewInput": {"fromNode": "worker", "paths": [
          "api/main.go",
          "api/owner_cleanup.go",
          "api/owner_cleanup_test.go",
          "api/services/scheduler/scheduler.go",
          "api/services/scheduler/scheduler_test.go",
          "api/services/vision/claudecode_navigator.go",
          "api/services/vision/claudecode_navigator_test.go",
          "api/services/vision/navigator.go",
          "api/services/vision/playwright_navigator.go",
          "api/services/vision/playwright_navigator_test.go",
          "api/services/vision/redaction.go",
          "api/services/vision/redaction_test.go",
          "api/services/vision/session_history_test.go",
          "api/handlers/vision_navigation/connect_handler.go",
          "api/handlers/vision_navigation/connect_handler_test.go",
          "api/sidecar/supervisor/process.go",
          "api/sidecar/supervisor/supervisor.go",
          "api/sidecar/supervisor/supervisor_test.go",
          "playwright-driver/src/server.ts",
          "playwright-driver/src/session/manager.ts",
          "playwright-driver/src/session/session-reset.ts",
          "playwright-driver/src/session/session-teardown.ts",
          "playwright-driver/tests/helpers/playwright-mocks.ts",
          "playwright-driver/tests/unit/idempotency/session-idempotency.test.ts",
          "playwright-driver/tests/unit/session/manager.test.ts",
          "ui/src/api/visionNavigation.test.ts",
          "ui/src/domains/recording/ai-navigation/types.ts",
          "ui/src/domains/recording/ai-navigation/useAINavigation.ts",
          "ui/src/domains/recording/ai-navigation/useAINavigation.test.ts",
          "ui/src/domains/recording/ai-navigation/navigationEvents.ts",
          "ui/src/domains/recording/ai-navigation/runtimeRefs.ts",
          "ui/src/domains/recording/ai-navigation/useAINavigationCommands.ts",
          "ui/src/domains/recording/ai-navigation/useAINavigationEvents.ts",
          "ui/src/domains/recording/ai-navigation/useAINavigationRuntime.ts",
          "ui/src/domains/recording/ai-conversation/useAIConversation.ts",
          "ui/src/domains/recording/ai-conversation/useAIConversation.test.ts",
          "ui/src/domains/recording/sidebar/AIMessageBubble.tsx",
          "ui/src/domains/recording/sidebar/AIMessageBubble.test.tsx",
          "ui/src/domains/recording/sidebar/types.ts",
          "ui/src/domains/recording/utils/actionDisplay.ts",
          "ui/src/domains/recording/utils/actionDisplay.test.ts",
          "ui/src/domains/recording/api/RecordingApiService.ts",
          "ui/src/domains/recording/api/RecordingApiService.test.ts",
          "ui/src/domains/recording/api/schemas.ts"
        ]},
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "type": "object",
            "properties": {
              "accepted": {"type": "boolean"},
              "candidateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
            },
            "required": ["accepted", "candidateSha256", "reason"],
            "additionalProperties": false
          },
          "schemaRepairAttempts": 0
        },
        "bindings": [
          {"name": "boundary", "source": "workflow_input", "selector": "$.boundary", "limit": 1, "maxBytes": 4096, "renderAs": "text", "missingPolicy": "error"}
        ],
        "maxTurns": 0,
        "timeoutSeconds": 0,
        "sandboxConfig": {
          "mode": "protected",
          "autoApply": false,
          "networkMode": "none",
          "writePolicy": {"paths": []}
        }
      }
    },
    {
      "id": "qualify",
      "kind": "qualification",
      "qualification": {
        "reviewFromNode": "review",
        "programName": "browser-automation-studio.qualify-candidate",
        "programDigest": "dddf1ba3a46543f83b5101354d1a22a90a2b1c8b4e96540d35cef539720e2e07",
        "grants": [
          "binding:workspace-sandbox/change/promote",
          "binding:test-genie/validation/resolve-identity",
          "binding:vrooli/scenario/freshness",
          "binding:vrooli/scenario/start",
          "binding:test-genie/validation/produce-evidence",
          "binding:test-genie/validation/wait",
          "binding:test-genie/validation/create"
        ],
        "bindings": [
          {"name": "request_key", "source": "workflow_input", "selector": "$.request_key", "limit": 1, "maxBytes": 128, "renderAs": "text", "missingPolicy": "error"},
          {"name": "invalidated_producers", "source": "workflow_input", "selector": "$.invalidated_producers", "limit": 1, "maxBytes": 2048, "renderAs": "json", "missingPolicy": "omit"},
          {"name": "required_rows", "source": "workflow_input", "selector": "$.required_rows", "limit": 1, "maxBytes": 8192, "renderAs": "json", "missingPolicy": "error"},
          {"name": "retained_evidence_sets", "source": "workflow_input", "selector": "$.retained_evidence_sets", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}
        ]
      }
    },
    {
      "id": "end",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {"name": "result", "source": "qualification_result", "selector": "node=qualify;$.value", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}
        ]
      }
    },
    {
      "id": "end-rejected",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {"name": "result", "source": "structured_result", "selector": "node=review;$.value", "limit": 1, "maxBytes": 16384, "renderAs": "json", "missingPolicy": "error"}
        ]
      }
    }
  ],
  "edges": [
    {"from": "worker", "to": "review"},
    {"from": "review", "to": "qualify", "condition": "has(latest(journal, 'review').value) && latest(journal, 'review').value.accepted == true"},
    {"from": "review", "to": "end-rejected", "condition": "has(latest(journal, 'review').value) && latest(journal, 'review').value.accepted == false"},
    {"from": "qualify", "to": "end"}
  ],
  "budgets": {
    "wallTimeSeconds": 2400,
    "maxTurns": 28,
    "maxTokens": 400000,
    "maxChargeMicroUsd": 3000000,
    "maxNodeAttempts": 3,
    "maxChildren": 3,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 1,
    "maxWaitSeconds": 780,
    "enforcement": "metered-cancellation"
  },
  "metadata": {"consumerMutationOwner": "browser-automation-studio"}
}
