          {
            "expected": {
              "normalized": [
                {
                  "folder": "",
                  "id": "w2",
                  "index": 0,
                  "name": "No folder",
                  "snippet": "",
                  "version": 0
                }
              ]
            },
            "inputs": {
              "rows": [
                {
                  "index": 0,
                  "row": {
                    "id": "w2",
                    "name": "No folder"
                  },
                  "source": "workflows"
                }
              ]
            }
          }
        ],
        "fragment": "def step(inputs, bindings):\n    out = []\n    for item in inputs['rows']:\n        row = item['row']\n        if item['source'] == 'workflows':\n            name = str(row.get('name') or '')\n            folder = str(row.get('folderPath') or '')\n            snippet = ''\n            version = int(row.get('version') or 0)\n        else:\n            name = str(row.get('title') or '')\n            folder = str(row.get('path') or '')\n            snippet = str(row.get('snippet') or '')\n            version = 0\n        out.append({'index': item['index'], 'id': str(row.get('id') or ''), 'name': name, 'folder': folder, 'snippet': snippet, 'version': version})\n    return {'normalized': out}",
