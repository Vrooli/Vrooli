{
  "$schema": "../../../program-runtime/schemas/program-contract.schema.json",
  "assumptions": [
    "browser-automation-studio and workflow-health are running; a stopped owner marks its own source unavailable rather than emptying the candidate list"
  ],
  "bindings": [
    {
      "effect": "read",
      "id": "browser-automation-studio/workflows/list"
    },
    {
      "effect": "read",
      "id": "workflow-health/workflows/search",
      "optional": true
    },
    {
      "effect": "read",
      "id": "search-hub/query/query",
      "note": "Called with rows=\"ranked\" (the response has four repeated fields).",
      "optional": true
    }
  ],
  "budget": {
    "delegated_runs": 0,
    "inference_calls": 3,
    "materialize_limit": 100,
    "wall_ms": 60000
  },
  "fixtures": [
    {
      "expect": {
        "status": [
          "failed"
        ]
      },
      "id": "no-task",
      "inputs": {},
      "requires": [
        "browser-automation-studio"
      ]
    },
    {
      "expect": {
        "status": [
          "ok",
          "partial"
        ]
      },
      "id": "smoke",
      "inputs": {
        "k": 3,
        "scenario": "browser-automation-studio",
        "task": "demo smoke workflow"
      },
      "requires": [
        "browser-automation-studio"
      ]
    }
  ],
  "helpers": {
    "program": "1"
  },
  "inputs": {
    "k": {
      "default": 5,
      "description": "Maximum candidates returned (1..20).",
      "type": "integer"
    },
    "scenario": {
      "description": "Scenario whose bas/ assets workflow-health should search; without it that source is skipped.",
      "type": "string"
    },
    "task": {
      "description": "The browser task in plain words.",
      "required": true,
      "type": "string"
    }
  },
  "invariants": [
    "no binding with effect write or destructive is called",
    "at most k candidates are returned; no row set above 100 is materialized",
    "ai.classify runs at most once: to break a tie at the k boundary, or to judge persisted workflow names when no lexical candidate exists",
    "the envelope is printed exactly once, on every path",
    "No memory I/O: this is an S3 step; the usage skill owns recall and capture in bas-usage."
  ],
