{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "recordings": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": true,
        "subpath": "recordings",
        "rationale": "Completed browser recordings are reconstructible run evidence and are retained for seven days.",
        "budget": {
          "max_age": "7d",
          "rationale": "Retain seven days of recordings for active debugging; owner cleanup protects live executions."
        }
      },
      "captures": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": true,
        "subpath": "captures",
        "rationale": "Completed browser captures are reconstructible run evidence and are retained for seven days.",
        "budget": {
          "max_age": "7d",
          "rationale": "Retain seven days of captures for active debugging; owner cleanup protects live executions."
        }
      },
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "subpath": "projects",
        "regenerable": false,
        "rationale": "Scenario-owned project data is durable user work and is bounded independently from regenerable execution evidence.",
        "budget": {
          "max_bytes": "5GiB",
          "rationale": "Project definitions are durable user work; 10GiB is a workload-derived alarm ceiling independent of recording retention."
        }
      },
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage is retained for 30 days and reclaimed by age; the window is the workload retention requirement."
        }
      },
      "api_storage": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned API storage observed in the canonical API storage directory.",
        "subpath": "api/storage",
        "budget": {
          "max_bytes": "5GiB",
          "rationale": "The API database and durable metadata are bounded at 10GiB; execution evidence is governed by the recordings and captures entries."
        }
      },
      "seed_state": {
        "rung": "owned",
        "kind": "dir",
        "class": "state",
        "subpath": "seed",
        "regenerable": false,
        "rationale": "Seed identity preserves stable demo project and workflow IDs; 227 bytes were measured on 2026-08-27.",
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "The seed state measured 227 bytes on 2026-08-27; 1 MiB detects accidental payload growth without authorizing deletion."
        }
      }
    },
    "cleanup_providers": [
      {
        "id": "browser-automation-studio-recordings",
        "name": "Browser Automation Studio terminal recordings",
        "safety_tier": "safe_with_owner",
        "default_mode": "disabled",
        "default_approval": "owner"
      }
    ],
    "rationale": "Storage surfaces include durable project and seed state plus separately budgeted regenerable execution evidence."
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/openrouter",
        "field": "api-key",
        "label": "OpenRouter API key",
        "description": "User-provisioned OpenRouter credential used by the gateway-backed vision navigator. The value is never returned or stored in browser local storage.",
        "required": false,
        "obtain_url": "https://openrouter.ai/keys",
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/claude-code",
        "field": "anthropic-api-key",
        "label": "Claude Code Anthropic API key",
        "description": "Credential used by the Claude Code navigator through resource-claude-code. The value is never returned or stored in browser local storage.",
        "required": false,
        "obtain_url": "https://console.anthropic.com/settings/keys"
      },
      {
        "logical_id": "vrooli/lpbs-account",
        "field": "refresh-token",
        "label": "Vrooli subscription session",
        "description": "Device-scoped refresh credential shared by bundled scenarios. Access tokens remain in memory only.",
        "required": false
      }
    ]
  },
  "service": {
    "name": "browser-automation-studio",
    "displayName": "Vrooli Ascension",
    "description": "Visual browser automation studio with AI-powered workflow builder and real-time debugging",
    "version": "1.0.0",
    "tags": [
      "browser-automation",
      "visual-workflows",
      "screenshot-capture",
      "ui-testing",
      "web-scraping",
      "ai-debugging",
      "workflow-builder",
      "real-time-execution",
      "go-api",
      "react-ui",
      "sqlite-storage"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/browser-automation-studio"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Vrooli Ascension API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Visual workflow builder UI port",
      "range": "20000-24999"
    },
    "playwright_driver": {
      "env_var": "PLAYWRIGHT_DRIVER_PORT",
      "description": "Playwright driver HTTP server port",
      "range": "24400-24499"
    },
    "playwright_driver_frames": {
      "env_var": "PLAYWRIGHT_DRIVER_FRAMES_PORT",
      "description": "Playwright driver direct frame-streaming WebSocket port",
      "range": "24400-24499"
    },
    "playwright_driver_metrics": {
      "env_var": "PLAYWRIGHT_DRIVER_METRICS_PORT",
      "description": "Playwright driver Prometheus metrics port",
      "range": "24400-24499"
    }
  },
  "generation": { "template": { "id": "react-vite" } },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Vrooli Ascension health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 10000,
      "interval": 30000,
      "startup_grace_period": 15000
    }
  },
  "dependencies": {
    "resources": {
      "minio": {
        "type": "minio",
        "enabled": true,
        "required": true,
        "description": "Screenshot and artifact storage with S3-compatible API",
        "startup_policy": "must_start"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "AI workflow generation and debugging assistance",
        "model_roles": [
          "chat.small"
        ],
        "startup_policy": "try_start"
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (resource_cli)",
        "model_roles": [
          "chat.default"
        ],
        "startup_policy": "must_start"
      }
    },
    "scenarios": {
      "experience-manager": {
        "required": true,
        "version": "0.0.1",
        "versionRange": ">=0.0.1",
        "description": "Import-level dependency detected via go_import",
        "degraded_behavior": "Readiness-profile resolution is unavailable while experience-manager is stopped; capture and execution APIs continue with their bounded default readiness behavior.",
        "startup_policy": "must_start"
      },
      "landing-page-business-suite": {
        "required": true,
        "version": "0.0.1",
        "versionRange": ">=0.0.1",
        "description": "LPBS is the authoritative monetization and subscription provider",
        "runtime_only": true,
        "runtime_only_rationale": "BAS reaches LPBS through its configured entitlement HTTP boundary and the control-plane-discovered local port; no Go package import is expected or desirable across scenario modules.",
        "degraded_behavior": "LPBS-backed Class-A entitlement and shared-session operations report unavailable while the authority is stopped; local Class-B work remains usable under a still-valid cached lease.",
        "bundle_policy": "discover",
        "startup_policy": "must_start"
      },
      "ai-gateway": {
        "required": false,
        "startup_policy": "try_start",
        "runtime_only": true,
        "runtime_only_rationale": "Vision sidecar requests use the provider-neutral AI gateway HTTP boundary resolved at startup.",
        "degraded_behavior": "Managed vision calls fail closed while the AI gateway is unavailable."
      }
    }
  },
  "hostTools": [
    {
      "name": "ffmpeg",
      "required": false,
      "reason": "Render replay exports and media conversions for browser automation playback artifacts",
      "when": [
        "setup",
        "develop"
      ],
      "notes": "Replay export features degrade when ffmpeg is unavailable"
    }
  ],
  "tier_feasibility": {
    "metadata_version": 1,
    "tiers": {
      "tier-1-local": {
        "requirements": {
          "ram_mb": 8192,
          "disk_mb": 12288,
          "cpu_cores": 4,
          "network": "required",
          "bucket": "large",
          "source": "estimated",
          "confidence": "medium"
        },
        "notes": "Runs today via Tier 1 local stack. Access is through app-monitor + Cloudflare tunnel. Persistent storage is local SQLite via api-core/storage.",
        "artifacts": [
          {
            "type": "cloudflare-proxy",
            "producer": "app-monitor",
            "status": "available",
            "notes": "Standard Tier 1 exposure via Cloudflare Zero Trust"
          }
        ]
      },
      "tier-2-desktop": {
        "requirements": {
          "ram_mb": 6144,
          "disk_mb": 8192,
          "cpu_cores": 4,
          "network": "optional",
          "bucket": "large",
          "source": "estimated",
          "confidence": "low"
        },
        "adaptations": [
          {
            "dependency": "playwright-driver",
            "swap": "playwright-packaged-sidecar",
            "impact": "Ship the built driver and its Node dependencies as an Electron bundle asset; the API supervises it locally",
            "effort_days": 0,
            "notes": "Implemented by bundle/bundle.json and the API sidecar supervisor"
          },
          {
            "dependency": "minio",
            "swap": "filesystem-store",
            "impact": "Store artifacts in user data folder",
            "effort_days": 0,
            "notes": "Implemented by BAS_SCREENSHOT_STORAGE=local in the desktop bundle"
          }
        ],
        "notes": "Desktop ships the API, UI, CLI, supervised Playwright driver, and SQLite-backed local artifact storage; no MinIO or remote API is required for the bundled runtime.",
        "artifacts": [
          {
            "type": "electron-app",
            "producer": "scenario-to-desktop",
            "status": "bundled",
            "notes": "Bundle proof stages the BAS API, UI, CLI, Playwright driver dist, and node_modules; monetized Class A calls remain LPBS-authorized."
          }
        ]
      },
      "tier-3-mobile": {
        "notes": "Needs entirely different orchestration model"
      },
      "tier-4-saas": {
        "requirements": {
          "ram_mb": 10240,
          "disk_mb": 16384,
          "cpu_cores": 6,
          "network": "required",
          "bucket": "large",
          "source": "estimated",
          "confidence": "low"
        },
        "notes": "Viable once deployment-manager can provision Playwright driver pools and managed storage"
      },
      "tier-5-enterprise": {
        "notes": "Follows SaaS path but with hardened secrets + monitoring"
      }
    },
    "dependencies": {
      "resources": {
        "playwright-driver": {
          "resource_type": "browser-automation",
          "footprint": {
            "ram_mb": 768,
            "disk_mb": 512,
            "cpu_cores": 1,
            "network": "optional",
            "source": "estimated",
            "confidence": "low"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Non-Docker Node driver on localhost"
            },
            "tier-2-desktop": {
              "supported": true,
              "notes": "Packaged driver spawned by Electron; reuse bundled Chromium via PLAYWRIGHT_CHROMIUM_PATH when possible"
            }
          },
          "swappable_with": [
            {
              "id": "playwright-packaged",
              "relationship": "future",
              "notes": "Compiled runner bundled directly into desktop/mobile builds"
            }
          ],
          "packaging_hints": [
            "Bundle driver/server.js with desktop app",
            "If not reusing Electron Chromium, include @playwright/browser-chromium per platform"
          ]
        },
        "minio": {
          "resource_type": "object-storage",
          "footprint": {
            "ram_mb": 512,
            "disk_mb": 2048,
            "cpu_cores": 1,
            "network": "required",
            "source": "estimated",
            "confidence": "medium"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Shared MinIO resource"
            },
            "tier-2-desktop": {
              "supported": true,
              "notes": "BAS desktop selects its local filesystem artifact store; MinIO is not started or shipped."
            },
            "tier-4-saas": {
              "supported": true,
              "notes": "Map to S3/Spaces bucket"
            }
          },
          "packaging_hints": [
            "Provide lifecycle policy for screenshots"
          ]
        },
        "ollama": {
          "resource_type": "llm-server",
          "footprint": {
            "ram_mb": 4096,
            "disk_mb": 8192,
            "cpu_cores": 4,
            "gpu": false,
            "network": "optional",
            "source": "estimated",
            "confidence": "low"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional but heavy"
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "Model download sizes exceed desktop bundle budget",
              "alternatives": [
                "openrouter"
              ]
            }
          },
          "swappable_with": [
            {
              "id": "openrouter",
              "relationship": "cloud-llm",
              "notes": "Prompt user for API key"
            }
          ]
        },
        "openrouter": {
          "resource_type": "llm-api",
          "footprint": {
            "network": "required",
            "source": "manual",
            "confidence": "medium"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Used when Ollama disabled"
            },
            "tier-2-desktop": {
              "supported": true,
              "reason": "Requires user-provided API key and network"
            }
          },
          "packaging_hints": [
            "Prompt users for key on first launch"
          ]
        }
      },
      "scenarios": {}
    }
  },
  "cli": {
    "enabled": true,
    "command": "browser-automation-studio",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "browser-automation-studio"
    },
    "freshness": {
      "inputs": [
        "api/**",
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "env": {
          "REQUEST_TIMEOUT_MS": "7200000",
          "SESSION_IDLE_TIMEOUT_MS": "7200000",
          "BAS_DRIVER_EXECUTION_TIMEOUT_MS": "7200000",
          "BAS_EXECUTION_MAX_TIMEOUT_MS": "7200000",
          "PLAYWRIGHT_DRIVER_URL": "http://127.0.0.1:${PLAYWRIGHT_DRIVER_PORT}"
        },
        "port": "api",
        "data_dirs": [
          "data/executions",
          "data/screenshots",
          "data/workflows"
        ],
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    },
    "playwright-driver": {
      "role": "sidecar",
      "build": {
        "kind": "node_bundle",
        "dir": "playwright-driver",
        "output": "playwright-driver/dist/server.js"
      },
      "run": {
        "argv": [
          "node",
          "dist/server.js"
        ],
        "cwd": "playwright-driver",
        "port": "playwright_driver",
        "env": {
          "METRICS_PORT": "${PLAYWRIGHT_DRIVER_METRICS_PORT}",
          "FRAME_STREAM_DIRECT_PORT": "${PLAYWRIGHT_DRIVER_FRAMES_PORT}"
        },
        "supervised_by": "api"
      }
    }
  }
}
