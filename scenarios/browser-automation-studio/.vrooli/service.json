{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "name": "browser-automation-studio",
    "displayName": "Vrooli Ascension",
    "description": "Visual browser automation studio with AI-powered workflow builder and real-time debugging",
    "version": "1.0.0",
    "tags": [
      "browser-automation",
      "visual-workflows",
      "screenshot-capture",
      "ui-testing",
      "web-scraping",
      "ai-debugging",
      "workflow-builder",
      "real-time-execution",
      "go-api",
      "react-ui",
      "sqlite-storage"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/browser-automation-studio"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Vrooli Ascension API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Visual workflow builder UI port",
      "range": "35000-39999"
    },
    "websocket": {
      "env_var": "WS_PORT",
      "description": "WebSocket port for real-time updates",
      "range": "25000-29999"
    },
    "playwright_driver": {
      "env_var": "PLAYWRIGHT_DRIVER_PORT",
      "description": "Playwright driver HTTP server port",
      "range": "39400-39499"
    }
  },
  "hostTools": [
    {
      "name": "ffmpeg",
      "required": false,
      "reason": "Render replay exports and media conversions for browser automation playback artifacts",
      "when": [
        "setup",
        "develop"
      ],
      "notes": "Replay export features degrade when ffmpeg is unavailable"
    }
  ],
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Vrooli Ascension health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 10000,
      "interval": 30000,
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Initialize Vrooli Ascension",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/browser-automation-studio-api"
            ]
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "playwright-driver/dist/server.js",
            "source_dir": "playwright-driver/src"
          },
          {
            "type": "cli",
            "command": "browser-automation-studio",
            "targets": [
              "browser-automation-studio"
            ]
          },
          {
            "type": "directories",
            "targets": ["initialization/storage/sqlite"]
          }
        ]
      },
      "steps": [
        {
          "name": "create-data-dirs",
          "run": "mkdir -p data/workflows data/executions data/screenshots",
          "description": "Create data directories for workflow storage"
        },
        {
          "name": "build-api",
          "run": "cd api && go mod download && go build -o browser-automation-studio-api .",
          "description": "Build Go API binary"
        },
        {
          "name": "install-ui-deps",
          "run": "cd ui && if [ -f package.json ]; then pnpm install --ignore-workspace; else echo 'No package.json found, skipping pnpm install'; fi",
          "description": "Install React UI dependencies"
        },
        {
          "name": "build-ui",
          "run": "cd ui && pnpm run build",
          "description": "Build React UI for production"
        },
        {
          "name": "install-playwright-driver-deps",
          "run": "cd playwright-driver && pnpm install --ignore-workspace",
          "description": "Install Playwright driver dependencies"
        },
        {
          "name": "build-playwright-driver",
          "run": "cd playwright-driver && pnpm run build",
          "description": "Build Playwright driver for production"
        }
      ]
    },
    "develop": {
      "description": "Start browser automation studio with production UI bundle",
      "steps": [
        {
          "name": "start-playwright-driver",
          "run": "echo 'ℹ️  Playwright driver lifecycle managed by API sidecar supervisor'",
          "description": "Skipped - API manages playwright driver lifecycle via sidecar supervisor. Set BAS_SIDECAR_ENABLED=false or PLAYWRIGHT_DRIVER_URL to use external driver."
        },
        {
          "name": "start-api",
          "run": "if [ -z \"${PLAYWRIGHT_DRIVER_URL:-}\" ]; then export PLAYWRIGHT_DRIVER_URL=\"http://127.0.0.1:${PLAYWRIGHT_DRIVER_PORT}\"; fi; cd api && ./browser-automation-studio-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/browser-automation-studio-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "description": "Start Express server with built React app",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Comprehensive phased testing for browser-automation-studio",
      "steps": [
        {
          "name": "run-phased-tests",
          "run": "test-genie execute browser-automation-studio --preset comprehensive",
          "description": "Execute phased scenario test suite"
        }
      ]
    },
    "stop": {
      "description": "Stop all browser automation studio services",
      "steps": [
        {
          "name": "stop-playwright-driver",
          "run": "pkill -f 'playwright-driver.*server' || true; pkill -f 'node.*playwright-driver/dist/server.js' || true",
          "description": "Stop scenario-managed Playwright driver if running"
        },
        {
          "name": "stop-api",
          "run": "pkill -f \"browser-automation-studio-api\" || true; sleep 1; pkill -9 -f \"browser-automation-studio-api\" 2>/dev/null || true",
          "description": "Stop API process"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f \"scenarios/browser-automation-studio.*vite\" || true; sleep 1; pkill -9 -f \"scenarios/browser-automation-studio.*vite\" 2>/dev/null || true",
          "description": "Stop UI process"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "minio": {
        "type": "minio",
        "enabled": true,
        "required": true,
        "description": "Screenshot and artifact storage with S3-compatible API"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "description": "AI workflow generation and debugging assistance"
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (resource_cli)"
      }
    },
    "scenarios": {}
  },
  "deployment": {
    "metadata_version": 1,
    "last_analyzed_at": "2024-03-28T01:30:00Z",
    "analyzer": {
      "name": "manual-draft",
      "version": "0.1"
    },
    "aggregate_requirements": {
      "ram_mb": 8192,
      "disk_mb": 12288,
      "cpu_cores": 4,
      "gpu": false,
      "network": "required",
      "storage_mb_per_user": 200,
      "startup_time_ms": 45000,
      "bucket": "large",
      "source": "estimated",
      "confidence": "medium"
    },
    "tiers": {
      "tier-1-local": {
        "status": "ready",
        "fitness_score": 0.85,
        "constraints": [
          "Requires full Vrooli stack with browserless Chromium workers and app-monitor proxy",
          "Needs outbound network for OpenRouter fallback when Ollama disabled"
        ],
        "requirements": {
          "ram_mb": 8192,
          "disk_mb": 12288,
          "cpu_cores": 4,
          "network": "required",
          "bucket": "large",
          "source": "estimated",
          "confidence": "medium"
        },
        "notes": "Runs today via Tier 1 local stack. Access is through app-monitor + Cloudflare tunnel. Persistent storage is local SQLite via api-core/storage.",
        "secrets": [
          {
            "secret_id": "browserless/api-key",
            "classification": "infrastructure",
            "notes": "Never ships with desktop bundles"
          },
          {
            "secret_id": "openrouter/api-key",
            "classification": "user",
            "notes": "Prompt desktop users for their own API key when using remote LLMs"
          }
        ],
        "artifacts": [
          {
            "type": "cloudflare-proxy",
            "producer": "app-monitor",
            "status": "available",
            "notes": "Standard Tier 1 exposure via Cloudflare Zero Trust"
          }
        ]
      },
      "tier-2-desktop": {
        "status": "limited",
        "fitness_score": 0.5,
        "constraints": [
          "Browserless requires bundled Playwright runner",
          "MinIO requires background server and credentials",
          "Secrets must be provisioned at install time"
        ],
        "requirements": {
          "ram_mb": 6144,
          "disk_mb": 8192,
          "cpu_cores": 4,
          "network": "optional",
          "bucket": "large",
          "source": "estimated",
          "confidence": "low"
        },
        "adaptations": [
          {
            "dependency": "browserless",
            "swap": "playwright-packaged",
            "impact": "Compile Playwright into the Electron app to avoid remote dependency",
            "effort_days": 5,
            "notes": "Requires custom runner and sandbox hardening"
          },
          {
            "dependency": "minio",
            "swap": "filesystem-store",
            "impact": "Store artifacts in user data folder",
            "effort_days": 2
          }
        ],
        "notes": "Storage runs as embedded SQLite via api-core/storage. scenario-to-desktop currently ships a thin client only; full bundling blocked until browserless and minio swaps are executed.",
        "artifacts": [
          {
            "type": "electron-app",
            "producer": "scenario-to-desktop",
            "status": "thin-client",
            "notes": "UI bundle works but depends on remote API"
          }
        ]
      },
      "tier-3-mobile": {
        "status": "blocked",
        "fitness_score": 0.1,
        "constraints": [
          "Browser automation requires Chromium which is unavailable on mobile",
          "Resource footprint exceeds mobile limits"
        ],
        "notes": "Needs entirely different orchestration model"
      },
      "tier-4-saas": {
        "status": "limited",
        "fitness_score": 0.6,
        "constraints": [
          "Requires deployment-manager driven packaging of dependent resources",
          "Needs secrets templating + Terraform/K8s automation"
        ],
        "requirements": {
          "ram_mb": 10240,
          "disk_mb": 16384,
          "cpu_cores": 6,
          "network": "required",
          "bucket": "large",
          "source": "estimated",
          "confidence": "low"
        },
        "notes": "Viable once deployment-manager can provision Browserless pools and managed storage"
      },
      "tier-5-enterprise": {
        "status": "limited",
        "fitness_score": 0.55,
        "constraints": [
          "Secrets segregation + air-gapped resource support not implemented",
          "Requires on-prem Browserless fleet management"
        ],
        "notes": "Follows SaaS path but with hardened secrets + monitoring"
      }
    },
    "dependencies": {
      "resources": {
        "browserless": {
          "resource_type": "browser-automation",
          "footprint": {
            "ram_mb": 2048,
            "disk_mb": 512,
            "cpu_cores": 2,
            "network": "required",
            "source": "estimated",
            "confidence": "medium"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "fitness_score": 0.85,
              "notes": "Managed via shared Browserless resource"
            },
            "tier-2-desktop": {
              "supported": false,
              "fitness_score": 0.1,
              "reason": "Electron cannot embed headless Chromium + Node cluster today",
              "alternatives": [
                "playwright-packaged"
              ]
            },
            "tier-4-saas": {
              "supported": true,
              "fitness_score": 0.6,
              "notes": "Needs auto-scaling pool"
            }
          },
          "swappable_with": [
            {
              "id": "playwright-packaged",
              "relationship": "future",
              "notes": "Potential compiled runner for desktop/mobile"
            }
          ],
          "packaging_hints": [
            "Requires Puppeteer-compatible fonts + sandbox syscalls"
          ]
        },
        "playwright-driver": {
          "resource_type": "browser-automation",
          "footprint": {
            "ram_mb": 768,
            "disk_mb": 512,
            "cpu_cores": 1,
            "network": "optional",
            "source": "estimated",
            "confidence": "low"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "fitness_score": 0.75,
              "notes": "Non-Docker Node driver on localhost"
            },
            "tier-2-desktop": {
              "supported": true,
              "fitness_score": 0.9,
              "notes": "Packaged driver spawned by Electron; reuse bundled Chromium via PLAYWRIGHT_CHROMIUM_PATH when possible"
            }
          },
          "swappable_with": [
            {
              "id": "browserless",
              "relationship": "fallback",
              "notes": "Use when remote pool is available"
            }
          ],
          "packaging_hints": [
            "Bundle driver/server.js with desktop app",
            "If not reusing Electron Chromium, include @playwright/browser-chromium per platform"
          ]
        },
        "minio": {
          "resource_type": "object-storage",
          "footprint": {
            "ram_mb": 512,
            "disk_mb": 2048,
            "cpu_cores": 1,
            "network": "required",
            "source": "estimated",
            "confidence": "medium"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "fitness_score": 0.8,
              "notes": "Shared MinIO resource"
            },
            "tier-2-desktop": {
              "supported": false,
              "fitness_score": 0.3,
              "reason": "Requires bundled object storage process",
              "alternatives": [
                "filesystem-store"
              ]
            },
            "tier-4-saas": {
              "supported": true,
              "fitness_score": 0.7,
              "notes": "Map to S3/Spaces bucket"
            }
          },
          "packaging_hints": [
            "Provide lifecycle policy for screenshots"
          ]
        },
        "ollama": {
          "resource_type": "llm-server",
          "footprint": {
            "ram_mb": 4096,
            "disk_mb": 8192,
            "cpu_cores": 4,
            "gpu": false,
            "network": "optional",
            "source": "estimated",
            "confidence": "low"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "fitness_score": 0.6,
              "notes": "Optional but heavy"
            },
            "tier-2-desktop": {
              "supported": false,
              "fitness_score": 0.2,
              "reason": "Model download sizes exceed desktop bundle budget",
              "alternatives": [
                "openrouter"
              ]
            }
          },
          "swappable_with": [
            {
              "id": "openrouter",
              "relationship": "cloud-llm",
              "notes": "Prompt user for API key"
            }
          ]
        },
        "openrouter": {
          "resource_type": "llm-api",
          "footprint": {
            "network": "required",
            "source": "manual",
            "confidence": "medium"
          },
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "fitness_score": 0.7,
              "notes": "Used when Ollama disabled"
            },
            "tier-2-desktop": {
              "supported": true,
              "fitness_score": 0.5,
              "reason": "Requires user-provided API key and network"
            }
          },
          "packaging_hints": [
            "Prompt users for key on first launch"
          ]
        }
      },
      "scenarios": {}
    }
  },
  "cli": {
    "enabled": true,
    "command": "browser-automation-studio",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "browser-automation-studio"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  }
}
