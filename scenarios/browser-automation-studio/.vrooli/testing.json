{
  "$schema": "../../test-genie/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for browser-automation-studio",
    "last_updated": "2025-11-07T03:45:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "error",
        "cli": "error"
      },
      "unmatched_code_components": "warning"
    }
  },
  "phases": {
    "unit": {
      "timeout": "300s"
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "options": {
      "verbose": true
    },
    "policy_profile": {
      "version": "1.0.0",
      "template": {
        "id": "react-vite",
        "scenario_class": "react-vite"
      },
      "required_roles": [
        {
          "role": "api",
          "policy_class": "go_service",
          "match": {
            "surface_id": "api",
            "kind": "api",
            "path": "api",
            "language": "go"
          }
        },
        {
          "role": "cli",
          "policy_class": "go_cli",
          "match": {
            "surface_id": "cli",
            "kind": "cli",
            "path": "cli",
            "language": "go"
          }
        },
        {
          "role": "ui",
          "policy_class": "react_vite_ui",
          "match": {
            "surface_id": "ui",
            "kind": "ui",
            "path": "ui",
            "language": "typescript",
            "framework": "vite"
          }
        }
      ],
      "policy_classes": {
        "go_service": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "api/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          }
        },
        "go_cli": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "cli/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          }
        },
        "react_vite_ui": {
          "language": "typescript",
          "framework": "vitest",
          "package_manager": "pnpm",
          "coverage": {
            "minimum_percent": 85,
            "mode": "both",
            "provider": "v8",
            "reporters": [
              "text",
              "json-summary",
              "json"
            ]
          },
          "test_utils": {
            "required_roots": [
              "ui/src/test-utils"
            ],
            "production_import_ban": true,
            "canonical_render_helper": "ui/src/test-utils/renderWithProviders.tsx"
          },
          "projection": {
            "required_files": [
              "ui/vite.config.ts",
              "ui/src/test-setup.ts",
              "ui/src/test-utils/renderWithProviders.tsx"
            ],
            "required_scripts": [
              "test",
              "test:coverage"
            ],
            "vitest": {
              "environment": "jsdom",
              "setup_files": [
                "./src/test-setup.ts"
              ],
              "coverage_provider": "v8"
            }
          }
        }
      },
      "customization": {
        "mode": "monotonic",
        "waivers": []
      }
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      },
      "websockets": {
        "enabled": true
      }
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true,
        "targets": [
          {
            "name": "UI bundle",
            "path": "ui/dist",
            "max_size_kb": 1000,
            "warn_size_kb": 800,
            "exclude_patterns": [
              "*.map",
              "*.LICENSE.txt"
            ]
          }
        ]
      },
      "response_time": {
        "enabled": true,
        "endpoints": [
          {
            "path": "/health",
            "max_ms": 100,
            "warn_ms": 50,
            "iterations": 10
          },
          {
            "path": "/api/v1/projects",
            "max_ms": 500,
            "warn_ms": 300,
            "iterations": 5,
            "requirement": "BAS-PERF-PROJECTS-API"
          }
        ]
      }
    },
    "options": {
      "continue_on_failure": true
    }
  }
}
