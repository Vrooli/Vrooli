{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "browser-automation-studio",
  "description": "Browser Automation Studio CLI surface. Single source of truth for command groups, flag shapes, governance metadata, and proto-method bindings. Cross-validated at test time against generated Connect service descriptors (see cli/capture/manifest_proto_test.go). Manifest-driven command dispatch is being adopted incrementally per the proto+Connect migration plan; hand-coded domains continue to register through cli/domains until migrated.",
  "groups": [
    {
      "name": "capture",
      "description": "Capture screenshot/console/network/video/DOM/performance artifacts from a single page load",
      "commands": [
        {
          "name": "capture",
          "description": "Capture artifacts from a single page load",
          "flags": [
            { "name": "url", "required": true, "description": "Target URL to load" },
            { "name": "captures", "description": "Comma-separated artifact types: screenshot,console,network,video,dom,performance" },
            { "name": "dimensions", "description": "Preset viewport: mobile|tablet|desktop" },
            { "name": "width", "description": "Viewport width (overrides dimensions)" },
            { "name": "height", "description": "Viewport height (overrides dimensions)" },
            { "name": "device-scale-factor", "description": "Viewport device scale factor" },
            { "name": "wait-for", "description": "Wait condition before capture (load|networkidle|selector:...)" },
            { "name": "out-dir", "description": "Output directory for artifact files" },
            { "name": "label", "description": "Optional label tagged onto every produced artifact" },
            { "name": "json", "bool": true, "description": "Emit raw CaptureResponse JSON instead of report" },
            { "name": "dry-run", "bool": true, "description": "Send X-Dry-Run header; server validates without producing artifacts" }
          ],
          "binding": { "kind": "connect-rpc", "service": "CaptureService", "method": "Capture" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "network:external", "filesystem:write"]
          }
        }
      ]
    },
    {
      "name": "scenarios",
      "description": "Discover sibling scenarios on the host and resolve their HTTP ports.",
      "commands": [
        {
          "name": "list",
          "description": "List every scenario known to the local vrooli CLI, with status.",
          "binding": { "kind": "connect-rpc", "service": "ScenariosService", "method": "List" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "port",
          "description": "Get the primary HTTP port and resolved base URL for a scenario by name.",
          "positionals": [
            { "name": "name", "required": true, "description": "Scenario slug (e.g. notes, calendar)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ScenariosService", "method": "GetPort" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "tools",
      "description": "Tool Discovery + Execution Protocol surface (cross-scenario agent integration).",
      "commands": [
        {
          "name": "list",
          "description": "List every tool this scenario advertises via the Tool Discovery Protocol.",
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "List" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Fetch the definition of a single tool by name.",
          "positionals": [
            { "name": "name", "required": true, "description": "Tool slug (e.g. execute_workflow)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "Get" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "execute",
          "description": "Invoke a tool with JSON arguments.",
          "positionals": [
            { "name": "name", "required": true, "description": "Tool slug to invoke" }
          ],
          "flags": [
            { "name": "args", "description": "JSON object of tool arguments (default: {})" },
            { "name": "args-file", "description": "Path to a JSON file with tool arguments" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "Execute" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "schema",
      "description": "Workflow JSON-Schema and step-definition discovery.",
      "commands": [
        {
          "name": "workflow",
          "description": "Get the workflow JSON-Schema. Filter by --nodes a,b,c to keep only listed node types.",
          "flags": [
            { "name": "nodes", "description": "Comma-separated node-type filter" },
            { "name": "output", "description": "Write schema to file instead of stdout" }
          ],
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetWorkflowSchema" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "node-types",
          "description": "List every node-type slug defined by the workflow schema.",
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetNodeTypes" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "steps",
          "description": "List CLI step definitions. Filter by --types a,b,c or restrict to CLI-supported steps with --cli-only.",
          "flags": [
            { "name": "types", "description": "Comma-separated step-type filter" },
            { "name": "cli-only", "bool": true, "description": "Only return CLI-supported step types" },
            { "name": "format", "description": "Output format: text (default), json, markdown" }
          ],
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetStepDefinitions" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "entitlement",
      "description": "Subscription status, identity, usage, dev overrides, and entitlement API source.",
      "commands": [
        {
          "name": "status",
          "description": "Show the current entitlement status (tier, features, usage, AI credits).",
          "flags": [
            { "name": "user", "description": "Override resolved user identity (default: server-side fallback chain)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetStatus" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-get",
          "description": "Show the persisted user identity (email).",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetIdentity" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-set",
          "description": "Persist a user identity (email) and refresh status.",
          "positionals": [
            { "name": "email", "required": true, "description": "Email to persist (must contain @ if non-empty)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetIdentity" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-clear",
          "description": "Clear the persisted user identity (logout).",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearIdentity" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "refresh",
          "description": "Invalidate cached entitlement for a user and return fresh status.",
          "positionals": [
            { "name": "user", "required": true, "description": "User identity (email) to refresh" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "RefreshStatus" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "usage",
          "description": "Show the unified credit usage summary for the current billing period.",
          "flags": [
            { "name": "user", "description": "User identity (email)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetUsage" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "usage-history",
          "description": "Show usage summaries across multiple billing periods.",
          "flags": [
            { "name": "user", "description": "User identity (email)" },
            { "name": "months", "description": "Number of months to retrieve (default 6)" },
            { "name": "offset", "description": "Months to skip from current (default 0)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetUsageHistory" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "operations",
          "description": "Show the paginated operation log for a billing month.",
          "flags": [
            { "name": "user", "description": "User identity (email)" },
            { "name": "month", "description": "YYYY-MM (default: current billing month)" },
            { "name": "category", "description": "Optional category filter: ai | execution | export" },
            { "name": "limit", "description": "Page size (default 20)" },
            { "name": "offset", "description": "Starting offset (default 0)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetOperationLog" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-get",
          "description": "Show the active dev override tier, or empty if unset.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetOverride" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-set",
          "description": "Install a dev override tier (empty value clears it).",
          "positionals": [
            { "name": "tier", "required": true, "description": "Subscription tier (free|solo|pro|studio|business) or empty to clear" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetOverride" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-clear",
          "description": "Remove any active dev override tier.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearOverride" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-get",
          "description": "Show the entitlement API source (production|local|disabled) and configured local port.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetApiSource" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-set",
          "description": "Set the entitlement API source and optional local LPBS port.",
          "positionals": [
            { "name": "source", "required": true, "description": "production | local | disabled" }
          ],
          "flags": [
            { "name": "local-port", "description": "Port the local LPBS API listens on (optional)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetApiSource" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-clear",
          "description": "Reset the entitlement API source back to production.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearApiSource" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "project-files",
      "description": "Project file tree, read/write workflow files, move/delete/resync, and OS reveal/open.",
      "commands": [
        {
          "name": "tree",
          "description": "List the file tree (folders + workflow files + indexed assets) for a project.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "GetProjectFileTree" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:read"]
          }
        },
        {
          "name": "read",
          "description": "Read a workflow JSON file as a WorkflowSummary message.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "path", "required": true, "description": "Project-root-relative workflow JSON path" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "ReadProjectFile" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:read"]
          }
        },
        {
          "name": "mkdir",
          "description": "Create a directory (with parents) inside the project root.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "path", "required": true, "description": "Project-root-relative directory path" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "MkdirProjectPath" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "write",
          "description": "Persist a new workflow JSON file (refuses overwrite).",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "path", "required": true, "description": "Project-root-relative .json path" },
            { "name": "name", "description": "Workflow display name (defaults to filename stem)" },
            { "name": "type", "description": "Workflow type: action | flow | case" },
            { "name": "description", "description": "Optional workflow description" },
            { "name": "tags", "description": "Comma-separated tags" },
            { "name": "flow-file", "description": "Path to a JSON file containing the WorkflowDefinitionV2 body" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "WriteProjectWorkflowFile" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "move",
          "description": "Rename or move a file/folder inside the project root.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "from-path", "required": true, "description": "Project-root-relative source path" },
            { "name": "to-path", "required": true, "description": "Project-root-relative target path" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "MoveProjectFile" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "delete",
          "description": "Delete a file or directory (recursive) inside the project root.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "path", "required": true, "description": "Project-root-relative path to remove" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "DeleteProjectFile" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "resync",
          "description": "Force a filesystem -> DB resync; report indexed counts.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "ResyncProjectFiles" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:read"]
          }
        },
        {
          "name": "reveal",
          "description": "Reveal a project file (or open a folder) in the system file manager.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "path", "required": true, "description": "Project-root-relative path" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "RevealProjectPath" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["filesystem:read"]
          }
        },
        {
          "name": "open-folder",
          "description": "Open the project root folder in the system file manager.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectFilesService", "method": "OpenProjectFolder" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["filesystem:read"]
          }
        }
      ]
    }
  ],
  "omitted": []
}
