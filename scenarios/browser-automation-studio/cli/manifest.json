{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "browser-automation-studio",
  "description": "Browser Automation Studio CLI surface. Single source of truth for command groups, flag shapes, governance metadata, and proto-method bindings. Cross-validated at test time against generated Connect service descriptors (see cli/capture/manifest_proto_test.go). Manifest-driven command dispatch is being adopted incrementally per the proto+Connect migration plan; hand-coded domains continue to register through cli/domains until migrated.",
  "groups": [
    {
      "name": "capture",
      "description": "Capture screenshot/console/network/video/DOM/performance artifacts from a single page load",
      "commands": [
        {
          "name": "capture",
          "description": "Capture artifacts from a single page load",
          "flags": [
            { "name": "url", "required": true, "description": "Target URL to load" },
            { "name": "captures", "description": "Comma-separated artifact types: screenshot,console,network,video,dom,performance" },
            { "name": "dimensions", "description": "Preset viewport: mobile|tablet|desktop" },
            { "name": "width", "description": "Viewport width (overrides dimensions)" },
            { "name": "height", "description": "Viewport height (overrides dimensions)" },
            { "name": "device-scale-factor", "description": "Viewport device scale factor" },
            { "name": "wait-for", "description": "Wait condition before capture (load|networkidle|selector:...)" },
            { "name": "out-dir", "description": "Output directory for artifact files" },
            { "name": "label", "description": "Optional label tagged onto every produced artifact" },
            { "name": "json", "bool": true, "description": "Emit raw CaptureResponse JSON instead of report" },
            { "name": "dry-run", "bool": true, "description": "Send X-Dry-Run header; server validates without producing artifacts" }
          ],
          "binding": { "kind": "connect-rpc", "service": "CaptureService", "method": "Capture" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "network:external", "filesystem:write"]
          }
        }
      ]
    },
    {
      "name": "scenarios",
      "description": "Discover sibling scenarios on the host and resolve their HTTP ports.",
      "commands": [
        {
          "name": "list",
          "description": "List every scenario known to the local vrooli CLI, with status.",
          "binding": { "kind": "connect-rpc", "service": "ScenariosService", "method": "List" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "port",
          "description": "Get the primary HTTP port and resolved base URL for a scenario by name.",
          "positionals": [
            { "name": "name", "required": true, "description": "Scenario slug (e.g. notes, calendar)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ScenariosService", "method": "GetPort" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "tools",
      "description": "Tool Discovery + Execution Protocol surface (cross-scenario agent integration).",
      "commands": [
        {
          "name": "list",
          "description": "List every tool this scenario advertises via the Tool Discovery Protocol.",
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "List" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Fetch the definition of a single tool by name.",
          "positionals": [
            { "name": "name", "required": true, "description": "Tool slug (e.g. execute_workflow)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "Get" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "execute",
          "description": "Invoke a tool with JSON arguments.",
          "positionals": [
            { "name": "name", "required": true, "description": "Tool slug to invoke" }
          ],
          "flags": [
            { "name": "args", "description": "JSON object of tool arguments (default: {})" },
            { "name": "args-file", "description": "Path to a JSON file with tool arguments" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ToolsService", "method": "Execute" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "schema",
      "description": "Workflow JSON-Schema and step-definition discovery.",
      "commands": [
        {
          "name": "workflow",
          "description": "Get the workflow JSON-Schema. Filter by --nodes a,b,c to keep only listed node types.",
          "flags": [
            { "name": "nodes", "description": "Comma-separated node-type filter" },
            { "name": "output", "description": "Write schema to file instead of stdout" }
          ],
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetWorkflowSchema" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "node-types",
          "description": "List every node-type slug defined by the workflow schema.",
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetNodeTypes" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "steps",
          "description": "List CLI step definitions. Filter by --types a,b,c or restrict to CLI-supported steps with --cli-only.",
          "flags": [
            { "name": "types", "description": "Comma-separated step-type filter" },
            { "name": "cli-only", "bool": true, "description": "Only return CLI-supported step types" },
            { "name": "format", "description": "Output format: text (default), json, markdown" }
          ],
          "binding": { "kind": "connect-rpc", "service": "SchemaService", "method": "GetStepDefinitions" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "entitlement",
      "description": "Subscription status, identity, usage, dev overrides, and entitlement API source.",
      "commands": [
        {
          "name": "status",
          "description": "Show the current entitlement status (tier, features, usage, AI credits).",
          "flags": [
            { "name": "user", "description": "Override resolved user identity (default: server-side fallback chain)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetStatus" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-get",
          "description": "Show the persisted user identity (email).",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetIdentity" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-set",
          "description": "Persist a user identity (email) and refresh status.",
          "positionals": [
            { "name": "email", "required": true, "description": "Email to persist (must contain @ if non-empty)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetIdentity" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "identity-clear",
          "description": "Clear the persisted user identity (logout).",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearIdentity" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "refresh",
          "description": "Invalidate cached entitlement for a user and return fresh status.",
          "positionals": [
            { "name": "user", "required": true, "description": "User identity (email) to refresh" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "RefreshStatus" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "usage",
          "description": "Show the unified credit usage summary for the current billing period.",
          "flags": [
            { "name": "user", "description": "User identity (email)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetUsage" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "usage-history",
          "description": "Show usage summaries across multiple billing periods.",
          "flags": [
            { "name": "user", "description": "User identity (email)" },
            { "name": "months", "description": "Number of months to retrieve (default 6)" },
            { "name": "offset", "description": "Months to skip from current (default 0)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetUsageHistory" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "operations",
          "description": "Show the paginated operation log for a billing month.",
          "flags": [
            { "name": "user", "description": "User identity (email)" },
            { "name": "month", "description": "YYYY-MM (default: current billing month)" },
            { "name": "category", "description": "Optional category filter: ai | execution | export" },
            { "name": "limit", "description": "Page size (default 20)" },
            { "name": "offset", "description": "Starting offset (default 0)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetOperationLog" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-get",
          "description": "Show the active dev override tier, or empty if unset.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetOverride" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-set",
          "description": "Install a dev override tier (empty value clears it).",
          "positionals": [
            { "name": "tier", "required": true, "description": "Subscription tier (free|solo|pro|studio|business) or empty to clear" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetOverride" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "override-clear",
          "description": "Remove any active dev override tier.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearOverride" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-get",
          "description": "Show the entitlement API source (production|local|disabled) and configured local port.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "GetApiSource" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-set",
          "description": "Set the entitlement API source and optional local LPBS port.",
          "positionals": [
            { "name": "source", "required": true, "description": "production | local | disabled" }
          ],
          "flags": [
            { "name": "local-port", "description": "Port the local LPBS API listens on (optional)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "SetApiSource" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "api-source-clear",
          "description": "Reset the entitlement API source back to production.",
          "binding": { "kind": "connect-rpc", "service": "EntitlementService", "method": "ClearApiSource" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "projects",
      "description": "Project CRUD + project-scoped workflow operations (list/bulk-delete/execute-all).",
      "commands": [
        {
          "name": "create",
          "description": "Create a project. Generates a folder index row; optionally seeds preset subfolders.",
          "flags": [
            { "name": "name", "required": true, "description": "Project name" },
            { "name": "folder-path", "required": true, "description": "Absolute folder path on disk" },
            { "name": "description", "description": "Optional description" },
            { "name": "preset", "description": "Preset layout: empty | recommended | custom" },
            { "name": "preset-paths", "description": "Comma-separated subfolders for preset=custom" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "CreateProject" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "list",
          "description": "List every project with computed stats.",
          "flags": [
            { "name": "limit", "description": "Maximum projects to return (0 = server default)" },
            { "name": "offset", "description": "Pagination offset" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "ListProjects" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Fetch a single project + stats by id.",
          "positionals": [
            { "name": "id", "required": true, "description": "Project UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "GetProject" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "update",
          "description": "Patch project name / description / folder_path. Empty fields are ignored.",
          "positionals": [
            { "name": "id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "name", "description": "New project name" },
            { "name": "description", "description": "New description" },
            { "name": "folder-path", "description": "New absolute folder path" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "UpdateProject" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "delete",
          "description": "Delete a project. With --delete-files, also removes the on-disk folder.",
          "positionals": [
            { "name": "id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "delete-files", "bool": true, "description": "Also remove the project folder on disk" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "DeleteProject" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "workflows",
          "description": "List workflows belonging to a project.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "limit", "description": "Maximum workflows to return" },
            { "name": "offset", "description": "Pagination offset" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "ListProjectWorkflows" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "bulk-delete-workflows",
          "description": "Delete multiple workflows from a project in a single call.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "flags": [
            { "name": "workflow-ids", "required": true, "description": "Comma-separated workflow UUIDs" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "BulkDeleteProjectWorkflows" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "execute-all",
          "description": "Start an execution for every workflow in the project.",
          "positionals": [
            { "name": "project-id", "required": true, "description": "Project UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProjectsService", "method": "ExecuteAllProjectWorkflows" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal", "filesystem:write"]
          }
        }
      ]
    },
    {
      "name": "workflows",
      "description": "Workflow CRUD, versioning, validation, AI modification, and execution start.",
      "commands": [
        {
          "name": "list",
          "description": "List workflows, optionally filtered by project.",
          "flags": [
            { "name": "project-id", "description": "Filter by project UUID" },
            { "name": "folder-path", "description": "Filter by folder path within the project" },
            { "name": "limit", "description": "Maximum number of results (1–100)" },
            { "name": "offset", "description": "Pagination offset" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "ListWorkflows" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Get a workflow by ID (optionally at a specific version).",
          "positionals": [
            { "name": "workflow-id", "required": true, "description": "Workflow UUID" }
          ],
          "flags": [
            { "name": "version", "description": "Specific version to retrieve (default: latest)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "GetWorkflow" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "create",
          "description": "Create a new workflow in a project.",
          "flags": [
            { "name": "project-id", "required": true, "description": "Project UUID" },
            { "name": "name", "required": true, "description": "Workflow name" },
            { "name": "folder-path", "description": "Folder path within the project" },
            { "name": "flow-file", "description": "Path to JSON file containing the V2 flow definition" },
            { "name": "ai-prompt", "description": "Optional AI prompt used to generate the workflow" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "CreateWorkflow" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "update",
          "description": "Update a workflow's definition and metadata.",
          "positionals": [
            { "name": "workflow-id", "required": true, "description": "Workflow UUID" }
          ],
          "flags": [
            { "name": "name", "description": "Updated workflow name" },
            { "name": "description", "description": "Updated description" },
            { "name": "folder-path", "description": "Updated folder path" },
            { "name": "tags", "description": "Comma-separated tag list" },
            { "name": "flow-file", "description": "Path to JSON file with updated V2 flow definition" },
            { "name": "change-description", "description": "Description of this change" },
            { "name": "source", "description": "Change source (manual|autosave|import|ai_generated|recording)" },
            { "name": "expected-version", "description": "Optimistic-lock version (required to avoid conflicts)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "UpdateWorkflow" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "delete",
          "description": "Delete a workflow.",
          "positionals": [
            { "name": "workflow-id", "required": true, "description": "Workflow UUID" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "DeleteWorkflow" },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal", "filesystem:write"]
          }
        },
        {
          "name": "execute",
          "description": "Execute a persisted workflow.",
          "positionals": [
            { "name": "workflow-id", "required": true, "description": "Workflow UUID" }
          ],
          "flags": [
            { "name": "version", "description": "Workflow version to execute (default: latest)" },
            { "name": "wait", "bool": true, "description": "Wait for completion before responding" },
            { "name": "parameters-file", "description": "Path to JSON file with ExecutionParameters" },
            { "name": "requires-video", "bool": true, "description": "Record playwright video" },
            { "name": "requires-trace", "bool": true, "description": "Record playwright trace.zip" },
            { "name": "requires-har", "bool": true, "description": "Record HAR archive" },
            { "name": "frame-streaming", "bool": true, "description": "Enable live frame streaming via WS" },
            { "name": "seed-mode", "description": "Seed apply mode (needs-applying)" },
            { "name": "seed-scenario", "description": "Seed scenario slug" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "ExecuteWorkflow" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "network:external", "filesystem:write"]
          }
        },
        {
          "name": "execute-adhoc",
          "description": "Execute a workflow definition without persisting it.",
          "flags": [
            { "name": "flow-file", "required": true, "description": "Path to JSON file with the adhoc V2 flow definition" },
            { "name": "wait", "bool": true, "description": "Wait for completion before responding" },
            { "name": "name", "description": "Optional label for the adhoc execution" },
            { "name": "description", "description": "Optional description for the adhoc execution" },
            { "name": "parameters-file", "description": "Path to JSON file with ExecutionParameters" },
            { "name": "requires-video", "bool": true, "description": "Record playwright video" },
            { "name": "requires-trace", "bool": true, "description": "Record playwright trace.zip" },
            { "name": "requires-har", "bool": true, "description": "Record HAR archive" },
            { "name": "frame-streaming", "bool": true, "description": "Enable live frame streaming via WS" },
            { "name": "seed-mode", "description": "Seed apply mode (needs-applying)" },
            { "name": "seed-scenario", "description": "Seed scenario slug" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "ExecuteAdhocWorkflow" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal", "network:external", "filesystem:write"]
          }
        },
        {
          "name": "validate",
          "description": "Validate a workflow definition.",
          "flags": [
            { "name": "flow-file", "required": true, "description": "Path to JSON file with the V2 flow definition" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "ValidateWorkflow" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "validate-resolved",
          "description": "Validate a workflow definition whose tokens have already been substituted.",
          "flags": [
            { "name": "flow-file", "required": true, "description": "Path to JSON file with the V2 flow definition" }
          ],
          "binding": { "kind": "connect-rpc", "service": "WorkflowsService", "method": "ValidateResolvedWorkflow" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "modify",
          "description": "Apply an AI-driven modification prompt to a workflow definition.",
          "positionals": [
            { "name": "workflow-id", "required": true, "description": "Workflow UUID" }
          ],
          "flags": [
