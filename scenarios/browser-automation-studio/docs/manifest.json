    "schema": "scenario-docs-manifest/v2",
    "maturityValues": [
      "missing",
      "stub",
      "draft",
      "active",
      "not-applicable",
      "deferred",
      "retired"
    ],
    "stages": [
      "generated",
      "oriented",
      "implemented",
      "validated",
      "deployable",
      "monetizable"
    ],
    "extensionRule": "Register every durable scenario document. Keep authoritative system concepts in docs/concepts, operational procedures in docs/operations, stable lookup material in docs/reference, and historical plans or audits in docs/internal."
  }
}
