{
  "metadata": {
    "name": "navigate-all-routes-mobile",
    "description": "Mobile-viewport variant of navigate-all-routes. Walks all six command-center routes at iPhone-14 dimensions (390x844), confirms the metrics drawer (data-testid='metrics-drawer') renders on every dashboard, and captures a full-page screenshot per route so reviewers can visually verify no horizontal overflow.",
    "labels": {
      "reset": "none"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 390,
    "viewport_height": 844
  },
  "nodes": [
    {
      "id": "navigate-mission-control",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "command-center",
          "scenario_path": "/mission-control",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to /mission-control (mobile)"
        }
      }
    },
    {
      "id": "wait-mission-control-theme",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-theme='ground-control']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for data-theme='ground-control'"
        }
      }
    },
    {
      "id": "assert-mission-control-drawer",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='metrics-drawer']",
          "mode": "ASSERTION_MODE_EXISTS"
        },
        "metadata": {
          "label": "Assert metrics drawer renders on /mission-control"
        }
      }
    },
    {
      "id": "capture-mission-control",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture /mission-control (mobile)"
        }
      }
    },
    {
      "id": "navigate-hive",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
