{
  "metadata": {
    "name": "navigate-all-routes",
    "description": "Walks all six top-level command-center routes (mission-control, hive, forge, ledger, broadcast, panorama), verifying each applies the expected data-theme attribute and capturing a screenshot per route.",
    "labels": {
      "reset": "none"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-mission-control",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "command-center",
          "scenario_path": "/mission-control",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to /mission-control"
        }
      }
    },
    {
      "id": "wait-mission-control-theme",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-theme='ground-control']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for data-theme='ground-control'"
        }
      }
    },
    {
      "id": "capture-mission-control",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture /mission-control"
        }
      }
    },
    {
      "id": "navigate-hive",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
