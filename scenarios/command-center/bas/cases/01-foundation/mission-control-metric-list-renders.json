{
  "metadata": {
    "name": "mission-control-metric-list-renders",
    "description": "Navigates to /mission-control and asserts metric readings carry their origin environment as data, and that a room whose readings are all local draws no per-tile origin mark, so provenance reaches the browser without rendering a resolved URL or repeating what does not differ.",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"CC-UI-002\"]"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-mission-control",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "command-center",
          "scenario_path": "/mission-control",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to /mission-control"
        }
      }
    },
    {
      "id": "wait-metric-list",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='metric-list']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for metric-list wrapper"
        }
      }
    },
    {
      "id": "assert-metric-list-wrapper",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='metric-list']",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected [data-testid='metric-list'] wrapper on /mission-control"
        },
        "metadata": {
          "label": "Assert metric-list wrapper present"
        }
      }
    },
    {
      "id": "assert-metric-entry",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='metric-list'] [data-metric-id]",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected at least one [data-metric-id] entry inside metric-list on /mission-control"
        },
        "metadata": {
          "label": "Assert at least one metric entry"
        }
      }
    },
    {
      "id": "assert-local-origin-env",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='metric-list'] [data-reading][data-origin-env='local']",
          "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
          "timeout_ms": 5000,
          "failure_message": "Expected at least one mission-control reading to expose its local origin environment",
          "attribute_name": "data-origin-env",
          "expected": {
            "string_value": "local"
          }
        },
        "metadata": {
          "label": "Assert origin environment marker"
        }
      }
    },
    {
      "id": "assert-no-origin-mark",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='metric-list'] [data-origin]",
          "mode": "ASSERTION_MODE_NOT_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "A room whose readings are all local draws no per-tile origin mark; origin is shown only where it differs (UI-ARCHITECTURE §Supporting tiles speak on exception)"
        },
        "metadata": {
          "label": "No origin mark in an all-local room"
        }
      }
    },
    {
      "id": "capture-mission-control-metrics",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture /mission-control metric list"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-mission-control",
      "target": "wait-metric-list",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "wait-metric-list",
      "target": "assert-metric-list-wrapper",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "assert-metric-list-wrapper",
      "target": "assert-metric-entry",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "assert-metric-entry",
      "target": "assert-local-origin-env",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "assert-local-origin-env",
      "target": "assert-no-origin-mark",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "assert-no-origin-mark",
      "target": "capture-mission-control-metrics",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
