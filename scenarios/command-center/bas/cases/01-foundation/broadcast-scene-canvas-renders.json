{
  "metadata": {
    "name": "broadcast-scene-canvas-renders",
    "description": "Navigates to /broadcast and asserts the SceneCanvas wrapper plus R3F <canvas> element mount (CC-UI-003 lazy-with-Suspense scene).",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"CC-UI-003\"]"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-broadcast",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "command-center",
          "scenario_path": "/broadcast",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to /broadcast"
        }
      }
    },
    {
      "id": "wait-scene-canvas",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='scene-canvas']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for SceneCanvas wrapper"
        }
      }
    },
    {
      "id": "assert-scene-wrapper",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='scene-canvas']",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected [data-testid='scene-canvas'] wrapper to exist on /broadcast"
        },
        "metadata": {
          "label": "Assert SceneCanvas wrapper present"
        }
      }
    },
    {
      "id": "assert-r3f-canvas",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='scene-canvas'] canvas",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected R3F <canvas> inside scene-canvas wrapper on /broadcast"
        },
        "metadata": {
          "label": "Assert R3F canvas mounted"
        }
      }
    },
    {
      "id": "capture-broadcast-scene",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture /broadcast scene canvas"
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-broadcast", "target": "wait-scene-canvas", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e2", "source": "wait-scene-canvas", "target": "assert-scene-wrapper", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e3", "source": "assert-scene-wrapper", "target": "assert-r3f-canvas", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4", "source": "assert-r3f-canvas", "target": "capture-broadcast-scene", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
