{
  "metadata": {
    "name": "panorama-scene-canvas-renders",
    "description": "Navigates to /panorama and asserts the composed canvas contains non-blank pixels (CC-UI-003).",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"CC-UI-003\"]"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-panorama",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "command-center",
          "scenario_path": "/panorama",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to /panorama"
        }
      }
    },
    {
      "id": "wait-scene-canvas",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='scene-canvas']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for SceneCanvas wrapper"
        }
      }
    },
    {
      "id": "assert-scene-wrapper",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-testid='scene-canvas']",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected [data-testid='scene-canvas'] wrapper to exist on /panorama"
        },
        "metadata": {
          "label": "Assert SceneCanvas wrapper present"
        }
      }
    },
    {
      "id": "assert-r3f-canvas",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "evaluate": {
          "expression": "(() => { const canvas = document.querySelector('[data-testid=scene-canvas] canvas'); const ctx = canvas && canvas.getContext('2d'); if (!ctx || !canvas) return false; return Array.from(ctx.getImageData(0, 0, canvas.width, canvas.height).data).some((value, index) => index % 4 !== 3 && value > 0); })()",
          "expected_value": true
        },
        "metadata": { "label": "Assert composed scene has non-blank pixels" }
      }
    },
    {
      "id": "capture-panorama-scene",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture /panorama scene canvas"
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-panorama", "target": "wait-scene-canvas", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e2", "source": "wait-scene-canvas", "target": "assert-scene-wrapper", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e3", "source": "assert-scene-wrapper", "target": "assert-r3f-canvas", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4", "source": "assert-r3f-canvas", "target": "capture-panorama-scene", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
