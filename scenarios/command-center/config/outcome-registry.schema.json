{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "rooms", "metrics", "tombstones"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "origins": {"type":"object", "additionalProperties":{"type":"object", "required":["mode","environment","display"], "properties":{"mode":{"enum":["discovery","static","relay"]},"environment":{"type":"string"},"display":{"type":"string"}}}},
    "rooms": {"type":"array", "items":{"type":"object", "required":["id","title","metricIds"], "properties":{"beats":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["hero"],"properties":{"hero":{"type":"string"},"composition":{"type":"string"},"dwellSeconds":{"type":"number","exclusiveMinimum":0}}}}}}},
    "metrics": {"type":"array", "items":{"type":"object", "required":["id","label","source","coverage"], "properties":{"kind":{"enum":["scalar","panel"],"default":"scalar"},"coverage":{"enum":["NOW","IN-REACH","MISSING"]},"source":{"type":"object","required":["integrationId","featureId","contractVersion","selector","expectedUnit","ttlSeconds","sourceTimePolicy"]},"sample":{"type":"object","required":["value","series","basis"]},"owner":{"type":"string"},"whatIsNeeded":{"type":"string"},"firstObservedMissing":{"type":"string"}}}},
    "tombstones": {"type":"array"}
  }
}
