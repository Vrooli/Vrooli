{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "bars"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metricId", "direction", "bar", "unit", "authoredAgainst", "decisionRef"],
        "additionalProperties": false,
        "properties": {
          "metricId": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["up", "down"] },
          "bar": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "authoredAgainst": { "type": "number" },
          "decisionRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notGradeable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metricId", "reason"],
        "additionalProperties": false,
        "properties": {
          "metricId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
