{
  "service": {
    "name": "test-data-generator",
    "displayName": "Test Data Generator",
    "parent": "vrooli",
    "type": "scenario",
    "category": "generation",
    "tags": [],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/test-data-generator"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "description": "Universal test data generator for all formats - JSON, YAML, CSV, XML, images, audio, video, PDFs",
    "version": "1.0.0"
  },
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Test data generator API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Test data generator UI port",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "health": {
      "description": "Test Data Generator health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 3000,
          "interval": 45000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    },
    "version": "2.0.0"
  },
  "dependencies": {
    "resources": {
      "redis": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "purpose": "Caching frequently generated patterns",
        "degraded_behavior": "Falls back to in-memory cache"
      },
      "minio": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "purpose": "Store generated files for retrieval",
        "degraded_behavior": "Falls back to temporary filesystem storage"
      }
    }
  },
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "cli": {
    "enabled": true,
    "command": "test-data-generator",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "test-data-generator"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator that no Go code in this scenario currently opens. The declaration records intended caching, not a runtime requirement."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
