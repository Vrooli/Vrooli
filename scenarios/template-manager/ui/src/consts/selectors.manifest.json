  "dynamicSelectors": {
    "debtList.row": {
      "description": "Debt list row by debt id",
      "selectorPattern": "[data-testid=\"debt-list-row-${key}\"]",
      "testIdPattern": "debt-list-row-${key}",
      "params": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    },
    "templateDetail.runLink": {
      "description": "Template detail run link by run id",
      "selectorPattern": "[data-testid=\"template-detail-run-${id}\"]",
      "testIdPattern": "template-detail-run-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "templateDetail.debtLink": {
      "description": "Template detail debt link by debt id",
      "selectorPattern": "[data-testid=\"template-detail-debt-${key}\"]",
      "testIdPattern": "template-detail-debt-${key}",
      "params": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    },
    "layout.navLink": {
      "description": "App shell navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]",
      "testIdPattern": "layout-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "templates",
            "runs",
            "debt",
            "settings"
          ]
        }
      ]
    },
    "templateList.row": {
      "description": "Template list row by template id",
      "selectorPattern": "[data-testid=\"template-list-row-${id}\"]",
      "testIdPattern": "template-list-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "runList.row": {
      "description": "Run list row by run id",
      "selectorPattern": "[data-testid=\"run-list-row-${id}\"]",
      "testIdPattern": "run-list-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    }
  },
