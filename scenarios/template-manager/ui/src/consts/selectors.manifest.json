  "dynamicSelectors": {
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "templates",
            "runs",
            "debt",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "templates",
            "runs",
            "debt",
            "settings"
          ]
        }
      ]
    },
    "templateList.row": {
      "description": "Template list row link to a template detail view, by template id",
      "selectorPattern": "[data-testid=\"template-list-row-${id}\"]",
      "testIdPattern": "template-list-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "runList.row": {
      "description": "Run list row link to a validation run detail view, by run id",
      "selectorPattern": "[data-testid=\"run-list-row-${id}\"]",
      "testIdPattern": "run-list-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "debtList.row": {
      "description": "Debt list row link to a debt entry detail view, by debt key",
      "selectorPattern": "[data-testid=\"debt-list-row-${key}\"]",
      "testIdPattern": "debt-list-row-${key}",
      "params": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    },
    "templateDetail.runLink": {
      "description": "Template detail link to one of its validation runs, by run id",
      "selectorPattern": "[data-testid=\"template-detail-run-link-${id}\"]",
      "testIdPattern": "template-detail-run-link-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "templateDetail.debtLink": {
      "description": "Template detail link to one of its debt entries, by debt key",
      "selectorPattern": "[data-testid=\"template-detail-debt-link-${key}\"]",
      "testIdPattern": "template-detail-debt-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    }
  }
