{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.template_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.template_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "registry_list_templates",
      "path": "/vrooli.template_manager.v1.registry.RegistryService/ListTemplates",
      "method": "POST",
      "summary": "List template records",
      "description": "Returns the governed inventory of scenario, design, and resource templates.",
      "category": "registry"
    },
    {
      "id": "registry_get_template",
      "path": "/vrooli.template_manager.v1.registry.RegistryService/GetTemplate",
      "method": "POST",
      "summary": "Get a template record",
      "description": "Returns one template registry record by id.",
      "category": "registry"
    },
    {
      "id": "validation_runs_run",
      "path": "/vrooli.template_manager.v1.validation.ValidationRunService/RunTemplateValidation",
      "method": "POST",
      "summary": "Run template validation",
      "description": "Runs the current template validation engine and persists the result.",
      "category": "validation"
    },
    {
      "id": "validation_runs_list",
      "path": "/vrooli.template_manager.v1.validation.ValidationRunService/ListValidationRuns",
      "method": "POST",
      "summary": "List validation runs",
      "description": "Returns persisted template validation runs.",
      "category": "validation"
    },
    {
      "id": "validation_runs_get",
      "path": "/vrooli.template_manager.v1.validation.ValidationRunService/GetValidationRun",
      "method": "POST",
      "summary": "Get validation run",
      "description": "Returns one persisted template validation run.",
      "category": "validation"
    },
    {
      "id": "validation_drift_record",
      "path": "/vrooli.template_manager.v1.validation.ValidationRunService/RecordFleetDrift",
      "method": "POST",
      "summary": "Record fleet drift",
      "description": "Runs the current fleet drift engine and persists a snapshot.",
      "category": "validation"
    },
    {
      "id": "validation_drift_list",
      "path": "/vrooli.template_manager.v1.validation.ValidationRunService/ListDriftSnapshots",
      "method": "POST",
      "summary": "List drift snapshots",
      "description": "Returns persisted template drift snapshots.",
      "category": "validation"
    },
    {
      "id": "debt_list",
      "path": "/vrooli.template_manager.v1.debt.DebtService/ListDebt",
      "method": "POST",
      "summary": "List template debt",
      "description": "Returns durable template debt entries.",
      "category": "debt"
    },
    {
      "id": "debt_get",
      "path": "/vrooli.template_manager.v1.debt.DebtService/GetDebt",
      "method": "POST",
      "summary": "Get template debt",
      "description": "Returns one durable template debt entry.",
      "category": "debt"
    },
    {
      "id": "guidance_next_gate",
      "path": "/vrooli.template_manager.v1.guidance.GuidanceService/NextGate",
      "method": "POST",
      "summary": "Get the next orientation gate",
      "description": "Returns the next incomplete orientation gate, checks, contract docs, and remediation pointers for a generated scenario.",
      "category": "guidance"
    },
    {
      "id": "lifecycle_generate_scenario",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/GenerateScenario",
      "method": "POST",
      "summary": "Generate scenario",
      "description": "Generates a scenario from a governed scenario template.",
      "category": "lifecycle"
    },
    {
      "id": "lifecycle_orient_scenario",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/OrientScenario",
      "method": "POST",
      "summary": "Orient scenario",
      "description": "Reports or finalizes scenario orientation progress.",
      "category": "lifecycle"
    },
    {
      "id": "lifecycle_detemplate_scenario",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/DetemplateScenario",
      "method": "POST",
      "summary": "Detemplate scenario",
      "description": "Removes the template example domain from a generated scenario.",
      "category": "lifecycle"
    },
    {
      "id": "lifecycle_validate_template",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/ValidateTemplate",
      "method": "POST",
      "summary": "Validate template",
      "description": "Runs the scenario-template validation engine.",
      "category": "lifecycle"
    },
    {
      "id": "lifecycle_drift_report",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/DriftReport",
      "method": "POST",
      "summary": "Template drift report",
      "description": "Compares generated scenarios against current template hashes.",
      "category": "lifecycle"
    },
    {
      "id": "lifecycle_cleanup_runs",
      "path": "/vrooli.template_manager.v1.lifecycle.TemplateLifecycleService/CleanupRuns",
      "method": "POST",
      "summary": "Cleanup template runs",
      "description": "Cleans retained or stale deep-validation workspaces.",
      "category": "lifecycle"
    },
    {
      "id": "design_list",
      "path": "/vrooli.template_manager.v1.lifecycle.DesignKitService/ListDesignKits",
      "method": "POST",
      "summary": "List design kits",
      "description": "Lists scenario design kits.",
      "category": "design"
    },
    {
      "id": "design_get",
      "path": "/vrooli.template_manager.v1.lifecycle.DesignKitService/GetDesignKit",
      "method": "POST",
      "summary": "Get design kit",
      "description": "Returns one scenario design kit.",
      "category": "design"
    },
    {
      "id": "design_validate",
      "path": "/vrooli.template_manager.v1.lifecycle.DesignKitService/ValidateDesignKits",
      "method": "POST",
      "summary": "Validate design kits",
      "description": "Validates scenario design kits.",
      "category": "design"
    },
    {
      "id": "measures_open_debt_count",
      "path": "/vrooli.template_manager.v1.measures.MeasuresService/OpenDebtCount",
      "method": "POST",
      "summary": "Count open template debt entries",
      "description": "Counts open inherited-template debt entries in a canonical time window. Backed by the same compute path as /measures.",
      "category": "measures"
    },
    {
      "id": "measures_deep_validate_green_streak",
      "path": "/vrooli.template_manager.v1.measures.MeasuresService/DeepValidateGreenStreak",
      "method": "POST",
      "summary": "Count consecutive passing deep validations",
      "description": "Counts newest-first passing deep-validation runs until the first non-green run for a template.",
      "category": "measures"
    },
    {
      "id": "measures_fleet_standing_distribution",
      "path": "/vrooli.template_manager.v1.measures.MeasuresService/FleetStandingDistribution",
      "method": "POST",
      "summary": "Return template standing distribution",
      "description": "Buckets governed templates by current, drift, version lag, and open-debt standing.",
      "category": "measures"
    },
    {
      "id": "measures_max_version_lag",
      "path": "/vrooli.template_manager.v1.measures.MeasuresService/MaxVersionLag",
      "method": "POST",
      "summary": "Return maximum template version lag",
      "description": "Returns the maximum version lag count across template records. Backed by the same compute path as /measures.",
      "category": "measures"
    },
    {
      "id": "measures_declarations",
      "path": "/measures/declarations",
      "method": "GET",
      "summary": "List declared measures",
      "description": "Measures-go registry declarations harvested by measures-health and search-hub.",
      "category": "measures",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "measures-go serves a framework-neutral harvest endpoint consumed without a generated client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
      "id": "measures_execute",
      "path": "/measures/execute",
      "method": "POST",
      "summary": "Execute a declared measure",
      "description": "Measures-go registry execution endpoint used by measures-health behavioral probes and search-hub federation.",
      "category": "measures",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "measures-go serves a uniform JSON execution endpoint shared across scenarios.",
        "proto_payloads": {
          "request": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
      "id": "monitor_status_get",
      "path": "/vrooli.template_manager.v1.monitor.MonitorService/GetMonitorStatus",
      "method": "POST",
      "summary": "Get monitor status",
      "description": "Returns recurring deep-validation monitor status.",
      "category": "monitor"
    },
    {
      "id": "resource_template_list",
      "path": "/vrooli.template_manager.v1.resource_template.ResourceTemplateService/ListResourceTemplates",
      "method": "POST",
      "summary": "List resource templates",
      "description": "Lists governed resource templates.",
      "category": "resource_template"
    },
    {
      "id": "resource_template_get",
      "path": "/vrooli.template_manager.v1.resource_template.ResourceTemplateService/GetResourceTemplate",
      "method": "POST",
      "summary": "Get resource template",
      "description": "Shows one governed resource template.",
      "category": "resource_template"
    },
    {
      "id": "resource_template_validate",
      "path": "/vrooli.template_manager.v1.resource_template.ResourceTemplateService/ValidateResourceTemplates",
      "method": "POST",
      "summary": "Validate resource templates",
      "description": "Validates governed resource templates.",
      "category": "resource_template"
    },
    {
      "id": "resource_template_generate",
      "path": "/vrooli.template_manager.v1.resource_template.ResourceTemplateService/GenerateResourceTemplate",
      "method": "POST",
      "summary": "Generate resource template",
      "description": "Generates a resource from a governed template.",
      "category": "resource_template"
    },
    {
      "id": "scenario_validation_validate",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate template standing",
      "description": "Statically validates a scenario's template provenance, orientation visibility, drift, version lag, and inherited-debt standing.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "include_execution": "bool",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid target path"
        }
      ]
    },
    {
      "id": "scenario_validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview deterministic template fixes",
      "description": "Dry-runs deterministic template standing repairs such as adopted provenance stamping.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "array<string>",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "array<scenario_validation.v1.FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid fix request"
        }
      ]
    },
    {
      "id": "scenario_validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply deterministic template fixes",
      "description": "Applies deterministic template standing repairs selected explicitly by the caller.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "array<string>",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "array<scenario_validation.v1.FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing target or invalid fix request"
        }
      ]
    }
  ]
}
