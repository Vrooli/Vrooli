{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "calendar",
    "displayName": "Calendar System",
    "description": "Universal scheduling intelligence system that enables time-aware workflows and cross-scenario temporal coordination",
    "version": "1.0.0",
    "tags": [
      "scheduling",
      "calendar",
      "events",
      "time-management",
      "automation",
      "ai-scheduling",
      "notifications",
      "multi-user",
      "postgres-storage",
      "vector-search",
      "microservice",
      "saas-ready"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/calendar"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Calendar REST API for event management and scheduling",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Professional calendar interface with week/month views",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Calendar system health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 15000
    },
    "develop": {
      "description": "Start calendar system with API and UI servers",
      "steps": [
        {
          "name": "setup-database",
          "exec": [
            "resource-postgres",
            "content",
            "create-database",
            "calendar_system"
          ],
          "description": "Create calendar database if not exists (idempotent)"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Vector database for semantic event search and scheduling intelligence",
        "collection": "calendar_events",
        "dimensions": 1536,
        "distance": "Cosine",
        "purpose": "AI-powered semantic event search and scheduling intelligence",
        "estimated_vectors": "1M events with embeddings"
      },
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Primary event storage and recurring schedule data",
        "instance_name": "calendar-system",
        "database": "calendar_system",
        "purpose": "Event storage, user schedules, recurring patterns",
        "estimated_size": "10GB for 100K events",
        "backup_frequency": "daily"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Natural language processing for chat interface",
        "model_roles": [
          "chat.small"
        ]
      }
    },
    "scenarios": {
      "scenario-authenticator": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Multi-user authentication and user context",
        "degraded_behavior": "Single-user mode without authentication",
        "bundle_policy": "discover",
        "bindings": [
          {
            "env_var": "AUTH_SERVICE_URL",
            "form": "http_base_url",
            "port": "api",
            "when_unavailable": "omit"
          }
        ]
      },
      "notification-hub": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Event reminders and schedule change notifications",
        "degraded_behavior": "In-memory reminder queue without delivery",
        "bundle_policy": "discover",
        "bindings": [
          {
            "env_var": "NOTIFICATION_SERVICE_URL",
            "form": "http_base_url",
            "port": "api",
            "when_unavailable": "omit"
          }
        ]
      }
    }
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/calendar",
        "field": "jwt-secret",
        "env": "JWT_SECRET",
        "label": "Calendar JWT signing secret",
        "description": "Signs Calendar API tokens and must be provisioned through the credential authority.",
        "required": true,
        "tiers": [
          "tier-1-local"
        ]
      }
    ]
  },
  "cli": {
    "enabled": true,
    "command": "calendar",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "calendar"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "env": {
          "ENVIRONMENT": "test",
          "VROOLI_LIFECYCLE_MANAGED": "true",
          "NOTIFICATION_PROFILE_ID": "calendar-system-prod"
        },
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.cjs"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
