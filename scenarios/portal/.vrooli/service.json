        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    }
  },
  "dependencies": {
    "scenarios": {
      "search-hub": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides federated ecosystem search for omnibox suggestions and passive message attachments."
      },
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides coding-agent chat execution through Portal's declared role-only profile.",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/agent-chat.json"
            ]
          }
        }
      },
      "prompt-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides skills and prompt content for system-prompt injection."
      }
    }
  },
  "environment": {
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
