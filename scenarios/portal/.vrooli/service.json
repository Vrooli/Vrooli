{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "portal",
    "displayName": "Vrooli Portal",
    "description": "Chat-first front door to the Vrooli ecosystem",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.5.0"
    },
    "generated_at": "2026-07-05T21:43:34Z",
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    },
    "manifest_sha": "9028ce71643a198490bc79397d83d05174a865c136005e26114ac80d4d557cb5",
    "content_sha": "9e2b2c88e6699f137699fd1819eb7819cbfeb76fe34f29f159fa4c1b300b372a"
  },
  "cli": {
    "enabled": true,
    "command": "portal",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "portal"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "port": 20004
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/portal-api"
            ]
          },
          {
            "type": "cli",
            "command": "portal"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api \u0026\u0026 GOWORK=off go mod download \u0026\u0026 GOWORK=off go build -o portal-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui \u0026\u0026 (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api \u0026\u0026 ./portal-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/portal-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui \u0026\u0026 node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute portal --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'portal-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "scenarios": {
      "search-hub": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides federated ecosystem search for omnibox suggestions and passive message attachments."
      },
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides coding-agent chat execution for agent-mode conversations."
      },
      "prompt-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides skills and prompt content for system-prompt injection."
      }
    }
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/portal.db",
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}"
  }
}
