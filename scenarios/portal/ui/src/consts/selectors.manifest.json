  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "integrations.statusRow": {
      "description": "Integration readiness table row by integration id",
      "selectorPattern": "[data-testid=\"integrations-status-row-${id}\"]",
      "testIdPattern": "integrations-status-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "integrations.deploymentProfileOption": {
      "description": "Deployment profile option by profile id",
      "selectorPattern": "[data-testid=\"integrations-deployment-profile-option-${id}\"]",
      "testIdPattern": "integrations-deployment-profile-option-${id}",
      "params": [
        {
          "name": "id",
          "type": "enum",
          "values": [
            "client",
            "local-control",
            "automation"
          ]
        }
      ]
    },
    "search.result": {
      "description": "Search omnibox result row by visible index",
      "selectorPattern": "[data-testid=\"search-omnibox-result-${index}\"]",
      "testIdPattern": "search-omnibox-result-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    },
    "chat.group": {
      "description": "Chat sidebar group row by group id",
      "selectorPattern": "[data-testid=\"chat-group-${id}\"]",
      "testIdPattern": "chat-group-${id}",
