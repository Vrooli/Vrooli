{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "portal",
  "description": "Vrooli Portal CLI surface for chat, message trees, integration readiness, and ecosystem search. Commands are thin generated-Connect clients over Portal's API.",
  "groups": [
    {
      "name": "chats",
      "description": "Manage Portal chats and chat groups",
      "commands": [
        {
          "name": "list",
          "description": "List chats with their groups",
          "flags": [
            {
              "name": "group-id",
              "description": "Optional group id filter"
            },
            {
              "name": "query",
              "description": "Optional full-text query"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "ListChats"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "create",
          "description": "Create a chat",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Chat title"
            },
            {
              "name": "group-id",
              "description": "Optional chat group id"
            },
            {
              "name": "model",
              "description": "Model override"
            },
            {
              "name": "mode",
              "description": "Chat mode: llm or agent",
              "default": "llm"
            },
            {
              "name": "web-search",
              "bool": true,
              "description": "Enable web search for this chat",
              "bind": {
                "field": "web_search_enabled"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "CreateChat"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "show",
          "description": "Show one chat",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Chat id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "GetChat"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "update",
          "description": "Update chat metadata",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Chat id"
            }
          ],
          "flags": [
            {
              "name": "title",
              "description": "New title"
            },
            {
              "name": "group-id",
              "description": "New group id"
            },
            {
              "name": "model",
              "description": "New model override"
            },
            {
              "name": "active-leaf",
              "description": "Set active leaf message id",
              "bind": {
                "field": "active_leaf_message_id"
              }
            },
            {
              "name": "web-search",
              "bool": true,
              "description": "Enable web search",
              "bind": {
                "field": "web_search_enabled"
              }
            },
            {
              "name": "no-web-search",
              "bool": true,
              "description": "Disable web search",
              "bind": {
                "field": "web_search_enabled"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "UpdateChat"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "delete",
          "description": "Delete a chat",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Chat id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "DeleteChat"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "requires_confirmation": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "groups",
          "description": "List chat groups",
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "ListGroups"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "group-create",
          "description": "Create a chat group",
          "flags": [
            {
              "name": "name",
              "required": true,
              "description": "Group name"
            },
            {
              "name": "color",
              "required": true,
              "description": "Group color"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "CreateGroup"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "group-update",
          "description": "Update a chat group",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Group id"
            }
          ],
          "flags": [
            {
              "name": "name",
              "description": "New group name"
            },
            {
              "name": "color",
              "description": "New group color"
            },
            {
              "name": "collapsed",
              "bool": true,
              "description": "Mark collapsed"
            },
            {
              "name": "expanded",
              "bool": true,
              "description": "Mark expanded",
              "bind": {
                "field": "collapsed"
              }
            },
            {
              "name": "sort-order",
              "description": "Sort order integer"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "UpdateGroup"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "group-delete",
          "description": "Delete a chat group",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Group id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ChatService",
            "method": "DeleteGroup"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": true,
            "requires_confirmation": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "messages",
      "description": "Manage message trees and stream completions",
      "commands": [
        {
          "name": "tree",
          "description": "Show a chat's message tree",
          "positionals": [
            {
              "name": "chat-id",
              "required": true,
              "description": "Chat id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "MessageService",
            "method": "GetTree"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "send",
          "description": "Append a user message",
          "positionals": [
            {
              "name": "chat-id",
              "required": true,
              "description": "Chat id"
            },
            {
              "name": "text",
              "required": true,
              "description": "Message text",
              "bind": {
                "field": "content"
              }
            }
          ],
          "flags": [
            {
              "name": "parent",
              "description": "Optional parent message id",
              "bind": {
                "field": "parent_message_id"
              }
            },
            {
              "name": "model",
              "description": "Model override for the next completion"
            },
            {
              "name": "skill-ids",
              "description": "Comma-separated selected skill ids",
              "bind": {
                "field": "selected_skill_ids"
              }
            },
            {
              "name": "web-search",
              "bool": true,
              "description": "Enable passive web search",
              "bind": {
                "field": "web_search_enabled"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "MessageService",
            "method": "SendMessage"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "edit",
          "description": "Edit a message and create a branch",
          "positionals": [
            {
              "name": "message-id",
              "required": true,
              "description": "Message id"
            },
            {
              "name": "text",
              "required": true,
              "description": "Replacement text",
              "bind": {
                "field": "content"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "MessageService",
            "method": "EditMessage"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "regenerate",
          "description": "Regenerate an assistant branch from a message",
          "positionals": [
            {
              "name": "message-id",
              "required": true,
              "description": "Message id"
            }
          ],
          "flags": [
            {
              "name": "model",
              "description": "Model override"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "MessageService",
            "method": "Regenerate"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "stream",
          "description": "Stream a completion for a chat",
          "positionals": [
            {
              "name": "chat-id",
              "required": true,
              "description": "Chat id"
            }
          ],
          "flags": [
            {
              "name": "from",
              "description": "Message id to complete from",
              "bind": {
                "field": "from_message_id"
              }
            },
            {
              "name": "model",
              "description": "Model override"
            },
            {
              "name": "mode",
              "description": "Chat mode: llm or agent",
              "default": "llm"
            },
            {
              "name": "skill-ids",
              "description": "Comma-separated selected skill ids",
              "bind": {
                "field": "selected_skill_ids"
              }
            },
            {
              "name": "web-search",
              "bool": true,
              "description": "Enable passive web search",
              "bind": {
                "field": "web_search_enabled"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "MessageService",
            "method": "StreamCompletion"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "integrations",
      "description": "Integration readiness status and behavior-mode controls",
      "commands": [
        {
          "name": "status",
          "description": "Show Portal integration readiness status",
          "binding": {
            "kind": "connect-rpc",
            "service": "IntegrationsService",
            "method": "Status"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "override",
          "description": "Set behavior override: auto, force-off, or force-passive",
          "positionals": [
            {
              "name": "override",
              "required": true,
              "description": "Override value"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "IntegrationsService",
            "method": "UpdateOverride"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "search",
      "description": "Request Portal-mediated ecosystem suggestions",
      "commands": [
        {
          "name": "suggest",
          "description": "Return bounded search suggestions",
          "positionals": [
            {
              "name": "query",
              "required": true,
              "description": "Search query"
            }
          ],
          "flags": [
            {
              "name": "types",
              "description": "Comma-separated hit types"
            },
            {
              "name": "limit",
              "description": "Maximum hits",
              "default": "8"
            },
            {
              "name": "group",
              "description": "Optional search group"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SearchService",
            "method": "Suggest"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  }
}
