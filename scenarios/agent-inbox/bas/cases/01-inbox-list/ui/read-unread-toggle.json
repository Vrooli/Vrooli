{
  "metadata": {
    "name": "read-unread-toggle",
    "description": "Validate toggling read/unread status updates visual indicator",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"INBOX-LIST-002\", \"INBOX-LIST-003\"]"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-home",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "agent-inbox",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to Agent Inbox UI"
        }
      }
    },
    {
      "id": "wait-inbox-container",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/app.container",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for inbox container to load"
        }
      }
    },
    {
      "id": "click-new-chat",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/sidebar.newChatButton"
        },
        "metadata": {
          "label": "Create a new chat for testing"
        }
      }
    },
    {
      "id": "wait-chat-view",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/chatView.container",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for chat view to open"
        }
      }
    },
    {
      "id": "wait-chat-header",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/chatView.header",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for chat header"
        }
      }
    },
    {
      "id": "click-more-actions",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/chatHeader.moreActionsButton"
        },
        "metadata": {
          "label": "Open the more actions dropdown menu"
        }
      }
    },
    {
      "id": "wait-dropdown-menu",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/dropdown.menu",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Wait for dropdown menu to appear"
        }
      }
    },
    {
      "id": "click-toggle-read",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/chatHeader.toggleReadButton"
        },
        "metadata": {
          "label": "Toggle read status via dropdown menu"
        }
      }
    },
    {
      "id": "assert-unread-indicator",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/indicators.unread",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 10000,
          "failure_message": "Unread indicator should appear after toggling read status"
        },
        "metadata": {
          "label": "Verify unread indicator appears"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate-home",
      "target": "wait-inbox-container",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "wait-inbox-container",
      "target": "click-new-chat",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "click-new-chat",
      "target": "wait-chat-view",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "wait-chat-view",
      "target": "wait-chat-header",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "wait-chat-header",
      "target": "click-more-actions",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "click-more-actions",
      "target": "wait-dropdown-menu",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "wait-dropdown-menu",
      "target": "click-toggle-read",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "click-toggle-read",
      "target": "assert-unread-indicator",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
