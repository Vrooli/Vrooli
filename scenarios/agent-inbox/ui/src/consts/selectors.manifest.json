  "dynamicSelectors": {
    "chat.item": {
      "description": "Chat list item by chat ID",
      "selectorPattern": "[data-testid=\"chat-item-${chatId}\"]",
      "testIdPattern": "chat-item-${chatId}",
      "params": [{"name": "chatId", "type": "string"}]
    },
    "chat.message": {
      "description": "Message by message ID",
      "selectorPattern": "[data-testid=\"message-${messageId}\"]",
      "testIdPattern": "message-${messageId}",
      "params": [{"name": "messageId", "type": "string"}]
    },
    "label.filterButton": {
      "description": "Label filter button in sidebar",
      "selectorPattern": "[data-testid=\"label-filter-${labelId}\"]",
      "testIdPattern": "label-filter-${labelId}",
