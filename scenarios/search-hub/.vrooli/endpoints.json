{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "search-hub status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "providers_register",
      "path": "/vrooli.search_hub.v1.registry.RegistryService/RegisterProvider",
      "method": "POST",
      "summary": "Register (upsert) a provider",
      "description": "Validates and persists a ProviderDescriptor (one (corpus, type) leaf). Upsert keyed by provider_id; created=false when an existing leaf was updated.",
      "category": "registry",
      "request": {
        "type": "object",
        "properties": {
          "descriptor": "ProviderDescriptor (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "created": "bool",
          "descriptor": "ProviderDescriptor"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Descriptor failed validation"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Registry write failure"
        }
      ],
      "examples": [
        {
          "name": "Register provider",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.registry.RegistryService/RegisterProvider -H 'Content-Type: application/json' -d '{\"descriptor\":{\"provider_id\":\"cli-health.commands\",\"provider_group\":\"cli-health\",\"bucket\":\"BUCKET_DO\",\"type\":\"command\",\"description\":\"CLI command corpus\"}}'"
        }
      ],
      "cli_mapping": {
        "command": "search-hub providers register",
        "args": [
          "--descriptor",
          "<json>"
        ]
      }
    },
    {
      "id": "providers_list",
      "path": "/vrooli.search_hub.v1.registry.RegistryService/ListProviders",
      "method": "POST",
      "summary": "List registered providers",
      "description": "Returns registered provider descriptors, optionally filtered by bucket, type, and/or state. Includes capability_gap stubs.",
      "category": "registry",
      "request": {
        "type": "object",
        "properties": {
          "bucket": "Bucket (optional filter)",
          "state": "ProviderState (optional filter)",
          "type": "string (optional filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "providers": "array<ProviderDescriptor>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Registry read failure"
        }
      ],
      "examples": [
        {
          "name": "List providers",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.registry.RegistryService/ListProviders -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "search-hub providers list"
      }
    },
    {
      "id": "providers_remove",
      "path": "/vrooli.search_hub.v1.registry.RegistryService/DeregisterProvider",
      "method": "POST",
      "summary": "Deregister a provider",
      "description": "Removes the provider leaf with the given provider_id. Idempotent: removed=false when no such leaf existed.",
      "category": "registry",
      "request": {
        "type": "object",
        "properties": {
          "provider_id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "removed": "bool"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Registry delete failure"
        }
      ],
      "examples": [
        {
          "name": "Deregister provider",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.registry.RegistryService/DeregisterProvider -H 'Content-Type: application/json' -d '{\"provider_id\":\"cli-health.commands\"}'"
        }
      ],
      "cli_mapping": {
        "command": "search-hub providers remove",
        "args": [
          "<provider_id>"
        ]
      }
    },
    {
      "id": "routing_query",
      "path": "/vrooli.search_hub.v1.routing.RoutingService/Query",
      "method": "POST",
      "summary": "Federated query across registered providers",
      "description": "Fans out a query to providers selected by explicit --type, --all, or --group (Phase 4: no automatic classifier yet), maps each response through the generic adapter, and returns results grouped by provider. Degraded providers are skipped with a note, never failing the whole query.",
      "category": "routing",
      "request": {
        "type": "object",
        "properties": {
          "all": "bool — fan out to every active provider",
          "explain": "bool — include routing rationale",
          "group": "string — scope to one scenario's leaves",
          "limit": "int32 — per-provider result cap (default 10)",
          "query": "string (required) — natural-language query text",
          "types": "array<string> — explicit leaf types to route to"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "corpora_searched": "array<string> — providers hit",
          "degraded": "bool — any provider degraded",
          "groups": "array<ProviderResultGroup> — by-provider grouping (always populated)",
          "latency_ms": "int64",
          "ranked": "array<SearchHit> — unified ranked list (populated once rerank lands, Phase 6)",
          "reranked": "bool — false until Phase 6"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Empty query, or no routing selector (pass --type/--all/--group; classifier is Phase 5)"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Registry read failure"
        }
      ],
      "examples": [
        {
          "name": "Explicit-type query",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.routing.RoutingService/Query -H 'Content-Type: application/json' -d '{\"query\":\"restart a scenario\",\"types\":[\"command\"],\"limit\":5}'"
        }
      ],
      "cli_mapping": {
        "command": "search-hub query",
        "args": [
          "<text>",
          "--type",
          "<types>",
          "--all",
          "--limit",
          "<n>"
        ]
      }
    },
    {
      "id": "routing_status",
      "path": "/vrooli.search_hub.v1.routing.RoutingService/Status",
      "method": "POST",
      "summary": "Federation status (reserved — Phase 7)",
      "description": "Reserved for the metrics domain (Phase 7): per-provider reachability/freshness + classifier/reranker availability. Returns Unimplemented until then; no CLI command binds to it yet (manifest omitted[]).",
      "category": "routing",
      "request": {
        "type": "object"
      },
      "response": {
        "type": "object",
        "properties": {
          "classifier_available": "bool",
          "providers": "array<ProviderHealth>",
          "reranker_available": "bool"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Lands in Phase 7 (federation status + metrics)"
        }
      ]
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "providers register",
      "description": "Register (upsert) a provider descriptor (--descriptor JSON or @file)",
      "endpoint_id": "providers_register"
    },
    {
      "name": "providers list",
      "description": "List registered providers (optional --bucket/--type/--state filters)",
      "endpoint_id": "providers_list"
    },
    {
      "name": "providers remove",
      "description": "Deregister a provider by provider_id",
      "endpoint_id": "providers_remove"
    },
    {
      "name": "query",
      "description": "Federated search across registered providers (explicit --type/--all/--group; classifier lands Phase 5)",
      "endpoint_id": "routing_query"
    }
  ]
}
