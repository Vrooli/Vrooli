{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.local/schemas/search-hub/run-telemetry-receipt-v1.schema.json",
  "title": "Run-correlated Search Hub token/cache receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "issuer", "key_id", "signature_algorithm", "run_id", "arm", "phase", "case_query_set_sha256", "case_count", "gateway", "cache", "source_evidence", "signature_base64"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "signature_algorithm": {"const": "rsa-pkcs1v15-sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "minLength": 1},
    "phase": {"enum": ["cold", "warm", "concurrent", "degraded", "model-free"]},
    "case_query_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_count": {"type": "integer", "minimum": 1},
    "gateway": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "coverage_case_count", "event_count", "input_tokens", "output_tokens"],
      "properties": {
        "complete": {"const": true}, "coverage_case_count": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "coverage_case_count", "hits", "misses", "lookup_count"],
      "properties": {
        "complete": {"const": true}, "coverage_case_count": {"type": "integer", "minimum": 1},
        "hits": {"type": "integer", "minimum": 0}, "misses": {"type": "integer", "minimum": 0},
        "lookup_count": {"type": "integer", "minimum": 0}
      }
    },
    "source_evidence": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "receipt_id", "evidence_uri", "evidence_sha256"],
        "properties": {
          "kind": {"enum": ["gateway_export", "cache_export"]},
          "receipt_id": {"type": "string", "minLength": 1}, "evidence_uri": {"type": "string", "minLength": 1},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "signature_base64": {"type": "string", "contentEncoding": "base64"}
  }
}
