{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.vrooli.invalid/search-hub/sh1-grade-export-v1.schema.json",
  "title": "SH1 sanitized per-case performance grade export",
  "description": "Minimum SH1-to-SH4 grade receipt. Contains frozen identifiers, hashes, per-part/task accepted booleans and denominator counts only; never query text, expected result identities, or result content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "issuer", "receipt_id", "evidence_uri", "evidence_sha256",
    "run_tag", "evaluation_run_ids", "tier", "build_id", "acceptance_policy_id",
    "cohort_id", "task_set_sha256", "cases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "issuer": {"const": "SH1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "evidence_uri": {"type": "string", "minLength": 1},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "run_tag": {"type": "string", "minLength": 1},
    "evaluation_run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tier": {"enum": ["federated", "provider_direct"]},
    "build_id": {"type": "string", "minLength": 1},
    "acceptance_policy_id": {"type": "string", "minLength": 1},
    "cohort_id": {"type": "string", "minLength": 1},
    "task_set_sha256": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/caseGrade"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "caseGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_sha256", "parts", "tasks"],
      "properties": {
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "parts": {"$ref": "#/$defs/partGrades"},
        "tasks": {"$ref": "#/$defs/taskGrade"}
      }
    },
    "partGrades": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "total", "verdicts"],
      "properties": {
        "accepted": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "verdicts": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}
      }
    },
    "taskGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "total", "verdicts"],
      "properties": {
        "accepted": {"enum": [0, 1]},
        "total": {"const": 1},
        "verdicts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "boolean"}}
      }
    }
  }
}
