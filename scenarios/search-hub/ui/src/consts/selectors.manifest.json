  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "search",
            "evals",
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "search",
            "evals",
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "search.typeFacet": {
      "description": "Type facet toggle on the search page, by leaf type token",
      "selectorPattern": "[data-testid=\"search-type-facet-${type}\"]",
      "testIdPattern": "search-type-facet-${type}",
      "params": [
        {
          "name": "type",
          "type": "string"
        }
      ]
    },
    "search.providerChip": {
      "description": "Federation-status provider chip, by provider_id",
      "selectorPattern": "[data-testid=\"search-provider-chip-${providerId}\"]",
      "testIdPattern": "search-provider-chip-${providerId}",
      "params": [
        {
          "name": "providerId",
          "type": "string"
        }
      ]
    },
    "evals.suiteItem": {
      "description": "Eval suite list item, by suite_id",
      "selectorPattern": "[data-testid=\"evals-suite-${suiteId}\"]",
      "testIdPattern": "evals-suite-${suiteId}",
      "params": [
        {
          "name": "suiteId",
          "type": "string"
        }
      ]
    },
    "evals.runRow": {
      "description": "Eval run-history row, by run_id",
