{
  "name": "fall-foliage-explorer-ui",
  "version": "1.0.0",
  "description": "Interactive autumn foliage tracking and prediction UI",
  "main": "server.js",
  "scripts": {
    "start": "vrooli lifecycle protect -- node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "if command -v tsc >/dev/null 2>&1; then tsc --noEmit; else node -e \"console.log('TypeScript compiler unavailable until pnpm install; syntax-only build continues')\"; fi",
    "build": "pnpm run type-check && node ./scripts/build.js"
  },
  "dependencies": {
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.3.3"
  },
  "keywords": ["foliage", "autumn", "maps", "travel"],
  "author": "Vrooli",
  "license": "MIT"
}
