{
  "metadata": { "name": "plan-board-open-decision-drawer", "description": "Open the Plan decision drawer and verify its content or honest empty state.", "requirement": "SWM-P0-003", "version": "1", "labels": { "reset": "none" }, "execution_mode": "observer" },
  "id": "c1ddd55a-a58d-4dfa-85ff-fa454ebc35d8",
  "project_id": "5139074a-06f7-4b93-a47f-9a9aaf3b4cd4",
  "name": "plan-board-open-decision-drawer",
  "folder_path": "/bas/cases/plan-board/decision-drawer",
  "description": "Open the Plan lens board, open the decision drawer via the ?drawer=decisions deep link, and verify the drawer renders (question stream or honest empty state)",
  "tags": [
    "reset:none",
    "requirements_json:[]"
  ],
  "version": 1,
  "created_at": "2026-08-10T03:44:43.548579786Z",
  "updated_at": "2026-08-10T03:44:43.548579786Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 1600,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-plan-board",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "url": "/graph/plan?drawer=decisions"
          },
          "metadata": {
            "label": "Open Plan lens with decisions drawer deep link"
          }
        }
      },
      {
        "id": "wait-board",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/plan.board",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 20000
          },
          "metadata": {
            "label": "Board renders"
          }
        }
      },
      {
        "id": "wait-drawer",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/plan.decisionDrawer",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Decision drawer opens from the deep link"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "open-plan-board",
        "target": "wait-board"
      },
      {
        "source": "wait-board",
        "target": "wait-drawer"
      }
    ]
  }
}
