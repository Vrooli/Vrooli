  "flow_definition": {
    "settings": {
      "viewport_width": 1600,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-related-tab",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "url": "/backlog/execute/swarm-manager-receipt-evidence-migration?tab=related"
          },
          "metadata": {
            "label": "Open the seeded backlog Related tab"
          }
        }
      },
      {
        "id": "wait-related-tab",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/related.tab",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 20000
          },
          "metadata": {
            "label": "Related tab renders"
          }
        }
      },
      {
        "id": "wait-linked",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/related.groupLinked",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Linked group renders"
          }
        }
      },
      {
        "id": "wait-scope",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/related.groupSameScope",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Same scope group renders"
          }
        }
      },
      {
        "id": "wait-similar",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/related.groupSimilar",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Similar group renders"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "open-related-tab",
        "target": "wait-related-tab"
      },
      {
        "source": "wait-related-tab",
        "target": "wait-linked"
      },
      {
        "source": "wait-linked",
        "target": "wait-scope"
      },
      {
        "source": "wait-scope",
        "target": "wait-similar"
      }
    ]
  }
