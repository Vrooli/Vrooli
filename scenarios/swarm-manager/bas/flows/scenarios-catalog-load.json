{
  "metadata": { "name": "scenarios-catalog-load", "description": "Load the Scenarios catalog and mark readiness.", "execution_mode": "mutating", "labels": { "requires_confirmation": "true", "routed_isolation": "true" } },
  "id": "11d4473a-ec02-45c3-be90-d6e73158295e",
  "project_id": "5139074a-06f7-4b93-a47f-9a9aaf3b4cd4",
  "name": "scenarios-catalog-load",
  "folder_path": "/bas/flows",
  "description": "Load the graph workspace, open the Scenarios catalog, and mark when the catalog is ready for operator scanning.",
  "tags": [
    "intent:performance",
    "reset:none",
    "interaction:load-only",
    "requires_confirmation:true",
    "routed_isolation:true"
  ],
  "version": 1,
  "created_at": "2026-08-10T03:44:43.552736064Z",
  "updated_at": "2026-08-10T03:44:43.552736064Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 1600,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "swarm-manager",
            "scenario_path": "/"
          },
          "metadata": {
            "label": "Open the graph workspace"
          }
        }
      },
      {
        "id": "open-scenarios",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid='sidebar-tab-scenarios']"
          },
          "metadata": {
            "label": "Open the Scenarios catalog"
          }
        }
      },
      {
        "id": "wait-catalog",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "[data-testid='scenarios-tab']",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Wait for the Scenarios catalog"
          }
        }
      },
      {
        "id": "mark-ready",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const rows = document.querySelectorAll('[data-testid^=\"scenario-row-\"]').length; performance.mark('bas.scenarios-catalog-load.ready'); return { rows }; })()"
          },
          "metadata": {
            "label": "Mark catalog readiness"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "open-workspace",
        "target": "open-scenarios"
      },
      {
        "source": "open-scenarios",
        "target": "wait-catalog"
      },
      {
        "source": "wait-catalog",
        "target": "mark-ready"
      }
    ]
  }
}
