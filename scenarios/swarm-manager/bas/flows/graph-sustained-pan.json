{
  "id": "b4a8584d-3666-4d2a-bd1a-99610ac0f30e",
  "project_id": "5139074a-06f7-4b93-a47f-9a9aaf3b4cd4",
  "name": "graph-sustained-pan",
  "folder_path": "/bas/flows",
  "description": "Interaction performance capture for sustained driver-level panning on the canonical Graph surface.",
  "tags": [
    "intent:performance",
    "reset:none",
    "interaction:sustained-pan"
  ],
  "version": 1,
  "created_at": "2026-08-09T11:26:50.617255466Z",
  "updated_at": "2026-08-09T11:26:50.617255466Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 1600,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-graph",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "swarm-manager",
            "scenario_path": "/graph"
          },
          "metadata": {
            "label": "Open the canonical Graph surface"
          }
        }
      },
      {
        "id": "wait-canvas",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "[data-testid='graph-canvas']",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Wait for the graph canvas"
          }
        }
      },
      {
        "id": "wait-rendered-topology",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const deadline = Date.now() + 45000; while (Date.now() < deadline) { const nodes = document.querySelectorAll('.react-flow__node').length; const edges = document.querySelectorAll('.react-flow__edge').length; if (nodes >= 250 && edges >= 200) return { nodes, edges }; await new Promise((resolve) => setTimeout(resolve, 250)); } const nodes = document.querySelectorAll('.react-flow__node').length; const edges = document.querySelectorAll('.react-flow__edge').length; throw new Error(`graph-sustained-pan: topology evidence too small; nodes=${nodes}, edges=${edges}`); })()"
          },
          "metadata": {
            "label": "Wait for large rendered topology"
          }
        }
      },
      {
        "id": "record-graph-size",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const nodes = document.querySelectorAll('.react-flow__node').length; const edges = document.querySelectorAll('.react-flow__edge').length; window.localStorage.setItem('swarm-manager.perf.graph-sustained-pan.size', JSON.stringify({ nodes, edges })); return { nodes, edges }; })()"
          },
          "metadata": {
            "label": "Record rendered graph size for trace notes"
          }
        }
      },
      {
        "id": "sustained-pan-right",
        "action": {
          "type": "ACTION_TYPE_GESTURE",
          "gesture": {
            "gesture_type": "GESTURE_TYPE_SWIPE",
            "selector": "[data-testid='graph-canvas']",
            "direction": "SWIPE_DIRECTION_RIGHT",
            "distance": 560,
            "duration_ms": 1000,
            "steps": 40,
            "step_delay_ms": 25,
            "trace_label": "graph-sustained-pan",
            "idle_after_ms": 220
          },
          "metadata": {
            "label": "Sustain a driver-level pan across the graph canvas"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "open-graph",
        "target": "wait-canvas"
      },
      {
        "source": "wait-canvas",
        "target": "wait-rendered-topology"
      },
      {
        "source": "wait-rendered-topology",
        "target": "record-graph-size"
      },
      {
        "source": "record-graph-size",
        "target": "sustained-pan-right"
      }
    ]
  }
}