      },
      {
        "id": "assert-terminal-composer",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const mic = document.querySelector('[data-testid=agent-session-composer-mic]'); const composer = document.querySelector('[data-testid=agent-session-composer]'); const body = document.body.innerText; return Boolean(mic && composer && mic.getAttribute('aria-pressed') === 'false' && !/voice input error|microphone access was lost|streaming transcription and retained-audio recovery failed/i.test(body)); })()"
          },
          "metadata": {
            "label": "Assert the composer reached a non-error terminal state"
          }
        }
      },
