  "flow_definition": {
    "metadata": {
      "name": "swarm-manager-voice-long-form-browser-soak",
      "description": "Drive the shared composer microphone for one real-time hour and record terminal/recovery UI evidence.",
      "execution_mode": "EXECUTION_MODE_MUTATING",
      "labels": {
        "requires_confirmation": "true",
        "routed_isolation": "true"
      }
    },
    "settings": {
      "timeout_ms": 3900000,
      "viewport_width": 1440,
      "viewport_height": 900,
      "fake_media": {
        "microphone_wav": "/home/matthalloran8/Vrooli/scenarios/audio-tools/bas/fixtures/dictation-reference.wav"
      }
    },
    "nodes": [
      {
        "id": "open-swarm-manager",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "swarm-manager",
            "scenario_path": "/"
          },
          "metadata": {
            "label": "Open swarm-manager"
          }
        }
      },
      {
        "id": "create-session-and-navigate",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "fetch('/api/v1/agent-sessions', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'swarm_operations', title: 'Audio reliability long-form soak' }) }).then((response) => response.json()).then((body) => { const session = body.session || body; const id = session.id || session.sessionId || session.session_id; if (!id) throw new Error('session create response omitted id'); window.location.assign('/sessions/' + encodeURIComponent(id)); return id; })"
          },
          "metadata": {
            "label": "Create a disposable swarm session through the public API"
          }
        }
      },
      {
        "id": "wait-composer",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/agentSessions.composer",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Wait for the session composer"
          }
        }
      },
      {
        "id": "start-recording",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/agentSessions.composerMic"
          },
          "metadata": {
            "label": "Start real-time shared PCM capture"
          }
        }
      },
      {
        "id": "assert-recording",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/agentSessions.composerMic",
            "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
            "expected": {
              "string_value": "true"
            },
            "attribute_name": "aria-pressed",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Confirm the real browser microphone is recording"
          }
        }
      },
