{
  "metadata": {
    "name": "scenario-health-remediation",
    "description": "Inspect a fresh scenario-health projection, preview a phase remediation, then separately preview and explicitly confirm its maturity campaign.",
    "requirement": "REQ-SCENARIO-HEALTH-REMEDIATION",
    "labels": {
      "intent": "governed-remediation",
      "reset": "none",
      "requires": "fresh Test Genie evidence for swarm-manager"
    },
    "version": 1,
    "execution_mode": "EXECUTION_MODE_MUTATING"
  },
  "settings": {
    "viewport_width": 1600,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "open-scenario",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": { "url": "/scenarios/swarm-manager" },
        "metadata": { "label": "Open the Swarm Manager scenario detail" }
      }
    },
    {
      "id": "wait-health",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": { "selector": "@selector/scenarioHealth.section", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 30000 },
        "metadata": { "label": "Wait for the provider-owned health projection" }
      }
    },
    {
      "id": "preview-phase",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "@selector/scenarioHealth.remediationPreviewButton" },
        "metadata": { "label": "Preview phase remediation without creating work" }
      }
    },
    {
      "id": "wait-phase-preview",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": { "selector": "@selector/scenarioHealth.remediationPreview", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 10000 },
        "metadata": { "label": "Review the phase remediation proposal" }
      }
    },
    {
      "id": "accept-phase",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "@selector/scenarioHealth.remediationAcceptButton" },
        "metadata": { "label": "Explicitly create the reviewed phase remediation" }
      }
    },
    {
      "id": "preview-campaign",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "@selector/scenarioHealth.maturityCampaignPreviewButton" },
        "metadata": { "label": "Preview the distinct broad maturity campaign" }
      }
    },
    {
      "id": "wait-campaign-preview",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": { "selector": "@selector/scenarioHealth.maturityCampaignPreview", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 10000 },
        "metadata": { "label": "Review the campaign confirmation state" }
      }
    },
    {
      "id": "confirm-campaign",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "@selector/scenarioHealth.maturityCampaignConfirmButton" },
        "metadata": { "label": "Explicitly create the governed maturity campaign" }
      }
    }
  ],
  "edges": [
    { "from": "open-scenario", "to": "wait-health" },
    { "from": "wait-health", "to": "preview-phase" },
    { "from": "preview-phase", "to": "wait-phase-preview" },
    { "from": "wait-phase-preview", "to": "accept-phase" },
    { "from": "accept-phase", "to": "preview-campaign" },
    { "from": "preview-campaign", "to": "wait-campaign-preview" },
    { "from": "wait-campaign-preview", "to": "confirm-campaign" }
  ]
}
