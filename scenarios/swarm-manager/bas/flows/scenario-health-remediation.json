{
  "metadata": { "name": "scenario-health-remediation", "description": "Preview governed scenario-health remediation and maturity actions.", "execution_mode": "mutating", "labels": { "requires_confirmation": "true", "routed_isolation": "true" } },
  "id": "e780163b-99dd-4ab2-a5f2-b415b55840be",
  "project_id": "5139074a-06f7-4b93-a47f-9a9aaf3b4cd4",
  "name": "scenario-health-remediation",
  "folder_path": "/bas/flows",
  "description": "Inspect a fresh scenario-health projection, preview a phase remediation, then separately preview and explicitly confirm its maturity campaign.",
  "tags": [
    "requires_confirmation:true",
    "routed_isolation:true"
  ],
  "version": 1,
  "created_at": "2026-08-10T03:44:43.552143563Z",
  "updated_at": "2026-08-10T03:44:43.552143563Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 1600,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-scenario",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "url": "/scenarios/swarm-manager"
          },
          "metadata": {
            "label": "Open the Swarm Manager scenario detail"
          }
        }
      },
      {
        "id": "wait-health",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/scenarioHealth.section",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Wait for the provider-owned health projection"
          }
        }
      },
      {
        "id": "preview-phase",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/scenarioHealth.remediationPreviewButton"
          },
          "metadata": {
            "label": "Preview phase remediation without creating work"
          }
        }
      },
      {
        "id": "wait-phase-preview",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/scenarioHealth.remediationPreview",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Review the phase remediation proposal"
          }
        }
      },
      {
        "id": "accept-phase",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/scenarioHealth.remediationAcceptButton"
          },
          "metadata": {
            "label": "Explicitly create the reviewed phase remediation"
          }
        }
      },
      {
        "id": "preview-campaign",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/scenarioHealth.maturityCampaignPreviewButton"
          },
          "metadata": {
            "label": "Preview the distinct broad maturity campaign"
          }
        }
      },
      {
        "id": "wait-campaign-preview",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/scenarioHealth.maturityCampaignPreview",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Review the campaign confirmation state"
          }
        }
      },
      {
        "id": "confirm-campaign",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/scenarioHealth.maturityCampaignConfirmButton"
          },
          "metadata": {
            "label": "Explicitly create the governed maturity campaign"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "open-scenario",
        "target": "wait-health"
      },
      {
        "source": "wait-health",
        "target": "preview-phase"
      },
      {
        "source": "preview-phase",
        "target": "wait-phase-preview"
      },
      {
        "source": "wait-phase-preview",
        "target": "accept-phase"
      },
      {
        "source": "accept-phase",
        "target": "preview-campaign"
      },
      {
        "source": "preview-campaign",
        "target": "wait-campaign-preview"
      },
      {
        "source": "wait-campaign-preview",
        "target": "confirm-campaign"
      }
    ]
  }
}
