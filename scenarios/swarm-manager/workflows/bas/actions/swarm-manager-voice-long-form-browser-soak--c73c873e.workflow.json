  "flow_definition": {
    "metadata": {
      "name": "swarm-manager-voice-long-form-browser-soak",
      "description": "Drive the shared composer microphone for one real-time hour and record terminal/recovery UI evidence."
    },
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900,
      "fake_media": {
        "microphone_wav": "/home/matthalloran8/Vrooli/scenarios/audio-tools/bas/fixtures/dictation-reference.wav"
      }
    },
    "nodes": [
      {
        "id": "open-swarm-manager",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "swarm-manager",
            "scenario_path": "/"
          },
          "metadata": {
            "label": "Open swarm-manager"
          }
        }
      },
      {
        "id": "create-session-and-navigate",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "fetch('/api/v1/agent-sessions', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: 'swarm_operations', title: 'Audio reliability long-form soak' }) }).then((response) => response.json()).then((body) => { const session = body.session || body; const id = session.id || session.sessionId || session.session_id; if (!id) throw new Error('session create response omitted id'); window.location.assign('/sessions/' + encodeURIComponent(id)); return id; })"
          }
        }
      },
      {
        "id": "wait-composer",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "[data-testid=agent-session-composer]",
            "timeout_ms": 30000
          }
        }
      },
      {
        "id": "start-recording",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=agent-session-composer-mic]"
          }
        }
      },
      {
        "id": "assert-recording",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid=agent-session-composer-mic]",
            "mode": "ASSERTION_MODE_ATTRIBUTE_EQUALS",
            "expected": {
              "string_value": "true"
            },
            "attribute_name": "aria-pressed",
            "timeout_ms": 10000
          }
        }
      },
