{
  "name": "swarm-manager-ui",
  "version": "1.0.0",
  "description": "React + Vite front-end for Swarm Manager",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bash -c 'set -e; mkdir -p node_modules/@vrooli; rm -rf node_modules/@vrooli/proto-types; cp -a ../../../packages/proto/gen/typescript node_modules/@vrooli/proto-types'",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run --minWorkers=1 --maxWorkers=1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protovalidate": "^1.1.1",
    "@monaco-editor/react": "^4.7.0",
