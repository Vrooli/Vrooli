{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "generation": {
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    }
  },
  "service": {
    "parent": "vrooli",
    "name": "swarm-manager",
    "displayName": "Swarm Manager",
    "description": "Central command center for managing scenario ecosystem with backlog-driven execution control and lifecycle orchestration",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api",
      "go-cli",
      "scenario-management",
      "ecosystem-orchestration"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/swarm-manager"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "runtime": {
    "kind": "long_running",
    "auto_restart_default": false
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 21234,
      "description": "React UI"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/swarm-manager-api"
            ]
          },
          {
            "type": "cli",
            "command": "swarm-manager"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o swarm-manager-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && pnpm run build; else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./swarm-manager-api",
          "background": true,
          "description": "Start Go API server in background",
          "condition": {
            "file_exists": "api/swarm-manager-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "run-tests",
          "run": "vrooli scenario start swarm-manager && test-genie execute swarm-manager --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'swarm-manager-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "ollama": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Local embedding model (nomic-embed-text) for AI search"
      },
      "qdrant": {
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Vector store for AI search over backlog items and goals"
      }
    },
    "scenarios": {
      "agent-manager": {
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Spawning agents for automated work",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/default.json",
              ".vrooli/agent-manager/deep-work.json",
              ".vrooli/agent-manager/analysis.json",
              ".vrooli/agent-manager/plan-workshop-review.json",
              ".vrooli/agent-manager/plan-workshop-reconcile.json",
              ".vrooli/agent-manager/plan-author.json",
              ".vrooli/agent-manager/phased-plan-slice-review.json",
              ".vrooli/agent-manager/phased-plan-drain.json",
              ".vrooli/agent-manager/plan-repair.json",
              ".vrooli/agent-manager/capture-classify.json",
              ".vrooli/agent-manager/independent-review.json",
              ".vrooli/agent-manager/work-follow-up.json",
              ".vrooli/agent-manager/work-correct.json",
              ".vrooli/agent-manager/scenario-spec-sync.json",
              ".vrooli/agent-manager/evidence-request.json",
              ".vrooli/agent-manager/goal-discover.json",
              ".vrooli/agent-manager/goal-plan.json",
              ".vrooli/agent-manager/milestone-review.json"
            ]
          }
        }
      },
      "plan-manager": {
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Canonical plan authoring, rendering, and execution-plan validation"
      },
      "knowledge-observatory": {
        "enabled": false,
        "required": false,
        "startup_policy": "try_start",
        "description": "PROBLEMS.md management (P1)"
      },
      "visited-tracker": {
        "enabled": false,
        "required": false,
        "startup_policy": "try_start",
        "description": "Context cleanup campaigns (P1)"
      },
      "scenario-completeness-scoring": {
        "enabled": false,
        "required": false,
        "startup_policy": "try_start",
        "description": "Completeness metrics (P1)"
      },
      "test-genie": {
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Validation runs, baseline evidence, and completion gates"
      },
      "prompt-manager": {
        "enabled": true,
        "required": true,
        "startup_policy": "must_start",
        "description": "Skill prompt templates for backlog research and processing"
      },
      "git-control-tower": {
        "enabled": false,
        "required": false,
        "startup_policy": "try_start",
        "description": "Post-execution code review and readiness validation"
      },
      "audio-tools": {
        "enabled": true,
        "required": true,
        "startup_policy": "try_start",
        "description": "STT (mic input in MessageComposer + QuickCapture) and TTS (assistant message playback in Session Details) flow through audio-tools via the audio-integration UI module and the discovery Connect handler. swarm-manager contains zero audio synthesis/transcription code.",
        "degraded_behavior": "If audio-tools is unreachable, the discovery handler returns available:false; the UI hides the mic button and renders an unavailable banner in the Audio settings tab. The API still boots."
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "swarm-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "swarm-manager"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  }
}
