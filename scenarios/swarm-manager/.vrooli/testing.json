{
  "$schema": "../../../../scripts/scenarios/testing/schemas/testing.schema.json",
  "_metadata": {
    "description": "Sample testing configuration for React + Vite template",
    "last_updated": "2025-11-08T00:00:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "languages": {
      "go": {
        "enabled": true,
        "strict": true
      },
      "node": {
        "enabled": true,
        "strict": true
      }
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "languages": {
      "go": {},
      "node": {}
    }
  },
  "docs": {
    "paths": {
      "exclude_globs": [
        "ideas/*-archived/**"
      ]
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      },
      "websockets": {
        "enabled": true
      }
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true
      }
    }
  }
}
