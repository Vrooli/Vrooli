{
  "$schema": "../../test-genie/schemas/testing.schema.json",
  "_metadata": {
    "description": "Sample testing configuration for React + Vite template",
    "last_updated": "2025-11-08T00:00:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "warning",
        "cli": "warning"
      },
      "unmatched_code_components": "warning"
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "policy_profile": {
      "version": "1.0.0",
      "template": {
        "id": "react-vite",
        "scenario_class": "react-vite"
      },
      "required_roles": [
        {
          "role": "api",
          "policy_class": "go_service",
          "match": {
            "surface_id": "api",
            "kind": "api",
            "path": "api",
            "language": "go"
          }
        },
        {
          "role": "cli",
          "policy_class": "go_cli",
          "match": {
            "surface_id": "cli",
            "kind": "cli",
            "path": "cli",
            "language": "go"
          }
        },
        {
          "role": "ui",
          "policy_class": "react_vite_ui",
          "match": {
            "surface_id": "ui",
            "kind": "ui",
            "path": "ui",
            "language": "typescript",
            "framework": "vite"
          }
        }
      ],
      "policy_classes": {
        "go_service": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "api/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          }
        },
        "go_cli": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "cli/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          }
        },
        "react_vite_ui": {
          "language": "typescript",
          "framework": "vitest",
          "package_manager": "pnpm",
          "coverage": {
            "minimum_percent": 85,
            "mode": "both",
            "provider": "v8",
            "reporters": [
              "text",
              "json-summary",
              "json"
            ]
          },
          "test_utils": {
            "required_roots": [
              "ui/src/test-utils"
            ],
            "production_import_ban": true,
            "canonical_render_helper": "ui/src/test-utils/renderWithProviders.tsx"
          },
          "projection": {
            "required_files": [
              "ui/vite.config.ts",
              "ui/src/test-setup.ts",
              "ui/src/test-utils/renderWithProviders.tsx"
            ],
            "required_scripts": [
              "test",
              "test:coverage"
            ],
            "vitest": {
              "environment": "jsdom",
              "setup_files": [
                "./src/test-setup.ts"
              ],
              "coverage_provider": "v8"
            }
          }
        }
      },
      "customization": {
        "mode": "monotonic",
        "waivers": []
      }
    }
  },
  "docs": {
    "paths": {
      "exclude_globs": [
        "ideas/*-archived/**"
      ]
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      },
      "websockets": {
        "enabled": true
      }
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true
      }
    },
    "budgets": {
      "ratchet": true,
      "flows": {
        "graph-load": {
          "load_only": true,
          "component_commit_avg_max_ms": 12,
          "component_commit_max_ms": 100,
          "long_task_total_max_ms": 1500
        },
        "graph-sustained-pan": {
          "dropped_frame_rate_max": 0.35,
          "long_task_total_max_ms": 650,
          "long_task_max_ms": 250,
          "raster_total_max_ms": 2600,
          "layout_total_max_ms": 330,
          "paint_total_max_ms": 200,
          "input_event_count_min": 30
        },
        "graph-wheel-zoom": {
          "dropped_frame_rate_max": 0.55,
          "long_task_total_max_ms": 900,
          "long_task_max_ms": 250,
          "raster_total_max_ms": 4300,
          "layout_total_max_ms": 370,
          "paint_total_max_ms": 220,
          "input_event_count_min": 24
        },
        "graph-pinch-zoom": {
          "dropped_frame_rate_max": 0.45,
          "long_task_total_max_ms": 900,
          "long_task_max_ms": 250,
          "raster_total_max_ms": 1700,
          "layout_total_max_ms": 370,
          "paint_total_max_ms": 200,
          "input_event_count_min": 12
        }
      }
    }
  }
}
