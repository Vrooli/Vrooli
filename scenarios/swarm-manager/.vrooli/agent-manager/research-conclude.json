{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/research-conclude",
  "version": "1.0.0",
  "description": "Produce research evidence and one typed, operator-reviewed disposition through bounded rounds; Swarm owns terminal application.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entity": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "snapshot": {
        "type": "object",
        "additionalProperties": true
      },
      "operatorNote": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "required": [
      "entity",
      "snapshot",
      "operatorNote"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "conclude",
  "nodes": [
    {
      "id": "conclude",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "type": "object",
            "properties": {
              "finding": {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "changed_files": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  },
                  "tests": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  }
                },
                "required": [
                  "summary",
                  "changed_files",
                  "tests",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "disposition": {
                "type": "object",
                "properties": {
                  "kind": {"type": "string", "enum": ["plan_revision", "plan_authoring", "follow_up", "archive", "supersede", "attention"]},
                  "rationale": {"type": "string", "minLength": 1, "maxLength": 8192},
                  "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
                  "scope": {"type": "string", "maxLength": 4096}
                },
                "required": ["kind", "rationale", "confidence"],
                "additionalProperties": false
              },
              "progress": {
                "type": "string",
                "enum": ["continue", "complete", "blocked"]
              },
              "blockers": {
                "type": "array",
                "maxItems": 50,
                "items": {"type": "string", "maxLength": 4096}
              }
            },
            "required": [
              "finding",
              "disposition",
              "progress",
              "blockers"
            ],
            "additionalProperties": false
          }
        },
        "bindings": [
          {
            "name": "entity",
            "source": "workflow_input",
            "selector": "$.entity",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "snapshot",
            "source": "workflow_input",
            "selector": "$.snapshot",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "operator_note",
            "source": "workflow_input",
            "selector": "$.operatorNote",
            "limit": 1,
            "maxBytes": 32768,
            "renderAs": "text",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 24,
        "timeoutSeconds": 1800,
        "promptRef": {
          "skillId": "swarm-manager-workflow-research-conclude"
        }
      }
    },
    {
      "id": "continue",
      "kind": "continue",
      "continue": {
        "conversationFromNode": "conclude",
        "bindings": [],
        "maxTurns": 24,
        "timeoutSeconds": 1800,
        "promptRef": {
          "skillId": "swarm-manager-workflow-research-conclude-continue"
        }
      }
    },
    {
      "id": "route",
      "kind": "branch",
      "branch": {}
    },
    {
      "id": "completed",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    },
    {
      "id": "blocked",
      "kind": "end",
      "end": {
        "status": "blocked",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    },
    {
      "id": "limit",
      "kind": "end",
      "end": {
        "status": "budget_exhausted",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "conclude",
      "to": "route",
      "maxTraversals": 6
    },
    {
      "from": "continue",
      "to": "route",
      "maxTraversals": 6
    },
    {
      "from": "route",
      "to": "completed",
      "condition": "latest(journal).value.progress == 'complete'"
    },
    {
      "from": "route",
      "to": "blocked",
      "condition": "latest(journal).value.progress == 'blocked'"
    },
    {
      "from": "route",
      "to": "continue",
      "condition": "latest(journal).value.progress == 'continue' && count(journal, 'conclude') + count(journal, 'continue') < 6",
      "maxTraversals": 5
    },
    {
      "from": "route",
      "to": "limit",
      "condition": "latest(journal).value.progress == 'continue' && count(journal, 'conclude') + count(journal, 'continue') >= 6"
    }
  ],
  "budgets": {
    "wallTimeSeconds": 14400,
    "maxTurns": 144,
    "maxTokens": 180000,
    "maxCostUsd": 20,
    "maxNodeAttempts": 12,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 3,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "consumerMutationOwner": "swarm-manager",
    "transition": "research.conclude"
  }
}
