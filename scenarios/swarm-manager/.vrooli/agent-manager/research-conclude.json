{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/research-conclude",
  "version": "1.0.0",
  "description": "Produce a planless research conclusion through bounded typed handoff rounds; Swarm owns the item and terminal application.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entity": {"type": "object", "properties": {"kind": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}}, "required": ["kind", "name", "version"], "additionalProperties": false},
      "snapshot": {"type": "object", "additionalProperties": true},
      "operatorNote": {"type": "string", "maxLength": 32768}
    },
    "required": ["entity", "snapshot", "operatorNote"],
    "additionalProperties": false
  },
  "outputSchema": {"type": "object", "properties": {"result": {"type": "object", "additionalProperties": true}}, "required": ["result"], "additionalProperties": false},
  "entryNode": "conclude",
  "nodes": [
    {"id": "conclude", "kind": "run", "run": {"profileKey": "swarm-manager/deep-work", "promptTemplate": "Work the planless research item to its conclusion. Treat the supplied item snapshot as immutable. Return only typed JSON with a handoff and progress. Do not mutate files outside the authorized workspace.\n\nEntity:\n{{.entity}}\n\nSnapshot:\n{{.snapshot}}\n\nOperator note:\n{{.operator_note}}", "resultSpec": {"version": "result-spec/v1", "kind": "json_schema", "extractionMode": "deterministic_only", "schema": {"type": "object", "properties": {"handoff": {"type": "object", "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 16384}, "blockers": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 4096}}, "next_step": {"type": "string", "maxLength": 4096}, "changed_files": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1024}}, "tests": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1024}}, "progress": {"type": "string", "enum": ["continue", "complete", "blocked"]}}, "required": ["summary", "blockers", "next_step", "changed_files", "tests", "progress"], "additionalProperties": false}}, "required": ["handoff"], "additionalProperties": false}}, "bindings": [{"name": "entity", "source": "workflow_input", "selector": "$.entity", "limit": 1, "maxBytes": 1024, "renderAs": "json", "missingPolicy": "error"}, {"name": "snapshot", "source": "workflow_input", "selector": "$.snapshot", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}, {"name": "operator_note", "source": "workflow_input", "selector": "$.operatorNote", "limit": 1, "maxBytes": 32768, "renderAs": "text", "missingPolicy": "error"}], "maxTurns": 24, "timeoutSeconds": 1800}},
    {"id": "continue", "kind": "continue", "continue": {"conversationFromNode": "conclude", "promptTemplate": "Continue the same bounded conclusion work. Return a complete replacement typed handoff JSON matching the original result contract.", "bindings": [], "maxTurns": 24, "timeoutSeconds": 1800}},
    {"id": "route", "kind": "branch", "branch": {}},
    {"id": "completed", "kind": "end", "end": {"status": "succeeded", "bindings": [{"name": "result", "source": "structured_result", "selector": "$.value", "order": "desc", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}]}},
    {"id": "blocked", "kind": "end", "end": {"status": "blocked", "bindings": [{"name": "result", "source": "structured_result", "selector": "$.value", "order": "desc", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}]}},
    {"id": "limit", "kind": "end", "end": {"status": "budget_exhausted", "bindings": [{"name": "result", "source": "structured_result", "selector": "$.value", "order": "desc", "limit": 1, "maxBytes": 65536, "renderAs": "json", "missingPolicy": "error"}]}}
  ],
  "edges": [
    {"from": "conclude", "to": "route", "maxTraversals": 6},
    {"from": "continue", "to": "route", "maxTraversals": 6},
    {"from": "route", "to": "completed", "condition": "latest(journal).value.handoff.progress == 'complete'"},
    {"from": "route", "to": "blocked", "condition": "latest(journal).value.handoff.progress == 'blocked'"},
    {"from": "route", "to": "continue", "condition": "latest(journal).value.handoff.progress == 'continue' && count(journal, 'conclude') + count(journal, 'continue') < 6", "maxTraversals": 5},
    {"from": "route", "to": "limit", "condition": "latest(journal).value.handoff.progress == 'continue' && count(journal, 'conclude') + count(journal, 'continue') >= 6"}
  ],
  "budgets": {"wallTimeSeconds": 14400, "maxTurns": 144, "maxTokens": 180000, "maxCostUsd": 20, "maxNodeAttempts": 12, "maxChildren": 1, "maxConcurrency": 1, "maxRecursion": 1, "maxRetries": 3, "maxWaitSeconds": 60},
  "metadata": {"consumerMutationOwner": "swarm-manager", "transition": "research.conclude"}
}
