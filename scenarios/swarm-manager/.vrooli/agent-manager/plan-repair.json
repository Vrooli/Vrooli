{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/plan-repair",
  "version": "1.0.0",
  "description": "Repair one invalid or stale plan from immutable Plan Manager findings, then return a typed candidate or truthful attention outcome. Swarm revalidates before binding any plan reference.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entity": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "plan": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "frontierDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "reference",
          "content",
          "frontierDigest"
        ],
        "additionalProperties": false
      },
      "validation": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "checkedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "findings",
          "checkedAt"
        ],
        "additionalProperties": false
      },
      "constraints": {
        "type": "object",
        "properties": {
          "maxRepairAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "maxRepairAttempts"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "entity",
      "plan",
      "validation",
      "constraints"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "nodes": [
    {
      "id": "repair",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "ready"
                  },
                  "candidatePlan": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "candidatePlan",
                  "summary"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "needs_attention"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "unresolvedFindings": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                },
                "required": [
                  "outcome",
                  "reason",
                  "unresolvedFindings"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "entity",
            "source": "workflow_input",
            "selector": "$.entity",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "plan_reference",
            "source": "workflow_input",
            "selector": "$.plan.reference",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "plan_digest",
            "source": "workflow_input",
            "selector": "$.plan.frontierDigest",
            "limit": 1,
            "maxBytes": 256,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "plan_content",
            "source": "workflow_input",
            "selector": "$.plan.content",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "validation_findings",
            "source": "workflow_input",
            "selector": "$.validation.findings",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "constraints",
            "source": "workflow_input",
            "selector": "$.constraints",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 16,
        "timeoutSeconds": 1200,
        "promptRef": {
          "skillId": "swarm-manager-workflow-plan-repair"
        }
      }
    }
  ],
  "budgets": {
    "wallTimeSeconds": 1500,
    "maxTurns": 16,
    "maxTokens": 60000,
    "maxCostUsd": 8,
    "maxNodeAttempts": 3,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 2,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "pilot": "plan-repair",
    "consumerMutationOwner": "swarm-manager",
    "validationAuthority": "plan-manager",
    "transition": "plan.repair"
  }
}
