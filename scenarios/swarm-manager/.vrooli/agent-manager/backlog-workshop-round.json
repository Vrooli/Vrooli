{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/backlog-workshop-round",
  "version": "1.0.0",
  "description": "Produce one typed workshop proposal from an immutable backlog snapshot; Swarm Manager validates and applies it.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entity": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "snapshot": {
        "type": "object",
        "additionalProperties": true
      },
      "operatorNote": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "required": [
      "entity",
      "snapshot",
      "operatorNote"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "workshop",
  "nodes": [
    {
      "id": "workshop",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "proposals"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 32768
                  },
                  "decisionQuestions": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "topic": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "context": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "options": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 16
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512
                              },
                              "rationale": {
                                "type": "string",
                                "maxLength": 2048
                              },
                              "recommended": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "key",
                              "label",
                              "rationale",
                              "recommended"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "topic",
                        "context",
                        "options"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "readiness": {
                    "type": "object",
                    "properties": {
                      "problem_clarity": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "scope_defined": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "approach_solid": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "testable": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "risk_awareness": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      }
                    },
                    "required": [
                      "problem_clarity",
                      "scope_defined",
                      "approach_solid",
                      "testable",
                      "risk_awareness"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "outcome",
                  "note",
                  "decisionQuestions",
                  "readiness"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "no_questions"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 32768
                  },
                  "readiness": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                },
                "required": [
                  "outcome",
                  "note",
                  "readiness"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "entity",
            "source": "workflow_input",
            "selector": "$.entity",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "snapshot",
            "source": "workflow_input",
            "selector": "$.snapshot",
            "limit": 1,
            "maxBytes": 32768,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "operator_note",
            "source": "workflow_input",
            "selector": "$.operatorNote",
            "limit": 1,
            "maxBytes": 32768,
            "renderAs": "text",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 12,
        "timeoutSeconds": 900,
        "promptRef": {
          "skillId": "swarm-manager-workflow-backlog-refine"
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "node=workshop;$.value",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "workshop",
      "to": "done"
    }
  ],
  "budgets": {
    "wallTimeSeconds": 1200,
    "maxTurns": 12,
    "maxTokens": 30000,
    "maxCostUsd": 5,
    "maxNodeAttempts": 2,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 1,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "pilot": "backlog-workshop-round",
    "consumerMutationOwner": "swarm-manager"
  }
}
