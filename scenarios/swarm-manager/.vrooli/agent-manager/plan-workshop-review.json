{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/plan-workshop-review",
  "version": "1.0.0",
  "description": "Produce a typed Plan Workshop review packet from an immutable generic subject snapshot; Swarm records Agent Session proposal entries and owns all mutation.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "subject": {
        "type": "object",
        "additionalProperties": true
      },
      "snapshot": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "subject",
      "snapshot"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "review",
  "nodes": [
    {
      "id": "review",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "packet"
                  },
                  "findings": {
                    "type": "array",
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "severity": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "evidence": {
                          "type": "string",
                          "maxLength": 8192
                        }
                      },
                      "required": [
                        "id",
                        "severity",
                        "summary"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "questions": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "question": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "options": {
                          "type": "array",
                          "maxItems": 12,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512
                          }
                        }
                      },
                      "required": [
                        "id",
                        "question"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "proposals": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "payload": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "apply_mode": {
                          "enum": [
                            "direct",
                            "reconciliation",
                            "attention"
                          ]
                        }
                      },
                      "required": [
                        "summary",
                        "payload",
                        "apply_mode"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "needs_attention"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "subject",
            "source": "workflow_input",
            "selector": "$.subject",
            "limit": 1,
            "maxBytes": 4096,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "snapshot",
            "source": "workflow_input",
            "selector": "$.snapshot",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 12,
        "timeoutSeconds": 900,
        "promptRef": {
          "skillId": "swarm-manager-plan-workshop-review"
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "node=review;$.value",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "review",
      "to": "done"
    }
  ],
  "budgets": {
    "wallTimeSeconds": 1200,
    "maxTurns": 12,
    "maxTokens": 600000,
    "maxCostUsd": 5,
    "maxNodeAttempts": 2,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 1,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "consumerMutationOwner": "swarm-manager",
    "transition": "plan.workshop.review"
  }
}
