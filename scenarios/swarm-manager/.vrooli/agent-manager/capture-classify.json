{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/capture-classify",
  "version": "1.0.0",
  "description": "Classify one immutable capture into typed backlog suggestions. Swarm Manager persists the result; the workflow never writes capture files.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "capture": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "note": {
            "type": "string",
            "maxLength": 8192
          },
          "attachments": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "text",
          "note",
          "attachments",
          "version"
        ],
        "additionalProperties": false
      },
      "grounding": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "capture",
      "grounding"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "classify",
  "nodes": [
    {
      "id": "classify",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/analysis",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "suggested"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "properties": {
                    "kind": {
                          "type": "string",
                          "enum": [
                            "idea",
                            "research",
                            "fix",
                            "execute",
                            "chore"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 8192
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10
                        },
                        "tags": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "string",
                            "maxLength": 64
                          }
                        },
                        "depends_on": {
                          "type": "array",
                          "maxItems": 50,
                          "items": { "type": "string", "minLength": 3, "maxLength": 256 }
                        },
                        "milestone": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "effort": {
                          "type": "string",
                          "enum": ["XS", "S", "M", "L", "XL"]
                        },
                        "acceptance_allow": {
                          "type": "array",
                          "maxItems": 50,
                          "items": { "type": "string", "maxLength": 512 }
                        },
                        "acceptance_deny": {
                          "type": "array",
                          "maxItems": 50,
                          "items": { "type": "string", "maxLength": 512 }
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                  "required": [
                    "kind",
                        "title",
                        "description",
                        "priority",
                        "tags",
                        "confidence"
                      ],
                  "additionalProperties": false
                    }
                  },
                  "goal": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "title": { "type": "string", "minLength": 1, "maxLength": 512 },
                      "description": { "type": "string", "maxLength": 8192 },
                      "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "targets": {
                        "type": "array",
                        "maxItems": 50,
                        "items": { "type": "string", "minLength": 3, "maxLength": 256 }
                      },
                      "milestones": {
                        "type": "array",
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                            "title": { "type": "string", "minLength": 1, "maxLength": 512 },
                            "description": { "type": "string", "maxLength": 8192 },
                            "acceptance_criteria": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 20,
                              "items": { "type": "string", "maxLength": 1024 }
                            },
                            "depends_on": {
                              "type": "array",
                              "maxItems": 20,
                              "items": { "type": "string", "maxLength": 128 }
                            }
                          },
                          "required": ["name", "title", "acceptance_criteria"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["name", "title", "description", "priority", "targets", "milestones"],
                    "additionalProperties": false
                  },
                  "research_item": {
                    "type": "object",
                    "properties": {
                  "kind": { "const": "research" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "title": { "type": "string", "minLength": 1, "maxLength": 512 },
                      "description": { "type": "string", "maxLength": 8192 },
                      "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
                      "depends_on": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 256 } },
                      "effort": { "type": "string", "enum": ["XS", "S", "M", "L", "XL"] },
                      "acceptance_allow": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 512 } },
                      "acceptance_deny": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 512 } },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "required": ["kind", "title", "description", "priority", "tags", "confidence"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "outcome",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": { "const": "research" },
                  "research_item": {
                    "type": "object",
                    "properties": {
                  "kind": { "const": "research" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "title": { "type": "string", "minLength": 1, "maxLength": 512 },
                      "description": { "type": "string", "maxLength": 8192 },
                      "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
                      "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
                      "depends_on": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 256 } },
                      "effort": { "type": "string", "enum": ["XS", "S", "M", "L", "XL"] },
                      "acceptance_allow": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 512 } },
                      "acceptance_deny": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 512 } },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "required": ["kind", "title", "description", "priority", "tags", "confidence"],
                    "additionalProperties": false
                  }
                },
                "required": ["outcome", "research_item"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "discarded"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "capture",
            "source": "workflow_input",
            "selector": "$.capture",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "grounding",
            "source": "workflow_input",
            "selector": "$.grounding",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 24,
        "timeoutSeconds": 1800,
        "promptRef": {
          "skillId": "swarm-manager-workflow-capture-classify"
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "node=classify;$.value",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "classify",
      "to": "done"
    }
  ],
  "budgets": {
    "wallTimeSeconds": 2100,
    "maxTurns": 24,
    "maxTokens": 900000,
    "maxChargeMicroUsd": 2,
    "maxNodeAttempts": 2,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 1,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "consumerMutationOwner": "swarm-manager"
  }
}
