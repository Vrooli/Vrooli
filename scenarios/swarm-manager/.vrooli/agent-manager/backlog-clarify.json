{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/backlog-clarify",
  "version": "1.0.0",
  "description": "Clarify a backlog workshop decision from an immutable thread snapshot. The workflow owns prompts and continuation state; Swarm owns thread persistence and applying typed replies.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "entity": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "kind",
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "decision": {
        "type": "object",
        "additionalProperties": true
      },
      "thread": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "entity",
      "decision",
      "thread"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "clarified"
              },
              "reply": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "resolved"
                ]
              }
            },
            "required": [
              "outcome",
              "reply",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "abstained"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "outcome",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "clarify",
  "nodes": [
    {
      "id": "clarify",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "clarified"
                  },
                  "reply": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "resolved"
                    ]
                  }
                },
                "required": [
                  "outcome",
                  "reply",
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "entity",
            "source": "workflow_input",
            "selector": "$.entity",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "decision",
            "source": "workflow_input",
            "selector": "$.decision",
            "limit": 1,
            "maxBytes": 16384,
            "renderAs": "json",
            "missingPolicy": "error"
          },
          {
            "name": "thread",
            "source": "workflow_input",
            "selector": "$.thread",
            "limit": 1,
            "maxBytes": 32768,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ],
        "maxTurns": 12,
        "timeoutSeconds": 900,
        "promptRef": {
          "skillId": "swarm-manager-workflow-backlog-clarify"
        }
      }
    },
    {
      "id": "done",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "node=clarify;$.value",
            "limit": 1,
            "maxBytes": 65536,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "clarify",
      "to": "done"
    }
  ],
  "budgets": {
    "wallTimeSeconds": 1200,
    "maxTurns": 12,
    "maxTokens": 30000,
    "maxCostUsd": 5,
    "maxNodeAttempts": 2,
    "maxChildren": 1,
    "maxConcurrency": 1,
    "maxRecursion": 1,
    "maxRetries": 1,
    "maxWaitSeconds": 60
  },
  "metadata": {
    "consumerMutationOwner": "swarm-manager",
    "transition": "backlog.clarify"
  }
}
