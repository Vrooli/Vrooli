{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/until-drain",
  "version": "1.0.0",
  "description": "One warm plan engagement that continues until the accepted plan frontier is complete or a typed terminal is reached.",
  "inputSchema": {
    "type": "object",
    "required": ["projectRoot", "plan", "planExecutionId", "consumer", "constraints"],
    "properties": {
      "projectRoot": {"type": "string", "minLength": 1, "maxLength": 4096},
      "plan": {"type": "object"},
      "planExecutionId": {"type": "string", "minLength": 1},
      "consumer": {"type": "object"},
      "constraints": {"type": "object"}
    },
    "additionalProperties": false
  },
  "outputSchema": {"type": "object", "required": ["result"], "properties": {"result": {"type": "object"}}, "additionalProperties": false},
  "entryNode": "iterate",
  "nodes": [
    {
      "id": "iterate",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "promptRef": {"skillId": "swarm-manager-workflow-until-drain", "withScope": false},
        "until": "The accepted Plan Manager execution frontier reports that every plan phase is complete, and the applied execution record contains the resulting evidence.",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {"type": "object", "required": ["outcome"], "properties": {"outcome": {"enum": ["complete", "blocked", "needs_review", "needs_attention", "abstained", "failed", "budget_exhausted", "cancelled"]}, "reason": {"type": "string"}}, "additionalProperties": true}
        }
      }
    },
    {
      "id": "resume",
      "kind": "continue",
      "continue": {
        "conversationFromNode": "iterate",
        "promptTemplate": "Continue the same engagement. Re-check the authoritative Plan Manager frontier and advance the accepted plan. Return the next typed outcome.",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {"type": "object", "required": ["outcome"], "properties": {"outcome": {"enum": ["complete", "blocked", "needs_review", "needs_attention", "abstained", "failed", "budget_exhausted", "cancelled"]}}, "additionalProperties": true}
        }
      }
    },
    {"id": "done", "kind": "end", "end": {"status": "succeeded", "bindings": [{"name": "result", "source": "structured_result", "selector": "$.value", "order": "desc", "limit": 1, "maxBytes": 16384, "renderAs": "json", "missingPolicy": "error"}]}}
  ],
  "edges": [
    {"from": "iterate", "to": "done", "condition": "latest(journal).value.outcome == 'complete'"},
    {"from": "iterate", "to": "resume", "condition": "latest(journal).value.outcome != 'complete'", "maxTraversals": 999},
    {"from": "resume", "to": "iterate", "maxTraversals": 999}
  ],
  "budgets": {
    "wallTimeSeconds": 97200,
    "maxTurns": 1000,
    "maxTokens": 18000000,
    "maxChargeMicroUsd": 18000000,
    "maxNodeAttempts": 1000,
    "maxChildren": 100,
    "maxConcurrency": 1,
    "maxRecursion": 4,
    "maxRetries": 20,
    "maxWaitSeconds": 97200
  },
  "metadata": {
    "budgetMeasurementDate": "2026-08-21",
    "budgetMeasurementSource": "Codex goal ledger measured completion work: 18M-token and 27-hour admission envelope"
  }
}
