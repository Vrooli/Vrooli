{
  "schemaVersion": "agent-workflow/v1",
  "owner": "swarm-manager",
  "key": "swarm-manager/phased-plan-drain",
  "version": "1.0.18",
  "description": "Drain a stable plan in bounded fresh-run slices with compact ordered handoffs and explicit correction/approval paths.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "projectRoot": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "plan": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "frontierDigest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "reference",
          "frontierDigest"
        ],
        "additionalProperties": false
      },
      "planExecutionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "consumer": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "entityKind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "entityName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "entityVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "executionId",
          "entityKind",
          "entityName",
          "entityVersion"
        ],
        "additionalProperties": false
      },
      "constraints": {
        "type": "object",
        "properties": {
          "maxSlices": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "executionStrategy": {
            "type": "string",
            "enum": [
              "phased-plan-drain",
              "adaptive-improvement",
              "goal-session"
            ]
          },
          "writeScope": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "sliceApprovalMode": {
            "type": "string",
            "enum": [
              "manual",
              "suggest",
              "auto"
            ]
          },
          "scopePolicy": {
            "type": "string",
            "enum": [
              "fixed",
              "extend-with-record"
            ]
          }
        },
        "required": [
          "maxSlices",
          "writeScope",
          "sliceApprovalMode"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "projectRoot",
      "plan",
      "planExecutionId",
      "consumer",
      "constraints"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "entryNode": "slice",
  "nodes": [
    {
      "id": "slice",
      "kind": "run",
      "run": {
        "profileKey": "swarm-manager/deep-work",
        "resultSpec": {
          "version": "result-spec/v1",
          "kind": "json_schema",
          "extractionMode": "deterministic_only",
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "continue"
                  },
                  "handoff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "correctionRequired": {
                    "type": "boolean"
                  },
                  "approvalRequired": {
                    "type": "boolean"
                  },
                  "approvalReason": {
                    "type": "string",
                    "enum": [
                      "phase-boundary",
                      "operator-decision"
                    ]
                  }
                },
                "required": [
                  "outcome",
                  "handoff",
                  "correctionRequired",
                  "approvalRequired"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "complete"
                  },
                  "handoff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "outcome",
                  "handoff"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "blocked"
                  },
                  "handoff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "blocker": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "retryable": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "summary",
                      "retryable"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "outcome",
                  "handoff",
                  "blocker"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "abstained"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "outcome",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "bindings": [
          {
            "name": "plan_reference",
            "source": "workflow_input",
            "selector": "$.plan.reference",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "plan_digest",
            "source": "workflow_input",
            "selector": "$.plan.frontierDigest",
            "limit": 1,
            "maxBytes": 256,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "plan_execution_id",
            "source": "workflow_input",
            "selector": "$.planExecutionId",
            "limit": 1,
            "maxBytes": 256,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "constraints",
            "source": "workflow_input",
            "selector": "$.constraints",
            "limit": 1,
            "maxBytes": 8192,
            "renderAs": "json_pretty",
            "missingPolicy": "error"
          },
          {
            "name": "previous_handoffs",
            "source": "structured_result",
            "selector": "$.value.handoff",
            "order": "desc",
            "limit": 6,
            "maxBytes": 49152,
            "renderAs": "json_pretty",
            "missingPolicy": "null"
          }
        ],
        "maxTurns": 60,
        "timeoutSeconds": 5400,
        "promptRef": {
          "skillId": "swarm-manager-workflow-phased-plan-slice"
        }
      }
    },
    {
      "id": "review",
      "kind": "child_workflow",
      "childWorkflow": {
        "workflowKey": "swarm-manager/phased-plan-slice-review",
        "version": "1.0.6",
        "bindings": [
          {
            "name": "plan_reference",
            "source": "workflow_input",
            "selector": "$.plan.reference",
            "limit": 1,
            "maxBytes": 1024,
            "renderAs": "text",
            "missingPolicy": "error"
          },
          {
            "name": "handoff",
            "source": "structured_result",
            "selector": "$.value.handoff",
            "order": "desc",
            "limit": 1,
            "maxBytes": 8192,
            "renderAs": "text",
            "missingPolicy": "error"
          }
        ],
        "maxDepth": 2
      }
    },
    {
      "id": "pre_review",
      "kind": "branch",
      "branch": {}
    },
    {
      "id": "route",
      "kind": "branch",
      "branch": {}
    },
    {
      "id": "correction",
      "kind": "continue",
      "continue": {
        "conversationFromNode": "slice",
        "bindings": [
          {
            "name": "review_note",
            "source": "child_workflow_output",
            "selector": "node=review;$.output.result.note",
            "order": "desc",
            "limit": 1,
            "maxBytes": 4096,
            "renderAs": "text",
            "missingPolicy": "null"
          }
        ],
        "maxTurns": 3,
        "timeoutSeconds": 300,
        "promptRef": {
          "skillId": "swarm-manager-workflow-phased-plan-correction"
        }
      }
    },
    {
      "id": "decision",
      "kind": "branch",
      "branch": {}
    },
    {
      "id": "approval",
      "kind": "wait",
      "wait": {
        "signal": "slice_approved",
        "payloadSchema": {
          "type": "object",
          "properties": {
            "executionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "actor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "required": [
            "executionId",
            "actor"
          ],
          "additionalProperties": false
        },
        "timeoutSeconds": 3600
      }
    },
    {
      "id": "complete",
      "kind": "end",
      "end": {
        "status": "succeeded",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 16384,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    },
    {
      "id": "blocked",
      "kind": "end",
      "end": {
        "status": "blocked",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 16384,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    },
    {
      "id": "abstained",
      "kind": "end",
      "end": {
        "status": "abstained",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 16384,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    },
    {
      "id": "slice_limit",
      "kind": "end",
      "end": {
        "status": "budget_exhausted",
        "bindings": [
          {
            "name": "result",
            "source": "structured_result",
            "selector": "$.value",
            "order": "desc",
            "limit": 1,
            "maxBytes": 16384,
            "renderAs": "json",
            "missingPolicy": "error"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "slice",
      "to": "pre_review",
      "maxTraversals": 512
    },
    {
      "from": "pre_review",
      "to": "blocked",
      "condition": "latest(journal).value.outcome == 'blocked'"
    },
    {
      "from": "pre_review",
      "to": "abstained",
      "condition": "latest(journal).value.outcome == 'abstained'"
    },
    {
      "from": "pre_review",
      "to": "review",
      "maxTraversals": 1536
    },
    {
      "from": "review",
      "to": "route",
      "maxTraversals": 512
    },
    {
      "from": "route",
      "to": "correction",
      "condition": "((latest(journal).value.outcome == 'continue' && latest(journal).value.correctionRequired) || (has(latest(journal, 'review').output) && !latest(journal, 'review').output.result.accepted)) && count_since_last(journal, 'correction', 'slice') < 2",
      "maxTraversals": 1024
    },
    {
      "from": "route",
      "to": "blocked",
      "condition": "has(latest(journal, 'review').output) && !latest(journal, 'review').output.result.accepted && count_since_last(journal, 'correction', 'slice') >= 2"
    },
    {
      "from": "route",
      "to": "decision",
      "maxTraversals": 512
    },
    {
      "from": "correction",
      "to": "pre_review",
      "maxTraversals": 1024
    },
    {
      "from": "decision",
      "to": "complete",
      "condition": "latest(journal).value.outcome == 'complete'"
    },
    {
      "from": "decision",
      "to": "approval",
      "condition": "latest(journal).value.outcome == 'continue' && ((has(latest(journal).value.approvalReason) && latest(journal).value.approvalReason == 'operator-decision') || (latest(journal).value.approvalRequired && input.constraints.sliceApprovalMode != 'auto' && !(has(input.constraints.executionStrategy) && input.constraints.executionStrategy == 'adaptive-improvement' && has(latest(journal).value.approvalReason) && latest(journal).value.approvalReason == 'phase-boundary'))) && count(journal, 'slice') < input.constraints.maxSlices",
      "maxTraversals": 512
    },
    {
      "from": "decision",
      "to": "slice",
      "condition": "latest(journal).value.outcome == 'continue' && !latest(journal).value.approvalRequired && !(has(latest(journal).value.approvalReason) && latest(journal).value.approvalReason == 'operator-decision') && count(journal, 'slice') < input.constraints.maxSlices",
      "maxTraversals": 512
    },
    {
      "from": "decision",
      "to": "slice",
      "condition": "latest(journal).value.outcome == 'continue' && latest(journal).value.approvalRequired && !(has(latest(journal).value.approvalReason) && latest(journal).value.approvalReason == 'operator-decision') && (input.constraints.sliceApprovalMode == 'auto' || (has(input.constraints.executionStrategy) && input.constraints.executionStrategy == 'adaptive-improvement' && has(latest(journal).value.approvalReason) && latest(journal).value.approvalReason == 'phase-boundary')) && count(journal, 'slice') < input.constraints.maxSlices",
      "maxTraversals": 512
    },
    {
      "from": "decision",
      "to": "slice_limit",
      "condition": "latest(journal).value.outcome == 'continue' && count(journal, 'slice') >= input.constraints.maxSlices"
    },
    {
      "from": "approval",
      "to": "slice",
      "maxTraversals": 512
    }
  ],
  "budgets": {
    "wallTimeSeconds": 21600,
    "maxTurns": 144,
    "maxTokens": 7200000,
    "maxChargeMicroUsd": 30000000,
    "maxNodeAttempts": 48,
    "maxChildren": 12,
    "maxConcurrency": 2,
    "maxRecursion": 3,
    "maxRetries": 6,
    "maxWaitSeconds": 3600
  },
  "metadata": {
    "pilot": "phased-plan-drain",
    "consumerMutationOwner": "swarm-manager",
    "freshRunPerSlice": "true",
    "revisionReason": "Prompt-facing constraints and previous handoffs use json_pretty so text templates receive valid JSON; the adaptive slice allows one real validation wait."
  },
  "grantCapacity": {
    "wallTimeSeconds": 604800,
    "maxTurns": 100000,
    "maxTokens": 2147483647,
    "maxChargeMicroUsd": 1000000000000,
    "maxNodeAttempts": 8192,
    "maxChildren": 4096,
    "maxConcurrency": 2,
    "maxRecursion": 3,
    "maxRetries": 4096,
    "maxWaitSeconds": 3600
  }
}
