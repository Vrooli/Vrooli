{
  "kind": "operating-mode",
  "id": "backlog-research",
  "label": "Backlog Research",
  "description": "One autonomous research round over a single backlog item: investigate its kind, deliverable, prior history and attached context, and refine the spec/research toward readiness. Loops on continue; stops on complete or blocked. Implements the research-refine operation.",
  "best_for": [
    "A backlog item whose spec needs autonomous research before workshop synthesis",
    "Items with attached context or archive requirements to fold into the spec"
  ],
  "not_for": [
    "Synthesizing workshop decisions \u2014 use backlog-workshop",
    "Whole-initiative investigation \u2014 use holistic-loop"
  ],
  "tradeoffs": [
    "One item at a time, one research round per agent run",
    "Refines the spec but does not bind a readiness plan_ref \u2014 that is workshop-finalize"
  ],
  "when_in_doubt_pick_instead": "backlog-workshop",
  "target": {
    "kind": "backlog-item"
  },
  "input_contract": {
    "specs": [
      {
        "id": "execution.mode_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Stable operating-mode identity for this execution."
      },
      {
        "id": "execution.phase_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Current phase identity within the pinned graph."
      },
      {
        "id": "execution.round_number",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "sensitivity": "public",
        "retention": "value",
        "description": "One-based round number within the immutable execution."
      },
      {
        "id": "execution.agent_profile_key",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Agent Manager profile selected for the current phase."
      },
      {
        "id": "execution.operator_note",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Optional operator guidance for the current round."
      },
      {
        "id": "execution.user_prompt",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "The operator's research prompt/instruction driving this refinement pass (legacy research request text)."
      },
      {
        "id": "execution.context_paths",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Repository paths/files the operator attached as research context, one per line."
      },
      {
        "id": "execution.context_targets",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Named targets (scenarios, resources, components) the operator scoped the research to, one per line."
      },
      {
        "id": "execution.context_requirements",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Explicit requirements or acceptance notes the operator attached to fold into the spec."
      },
      {
        "id": "execution.gap_report",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "A prior readiness/gap report identifying what the spec still lacks, to steer this round."
      },
      {
        "id": "execution.prior_rounds",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Durable prior round envelopes available to the current round."
      },
      {
        "id": "execution.mode_artifacts",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Declared artifacts accumulated under the mode execution."
      },
      {
        "id": "item.title",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Backlog item title."
      },
      {
        "id": "item.description",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "Backlog item description."
      },
      {
        "id": "item.status",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "Current backlog item status."
      },
      {
        "id": "item.spec",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "The item's authorable spec/research document content."
      }
    ],
    "sources": [
      {
        "input_id": "execution.mode_id",
        "kind": "generic_provider",
        "capability": "generic.operating_mode"
      },
