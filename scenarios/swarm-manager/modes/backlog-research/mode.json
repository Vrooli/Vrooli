        "input_id": "execution.prior_rounds"
      },
      {
        "name": "MODE_ARTIFACTS_JSON",
        "input_id": "execution.mode_artifacts"
      },
      {
        "name": "ITEM_TITLE",
        "input_id": "item.title"
      },
      {
        "name": "ITEM_DESCRIPTION",
        "input_id": "item.description"
      },
      {
        "name": "ITEM_STATUS",
        "input_id": "item.status"
      },
      {
        "name": "ITEM_SPEC",
        "input_id": "item.spec"
      }
    ]
  },
  "run_strategy": {
    "kind": "sequential_handoff"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-backlog-research"
  },
  "artifact": {
    "root": "modes/backlog-research"
  },
  "profile": {
    "default_profile_key": "swarm-manager/deep-work"
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "research",
    "phases": [
      {
        "id": "research",
        "kind": "investigate",
        "activity_purpose": "backlog_research",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "OPERATOR_NOTE",
          "USER_PROMPT",
          "CONTEXT_PATHS",
          "CONTEXT_TARGETS",
          "CONTEXT_REQUIREMENTS",
          "GAP_REPORT",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "ITEM_TITLE",
          "ITEM_DESCRIPTION",
          "ITEM_STATUS",
          "ITEM_SPEC"
        ],
        "profile_key": "swarm-manager/deep-work",
        "prompt": {
          "suffix": "research",
          "title": "Backlog Research Round",
          "trigger": "Operator starts (or the loop continues) the backlog-research phase",
          "purpose": "Investigate the backlog item and refine its spec/research toward readiness, emitting a handoff stating what was refined and whether another round is warranted."
        },
        "declared_output": {
          "fields": [
            {
              "name": "handoff",
              "type": "object",
              "required": true,
              "description": "The structured handoff the next round consumes.",
              "fields": [
                {
                  "name": "summary",
                  "type": "string",
                  "required": true,
                  "description": "Concise statement of what this round did."
                },
                {
                  "name": "blockers",
                  "type": "array",
                  "required": true,
                  "description": "Known blockers; use a single item such as \"none\" when there are none."
                },
                {
                  "name": "next_step",
                  "type": "string",
                  "required": true,
                  "description": "The immediate next step after this round."
                },
                {
                  "name": "changed_files",
                  "type": "array",
                  "required": true,
                  "description": "Repository/spec paths changed; use a single item such as \"none\" when nothing changed."
                },
                {
                  "name": "tests",
                  "type": "array",
                  "required": true,
                  "description": "Checks run for this round; use \"none\" when not applicable."
                }
              ]
            },
            {
              "name": "decisions",
              "type": "array",
              "required": true,
              "description": "Lettered-option decisions this round surfaces for the operator: each an object {id, topic, text, context?, options:[{key, label, rationale, recommended?}]}. An empty array when the round surfaces no new decisions. The save-workshop-round action handler writes these into workshop/round-NNN.json; the mode never writes the domain folder."
            },
            {
              "name": "self_assessment",
              "type": "object",
              "required": true,
              "description": "The agent's 5-dimension readiness self-assessment; an INPUT to the workshop service's readiness computation (which applies round-count boosts), not the final readiness verdict.",
              "fields": [
                {
                  "name": "problem_clarity",
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 3,
                  "description": "How clearly the problem is understood (0-3)."
                },
                {
                  "name": "scope_defined",
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 3,
                  "description": "How well the scope is bounded (0-3)."
                },
                {
                  "name": "approach_solid",
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 3,
                  "description": "How sound the chosen approach is (0-3)."
                },
                {
                  "name": "testable",
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 3,
                  "description": "How verifiable the outcome is (0-3)."
                },
                {
                  "name": "risk_awareness",
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 3,
                  "description": "How well risks are identified and mitigated (0-3)."
                }
              ]
            }
          ]
        },
        "transitions": [
          {
            "classify": {
              "field": "progress",
              "enum": [
                "continue",
                "complete",
                "blocked"
              ],
              "from": "handoff",
              "description": "Whether another research round is warranted (continue), the spec is refined enough to workshop/finalize (complete), or the round is blocked (blocked)."
            },
            "routes": {
              "continue": [
                "research"
              ],
              "complete": [],
              "blocked": []
            }
          }
        ]
      }
    ]
  }
}
