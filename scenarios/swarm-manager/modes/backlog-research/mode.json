        "capability": "generic.mode_artifacts"
      },
      {
        "input_id": "item.title",
        "kind": "target_adapter",
        "capability": "target.item_title"
      },
      {
        "input_id": "item.description",
        "kind": "target_adapter",
        "capability": "target.item_description"
      },
      {
        "input_id": "item.status",
        "kind": "target_adapter",
        "capability": "target.item_status"
      },
      {
        "input_id": "item.spec",
        "kind": "target_adapter",
        "capability": "target.item_spec"
      }
    ],
    "aliases": [
      {
        "name": "OPERATING_MODE",
        "input_id": "execution.mode_id"
      },
      {
        "name": "PHASE",
        "input_id": "execution.phase_id"
      },
      {
        "name": "ROUND_NUMBER",
        "input_id": "execution.round_number"
      },
      {
        "name": "AGENT_PROFILE_KEY",
        "input_id": "execution.agent_profile_key"
      },
      {
        "name": "OPERATOR_NOTE",
        "input_id": "execution.operator_note"
      },
      {
        "name": "USER_PROMPT",
        "input_id": "execution.user_prompt"
      },
      {
        "name": "CONTEXT_PATHS",
        "input_id": "execution.context_paths"
      },
      {
        "name": "CONTEXT_TARGETS",
        "input_id": "execution.context_targets"
      },
      {
        "name": "CONTEXT_REQUIREMENTS",
        "input_id": "execution.context_requirements"
      },
      {
        "name": "GAP_REPORT",
        "input_id": "execution.gap_report"
      },
      {
