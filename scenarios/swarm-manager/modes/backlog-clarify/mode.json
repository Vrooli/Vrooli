  "run_strategy": {
    "kind": "sequential_handoff"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-backlog-clarify"
  },
  "artifact": {
    "root": "modes/backlog-clarify"
  },
  "profile": {
    "default_profile_key": "swarm-manager/default"
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "clarify",
    "phases": [
      {
        "id": "clarify",
        "kind": "investigate",
        "activity_purpose": "backlog_clarify",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "OPERATOR_NOTE",
          "USER_QUESTION",
          "DECISION_TOPIC",
          "USER_MESSAGE",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "ITEM_TITLE",
          "ITEM_DESCRIPTION",
          "ITEM_STATUS",
          "ITEM_SPEC"
        ],
        "profile_key": "swarm-manager/default",
        "prompt": {
          "suffix": "clarify",
          "title": "Backlog Clarification Turn",
          "trigger": "Operator starts (or continues) the backlog-clarify thread",
          "purpose": "Answer the operator's question about a workshop decision and assess its impact (none/decision/round), emitting a handoff and whether the thread stays open."
        },
        "declared_output": {
          "fields": [
            {
              "name": "handoff",
              "type": "object",
              "required": true,
              "description": "The structured handoff the next round consumes.",
              "fields": [
                {
                  "name": "summary",
                  "type": "string",
                  "required": true,
                  "description": "Concise statement of what this round did."
                },
                {
                  "name": "blockers",
                  "type": "array",
                  "required": true,
                  "description": "Known blockers; use a single item such as \"none\" when there are none."
                },
                {
                  "name": "next_step",
                  "type": "string",
                  "required": true,
                  "description": "The immediate next step after this round."
                },
                {
                  "name": "changed_files",
                  "type": "array",
                  "required": true,
                  "description": "Repository/spec paths changed; use a single item such as \"none\" when nothing changed."
                },
                {
                  "name": "tests",
                  "type": "array",
                  "required": true,
                  "description": "Checks run for this round; use \"none\" when not applicable."
                }
              ]
            }
          ]
        },
        "transitions": [
          {
            "classify": {
              "field": "progress",
              "enum": [
                "continue",
                "complete",
                "blocked"
              ],
              "from": "handoff",
              "description": "Whether the clarification thread stays open for more turns (continue), the clarification resolved (complete), or the item is busy/inactive (blocked)."
            },
            "routes": {
              "continue": [
                "clarify"
              ],
              "complete": [],
              "blocked": []
            }
          }
        ]
      }
    ]
  }
}
