{
  "kind": "operating-mode",
  "id": "initiative-review-loop",
  "label": "Initiative Review",
  "description": "One review round over a whole initiative once all member items are terminal: assess the delivered work against the acceptance criteria and return a classification. A single terminal round at the initiative scope. Implements the initiative-review operation.",
  "best_for": [
    "Reviewing a whole initiative against its acceptance criteria",
    "Producing an initiative-level acceptance signal after member items complete"
  ],
  "not_for": [
    "Reviewing a single item \u2014 use backlog-review",
    "Running the initiative work \u2014 use holistic-loop"
  ],
  "tradeoffs": [
    "Single review round at the initiative scope",
    "Requires all member items terminal before it runs (a domain trigger precondition)"
  ],
  "when_in_doubt_pick_instead": "holistic-loop",
  "target": {
    "kind": "initiative"
  },
  "input_contract": {
    "specs": [
      {
        "id": "execution.mode_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Stable operating-mode identity for this execution."
      },
      {
        "id": "execution.phase_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Current phase identity within the pinned graph."
      },
      {
        "id": "execution.round_number",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "sensitivity": "public",
        "retention": "value",
        "description": "One-based round number within the immutable execution."
      },
      {
        "id": "execution.agent_profile_key",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Agent Manager profile selected for the current phase."
      },
      {
        "id": "execution.prior_rounds",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Durable prior round envelopes available to the current phase."
      },
      {
        "id": "execution.mode_artifacts",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Declared artifacts accumulated under the mode execution."
      },
      {
        "id": "initiative.name",
        "type": "string",
        "required": true,
        "min_length": 1,
        "max_length": 256,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Stable initiative identity under review."
      },
      {
        "id": "initiative.title",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Current initiative title."
      },
      {
        "id": "initiative.acceptance_criteria",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "Newline-normalized initiative acceptance criteria."
      },
      {
        "id": "initiative.member_items",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Resolved initiative member items and their status."
      }
    ],
    "sources": [
      {
        "input_id": "execution.mode_id",
        "kind": "generic_provider",
        "capability": "generic.operating_mode"
      },
      {
        "input_id": "execution.phase_id",
        "kind": "generic_provider",
        "capability": "generic.phase"
      },
      {
        "input_id": "execution.round_number",
        "kind": "generic_provider",
        "capability": "generic.round_number"
      },
      {
        "input_id": "execution.agent_profile_key",
        "kind": "generic_provider",
        "capability": "generic.agent_profile_key"
      },
      {
        "input_id": "execution.prior_rounds",
        "kind": "generic_provider",
        "capability": "generic.prior_rounds"
      },
      {
        "input_id": "execution.mode_artifacts",
        "kind": "generic_provider",
        "capability": "generic.mode_artifacts"
      },
      {
        "input_id": "initiative.name",
        "kind": "target_adapter",
        "capability": "target.initiative_name"
      },
      {
        "input_id": "initiative.title",
        "kind": "target_adapter",
        "capability": "target.initiative_title"
      },
      {
        "input_id": "initiative.acceptance_criteria",
        "kind": "target_adapter",
        "capability": "target.acceptance_criteria"
      },
      {
        "input_id": "initiative.member_items",
        "kind": "target_adapter",
        "capability": "target.member_items"
      }
    ],
    "aliases": [
      {
        "name": "OPERATING_MODE",
        "input_id": "execution.mode_id"
      },
      {
        "name": "PHASE",
        "input_id": "execution.phase_id"
      },
      {
        "name": "ROUND_NUMBER",
        "input_id": "execution.round_number"
      },
      {
        "name": "AGENT_PROFILE_KEY",
        "input_id": "execution.agent_profile_key"
      },
      {
        "name": "PRIOR_ROUNDS_JSON",
        "input_id": "execution.prior_rounds"
      },
      {
        "name": "MODE_ARTIFACTS_JSON",
        "input_id": "execution.mode_artifacts"
      },
      {
        "name": "INITIATIVE_NAME",
        "input_id": "initiative.name"
      },
      {
        "name": "INITIATIVE_TITLE",
        "input_id": "initiative.title"
      },
      {
        "name": "ACCEPTANCE_CRITERIA",
        "input_id": "initiative.acceptance_criteria"
      },
      {
        "name": "MEMBER_ITEMS_JSON",
        "input_id": "initiative.member_items"
      }
    ]
  },
  "run_strategy": {
    "kind": "sequential_handoff"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-initiative-review"
  },
  "artifact": {
    "root": "modes/initiative-review-loop"
  },
  "profile": {
    "default_profile_key": "swarm-manager/analysis"
  },
  "metrics": {
    "event_source": "initiative-review-loop",
    "accepted_verdicts": [
      "ready",
      "ready_with_notes"
    ]
  },
  "lock": {
    "initiative_exclusive": true
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "review",
    "phases": [
      {
        "id": "review",
        "kind": "review",
        "activity_purpose": "initiative_review",
        "requires_criteria": true,
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "INITIATIVE_NAME",
          "INITIATIVE_TITLE",
          "ACCEPTANCE_CRITERIA",
          "MEMBER_ITEMS_JSON"
        ],
        "profile_key": "swarm-manager/analysis",
        "prompt": {
          "suffix": "review",
          "title": "Initiative Acceptance Review",
          "trigger": "All member items reached terminal and an initiative review is triggered",
          "purpose": "Assess the initiative's delivered work against its acceptance criteria and return a readiness classification."
        },
        "declared_output": {
          "fields": [
            {
              "name": "verdict",
              "type": "string",
              "required": true,
              "enum": [
                "ready",
                "ready_with_notes",
                "needs_work",
                "not_assessable"
              ],
              "description": "Review classification (mirrors the legacy review agent vocabulary): ready / ready_with_notes accept, needs_work requests changes, not_assessable abstains to operator attention."
            },
            {
              "name": "agent_assessment",
              "type": "string",
              "description": "The review agent's prose assessment of the initiative against its acceptance criteria. The commit handler records it on the initiative review round; a completed round lacking an assessment is downgraded to failed (mirrors internal/review validateCompletedRound)."
            },
            {
              "name": "evidence",
              "type": "array",
              "description": "Evidence items the review gathered, each an object {id, type (screenshot/api_test/cli_output/config_diff/workflow_recording/custom), title, description, capture_path?, before_capture_path?, test_results?:[{name, passed, output_summary?}]}. Empty array when none."
            },
            {
              "name": "improvement_suggestions",
              "type": "array",
              "description": "Durable-automation suggestions to replace one-off evidence, each {category (test_coverage/visual_capture/health_check/ci_workflow/standards_rule/other), description, evidence_id?, priority (high/medium/low)}. Empty array when none."
            },
            {
              "name": "regression_introduced",
              "type": "boolean",
              "description": "True only when baseline-diff evidence showed a regression the initiative's work caused that the agent could not disprove. Never set for pre-existing failures."
            },
            {
              "name": "notes",
              "type": "array",
              "description": "Free-form reviewer notes recorded on the round. Empty array when none."
            }
          ]
        },
        "transitions": [
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "ready"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "ready_with_notes"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "needs_work"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "not_assessable"
            },
            "to": []
          }
        ],
        "metrics": {
          "counts_acceptance_sample": true
        }
      }
    ]
  },
  "backlog_sync": {
    "capabilities": [
      "read_only"
    ],
    "event_source": "initiative-review-loop",
    "apply_mode": "operator-gated"
  }
}
