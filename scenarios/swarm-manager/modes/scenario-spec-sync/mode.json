{
  "kind": "operating-mode",
  "id": "scenario-spec-sync",
  "label": "Scenario Spec Sync",
  "description": "Read a scenario's implementation code and update its spec artifacts (PRD.md, requirements/, README.md, docs/) to match the actual behavior. Targets a scenario workspace directly. Implements the spec-sync operation.",
  "best_for": [
    "Bringing a scenario's spec artifacts back in sync with its implementation before archiving"
  ],
  "not_for": [
    "Executing a backlog item — use execution-run / research-conclude",
    "Reviewing completed work — use backlog-review"
  ],
  "tradeoffs": [
    "Edits spec docs in place; no plan or review state",
    "Runs against a scenario directory, not a backlog item"
  ],
  "when_in_doubt_pick_instead": "backlog-conclude",
  "target": {
    "kind": "scenario"
  },
  "input_contract": {
    "specs": [
      {
        "id": "execution.mode_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Stable operating-mode identity for this execution."
      },
      {
        "id": "execution.phase_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Current phase identity within the pinned graph."
      },
      {
        "id": "execution.round_number",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "sensitivity": "public",
        "retention": "value",
        "description": "One-based round number within the immutable execution."
      },
      {
        "id": "execution.agent_profile_key",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Agent Manager profile selected for the current phase."
      },
      {
        "id": "execution.operator_note",
        "type": "string",
        "max_length": 32768,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Optional operator guidance for the current round."
      },
      {
        "id": "execution.prior_rounds",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Durable prior round envelopes available to the current round."
      },
      {
        "id": "execution.mode_artifacts",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Declared artifacts accumulated under the mode execution."
      },
      {
        "id": "scenario.name",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "The name of the scenario whose spec artifacts are being synced."
      }
    ],
    "sources": [
      {
        "input_id": "execution.mode_id",
        "kind": "generic_provider",
        "capability": "generic.operating_mode"
      },
      {
        "input_id": "execution.phase_id",
        "kind": "generic_provider",
        "capability": "generic.phase"
      },
      {
        "input_id": "execution.round_number",
        "kind": "generic_provider",
        "capability": "generic.round_number"
      },
      {
        "input_id": "execution.agent_profile_key",
        "kind": "generic_provider",
        "capability": "generic.agent_profile_key"
      },
      {
        "input_id": "execution.operator_note",
        "kind": "generic_provider",
        "capability": "generic.operator_note"
      },
      {
        "input_id": "execution.prior_rounds",
        "kind": "generic_provider",
        "capability": "generic.prior_rounds"
      },
      {
        "input_id": "execution.mode_artifacts",
        "kind": "generic_provider",
        "capability": "generic.mode_artifacts"
      },
      {
        "input_id": "scenario.name",
        "kind": "target_adapter",
        "capability": "target.scenario_name"
      }
    ],
    "aliases": [
      {
        "name": "OPERATING_MODE",
        "input_id": "execution.mode_id"
      },
      {
        "name": "PHASE",
        "input_id": "execution.phase_id"
      },
      {
        "name": "ROUND_NUMBER",
        "input_id": "execution.round_number"
      },
      {
        "name": "AGENT_PROFILE_KEY",
        "input_id": "execution.agent_profile_key"
      },
      {
        "name": "OPERATOR_NOTE",
        "input_id": "execution.operator_note"
      },
      {
        "name": "PRIOR_ROUNDS_JSON",
        "input_id": "execution.prior_rounds"
      },
      {
        "name": "MODE_ARTIFACTS_JSON",
        "input_id": "execution.mode_artifacts"
      },
      {
        "name": "SCENARIO_NAME",
        "input_id": "scenario.name"
      }
    ]
  },
  "run_strategy": {
    "kind": "sequential_handoff"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-scenario-spec-sync"
  },
  "artifact": {
    "root": "modes/scenario-spec-sync"
  },
  "profile": {
    "default_profile_key": "swarm-manager/deep-work"
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "spec-sync",
    "phases": [
      {
        "id": "spec-sync",
        "kind": "execute",
        "activity_purpose": "scenario_spec_sync",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "OPERATOR_NOTE",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "SCENARIO_NAME"
        ],
        "profile_key": "swarm-manager/deep-work",
        "writes_repo": true,
        "prompt": {
          "suffix": "spec-sync",
          "title": "Scenario Spec Sync Run",
          "trigger": "A scenario's spec artifacts must be synced to its implementation before archiving",
          "purpose": "Read the scenario's implementation code and update its spec artifacts (PRD.md, requirements/, README.md, docs/) to match the actual behavior, emitting a handoff."
        },
        "declared_output": {
          "fields": [
            {
              "name": "handoff",
              "type": "object",
              "required": true,
              "description": "The structured handoff the next round consumes.",
              "fields": [
                {
                  "name": "summary",
                  "type": "string",
                  "required": true,
                  "description": "Concise statement of what this round did."
                },
                {
                  "name": "blockers",
                  "type": "array",
                  "required": true,
                  "description": "Known blockers; use a single item such as \"none\" when there are none."
                },
                {
                  "name": "next_step",
                  "type": "string",
                  "required": true,
                  "description": "The immediate next step after this round."
                },
                {
                  "name": "changed_files",
                  "type": "array",
                  "required": true,
                  "description": "Spec paths changed; use a single item such as \"none\" when nothing changed."
                },
                {
                  "name": "tests",
                  "type": "array",
                  "required": true,
                  "description": "Checks run for this round; use \"none\" when not applicable."
                }
              ]
            }
          ]
        },
        "transitions": [
          {
            "classify": {
              "field": "progress",
              "enum": [
                "continue",
                "complete",
                "blocked"
              ],
              "from": "handoff",
              "description": "Whether more spec-sync work remains (continue), the sync is complete (complete), or it is blocked (blocked)."
            },
            "routes": {
              "continue": [
                "spec-sync"
              ],
              "complete": [],
              "blocked": []
            }
          }
        ]
      }
    ]
  }
}
