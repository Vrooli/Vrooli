{
  "kind": "operating-mode",
  "id": "holistic-loop",
  "label": "Holistic Loop",
  "description": "Investigate → plan → execute → review cycles across the whole initiative. The plan phase authors and binds a canonical plan-manager plan; the execute phase is delegated to the generic phased-plan-drain (executed_by), which drains that plan slice-by-slice — a blocked drain routes back to investigate for replanning. Use when scope is exploratory and the plan must be revised as you learn.",
  "best_for": [
    "Coupled work where items can't be validated in isolation",
    "The right plan can only be authored after cross-item investigation",
    "Item shape will shift as the work reveals what items actually are",
    "Replanning is expected — the first plan will be wrong about something material"
  ],
  "not_for": [
    "Items are independent and stable — use item-level for parallelism",
    "A stable plan already exists and just needs to be drained — use phased-plan-drain",
    "Work is small enough to fit in a single backlog item"
  ],
  "tradeoffs": [
    "One plan, not N plans — lower replanning cost than item-level for coupled work",
    "Higher per-run cost than item-level",
    "Loses parallelism — only one round runs at a time",
    "Initiative-level acceptance review instead of per-item review"
  ],
  "when_in_doubt_pick_instead": "item-level",
  "target": {
    "kind": "initiative",
    "plan_ref": {
      "required": true,
      "role": "operating_mode_plan"
    }
  },
  "input_contract": {
    "specs": [
      { "id": "execution.mode_id", "type": "string", "required": true, "sensitivity": "public", "retention": "value", "description": "Stable operating-mode identity for this execution." },
      { "id": "execution.phase_id", "type": "string", "required": true, "sensitivity": "public", "retention": "value", "description": "Current phase identity within the pinned graph." },
      { "id": "execution.round_number", "type": "integer", "required": true, "minimum": 1, "sensitivity": "public", "retention": "value", "description": "One-based round number within the immutable execution." },
      { "id": "execution.agent_profile_key", "type": "string", "required": true, "sensitivity": "internal", "retention": "value", "description": "Agent Manager profile selected for the current phase." },
      { "id": "execution.operator_note", "type": "string", "max_length": 32768, "sensitivity": "internal", "retention": "value", "description": "Optional operator guidance for the current round." },
      { "id": "execution.prior_rounds", "type": "array", "required": true, "sensitivity": "internal", "retention": "value", "description": "Durable prior round envelopes available to the current phase." },
      { "id": "execution.mode_artifacts", "type": "array", "required": true, "sensitivity": "internal", "retention": "value", "description": "Declared artifacts accumulated under the mode execution." },
      { "id": "execution.backlog_sync_guidance", "type": "string", "required": true, "sensitivity": "public", "retention": "digest", "description": "Shared contract for emitting backlog reconciliation proposals." },
      { "id": "initiative.name", "type": "string", "required": true, "min_length": 1, "max_length": 256, "sensitivity": "internal", "retention": "value", "description": "Stable initiative identity targeted by the holistic loop." },
      { "id": "initiative.title", "type": "string", "required": true, "sensitivity": "internal", "retention": "value", "description": "Current initiative title." },
      { "id": "initiative.description", "type": "string", "sensitivity": "internal", "retention": "value", "description": "Current initiative description." },
      { "id": "initiative.acceptance_criteria", "type": "string", "sensitivity": "internal", "retention": "value", "description": "Newline-normalized initiative acceptance criteria." },
      { "id": "initiative.member_items", "type": "array", "required": true, "sensitivity": "internal", "retention": "value", "description": "Resolved initiative backlog members and their current status." },
      { "id": "plan.context", "type": "object", "sensitivity": "internal", "retention": "value", "description": "Resolved non-mutating Plan Manager context when the initiative has a bound operating-mode plan." }
    ],
    "sources": [
      { "input_id": "execution.mode_id", "kind": "generic_provider", "capability": "generic.operating_mode" },
      { "input_id": "execution.phase_id", "kind": "generic_provider", "capability": "generic.phase" },
      { "input_id": "execution.round_number", "kind": "generic_provider", "capability": "generic.round_number" },
      { "input_id": "execution.agent_profile_key", "kind": "generic_provider", "capability": "generic.agent_profile_key" },
      { "input_id": "execution.operator_note", "kind": "generic_provider", "capability": "generic.operator_note" },
      { "input_id": "execution.prior_rounds", "kind": "generic_provider", "capability": "generic.prior_rounds" },
      { "input_id": "execution.mode_artifacts", "kind": "generic_provider", "capability": "generic.mode_artifacts" },
      { "input_id": "execution.backlog_sync_guidance", "kind": "generic_provider", "capability": "generic.backlog_sync_proposal" },
      { "input_id": "initiative.name", "kind": "target_adapter", "capability": "target.initiative_name" },
      { "input_id": "initiative.title", "kind": "target_adapter", "capability": "target.initiative_title" },
      { "input_id": "initiative.description", "kind": "target_adapter", "capability": "target.initiative_description" },
      { "input_id": "initiative.acceptance_criteria", "kind": "target_adapter", "capability": "target.acceptance_criteria" },
      { "input_id": "initiative.member_items", "kind": "target_adapter", "capability": "target.member_items" },
      { "input_id": "plan.context", "kind": "target_adapter", "capability": "target.plan_context" }
    ],
    "aliases": [
      { "name": "OPERATING_MODE", "input_id": "execution.mode_id" },
      { "name": "PHASE", "input_id": "execution.phase_id" },
      { "name": "ROUND_NUMBER", "input_id": "execution.round_number" },
      { "name": "AGENT_PROFILE_KEY", "input_id": "execution.agent_profile_key" },
      { "name": "OPERATOR_NOTE", "input_id": "execution.operator_note" },
      { "name": "PRIOR_ROUNDS_JSON", "input_id": "execution.prior_rounds" },
      { "name": "MODE_ARTIFACTS_JSON", "input_id": "execution.mode_artifacts" },
      { "name": "BACKLOG_SYNC_PROPOSAL_SNIPPET", "input_id": "execution.backlog_sync_guidance" },
      { "name": "INITIATIVE_NAME", "input_id": "initiative.name" },
      { "name": "INITIATIVE_TITLE", "input_id": "initiative.title" },
      { "name": "INITIATIVE_DESCRIPTION", "input_id": "initiative.description" },
      { "name": "ACCEPTANCE_CRITERIA", "input_id": "initiative.acceptance_criteria" },
      { "name": "MEMBER_ITEMS_JSON", "input_id": "initiative.member_items" },
      { "name": "PLAN_CONTEXT_JSON", "input_id": "plan.context" }
    ]
  },
  "run_strategy": {
    "kind": "operator_gated_loop"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-holistic-loop"
  },
  "artifact": {
    "root": "modes/holistic-loop"
  },
  "profile": {
    "default_profile_key": "swarm-manager/deep-work"
  },
  "backlog_sync": {
    "capabilities": [
      "read_only",
      "propose_mutations",
      "mark_complete",
      "create_followups",
      "update_scope"
    ],
    "requires_run_id": true,
    "requires_membership": true,
    "event_source": "holistic-loop",
    "apply_mode": "operator-gated"
  },
  "metrics": {
    "event_source": "holistic-loop",
    "accepted_verdicts": [
      "accept",
      "accepted"
    ]
  },
  "lock": {
    "initiative_exclusive": true
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "investigate",
    "terminal": [
      "reconcile"
    ],
    "phases": [
      {
        "id": "investigate",
        "kind": "investigate",
        "activity_purpose": "holistic_loop_investigate",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "OPERATOR_NOTE",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "INITIATIVE_NAME",
          "INITIATIVE_TITLE",
          "INITIATIVE_DESCRIPTION",
          "ACCEPTANCE_CRITERIA",
          "MEMBER_ITEMS_JSON"
        ],
        "profile_key": "swarm-manager/deep-work",
        "prompt": {
          "title": "Holistic Loop Investigate",
          "trigger": "Operator starts holistic-loop investigate phase",
          "purpose": "Investigate initiative-wide code, backlog, and system state and produce holistic findings."
        },
        "output_artifacts": [
          {
            "path": "modes/holistic-loop/findings.md",
            "content_type": "text/markdown",
            "required": true
          }
        ],
        "transitions": [
          {
            "when": {
              "op": "always"
            },
            "to": [
              "plan"
            ]
          }
        ]
      },
      {
        "id": "plan",
        "kind": "investigate",
        "activity_purpose": "holistic_loop_plan",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "OPERATOR_NOTE",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "INITIATIVE_NAME",
          "INITIATIVE_TITLE",
          "ACCEPTANCE_CRITERIA",
          "MEMBER_ITEMS_JSON",
          "PLAN_CONTEXT_JSON"
        ],
        "profile_key": "swarm-manager/deep-work",
        "prompt": {
          "title": "Holistic Loop Plan",
          "trigger": "Operator starts holistic-loop plan phase",
          "purpose": "Author or revise the canonical initiative-wide plan-manager plan and bind it to the initiative as plan_ref."
        },
        "declared_output": {
          "fields": [
            {
              "name": "plan_ref",
              "type": "object",
              "required": true,
              "description": "Canonical plan-manager reference for the initiative-wide plan (provider plan-manager, plan_id or slug, role operating_mode_plan). Binding it is what arms the delegated execute drain."
            }
          ]
        },
        "transitions": [
          {
            "when": {
              "op": "always"
            },
            "to": [
              "execute"
            ]
          }
        ]
      },
      {
        "id": "execute",
        "kind": "execute",
        "executed_by": "phased-plan-drain",
        "transitions": [
          {
            "when": {
              "op": "eq",
              "field": "progress",
              "value": "complete"
            },
            "to": [
              "review"
            ]
          },
          {
            "when": {
              "op": "eq",
              "field": "progress",
              "value": "blocked"
            },
            "to": [
              "investigate"
            ]
          }
        ]
      },
      {
        "id": "review",
        "kind": "review",
        "activity_purpose": "holistic_loop_review",
        "reads": [
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "INITIATIVE_NAME",
          "INITIATIVE_TITLE",
          "MEMBER_ITEMS_JSON",
          "ACCEPTANCE_CRITERIA"
        ],
        "profile_key": "swarm-manager/analysis",
        "requires_criteria": true,
        "prompt": {
          "title": "Holistic Loop Acceptance Review",
          "trigger": "Operator starts holistic-loop review phase",
          "purpose": "Evaluate holistic-loop results against acceptance criteria and produce an acceptance verdict."
        },
        "declared_output": {
          "fields": [
            {
              "name": "verdict",
              "type": "string",
              "required": true,
              "enum": [
                "accepted",
                "changes_requested",
                "rejected"
              ],
              "description": "Acceptance verdict for the initiative against its acceptance criteria. Use accept / accepted when the criteria are met; changes_requested when specific fixable gaps should be re-executed before acceptance (routes back to execute); any other non-accepting verdict records the gap and reconciles."
            }
          ]
        },
        "metrics": {
          "counts_acceptance_sample": true
        },
        "transitions": [
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "changes_requested"
            },
            "to": [
              "execute"
            ]
          },
          {
            "when": {
              "op": "always"
            },
            "to": [
              "reconcile"
            ]
          }
        ]
      },
      {
        "id": "reconcile",
        "kind": "reconcile",
        "activity_purpose": "holistic_loop_reconcile",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "BACKLOG_SYNC_PROPOSAL_SNIPPET",
          "INITIATIVE_NAME",
          "INITIATIVE_TITLE",
          "INITIATIVE_DESCRIPTION",
          "ACCEPTANCE_CRITERIA",
          "MEMBER_ITEMS_JSON"
        ],
        "profile_key": "swarm-manager/analysis",
        "auto_start_after": [
          "review"
        ],
        "prompt": {
          "suffix": "reconcile",
          "title": "Holistic Loop Backlog Reconcile",
          "trigger": "Round refresher auto-starts holistic-loop reconcile after review completes",
          "purpose": "Read prior round artifacts and propose backlog mutations that align the initiative with the work just completed."
        },
        "declared_output": {
          "fields": [
            {
              "name": "backlog_sync",
              "type": "object",
              "required": true,
              "description": "The proposed backlog reconciliation plan (completed/created/updated items, proposal, rationale)."
            }
          ]
        }
      }
    ]
  }
}
