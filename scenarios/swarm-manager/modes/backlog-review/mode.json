{
  "kind": "operating-mode",
  "id": "backlog-review",
  "label": "Backlog Review",
  "description": "One review round over a completed backlog-item execution: gather evidence and return a classification (ready/ready_with_notes/needs_work/not_assessable). A single terminal round; the workflow policy routes on the normalized verdict. Implements the review-round operation.",
  "best_for": [
    "Reviewing a completed item execution and classifying readiness",
    "Producing an evidence-backed acceptance signal"
  ],
  "not_for": [
    "Whole-initiative acceptance \u2014 use initiative-review",
    "Gathering one specific piece of evidence \u2014 use backlog-evidence"
  ],
  "tradeoffs": [
    "Single review round",
    "Emits the raw review classification; the domain normalizes it to accepted/changes-requested/failed"
  ],
  "when_in_doubt_pick_instead": "backlog-evidence",
  "target": {
    "kind": "backlog-item"
  },
  "input_contract": {
    "specs": [
      {
        "id": "execution.mode_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Stable operating-mode identity for this execution."
      },
      {
        "id": "execution.phase_id",
        "type": "string",
        "required": true,
        "sensitivity": "public",
        "retention": "value",
        "description": "Current phase identity within the pinned graph."
      },
      {
        "id": "execution.round_number",
        "type": "integer",
        "required": true,
        "minimum": 1,
        "sensitivity": "public",
        "retention": "value",
        "description": "One-based round number within the immutable execution."
      },
      {
        "id": "execution.agent_profile_key",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Agent Manager profile selected for the current phase."
      },
      {
        "id": "execution.prior_rounds",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Durable prior round envelopes available to the current phase."
      },
      {
        "id": "execution.mode_artifacts",
        "type": "array",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Declared artifacts accumulated under the mode execution."
      },
      {
        "id": "item.title",
        "type": "string",
        "required": true,
        "sensitivity": "internal",
        "retention": "value",
        "description": "Backlog item title."
      },
      {
        "id": "item.status",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "Current backlog item status."
      },
      {
        "id": "item.spec",
        "type": "string",
        "sensitivity": "internal",
        "retention": "value",
        "description": "The item's authorable spec/plan document content."
      }
    ],
    "sources": [
      {
        "input_id": "execution.mode_id",
        "kind": "generic_provider",
        "capability": "generic.operating_mode"
      },
      {
        "input_id": "execution.phase_id",
        "kind": "generic_provider",
        "capability": "generic.phase"
      },
      {
        "input_id": "execution.round_number",
        "kind": "generic_provider",
        "capability": "generic.round_number"
      },
      {
        "input_id": "execution.agent_profile_key",
        "kind": "generic_provider",
        "capability": "generic.agent_profile_key"
      },
      {
        "input_id": "execution.prior_rounds",
        "kind": "generic_provider",
        "capability": "generic.prior_rounds"
      },
      {
        "input_id": "execution.mode_artifacts",
        "kind": "generic_provider",
        "capability": "generic.mode_artifacts"
      },
      {
        "input_id": "item.title",
        "kind": "target_adapter",
        "capability": "target.item_title"
      },
      {
        "input_id": "item.status",
        "kind": "target_adapter",
        "capability": "target.item_status"
      },
      {
        "input_id": "item.spec",
        "kind": "target_adapter",
        "capability": "target.item_spec"
      }
    ],
    "aliases": [
      {
        "name": "OPERATING_MODE",
        "input_id": "execution.mode_id"
      },
      {
        "name": "PHASE",
        "input_id": "execution.phase_id"
      },
      {
        "name": "ROUND_NUMBER",
        "input_id": "execution.round_number"
      },
      {
        "name": "AGENT_PROFILE_KEY",
        "input_id": "execution.agent_profile_key"
      },
      {
        "name": "PRIOR_ROUNDS_JSON",
        "input_id": "execution.prior_rounds"
      },
      {
        "name": "MODE_ARTIFACTS_JSON",
        "input_id": "execution.mode_artifacts"
      },
      {
        "name": "ITEM_TITLE",
        "input_id": "item.title"
      },
      {
        "name": "ITEM_STATUS",
        "input_id": "item.status"
      },
      {
        "name": "ITEM_SPEC",
        "input_id": "item.spec"
      }
    ]
  },
  "run_strategy": {
    "kind": "sequential_handoff"
  },
  "prompt": {
    "catalog_prefix": "swarm-manager-backlog-review"
  },
  "artifact": {
    "root": "modes/backlog-review"
  },
  "profile": {
    "default_profile_key": "swarm-manager/analysis"
  },
  "metrics": {
    "event_source": "backlog-review",
    "accepted_verdicts": [
      "ready",
      "ready_with_notes"
    ]
  },
  "ui": {
    "workspace_tab_id": "operating-mode"
  },
  "phase_graph": {
    "start_phase": "review",
    "phases": [
      {
        "id": "review",
        "kind": "review",
        "activity_purpose": "backlog_review",
        "reads": [
          "OPERATING_MODE",
          "PHASE",
          "ROUND_NUMBER",
          "AGENT_PROFILE_KEY",
          "PRIOR_ROUNDS_JSON",
          "MODE_ARTIFACTS_JSON",
          "ITEM_TITLE",
          "ITEM_STATUS",
          "ITEM_SPEC"
        ],
        "profile_key": "swarm-manager/analysis",
        "prompt": {
          "suffix": "review",
          "title": "Backlog Review Round",
          "trigger": "An item execution completed and a review round is spawned",
          "purpose": "Gather review evidence over the completed work and return a readiness classification and assessment."
        },
        "declared_output": {
          "fields": [
            {
              "name": "verdict",
              "type": "string",
              "required": true,
              "enum": [
                "ready",
                "ready_with_notes",
                "needs_work",
                "not_assessable"
              ],
              "description": "Review classification (mirrors the legacy review agent vocabulary): ready / ready_with_notes accept, needs_work requests changes, not_assessable abstains to operator attention."
            },
            {
              "name": "agent_assessment",
              "type": "string",
              "description": "The review agent's prose assessment of the completed work. The commit-review-round handler records it on the review round; a completed round lacking an assessment is downgraded to failed (mirrors internal/review validateCompletedRound)."
            },
            {
              "name": "evidence",
              "type": "array",
              "description": "Evidence items the review gathered, each an object {id, type (screenshot/api_test/cli_output/config_diff/workflow_recording/custom), title, description, capture_path?, before_capture_path?, test_results?:[{name, passed, output_summary?}]}. Empty array when none. The handler materializes these into the review round's evidence set."
            },
            {
              "name": "improvement_suggestions",
              "type": "array",
              "description": "Durable-automation suggestions to replace one-off evidence, each {category (test_coverage/visual_capture/health_check/ci_workflow/standards_rule/other), description, evidence_id?, priority (high/medium/low)}. Empty array when none."
            },
            {
              "name": "regression_introduced",
              "type": "boolean",
              "description": "True only when baseline-diff evidence showed a regression THIS item caused that the agent could not disprove. Never set for pre-existing failures."
            },
            {
              "name": "notes",
              "type": "array",
              "description": "Free-form reviewer notes recorded on the round. Empty array when none."
            }
          ]
        },
        "transitions": [
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "ready"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "ready_with_notes"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "needs_work"
            },
            "to": []
          },
          {
            "when": {
              "op": "eq",
              "field": "verdict",
              "value": "not_assessable"
            },
            "to": []
          }
        ],
        "metrics": {
          "counts_acceptance_sample": true
        }
      }
    ]
  }
}
