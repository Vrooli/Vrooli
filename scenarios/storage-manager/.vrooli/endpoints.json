      }
    },
    {
      "id": "storage_declare_suggest",
      "path": "/api/v1/declare/suggest",
      "method": "GET",
      "summary": "Suggest a storage declaration",
      "description": "Emits a measured, schema-valid storage block for one owner.",
      "category": "",
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "storage_declare_check",
      "path": "/api/v1/declare/check",
      "method": "GET",
      "summary": "Check declaration coverage",
      "description": "Reports declared and budgeted coverage by owner kind.",
