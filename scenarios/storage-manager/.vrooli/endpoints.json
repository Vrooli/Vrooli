{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.cleanup_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.cleanup_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "cleanup_provider_list",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ListProviders",
      "method": "POST",
      "summary": "List cleanup providers",
      "description": "Returns the registered cleanup providers and their safety metadata.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "providers": "array<Provider>"
        }
      }
    },
    {
      "id": "cleanup_policy_get",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/GetPolicy",
      "method": "POST",
      "summary": "Get cleanup policy",
      "description": "Returns the active cleanup policy profile and per-provider settings.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "policy": "Policy"
        }
      }
    },
    {
      "id": "cleanup_policy_set_profile",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/SetPolicyProfile",
      "method": "POST",
      "summary": "Set cleanup policy profile",
      "description": "Switches the active policy to conservative, balanced, or aggressive defaults.",
      "category": "cleanup",
      "request": {
        "type": "object",
        "properties": {
          "profile": "string (conservative|balanced|aggressive)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "policy": "Policy"
        }
      }
    },
    {
      "id": "cleanup_plan_create",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/CreatePlan",
      "method": "POST",
      "summary": "Create cleanup plan",
      "description": "Runs provider estimates and previews to create a stable cleanup plan id without mutating host state.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "plan": "Plan"
        }
      }
    },
    {
      "id": "cleanup_plan_apply",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ApplyPlan",
      "method": "POST",
      "summary": "Apply cleanup plan",
      "description": "Applies an approved plan using policy/provider version checks and an idempotency key.",
      "category": "cleanup",
      "request": {
        "type": "object",
        "properties": {
          "approval_mode": "string",
          "approval_token": "string",
          "idempotency_key": "string (required)",
          "plan_id": "string (required)",
          "policy_version": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "already_applied": "bool",
          "reclaimed_bytes": "int64"
        }
      }
    },
    {
      "id": "cleanup_pressure_report",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ReportPressure",
      "method": "POST",
      "summary": "Report disk pressure",
      "description": "Inbound disk-pressure signal from a safeguard. Warning, high, and critical apply only provably safe-tier providers with no operator present; owner, conditional, and forbidden providers remain withheld. Duplicate concurrent reports of the same partition and band collapse into one execution.",
      "category": "cleanup",
      "request": {
        "type": "object",
        "properties": {
          "available_bytes": "int64",
          "band": "enum (PRESSURE_BAND_WARNING|PRESSURE_BAND_HIGH|PRESSURE_BAND_CRITICAL, required)",
          "partition": "string (required)",
          "source_scenario": "string",
          "used_percent": "double"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "action": "enum (observed|previewed|applied|deduplicated|suppressed)",
          "autonomous_apply_enabled": "bool",
          "estimated_bytes": "int64",
          "plan_id": "string",
          "providers_applied": "array<string>",
          "providers_withheld": "array<string>",
          "reclaimed_bytes": "int64"
        }
      }
    },
    {
      "id": "cleanup_audit_list",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ListAudit",
      "method": "POST",
      "summary": "List cleanup audit events",
      "description": "Returns immutable cleanup policy, plan, apply, and replay audit events with redacted messages.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "events": "array<AuditEvent>"
        }
      }
    },
    {
      "id": "cleanup_recovery_start",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/StartRecovery",
      "method": "POST",
      "summary": "Start recovery run",
      "description": "Starts a server-owned recovery run and returns its id without waiting for filesystem work.",
      "category": "cleanup"
    },
    {
      "id": "cleanup_recovery_wait",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/WaitRecovery",
      "method": "POST",
      "summary": "Wait for recovery run",
      "description": "Waits for one server-owned recovery run to reach a terminal result.",
      "category": "cleanup"
    },
    {
      "id": "cleanup_recovery_history",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ListRecovery",
      "method": "POST",
      "summary": "List recovery history",
      "description": "Lists recent server-owned recovery runs.",
      "category": "cleanup"
    },
    {
      "id": "cleanup_standing_approvals",
      "path": "/api/v1/cleanup/approvals",
      "method": "GET",
      "summary": "List standing approvals",
      "description": "Returns host-local approvals for conditional recovery providers.",
      "category": "cleanup",
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "fleet_scan_fleet",
      "path": "/vrooli.storage_health.v1.fleet.FleetService/ScanFleet",
      "method": "POST",
      "summary": "Scan the fleet's storage inventory",
      "description": "Classifies the requested scenarios (or every discovered scenario) by engine, isolation-readiness, namespace adoption, deploy stage, and backup readiness, persists the snapshot, and rolls up fleet-wide distributions + offender counts.",
      "category": "fleet",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "data_dir_over_budget_count": "int32",
          "engine_distribution": "array<EngineCount>",
          "entries": "array<FleetScenarioEntry>",
          "errors": "array<FleetScanError>",
          "finding_count": "int32",
          "isolation_unready_count": "int32",
          "no_backup_count": "int32",
          "scanned_at": "string",
          "scenario_count": "int32",
          "stage_distribution": "array<StageCount>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Fleet scan failure"
        }
      ],
      "examples": [
        {
          "name": "Scan whole fleet",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.fleet.FleetService/ScanFleet -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "fleet_get_inventory",
      "path": "/vrooli.storage_health.v1.fleet.FleetService/GetInventory",
      "method": "POST",
      "summary": "Read the latest persisted fleet snapshot",
      "description": "Returns the most recent persisted fleet inventory snapshot without re-scanning. An empty snapshot (scenario_count 0) means ScanFleet has not run yet.",
      "category": "fleet",
      "request": {
        "type": "object"
      },
      "response": {
        "type": "object",
        "properties": {
          "entries": "array<FleetScenarioEntry>",
          "scanned_at": "string",
          "scenario_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Snapshot read failure"
        }
      ],
      "examples": [
        {
          "name": "Read snapshot",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.fleet.FleetService/GetInventory -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "advisor_analyze_migrations",
      "path": "/vrooli.storage_health.v1.advisor.AdvisorService/AnalyzeMigrations",
      "method": "POST",
      "summary": "Grade migration hygiene against deploy stage",
      "description": "Analyzes each requested scenario's (or every discovered scenario's) migration posture against its deploy stage — greenfield expects schema-as-desired-state; brownfield expects idempotent, ALTER-free, per-domain schema with a forward-migration path — and returns per-scenario hygiene plus stage-aware debt notes.",
      "category": "advisor",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "debt_count": "int32",
          "entries": "array<MigrationHygiene>",
          "errors": "array<AdvisorScanError>",
          "scenario_count": "int32",
          "with_migrations_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Migration analysis failure"
        }
      ],
      "examples": [
        {
          "name": "Analyze fleet migrations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.advisor.AdvisorService/AnalyzeMigrations -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "advisor_advise_engines",
      "path": "/vrooli.storage_health.v1.advisor.AdvisorService/AdviseEngines",
      "method": "POST",
      "summary": "Rank Postgres→SQLite migration candidates",
      "description": "Scores each requested scenario's (or every discovered scenario's) engine fitness and returns a ranked list of Postgres→SQLite migration candidates with rationale, fitness score, and any blockers. Vrooli is local-first; a single-node scenario carrying Postgres usually pays an external-service cost it does not need.",
      "category": "advisor",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "candidates": "array<EngineCandidate>",
          "errors": "array<AdvisorScanError>",
          "scenario_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Engine advisor failure"
        }
      ],
      "examples": [
        {
          "name": "Advise engine migrations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.advisor.AdvisorService/AdviseEngines -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "validation_validate_target",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateTarget",
      "method": "POST",
      "summary": "Validate a first-class repository target",
      "description": "",
      "category": "validation"
    },
    {
      "id": "validation_validate_owner",
      "path": "/api/v1/validation/validate/{kind}/{id}",
      "method": "GET",
      "summary": "Validate one storage owner",
      "description": "Runs the shared storage validation report for a scenario, resource, tool, or safeguard on the requested platform.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "id": "string",
          "kind": "scenario|resource|tool|safeguard",
          "platform": "linux|macos|windows"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "findings": "[]storage finding",
          "owner_id": "string",
          "owner_kind": "string",
          "platform": "string",
          "status": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown owner kind, invalid platform, or unresolved owner"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "validation_validate_fleet",
      "path": "/api/v1/validation/validate/fleet",
      "method": "GET",
      "summary": "Validate every storage owner",
      "description": "Runs the shared validation report for every selected scenario, resource, tool, and safeguard and returns per-code roll-up counts.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "kind": "repeatable owner-kind filter",
          "platform": "linux|macos|windows"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "blocker_count": "int",
          "counts_by_code": "map[string]int",
          "error_count": "int",
          "migration_allowlist_size": "int",
          "platform": "string",
          "reports": "[]storage validation report"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Owner inventory cannot be loaded or validated"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's storage judgment",
      "description": "Detects the target scenario's storage surface (engines + API language) and runs the applicable static storage analyzers, returning the shared scenario-validation response with findings in the maturity assessment.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string (required, scenario id)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "native_detail": "google.protobuf.Any",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id or scenario not found under scenarios/"
        }
      ],
      "examples": [
        {
          "name": "Validate scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-manager\"}'"
        }
      ]
    },
    {
      "id": "validation_describe_provider",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/DescribeProvider",
      "method": "POST",
      "summary": "Describe this provider's identity and contract",
      "description": "Reports provider identity, backed phase, maturity spec version, contract, build provenance, and capabilities. Inspects no target, so readiness consumers can confirm this provider is live and current without paying for a full validation run.",
      "category": "validation",
      "request": {
        "type": "object"
      },
      "response": {
        "type": "object",
        "properties": {
          "build": "scenario_validation.v1.ProviderBuild",
          "capabilities": "scenario_validation.v1.ProviderCapabilities",
          "contract": "string",
          "phase": "string",
          "provider": "string",
          "spec_version": "string"
        }
      },
      "examples": [
        {
          "name": "Describe provider",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/DescribeProvider -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview the deterministic storage autofixes for a scenario",
      "description": "Shared ScenarioValidationService Fix RPC. Returns the candidate edits the storage-manager autofix registry would apply (DB_ROWS_NOT_CLOSED, ENSURE_SCHEMAS_NOT_WIRED) without writing anything. Optional rule_ids restricts the preview to specific finding codes.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id/path or scenario directory not resolvable"
        }
      ],
      "examples": [
        {
          "name": "Preview storage fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-manager\"}'"
        }
      ]
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply the deterministic storage autofixes for a scenario",
      "description": "Shared ScenarioValidationService Fix RPC. Applies the storage-manager autofix registry's deterministic edits (DB_ROWS_NOT_CLOSED, ENSURE_SCHEMAS_NOT_WIRED) and reports what changed. Idempotent: a second apply over an already-fixed tree is a no-op.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id/path or scenario directory not resolvable"
        }
      ],
      "examples": [
        {
          "name": "Apply storage fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-manager\"}'"
        }
      ]
    },
    {
      "id": "storage_inventory",
      "path": "/api/v1/storage/inventory",
      "method": "GET",
      "summary": "List storage owners and declarations",
      "description": "Deterministic owner-neutral inventory across scenarios, resources, tools, and safeguards.",
      "category": "",
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "storage_qdrant",
      "path": "/api/v1/storage/qdrant",
