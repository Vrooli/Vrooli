{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "storage-manager",
    "displayName": "Storage Manager",
    "description": "Unified, policy-gated storage census, retention, placement, and cleanup orchestration.",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "storage": {
    "entries": {
      "database": {
        "rung": "owned",
        "path": "data/storage-manager.db",
        "kind": "file",
        "class": "data",
        "format": "sqlite",
        "sensitive": false,
        "budget": { "max_bytes": "2GiB", "max_age": "30d", "rationale": "Durable storage-manager audit and census history." },
        "rationale": "The manager's own control-plane database."
      },
      "database_wal": {
        "rung": "owned",
        "path": "data/storage-manager.db-wal",
        "kind": "file",
        "class": "state",
        "regenerable": true,
        "rationale": "SQLite WAL sidecar for the manager database; it is recreated by SQLite and must be counted while live."
      },
      "database_shm": {
        "rung": "owned",
        "path": "data/storage-manager.db-shm",
        "kind": "file",
        "class": "state",
        "regenerable": true,
        "rationale": "SQLite shared-memory sidecar for the manager database; it is recreated by SQLite and must be counted while live."
      },
      "cleanup_database": {
        "rung": "owned",
        "path": "data/cleanup-manager.db",
        "kind": "file",
        "class": "data",
        "format": "sqlite",
        "regenerable": false,
        "rationale": "The cleanup coordinator's durable database is stored in the manager's scenario data directory."
      },
      "cleanup_database_wal": {
        "rung": "owned",
        "path": "data/cleanup-manager.db-wal",
        "kind": "file",
        "class": "state",
        "regenerable": true,
        "rationale": "SQLite WAL sidecar for the cleanup coordinator database."
      },
      "cleanup_database_shm": {
        "rung": "owned",
        "path": "data/cleanup-manager.db-shm",
        "kind": "file",
        "class": "state",
        "regenerable": true,
        "rationale": "SQLite shared-memory sidecar for the cleanup coordinator database."
      },
      "logs": {
        "rung": "owned",
        "path": "logs",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "budget": { "max_bytes": "2GiB", "max_age": "30d", "rationale": "Operational logs are bounded and regenerable." }
      },
      "metrics": {
        "rung": "owned",
        "path": "metrics",
        "kind": "dir",
        "class": "state",
        "regenerable": true,
        "budget": { "max_bytes": "2GiB", "max_age": "30d", "rationale": "Census snapshots and growth time series are bounded." }
      }
    }
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.6.0"
    },
    "generated_at": "2026-07-08T02:38:38Z",
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    },
    "manifest_sha": "81edaea6d261bb51cb8f6416f0d27b095d92894b62e497526aeb1748e9e0949c",
    "content_sha": "b9ef831dbb8460e71bcc20a636c74c37f88d6198ac322c1b99500e7b8a173d80"
  },
  "cli": {
    "enabled": true,
    "command": "storage-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "invoke": {
      "kind": "installed_command",
      "command": "storage-manager"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/storage-manager-api"
            ]
          },
          {
            "type": "cli",
            "command": "storage-manager"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o storage-manager-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./storage-manager-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/storage-manager-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute storage-manager --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'storage-manager-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "scenarios": {
      "code-facts": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Optional code-facts enrichment for storage validation and census attribution.",
        "degraded_behavior": "Filesystem scanning remains available when code-facts is unavailable."
      }
    }
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/storage-manager.db",
    "STORAGE_CENSUS_INTERVAL": "30m"
  }
}
