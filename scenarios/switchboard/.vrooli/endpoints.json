      "path": "/api/v1/channels/socket",
      "method": "GET",
      "summary": "Connect an in-app conversation",
      "description": "Connects an in-app conversation over the registered WebSocket adapter.",
      "category": "channels",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Bidirectional JSON WebSocket transport; messages use the normalized channel envelope.",
        "proto_payloads": {
          "request": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
