      "summary": "List channel availability",
      "description": "Lists descriptor-backed channels ordered by setup friction.",
      "category": "channels",
      "rest_exception": {
        "reason": "ops_probe",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "json",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "json",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
