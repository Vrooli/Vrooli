{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "proto-health",
  "description": "Single source of truth for the proto-health CLI command surface. Schema-validated against cli-manifest/v1 and cross-validated against the ProtoHealthService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "validate",
      "description": "Run proto-health validators against a scenario's Protocol Buffer contracts",
      "commands": [
        {
          "name": "scenario",
          "description": "Validate a single scenario by id",
          "positionals": [
            { "name": "name", "required": true, "description": "Scenario id (directory name under scenarios/)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProtoHealthService", "method": "ValidateScenario" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "describe",
      "description": "Inspect proto surface facts for a scenario",
      "commands": [
        {
          "name": "scenario",
          "description": "Describe a single scenario's proto files, services, messages, imports, adoption, and transport world",
          "positionals": [
            { "name": "name", "required": true, "description": "Scenario id (directory name under scenarios/)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ProtoHealthService", "method": "DescribeScenarioProtos" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "ListNotes" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            { "name": "title", "required": true, "description": "Note title" },
            { "name": "body", "description": "Note body" }
          ],
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "CreateNote" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            { "name": "id", "required": true, "description": "Note id" }
          ],
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "GetNote" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            { "name": "window", "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "CountNotes" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": { "type": "time_window", "default": "this_week" }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      { "domain": "notes", "stateful": true, "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier." }
    ]
  },
  "omitted": []
}
