  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.navLink": {
      "description": "App shell navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]",
      "testIdPattern": "layout-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "audit",
            "trends",
            "fleet",
            "trace",
            "readiness",
            "budgets",
            "settings"
          ]
        }
      ]
    },
    "pages.workflowCard": {
      "description": "Overview workflow entry-point card by destination route",
      "selectorPattern": "[data-testid=\"overview-workflow-card-${to}\"]",
      "testIdPattern": "overview-workflow-card-${to}",
      "params": [
        {
          "name": "to",
          "type": "string"
        }
      ]
    },
    "audit.findingRow": {
      "description": "Readiness finding row in the audit workbench by finding code",
      "selectorPattern": "[data-testid=\"audit-finding-${code}\"]",
      "testIdPattern": "audit-finding-${code}",
      "params": [
        {
          "name": "code",
          "type": "string"
        }
      ]
    },
    "fleet.scenarioRow": {
      "description": "Fleet offender row by scenario id",
      "selectorPattern": "[data-testid=\"fleet-scenario-${scenario}\"]",
      "testIdPattern": "fleet-scenario-${scenario}",
      "params": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    "fleet.tierRow": {
      "description": "Fleet tier-distribution row by tier",
      "selectorPattern": "[data-testid=\"fleet-tier-${tier}\"]",
      "testIdPattern": "fleet-tier-${tier}",
      "params": [
        {
          "name": "tier",
          "type": "string"
        }
      ]
    },
    "trace.componentRow": {
      "description": "Per-component trace timing row by component name",
      "selectorPattern": "[data-testid=\"trace-component-${component}\"]",
      "testIdPattern": "trace-component-${component}",
      "params": [
        {
          "name": "component",
          "type": "string"
        }
      ]
    },
    "readiness.gapRow": {
      "description": "Readiness gap row by finding code",
      "selectorPattern": "[data-testid=\"readiness-gap-${code}\"]",
      "testIdPattern": "readiness-gap-${code}",
      "params": [
        {
          "name": "code",
          "type": "string"
        }
      ]
    },
    "budgets.field": {
      "description": "Budget threshold input by proto field name",
      "selectorPattern": "[data-testid=\"budgets-field-${field}\"]",
      "testIdPattern": "budgets-field-${field}",
      "params": [
        {
          "name": "field",
          "type": "string"
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
