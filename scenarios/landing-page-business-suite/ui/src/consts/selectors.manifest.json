  "dynamicSelectors": {
    "publicLanding.experienceState": {
      "description": "Public landing experience surface by lifecycle state",
      "selectorPattern": "[data-testid=\"landing-experience-surface\"][data-experience-state=\"${state}\"]",
      "params": [
        {
          "name": "state",
          "type": "enum",
          "values": [
            "loading",
            "ready",
            "error"
          ]
        }
      ]
    },
    "admin.analytics.variantRow": {
      "description": "Analytics variant performance row by variant ID",
      "selectorPattern": "[data-testid=\"analytics-variant-row-${id}\"]",
      "testIdPattern": "analytics-variant-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "number"
        }
      ]
    },
    "admin.analytics.viewDetails": {
      "description": "View details button for specific variant",
      "selectorPattern": "[data-testid=\"analytics-view-details-${id}\"]",
      "testIdPattern": "analytics-view-details-${id}",
      "params": [
