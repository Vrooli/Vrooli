  "sideEffects": [
    "Wallet reservations and Gateway receipts are the only durable authorities. The reserve event follows one committed account transaction containing device/session cap admission and the wallet hold.",
    "Only a receipt matching the operation with known terminal cost may commit.",
    "A failed commit returns to reconciliation; it cannot dispatch. Public disconnect preserves the stream until receipt.",
    "Definitive no-dispatch failures release holds; ambiguous outcomes retain them.",
    "Gateway pins the selected route and disables costlier fallback; request retries only query receipts.",
    "A definitive wallet rejection commits only a zero-cost terminal cap marker. Process death before admission commit rolls back both cap and wallet changes; no provider dispatch can precede that commit."
  ],
  "compositionInvariants": [
    "reserved_before_dispatch",
    "receipt_before_commit",
    "no_dispatch_after_recovery",
    "commit_once"
  ]
