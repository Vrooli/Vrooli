# Landing Page Business Suite Environment Configuration
# This file contains default environment variables for development
# In production, override these with secure values

# Session security
# Set SESSION_SECRET through the deployment secret store. Development generates
# an ephemeral key when it is absent; production refuses to start without one.

# Ports are allocated dynamically by the lifecycle system via service.json
# Do NOT set hardcoded port defaults here - each generated scenario gets unique ports

# Database for this scenario
DATABASE_URL=${DATABASE_URL:-postgresql://vrooli:lUq9qvemypKpuEeXCV6Vnxak1@localhost:5433/landing-page-business-suite?sslmode=disable}

# Stripe payment configuration
# Set Stripe values through the deployment secret store. The API reports an
# unconfigured payment integration rather than inventing test credentials.

# Analytics / Metrics
METRICS_SAMPLE_RATE=1.0

# Admin portal
ADMIN_DEFAULT_EMAIL=admin@localhost
