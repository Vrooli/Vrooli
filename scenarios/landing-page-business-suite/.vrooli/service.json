            "field": "admin-default-email",
            "env": "ADMIN_DEFAULT_EMAIL",
            "classification": "user",
            "label": "Admin Email",
            "description": "Email address for the default admin account. Used for logging into the admin portal.",
            "required": false,
            "default_hint": "Defaults to admin@localhost if not set"
          },
          {
            "secret_id": "ADMIN_DEFAULT_PASSWORD",
            "logical_id": "vrooli/landing-page-business-suite",
            "field": "admin-default-password",
            "env": "ADMIN_DEFAULT_PASSWORD",
            "classification": "user",
            "label": "Admin Password",
            "description": "Password for the default admin account. Should be a strong, unique password for production deployments.",
            "required": false,
            "default_hint": "Required in production; local development generates an ephemeral credential when not set"
          },
          {
            "secret_id": "SESSION_SECRET",
            "logical_id": "vrooli/landing-page-business-suite",
            "field": "session-secret",
