        "required": true,
        "schema": "landing-page-business-suite",
        "type": "postgres",
        "startup_policy": "must_start"
      }
    }
  },
  "environment": {
    "PUBLIC_BASE_URL": "https://vrooli.com",
    "AUTH_MAGIC_LINK_BASE_URL": "https://vrooli.com/auth/verify",
    "CONSUMER_AUTH_KEY_ID": "lpbs-consumer-v1",
    "STRIPE_MODE": "test",
    "STRIPE_PLANS_PATH": ".vrooli/plans.json"
    ,"EMAIL_FROM_ADDRESS": "noreply@vrooli.com"
    ,"EMAIL_FROM_NAME": "Vrooli"
  },
  "generation": {
    "template": {
      "id": "landing-page-react-vite",
