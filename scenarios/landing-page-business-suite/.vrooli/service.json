    "invoke": {
      "kind": "installed_command",
      "command": "landing-page-business-suite"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
