    "version": "2.0.0"
  },
  "ports": {
    "api": {
      "description": "Go API server",
      "env_var": "API_PORT",
      "range": "15000-19999"
    },
    "ui": {
      "description": "React UI",
      "env_var": "UI_PORT",
      "range": "20000-24999"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
