{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "hostTools": [
    {
      "name": "stripe",
      "required": false,
      "reason": "Run local Stripe webhook forwarding and payment test flows for landing-page subscriptions, bundles, and coupons",
      "when": [
        "setup",
        "develop",
        "test"
      ],
      "environments": [
        "development"
      ],
      "notes": "Use the Stripe CLI to forward /api/v1/webhooks/stripe and trigger test events during scenario validation"
    }
  ],
  "dependencies": {
    "resources": {
      "postgres": {
        "description": "Primary relational data store for generated landing pages (content, variants, metrics, subscriptions)",
        "enabled": true,
        "required": true,
        "schema": "landing-page-business-suite",
        "type": "postgres"
      }
    }
  },
  "generation": {
    "template": {
      "id": "landing-page-react-vite",
      "version": "1.0.0"
    },
    "generated_at": "2025-12-06T20:24:47Z"
  },
  "lifecycle": {
    "health": {
      "checks": [
        {
          "critical": true,
          "interval": 30000,
          "name": "api_endpoint",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "type": "http"
        },
        {
          "critical": false,
          "interval": 30000,
          "name": "ui_endpoint",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "type": "http"
        }
      ],
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000
    },
    "version": "2.0.0"
  },
  "ports": {
    "api": {
      "description": "Go API server",
      "env_var": "API_PORT",
      "range": "15000-19999"
    },
    "ui": {
      "description": "React UI",
      "env_var": "UI_PORT",
      "range": "20000-24999"
    }
  },
  "service": {
    "category": "business_tools",
    "description": "Generated landing page scenario from template 'landing-page-business-suite'",
    "displayName": "Silent Founder OS",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "license": "MIT",
    "maintainers": [
      {
        "email": "support@vrooli.com",
        "name": "Vrooli Team",
        "url": "https://github.com/Vrooli"
      }
    ],
    "name": "landing-page-business-suite",
    "parent": "vrooli",
    "repository": {
      "directory": "/scenarios/landing-page-business-suite",
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli"
    },
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "tags": [
      "react-ui",
      "go-api",
      "landing-template",
      "ab-testing",
      "stripe",
      "analytics",
      "templates"
    ],
    "type": "application-template",
    "version": "1.1.0"
  },
  "tier_feasibility": {
    "tiers": {
      "tier-1-local": {}
    }
  },
  "version": "1.1.0",
  "storage": {
    "entries": {
      "logs": {
        "rung": "owned",
        "kind": "dir",
        "class": "logs",
        "regenerable": true,
        "rationale": "Scenario operational logs observed in the canonical logs directory.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "cli": {
    "enabled": true,
    "command": "landing-page-business-suite",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "landing-page-business-suite"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "session-secret",
        "env": "SESSION_SECRET",
        "label": "Session signing secret",
        "description": "Signs session cookies. Without it the scenario generates an ephemeral key and sessions do not survive a restart.",
        "required": true,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "service-secret",
        "env": "LPBS_SERVICE_SECRET",
        "label": "Service-to-service token",
        "description": "Bearer token other scenarios present to reach LPBS admin endpoints; scenario-to-desktop uses it.",
        "required": false,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "api-key-encryption-key",
        "env": "LPBS_API_KEY_ENCRYPTION_KEY",
        "label": "API key encryption key",
        "description": "Encrypts stored API keys at rest. Required in production; without it keys are stored unencrypted.",
        "required": false
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "remote-profile-encryption-key",
        "env": "LPBS_REMOTE_PROFILE_ENCRYPTION_KEY",
        "label": "Remote profile encryption key",
        "description": "Encrypts stored remote deployment profiles. Falls back to the API key encryption key when unset.",
        "required": false,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "auth-magic-link-base-url",
        "env": "AUTH_MAGIC_LINK_BASE_URL",
        "label": "Magic-link verification URL",
        "description": "Absolute public URL for the /auth/verify magic-link route. Production requires HTTPS.",
        "required": false,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "admin-default-password",
        "env": "ADMIN_DEFAULT_PASSWORD",
        "label": "Seeded admin password",
        "description": "Password for the seeded admin account. Required in production; development generates an ephemeral one.",
        "required": false,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "consumer-auth-private-key",
        "env": "CONSUMER_AUTH_PRIVATE_KEY",
        "label": "Consumer token signing key",
        "description": "Private RSA key used only by LPBS to sign consumer access tokens. Never distribute to bundled scenarios.",
        "required": true,
        "tiers": [
          "tier-1-local"
        ]
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "sendgrid-api-key",
        "env": "SENDGRID_API_KEY",
        "label": "SendGrid API key",
        "description": "Authenticates outbound transactional email delivery.",
        "required": false
      },
      {
        "logical_id": "vrooli/landing-page-business-suite",
        "field": "admin-default-email",
        "env": "ADMIN_DEFAULT_EMAIL",
        "label": "Admin Email",
        "description": "Email address for the default admin account. Used for logging into the admin portal.",
        "required": false,
        "tiers": [
          "tier-1-local"
        ]
      }
    ]
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
