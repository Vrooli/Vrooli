{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "cleanup-manager",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "cleanup",
      "description": "Preview, plan, apply, and audit cleanup policy",
      "commands": [
        {
          "name": "providers",
          "description": "List cleanup providers and safety metadata",
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "ListProviders"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "policy",
          "description": "Show active cleanup policy",
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "GetPolicy"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "set-profile",
          "description": "Set cleanup policy profile",
          "flags": [
            {
              "name": "profile",
              "required": true,
              "description": "Policy profile: conservative, balanced, or aggressive"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "SetPolicyProfile"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "plan",
          "description": "Create a cleanup preview plan without mutating host state",
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "CreatePlan"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "operational"
          }
        },
        {
          "name": "apply",
          "description": "Apply an approved cleanup plan with replay protection",
          "flags": [
            {
              "name": "plan-id",
              "required": true,
              "description": "Cleanup plan id"
            },
            {
              "name": "policy-version",
              "required": true,
              "description": "Policy version captured by the plan"
            },
            {
              "name": "approval-mode",
              "description": "Approval mode supplied for this apply request"
            },
            {
              "name": "approval-token",
              "description": "Approval token when owner/operator approval is required"
            },
            {
              "name": "idempotency-key",
              "required": true,
              "description": "Replay-safe idempotency key"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "ApplyPlan"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "requires_confirmation": true,
            "permissions": [
              "network:internal",
              "admin"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "audit",
          "description": "List cleanup audit events",
          "binding": {
            "kind": "connect-rpc",
            "service": "CleanupService",
            "method": "ListAudit"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "ListNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Note title"
            },
            {
              "name": "body",
              "description": "Note body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CreateNote"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Note id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "GetNote"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            {
              "name": "window",
              "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CountNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "notes",
        "stateful": true,
        "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier."
      }
    ]
  },
  "omitted": []
}
