{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.cleanup_manager.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.cleanup_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "cleanup_provider_list",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ListProviders",
      "method": "POST",
      "summary": "List cleanup providers",
      "description": "Returns the registered cleanup providers and their safety metadata.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "providers": "array<Provider>"
        }
      }
    },
    {
      "id": "cleanup_policy_get",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/GetPolicy",
      "method": "POST",
      "summary": "Get cleanup policy",
      "description": "Returns the active cleanup policy profile and per-provider settings.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "policy": "Policy"
        }
      }
    },
    {
      "id": "cleanup_policy_set_profile",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/SetPolicyProfile",
      "method": "POST",
      "summary": "Set cleanup policy profile",
      "description": "Switches the active policy to conservative, balanced, or aggressive defaults.",
      "category": "cleanup",
      "request": {
        "type": "object",
        "properties": {
          "profile": "string (conservative|balanced|aggressive)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "policy": "Policy"
        }
      }
    },
    {
      "id": "cleanup_plan_create",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/CreatePlan",
      "method": "POST",
      "summary": "Create cleanup plan",
      "description": "Runs provider estimates and previews to create a stable cleanup plan id without mutating host state.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "plan": "Plan"
        }
      }
    },
    {
      "id": "cleanup_plan_apply",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ApplyPlan",
      "method": "POST",
      "summary": "Apply cleanup plan",
      "description": "Applies an approved plan using policy/provider version checks and an idempotency key.",
      "category": "cleanup",
      "request": {
        "type": "object",
        "properties": {
          "approval_mode": "string",
          "approval_token": "string",
          "idempotency_key": "string (required)",
          "plan_id": "string (required)",
          "policy_version": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "already_applied": "bool",
          "reclaimed_bytes": "int64"
        }
      }
    },
    {
      "id": "cleanup_audit_list",
      "path": "/vrooli.cleanup_manager.v1.cleanup.CleanupService/ListAudit",
      "method": "POST",
      "summary": "List cleanup audit events",
      "description": "Returns immutable cleanup policy, plan, apply, and replay audit events with redacted messages.",
      "category": "cleanup",
      "response": {
        "type": "object",
        "properties": {
          "events": "array<AuditEvent>"
        }
      }
    },
    {
      "id": "notes_list",
      "path": "/vrooli.cleanup_manager.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.cleanup_manager.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "notes_create",
      "path": "/vrooli.cleanup_manager.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.cleanup_manager.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ]
    },
    {
      "id": "notes_get",
      "path": "/vrooli.cleanup_manager.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.cleanup_manager.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "notes_count",
      "path": "/vrooli.cleanup_manager.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.cleanup_manager.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ]
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "UploadAttachmentResponse",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.cleanup_manager.v1.notes.UploadAttachmentResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.cleanup_manager.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    }
  ]
}
