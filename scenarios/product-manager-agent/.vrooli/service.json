{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "product-manager-agent",
    "displayName": "Product Manager Agent",
    "description": "Product manager AI agent with Go API and React UI",
    "version": "1.0.0",
    "tags": [
      "product-management",
      "ai-agent",
      "go-api",
      "react-ui",
      "postgres-storage",
      "redis-cache",
      "ollama-ai",
      "qdrant-vectors"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/product-manager-agent"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "range": "20000-24999"
    }
  },
  "cli": {
    "enabled": true,
    "command": "product-manager-agent",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "product-manager-agent"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Product Manager Agent health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 3000,
          "interval": 45000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    },
    "setup": {
      "description": "Initialize Product Manager Agent",
      "steps": [
        {
          "name": "generate-embeddings",
          "exec": [
            "vrooli",
            "resource",
            "qdrant",
            "embeddings",
            "refresh",
            "--force"
          ],
          "on_error": "continue",
          "description": "Generate code embeddings for AI assistance"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "redis": {
        "type": "redis",
        "enabled": true,
        "required": true,
        "purpose": "Cache analysis results and session management"
      },
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "purpose": "Store features, roadmaps, sprints, and analysis results"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "model_roles": [
          "chat.small"
        ],
        "purpose": "AI-powered analysis for market research, competitor analysis, and decision support"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": false,
        "required": false,
        "purpose": "Semantic search for features and feedback (optional)"
      }
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "readiness": {
          "type": "http",
          "path": "/health",
          "timeout_ms": 30000
        },
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "depends_on": [
          {
            "component": "api",
            "wait": "ready"
          }
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
