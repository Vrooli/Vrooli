#!/usr/bin/env bash
# Install script template for a Vrooli scenario-wrapping skill.
#
# Required properties:
#   - Idempotent: running twice when already installed is a no-op.
#   - Pinned: every download uses a specific release tag or commit SHA.
#   - Checksummed: every download is verified against a known SHA-256.
#   - Minimal: installs only what this specific skill needs, not the full
#     Vrooli runtime, unless explicitly required and disclosed.
#   - Auditable: prints what it's about to do before doing it.
#
# Replace every <PLACEHOLDER> below.

set -euo pipefail

SCENARIO_SLUG="<scenario-slug>"
RELEASE_TAG="<v0.0.0>"           # pin to a real release tag, never 'latest' or 'main'
EXPECTED_SHA256="<sha256-hex>"   # SHA-256 of the artifact at RELEASE_TAG
DOWNLOAD_URL="https://github.com/Vrooli/<repo>/releases/download/${RELEASE_TAG}/<artifact>"
INSTALL_PREFIX="${VROOLI_SKILL_PREFIX:-${HOME}/.local/share/vrooli/skills/${SCENARIO_SLUG}}"
BIN_TARGET="${INSTALL_PREFIX}/bin/<cli-name>"

log() { printf '[install] %s\n' "$*" >&2; }
fail() { printf '[install] ERROR: %s\n' "$*" >&2; exit 1; }

# --- Idempotency check -------------------------------------------------------

if [[ -x "${BIN_TARGET}" ]]; then
  installed_version="$("${BIN_TARGET}" --version 2>/dev/null || echo unknown)"
  if [[ "${installed_version}" == *"${RELEASE_TAG}"* ]]; then
    log "Already installed at ${BIN_TARGET} (${installed_version}). Nothing to do."
    exit 0
  fi
  log "Different version detected (${installed_version}); reinstalling ${RELEASE_TAG}."
fi

# --- Preflight ---------------------------------------------------------------

command -v curl >/dev/null 2>&1 || fail "curl is required"
command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
  || fail "sha256sum or shasum is required"

mkdir -p "${INSTALL_PREFIX}/bin"
tmpdir="$(mktemp -d)"
trap 'rm -rf "${tmpdir}"' EXIT

# --- Download with pinned URL + checksum verification -----------------------

log "Downloading ${DOWNLOAD_URL}"
curl --proto '=https' --tlsv1.2 -fL --retry 3 --retry-connrefused \
  -o "${tmpdir}/artifact" "${DOWNLOAD_URL}"

log "Verifying SHA-256"
if command -v sha256sum >/dev/null 2>&1; then
  actual_sha="$(sha256sum "${tmpdir}/artifact" | awk '{print $1}')"
else
  actual_sha="$(shasum -a 256 "${tmpdir}/artifact" | awk '{print $1}')"
fi

if [[ "${actual_sha}" != "${EXPECTED_SHA256}" ]]; then
  fail "Checksum mismatch. Expected ${EXPECTED_SHA256}, got ${actual_sha}. Aborting."
fi

# --- Install -----------------------------------------------------------------

log "Installing to ${BIN_TARGET}"
# Adjust the next two lines based on artifact format (binary, tarball, zip, etc.).
# Example for a single binary:
install -m 0755 "${tmpdir}/artifact" "${BIN_TARGET}"

# --- Verify ------------------------------------------------------------------

if ! "${BIN_TARGET}" --version >/dev/null 2>&1; then
  fail "Post-install verification failed. ${BIN_TARGET} did not run cleanly."
fi

log "Installed ${SCENARIO_SLUG} ${RELEASE_TAG} at ${BIN_TARGET}"
log "Add ${INSTALL_PREFIX}/bin to your PATH if it is not already."
