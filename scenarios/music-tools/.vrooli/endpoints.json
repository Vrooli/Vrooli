{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.music_tools.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.music_tools.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "JSON capability discovery is consumed by lifecycle and capability tooling."
      }
    },
    {
      "id": "composition-submit",
      "path": "/vrooli.music_tools.v1.composition.CompositionService/Submit",
      "method": "POST",
      "summary": "Submit a composition batch",
      "description": "",
      "category": "composition"
    },
    {
      "id": "composition-list-takes",
      "path": "/vrooli.music_tools.v1.composition.CompositionService/ListTakes",
      "method": "POST",
      "summary": "List peer takes",
      "description": "",
      "category": "composition"
    },
    {
      "id": "models_list",
      "path": "/api/v1/models",
      "method": "GET",
      "summary": "List available music models and licence lanes.",
      "description": "",
      "category": "models",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "REST projection of the model registry."
      }
    },
    {
      "id": "models_get",
      "path": "/api/v1/models/{id}",
      "method": "GET",
      "summary": "Get one music model.",
      "description": "",
      "category": "models",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "REST projection of the model registry."
      }
    },
    {
      "id": "cleanup_estimate",
      "path": "/api/v1/cleanup/estimate",
      "method": "GET",
      "summary": "Estimate music-tools output cleanup",
      "description": "",
      "category": "cleanup",
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "cleanup_preview",
      "path": "/api/v1/cleanup/preview",
      "method": "POST",
      "summary": "Preview music-tools output cleanup",
      "description": "",
      "category": "cleanup",
      "rest_exception": {
        "reason": "ops_probe"
      }
    },
    {
      "id": "cleanup_apply",
      "path": "/api/v1/cleanup/apply",
      "method": "POST",
      "summary": "Apply music-tools output cleanup",
      "description": "",
      "category": "cleanup",
      "rest_exception": {
        "reason": "ops_probe"
      }
    }
  ]
}
