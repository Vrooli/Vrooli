{
  "name": "music-tools-ui",
  "version": "1.0.0",
  "description": "React + Vite front-end for Music Tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vrooli lifecycle protect -- vite",
    "build": "pnpm strings:gen && vite build",
    "build:profile": "pnpm strings:gen && vite build --mode profile",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "pnpm strings:check && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "strings:gen": "node scripts/gen-strings.mjs",
    "strings:check": "node scripts/gen-strings.mjs --check",
    "selector:manifest": "node ./scripts/generate-selector-manifest.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "5.59.0",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "@vrooli/proto-types": "file:../../../packages/proto/gen/typescript",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.18.2",
    "i18next": "23.16.4",
    "lucide-react": "^0.424.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.1",
    "react-router-dom": "6.30.4",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "4.10.2",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.44",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@9.12.1"
}
