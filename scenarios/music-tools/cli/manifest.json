{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "music-tools",
  "description": "Music composition CLI surface for styles, peer-take jobs, take selection, and pool reservations.",
  "groups": [
    {
      "name": "styles",
      "description": "Manage composition styles",
      "commands": [
        {
          "name": "create",
          "description": "Create a style from JSON",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "list",
          "description": "List styles",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "default-get",
          "description": "Show the configured default composition style",
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true}
        },
        {
          "name": "default-set",
          "description": "Set the configured default composition style",
          "positionals": [{"name": "style-id", "required": true, "description": "Style ID"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "write", "run_eligible": true}
        },
        {
          "name": "export",
          "description": "Export a style",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "compile",
          "description": "Compile a style",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "delete",
          "description": "Delete a custom style",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "import",
          "description": "Import a style",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "compose",
      "description": "Queue peer music takes",
      "commands": [
        {
          "name": "run",
          "description": "Queue a composition batch",
          "flags": [
            {"name": "style", "type": "string", "required": false, "description": "Style ID"},
            {"name": "takes", "type": "int", "required": false, "description": "Number of takes"},
            {"name": "duration", "type": "int", "required": false, "description": "Duration in seconds"},
            {"name": "seed", "type": "int", "required": false, "description": "Optional repeatable base seed"},
            {"name": "shift", "type": "float", "required": false, "description": "Optional ACE sampling shift"},
            {"name": "vocal-language", "type": "string", "required": false, "description": "Optional model-declared sung language"}
          ],
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "sources",
      "description": "Manage private audio sources",
      "commands": [
        {
          "name": "import",
          "description": "Import a local audio file into managed private storage",
          "flags": [
            {"name": "file", "type": "string", "required": true, "description": "Local audio path"},
            {"name": "title", "type": "string", "required": true, "description": "Track title"},
            {"name": "artist", "type": "string", "required": false, "description": "Artist"},
            {"name": "uploader", "type": "string", "required": false, "description": "Source uploader/channel"},
            {"name": "source-url", "type": "string", "required": false, "description": "HTTPS YouTube provenance URL"},
            {"name": "acquired-at", "type": "string", "required": false, "description": "RFC3339 acquisition timestamp"}
          ],
          "binding": {"kind": "local"},
          "governance": {"effect": "write", "run_eligible": true}
        },
        {
          "name": "get",
          "description": "Read source provenance by SHA-256",
          "positionals": [{"name": "sha256", "required": true, "description": "Source content SHA-256"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true}
        },
        {
          "name": "audio",
          "description": "Export private source audio to a new file",
          "positionals": [{"name": "sha256", "required": true, "description": "Source content SHA-256"}],
          "flags": [{"name": "out", "type": "string", "required": true, "description": "New audio output path"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true}
        }
      ]
    },
    {
      "name": "analyze",
      "description": "Queue track analysis",
      "commands": [
        {
          "name": "run",
          "description": "Queue analysis for a managed source blob",
          "positionals": [{"name": "source_blob_key", "required": true, "description": "Music Tools managed audio blob key"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "write", "run_eligible": true}
        }
      ]
    },
    {
      "name": "separate",
      "description": "Queue source separation",
      "commands": [
        {
          "name": "run",
          "description": "Queue vocals, drums, bass and other stems",
          "positionals": [{"name": "source_blob_key", "required": true, "description": "Music Tools managed audio blob key"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "write", "run_eligible": true}
        }
      ]
    },
    {
      "name": "analysis",
      "description": "Read analysis jobs and stems",
      "commands": [
        {
          "name": "result",
          "description": "Read a completed analysis result",
          "positionals": [{"name": "id", "required": true, "description": "Analysis job ID"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true}
        },
        {
          "name": "stem",
          "description": "Export one completed separated stem",
          "positionals": [
            {"name": "id", "required": true, "description": "Analysis job ID"},
            {"name": "name", "required": true, "description": "vocals, drums, bass or other"}
          ],
          "flags": [{"name": "out", "type": "string", "required": true, "description": "New WAV path"}],
          "binding": {"kind": "local"},
          "governance": {"effect": "read", "run_eligible": true}
        }
      ]
    },
    {
      "name": "jobs",
      "description": "Inspect composition jobs",
      "commands": [
        {
          "name": "get",
          "description": "Get a job",
          "positionals": [
            {"name": "id", "required": true, "description": "Job id"}
          ],
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "list",
          "description": "List jobs",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "wait",
          "description": "Wait for a job",
          "positionals": [
            {"name": "id", "required": true, "description": "Job id"}
          ],
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          },
          "semantics": {"kind": "query", "blocks": {"replaces": ["music-tools jobs get"]}}
        },
        {
          "name": "cancel",
          "description": "Cancel a queued or running job",
          "positionals": [
            {"name": "id", "required": true, "description": "Job id"}
          ],
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "takes",
      "description": "Inspect generated takes",
      "commands": [
        {
          "name": "list",
          "description": "List generated takes",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "get",
          "description": "Get a take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "reserve",
          "description": "Reserve a take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "consume",
          "description": "Consume a reserved take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "release",
          "description": "Release a reserved take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "discard",
          "description": "Discard a take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "pool",
      "description": "Reserve composition takes",
      "commands": [
        {
          "name": "draw",
          "description": "Draw an available take",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        },
        {
          "name": "status",
          "description": "Show pool depth",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "configure",
          "description": "Configure replenishment policy",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "models",
      "description": "Inspect music model registry",
      "commands": [
        {
          "name": "list",
          "description": "List available models",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        },
        {
          "name": "get",
          "description": "Get one model",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true
          }
        }
      ]
    },
    {
      "name": "delivery",
      "description": "Deterministic local music delivery",
      "commands": [
        {
          "name": "arrange",
          "description": "Arrange sample-exact PCM from retained sources with versioned receipts",
          "binding": {
            "kind": "local"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true
          },
          "flags": [
            {
              "name": "recipe",
              "description": "Local JSON arrangement recipe",
              "required": true,
              "local_only": true
            },
            {
              "name": "out",
              "description": "New output directory",
              "required": true,
              "local_only": true
            }
          ]
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "omitted": [
    {
      "service": "CompositionService",
      "method": "Submit",
      "reason": "The CLI uses the REST composition job surface so it can expose asynchronous batch submission and job IDs."
    },
    {
      "service": "CompositionService",
      "method": "ListTakes",
      "reason": "The CLI uses the REST take inventory surface so it can filter and reserve pool takes."
    },
    {
      "service": "CompositionService",
      "method": "CompileStyle",
      "reason": "The compile edge is a REST style projection; no generated RPC exists for this endpoint."
    },
    {
      "service": "CompositionService",
      "method": "AudioTake",
      "reason": "The endpoint carries opaque audio bytes; the CLI manifest records it as a REST binary edge rather than a JSON command."
    },
    {
      "service": "ModelsService",
      "method": "List",
      "reason": "The CLI uses the REST model-registry projection so licence lanes remain visible in the JSON response."
    },
    {
      "service": "ModelsService",
      "method": "Get",
      "reason": "The CLI uses the REST model-registry projection for one-model retrieval."
    },
    {
      "service": "CandidateInventoryService",
      "method": "RequestRefill",
      "reason": "Music Library uses this internal Connect contract to persist idempotent candidate refill requests; callers do not operate it as a user CLI command."
    },
    {
      "service": "CandidateInventoryService",
      "method": "CancelRefill",
      "reason": "Music Library uses this internal Connect contract to cancel held requests when a draft bank use is rolled back."
    }
  ]
}
