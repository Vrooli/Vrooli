  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "plans",
            "authoring",
            "execution",
            "families",
            "validation",
            "triage",
            "velocity",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "plans",
            "authoring",
            "execution",
            "families",
            "validation",
            "triage",
            "velocity",
            "settings"
          ]
        }
      ]
    },
    "plans.row": {
      "description": "Plan list row by plan id",
      "selectorPattern": "[data-testid=\"plans-row-${id}\"]",
      "testIdPattern": "plans-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "plans.phase": {
      "description": "Plan-detail phase card by phase id",
      "selectorPattern": "[data-testid=\"plan-phase-${id}\"]",
      "testIdPattern": "plan-phase-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "authoring.section": {
      "description": "Authoring section row by section key",
      "selectorPattern": "[data-testid=\"authoring-section-${key}\"]",
      "testIdPattern": "authoring-section-${key}",
      "params": [
        {
          "name": "key",
          "type": "string"
        }
      ]
    },
    "execution.logEntry": {
      "description": "Execution log entry by durable ledger id",
      "selectorPattern": "[data-testid=\"execution-log-entry-${id}\"]",
      "testIdPattern": "execution-log-entry-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "execution.retrySync": {
      "description": "Retry downstream sync for a durable ledger entry",
      "selectorPattern": "[data-testid=\"execution-retry-sync-${id}\"]",
      "testIdPattern": "execution-retry-sync-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "families.edge": {
      "description": "Family graph edge by stable display ordinal",
      "selectorPattern": "[data-testid=\"families-edge-${index}\"]",
      "testIdPattern": "families-edge-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    },
    "triage.row": {
      "description": "Triage finding row by finding id",
      "selectorPattern": "[data-testid=\"triage-row-${id}\"]",
      "testIdPattern": "triage-row-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
