{
  "schemaVersion": 6,
  "kind": "temporal",
  "flowId": "authoring.guided-composer.api",
  "domain": "authoring",
  "description": "API-side guided-composer authoring workflow: a draft session progresses through section submissions, passes the structure-validation gate, and finalizes into a structured plan.",
  "model": {
    "module": "ApiAuthoringWorkflow",
    "seed": "2026062501",
    "maxSteps": 6,
    "traceCount": 8,
    "verify": {
      "invariants": [
        "TypeOK",
        "TerminalClosure",
        "IllegalTransitionsPreserveState",
        "FinalizeRequiresValidated"
      ]
    }
  },
  "states": [
    { "id": "drafting", "quint": "Drafting", "initial": true },
    { "id": "validated", "quint": "Validated" },
    { "id": "finalized", "quint": "Finalized", "terminal": true }
  ],
  "events": [
    { "id": "submit_section", "quint": "SubmitSection" },
    { "id": "validate", "quint": "Validate" },
    { "id": "finalize", "quint": "Finalize" }
  ],
  "transitionDefaults": {
    "invalid": { "to": "self", "wantError": true },
    "terminal": { "to": "self", "wantError": true }
  },
  "transitions": [
    { "from": "drafting", "event": "submit_section", "to": "drafting" },
    { "from": "drafting", "event": "validate", "to": "validated" },
    { "from": "validated", "event": "submit_section", "to": "drafting" },
    { "from": "validated", "event": "validate", "to": "validated" },
    { "from": "validated", "event": "finalize", "to": "finalized" }
  ],
  "invariants": [
    { "id": "type_ok", "quint": "TypeOK", "description": "Model variables remain inside declared state and event sets." },
    { "id": "terminal_closure", "quint": "TerminalClosure", "description": "Terminal states cannot transition to another status." },
    { "id": "illegal_transitions_preserve_state", "quint": "IllegalTransitionsPreserveState", "description": "Rejected transitions are state preserving." },
    {
      "id": "finalize_requires_validated",
      "quint": "FinalizeRequiresValidated",
      "description": "Finalize can only be valid after the structure gate has passed (state Validated).",
      "expression": "not(isValid(status, Finalize)) or status == Validated"
    }
  ],
  "traces": [
    {
      "name": "successful_authoring",
      "initial": "drafting",
      "steps": [
        { "event": "submit_section", "want": "drafting", "wantError": false },
        { "event": "validate", "want": "validated", "wantError": false },
        { "event": "finalize", "want": "finalized", "wantError": false }
      ]
    },
    {
      "name": "premature_finalize_rejected",
      "initial": "drafting",
      "steps": [
        { "event": "finalize", "want": "drafting", "wantError": true },
        { "event": "validate", "want": "validated", "wantError": false }
      ]
    },
    {
      "name": "reedit_after_validate",
      "initial": "drafting",
      "steps": [
        { "event": "validate", "want": "validated", "wantError": false },
        { "event": "submit_section", "want": "drafting", "wantError": false },
        { "event": "finalize", "want": "drafting", "wantError": true }
      ]
    }
  ],
  "runtime": {
    "go": {
      "package": "flow",
      "statusType": "AuthoringStatus",
      "eventType": "AuthoringEvent",
      "constantPrefix": "Authoring"
    },
    "sideEffects": [
      "Finalize writes the produced plan through the plans domain only after the structure gate passes.",
      "Submitting a section after validation returns the session to drafting (re-edit invalidates a prior pass)."
    ]
  },
  "replay": {
    "transition": {
      "function": "TransitionAuthoring",
      "stateType": "AuthoringState",
      "statusField": "Status"
    }
  }
}
