{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "plan-manager",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "plans",
      "description": "The structured-plan SSOT — create, read, render, archive, graph, and import/migrate plans",
      "commands": [
        {
          "name": "list",
          "description": "List plans, optionally filtered by status",
          "flags": [
            {
              "name": "status",
              "description": "Filter by status (draft|active|complete|archived)"
            },
            {
              "name": "include-archived",
              "description": "Include archived plans"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "ListPlans"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "get",
          "description": "Show one plan by id or slug",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "GetPlan"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "create",
          "description": "Create a new structured plan",
          "flags": [
            {
              "name": "title",
              "description": "Plan title",
              "required": true
            },
            {
              "name": "slug",
              "description": "Filename-safe slug (derived from title when omitted)"
            },
            {
              "name": "purpose",
              "description": "One-paragraph why"
            },
            {
              "name": "scope",
              "description": "In/out of scope"
            },
            {
              "name": "constraints",
              "description": "Hard rules"
            },
            {
              "name": "non-goals",
              "description": "Explicit exclusions"
            },
            {
              "name": "dod",
              "description": "Definition of Done"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "CreatePlan"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "update",
          "description": "Update a plan's authored fields",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "title",
              "description": "Plan title"
            },
            {
              "name": "purpose",
              "description": "One-paragraph why"
            },
            {
              "name": "scope",
              "description": "In/out of scope"
            },
            {
              "name": "constraints",
              "description": "Hard rules"
            },
            {
              "name": "non-goals",
              "description": "Explicit exclusions"
            },
            {
              "name": "dod",
              "description": "Definition of Done"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "UpdatePlan"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "archive",
          "description": "Soft-archive a plan",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "ArchivePlan"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "render",
          "description": "Render a plan to its markdown view",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "RenderMarkdown"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "graph",
          "description": "Show the supersession/dependency graph",
          "flags": [
            {
              "name": "plan",
              "description": "Scope to one plan's neighborhood"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "GetGraph"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "link",
          "description": "Record that one plan supersedes another",
          "positionals": [
            {
              "name": "superseding",
              "required": true,
              "description": "Superseding plan id"
            },
            {
              "name": "superseded",
              "required": true,
              "description": "Superseded plan id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "LinkSupersession"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "import",
          "description": "Adopt a markdown plan from a fallback location",
          "flags": [
            {
              "name": "source",
              "description": "Source path to read"
            },
            {
              "name": "markdown",
              "description": "Inline markdown (overrides source)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "ImportPlan"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "migrate",
          "description": "Ensure a plan resides in the canonical home store",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "MigratePlan"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "phase",
      "description": "First-class phases on a plan — add and update",
      "commands": [
        {
          "name": "add",
          "description": "Append a phase to a plan",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "title",
              "description": "Phase title",
              "required": true
            },
            {
              "name": "intent",
              "description": "What the phase accomplishes"
            },
            {
              "name": "acceptance",
              "description": "Objective pass/fail"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "AddPhase"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "update",
          "description": "Update a phase's authored fields",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            },
            {
              "name": "phase",
              "required": true,
              "description": "Phase id"
            }
          ],
          "flags": [
            {
              "name": "title",
              "description": "Phase title"
            },
            {
              "name": "intent",
              "description": "What the phase accomplishes"
            },
            {
              "name": "acceptance",
              "description": "Objective pass/fail"
            },
            {
              "name": "status",
              "description": "Phase status (todo|active|done|blocked)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "UpdatePhase"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "template",
      "description": "Per-surface plan templates — list and instantiate",
      "commands": [
        {
          "name": "list",
          "description": "List the available plan templates",
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "ListTemplates"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "new",
          "description": "Create a plan from a template",
          "positionals": [
            {
              "name": "template",
              "required": true,
              "description": "Template id (generic|cli|proto|ui)"
            }
          ],
          "flags": [
            {
              "name": "title",
              "description": "Plan title",
              "required": true
            },
            {
              "name": "slug",
              "description": "Filename-safe slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlansService",
            "method": "CreateFromTemplate"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "validate",
      "description": "Plan health — resolve references, compute staleness, derive + run baselines, verify the Definition of Done",
      "commands": [
        {
          "name": "references",
          "description": "Resolve a plan/phase's code references against code-facts",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Scope to one phase id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ValidationService",
            "method": "ResolveReferences"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "staleness",
          "description": "Compute staleness tiers for a plan/phase's references",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Scope to one phase id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ValidationService",
            "method": "ComputeStaleness"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "baseline-scope",
          "description": "Derive the exact baseline/validation command set",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Scope to one phase id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ValidationService",
            "method": "DeriveBaselineScope"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "run",
          "description": "Run the derived baseline/check set and report the verdict",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Scope to one phase id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ValidationService",
            "method": "RunValidation"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "verify-dod",
          "description": "Verify the Definition of Done against the regression anchor",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ValidationService",
            "method": "VerifyDefinitionOfDone"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "author",
      "description": "Guided composer wizard — start a session, walk and submit sections, validate structure, autofill mechanical sections, and finalize into a structured plan",
      "commands": [
        {
          "name": "start",
          "description": "Start a guided authoring session for a plan title/slug",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Plan title"
            },
            {
              "name": "slug",
              "description": "Optional slug (derived from title when omitted)"
            },
            {
              "name": "template",
              "description": "Optional template id to pre-scaffold the section skeleton"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "StartSession"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "section-get",
          "description": "Get one section's current state",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "flags": [
            {
              "name": "section",
              "required": true,
              "description": "Section key (e.g. purpose, scope, regression_anchor, phases)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "GetSection"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "section-submit",
          "description": "Submit authored content for a section and re-validate it",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "flags": [
            {
              "name": "section",
              "required": true,
              "description": "Section key to submit"
            },
            {
              "name": "content",
              "required": true,
              "description": "Authored content for the section"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "SubmitSection"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "next",
          "description": "Return the next section that still needs author input",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "Next"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "validate",
          "description": "Run the structure-validation gate over the whole session",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "ValidateStructure"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "autofill",
          "description": "Autofill the mechanical sections behind seams (regression anchor / required reading / references)",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "flags": [
            {
              "name": "sources",
              "description": "Comma-separated autofill source(s) to run; omit to run all (regression_anchor, required_reading, references)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "Autofill"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "finalize",
          "description": "Run the structure gate then write the produced plan through the plans domain",
          "positionals": [
            {
              "name": "session",
              "required": true,
              "description": "Authoring session id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AuthoringService",
            "method": "Finalize"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "exec",
      "description": "Guided runner — start a run, get just-in-time context, transition phases, capture decisions/findings, complete into the canonical handoff, triage candidate findings, and read velocity",
      "commands": [
        {
          "name": "start",
          "description": "Start a guided run linked to a plan",
          "positionals": [
            {
              "name": "plan",
              "required": true,
              "description": "Plan id or slug"
            }
          ],
          "flags": [
            {
              "name": "run-id",
              "description": "Attribution run id (falls back to VROOLI_AGENT_MANAGER_RUN_ID)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "Start"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "status",
          "description": "Get the just-in-time context for the current phase",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "GetStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "next",
          "description": "Advance to the next actionable phase and return its context",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "GetNext"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "transition",
          "description": "Transition a phase to a new status",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            },
            {
              "name": "phase",
              "required": true,
              "description": "Phase id"
            }
          ],
          "flags": [
            {
              "name": "status",
              "description": "Target status (todo|active|done|blocked)",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "TransitionPhase"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "decision-add",
          "description": "Record an in-flow design decision",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Phase id"
            },
            {
              "name": "summary",
              "description": "One-line decision summary",
              "required": true
            },
            {
              "name": "detail",
              "description": "Optional detail"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "RecordDecision"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "finding-add",
          "description": "Record an in-flow candidate finding (unvalidated)",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "flags": [
            {
              "name": "phase",
              "description": "Phase id"
            },
            {
              "name": "title",
              "description": "Finding title",
              "required": true
            },
            {
              "name": "detail",
              "description": "Optional detail"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "RecordFinding"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "complete",
          "description": "Run the guided completion process and assemble the canonical handoff",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "flags": [
            {
              "name": "tokens",
              "description": "Tokens consumed (velocity)"
            },
            {
              "name": "iterations",
              "description": "Iteration count (velocity)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "Complete"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "handoff",
          "description": "Show the assembled canonical handoff",
          "positionals": [
            {
              "name": "execution",
              "required": true,
              "description": "Execution id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ExecutionService",
            "method": "GetHandoff"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "findings",
          "description": "List candidate findings awaiting triage",
          "flags": [
            {
