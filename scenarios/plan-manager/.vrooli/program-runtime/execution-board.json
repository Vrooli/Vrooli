{
  "$schema": "../../../program-runtime/schemas/program-contract.schema.json",
  "name": "plan-manager.execution-board",
  "version": "1",
  "purpose": "Join execution guidance with reviewed current family admission and active work.",
  "inputs": {
    "execution_id": {
      "type": "string",
      "required": true
    },
    "family_id": {
      "type": "string",
      "required": false
    },
    "supervisor_execution_id": {
      "type": "string",
      "required": false
    }
  },
  "assumptions": [
    "Owner responses are authoritative; separate reads can observe different revisions."
  ],
  "invariants": [
    "Read only; no launches, cursor movement, assessments or promotions.",
    "One bounded envelope; missing evidence remains unknown.",
    "Outer usage skill owns one outcome-linked memory capture."
  ],
  "bindings": [
    {
      "id": "plan-manager/exec/status",
      "effect": "read"
    },
    {
      "id": "plan-manager/families/get",
      "effect": "read"
    },
    {
      "id": "plan-manager/families/frontier",
      "effect": "read"
    },
    {
      "id": "test-genie/validation/get",
      "effect": "read"
    },
    {
      "id": "agent-manager/watch/list",
      "effect": "read"
    }
  ],
  "verbs": [
    "gather"
  ],
  "outputs": {
    "status": {
      "enum": [
        "ok",
        "failed",
        "unavailable",
        "refused"
      ]
    },
    "phase": {
      "enum": [
        "validate",
        "collect",
        "classify",
        "report"
      ]
    },
    "signals": {
      "summary": "Bounded owner identities, evidence coverage and next action"
    },
    "errors": {
      "classes": [
        "invalid_input",
        "identity_mismatch",
        "output_budget_exhausted",
        "scenario_unreachable",
        "no_grant",
        "not_run_eligible",
        "inference_spend_exceeded",
        "delegated_run_spend_exceeded",
        "ambiguous_response",
        "deadline_exceeded",
        "binding_error",
        "kernel_runtime",
        "revision_changed"
      ]
    },
    "evidence": "At most two owner identities"
  },
  "budget": {
    "wall_ms": 60000,
    "inference_calls": 0,
    "delegated_runs": 0,
    "materialize_limit": 32
  },
  "fixtures": [
    {
      "id": "empty-owner-id",
      "inputs": {
        "execution_id": "",
        "family_id": ""
      },
      "expect": {
        "status": [
          "failed"
        ]
      },
      "requires": [
        "plan-manager"
      ]
    }
  ],
  "rung": "S3",
  "owner_skill": "plan-manager"
}
