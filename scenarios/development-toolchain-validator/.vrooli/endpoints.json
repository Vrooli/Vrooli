{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "GET /health is the standard operational probe path consumed by load balancers and infrastructure curl checks, which cannot speak Connect-RPC."
      }
    },
    {
      "id": "golden_list",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/ListGoldens",
      "method": "POST",
      "summary": "List goldens",
      "description": "Returns every registered template-pristine golden ordered by slug.",
      "category": "golden",
      "response": {
        "type": "object",
        "properties": {
          "goldens": "array<Golden>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List goldens",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/ListGoldens -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens list"
      }
    },
    {
      "id": "golden_get",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/GetGolden",
      "method": "POST",
      "summary": "Get a golden by slug",
      "description": "Returns the golden whose slug matches the request.",
      "category": "golden",
      "request": {
        "type": "object",
        "properties": {
          "slug": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "golden": "Golden"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing slug"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No golden with that slug exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get golden",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/GetGolden -H 'Content-Type: application/json' -d '{\"slug\":\"reference-react-vite\"}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens get",
        "args": [
          "<slug>"
        ]
      }
    },
    {
      "id": "golden_register",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/RegisterGolden",
      "method": "POST",
      "summary": "Register a golden",
      "description": "Persists a new golden record. Slug must be unique. The on-disk path must exist; this RPC does not regenerate it.",
      "category": "golden",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (required, repo-relative)",
          "slug": "string (required, kebab-case)",
          "template_id": "string (required)",
          "template_version": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "golden": "Golden"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid slug or missing required field"
        },
        {
          "status": 409,
          "code": "already_exists",
          "description": "A golden with that slug is already registered"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Register golden",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/RegisterGolden -H 'Content-Type: application/json' -d '{\"slug\":\"reference-react-vite\",\"template_id\":\"react-vite\",\"template_version\":\"1.0.1\",\"path\":\"scenarios/reference-react-vite\"}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens register",
        "args": [
          "--slug",
          "<slug>",
          "--template",
          "<template>",
          "--version",
          "<version>",
          "--path",
          "<path>"
        ]
      }
    },
    {
      "id": "golden_update",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/UpdateGolden",
      "method": "POST",
      "summary": "Update a golden",
      "description": "Patches the path and/or template_version of an existing golden. Empty fields are left unchanged.",
      "category": "golden",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional)",
          "slug": "string (required)",
          "template_version": "string (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "golden": "Golden"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid input"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No golden with that slug exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Update golden",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/UpdateGolden -H 'Content-Type: application/json' -d '{\"slug\":\"reference-react-vite\",\"template_version\":\"1.0.2\"}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens update",
        "args": [
          "<slug>",
          "[--path",
          "<path>]",
          "[--version",
          "<version>]"
        ]
      }
    },
    {
      "id": "golden_delete",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/DeleteGolden",
      "method": "POST",
      "summary": "Delete a golden",
      "description": "Removes the golden record. Does not touch files on disk.",
      "category": "golden",
      "request": {
        "type": "object",
        "properties": {
          "slug": "string (required)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing slug"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No golden with that slug exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Delete golden",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/DeleteGolden -H 'Content-Type: application/json' -d '{\"slug\":\"reference-react-vite\"}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens delete",
        "args": [
          "<slug>",
          "--yes"
        ]
      }
    },
    {
      "id": "golden_regenerate",
      "path": "/vrooli.development_toolchain_validator.v1.golden.GoldenService/RegenerateGolden",
      "method": "POST",
      "summary": "Regenerate a golden",
      "description": "Invokes the configured regenerator runner (production: vrooli scenario generate --force) to re-materialize the golden on disk and refresh its template version pin.",
      "category": "golden",
      "request": {
        "type": "object",
        "properties": {
          "slug": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "golden": "Golden"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing slug"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No golden with that slug exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Regenerator runner failure"
        }
      ],
      "examples": [
        {
          "name": "Regenerate golden",
          "curl": "curl http://localhost:${API_PORT}/vrooli.development_toolchain_validator.v1.golden.GoldenService/RegenerateGolden -H 'Content-Type: application/json' -d '{\"slug\":\"reference-react-vite\"}'"
        }
      ],
      "cli_mapping": {
        "command": "development-toolchain-validator goldens regenerate",
        "args": [
          "<slug>",
          "--yes"
        ]
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "goldens list",
      "description": "List registered template-pristine golden scenarios",
      "endpoint_id": "golden_list"
    },
    {
      "name": "goldens get",
      "description": "Show one golden by slug",
      "endpoint_id": "golden_get"
    },
    {
      "name": "goldens register",
      "description": "Register a golden (--slug --template --version --path)",
      "endpoint_id": "golden_register"
    },
    {
      "name": "goldens update",
      "description": "Patch a golden's path and/or template version",
      "endpoint_id": "golden_update"
    },
    {
      "name": "goldens delete",
      "description": "Delete a golden (--yes to confirm)",
      "endpoint_id": "golden_delete"
    },
    {
      "name": "goldens regenerate",
      "description": "Regenerate a golden's on-disk tree from its pinned template (--yes to confirm)",
      "endpoint_id": "golden_regenerate"
    }
  ]
}
