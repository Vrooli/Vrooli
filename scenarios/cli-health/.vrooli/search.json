            ],
            "expect_within_top_k": 3
          },
          {
            "id": "reindex-run",
            "query": "reindex the command search index",
            "tags": [
              "strong",
              "search"
            ],
            "expect_ids": [
              "run",
              "reindex"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "duplicate-code",
            "query": "find duplicate code",
            "tags": [
              "strong",
              "analysis"
            ],
            "expect_ids": [
              "duplicates"
            ],
            "expect_within_top_k": 3
