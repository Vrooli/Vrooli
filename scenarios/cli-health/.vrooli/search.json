{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "cli-health.commands",
      "lifecycle": "production",
      "provider_group": "cli-health",
      "bucket": "BUCKET_DO",
      "type": "command",
      "description": "Vrooli CLI commands across every scenario CLI, searchable by what each command does (for example \"restart a scenario\", \"view logs\", \"run tests\"). Route here to discover which CLI command performs an operation.",
      "scope": "SCOPE_PROJECT",
      "class": "local_index",
      "index_timestamp_field": "lastReconcileAt",
      "endpoint": {
        "http_json": {
          "scenario_id": "cli-health",
          "path": "/vrooli.cli_health.v1.search.SearchService/Search",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}},\"mode\":\"MODE_AI\"}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "cli-health",
          "path": "/vrooli.cli_health.v1.search.SearchService/Status",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "name",
        "title_field": "fullPath",
        "score_field": "score",
        "snippet_field": "description",
        "path_field": "fullPath",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "reindex_endpoint": {
        "http_json": {
          "scenario_id": "cli-health",
          "path": "/vrooli.search_hub.v1.control.SearchControlService/Reindex",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scope\":\"{{scope}}\",\"dry_run\":false}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "config_endpoint": {
        "http_json": {
          "scenario_id": "cli-health",
          "path": "/vrooli.search_hub.v1.control.SearchControlService/WriteConfig",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "tuning": {
        "engine": "hybrid",
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": true,
        "rerank_enabled": true,
        "rerank_blend": false,
        "rerank_shortlist": 50,
        "hybrid_fusion": "dbsf",
        "floor": {
          "max_gap": 0,
    "hard_floor": 0
        }
      },
      "scoring": {
        "recall_at": 5,
        "recall_target": 0.8,
        "mrr_at": 3,
        "deep_k": 50
      },
      "performance": {
        "p95_ms": 1500,
        "degraded_rate_max": 0.05,
        "telemetry_required": true,
        "minimum_samples": 8
      },
      "tests": {
        "name": "cli-health commands — primary golden corpus",
        "description": "RANK-CENTRIC golden corpus for the cli-health command index. Positive cases assert expect_ids (LEAF command name, e.g. 'restart' for 'vrooli scenario restart') landing within expect_within_top_k. NO absolute expect_min_score band is set on positives by design: the sweep compares arms across different score REGIMES (dense cosine ~0.5-0.7, cross-encoder ~0..1, RRF-blend ~0.03), so an absolute score band cannot be shared and would mislabel a rank-correct hit as a miss under RRF-blend. Difficulty spread: strong (intended leaf at rank 1-3), weak-real (in top-5 but contested by ambiguous leaves / vocab gaps), hard (genuine retrieval gaps that most arms miss — kept honest, not gamed). Gibberish negatives feed the junk-rejection constraint, never the recall objective.",
        "cases": [
          {
            "id": "restart-scenario",
            "query": "restart a scenario",
            "tags": [
              "strong",
              "lifecycle"
            ],
            "expect_ids": [
              "restart"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "start-scenario",
            "query": "start a scenario",
            "tags": [
              "strong",
              "lifecycle"
            ],
            "expect_ids": [
              "start"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "stop-scenario",
            "query": "stop a running scenario",
            "tags": [
              "strong",
              "lifecycle"
            ],
            "expect_ids": [
              "stop"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "run-tests",
            "query": "run the tests for a scenario",
            "tags": [
              "strong",
              "testing"
            ],
            "expect_ids": [
              "test"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "view-logs",
            "query": "view logs for a scenario",
            "tags": [
              "strong",
              "observability"
            ],
            "expect_ids": [
              "logs"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "list-scenarios",
            "query": "list all scenarios",
            "tags": [
              "strong",
              "lifecycle"
            ],
            "expect_ids": [
              "list"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "develop-env",
