            "tags": [
              "hard",
              "records"
            ],
            "expect_ids": [
              "create",
              "record"
            ],
            "expect_within_top_k": 5,
            "note": "swarm-manager records create is NOT retrieved in top-5 — genuine semantic gap (record vs history vs create). Honest hard case."
          },
          {
            "id": "create-action",
            "query": "register a reusable cli action",
            "tags": [
              "hard",
              "discovery"
            ],
            "expect_ids": [
              "create"
            ],
            "expect_within_top_k": 5,
            "note": "prompt-manager action create is NOT retrieved in top-5 — 'register' surfaces wrong commands. Honest hard case."
          },
          {
            "id": "search-command",
            "query": "search for a cli command across scenarios",
            "tags": [
              "hard",
              "vocab-gap",
              "search"
            ],
            "expect_ids": [
              "query",
              "search"
            ],
            "expect_within_top_k": 5,
            "note": "cli-health search query is NOT retrieved — query embeds toward 'configure'. Genuine vocab gap."
          },
          {
            "id": "gibberish-1",
            "query": "asdfqwer zxcvbnm qwertyuiop florbnax",
            "tags": [
              "gibberish"
            ],
            "expect_max_score": 0.3,
            "expect_no_strong_hit": true,
            "note": "Junk rejection. Under rerank-on (incumbent) the cross-encoder collapses this to ~0.00; the sweep constraint is anchored to the incumbent's gibberish, so a rerank-off arm leaking ~0.59 becomes infeasible."
          },
          {
            "id": "gibberish-2",
            "query": "wibble snorp gleurgh ffffzzzz plover",
            "tags": [
              "gibberish"
            ],
            "expect_max_score": 0.3,
