      "exit_criteria": ["Measure blocks assemble cleanly and degraded schema reads are resolved or accepted"]
    },
    {
      "id": "L5",
      "name": "Discoverable CLI surface",
      "description": "The CLI manifest is clean enough for command indexing, discovery, and governance reuse.",
