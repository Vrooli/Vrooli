  "version": "1.0.0",
  "levels": [
    {
      "id": "L0",
      "name": "No CLI manifest contract",
      "description": "The target scenario has no readable CLI manifest contract for cli-health to validate.",
      "entry_criteria": ["Scenario exists in the repository"],
      "exit_criteria": ["cli/manifest.json is present and parseable"]
    },
    {
      "id": "L1",
      "name": "Manifest schema valid",
      "description": "The CLI manifest conforms to the canonical schema and can be parsed by cli-core.",
      "entry_criteria": ["CLI manifest exists"],
      "exit_criteria": ["Manifest JSON is schema-valid and parseable"]
    },
    {
      "id": "L2",
      "name": "Command bindings valid",
      "description": "Every declared command binding resolves to a known generated proto service and method.",
      "entry_criteria": ["Manifest schema is valid"],
      "exit_criteria": ["No unknown, duplicate, or orphan CLI/proto bindings remain"]
    },
    {
      "id": "L3",
      "name": "Proto/API coverage complete",
      "description": "The scenario's proto methods are either exposed through CLI commands or deliberately omitted with a reason.",
      "entry_criteria": ["Command bindings resolve"],
      "exit_criteria": ["Every proto method is bound or intentionally omitted"]
    },
    {
      "id": "L4",
      "name": "Measures metadata valid",
      "description": "CLI command measure blocks are well-formed against their proto-derived parameter schemas.",
