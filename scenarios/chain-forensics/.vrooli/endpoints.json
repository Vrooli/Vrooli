{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.chain_forensics.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.chain_forensics.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "capabilities_describe",
      "path": "/api/v1/capabilities/describe",
      "method": "GET",
      "summary": "Describe declared scenario dependencies and their current recovery actions.",
      "description": "",
      "category": "capabilities",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Read by lifecycle and setup tooling before a generated Connect client exists; reports declared-dependency liveness.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.chain_forensics.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.chain_forensics.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "cases_list",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/ListCases",
      "method": "POST",
      "summary": "List forensic cases",
      "description": "",
      "category": "cases"
    },
    {
      "id": "cases_import",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/ImportCase",
      "method": "POST",
      "summary": "Import validated evidence case",
      "description": "",
      "category": "cases"
    },
    {
      "id": "cases_get",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/GetCase",
      "method": "POST",
      "summary": "Get forensic case",
      "description": "",
      "category": "cases"
    },
    {
      "id": "cases_private_packet",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/ExportPrivatePacket",
      "method": "POST",
      "summary": "Export a private packet locally",
      "description": "",
      "category": "cases"
    },
    {
      "id": "cases_add_label",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/AddAnalystLabel",
      "method": "POST",
      "summary": "Add analyst label separately from chain evidence",
      "description": "",
      "category": "cases"
    },
    {
      "id": "cases_list_labels",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/ListAnalystLabels",
      "method": "POST",
