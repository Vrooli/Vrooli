    },
    {
      "id": "cases_capture_bitcoin",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/CaptureBitcoinTransaction",
      "method": "POST",
      "summary": "Capture a confirmed public Bitcoin transaction into a case",
