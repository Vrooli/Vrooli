    },
    {
      "id": "cases_revision_history",
      "path": "/vrooli.chain_forensics.v1.cases.CasesService/ListCaseRevisions",
      "method": "POST",
      "summary": "List immutable case revision receipts",
      "description": "",
      "category": "cases"
    }
  ]
}
