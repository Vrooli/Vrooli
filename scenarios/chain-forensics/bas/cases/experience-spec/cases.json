{
  "metadata": {
    "name": "experience-cases-spec-smoke",
    "description": "Observer smoke for the persistent forensic case review route.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "cases",
      "surface": "experience-cases"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-cases",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "chain-forensics",
          "scenario_path": "/cases",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open forensic cases" }
      }
    },
    {
      "id": "wait-cases-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.cases",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Forensic cases page visible" }
      }
    }
  ]
}
