{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "api_data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned API data observed in the canonical API data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "vrooli-emulator",
    "displayName": "Vrooli Emulator",
    "description": "Virtual display + session management for scenario validation",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/vrooli-emulator"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "cli": {
    "enabled": true,
    "command": "vrooli-emulator",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "vrooli-emulator"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    }
  },
  "dependencies": {
    "resources": {}
  },
  "hostTools": [
    {
      "name": "Xvfb",
      "required": true,
      "reason": "Provide the virtual X display that backs every emulator session",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ],
      "notes": "Native runtime handler provisions the Linux virtual display dependency when absent"
    },
    {
      "name": "x11vnc",
      "required": false,
      "reason": "Expose interactive sessions over VNC; not needed for headless sessions",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "websockify",
      "required": false,
      "reason": "Bridge the VNC port to a browser WebSocket endpoint",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "openbox",
      "required": false,
      "reason": "Provide a lightweight window manager inside the virtual display",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "xdotool",
      "required": true,
      "reason": "Detect visible X11 windows for the process monitor",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "ffmpeg",
      "required": true,
      "reason": "Capture X11 desktop frames for emulator screenshots and visual evidence",
      "when": [
        "setup",
        "develop",
        "test"
      ],
      "platforms": [
        "linux"
      ]
    }
  ],
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
