{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {"entries":{"api_data":{"rung":"owned","path":"api/data","kind":"dir","class":"data","regenerable":false,"rationale":"Scenario-owned API data observed in the canonical API data directory."}},"rationale":"Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."},
  "service": {
    "parent": "vrooli",
    "name": "vrooli-emulator",
    "displayName": "Vrooli Emulator",
    "description": "Virtual display + session management for scenario validation",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/vrooli-emulator"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "cli": {
    "enabled": true,
    "command": "vrooli-emulator",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "vrooli-emulator"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/vrooli-emulator-api"
            ]
          },
          {
            "type": "cli",
            "command": "vrooli-emulator"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o vrooli-emulator-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./vrooli-emulator-api",
          "background": true,
          "description": "Start Go API server in background",
          "condition": {
            "file_exists": "api/vrooli-emulator-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "run-tests",
          "run": "test-genie execute vrooli-emulator --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'vrooli-emulator-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {}
  },
  "hostTools": [
    {
      "name": "Xvfb",
      "required": true,
      "reason": "Provide the virtual X display that backs every emulator session",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ],
      "notes": "Native runtime handler provisions the Linux virtual display dependency when absent"
    },
    {
      "name": "x11vnc",
      "required": false,
      "reason": "Expose interactive sessions over VNC; not needed for headless sessions",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "websockify",
      "required": false,
      "reason": "Bridge the VNC port to a browser WebSocket endpoint",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "openbox",
      "required": false,
      "reason": "Provide a lightweight window manager inside the virtual display",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "xdotool",
      "required": true,
      "reason": "Detect visible X11 windows for the process monitor",
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ]
    },
    {
      "name": "ffmpeg",
      "required": true,
      "reason": "Capture X11 desktop frames for emulator screenshots and visual evidence",
      "when": [
        "setup",
        "develop",
        "test"
      ],
      "platforms": [
        "linux"
      ]
    }
  ]
}
