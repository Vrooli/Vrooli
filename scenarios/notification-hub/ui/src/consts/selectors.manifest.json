  "dynamicSelectors": {
    "layout.navLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]",
      "testIdPattern": "layout-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "asks",
            "history",
            "settings"
          ]
        }
      ]
    },
    "layout.visibleNavLink": {
      "description": "Visible primary destination in the sidebar or the bottom tab bar",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]:visible, [data-testid=\"layout-nav-link-${key}-tab\"]:visible",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "asks",
            "history",
            "settings"
          ]
        }
      ]
    },
    "delivery.recordDetailsLink": {
      "description": "Delivery detail link for one notification record ID",
      "selectorPattern": "[data-testid=\"delivery-record-${id}-details\"]",
      "testIdPattern": "delivery-record-${id}-details",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "updates.tab": {
      "description": "Updates or Delivery tab in the Updates section switcher",
      "selectorPattern": "[data-testid=\"updates-tab-${id}\"]",
      "testIdPattern": "updates-tab-${id}",
      "params": [
        {
          "name": "id",
          "type": "enum",
          "values": [
            "updates",
            "delivery"
          ]
        }
      ]
    },
    "asks.urgencyChip": {
      "description": "Urgency filter chip in the decision filter sheet",
      "selectorPattern": "[data-testid=\"asks-filter-urgency-${urgency}\"]",
      "testIdPattern": "asks-filter-urgency-${urgency}",
      "params": [
        {
          "name": "urgency",
          "type": "enum",
          "values": [
            "critical",
            "high",
            "normal",
            "low"
          ]
        }
      ]
    },
    "history.row": {
      "description": "One request row in the decision list or History, by request ID",
      "selectorPattern": "[data-request-id=\"${id}\"]",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "history.filterLink": {
      "description": "History filter link by request lifecycle state",
      "selectorPattern": "[data-testid=\"history-filter-${state}\"]",
      "testIdPattern": "history-filter-${state}",
      "params": [
        {
          "name": "state",
          "type": "enum",
          "values": [
            "all",
            "awaiting",
            "answered",
            "defaulted",
            "expired",
            "withdrawn",
            "dismissed"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "settings.row": {
      "description": "Row for one settings screen, in the settings list",
      "selectorPattern": "[data-testid=\"settings-row-${key}\"]",
      "testIdPattern": "settings-row-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "reach",
            "quietHours",
            "escalation",
            "appearance",
            "session",
            "sources"
          ]
        }
      ]
    },
    "settings.source": {
      "description": "Event source group by source scenario id",
      "selectorPattern": "[data-testid=\"notification-source-${scenario}\"]",
      "testIdPattern": "notification-source-${scenario}",
      "params": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    "settings.sourceToggle": {
      "description": "The on/off switch of one event category, by source scenario id and category key",
      "selectorPattern": "[data-testid=\"notification-source-${scenario}-${category}-toggle\"]",
      "testIdPattern": "notification-source-${scenario}-${category}-toggle",
      "params": [
        {
