{
  "metadata": {
    "name": "reach-empty-owner",
    "description": "An owner with no devices sees a plain empty state and can still turn on this browser.",
    "requirement": "NOTIFICA-P0-003",
    "version": "1",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "surface": "reach-empty-owner"
    },
    "execution_mode": "mutating"
  },
  "flow_definition": {
    "metadata": {
      "description": "An owner with no devices sees a plain empty state and can still turn on this browser.",
      "requirement": "NOTIFICA-P0-003",
      "version": "1",
      "execution_mode": "mutating",
      "owner": "notification-hub"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-settings",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Settings so the page can reach the Hub API"
          }
        }
      },
      {
        "id": "seed-empty",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/seed-owner.json",
            "args": {
              "profile": {
                "string_value": "empty"
              }
            }
          },
          "metadata": {
            "label": "Start from an owner with no devices"
          }
        }
      },
      {
        "id": "open-reach",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings/reach?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Devices and channels"
          }
        }
      },
      {
        "id": "wait-root",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/reach.root",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the devices section"
          }
        }
      },
      {
        "id": "assert-empty",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/reach.root",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": {
              "string_value": "No devices yet"
            },
            "timeout_ms": 15000,
            "failure_message": "The empty state is not an error"
          },
          "metadata": {
            "label": "The empty state is not an error"
          }
        }
      },
      {
        "id": "wait-add-browser",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/reach.addBrowser",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Turning on this browser is still offered"
          }
        }
      },
      {
        "id": "zero-insets",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async()=>{const root=document.documentElement;root.style.setProperty('--safe-area-inset-top','0px');root.style.setProperty('--safe-area-inset-bottom','0px');return true;})()"
          },
          "metadata": {
            "label": "Zero the safe-area insets so the capture matches a desktop browser"
          }
        }
      },
      {
        "id": "capture",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": false
          },
          "metadata": {
            "label": "Capture the empty Devices and channels screen"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-00",
        "source": "open-settings",
        "target": "seed-empty",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-01",
        "source": "seed-empty",
        "target": "open-reach",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-02",
        "source": "open-reach",
        "target": "wait-root",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-03",
        "source": "wait-root",
        "target": "assert-empty",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-04",
        "source": "assert-empty",
        "target": "wait-add-browser",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-05",
        "source": "wait-add-browser",
        "target": "zero-insets",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-06",
        "source": "zero-insets",
        "target": "capture",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      }
    ]
  }
}
