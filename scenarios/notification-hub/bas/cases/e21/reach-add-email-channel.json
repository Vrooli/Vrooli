{
  "metadata": {
    "name": "reach-add-email-channel",
    "description": "Add an email destination to a device that has none, and see it listed on the device after a reload.",
    "requirement": "NOTIFICA-P0-005",
    "version": "1",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "surface": "reach-add-email-channel"
    },
    "execution_mode": "mutating"
  },
  "flow_definition": {
    "metadata": {
      "description": "Add an email destination to a device that has none, and see it listed on the device after a reload.",
      "requirement": "NOTIFICA-P0-005",
      "version": "1",
      "execution_mode": "mutating",
      "owner": "notification-hub"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-settings",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Settings so the page can reach the Hub API"
          }
        }
      },
      {
        "id": "seed-reach",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/seed-owner.json",
            "args": {
              "profile": {
                "string_value": "reach"
              }
            }
          },
          "metadata": {
            "label": "Start from two devices with channels"
          }
        }
      },
      {
        "id": "open-tablet",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings/reach/devices/settings-test-tablet?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Spare tablet, which has no email"
          }
        }
      },
      {
        "id": "wait-add-email",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/reach.addEmail",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for Add email"
          }
        }
      },
      {
        "id": "add-email",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/reach.addEmail"
          },
          "metadata": {
            "label": "Add email"
          }
        }
      },
      {
        "id": "set-address",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/reach.emailDestination",
            "value": "tablet@example.test",
            "clear_first": true
          },
          "metadata": {
            "label": "Enter the destination"
          }
        }
      },
      {
        "id": "save",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/reach.channelSave"
          },
          "metadata": {
            "label": "Save"
          }
        }
      },
      {
        "id": "wait-confirm",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/reach.widenDialog",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "A new destination asks first"
          }
        }
      },
      {
        "id": "confirm",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/reach.widenConfirm"
          },
          "metadata": {
            "label": "Confirm the new destination"
          }
        }
      },
      {
        "id": "wait-saved",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/reach.channelSaved",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the saved notice"
          }
        }
      },
      {
        "id": "assert-readback",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async()=>{const call=async(method)=>{const r=await fetch('/vrooli.notification_hub.v1.recipients.RecipientsService/'+method,{method:'POST',headers:{'content-type':'application/json','X-Vrooli-Test-Mode':'1','X-Vrooli-Browser-Session':'1'},credentials:'same-origin',body:'{}'});if(!r.ok)throw new Error(method+' failed '+r.status);return r.json();};const {addresses=[]}=await call('ListChannelAddresses');const row=addresses.find(a=>a.deviceId==='settings-test-tablet'&&a.channel==='email');if(!row||row.address!=='tablet@example.test')throw new Error('email was not stored: '+JSON.stringify(addresses));return row;})()"
          },
          "metadata": {
            "label": "The Hub holds the new email destination"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-00",
        "source": "open-settings",
        "target": "seed-reach",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-01",
        "source": "seed-reach",
        "target": "open-tablet",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-02",
        "source": "open-tablet",
        "target": "wait-add-email",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-03",
        "source": "wait-add-email",
        "target": "add-email",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-04",
        "source": "add-email",
        "target": "set-address",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-05",
        "source": "set-address",
        "target": "save",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-06",
        "source": "save",
        "target": "wait-confirm",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-07",
        "source": "wait-confirm",
        "target": "confirm",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-08",
        "source": "confirm",
        "target": "wait-saved",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-09",
        "source": "wait-saved",
        "target": "assert-readback",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      }
    ]
  }
}
