{
  "edges": [
    {
      "id": "edge-navigate-updates-to-open-delivery-tab",
      "source": "navigate-updates",
      "target": "open-delivery-tab"
    },
    {
      "id": "edge-open-delivery-tab-to-wait-delivery-page",
      "source": "open-delivery-tab",
      "target": "wait-delivery-page"
    },
    {
      "id": "edge-wait-delivery-page-to-wait-delivery-record",
      "source": "wait-delivery-page",
      "target": "wait-delivery-record"
    },
    {
      "id": "edge-wait-delivery-record-to-capture-delivery",
      "source": "wait-delivery-record",
      "target": "capture-delivery"
    }
  ],
  "metadata": {
    "description": "Given the leased disposable recipient, when the owner opens Delivery from Updates at phone width, then the fixture's delivered record is listed and captured.",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true",
      "spec_entry_id": "delivery",
      "surface": "experience-delivery-routed-smoke"
    },
    "name": "experience-delivery-routed-smoke",
    "requirement": "OT-P0-001",
    "version": "2"
  },
  "nodes": [
    {
      "id": "navigate-updates",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-pending-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open routed Updates with the pending-state fixture"
        }
      }
    },
    {
      "id": "open-delivery-tab",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/updates.tab(id=delivery)"
        },
        "metadata": {
          "label": "Switch to the Delivery tab"
        }
      }
    },
    {
      "id": "wait-delivery-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.delivery",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Delivery page visible"
        }
      }
    },
    {
      "id": "wait-delivery-record",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/delivery.recordDetailsLink(id=e4-test-delivered)",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "The delivered record links to its details"
        }
      }
    },
    {
      "id": "capture-delivery",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Capture Delivery at 390 pixel phone width"
        }
      }
    }
  ],
  "settings": {
    "browser_profile": {
      "extra_headers": {
        "X-Vrooli-Test-Mode": "1"
      },
      "fingerprint": {
        "device_scale_factor": 2
      }
    },
    "viewport_height": 844,
    "viewport_width": 390
  }
}
