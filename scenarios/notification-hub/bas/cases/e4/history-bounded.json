          "label": "Reveal the first keyboard skip link with a genuine Tab key"
        }
      }
    },
    {
      "id": "record-nh16-skip-after",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(async () => { await new Promise(resolve=>setTimeout(resolve,350)); const node=document.querySelector('[data-testid=\\\"layout-shell-skip\\\"]'); const rect=node?.getBoundingClientRect(); const style=node?getComputedStyle(node):null; const sameNodeFocused=!!node&&window.__nh16SkipRef===node&&document.activeElement===node; const focusVisible=node?.matches(':focus-visible')??false; const visible=!!rect&&rect.top>=0&&rect.bottom<=innerHeight; if(!sameNodeFocused||!focusVisible||!visible) throw new Error('skip link did not reveal the same focused node inside the viewport'); return {sameNodeFocused,activeTestId:document.activeElement?.getAttribute('data-testid')??null,focusVisible,visible,transform:style?.transform??null,rect:rect?{x:rect.x,y:rect.y,width:rect.width,height:rect.height}:null,viewport:{width:innerWidth,height:innerHeight}}; })()",
          "store_result": "nh16SkipAfter"
        },
        "metadata": {
          "label": "Measure same-node focus-visible reveal after Tab"
        }
      }
    },
