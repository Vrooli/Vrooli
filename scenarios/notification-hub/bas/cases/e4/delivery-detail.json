{
  "metadata": {
    "name": "e4-delivery-detail-receipt",
    "description": "Given the leased disposable recipient fixture on a phone, when the owner uses the destination drawer, then Delivery details distinguish state, adapter receipts and unavailable evidence.",
    "requirement": "OT-P0-001",
    "version": "2",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "surface": "delivery-detail"
    },
    "execution_mode": "mutating"
  },
  "settings": {
    "viewport_width": 390,
    "viewport_height": 844
  },
  "nodes": [
    {
      "id": "open-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/settings?view=all&vrooli_test_mode=1",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open routed Settings to apply the light theme"
        }
      }
    },
    {
      "id": "return-to-updates-after-theme",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-pending-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Return to Updates and select the leased Pending record for this journey"
        }
      }
    },
    {
      "id": "open-menu-for-open-delivery",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.menu"
        },
        "metadata": {
          "label": "Open the mobile destination drawer"
        }
      }
    },
    {
      "id": "open-delivery",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.navLink(key=delivery)"
        },
        "metadata": {
          "label": "Open Delivery through mobile primary navigation"
        }
      }
    },
    {
      "id": "wait-for-fixture",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "E4 delivery receipt fixture"
          },
          "timeout_ms": 15000,
          "failure_message": "Expected the disposable delivery record in the recipient list"
        },
        "metadata": {
          "label": "Delivery fixture is visible"
        }
      }
    },
    {
      "id": "assert-state-pending",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Pending"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Pending"
        },
        "metadata": {
          "label": "Recognized delivery state Pending"
        }
      }
    },
    {
      "id": "assert-state-held",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Held"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Held"
        },
        "metadata": {
          "label": "Recognized delivery state Held"
        }
      }
    },
    {
      "id": "assert-state-routed",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Routed"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Routed"
        },
        "metadata": {
          "label": "Recognized delivery state Routed"
        }
      }
    },
    {
      "id": "assert-state-delivered",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Delivered"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Delivered"
        },
        "metadata": {
          "label": "Recognized delivery state Delivered"
        }
      }
    },
    {
      "id": "assert-state-failed",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Failed"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Failed"
        },
        "metadata": {
          "label": "Recognized delivery state Failed"
        }
      }
    },
    {
      "id": "assert-state-unroutable",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Unroutable"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Unroutable"
        },
        "metadata": {
          "label": "Recognized delivery state Unroutable"
        }
      }
    },
    {
      "id": "assert-state-suppressed",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Suppressed"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected recognized delivery state Suppressed"
        },
        "metadata": {
          "label": "Recognized delivery state Suppressed"
        }
      }
    },
    {
      "id": "scroll-delivery-states-bottom",
      "action": {
        "type": "ACTION_TYPE_SCROLL",
        "scroll": {
          "behavior": "SCROLL_BEHAVIOR_AUTO",
          "selector": "@selector/layout.main",
          "y": 40
        },
        "metadata": {
          "label": "Capture the lower state guide viewport"
        }
      }
    },
    {
      "id": "assert-lower-states",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Suppressed"
          },
          "timeout_ms": 10000,
          "failure_message": "Expected the lower transport states to remain visible after scrolling"
        },
        "metadata": {
          "label": "Lower delivery state meanings remain reachable"
        }
      }
    },
    {
      "id": "open-delivery-details",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=e4-test-delivered)"
        },
        "metadata": {
          "label": "Open selected delivery details"
        }
      }
    },
    {
      "id": "assert-state-and-receipt",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Adapter accepted"
          },
          "timeout_ms": 15000,
          "failure_message": "Expected the detail to distinguish current state from adapter receipt"
        },
        "metadata": {
          "label": "Adapter receipt is shown"
        }
      }
    },
    {
      "id": "open-menu-for-return-delivery-no-receipt",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.menu"
        },
        "metadata": {
          "label": "Open the mobile destination drawer"
        }
      }
    },
    {
      "id": "return-delivery-no-receipt",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.navLink(key=delivery)"
        },
        "metadata": {
          "label": "Return to the Delivery list"
        }
      }
    },
    {
      "id": "open-no-receipt",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=DEMO-N043)"
        },
        "metadata": {
          "label": "Open a record without an adapter receipt"
        }
      }
    },
    {
      "id": "assert-no-receipt",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "No receipt does not mean unread, offline or a failed answer."
          },
          "timeout_ms": 15000,
          "failure_message": "Missing receipt keeps reach unknown"
        },
        "metadata": {
          "label": "Missing receipt keeps reach unknown"
        }
      }
    },
    {
      "id": "open-menu-for-return-delivery-unknown",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.menu"
        },
        "metadata": {
          "label": "Open the mobile destination drawer"
        }
      }
    },
    {
      "id": "return-delivery-unknown",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-unknown-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Select the leased unknown-state fixture from Updates"
        }
      }
    },
    {
      "id": "open-menu-for-unknown-delivery",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.menu"
        },
        "metadata": {
          "label": "Open destination drawer after selecting unknown state"
        }
      }
    },
    {
      "id": "navigate-to-unknown-delivery",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/layout.navLink(key=delivery)"
        },
        "metadata": {
          "label": "Open Delivery with the leased unknown state"
        }
      }
    },
    {
      "id": "open-unknown",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=DEMO-N043)"
        },
        "metadata": {
          "label": "Open an unrecognized delivery status"
        }
      }
    },
    {
      "id": "assert-unknown",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "The returned state isn\u2019t recognized"
          },
          "timeout_ms": 15000,
          "failure_message": "Unknown delivery values remain explicit"
        },
        "metadata": {
          "label": "Unknown delivery values remain explicit"
        }
      }
    },
    {
      "id": "set-light",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/settingsPage.themeOption(choice=light)"
        },
        "metadata": {
          "label": "Choose light with the registered Settings theme control"
        }
      }
    },
    {
      "id": "assert-no-success-from-unknown",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "No delivery success is assumed"
          },
          "timeout_ms": 15000,
          "failure_message": "An unrecognized delivery state must not imply delivery success"
        },
        "metadata": {
          "label": "Unrecognized state does not imply success"
        }
      }
    },
    {
      "id": "set-selected-capture-safe-area",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(()=>{const root=document.documentElement;root.style.setProperty('--safe-area-inset-top','0px');root.style.setProperty('--safe-area-inset-bottom','0px');const top=getComputedStyle(root).getPropertyValue('--safe-area-inset-top').trim(),bottom=getComputedStyle(root).getPropertyValue('--safe-area-inset-bottom').trim();if(top!=='0px'||bottom!=='0px')throw new Error('Selected artwork comparison requires the zero-inset phone viewport');return {top,bottom,viewport:{width:innerWidth,height:innerHeight}}})()",
          "store_result": "selectedCaptureSafeArea"
        },
        "metadata": {
          "label": "Match the selected phone artwork\u2019s zero-inset viewport while retaining separate nonzero-inset shell coverage"
        }
      }
    },
    {
      "id": "set-unknown-capture-safe-area",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(()=>{const root=document.documentElement;root.style.setProperty('--safe-area-inset-top','0px');root.style.setProperty('--safe-area-inset-bottom','0px');const top=getComputedStyle(root).getPropertyValue('--safe-area-inset-top').trim(),bottom=getComputedStyle(root).getPropertyValue('--safe-area-inset-bottom').trim();if(top!=='0px'||bottom!=='0px')throw new Error('Selected artwork comparison requires the zero-inset phone viewport');return {top,bottom,viewport:{width:innerWidth,height:innerHeight}}})()",
          "store_result": "unknownCaptureSafeArea"
        },
        "metadata": {
          "label": "Reapply the selected artwork\u2019s zero-inset viewport after the direct unknown-state navigation"
        }
      }
    }
  ],
