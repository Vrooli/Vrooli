  "metadata": {
    "description": "Given the leased disposable recipient, when the owner opens delivery records, then a receipt reads as adapter acceptance only, a missing receipt does not read as unread or failed, and an unrecognized state assumes no success.",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true",
      "spec_entry_id": "delivery-detail",
      "surface": "e4-delivery-record"
    },
    "name": "e4-delivery-record",
    "requirement": "OT-P0-001",
    "version": "3"
  },
  "nodes": [
    {
      "id": "navigate-updates",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-pending-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open routed Updates with the pending-state fixture"
        }
      }
    },
    {
      "id": "open-delivery-tab",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/updates.tab(id=delivery)"
        },
        "metadata": {
          "label": "Switch to the Delivery tab"
        }
      }
    },
    {
      "id": "assert-list-fixture",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "E4 delivery receipt fixture"
          },
          "timeout_ms": 15000,
          "failure_message": "The fixture record is listed"
        },
        "metadata": {
          "label": "The fixture record is listed"
        }
      }
    },
    {
      "id": "open-delivered",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=e4-test-delivered)"
        },
        "metadata": {
          "label": "Open the record with a receipt"
        }
      }
    },
    {
      "id": "assert-receipts",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Adapter receipts"
          },
          "timeout_ms": 15000,
          "failure_message": "The adapter receipt is shown"
        },
        "metadata": {
          "label": "The adapter receipt is shown"
        }
      }
    },
    {
      "id": "assert-receipt-scope",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "A returned receipt records adapter acceptance. It does not establish device arrival or human reading."
          },
          "timeout_ms": 15000,
          "failure_message": "A receipt is not device arrival or reading"
        },
        "metadata": {
          "label": "A receipt is not device arrival or reading"
        }
      }
    },
    {
      "id": "return-delivery",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-pending-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Return with the pending-state fixture"
        }
      }
    },
    {
      "id": "open-delivery-tab-again",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/updates.tab(id=delivery)"
        },
        "metadata": {
          "label": "Switch to the Delivery tab"
        }
      }
    },
    {
      "id": "open-no-receipt",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=DEMO-N043)"
        },
        "metadata": {
          "label": "Open the record with no receipt"
        }
      }
    },
    {
      "id": "assert-no-receipt",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "No receipt doesn’t mean unread, offline or unanswered."
          },
          "timeout_ms": 15000,
          "failure_message": "No receipt is not read as unread, offline or unanswered"
        },
        "metadata": {
          "label": "No receipt is not read as unread, offline or unanswered"
        }
      }
    },
    {
      "id": "select-unknown",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-unknown-state",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open routed Updates with the unknown-state fixture"
        }
      }
    },
    {
      "id": "open-delivery-tab-unknown",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/updates.tab(id=delivery)"
        },
        "metadata": {
          "label": "Switch to the Delivery tab"
        }
      }
    },
    {
      "id": "open-unknown",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.recordDetailsLink(id=DEMO-N043)"
        },
        "metadata": {
          "label": "Open the record with an unrecognized state"
        }
      }
    },
    {
      "id": "assert-unknown-heading",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "The returned state isn’t recognized"
          },
          "timeout_ms": 15000,
          "failure_message": "The unrecognized state is named"
        },
        "metadata": {
          "label": "The unrecognized state is named"
        }
      }
    },
    {
      "id": "assert-no-success-assumed",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.deliveryDetail",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "No delivery success is assumed."
          },
          "timeout_ms": 15000,
          "failure_message": "No delivery success is assumed"
        },
        "metadata": {
          "label": "No delivery success is assumed"
        }
      }
    },
    {
      "id": "capture-unknown",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Capture the unrecognized state at 390 pixel phone width"
        }
      }
    }
  ],
  "settings": {
    "browser_profile": {
      "extra_headers": {
        "X-Vrooli-Test-Mode": "1"
      },
      "fingerprint": {
        "device_scale_factor": 2
      }
    },
    "viewport_height": 844,
    "viewport_width": 390
  }
