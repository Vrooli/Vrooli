{
  "edges": [
    {
      "id": "edge-navigate-updates-to-open-delivery-tab",
      "source": "navigate-updates",
      "target": "open-delivery-tab"
    },
    {
      "id": "edge-open-delivery-tab-to-wait-retry",
      "source": "open-delivery-tab",
      "target": "wait-retry"
    },
    {
      "id": "edge-wait-retry-to-assert-metrics-failure",
      "source": "wait-retry",
      "target": "assert-metrics-failure"
    },
    {
      "id": "edge-assert-metrics-failure-to-assert-records-readable",
      "source": "assert-metrics-failure",
      "target": "assert-records-readable"
    },
    {
      "id": "edge-assert-records-readable-to-capture-analytics-failure",
      "source": "assert-records-readable",
      "target": "capture-analytics-failure"
    },
    {
      "id": "edge-capture-analytics-failure-to-retry-metrics",
      "source": "capture-analytics-failure",
      "target": "retry-metrics"
    },
    {
      "id": "edge-retry-metrics-to-assert-metrics-restored",
      "source": "retry-metrics",
      "target": "assert-metrics-restored"
    }
  ],
  "metadata": {
    "description": "Given the leased disposable recipient whose channel metrics fail once, when the owner opens Delivery, then the records stay readable, the failure offers a retry, and the retry restores the metrics.",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "reset": "none",
      "routed_isolation": "true",
      "spec_entry_id": "delivery",
      "surface": "e4-delivery-analytics-failure"
    },
    "name": "e4-delivery-analytics-failure",
    "requirement": "OT-P0-001",
    "version": "3"
  },
  "nodes": [
    {
      "id": "navigate-updates",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "notification-hub",
          "scenario_path": "/updates?vrooli_test_mode=1&e4_fixture=delivery-analytics-read-failure",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open routed Updates with the analytics failure fixture"
        }
      }
    },
    {
      "id": "open-delivery-tab",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/updates.tab(id=delivery)"
        },
        "metadata": {
          "label": "Switch to the Delivery tab"
        }
      }
    },
    {
      "id": "wait-retry",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/delivery.analyticsRetry",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "A retry is offered for the metrics"
        }
      }
    },
    {
      "id": "assert-metrics-failure",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Couldn’t load channel reliability."
          },
          "timeout_ms": 15000,
          "failure_message": "The metrics failure is named"
        },
        "metadata": {
          "label": "The metrics failure is named"
        }
      }
    },
    {
      "id": "assert-records-readable",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "E4 delivery receipt fixture"
          },
          "timeout_ms": 15000,
          "failure_message": "Individual records stay readable"
        },
        "metadata": {
          "label": "Individual records stay readable"
        }
      }
    },
    {
      "id": "capture-analytics-failure",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": false
        },
        "metadata": {
          "label": "Capture the independent failure at 390 pixel phone width"
        }
      }
    },
    {
      "id": "retry-metrics",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/delivery.analyticsRetry"
        },
        "metadata": {
          "label": "Retry the metrics"
        }
      }
    },
    {
      "id": "assert-metrics-restored",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.delivery",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": {
            "string_value": "Since"
          },
          "timeout_ms": 15000,
          "failure_message": "The retry restores the channel metrics"
        },
        "metadata": {
          "label": "The retry restores the channel metrics"
        }
      }
    }
  ],
  "settings": {
    "browser_profile": {
      "extra_headers": {
        "X-Vrooli-Test-Mode": "1"
      },
      "fingerprint": {
        "device_scale_factor": 2
      }
    },
    "viewport_height": 844,
    "viewport_width": 390
  }
}
