{
  "metadata": {
    "name": "e22-quiet-japanese-editor-dark-phone",
    "description": "Capture the selected Japanese Monday quiet-hours editor on dark phone through the lease-pinned owner fixture.",
    "requirement": "NOTIFICA-P0-005",
    "version": "1",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "surface": "settings-e22-quiet-japanese-editor-dark-phone"
    },
    "execution_mode": "mutating"
  },
  "flow_definition": {
    "metadata": {
      "description": "Capture the selected Japanese Monday quiet-hours editor on dark phone through the lease-pinned owner fixture.",
      "requirement": "NOTIFICA-P0-005",
      "version": "1",
      "execution_mode": "mutating",
      "owner": "notification-hub",
      "name": "e22-quiet-japanese-editor-dark-phone"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-settings",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings?vrooli_test_mode=1&e22_fixture=settings-owner&e22_case=e22-quiet-japanese-editor-dark-phone",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
          },
          "metadata": {
            "label": "Open Settings in the leased owner fixture"
          }
        }
      },
      {
        "id": "wait-settings",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.root",
            "state": "WAIT_STATE_VISIBLE"
          },
          "metadata": {
            "label": "Wait for the routed quiet-hours editor"
          }
        }
      },
      {
        "id": "select-theme",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/settingsPage.themeOption(choice=dark)"
          },
          "metadata": {
            "label": "Set dark appearance for exact selected-state capture"
          }
        }
      },
      {
        "id": "select-japanese-locale",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/settingsPage.localeOption(code=ja)"
          },
          "metadata": {
            "label": "Select Japanese before opening the saved Monday editor"
          }
        }
      },
      {
        "id": "open-monday-editor",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.editDay(day=1)"
          },
          "metadata": {
            "label": "Open the saved Monday quiet-window editor"
          }
        }
      },
      {
        "id": "set-monday-start",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/quietHours.dayStart(day=1)",
            "value": "13:00",
            "clear_first": true
          },
          "metadata": {
            "label": "Set Monday start time to 13:00"
          }
        }
      },
      {
        "id": "set-monday-end",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/quietHours.dayEnd(day=1)",
            "value": "14:00",
            "clear_first": true
          },
          "metadata": {
            "label": "Set Monday end time to 14:00"
          }
        }
      },
      {
        "id": "set-monday-timezone",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/quietHours.dayTimezone(day=1)",
            "value": "Etc/UTC",
            "clear_first": true
          },
          "metadata": {
            "label": "Keep Monday wall-clock time in the selected Etc/UTC zone"
          }
        }
      },
      {
        "id": "stage-monday-edit",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.doneDay(day=1)"
          },
          "metadata": {
            "label": "Stage the Monday edit for review"
          }
        }
      },
      {
        "id": "review-monday-change",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.reviewButton"
          },
          "metadata": {
            "label": "Review the named Monday change before saving"
          }
        }
      },
      {
        "id": "save-monday-change",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.saveButton"
          },
          "metadata": {
            "label": "Persist the reviewed Monday fixture value"
          }
        }
      },
      {
        "id": "assert-monday-saved",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/quietHours.root",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": {
              "string_value": "\u5909\u66f4\u3057\u305f\u66dc\u65e5\u3092\u6700\u65b0\u306e\u8aad\u307f\u53d6\u308a\u3067\u78ba\u8a8d\u3057\u307e\u3057\u305f"
            },
            "timeout_ms": 10000,
            "failure_message": "Monday quiet-hours write is confirmed by readback before the visual capture"
          },
          "metadata": {
            "label": "Confirm the saved Monday change from the latest owner read in Japanese"
          }
        }
      },
      {
        "id": "reload-settings",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings?vrooli_test_mode=1&e22_fixture=settings-owner&e22_case=e22-quiet-japanese-editor-dark-phone",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
          },
          "metadata": {
            "label": "Reload Settings using the same lease-pinned fixture"
          }
        }
      },
      {
        "id": "wait-reloaded-settings",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.root",
            "state": "WAIT_STATE_VISIBLE"
          },
          "metadata": {
            "label": "Wait for authoritative quiet-hours read after refresh"
          }
        }
      },
      {
        "id": "open-saved-monday-editor",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.editDay(day=1)"
          },
          "metadata": {
            "label": "Reopen the persisted Monday quiet-window editor"
          }
        }
      },
      {
        "id": "assert-saved-monday-values",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(()=>{const start=document.querySelector('[data-testid=\"quiet-hours-start-1\"]')?.value;const end=document.querySelector('[data-testid=\"quiet-hours-end-1\"]')?.value;const zone=document.querySelector('[data-testid=\"quiet-hours-timezone-1\"]')?.value;const override=document.querySelector('[data-testid=\"quiet-hours-editor-1\"] input[type=checkbox]')?.checked;if(start!=='13:00'||end!=='14:00'||zone!=='Etc/UTC'||override!==false)throw new Error(`saved Monday editor mismatch start=${start} end=${end} zone=${zone} override=${override}`);return {start,end,zone,override}})()"
          },
          "metadata": {
            "label": "Verify saved 13:00\u201314:00 Etc/UTC values and critical override off"
          }
        }
      },
      {
        "id": "set-selected-capture-safe-area",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(()=>{const root=document.documentElement;root.style.setProperty('--safe-area-inset-top','0px');root.style.setProperty('--safe-area-inset-bottom','0px');const top=getComputedStyle(root).getPropertyValue('--safe-area-inset-top').trim(),bottom=getComputedStyle(root).getPropertyValue('--safe-area-inset-bottom').trim();if(top!=='0px'||bottom!=='0px')throw new Error(`selected capture requires zero insets, got ${top}/${bottom}`);return {top,bottom,viewport:{width:innerWidth,height:innerHeight}}})()",
            "store_result": "selectedCaptureSafeArea"
          },
          "metadata": {
            "label": "Match selected artwork zero-inset viewport; safe-area behavior is qualified separately"
          }
        }
      },
      {
        "id": "capture-monday-editor",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": false
          },
          "metadata": {
            "label": "Capture selected Japanese dark phone state at 390 by 844 CSS pixels"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e22-monday-desktop-00",
        "source": "open-settings",
        "target": "wait-settings",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-01",
        "source": "wait-settings",
        "target": "select-theme",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-02",
        "source": "select-theme",
        "target": "select-japanese-locale",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-japanese-dark-locale-to-editor",
        "source": "select-japanese-locale",
        "target": "open-monday-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-03",
        "source": "open-monday-editor",
        "target": "set-monday-start",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-04",
        "source": "set-monday-start",
        "target": "set-monday-end",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-05",
        "source": "set-monday-end",
        "target": "set-monday-timezone",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-06",
        "source": "set-monday-timezone",
        "target": "stage-monday-edit",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-07",
        "source": "stage-monday-edit",
        "target": "review-monday-change",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-08",
        "source": "review-monday-change",
        "target": "save-monday-change",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-09",
        "source": "save-monday-change",
        "target": "assert-monday-saved",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-10",
        "source": "assert-monday-saved",
        "target": "reload-settings",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-11",
        "source": "reload-settings",
        "target": "wait-reloaded-settings",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-12",
        "source": "wait-reloaded-settings",
        "target": "open-saved-monday-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-13",
        "source": "open-saved-monday-editor",
        "target": "assert-saved-monday-values",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "e22-monday-desktop-14",
        "source": "assert-saved-monday-values",
        "target": "set-selected-capture-safe-area",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "quiet-zero-inset-to-capture",
        "source": "set-selected-capture-safe-area",
        "target": "capture-monday-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      }
    ]
  }
}
