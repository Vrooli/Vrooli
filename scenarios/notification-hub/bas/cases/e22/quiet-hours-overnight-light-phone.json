{
  "metadata": {
    "name": "quiet-hours-overnight-light-phone",
    "description": "Add overnight quiet hours for the weekdays, read them back from the Hub, edit nothing else, then remove them.",
    "requirement": "NOTIFICA-P0-005",
    "version": "1",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "requires_confirmation": "true",
      "surface": "settings-quiet-hours-overnight-light-phone"
    },
    "execution_mode": "mutating"
  },
  "flow_definition": {
    "metadata": {
      "description": "Add overnight quiet hours for the weekdays, read them back from the Hub, edit nothing else, then remove them.",
      "requirement": "NOTIFICA-P0-005",
      "version": "1",
      "execution_mode": "mutating",
      "owner": "notification-hub"
    },
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-appearance",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings/appearance?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Appearance to set the theme"
          }
        }
      },
      {
        "id": "wait-appearance",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/settingsPage.themeOption(choice=light)",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the theme choices"
          }
        }
      },
      {
        "id": "choose-theme",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/settingsPage.themeOption(choice=light)"
          },
          "metadata": {
            "label": "Choose light appearance"
          }
        }
      },
      {
        "id": "seed-empty",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/seed-owner.json",
            "args": {
              "profile": {
                "string_value": "empty"
              }
            }
          },
          "metadata": {
            "label": "Start from an owner with no quiet hours"
          }
        }
      },
      {
        "id": "open-quiet",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "notification-hub",
            "scenario_path": "/settings/quiet-hours?vrooli_test_mode=1",
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "timeout_ms": 30000
          },
          "metadata": {
            "label": "Open Quiet hours"
          }
        }
      },
      {
        "id": "wait-add",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.add",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for Add quiet hours"
          }
        }
      },
      {
        "id": "open-editor",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.add"
          },
          "metadata": {
            "label": "Open the editor"
          }
        }
      },
      {
        "id": "wait-editor",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.editor",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the editor sheet"
          }
        }
      },
      {
        "id": "set-start",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/quietHours.start",
            "value": "22:00",
            "clear_first": true
          },
          "metadata": {
            "label": "Start at 22:00"
          }
        }
      },
      {
        "id": "set-end",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/quietHours.end",
            "value": "07:00",
            "clear_first": true
          },
          "metadata": {
            "label": "End at 07:00 the next morning"
          }
        }
      },
      {
        "id": "wait-overnight-note",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.overnight",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "The editor explains that the hours end the next morning"
          }
        }
      },
      {
        "id": "zero-insets-editor",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async()=>{const root=document.documentElement;root.style.setProperty('--safe-area-inset-top','0px');root.style.setProperty('--safe-area-inset-bottom','0px');return true;})()"
          },
          "metadata": {
            "label": "Zero the safe-area insets so the capture matches a desktop browser"
          }
        }
      },
      {
        "id": "capture-editor",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": false
          },
          "metadata": {
            "label": "Capture the light overnight editor on a phone"
          }
        }
      },
      {
        "id": "save",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.save"
          },
          "metadata": {
            "label": "Save the schedule"
          }
        }
      },
      {
        "id": "wait-saved",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.message",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the saved notice"
          }
        }
      },
      {
        "id": "assert-summary",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/quietHours.schedule(day=1)",
            "mode": "ASSERTION_MODE_TEXT_CONTAINS",
            "expected": {
              "string_value": "Weekdays"
            },
            "timeout_ms": 15000,
            "failure_message": "The saved schedule reads as Weekdays"
          },
          "metadata": {
            "label": "The saved schedule reads as Weekdays"
          }
        }
      },
      {
        "id": "assert-readback",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async()=>{const call=async(method)=>{const r=await fetch('/vrooli.notification_hub.v1.recipients.RecipientsService/'+method,{method:'POST',headers:{'content-type':'application/json','X-Vrooli-Test-Mode':'1','X-Vrooli-Browser-Session':'1'},credentials:'same-origin',body:'{}'});if(!r.ok)throw new Error(method+' failed '+r.status);return r.json();};const {windows=[]}=await call('ListQuietWindows');const days=windows.map(w=>w.weekday).sort();const ok=windows.length===5&&windows.every(w=>w.start==='22:00'&&w.end==='07:00');if(!ok)throw new Error('quiet hours were not stored as overnight weekdays: '+JSON.stringify(windows));return {days};})()"
          },
          "metadata": {
            "label": "The Hub holds five overnight windows, Monday to Friday"
          }
        }
      },
      {
        "id": "reopen",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.schedule(day=1)"
          },
          "metadata": {
            "label": "Open the saved schedule"
          }
        }
      },
      {
        "id": "wait-reopened",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.remove",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for Remove"
          }
        }
      },
      {
        "id": "remove",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.remove"
          },
          "metadata": {
            "label": "Remove the schedule"
          }
        }
      },
      {
        "id": "confirm-remove",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/quietHours.removeConfirm"
          },
          "metadata": {
            "label": "Confirm the removal"
          }
        }
      },
      {
        "id": "wait-add-again",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/quietHours.add",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Back on the list"
          }
        }
      },
      {
        "id": "assert-gone",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async()=>{const call=async(method)=>{const r=await fetch('/vrooli.notification_hub.v1.recipients.RecipientsService/'+method,{method:'POST',headers:{'content-type':'application/json','X-Vrooli-Test-Mode':'1','X-Vrooli-Browser-Session':'1'},credentials:'same-origin',body:'{}'});if(!r.ok)throw new Error(method+' failed '+r.status);return r.json();};const {windows=[]}=await call('ListQuietWindows');if(windows.length!==0)throw new Error('quiet hours remain: '+JSON.stringify(windows));return true;})()"
          },
          "metadata": {
            "label": "The Hub holds no quiet hours"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "edge-00",
        "source": "open-appearance",
        "target": "wait-appearance",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-01",
        "source": "wait-appearance",
        "target": "choose-theme",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-02",
        "source": "choose-theme",
        "target": "seed-empty",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-03",
        "source": "seed-empty",
        "target": "open-quiet",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-04",
        "source": "open-quiet",
        "target": "wait-add",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-05",
        "source": "wait-add",
        "target": "open-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-06",
        "source": "open-editor",
        "target": "wait-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-07",
        "source": "wait-editor",
        "target": "set-start",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-08",
        "source": "set-start",
        "target": "set-end",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-09",
        "source": "set-end",
        "target": "wait-overnight-note",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-10",
        "source": "wait-overnight-note",
        "target": "zero-insets-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-11",
        "source": "zero-insets-editor",
        "target": "capture-editor",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-12",
        "source": "capture-editor",
        "target": "save",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-13",
        "source": "save",
        "target": "wait-saved",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-14",
        "source": "wait-saved",
        "target": "assert-summary",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-15",
        "source": "assert-summary",
        "target": "assert-readback",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-16",
        "source": "assert-readback",
        "target": "reopen",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-17",
        "source": "reopen",
        "target": "wait-reopened",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-18",
        "source": "wait-reopened",
        "target": "remove",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-19",
        "source": "remove",
        "target": "confirm-remove",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-20",
        "source": "confirm-remove",
        "target": "wait-add-again",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      },
      {
        "id": "edge-21",
        "source": "wait-add-again",
        "target": "assert-gone",
        "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
      }
    ]
  }
}
