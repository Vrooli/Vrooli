{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "notification-hub",
  "description": "Chimesail — owner notification delivery and decision surface.",
  "groups": [
    {
      "name": "notifications",
      "description": "Accept and inspect notifications.",
      "commands": [
        {
          "name": "send",
          "description": "Accept a notification and return its durable id.",
          "flags": [
            {
              "name": "title"
            },
            {
              "name": "body",
              "required": true
            },
            {
              "name": "urgency",
              "values": [
                "low",
                "normal",
                "high",
                "critical"
              ]
            },
            {
              "name": "sensitivity-label",
              "required": true
            },
            {
              "name": "idempotency-key",
              "required": true
            },
            {
              "name": "dedupe-key"
            },
            {
              "name": "scheduled-at"
            },
            {
              "name": "digest-window-seconds"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotificationsService",
            "method": "Send"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "relay",
          "description": "Accept a bridge-safe base64 notification payload.",
          "flags": [
            {
              "name": "payload-base64",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotificationsService",
            "method": "Relay"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "get",
          "description": "Read a notification and its receipts.",
          "positionals": [
            {
              "name": "id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotificationsService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List the notification timeline.",
          "flags": [
            {
              "name": "limit"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotificationsService",
            "method": "List"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "channels",
      "description": "Inspect delivery channel readiness.",
      "commands": [
        {
          "name": "status",
          "description": "Report channel readiness for this recipient and machine.",
          "flags": [
            {
              "name": "machine-id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RoutingService",
            "method": "ChannelsStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "delivery",
      "description": "Operate durable delivery.",
      "commands": [
        {
          "name": "deliver",
          "description": "Attempt delivery for a durable notification.",
          "positionals": [
            {
              "name": "id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DeliveryService",
            "method": "Deliver"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "timeline",
          "description": "Read delivery history.",
          "binding": {
            "kind": "connect-rpc",
            "service": "DeliveryService",
            "method": "GetTimeline"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "analytics",
          "description": "Report delivery counts, failures, and latency.",
          "flags": [
            {
              "name": "since"
            },
            {
              "name": "until"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "DeliveryService",
            "method": "GetAnalytics"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "conversations",
      "description": "Ask, answer, dismiss, or withdraw operator decisions. Before writing a decision, read the writing guide: prompt-manager skill read notification-hub",
      "commands": [
        {
          "name": "ask",
          "description": "Ask the operator a question and persist its deadline. The operator reads it cold on a phone: write it by the guide in `prompt-manager skill read notification-hub` (plain question, --big-picture for why it matters, --technical-details for IDs and paths). Direct asks include a free-text Other answer. With --subject-key an ask about an ongoing situation stays one open ask, and you can fix its text in place.",
          "flags": [
            {
              "name": "question",
              "required": true,
              "description": "One plain sentence the operator can answer from the push alone: the choice and what it affects. No internal IDs, codes, or file paths."
            },
            {
              "name": "option",
              "required": true,
              "repeatable": true,
              "description": "An allowed answer as key or key=label; repeat for each answer (at least two). Direct asks also include Other."
            },
            {
              "name": "recommend",
              "description": "The recommended option key; shown first."
            },
            {
              "name": "recommend-reason",
              "description": "One sentence on why the recommendation is best."
            },
            {
              "name": "default",
              "description": "Option key applied if unanswered; needs --reversible. Applies after the deadline and at least 12 h after delivery."
            },
            {
              "name": "reversible",
              "bool": true,
              "description": "The decision can be undone later (required for --default)."
            },
            {
              "name": "urgency",
              "values": [
                "low",
                "normal",
                "high",
                "critical"
              ],
              "description": "Default high; only critical may pass quiet hours."
            },
            {
              "name": "context-url",
              "description": "A web page that opens on the operator's phone. Never a local file path or localhost link; put those in --technical-details."
            },
            {
              "name": "big-picture",
              "description": "Plain sentences for a reader with no context: what this is about, why it matters now, what each answer leads to, and what happens with no answer. At most 4,000 characters."
            },
            {
              "name": "technical-details",
              "description": "Evidence, IDs, commands, and file paths for the agent that acts on the answer. The only place internal names belong. At most 12,000 characters."
            },
            {
              "name": "deadline",
              "required": true,
              "description": "RFC 3339 time or a duration from now such as 24h."
            },
            {
              "name": "sensitivity-label",
              "required": true
            },
            {
              "name": "idempotency-key",
              "required": true
            },
            {
              "name": "subject-key",
              "description": "Names the situation this ask is about, for example disk-pressure. Sending the same key again updates the open ask instead of adding another: identical terms change nothing, new text updates it without a new push, a different answer set replaces it, and an ask the operator dismissed is not reopened by identical terms. 1-128 of A-Z a-z 0-9 . _ : / @ -, starting with a letter or digit."
            },
            {
              "name": "reassert-within",
              "description": "With --subject-key: close the ask if you have not sent it again for this long (a duration from 1m to 720h such as 15m). Send it on that cadence while it is still needed."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "Ask"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "answer",
          "description": "Record an answer to a pending notification question.",
          "flags": [
            {
              "name": "ask-id",
              "required": true
            },
            {
              "name": "answer",
              "required": true
            },
            {
              "name": "note",
              "description": "Optional note, stored verbatim and returned to the requester."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "Answer"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "dismiss",
          "description": "Close an ask without recording an answer; recipient only.",
          "flags": [
            {
              "name": "ask-id",
              "required": true
            },
            {
              "name": "note",
              "description": "Optional reason shown to the requester."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "Dismiss"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "withdraw",
          "description": "Withdraw a direct ask you created, by id or by --subject-key; does not delete its audit record.",
          "flags": [
            {
              "name": "ask-id",
              "description": "The ask to withdraw. Give --ask-id or --subject-key."
            },
            {
              "name": "reason",
              "required": true,
              "description": "Why the ask is no longer applicable."
            },
            {
              "name": "subject-key",
              "description": "Withdraw your open ask for this subject key instead of naming its id."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "Withdraw"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "wait",
          "description": "Wait for an answer or the supplied deadline; the ask stays open when the deadline passes first.",
          "flags": [
            {
              "name": "ask-id",
              "required": true
            },
            {
              "name": "deadline",
              "required": true,
              "description": "RFC 3339 time or a duration from now such as 10m."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "Wait"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "semantics": {
            "kind": "query",
            "blocks": {
              "replaces": [
                "notification-hub conversations get"
              ]
            }
          }
        },
        {
          "name": "get",
          "description": "Read one ask without changing it.",
          "positionals": [
            {
              "name": "ask-id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "GetAsk"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List your asks, newest first.",
          "flags": [
            {
              "name": "open",
              "bool": true,
              "bind": {
                "field": "open_only"
              },
              "description": "Only asks that still wait for an answer."
            },
            {
              "name": "limit",
              "description": "Page size (default 50, maximum 200)."
            },
            {
              "name": "cursor",
              "description": "Opaque continuation for the same filters."
            },
            {
              "name": "query",
              "description": "Literal substring filter including requester identity."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationsService",
            "method": "ListAsks"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "recipients",
      "description": "Manage the authenticated recipient projection, devices, addresses, preferences, and escalation.",
      "commands": [
        {
          "name": "get",
          "description": "Read the authenticated recipient.",
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "GetRecipient"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "push-subscribe",
          "description": "Register a browser push subscription.",
          "flags": [
            {
              "name": "endpoint",
              "required": true
            },
            {
              "name": "p256dh",
              "required": true
            },
            {
              "name": "auth",
              "required": true
            },
            {
              "name": "origin",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "RegisterPushSubscription"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "push-remove",
          "description": "Remove a browser push subscription.",
          "flags": [
            {
              "name": "endpoint",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "RemovePushSubscription"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "device-list",
          "description": "List registered devices.",
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "ListDevices"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "device-upsert",
          "description": "Register or update a device.",
          "flags": [
            {
              "name": "id"
            },
            {
              "name": "name",
              "required": true
            },
            {
              "name": "machine-id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "UpsertDevice"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "device-remove",
          "description": "Remove a device.",
          "positionals": [
            {
              "name": "id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "RemoveDevice"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "address-upsert",
          "description": "Register or update a channel address.",
          "flags": [
            {
              "name": "id"
            },
            {
              "name": "device-id",
              "required": true
            },
            {
              "name": "channel",
              "required": true
            },
            {
              "name": "address",
              "required": true
            },
            {
              "name": "approved-labels"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "UpsertChannelAddress"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "address-remove",
          "description": "Remove a channel address.",
          "positionals": [
            {
              "name": "id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "RemoveChannelAddress"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "quiet-set",
          "description": "Create or replace a quiet window.",
          "flags": [
            {
              "name": "weekday",
              "required": true
            },
            {
              "name": "start",
              "required": true
            },
            {
              "name": "end",
              "required": true
            },
            {
              "name": "timezone",
              "required": true
            },
            {
              "name": "critical-override"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "SetQuietWindow"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "quiet-list",
          "description": "List quiet windows.",
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "ListQuietWindows"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "quiet-delete",
          "description": "Delete a quiet window.",
          "positionals": [
            {
              "name": "id",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "DeleteQuietWindow"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "escalation-set",
          "description": "Set ordered escalation channels.",
          "flags": [
            {
              "name": "channels",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "SetEscalationChain"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "escalation-get",
          "description": "Read ordered escalation channels.",
          "binding": {
            "kind": "connect-rpc",
            "service": "RecipientsService",
            "method": "GetEscalationChain"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "exceptions": [],
  "omitted": [
    {
      "service": "ConversationsService",
      "method": "ListNativeConsents",
      "reason": "Read-only cross-source Needs You projection for the browser. Native permission review and action stay in Agent Manager, not in Hub conversations commands."
    },
    {
      "service": "IdentityService",
      "method": "Login",
      "reason": "Same-origin browser session facade for the installed web app (HttpOnly cookie); the CLI presents its own scenario-authenticator bearer token instead."
    },
    {
      "service": "IdentityService",
      "method": "GetSession",
      "reason": "Same-origin browser session facade for the installed web app (HttpOnly cookie); the CLI presents its own scenario-authenticator bearer token instead."
    },
    {
      "service": "IdentityService",
      "method": "Logout",
      "reason": "Same-origin browser session facade for the installed web app (HttpOnly cookie); the CLI presents its own scenario-authenticator bearer token instead."
    }
  ]
}
