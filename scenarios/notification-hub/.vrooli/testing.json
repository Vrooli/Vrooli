{
  "$schema": "../../../../scenarios/test-genie/schemas/testing.schema.json",
  "_metadata": {
    "description": "Sample testing configuration for React + Vite template",
    "last_updated": "2026-05-03T00:00:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "warning",
        "cli": "warning"
      },
      "unmatched_code_components": "warning"
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "policy_profile": {
      "version": "2.0.0",
      "template": {
        "id": "react-vite",
        "scenario_class": "react-vite"
      },
      "required_roles": [
        {
          "role": "api",
          "policy_class": "go_service",
          "match": {
            "surface_id": "api",
            "kind": "api",
            "path": "api",
            "language": "go"
          }
        },
        {
          "role": "cli",
          "policy_class": "go_cli",
          "match": {
            "surface_id": "cli",
            "kind": "cli",
            "path": "cli",
            "language": "go"
          }
        },
        {
          "role": "ui",
          "policy_class": "react_vite_ui",
          "match": {
            "surface_id": "ui",
            "kind": "ui",
            "path": "ui",
            "language": "typescript",
            "framework": "vitest"
          }
        }
      ],
      "policy_classes": {
        "go_service": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "api/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        },
        "go_cli": {
          "language": "go",
          "framework": "go test",
          "package_manager": "go",
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "test_utils": {
            "required_roots": [
              "cli/internal/testutil"
            ],
            "production_import_ban": true
          },
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "go",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        },
        "react_vite_ui": {
          "language": "typescript",
          "framework": "vitest",
          "package_manager": "pnpm",
          "coverage": {
            "minimum_percent": 85,
            "mode": "both",
            "provider": "v8",
            "reporters": [
              "text",
              "json-summary",
              "json"
            ]
          },
          "test_utils": {
            "required_roots": [
              "ui/src/test-utils"
            ],
            "production_import_ban": true,
            "canonical_render_helper": "ui/src/test-utils/renderWithProviders.tsx"
          },
          "projection": {
            "required_files": [
              "ui/vite.config.ts",
              "ui/src/test-setup.ts",
              "ui/src/test-utils/renderWithProviders.tsx"
            ],
            "required_scripts": [
              "test",
              "test:coverage"
            ],
            "settings": {
              "environment": "jsdom",
              "setup_files": [
                "./src/test-setup.ts"
              ],
              "coverage_provider": "v8"
            }
          },
          "runner_profile": "default",
          "test_kind": "unit",
          "adapter": {
            "id": "react-vitest",
            "version": "1.0.0"
          },
          "hermetic": {
            "network": "allow",
            "filesystem": "workspace",
            "restore_environment": true
          }
        }
      },
      "customization": {
        "mode": "monotonic",
        "waivers": []
      },
      "runner_profiles": {
        "default": {
          "cpu_weight": 1,
          "memory_bytes": 536870912,
          "max_workers": 1,
          "timeout_seconds": 600,
          "no_output_timeout_seconds": 60,
          "sharding": "none",
          "network": "allow",
          "filesystem": "workspace"
        }
      }
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      }
    }
  },
  "performance": {
    "checks": {
      "lighthouse": {
        "enabled": true
      },
      "bundle_size": {
        "enabled": true
      }
    }
  },
  "phases": {
    "tidiness": {
      "budgets": {
        "ratchet": true,
        "duplication_line_debt": 227,
        "baseline_duplication_line_debt": 228,
        "long_files": 0,
        "baseline_long_files": 1,
        "complexity_over_threshold": 16,
        "baseline_complexity_over_threshold": 17,
        "coupling_over_threshold": 0,
        "baseline_coupling_over_threshold": 1,
        "reserve": 1,
        "reserve_reason": "Measured fleet seed reserves one observed unit while successor cleanup earns each stricter budget."
      }
    }
  },
  "workflow": {
    "evidence": {
      "common_inputs": [
        "scenarios/notification-hub/.vrooli/service.json",
        "scenarios/notification-hub/api/main.go",
        "scenarios/notification-hub/api/internal/**",
        "scenarios/notification-hub/api/go.mod",
        "scenarios/notification-hub/api/go.sum",
        "scenarios/notification-hub/ui/package.json",
        "scenarios/notification-hub/ui/pnpm-lock.yaml",
        "scenarios/notification-hub/ui/index.html",
        "scenarios/notification-hub/ui/vite.config.*",
        "scenarios/notification-hub/ui/src/App.tsx",
        "scenarios/notification-hub/ui/src/main.tsx",
        "scenarios/notification-hub/ui/src/app/**",
        "scenarios/notification-hub/ui/src/layout/**",
        "scenarios/notification-hub/ui/src/components/**",
        "scenarios/notification-hub/ui/src/hooks/**",
        "scenarios/notification-hub/ui/src/theme/**",
        "scenarios/notification-hub/ui/src/i18n/**",
        "scenarios/notification-hub/ui/src/consts/**",
        "scenarios/notification-hub/ui/src/api/**",
        "scenarios/notification-hub/ui/src/styles.css",
        "scenarios/notification-hub/ui/src/design-tokens.css",
        "scenarios/notification-hub/ui/src/features/session/**",
        "scenarios/notification-hub/ui/src/features/health/**",
        "scenarios/notification-hub/ui/src/features/routedTestMode.ts",
        "scenarios/notification-hub/ui/public/**",
        "scenarios/notification-hub/docs/concepts/FLOWS.md",
        "packages/proto/schemas/notification-hub/**",
        "packages/proto/gen/typescript/notification-hub/**",
        "packages/proto/gen/go/notification-hub/**",
        "packages/react-component-library/package.json",
        "packages/api-base/src/**",
        "packages/iframe-bridge/src/**",
        "packages/ui-selectors/src/**",
        "scenarios/react-component-library/library/**",
        "scenarios/notification-hub/ui/tsconfig*.json",
        "scenarios/notification-hub/ui/postcss.config.*",
        "scenarios/notification-hub/ui/tailwind.config.*",
        "packages/api-core/**",
        "packages/binaryfetch/**",
        "packages/capability-registry-go/**",
        "packages/cli-core/**",
        "packages/envkit-go/**",
        "packages/platform-go/**",
        "packages/repo-contract-go/**",
        "internal/credentialpolicy/*.go",
        "internal/credentialspec/*.go",
        "internal/fsx/*.go",
        "internal/hostreqspec/*.go",
        "internal/logx/*.go",
        "internal/tuning/*.go",
        "internal/shell/*.go",
        "internal/hostreqkit/*.go",
        "internal/repocontractmeta/*.go",
        "internal/config/*.go",
        "internal/buildflags/*.go",
        "internal/clock/*.go",
        "internal/operatorcapability/*.go",
        "internal/portspec/*.go",
        "internal/process/*.go",
        "internal/scenario/*.go",
        "internal/storagetime/*.go",
        "internal/values/*.go",
        "internal/scenarioruntime/*.go",
        "internal/buildinfo/*.go",
        "internal/network/*.go",
        "internal/hostsession/*.go",
        "internal/workloadowner/*.go",
        "internal/hostinventory/*.go",
        "internal/hostpressure/*.go",
        "internal/setpoint/*.go",
        "internal/capacity/*.go",
        "internal/operatorstate/*.go",
        "internal/storageactivity/*.go",
        "internal/privilegebroker/*.go",
        "internal/securestore/*.go",
        "internal/credentialauthority/*.go",
        "packages/credential-authority-go/*.go"
      ],
      "scopes": [
        {
          "id": "quiet-hours",
          "case_patterns": [
            "bas/cases/e22/quiet-*.json",
            "bas/cases/e22/e22-quiet-*.json"
          ],
          "inputs": [
            "scenarios/notification-hub/ui/src/pages/SettingsPage.tsx",
            "scenarios/notification-hub/ui/src/features/settings/QuietHoursPanel.tsx"
          ]
        },
        {
          "id": "escalation-order",
          "case_patterns": [
            "bas/cases/e22/order-*.json"
          ],
          "inputs": [
            "scenarios/notification-hub/ui/src/pages/SettingsPage.tsx",
            "scenarios/notification-hub/ui/src/features/settings/EscalationOrderPanel.tsx"
          ]
        },
        {
          "id": "settings-integrated",
          "case_patterns": [
            "bas/cases/e22/settings-owner*.json"
          ],
          "inputs": [
            "scenarios/notification-hub/ui/src/pages/SettingsPage.tsx",
            "scenarios/notification-hub/ui/src/features/settings/QuietHoursPanel.tsx",
            "scenarios/notification-hub/ui/src/features/settings/EscalationOrderPanel.tsx"
          ]
        },
        {
          "id": "reach-and-preferences",
          "case_patterns": [
            "bas/cases/e21/*.json",
            "bas/cases/e23/*.json"
          ],
          "inputs": [
            "scenarios/notification-hub/ui/src/pages/SettingsPage.tsx",
            "scenarios/notification-hub/ui/src/features/reach/**",
            "scenarios/notification-hub/ui/src/pages/ReachPage.tsx"
          ]
        }
      ]
    }
  }
}
