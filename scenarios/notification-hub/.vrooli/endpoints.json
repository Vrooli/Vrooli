    {
      "id": "conversations_stat_attachment_blobs",
      "path": "/vrooli.notification_hub.v1.conversations.ConversationsService/StatAttachmentBlobs",
      "method": "POST",
      "summary": "Report which attachment content hashes the Hub does not hold (verified sender)",
      "description": "",
      "category": "conversations"
    },
    {
      "id": "conversations_put_attachment_blob",
      "path": "/vrooli.notification_hub.v1.conversations.ConversationsService/PutAttachmentBlob",
      "method": "POST",
      "summary": "Store one attachment file under its SHA-256 (at most 64 MiB; sender identity is optional)",
      "description": "",
      "category": "conversations"
    },
    {
      "id": "conversations_attachment_content",
      "path": "/api/v1/asks/{ask_id}/attachments/{name}",
      "method": "GET",
      "summary": "Open one attached file of an ask",
      "description": "Streams the Hub's stored copy of an attachment (or ?path= inside a folder attachment) to the ask's recipient, with byte ranges for video and audio. Requires a verified owner identity like Answer (401 without one). Unknown asks, other owners' asks, attachments and paths are all 404.",
      "category": "conversations",
      "rest_exception": {
        "reason": "browser_surface",
        "note": "Raw file bytes with Range support for the Hub's viewer; a Connect procedure cannot stream or seek. Metadata for the same attachments is the proto AskAttachment on GetAsk. Errors are plain-text HTTP statuses (401, 404).",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "none"
          },
          "error": {
            "transport": "none",
            "conformance": "none"
          }
        }
      }
    },
    {
      "id": "conversations_linked_artifact_metadata",
      "path": "/api/v1/asks/{ask_id}/linked-artifact/metadata",
      "method": "GET",
      "summary": "Resolve one decision-linked artifact inside an allowed local root",
      "description": "",
      "category": "conversations",
      "rest_exception": {
        "reason": "browser_surface",
        "note": "The read-only file viewer uses this route for metadata and byte-range content. Both require the verified owner and an ask addressed to that owner. File access is restricted to configured roots and 64 MiB; missing optional roots return 503.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "transport": "none",
            "conformance": "external_shape"
          },
          "error": {
            "transport": "none",
            "conformance": "external_shape"
          }
        }
      }
    },
    {
      "id": "conversations_linked_artifact_content",
      "path": "/api/v1/asks/{ask_id}/linked-artifact/content",
      "method": "GET",
      "summary": "Stream one owner-authorized decision-linked artifact",
      "description": "",
      "category": "conversations",
      "rest_exception": {
        "reason": "browser_surface",
        "note": "The read-only file viewer uses this route for metadata and byte-range content. Both require the verified owner and an ask addressed to that owner. File access is restricted to configured roots and 64 MiB; missing optional roots return 503.",
