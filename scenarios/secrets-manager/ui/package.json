{
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.59.0",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "axe-core": "4.10.2",
    "brace-expansion": "^5.0.9",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1",
    "express": "^5.2.1",
    "flatted": "^3.4.2",
    "http-proxy-middleware": "^3.0.7",
    "lucide-react": "^0.424.0",
    "minimatch": "^10.2.6",
    "picomatch": "^2.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.3.0"
  },
  "description": "React + Vite dashboard for Secrets Manager",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.44",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "name": "secrets-manager-ui",
  "packageManager": "pnpm@9.12.1",
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.6"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build $([ \"$VROOLI_BUILD_MODE\" = profile ] && echo --mode profile)",
    "build:profile": "tsc --noEmit && vite build --mode profile",
    "dev": "vrooli lifecycle protect -- vite",
    "lint": "eslint src --ext ts,tsx",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
