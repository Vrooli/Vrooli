{
  "metadata": {
    "description": "Generated observer smoke for active experience page vault.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "vault",
      "surface": "experience-vault"
    },
    "name": "experience-vault-spec-smoke",
    "requirement": "OT-P1-001",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Vault"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "secrets-manager",
          "scenario_path": "/",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-vault"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/navigation.vault",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-vault-primary-binding"
    },
    {
      "action": {
        "metadata": {
          "label": "Vault collection visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-experience-surface=\"vault-collection\"][data-experience-state=\"ready\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-vault-collection"
    }
  ],
  "edges": [
    {"id": "e1", "source": "navigate-vault", "target": "wait-vault-primary-binding"},
    {"id": "e2", "source": "wait-vault-primary-binding", "target": "wait-vault-collection"}
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
