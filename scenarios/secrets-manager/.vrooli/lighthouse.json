{
  "$schema": "../../../.vrooli/schemas/lighthouse.schema.json",
  "version": "1.0.0",
  "scenario": "secrets-manager",
  "enabled": true,
  "pages": [
    {
      "id": "dashboard",
      "label": "Dashboard",
      "path": "/",
      "description": "Main secrets manager dashboard",
      "thresholds": {
        "performance": {"error": 0.8, "warn": 0.9},
        "accessibility": {"error": 0.9, "warn": 0.95},
        "best-practices": {"error": 0.85, "warn": 0.9},
        "seo": {"error": 0.7, "warn": 0.8},
        "first-contentful-paint": {"error": 2000, "warn": 2500},
        "largest-contentful-paint": {"error": 3000, "warn": 3500},
        "time-to-interactive": {"error": 4000, "warn": 4500},
        "cumulative-layout-shift": {"error": 0.1, "warn": 0.15},
        "total-blocking-time": {"error": 500, "warn": 600}
      }
    }
  ],
  "global_options": {
    "chrome_flags": [
      "--no-sandbox",
      "--headless"
    ]
  }
}
