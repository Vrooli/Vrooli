{
  "$schema": "../../test-genie/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for secrets-manager",
    "last_updated": "2025-11-06T23:58:54-05:00"
  },
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    }
  },
  "unit": {
    "options": {
      "verbose": false
    },
    "policy_profile": {
      "customization": {
        "mode": "monotonic",
        "waivers": []
      },
      "policy_classes": {
        "go_cli": {
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "framework": "go test",
          "language": "go",
          "package_manager": "go",
          "projection": {
            "required_files": [
              "cli/app_test.go",
              "cli/internal/testutil/no_prod_import_test.go"
            ]
          },
          "test_utils": {
            "production_import_ban": true,
            "required_roots": [
              "cli/internal/testutil"
            ]
          }
        },
        "go_service": {
          "coverage": {
            "minimum_percent": 75,
            "mode": "total"
          },
          "framework": "go test",
          "language": "go",
          "package_manager": "go",
          "projection": {
            "required_files": [
              "api/internal/testutil/no_prod_import_test.go"
            ]
          },
          "test_utils": {
            "production_import_ban": true,
            "required_roots": [
              "api/internal/testutil"
            ]
          }
        },
        "react_vite_ui": {
          "coverage": {
            "minimum_percent": 85,
            "mode": "both",
            "provider": "v8",
            "reporters": [
              "text",
              "json-summary",
              "json"
            ]
          },
          "framework": "vitest",
          "language": "typescript",
          "package_manager": "pnpm",
          "projection": {
            "required_files": [
              "ui/vite.config.ts",
              "ui/src/test-setup.ts",
              "ui/src/test-utils/renderWithProviders.tsx"
            ],
            "required_scripts": [
              "test",
              "test:coverage"
            ],
            "vitest": {
              "coverage_provider": "v8",
              "environment": "jsdom",
              "setup_files": [
                "./src/test-setup.ts"
              ]
            }
          },
          "test_utils": {
            "canonical_render_helper": "ui/src/test-utils/renderWithProviders.tsx",
            "production_import_ban": true,
            "required_roots": [
              "ui/src/test-utils"
            ]
          }
        }
      },
      "required_roles": [
        {
          "match": {
            "kind": "api",
            "language": "go",
            "path": "api",
            "surface_id": "api"
          },
          "policy_class": "go_service",
          "role": "api"
        },
        {
          "match": {
            "kind": "cli",
            "language": "go",
            "path": "cli",
            "surface_id": "cli"
          },
          "policy_class": "go_cli",
          "role": "cli"
        },
        {
          "match": {
            "framework": "vite",
            "kind": "ui",
            "language": "typescript",
            "path": "ui",
            "surface_id": "ui"
          },
          "policy_class": "react_vite_ui",
          "role": "ui"
        }
      ],
      "template": {
        "id": "react-vite",
        "scenario_class": "react-vite"
      },
      "version": "1.0.0"
    }
  },
  "version": "1.0.0"
}
