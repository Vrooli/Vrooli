{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "secrets-manager",
  "description": "Typed Secrets Manager broker commands for bounded credential use.",
  "groups": [
    {
      "name": "broker",
      "description": "Grant-bound credential broker operations",
      "commands": [
        {
          "name": "get-access-request",
          "description": "Read the metadata-only status of an access request",
          "flags": [
            {
              "name": "request-id",
              "required": true,
              "description": "Access request identifier"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "GetAccessRequest"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "request-access",
          "description": "Create a metadata-only access request",
          "flags": [
            {
              "name": "grant-id",
              "required": true,
              "description": "Approved grant identifier"
            },
            {
              "name": "item-id",
              "required": true,
              "description": "Vault item identifier"
            },
            {
              "name": "operation",
              "required": true,
              "description": "Bounded operation name"
            },
            {
              "name": "duration-seconds",
              "default": "900",
              "description": "Request lifetime in seconds"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "RequestAccess"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "wait-access-request",
          "description": "Wait for a bounded access-request decision",
          "flags": [
            {
              "name": "request-id",
              "required": true,
              "description": "Access request identifier"
            },
            {
              "name": "timeout-seconds",
              "default": "30",
              "description": "Maximum wait duration in seconds"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "WaitAccessRequest"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create-session",
          "description": "Create a bounded broker capability",
          "flags": [
            {
              "name": "grant-id",
              "required": true,
              "description": "Approved grant identifier"
            },
            {
              "name": "item-id",
              "required": true,
              "description": "Vault item identifier"
            },
            {
              "name": "target-origin",
              "required": true,
              "description": "Pinned consumer origin"
            },
            {
              "name": "allow-internal",
              "bool": true,
              "description": "Allow the explicitly configured internal origin"
            },
            {
              "name": "duration-seconds",
              "default": "900",
              "description": "Session lifetime in seconds"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "CreateBrokerSession"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "execute",
          "description": "Execute one bounded operation through a broker session",
          "flags": [
            {
              "name": "session-id",
              "required": true,
              "description": "Broker session identifier"
            },
            {
              "name": "session-token",
              "required": true,
              "description": "Broker capability token"
            },
            {
              "name": "method",
              "default": "GET",
              "description": "Bounded HTTP method"
            },
            {
              "name": "path",
              "required": true,
              "description": "Bounded path"
            },
            {
              "name": "headers",
              "description": "JSON object of request headers",
              "bind": {
                "field": "headers",
                "kind": "json_inline"
              }
            },
            {
              "name": "body",
              "description": "Request body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "ExecuteBrokerOperation"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "revoke",
          "description": "Revoke a broker session",
          "flags": [
            {
              "name": "session-id",
              "required": true,
              "description": "Broker session identifier"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CredentialBrokerService",
            "method": "RevokeBrokerSession"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
