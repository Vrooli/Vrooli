{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {"entries":{"data":{"rung":"owned","path":"data","kind":"dir","class":"data","regenerable":false,"rationale":"Scenario-owned durable data observed in the canonical data directory."},"api_data":{"rung":"owned","path":"api/data","kind":"dir","class":"data","regenerable":false,"rationale":"Scenario-owned API data observed in the canonical API data directory."}},"rationale":"Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."},
  "service": {
    "parent": "vrooli",
    "name": "agent-inbox",
    "displayName": "Agent Inbox",
    "description": "AI chat inbox for managing conversations with multiple AI models and coding agents",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/agent-inbox"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 21237,
      "description": "React UI"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "startup_grace_period": 15000,
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI",
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && go mod download && go build -o agent-inbox-api .",
          "description": "Build Go API server binary"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && pnpm install --ignore-workspace; else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies"
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && pnpm run build; else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ],
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/agent-inbox-api"
            ]
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          },
          {
            "type": "cli",
            "command": "agent-inbox",
            "targets": [
              "agent-inbox"
            ]
          }
        ]
      }
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./agent-inbox-api",
          "background": true,
          "description": "Start Go API server",
          "condition": {
            "file_exists": "api/agent-inbox-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite",
      "steps": [
        {
          "name": "run-tests",
          "run": "test-genie execute agent-inbox --preset comprehensive",
          "description": "Run structure/unit/integration/business/performance phases"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'agent-inbox-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "description": "Local LLM for automatic chat naming",
        "model_roles": [
          "chat.default"
        ]
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": true,
        "description": "Multi-model chat completions API",
        "model_roles": [
          "chat.default"
        ]
      }
    },
    "scenarios": {
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides portable coding-agent execution for task dispatch",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/default.json"
            ]
          }
        }
      },
      "scenario-to-cloud": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides VPS deployment lifecycle management (create, execute, stop, inspect deployments)"
      },
      "prompt-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides skills/prompts for agent context injection (optional - graceful degradation)"
      }
    }
  },
  "environment": {
    "AI_SQLITE_PATH": "${SCENARIO_DATA_DIR}/agent-inbox.db"
  },
  "cli": {
    "enabled": true,
    "command": "agent-inbox",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "agent-inbox"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  }
}
