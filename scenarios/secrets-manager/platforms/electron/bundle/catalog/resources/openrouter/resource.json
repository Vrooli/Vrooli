{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "openrouter",
  "storage": {"entries": {}, "rationale": "No additional host storage is owned by this resource on the supported lifecycle path; the explicit empty declaration prevents an implicit-storage assumption."},
  "display_name": "OpenRouter API",
  "description": "Hosted OpenRouter API gateway for access to multiple model providers.",
  "cli": {
    "enabled": true,
    "command": "resource-openrouter",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-openrouter_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-openrouter"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an OpenRouter account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an OpenRouter account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an OpenRouter account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        }
      }
    }
  },
  "endpoint": "https://openrouter.ai/api/v1/models",
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/openrouter",
        "field": "api-key",
        "env": "OPENROUTER_API_KEY",
        "label": "OpenRouter API Key",
        "description": "OpenRouter unified API gateway across LLM providers. Required for scenarios that route LLM calls through OpenRouter rather than calling providers directly.",
        "required": true,
        "obtain_url": "https://openrouter.ai/keys"
      }
    ]
  },
  "orchestration": {
    "startup_order": 640,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "OPENROUTER_API_BASE": "https://openrouter.ai/api/v1",
      "OPENROUTER_DEFAULT_ROLE": "chat.default"
    },
    "derived": {
      "OPENROUTER_URL": {
        "template": "${OPENROUTER_API_BASE}"
      },
      "RESOURCE_OPENROUTER_URL": {
        "template": "${OPENROUTER_API_BASE}"
      }
    }
  },
  "portability_tier": "full",
  "category": "hosted-service",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://openrouter.ai/api/v1/models",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false,
    "supports_ensure": true
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific OpenRouter dependency settings. Greenfield: roles only — concrete model slugs are resolved by resource-openrouter, never declared here.",
    "properties": {
      "model_roles": {
        "type": "array",
        "description": "Logical OpenRouter model roles resolved through resources/openrouter/model-policy.json (e.g. chat.default, image.generate.logo).",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "configuration": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
