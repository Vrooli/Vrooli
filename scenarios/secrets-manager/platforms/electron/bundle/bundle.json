{
  "app": {
    "description": "Dark chrome security dashboard for discovering, validating, and provisioning secrets required by Vrooli resources",
    "name": "Secrets Manager",
    "version": "1.0.0"
  },
  "ipc": {
    "auth_token_path": "runtime/auth_token",
    "host": "127.0.0.1",
    "mode": "loopback-http",
    "port": 0
  },
  "ports": {
    "default_range": {
      "max": 24000,
      "min": 20000
    },
    "reserved": []
  },
  "schema_version": "v0.1",
  "services": [
    {
      "binaries": {
        "darwin-x64": {
          "path": "bin/api/darwin-x64/api"
        },
        "linux-x64": {
          "path": "bin/api/linux-x64/api"
        },
        "win-x64": {
          "path": "bin/api/win-x64/api.exe"
        }
      },
      "build": {
        "output_pattern": "bin/api/{{platform}}/api{{ext}}",
        "source_dir": "api",
        "type": "go"
      },
      "critical": true,
      "description": "Declared api component",
      "env": {
        "API_PORT": "${api.api}",
        "UI_PORT": "${ui.ui}",
        "VROOLI_LIFECYCLE_MANAGED": "true"
      },
      "health": {
        "interval_ms": 30000,
        "path": "/health",
        "port_name": "api",
        "retries": 5,
        "timeout_ms": 10000,
        "type": "http"
      },
      "id": "api",
      "ports": {
        "requested": [
          {
            "name": "api",
            "range": {
              "max": 19999,
              "min": 15000
            },
            "requires_socket": false
          }
        ]
      },
      "readiness": {
        "pattern": "",
        "port_name": "api",
        "timeout_ms": 30000,
        "type": "health_success"
      },
      "type": "api-binary"
    },
    {
      "assets": [
        {
          "path": "ui/dist/assets/index-C6ybwBkV.js",
          "sha256": "2b87e52c4c7108b7f33b2a64c8d34bd66c76bc8eca4c3506c408748edc77b0e6",
          "size_bytes": 438170
        },
        {
          "path": "ui/dist/assets/index-Zeo9Cllz.css",
          "sha256": "d20f9d15c238ebfbf9a07724f94d953511798d6a10723ecb96144066070c06c9",
          "size_bytes": 60072
        },
        {
          "path": "ui/dist/favicon.svg",
          "sha256": "ff3ce0b756bb7f7b2fab0f3a40ed95283b8b6be305560f7fa5a87367c6c51f90",
          "size_bytes": 508
        },
        {
          "path": "ui/dist/index.html",
          "sha256": "8eb71d189f7023aeb057cbab366bf4738cb8fb998c988cf7a54104e1fcc14cdb",
          "size_bytes": 992
        },
        {
          "path": "ui/dist/index.html.freshness.json",
          "sha256": "987cb87a0a0360c592127ab0741163e4bc70fd90dfcba0734e0e0cae03614aa1",
          "size_bytes": 100085
        },
        {
          "path": "ui/dist/site.webmanifest",
          "sha256": "56e5965576887701d56a653b589d569a73cfefbff1700841f4f160583351f36a",
          "size_bytes": 418
        },
        {
          "path": "ui/dist/sw.js",
          "sha256": "02df4d55414fea0d6e24ce8e941542e9b4e9ecdd0e13e60238c0fc894695100c",
          "size_bytes": 1372
        }
      ],
      "binaries": {
        "darwin-x64": {
          "path": "ui/dist/index.html"
        },
        "linux-x64": {
          "path": "ui/dist/index.html"
        },
        "win-x64": {
          "path": "ui/dist/index.html"
        }
      },
      "build": {
        "output_pattern": "ui/dist/index.html",
        "source_dir": "ui",
        "type": "npm"
      },
      "critical": true,
      "description": "Declared ui component",
      "env": {
        "API_PORT": "${api.api}",
        "UI_PORT": "${ui.ui}",
        "VROOLI_LIFECYCLE_MANAGED": "true"
      },
      "health": {
        "interval_ms": 30000,
        "path": "/health",
        "port_name": "ui",
        "retries": 5,
        "timeout_ms": 5000,
        "type": "http"
      },
      "id": "ui",
      "ports": {
        "requested": [
          {
            "name": "ui",
            "range": {
              "max": 24999,
              "min": 20000
            },
            "requires_socket": false
          }
        ]
      },
      "readiness": {
        "pattern": "",
        "port_name": "ui",
        "timeout_ms": 30000,
        "type": "health_success"
      },
      "type": "ui-bundle"
    }
  ],
  "swaps": [
    {
      "limitations": "",
      "original": "redis",
      "reason": "Recommended bundle-safe alternative from dependency metadata",
      "replacement": "durable-local"
    }
  ],
  "target": "desktop",
  "telemetry": {
    "file": "telemetry/deployment-telemetry.jsonl",
    "upload_url": ""
  }
}