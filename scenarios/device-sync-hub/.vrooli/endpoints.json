{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "notes_list",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes list"
      }
    },
    {
      "id": "notes_create",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes create",
        "args": [
          "--title",
          "<title>",
          "--body",
          "<body>"
        ]
      }
    },
    {
      "id": "notes_get",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "notes_count",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes count",
        "args": [
          "--window",
          "<window>"
        ]
      }
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes attach",
        "args": [
          "<id>",
          "--file",
          "<path>"
        ]
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message."
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "notes list",
      "description": "List all notes (newest-first, default limit 100)",
      "endpoint_id": "notes_list"
    },
    {
      "name": "notes create",
      "description": "Create a note (--title TITLE [--body BODY])",
      "endpoint_id": "notes_create"
    },
    {
      "name": "notes get",
      "description": "Get a note by id",
      "endpoint_id": "notes_get"
    },
    {
      "name": "notes count",
      "description": "Count notes created in a time window (--window WINDOW); the reference measure",
      "endpoint_id": "notes_count"
    },
    {
      "name": "notes attach",
      "description": "Upload an attachment for a note (--file PATH)",
      "endpoint_id": "notes_attach"
    }
  ]
}
