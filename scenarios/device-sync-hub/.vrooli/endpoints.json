{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "devices_list",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/ListDevices",
      "method": "POST",
      "summary": "List trusted devices",
      "description": "Returns every device in the authenticated owner's trust group, newest first.",
      "category": "devices",
      "response": {
        "type": "object",
        "properties": {
          "devices": "array<Device>"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List devices",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/ListDevices -H 'Authorization: Bearer <owner-jwt>' -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices list"
      }
    },
    {
      "id": "devices_get",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/GetDevice",
      "method": "POST",
      "summary": "Get a device by id",
      "description": "Returns one owner-scoped device.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such device for this owner"
        }
      ],
      "examples": [
        {
          "name": "Get device",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/GetDevice -H 'Authorization: Bearer <owner-jwt>' -d '{\"id\":\"<device-id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "devices_issue_pairing_code",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/IssuePairingCode",
      "method": "POST",
      "summary": "Issue a pairing code",
      "description": "Mints a short-TTL, single-use pairing code (and QR payload) for a new device to redeem. Owner-authed.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "device_name": "string (optional slot label)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "pairing_code": "PairingCode (raw code returned once)"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Code generation or persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Issue code",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/IssuePairingCode -H 'Authorization: Bearer <owner-jwt>' -d '{\"device_name\":\"My Phone\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices pair",
        "args": [
          "--name",
          "<name>"
        ]
      }
    },
    {
      "id": "devices_redeem_pairing_code",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/RedeemPairingCode",
      "method": "POST",
      "summary": "Redeem a pairing code",
      "description": "Called by a new device presenting a valid code. Registers a TRUSTED device and returns its one-time hub device token. No owner token required.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "code": "string",
          "profile": "DeviceProfile"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device",
          "device_token": "string (returned once)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown, expired, or already-used code"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Redeem code",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/RedeemPairingCode -d '{\"code\":\"ABCDE-FGHIJ\",\"profile\":{\"device_name\":\"Tablet\",\"kind\":\"tablet\"}}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices redeem",
        "args": [
          "--code",
          "<code>"
        ]
      }
    },
    {
      "id": "devices_request_pairing",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/RequestPairing",
      "method": "POST",
      "summary": "Request pairing (fallback)",
      "description": "Fallback join path for a device that cannot enter a code: registers a PENDING device and returns an inert token that activates when the owner approves.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "profile": "DeviceProfile"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device (pending)",
          "device_token": "string (inert until approved)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "failed_precondition",
          "description": "No owner yet — first device must use a code"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Request pairing",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/RequestPairing -d '{\"profile\":{\"device_name\":\"Tablet\"}}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices request"
      }
    },
    {
      "id": "devices_approve_pairing",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/ApprovePairing",
      "method": "POST",
      "summary": "Approve a pending device",
      "description": "Promotes a PENDING device (from the request path) to TRUSTED. Owner-authed.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "device_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such device"
        },
        {
          "status": 400,
          "code": "failed_precondition",
          "description": "Device is revoked"
        }
      ],
      "examples": [
        {
          "name": "Approve device",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/ApprovePairing -H 'Authorization: Bearer <owner-jwt>' -d '{\"device_id\":\"<id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices approve",
        "args": [
          "<device-id>"
        ]
      }
    },
    {
      "id": "devices_rename",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/RenameDevice",
      "method": "POST",
      "summary": "Rename a device",
      "description": "Updates a device's human-facing name. Owner-authed.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "device_id": "string",
          "name": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Blank name"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such device"
        }
      ],
      "examples": [
        {
          "name": "Rename device",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/RenameDevice -H 'Authorization: Bearer <owner-jwt>' -d '{\"device_id\":\"<id>\",\"name\":\"Laptop\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices rename",
        "args": [
          "<device-id>",
          "--name",
          "<name>"
        ]
      }
    },
    {
      "id": "devices_revoke",
      "path": "/vrooli.device_sync_hub.v1.devices.DevicesService/RevokeDevice",
      "method": "POST",
      "summary": "Revoke a device",
      "description": "Immediately severs a device's access: flips it to REVOKED (hub token rejected at once) and revokes its authenticator session. Owner-authed.",
      "category": "devices",
      "request": {
        "type": "object",
        "properties": {
          "device_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": "Device"
        }
      },
      "errors": [
        {
          "status": 401,
          "code": "unauthenticated",
          "description": "Missing or invalid owner token"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such device"
        }
      ],
      "examples": [
        {
          "name": "Revoke device",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.devices.DevicesService/RevokeDevice -H 'Authorization: Bearer <owner-jwt>' -d '{\"device_id\":\"<id>\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub devices revoke",
        "args": [
          "<device-id>"
        ]
      }
    },
    {
      "id": "notes_list",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes list"
      }
    },
    {
      "id": "notes_create",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes create",
        "args": [
          "--title",
          "<title>",
          "--body",
          "<body>"
        ]
      }
    },
    {
      "id": "notes_get",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "notes_count",
      "path": "/vrooli.device_sync_hub.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.device_sync_hub.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes count",
        "args": [
          "--window",
          "<window>"
        ]
      }
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "UploadAttachmentResponse",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "cli_mapping": {
        "command": "device-sync-hub notes attach",
        "args": [
          "<id>",
          "--file",
          "<path>"
        ]
      },
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message."
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "devices list",
      "description": "List the owner's trusted devices",
      "endpoint_id": "devices_list"
    },
    {
      "name": "devices get",
      "description": "Get a device by id",
      "endpoint_id": "devices_get"
    },
    {
      "name": "devices pair",
      "description": "Issue a short-TTL pairing code/QR for a new device (--name NAME)",
      "endpoint_id": "devices_issue_pairing_code"
    },
    {
      "name": "devices redeem",
      "description": "Redeem a pairing code from a new device (--code CODE)",
      "endpoint_id": "devices_redeem_pairing_code"
    },
    {
      "name": "devices request",
      "description": "Request pairing (fallback) from a device that cannot enter a code",
      "endpoint_id": "devices_request_pairing"
    },
    {
      "name": "devices approve",
      "description": "Approve a pending device into the trust group",
      "endpoint_id": "devices_approve_pairing"
    },
    {
      "name": "devices rename",
      "description": "Rename a device (--name NAME)",
      "endpoint_id": "devices_rename"
    },
    {
      "name": "devices revoke",
      "description": "Revoke a device, severing its access immediately",
      "endpoint_id": "devices_revoke"
    },
    {
      "name": "notes list",
      "description": "List all notes (newest-first, default limit 100)",
      "endpoint_id": "notes_list"
    },
    {
      "name": "notes create",
      "description": "Create a note (--title TITLE [--body BODY])",
      "endpoint_id": "notes_create"
    },
    {
      "name": "notes get",
      "description": "Get a note by id",
      "endpoint_id": "notes_get"
    },
    {
      "name": "notes count",
      "description": "Count notes created in a time window (--window WINDOW); the reference measure",
      "endpoint_id": "notes_count"
    },
    {
      "name": "notes attach",
      "description": "Upload an attachment for a note (--file PATH)",
      "endpoint_id": "notes_attach"
    }
  ]
}
