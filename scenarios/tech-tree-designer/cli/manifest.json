{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "tech-tree-designer",
  "description": "Tech Tree Designer CLI surface for the scenario interface graph.",
  "groups": [
    {
      "name": "graph",
      "description": "Scenario interface graph commands.",
      "commands": [
        {
          "name": "describe",
          "description": "Describe the scenario interface graph.",
          "flags": [
            {
              "name": "scenarios",
              "description": "Comma-separated scenario filter",
              "bind": {
                "field": "scenario_filter"
              }
            },
            {
              "name": "stability",
              "description": "Optional stability filter",
              "bind": {
                "field": "stability_filter"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "DescribeTechTree"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "neighbors",
          "description": "Get the graph neighborhood around one scenario.",
          "positionals": [
            {
              "name": "scenario",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "depth",
              "description": "Neighborhood depth; defaults to 1"
            },
            {
              "name": "scenarios",
              "description": "Comma-separated scenario filter",
              "bind": {
                "field": "scenario"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "GetNeighborhood"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "path",
          "description": "Find a directed graph path between two scenarios.",
          "positionals": [
            {
              "name": "from",
              "required": true,
              "bind": {
                "field": "from_scenario"
              }
            },
            {
              "name": "to",
              "required": true,
              "bind": {
                "field": "to_scenario"
              }
            }
          ],
          "flags": [
            {
              "name": "scenarios",
              "description": "Comma-separated scenario filter",
              "bind": {
                "field": "to_scenario"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "FindPath"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "ancestors",
          "description": "List dependency ancestors for one scenario.",
          "positionals": [
            {
              "name": "scenario",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "scenarios",
              "description": "Comma-separated scenario filter",
              "bind": {
                "field": "scenario"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "ListAncestors"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "export",
          "description": "Export the scenario interface graph.",
          "flags": [
            {
              "name": "format",
              "description": "Export format: text, dot, or json",
              "default": "text"
            },
            {
              "name": "scenarios",
              "description": "Comma-separated scenario filter",
              "bind": {
                "field": "scenario_filter"
              }
            },
            {
              "name": "stability",
              "description": "Optional stability filter",
              "bind": {
                "field": "stability_filter"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "GraphService",
            "method": "ExportTechTree"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "ontology",
      "description": "Capability ontology and coverage commands.",
      "commands": [
        {
          "name": "capabilities",
          "description": "List capability ontology nodes.",
          "flags": [
            {
              "name": "parent",
              "description": "Optional parent capability id",
              "bind": {
                "field": "parent_id"
              }
            },
            {
              "name": "kind",
              "description": "Filter kind: sector, capability, component, capstone, simulation"
            },
            {
              "name": "descendants",
              "description": "Include descendants of --parent",
              "default": "false",
              "bind": {
                "field": "include_descendants"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "ListCapabilities"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "capability",
          "description": "Get a capability by slug.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "GetCapability"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "capability-upsert",
          "description": "Create or update a capability.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "name",
              "description": "Capability display name"
            },
            {
              "name": "description",
              "description": "Capability description"
            },
            {
              "name": "kind",
              "description": "Kind: sector, capability, component, capstone, simulation",
              "default": "capability"
            },
            {
              "name": "parent",
              "description": "Parent capability id"
            },
            {
              "name": "importance",
              "description": "Optional importance weight"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "UpsertCapability"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "capability-rm",
          "description": "Delete a capability by slug.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "DeleteCapability"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "edge-add",
          "description": "Create a capability edge.",
          "positionals": [
            {
              "name": "from",
              "required": true
            },
            {
              "name": "to",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "type",
              "description": "Edge type: progression, decomposes, requires",
              "default": "progression"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "UpsertCapabilityEdge"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "edge-rm",
          "description": "Delete a capability edge.",
          "positionals": [
            {
              "name": "from",
              "required": true
            },
            {
              "name": "to",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "type",
              "description": "Edge type: progression, decomposes, requires",
              "default": "progression"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "DeleteCapabilityEdge"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "import",
          "description": "Import topology JSON.",
          "flags": [
            {
              "name": "from-file",
              "description": "Topology JSON file path"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "ImportTopology"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:read",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "fulfill",
          "description": "Link a capability to a scenario.",
          "positionals": [
            {
              "name": "capability",
              "required": true
            },
            {
              "name": "scenario",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "note",
              "description": "Optional fulfillment note"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "LinkFulfillment"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "unfulfill",
          "description": "Remove a capability-to-scenario fulfillment link.",
          "positionals": [
            {
              "name": "capability",
              "required": true
            },
            {
              "name": "scenario",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "UnlinkFulfillment"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "fulfillments",
          "description": "List fulfillment links.",
          "flags": [
            {
              "name": "capability",
              "description": "Optional capability id filter",
              "bind": {
                "field": "capability_id"
              }
            },
            {
              "name": "scenario",
              "description": "Optional scenario slug filter",
              "bind": {
                "field": "scenario_slug"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "ListFulfillments"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "coverage",
          "description": "Compute ontology and implementation coverage.",
          "flags": [
            {
              "name": "subtree",
              "description": "Use subtree rollup in capability state counts",
              "default": "true",
              "bind": {
                "field": "include_subtree_rollup"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "GetCoverage"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "focus",
          "description": "List prioritized ontology focus items.",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum focus items",
              "default": "10"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "ListFocus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "capability-scenarios",
          "description": "List scenarios fulfilling a capability.",
          "positionals": [
            {
              "name": "slug",
              "required": true,
              "bind": {
                "field": "capability_slug"
              }
            }
          ],
          "flags": [
            {
              "name": "descendants",
              "description": "Include descendant capabilities",
              "default": "true",
              "bind": {
                "field": "include_descendants"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "GetCapabilityScenarios"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "scenario",
          "description": "List capabilities fulfilled by a scenario.",
          "positionals": [
            {
              "name": "slug",
              "required": true,
              "bind": {
                "field": "scenario_slug"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "GetScenarioCapabilities"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "overlay",
          "description": "Describe the ontology/implementation overlay graph.",
          "flags": [
            {
              "name": "implementation",
              "description": "Include implementation graph nodes and edges",
              "default": "false",
              "bind": {
                "field": "include_implementation"
              }
            },
            {
              "name": "ontology",
              "description": "Include ontology graph nodes and edges",
              "default": "false",
              "bind": {
                "field": "include_ontology"
              }
            },
            {
              "name": "fulfillment",
              "description": "Include fulfillment edges",
              "default": "false",
              "bind": {
                "field": "include_fulfillment"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "OntologyService",
            "method": "DescribeOverlayGraph"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "plan",
      "description": "Contract-first planned scenario commands.",
      "commands": [
        {
          "name": "create",
          "description": "Create or update a planned scenario.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "display-name",
              "description": "Human display name"
            },
            {
              "name": "sector",
              "description": "Planning sector metadata"
            },
            {
              "name": "tier",
              "description": "Planning tier metadata"
            },
            {
              "name": "stability",
              "description": "Target stability",
              "default": "experimental"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "CreatePlannedScenario"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "list",
          "description": "List planned scenarios.",
          "flags": [
            {
              "name": "sector",
              "description": "Optional sector filter"
            },
            {
              "name": "tier",
              "description": "Optional tier filter"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "ListPlannedScenarios"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "tree",
          "description": "Show a planned scenario's proto file tree.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            },
            {
              "name": "path",
              "required": false,
              "bind": {
                "field": "slug"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "GetPlannedScenario"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "add",
          "description": "Add or replace a planned proto file.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            },
            {
              "name": "path",
              "required": true
            }
          ],
          "flags": [
            {
              "name": "from-file",
              "description": "Read proto text from file path or - for stdin",
              "default": "-"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "PutPlannedProtoFile"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "rm",
          "description": "Remove one planned proto file.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            },
            {
              "name": "path",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "DeletePlannedProtoFile"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          }
        },
        {
          "name": "validate",
          "description": "Validate planned proto files.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "ValidatePlannedScenario"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "materialize",
          "description": "Write planned proto files into packages/proto and regenerate artifacts.",
          "positionals": [
            {
              "name": "slug",
              "required": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PlanningService",
            "method": "MaterializePlannedScenario"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "requires_confirmation": true,
            "permissions": [
              "network:internal",
              "filesystem:write",
              "admin"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "omitted": []
}
