{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {},
    "rationale": "No scenario-owned persistent directory was found in the canonical repository storage paths; the scenario uses external storage, generated test paths, or ephemeral runtime state."
  },
  "service": {
    "parent": "vrooli",
    "name": "scenario-to-cloud",
    "displayName": "Scenario To Cloud",
    "description": "Deploy one scenario and its dependencies to cloud targets (VPS first), orchestrated by deployment-manager.",
    "version": "0.0.1",
    "type": "business-application",
    "category": "deployment",
    "tags": [
      "react-ui",
      "go-api",
      "deployment",
      "packager"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/scenario-to-cloud"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "hostTools": [
    {
      "name": "qemu",
      "required": true,
      "reason": "The disposable local-QEMU provider needs a real Linux VM for fresh-host validation.",
      "when": [
        "setup",
        "test"
      ],
      "platforms": [
        "linux"
      ],
      "notes": "Install through Vrooli host requirements; do not use an ad-hoc package-manager command."
    },
    {
      "name": "cloud-localds",
      "required": true,
      "reason": "The disposable local-QEMU provider uses cloud-init to provision the VM user and SSH key.",
      "when": [
        "setup",
        "test"
      ],
      "platforms": [
        "linux"
      ],
      "notes": "Install through Vrooli host requirements; do not use an ad-hoc package-manager command."
    }
  ],
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "startup_grace_period": 15000,
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "description": "Deployment records storage",
        "schema": "scenario_to_cloud"
      }
    },
    "scenarios": {
      "scenario-dependency-analyzer": {
        "enabled": true,
        "required": true,
        "description": "Provides dependency analysis for manifest generation"
      },
      "agent-manager": {
        "enabled": true,
        "required": false,
      "description": "Optional investigation and task orchestration backend"
    },
    "secrets-manager": {
      "required": false,
      "startup_policy": "try_start",
      "runtime_only": true,
      "runtime_only_rationale": "Secret resolution uses the secrets-manager HTTP boundary through discovery.",
      "degraded_behavior": "Operations requiring secret resolution fail explicitly while secrets-manager is unavailable."
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "scenario-to-cloud",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "scenario-to-cloud"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
