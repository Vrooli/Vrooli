  "fault_capabilities": {
    "worker_restart": {
      "points": [
        "worker_before_commit",
        "worker_after_effect",
        "activation_before_switch"
      ],
      "kind": "crash",
      "blast_radius": "cloud owner process on the controller host"
    },
    "lease_expiry": {
      "points": [
        "worker_after_effect"
      ],
      "kind": "delay",
      "blast_radius": "one operation lease; successor fence proves the stale one cannot commit"
    },
    "lost_reply": {
      "points": [
        "transport_reply"
      ],
      "kind": "drop_reply",
      "blast_radius": "one remote step reply"
    },
    "transport_disconnect": {
      "points": [
        "transport_send",
        "transport_reply"
      ],
      "kind": "fail",
      "blast_radius": "one reach call to the owned guest"
    },
    "target_reboot": {
      "points": [],
      "kind": "guest_reset",
      "blast_radius": "the owned QEMU guest only (vps instance stop then start); never a faultinject point"
    },
    "data_interruption": {
      "points": [
        "data_before_backup",
        "data_after_restore"
      ],
      "kind": "fail",
      "blast_radius": "one backup or restore step inside the owned guest"
    }
  },
  "fault_rule": "Fault injection arms api/faultinject points only inside routed test mode and only against the owned guest; target_reboot is a guest reset through the instance owner. A capability not listed here is refused at admission.",
  "journey": [
    "readiness (GET /api/v1/instances/readiness) must be ready for the requested architecture",
    "verify source image digest against qemu-images.json",
    "vps instance create (owned copy-on-write disk) -> start -> wait-for-ssh -> snapshot clean",
    "deploy the cell fixture through the operations API: plan -> apply(plan_digest, request_key) -> operation wait",
    "per cell: arm the declared fault in test mode, exercise the trigger, collect target receipts (vrooli cloud-target receipt get) and the health observation",
    "reset to clean and repeat every repeat_after_reset cell for the same release digest (P20-A04)",
    "destroy the owned disk; verify the source image digest is unchanged and the neighbor inventory matches (P20-A05)",
    "write certification/evidence/<CASE>.qemu.json receipts"
  ],
