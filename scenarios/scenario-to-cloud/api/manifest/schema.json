{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.dev/scenario-to-cloud/manifest.schema.json",
  "title": "Scenario to Cloud Manifest",
  "type": "object",
  "required": [
    "version",
    "target",
    "scenario",
    "dependencies",
    "bundle",
    "ports",
    "edge"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "environment": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["type", "vps"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["vps"] },
        "vps": {
          "type": "object",
          "required": ["host"],
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "user": { "type": "string" },
            "workdir": { "type": "string" },
            "preserve_paths": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "required": ["scenarios", "resources"],
      "additionalProperties": false,
      "properties": {
        "scenarios": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "analyzer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool": { "type": "string" },
            "fingerprint": { "type": "string" },
            "generated_at": { "type": "string" }
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["include_packages", "include_autoheal"],
      "additionalProperties": false,
      "properties": {
        "include_packages": { "type": "boolean" },
        "include_autoheal": { "type": "boolean" },
        "scenarios": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "edge": {
      "type": "object",
      "required": ["domain", "caddy"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "dns_policy": { "type": "string", "enum": ["required", "warn", "skip"] },
        "managed_dns_profile": { "type": "string", "minLength": 1 },
        "mail_dns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "spf_mechanism": { "type": "string" },
              "spf_host": { "type": "string" },
              "dkim": { "type": "array", "items": { "type": "object", "required": ["selector", "type"], "additionalProperties": false, "properties": { "selector": { "type": "string", "minLength": 1 }, "type": { "type": "string", "enum": ["TXT", "CNAME"] }, "expected": { "type": "string" } } } }
            }
          }
        },
        "acme_environment": {
          "type": "string",
          "enum": ["staging", "production"],
          "description": "Requests staging or production ACME issuance. Empty derives it: production for the production environment, staging otherwise."
        },
        "health_path": {
          "type": "string",
          "minLength": 1,
          "description": "Public path serving the application's own health document, the one whose body names its dependencies (default \"/health\"). Declare it when the informative path differs from the root, for example \"/api/v1/health\"."
        },
        "caddy": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "email": { "type": "string" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "bundle_secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "class": {
                "type": "string",
                "enum": ["per_install_generated", "user_prompt", "remote_fetch", "infrastructure"]
              },
              "required": {
                "type": "boolean",
                "description": "Blocking. A required secret nothing satisfies stops the plan with an operator handoff."
              },
              "capability": {
                "type": "string",
                "minLength": 1,
                "description": "Non-blocking. Names the customer-facing capability this secret powers, in operator words (\"customer sign-in email\", \"card payments\"). A plan that cannot satisfy an optional secret with a declared capability emits a warning naming that capability instead of staying silent."
              },
              "description": { "type": "string" },
              "format": { "type": "string" },
              "target": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["env", "file"] },
                  "name": { "type": "string", "minLength": 1 }
                }
              },
              "descriptor": {
                "type": "object",
                "properties": {
                  "logical_id": { "type": "string", "minLength": 1 },
                  "field": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "local_credential_handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumer_scenario", "consumer_path", "auth_descriptor", "profile_tag", "api_base", "secret_id"],
        "properties": {
          "consumer_scenario": { "type": "string", "minLength": 1 },
          "consumer_path": { "type": "string", "minLength": 1 },
          "auth_descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["logical_id", "field"],
            "properties": {
              "logical_id": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 }
            }
          },
          "profile_tag": { "type": "string", "minLength": 1 },
          "profile_label": { "type": "string" },
          "api_base": { "type": "string", "minLength": 1 },
          "secret_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
