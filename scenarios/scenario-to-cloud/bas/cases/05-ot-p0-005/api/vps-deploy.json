{
  "metadata": {
    "name": "Deploy candidates and health surface",
    "description": "Observer check that deploy candidates are listable and the API health surface answers with typed readiness; deploy/start against a target is exercised by the QEMU and real-VPS lanes.",
    "tags": [
      "e2e",
      "api",
      "deploy"
    ],
    "requirements": [
      "STC-P0-005"
    ],
    "labels": {
      "safety": "observer",
      "mutates_target": "false",
      "mutates_repository": "false",
      "requirements_json": "[\"STC-P0-005\"]"
    },
    "reset": "none",
    "execution_mode": "observer"
  },
  "settings": {},
  "nodes": [
    {
      "id": "scenarios",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/scenarios",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/scenarios",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.scenarios"
          },
          {
            "type": "json_path_exists",
            "path": "$.timestamp"
          }
        ]
      }
    },
    {
      "id": "health",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/health",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/health",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.status"
          },
          {
            "type": "json_path_exists",
            "path": "$.readiness"
          }
        ]
      }
    }
  ],
  "edges": []
}
