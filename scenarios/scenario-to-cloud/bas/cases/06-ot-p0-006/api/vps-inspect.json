{
  "metadata": {
    "name": "Inspection surfaces without a target",
    "description": "Observer check of the read-only inspection surfaces (deployment listing filtered by status, docs manifest) that remote status and log retrieval build on; SSH-backed inspection needs an owned target and runs in the QEMU lane.",
    "tags": [
      "e2e",
      "api",
      "inspect"
    ],
    "requirements": [
      "STC-P0-006"
    ],
    "labels": {
      "safety": "observer",
      "mutates_target": "false",
      "mutates_repository": "false",
      "requirements_json": "[\"STC-P0-006\"]"
    },
    "reset": "none",
    "execution_mode": "observer"
  },
  "settings": {},
  "nodes": [
    {
      "id": "deployed",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/deployments?status=deployed",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/deployments?status=deployed",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.deployments"
          }
        ]
      }
    },
    {
      "id": "docs",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/docs/manifest",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/docs/manifest",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          }
        ]
      }
    }
  ],
  "edges": []
}
