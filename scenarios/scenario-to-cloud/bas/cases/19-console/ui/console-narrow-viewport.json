{
  "metadata": {
    "name": "Deployment console keeps primary actions at 360px",
    "description": "Observer journey at a 360px viewport: the identity header, the operation panel and the recovery panel render and the advanced disclosure toggle stays reachable; no primary action is clipped. Read-only navigation and assertions.",
    "tags": ["e2e", "ui", "console", "responsive"],
    "requirements": ["STC-P0-039"],
    "labels": {
      "safety": "observer",
      "mutates_target": "false",
      "mutates_repository": "false",
      "requirements_json": "[\"STC-P0-039\"]"
    },
    "reset": "none",
    "execution_mode": "observer",
    "version": 1
  },
  "settings": {
    "executionViewport": { "width": 360, "height": 780, "preset": "mobile" }
  },
  "nodes": [
    {
      "id": "open-console",
      "type": "navigate",
      "data": {
        "label": "Open the deployment console at 360px",
        "destinationType": "scenario",
        "scenario": "scenario-to-cloud",
        "scenarioPath": "/#deployments/7e493e04-5297-47eb-9df9-74929f185956",
        "waitUntil": "load",
        "timeoutMs": 30000,
        "waitForMs": 3000
      }
    },
    { "id": "identity", "type": "assert", "data": { "label": "Identity header present", "selector": "[data-testid=\"console-identity\"]", "assertMode": "exists", "timeoutMs": 30000, "failureMessage": "Identity header must render at 360px" } },
    { "id": "inspect", "type": "assert", "data": { "label": "Inspect action reachable", "selector": "[data-testid=\"console-inspect\"]", "assertMode": "exists", "timeoutMs": 10000, "failureMessage": "Inspect must not be clipped" } },
    { "id": "operation", "type": "assert", "data": { "label": "Operation panel present", "selector": "[data-testid=\"console-operation\"]", "assertMode": "exists", "timeoutMs": 10000, "failureMessage": "Operation panel must render at 360px" } },
    { "id": "recovery", "type": "assert", "data": { "label": "Recovery panel present", "selector": "[data-testid=\"console-recovery\"]", "assertMode": "exists", "timeoutMs": 10000, "failureMessage": "Recovery panel must render at 360px" } },
    { "id": "advanced", "type": "assert", "data": { "label": "Advanced disclosure reachable", "selector": "[data-testid=\"console-advanced-toggle\"]", "assertMode": "exists", "timeoutMs": 10000, "failureMessage": "Advanced disclosure must render at 360px" } }
  ],
  "edges": [
    { "id": "e1", "source": "open-console", "target": "identity", "type": "smoothstep" },
    { "id": "e2", "source": "identity", "target": "inspect", "type": "smoothstep" },
    { "id": "e3", "source": "inspect", "target": "operation", "type": "smoothstep" },
    { "id": "e4", "source": "operation", "target": "recovery", "type": "smoothstep" },
    { "id": "e5", "source": "recovery", "target": "advanced", "type": "smoothstep" }
  ]
}
