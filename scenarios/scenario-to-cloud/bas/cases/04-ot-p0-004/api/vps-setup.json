{
  "metadata": {
    "name": "Setup plan preconditions",
    "description": "Observer check that the deployment listing and scenario inventory the setup plan is generated from are readable; the setup plan apply requires an owned target and is exercised by the QEMU lane, not here.",
    "tags": [
      "e2e",
      "api",
      "setup"
    ],
    "requirements": [
      "STC-P0-004"
    ],
    "labels": {
      "safety": "observer",
      "mutates_target": "false",
      "mutates_repository": "false",
      "requirements_json": "[\"STC-P0-004\"]"
    },
    "reset": "none",
    "execution_mode": "observer"
  },
  "settings": {},
  "nodes": [
    {
      "id": "deployments",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/deployments",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/deployments",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.deployments"
          }
        ]
      }
    },
    {
      "id": "scenarios",
      "type": "http_request",
      "data": {
        "label": "GET /api/v1/scenarios",
        "method": "GET",
        "url": "{{API_URL}}/api/v1/scenarios",
        "headers": {
          "Content-Type": "application/json"
        },
        "assertions": [
          {
            "type": "status_code",
            "expected": 200
          },
          {
            "type": "json_path_exists",
            "path": "$.scenarios"
          }
        ]
      }
    }
  ],
  "edges": []
}
