  "dynamicSelectors": {
    "wizard.stepByIndex": {
      "description": "Wizard step by index (0-based)",
      "selectorPattern": "[data-testid=\"wizard-step-${index}\"]",
      "testIdPattern": "wizard-step-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    },
    "wizard.stepByName": {
      "description": "Wizard step by name",
      "selectorPattern": "[data-testid=\"wizard-step-${name}\"]",
      "testIdPattern": "wizard-step-${name}",
      "params": [
        {
          "name": "name",
          "type": "enum",
          "values": [
            "manifest",
            "build",
            "preflight",
            "deploy"
          ]
        }
      ]
    },
    "validation.issueByIndex": {
      "description": "Validation issue by index (0-based)",
      "selectorPattern": "[data-testid=\"validation-issue-${index}\"]",
      "testIdPattern": "validation-issue-${index}",
      "params": [
        {
          "name": "index",
          "type": "number"
        }
      ]
    }
