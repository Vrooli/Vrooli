{
  "name": "ledger-store",
  "privilege": "none",
  "bundling": "vendorable",
  "requirements": {
    "ram_mb": 1024,
    "disk_mb": 4096,
    "cpu_cores": 1,
    "class": "storage"
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "fixture/ledger-store",
        "field": "password",
        "env": "LEDGER_STORE_PASSWORD",
        "required": true
      }
    ]
  },
  "hostTools": [
    {
      "name": "curl",
      "required": true,
      "reason": "readiness probe"
    }
  ],
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64"
          ],
          "limitations": [
            "amd64 archive only; no arm64 build is published for this fixture"
          ],
          "evidence": [
            "manifest-validation"
          ]
        },
        "macos": {
          "support": "unsupported",
          "mode": "manual",
          "reason": "no macos archive"
        },
        "windows": {
          "support": "unsupported",
          "mode": "manual",
          "reason": "no windows archive"
        }
      }
    },
    "persistent_data": [
      {
        "id": "ledger-store-data",
        "binding": "dir:data",
        "backup_provider": "data-backup-manager",
        "migration_owner": "resource"
      }
    ],
    "backup": {
      "provider": "postgres",
      "consistency": "database_native",
      "dump": {
        "tool": "pg_dump",
        "argv": [
          "--format=custom",
          "--no-password",
          "--dbname",
          "{database}",
          "--file",
          "{output}"
        ]
      },
      "restore": {
        "tool": "pg_restore",
        "argv": [
          "--no-password",
          "--exit-on-error",
          "--dbname",
          "{database}",
          "{input}"
        ]
      }
    }
  },
  "managed_service": {
    "provider_policy": {
      "allowed_modes": [
        "managed-private",
        "attach-only"
      ]
    },
    "artifact": {
      "path": "server/ledger-store",
      "version": "3",
      "layout": "dir",
      "entry_path": "bin/ledger-store",
      "sha256_by_platform": {
        "linux-amd64": "5d0f0c2a1b7e4d3c9f8a6b5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c"
      },
      "bundle_artifact": "ledger-store_${os}_${arch}"
    }
  },
  "ports": [
    {
      "name": "ledger-store",
      "host": 5433
    }
  ]
}
