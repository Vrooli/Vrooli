{
  "$schema": "../../.vrooli/schemas/scenario-docs-manifest.schema.json",
  "version": "2.0.0",
  "title": "Scenario-to-Cloud Documentation",
  "description": "Deploy Vrooli scenarios to VPS with HTTPS and automatic configuration",
  "defaultDocument": "QUICKSTART.md",
  "contract": {
    "kind": "scenario-docs",
    "template": "react-vite",
    "schema": "scenario-docs-manifest/v2",
    "maturityValues": ["missing", "stub", "draft", "active", "not-applicable", "deferred", "retired"],
    "stages": ["generated", "oriented", "implemented", "validated", "deployable", "monetizable"],
    "extensionRule": "Register every durable scenario document here. Keep concepts in docs/concepts, procedures in docs/guides, stable lookup material in docs/reference, and engineering memory in docs/internal."
  },
  "sections": [
    {
      "id": "getting-started",
      "title": "Getting Started",
      "icon": "rocket",
      "documents": [
        { "path": "QUICKSTART.md", "docType": "quickstart", "title": "Quick Start", "description": "Get up and running with Scenario-to-Cloud", "maturity": "active", "requiredBy": ["generated"], "completion": "required" },
        { "path": "concepts/GLOSSARY.md", "docType": "glossary", "title": "Glossary", "description": "Key terms and concepts", "maturity": "active", "requiredBy": ["oriented"], "completion": "required" }
      ]
    },
    {
      "id": "guides",
      "title": "Guides",
      "icon": "book",
      "description": "Step-by-step deployment guides",
      "documents": [
        { "path": "guides/manifest-reference.md", "docType": "manifest-reference", "title": "Manifest Reference", "description": "Complete manifest configuration guide", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "guides/dns-setup.md", "docType": "dns-guide", "title": "DNS Setup", "description": "DNS patterns for VPS deployments (with or without OG Worker)", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "guides/vps-setup.md", "docType": "vps-guide", "title": "VPS Setup", "description": "Prepare your VPS for deployments", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "guides/troubleshooting.md", "docType": "troubleshooting", "title": "Troubleshooting", "description": "Common issues and solutions", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" }
      ]
    },
    {
      "id": "reference",
      "title": "Reference",
      "icon": "code",
      "description": "Technical reference documentation",
      "documents": [
        { "path": "reference/api-endpoints.md", "docType": "api-reference", "title": "API Reference", "description": "REST API endpoint documentation", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "reference/deployment-lifecycle.md", "docType": "deployment-lifecycle", "title": "Deployment Lifecycle", "description": "Stages and status transitions", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "reference/configuration.md", "docType": "configuration-reference", "title": "SSH Configuration", "description": "SSH options, presets, error categories, and step configuration", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" }
      ]
    },
    {
      "id": "concepts",
      "title": "Concepts",
      "icon": "lightbulb",
      "description": "Architecture and design concepts",
      "documents": [
        { "path": "concepts/architecture.md", "docType": "architecture", "title": "Architecture", "description": "System design and components", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "concepts/bundle-system.md", "docType": "bundle-system", "title": "Bundle System", "description": "How mini-Vrooli bundles work", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" }
      ]
    },
    {
      "id": "internal",
      "title": "Internal",
      "icon": "wrench",
      "visibility": "developers-only",
      "description": "Internal development documentation",
      "documents": [
        { "path": "internal/SEAMS.md", "docType": "seams", "title": "Architectural Seams", "description": "Responsibility boundaries and testability seams", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "internal/PROBLEMS.md", "docType": "problems", "title": "Problems & Risks", "description": "Open issues and deferred items", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "internal/PROGRESS.md", "docType": "progress", "title": "Progress Log", "description": "Development progress tracking", "maturity": "active", "requiredBy": ["implemented"], "completion": "required" },
        { "path": "internal/RESEARCH.md", "docType": "research", "title": "Research", "description": "Research notes and findings", "maturity": "active", "requiredBy": ["oriented"], "completion": "required" }
      ]
    },
    {
      "id": "plans",
      "title": "Plans",
      "icon": "map",
      "visibility": "developers-only",
      "description": "Architecture plans and refactoring proposals",
      "documents": []
    }
  ],
  "navigation": {
    "primary": ["getting-started", "guides", "reference"],
    "secondary": ["concepts", "internal", "plans"]
  }
}
