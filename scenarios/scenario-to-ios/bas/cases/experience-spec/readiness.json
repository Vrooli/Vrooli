{
  "metadata": {
    "name": "experience-readiness-spec-smoke",
    "description": "Observer smoke for active experience page readiness.",
    "requirement": "OT-P0-009",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "readiness",
      "surface": "experience-readiness"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-readiness",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "scenario-to-ios",
          "scenario_path": "/readiness",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open Release readiness"
        }
      }
    },
    {
      "id": "wait-readiness-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.readiness",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Release readiness page visible"
        }
      }
    }
  ]
}
