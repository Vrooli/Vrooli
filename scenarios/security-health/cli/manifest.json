{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "security-health",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "ListNotes" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            { "name": "title", "required": true, "description": "Note title" },
            { "name": "body", "description": "Note body" }
          ],
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "CreateNote" },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            { "name": "id", "required": true, "description": "Note id" }
          ],
          "binding": { "kind": "connect-rpc", "service": "NotesService", "method": "GetNote" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate a scenario's security posture (secrets, Go SAST, Go vuln-DB, JS deps)",
      "commands": [
        {
          "name": "scenario",
          "description": "Run the applicable security scanners against a scenario and report normalized findings",
          "positionals": [
            { "name": "name", "required": true, "description": "Scenario id (directory name under scenarios/)" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ValidationService", "method": "ValidateScenario" },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "deps",
      "description": "Query the fleet dependency & vulnerability intelligence index",
      "commands": [
        {
          "name": "search",
          "description": "Search dependencies across scenarios; answers 'who is exposed to CVE-X?'",
          "positionals": [
            { "name": "query", "required": false, "description": "Free-text query (optional when using only filters)" }
          ],
          "flags": [
            { "name": "limit", "default": "20", "description": "Maximum results to return" },
            { "name": "mode", "description": "Retrieval mode: ai | text (default lets the server choose)" },
            { "name": "ecosystem", "description": "Filter by ecosystem: go | npm" },
            { "name": "vulnerable-only", "bool": true, "description": "Only return dependencies with known vulnerabilities" },
            { "name": "name-glob", "description": "Glob over the dependency name (e.g. 'golang.org/x/*')" }
          ],
          "binding": { "kind": "connect-rpc", "service": "DependencyService", "method": "Search" },
          "governance": { "effect": "read", "run_eligible": true, "permissions": ["network:internal"] }
        },
        {
          "name": "status",
          "description": "Report dependency-index availability, counts, and last reconcile",
          "binding": { "kind": "connect-rpc", "service": "DependencyService", "method": "Status" },
          "governance": { "effect": "read", "run_eligible": true, "permissions": ["network:internal"] }
        }
      ]
    },
    {
      "name": "reindex",
      "description": "Reconcile the fleet dependency corpus (re-walk lockfiles, re-annotate vulns)",
      "commands": [
        {
          "name": "run",
          "description": "Start a reindex job (or compute the plan with --dry-run)",
          "flags": [
            { "name": "scenario", "description": "Limit to a single scenario; empty means all" },
            { "name": "dry-run", "bool": true, "description": "Compute planned upserts/deletes without writing" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ReindexService", "method": "Reindex" },
          "governance": { "effect": "write", "run_eligible": true, "permissions": ["network:internal"] }
        },
        {
          "name": "status",
          "description": "Poll a reindex job's progress",
          "positionals": [
            { "name": "job_id", "required": true, "description": "Job id returned by `reindex run`" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ReindexService", "method": "ReindexStatus" },
          "governance": { "effect": "read", "run_eligible": true, "permissions": ["network:internal"] }
        },
        {
          "name": "cancel",
          "description": "Request cooperative cancellation of an in-flight reindex job",
          "positionals": [
            { "name": "job_id", "required": true, "description": "Job id returned by `reindex run`" }
          ],
          "binding": { "kind": "connect-rpc", "service": "ReindexService", "method": "ReindexCancel" },
          "governance": { "effect": "write", "run_eligible": true, "permissions": ["network:internal"] }
        }
      ]
    }
  ],
  "omitted": []
}
