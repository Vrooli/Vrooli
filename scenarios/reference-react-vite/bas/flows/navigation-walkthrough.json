{
  "metadata": {
    "name": "navigation-walkthrough",
    "description": "Behavioral exercise of ui/flow/navigation.json: signs in, walks the four primary top-nav affordances (Dashboard, Tasks, Projects, Settings), opens the user menu, and signs out — verifying the auth-gated and viewport-gated containers appear at the points the spec promises.",
    "labels": {
      "reset": "none",
      "navigation_spec": "reference-react-vite.app.ui"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-login",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "reference-react-vite",
          "scenario_path": "/login",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Navigate to /login" }
      }
    },
    {
      "id": "wait-login-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='login-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "Login page visible (auth_footer container)" }
      }
    },
    {
      "id": "click-login-submit",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='login-submit']" },
        "metadata": { "label": "Affordance login_submit → set_context auth=logged_in" }
      }
    },
    {
      "id": "wait-top-nav",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='top-nav-bar']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "top_nav_bar container appears (viewport=desktop AND auth=logged_in)" }
      }
    },
    {
      "id": "click-nav-tasks",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='top-nav-tasks']" },
        "metadata": { "label": "Affordance nav_tasks" }
      }
    },
    {
      "id": "wait-tasks-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='tasks-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "tasks_index route reached" }
      }
    },
    {
      "id": "click-nav-projects",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='top-nav-projects']" },
        "metadata": { "label": "Affordance nav_projects" }
      }
    },
    {
      "id": "wait-projects-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='projects-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "projects_index route reached" }
      }
    },
    {
      "id": "click-nav-settings",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='top-nav-settings']" },
        "metadata": { "label": "Affordance nav_settings" }
      }
    },
    {
      "id": "wait-settings-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='settings-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "settings_index route reached (max_clicks≤1 desktop)" }
      }
    },
    {
      "id": "click-settings-card-display",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='settings-card-display']" },
        "metadata": { "label": "Affordance settings_card_display" }
      }
    },
    {
      "id": "wait-settings-display",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='settings-display-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "settings_display route reached (max_clicks≤2 desktop)" }
      }
    },
    {
      "id": "open-user-menu",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='user-menu-trigger']" },
        "metadata": { "label": "user_menu container disclosure" }
      }
    },
    {
      "id": "click-logout",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='logout-item']" },
        "metadata": { "label": "Affordance log_out → set_context auth=logged_out → /login" }
      }
    },
    {
      "id": "wait-logged-out",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='login-page']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "Redirected back to /login" }
      }
    },
    {
      "id": "capture-final",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": { "full_page": true },
        "metadata": { "label": "Capture final logged-out state" }
      }
    }
  ]
}
