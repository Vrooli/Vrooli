{
  "metadata": {
    "name": "experience-bindings-spec-smoke",
    "description": "Generated observer smoke for active experience page bindings.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "bindings",
      "surface": "experience-bindings"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-bindings",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "program-runtime",
          "scenario_path": "/bindings",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Bindings" }
      }
    },
    {
      "id": "wait-bindings-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.bindings",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Bindings page visible" }
      }
    },
    {
      "id": "wait-binding-registry-lifecycle",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-experience-surface=\"binding-registry\"][data-experience-state=\"loading\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"ready\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"empty\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"partial\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"error\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Binding registry exposes its authored lifecycle" }
      }
    },
    {
      "id": "wait-binding-registry-terminal",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-experience-surface=\"binding-registry\"][data-experience-state=\"ready\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"empty\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"partial\"], [data-experience-surface=\"binding-registry\"][data-experience-state=\"error\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Binding registry reaches an authored terminal state" }
      }
    }
  ]
}
