{
  "$schema": "../../schemas/program-contract.schema.json",
  "name": "program-runtime.concurrent-fanout",
  "version": "1",
  "purpose": "Run three independent governed reads concurrently through gather and report the elapsed wall time with one count per result; the concurrency construction pattern.",
  "inputs": {},
  "assumptions": [
    "agent-manager, ai-gateway, and program-runtime are running"
  ],
  "invariants": [
    "no binding with effect write or destructive is called",
    "no row set is materialized; every reading is count",
    "the envelope is printed exactly once, on every path"
  ],
  "bindings": [
    {
      "id": "agent-manager/measures/run-volume",
      "effect": "read"
    },
    {
      "id": "ai-gateway/measures/total",
      "effect": "read"
    },
    {
      "id": "program-runtime/programs/mine",
      "effect": "read"
    }
  ],
  "verbs": [
    "gather"
  ],
  "outputs": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "unavailable",
        "failed"
      ]
    },
    "phase": {
      "enum": [
        "validate",
        "collect",
        "classify",
        "report"
      ]
    },
    "signals": {
      "elapsed_seconds": "wall time of the gather, rounded to milliseconds",
      "result_counts": "one count per read, in call order"
    },
    "errors": {
      "classes": [
        "scenario_unreachable",
        "no_grant",
        "not_run_eligible",
        "inference_spend_exceeded",
        "delegated_run_spend_exceeded",
        "ambiguous_response",
        "invalid_input",
        "deadline_exceeded",
        "binding_error",
        "kernel_runtime"
      ]
    },
    "evidence": "the gather timing sentence"
  },
  "budget": {
    "wall_ms": 30000,
    "inference_calls": 0,
    "delegated_runs": 0,
    "materialize_limit": 0
  },
  "fixtures": [
    {
      "id": "live",
      "inputs": {},
      "expect": {
        "status": [
          "ok"
        ]
      },
      "requires": [
        "agent-manager",
        "ai-gateway",
        "program-runtime"
      ]
    }
  ],
  "rung": "S3",
  "owner_skill": "program-runtime"
}
