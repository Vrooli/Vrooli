            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.program_runtime.v1.capabilities.DescribeResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.program_runtime.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
