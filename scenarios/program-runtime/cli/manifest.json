{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "program-runtime",
  "description": "Governed program execution, persistent sessions, typed bindings, and bounded telemetry.",
  "groups": [
    {
      "name": "bindings",
      "description": "Inspect the typed and governed callable namespace.",
      "commands": [
        {"name":"list","description":"List manifest-bound Connect callables.","flags":[{"name":"scenario","description":"Filter by scenario."},{"name":"group","description":"Filter by binding group."}],"binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"ListBindings"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"unbound","description":"List capabilities with a closed-set unbound reason.","flags":[{"name":"scenario","description":"Filter by scenario."}],"binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"ListUnbound"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"act","description":"Resolve Act operation classes against the live registry.","binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"ResolveActCells"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"doctor","description":"Report callable-binding health and unresolved arguments.","flags":[{"name":"scenario","description":"Filter by scenario."}],"binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"DoctorBindings"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"condition","description":"Report per-binding serving, freshness, and exercise condition.","flags":[{"name":"binding-id","description":"Filter by canonical binding id."},{"name":"scenario","description":"Filter by scenario."},{"name":"window-seconds","description":"Lookback window in seconds."}],"binding":{"kind":"connect-rpc","service":"vrooli.program_runtime.v1.bindings.BindingConditionService","method":"GetBindingCondition"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"},"measure":{"intent":"How many binding conditions are served for the requested filter.","questions":["how many binding conditions"],"result":{"kind":"scalar","value_field":"count","unit":"conditions","summary_template":"{count} binding conditions"}}},
        {"name":"describe","description":"Describe resolved proto paths for one binding.","positionals":[{"name":"id","required":true,"description":"Canonical binding id, such as ai-gateway/routing/preview."}],"binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"DescribeBinding"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
        ,{"name":"resolve-intent","description":"Resolve natural-language intent to governed bindings.","flags":[{"name":"intent","required":true,"description":"Natural-language operation intent."},{"name":"limit","description":"Maximum candidates, default 20."}],"binding":{"kind":"connect-rpc","service":"BindingRegistryService","method":"ResolveIntent"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
      ]
    },
    {
      "name": "sessions",
      "description": "Create and govern persistent program kernel sessions.",
      "commands": [
        {"name":"create","description":"Create a session with optional grants, sandbox workspace, and spend ceilings.","flags":[{"name":"name","description":"Optional human-readable session name."},{"name":"sandbox-workspace","description":"Optional workspace-sandbox workspace identifier."},{"name":"grants","description":"Comma-separated explicit grants."},{"name":"inference-ceiling-micros","description":"Optional per-session inference cost ceiling in USD micros."},{"name":"delegation-ceiling-micros","description":"Optional per-session delegated-run cost ceiling in USD micros."}],"binding":{"kind":"connect-rpc","service":"SessionService","method":"CreateSession"},"governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_mutation"}},
        {"name":"get","description":"Read one session lease.","positionals":[{"name":"id","required":true,"description":"Session identifier."}],"binding":{"kind":"connect-rpc","service":"SessionService","method":"GetSession"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"list","description":"List live sessions.","binding":{"kind":"connect-rpc","service":"vrooli.program_runtime.v1.sessions.SessionService","method":"ListSessions"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"},"measure":{"intent":"How many program sessions are live.","questions":["how many program sessions are live","count live sessions"],"result":{"kind":"scalar","value_field":"count","unit":"sessions","summary_template":"{count} live sessions"}}},
        {"name":"delete","description":"Reclaim a session with a stated reason.","positionals":[{"name":"id","required":true,"description":"Session identifier."}],"flags":[{"name":"reason","description":"Reason recorded for reclamation."}],"binding":{"kind":"connect-rpc","service":"SessionService","method":"DeleteSession"},"governance":{"effect":"destructive","run_eligible":true,"permissions":["admin"]},"architecture":{"primitive":"proto_mutation"}},
        {"name":"grant","description":"Add an explicit grant to a session.","positionals":[{"name":"id","required":true,"description":"Session identifier."}],"flags":[{"name":"grants","required":true,"description":"Comma-separated grants."}],"binding":{"kind":"connect-rpc","service":"SessionService","method":"GrantSession"},"governance":{"effect":"write","run_eligible":true,"permissions":["admin"]},"architecture":{"primitive":"proto_mutation"}}
      ]
    },
    {
      "name": "programs",
      "description": "Submit bounded programs and query their provenance-bearing corpus.",
      "commands": [
        {"name":"submit","description":"Execute a program in its session.","flags":[{"name":"session-id","required":true,"description":"Session identifier."},{"name":"source","description":"Python program source; mutually exclusive with source-file."},{"name":"source-file","description":"Read Python source from a file, or - for standard input; mutually exclusive with source.","local_only":true},{"name":"provenance","required":true,"description":"agent or operator provenance."},{"name":"include-materialized","bool":true,"description":"Permit explicitly materialized output in the response."}],"binding":{"kind":"connect-rpc","service":"ProgramService","method":"SubmitProgram"},"governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_mutation"}},
        {"name":"get","description":"Read one program result and failure detail.","positionals":[{"name":"id","required":true,"description":"Program identifier."}],"binding":{"kind":"connect-rpc","service":"ProgramService","method":"GetProgram"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"list","description":"List submitted programs.","flags":[{"name":"session-id","description":"Filter by session."},{"name":"include-operator","bool":true,"description":"Include operator submissions."}],"binding":{"kind":"connect-rpc","service":"ProgramService","method":"ListPrograms"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"mine","description":"Summarize recurring failure shapes.","flags":[{"name":"include-operator","bool":true,"description":"Include operator submissions."}],"binding":{"kind":"connect-rpc","service":"vrooli.program_runtime.v1.programs.ProgramService","method":"MineFailures"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"},"measure":{"intent":"How many recurring program failure shapes are recorded.","questions":["how many recurring program failure shapes","count recurring program failures"],"result":{"kind":"scalar","value_field":"count","unit":"failure_shapes","summary_template":"{count} recurring failure shapes"}}}
        ,{"name":"mine-refusals","description":"Summarize recurring binding refusals.","flags":[{"name":"include-operator","bool":true,"description":"Include operator submissions."}],"binding":{"kind":"connect-rpc","service":"vrooli.program_runtime.v1.programs.ProgramService","method":"MineRefusals"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
        ,{"name":"mine-unresolved","description":"Summarize attempted names with no governed binding.","binding":{"kind":"connect-rpc","service":"vrooli.program_runtime.v1.programs.ProgramService","method":"MineUnresolvedBindings"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
      ]
    },
    {
      "name": "telemetry",
      "description": "Read typed program lifecycle events.",
      "commands": [
        {"name":"events","description":"List typed program-runtime events.","flags":[{"name":"session-id","description":"Filter by session."},{"name":"kind","description":"Optional event kind."}],"binding":{"kind":"connect-rpc","service":"TelemetryService","method":"ListEvents"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
      ]
    }
  ],
  "measures": {
    "omitted": [],
    "domains": [
      {"domain":"bindings","stateful":true,"reason":"Binding invocations are persisted in the binding_invocations ledger."},
      {"domain":"sessions","stateful":true,"reason":"Live session leases are measured by sessions.list."},
      {"domain":"programs","stateful":true,"reason":"The submitted program corpus is measured by programs.mine."},
      {"domain":"telemetry","stateful":false,"reason":"Telemetry is a typed event projection owned by the runtime."}
    ]
  },
  "exceptions": [{"command":"space","class":"external_delegation","reason":"Shared api-core coverage-space projection is registered outside manifest-bound RPC groups."}],
  "omitted": []
}
