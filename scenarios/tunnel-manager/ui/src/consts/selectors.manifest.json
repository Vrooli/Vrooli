  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "overview",
            "exposure",
            "recovery",
            "metrics",
            "audit",
            "drift",
            "settings"
          ]
        }
      ]
    },
