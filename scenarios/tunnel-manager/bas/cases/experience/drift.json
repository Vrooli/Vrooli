{
  "metadata": {
    "name": "experience-drift",
    "description": "Navigate to the drift experience page so its active experience specification has a browser automation evidence seam.",
    "requirement": "UX-EXPERIENCE-DRIFT",
    "version": "1",
    "labels": {"spec_entry_id": "drift", "reset": "none", "purpose": "experience-contract"},
    "execution_mode": "observer"
  },
  "settings": {"viewport_width": 1280, "viewport_height": 800},
  "nodes": [
    {
      "id": "navigate-drift",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "tunnel-manager",
          "scenario_path": "/drift",
          "wait_until": "NAVIGATE_WAIT_EVENT_DOMCONTENTLOADED",
          "timeout_ms": 30000
        },
        "metadata": {"label": "Navigate to drift"}
      }
    },
    {
      "id": "wait-drift-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.drift",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {"label": "Wait for the drift surface"}
      }
    },
    {
      "id": "assert-drift-page",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.drift",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 10000,
          "failure_message": "Drift did not render its bound page surface"
        },
        "metadata": {"label": "Assert drift surface is visible"}
      }
    },
    {
      "id": "assert-drift-results-lifecycle",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-experience-surface=\"drift-results\"][data-experience-state=\"loading\"], [data-experience-surface=\"drift-results\"][data-experience-state=\"ready\"], [data-experience-surface=\"drift-results\"][data-experience-state=\"partial\"]",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 10000,
          "failure_message": "Drift results did not expose its async lifecycle surface"
        },
        "metadata": {"label": "Assert drift results lifecycle"}
      }
    }
  ]
}
