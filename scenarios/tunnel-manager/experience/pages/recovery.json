{
  "$schema": "../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-page",
  "schemaVersion": "1.0.0",
  "page": {
    "id": "recovery",
    "title": "Recovery & Events",
    "routes": [
      "/recovery"
    ],
    "purpose": "Explain tunnel recovery state, breaker risk, next action, and the evidence timeline before an operator forces recovery."
  },
  "priorities": [
    {
      "statement": "Show the state machine and next action before the event log."
    },
    {
      "statement": "Make force recovery consequences and breaker risk explicit."
    }
  ],
  "states": [
    {
      "id": "loading",
      "description": "Recovery state and events are loading.",
      "setup": {
        "route": "/recovery"
      }
    },
    {
      "id": "ready",
      "description": "State, next action, policy, and event timeline are visible.",
      "setup": {
        "route": "/recovery"
      }
    },
    {
      "id": "empty",
      "description": "No recovery events have occurred and normal operation is explicit.",
      "setup": {
        "route": "/recovery"
      }
    },
    {
      "id": "partial",
      "description": "State is available while event history is incomplete.",
      "setup": {
        "route": "/recovery"
      }
    },
    {
      "id": "stale",
      "description": "Last known recovery state remains visible during refresh.",
      "setup": {
        "route": "/recovery"
      }
    },
    {
      "id": "request-error",
      "description": "Recovery data failed and can be retried.",
      "setup": {
        "route": "/recovery"
      }
    }
  ],
  "regions": [{"id":"recovery-results","purpose":"Render recovery state and event evidence through loading, ready, partial, and failed states.","component":{"library":{"component":"experience-surface","version":"1.0.0"}},"lifecycle":{"kind":"async","states":["loading","ready","empty","partial","error"]}}],
  "elements": [
    {
      "id": "page",
      "role": "region",
      "name": "Recovery manager"
    },
    {
      "id": "state",
      "role": "region",
      "name": "Recovery state"
    },
    {
      "id": "timeline",
      "role": "region",
      "name": "Recovery event timeline"
    },
    {
      "id": "confirm",
      "role": "dialog",
      "name": "Recovery confirmation"
    }
  ],
  "claims": [
    {
      "id": "page-present",
      "type": "element-present",
      "statement": "The Recovery & Events page exposes a stable named main region.",
      "tier": "machine",
      "elements": [
        "page"
      ],
      "states": [
        "loading",
        "ready",
        "empty",
        "partial",
        "stale",
        "request-error"
      ]
    },
    {
      "id": "force-is-guarded",
      "type": "custom",
      "statement": "Force recovery explains consequences and requires confirmation.",
      "tier": "manual"
    }
  ],
  "bindings": {
    "regions": {"recovery-results":{"selector":"[data-experience-surface=\"recovery-results\"]"}},
    "elements": {
      "page": {
        "testid": "page-recovery"
      },
      "state": { "testid": "recovery-state-panel" },
      "timeline": { "testid": "recovery-timeline" },
      "confirm": { "testid": "recovery-confirm-dialog" }
    }
  }
}
