{
  "$schema": "../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-page",
  "schemaVersion": "1.0.0",
  "page": {
    "id": "drift",
    "title": "Ingress Drift",
    "routes": [
      "/drift"
    ],
    "purpose": "Compare live ingress, the route manifest, and ownership state, then make prune or adoption consequences explicit."
  },
  "priorities": [
    {
      "statement": "Distinguish managed, external, and unmanaged ingress."
    },
    {
      "statement": "Require explicit confirmation before removing ingress or changing ownership."
    }
  ],
  "states": [
    {
      "id": "loading",
      "description": "Live ingress and ledger comparison is loading.",
      "setup": {
        "route": "/drift"
      }
    },
    {
      "id": "ready",
      "description": "Drift findings and ownership actions are visible.",
      "setup": {
        "route": "/drift"
      }
    },
    {
      "id": "empty",
      "description": "No drift is present.",
      "setup": {
        "route": "/drift"
      }
    },
    {
      "id": "partial",
      "description": "Some live ingress data is unavailable while known entries remain visible.",
      "setup": {
        "route": "/drift"
      }
    },
    {
      "id": "stale",
      "description": "Last comparison remains visible during refresh.",
      "setup": {
        "route": "/drift"
      }
    },
    {
      "id": "request-error",
      "description": "Drift comparison failed and identifies the source.",
      "setup": {
        "route": "/drift"
      }
    }
  ],
  "regions": [{"id":"drift-results","purpose":"Render ingress comparison through loading, ready, empty, partial, stale, and failed states.","component":{"library":{"component":"experience-surface","version":"1.0.0"}},"lifecycle":{"kind":"async","states":["loading","ready","empty","partial","error"]}}],
  "elements": [
    {
      "id": "page",
      "role": "region",
      "name": "Ingress drift"
    },
    {
      "id": "table",
      "role": "region",
      "name": "Ingress drift table"
    },
    {
      "id": "confirm",
      "role": "dialog",
      "name": "Prune confirmation"
    }
  ],
  "claims": [
    {
      "id": "page-present",
      "type": "element-present",
      "statement": "The Ingress Drift page exposes a stable named main region.",
      "tier": "machine",
      "elements": [
        "page"
      ],
      "states": [
        "loading",
        "ready",
        "empty",
        "partial",
        "stale",
        "request-error"
      ]
    },
    {
      "id": "prune-is-confirmed",
      "type": "custom",
      "statement": "Prune explains what will be removed and requires explicit confirmation before mutation.",
      "tier": "manual"
    }
  ],
  "bindings": {
    "regions": {"drift-results":{"selector":"[data-experience-surface=\"drift-results\"]"}},
    "elements": {
      "page": {
        "testid": "page-drift"
      },
      "table": { "testid": "drift-table" },
      "confirm": { "testid": "drift-confirm-dialog" }
    }
  }
}
