{
  "id": "refactor-test-focus",
  "name": "Refactor & Test Focus",
  "description": "For scenarios that work but need quality improvement. Focuses on testing and code quality.",
  "phases": [
    {
      "id": "refactor-test-focus-test",
      "mode": "test",
      "stop_conditions": [
        {
          "type": "compound",
          "operator": "AND",
          "conditions": [
            {
              "type": "simple",
              "metric": "unit_test_coverage",
              "compare_operator": ">",
              "value": 85
            },
            {
              "type": "simple",
              "metric": "integration_test_coverage",
              "compare_operator": ">",
              "value": 75
            }
          ]
        }
      ],
      "max_iterations": 20
    },
    {
      "id": "refactor-test-focus-refactor",
      "mode": "refactor",
      "stop_conditions": [
        {
          "type": "simple",
          "metric": "tidiness_score",
          "compare_operator": ">",
          "value": 90
        }
      ],
      "max_iterations": 15
    },
    {
      "id": "refactor-test-focus-test-stability",
      "mode": "test",
      "stop_conditions": [
        {
          "type": "simple",
          "metric": "flaky_tests",
          "compare_operator": "==",
          "value": 0
        }
      ],
      "max_iterations": 10
    }
  ],
  "quality_gates": [],
