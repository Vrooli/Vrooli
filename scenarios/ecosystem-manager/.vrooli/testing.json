{
  "$schema": "https://vrooli.com/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for ecosystem-manager",
    "last_updated": "2026-06-08T00:00:00Z"
  },
  "version": "1.0.0",
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "policy": {
      "unconfigured_common_components": {
        "api": "error",
        "ui": "warning",
        "cli": "warning"
      },
      "unmatched_code_components": "warning"
    }
  },
  "unit": {
    "languages": {
      "go": {
        "coverage": {
          "error_threshold": 30
        }
      }
    },
    "options": {
      "verbose": false
    }
  }
}
