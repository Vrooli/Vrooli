  "service": {
    "name": "ecosystem-manager",
    "displayName": "Ecosystem Manager",
    "description": "Unified system for generating and improving resources and scenarios",
    "version": "1.0.0",
    "tags": [
      "management",
      "resource-generator",
      "scenario-generator",
      "ai-orchestration",
      "metadata",
      "maintenance",
      "self-improvement"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/ecosystem-manager"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Ecosystem Manager API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 21110,
      "description": "Ecosystem Manager UI port"
    }
  },
  "hostTools": [
    {
      "name": "bats",
      "required": false,
      "reason": "Parse and reason about BATS-based shell metrics and generated test artifacts during scenario analysis",
      "when": [
        "setup",
        "develop",
        "test"
      ],
      "environments": [
        "development"
      ],
      "notes": "Ecosystem analysis can continue without bats, but shell-test introspection is reduced"
    }
  ],
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Ecosystem Manager health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 10000,
      "interval": 30000,
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Initialize Ecosystem Manager",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/ecosystem-manager-api"
            ]
          },
          {
            "type": "cli",
            "command": "ecosystem-manager"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && if [ ! -f go.sum ]; then go mod tidy; fi && go build -o ecosystem-manager-api main.go",
          "description": "Build Go API binary"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies if package.json exists",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI"
        },
        {
          "name": "validate-prompts",
          "run": "python3 -c \"import yaml; yaml.safe_load(open('prompts/sections.yaml'))\" || echo 'Warning: Prompts configuration may have YAML errors'",
          "description": "Validate prompts configuration",
          "condition": {
            "file_exists": "prompts/sections.yaml"
          }
        },
        {
          "name": "set-permissions",
          "run": "chmod +x api/ecosystem-manager-api || true",
          "description": "Set executable permissions"
        }
      ]
    },
    "develop": {
      "description": "Start Ecosystem Manager services",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./ecosystem-manager-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/ecosystem-manager-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && NODE_ENV=production node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Comprehensive phased testing for ecosystem-manager",
      "steps": [
        {
          "name": "run-phased-tests",
          "run": "test-genie execute ecosystem-manager --preset comprehensive",
          "description": "Execute phased scenario test suite"
        }
      ]
    },
    "stop": {
      "description": "Stop Ecosystem Manager services",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f \"ecosystem-manager-api\" || true; sleep 1; pkill -9 -f \"ecosystem-manager-api\" 2>/dev/null || true",
          "description": "Stop API process"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f \"scenarios/ecosystem-manager.*vite\" || true; sleep 1; pkill -9 -f \"scenarios/ecosystem-manager.*vite\" 2>/dev/null || true",
          "description": "Stop UI process"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "claude-code": {
        "type": "claude-code",
        "enabled": true,
        "required": true,
        "description": "AI for resource and scenario generation"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "description": "Semantic search and similarity matching"
      },
      "redis": {
        "type": "redis",
        "enabled": false,
        "required": false,
        "description": "Optional caching layer"
      },
      "openrouter": {
        "type": "openrouter",
        "enabled": true,
        "required": false,
        "startup_policy": "try_start",
        "description": "Optional cloud model provider for recycler workflows and model selection",
        "degraded_behavior": "OpenRouter-backed recycler runs and model discovery are unavailable until OPENROUTER_API_KEY is configured"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (heuristic)",
        "model_roles": [
          "chat.default",
          "chat.small"
        ]
      },
      "minio": {
        "type": "minio",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (heuristic)"
      }
    },
    "scenarios": {
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": true,
        "description": "Centralized agent orchestration for task execution through Ecosystem Manager's declared role-only profile.",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/default.json"
            ]
          }
        }
      },
      "prompt-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Provides steering prompts for Auto Steer functionality (optional - graceful degradation)"
      },
      "visited-tracker": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Tracks visited resources/scenarios for campaign management (optional - proxied via API)"
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "ecosystem-manager",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "ecosystem-manager"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    }
  }
}
