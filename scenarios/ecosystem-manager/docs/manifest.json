  "description": "Documentation contract for the ecosystem-manager scenario: the autonomous generation-and-improvement control plane",
  "defaultDocument": "START-HERE.md",
  "contract": {
    "kind": "scenario-docs",
    "template": "react-vite",
    "schema": "scenario-docs-manifest/v2",
    "maturityValues": [
      "missing",
      "stub",
      "draft",
      "active",
      "not-applicable",
      "deferred",
      "retired"
    ],
    "stages": [
      "generated",
      "oriented",
      "implemented",
      "validated",
      "deployable",
      "monetizable"
    ],
    "extensionRule": "Every durable scenario document should be registered here. Use docs/concepts/ for product and system concepts (CONTROL-MODEL.md is the canonical improvement-loop model), docs/guides/ for task procedures, docs/reference/ for stable lookup material, docs/internal/ for developer and agent memory, docs/operations/ for runtime operations, and docs/business/ for commercial strategy."
  },
