{
  "schemaVersion": 6,
  "kind": "temporal",
  "flowId": "tasks.lifecycle.api",
  "domain": "tasks",
  "description": "Queue task lifecycle: a task moves pending -> in-progress, then to completed or failed, may requeue back to pending (rate-limit/recycle/retry), and is finalized (completed-finalized / failed-blocked) or archived. Mirrors api/pkg/tasks status transitions.",
  "model": {
    "module": "TaskLifecycleWorkflow",
    "seed": "2026060801",
    "maxSteps": 7,
    "traceCount": 8,
    "verify": {
      "invariants": [
        "TypeOK",
        "TerminalClosure",
        "IllegalTransitionsPreserveState",
        "FinalizeSuccessRequiresCompleted",
        "FinalizeFailureRequiresFailed"
      ]
    }
  },
  "states": [
    { "id": "pending", "quint": "Pending", "initial": true },
    { "id": "in_progress", "quint": "InProgress" },
    { "id": "completed", "quint": "Completed" },
    { "id": "failed", "quint": "Failed" },
    { "id": "completed_finalized", "quint": "CompletedFinalized", "terminal": true },
    { "id": "failed_blocked", "quint": "FailedBlocked", "terminal": true },
    { "id": "archived", "quint": "Archived", "terminal": true }
  ],
  "events": [
    { "id": "start", "quint": "Start" },
    { "id": "succeed", "quint": "Succeed" },
    { "id": "fail", "quint": "Fail" },
    { "id": "requeue", "quint": "Requeue" },
    { "id": "finalize_success", "quint": "FinalizeSuccess" },
    { "id": "finalize_failure", "quint": "FinalizeFailure" },
    { "id": "archive", "quint": "Archive" }
  ],
  "transitionDefaults": {
    "invalid": { "to": "self", "wantError": true },
    "terminal": { "to": "self", "wantError": true }
  },
  "transitions": [
    { "from": "pending", "event": "start", "to": "in_progress" },
    { "from": "in_progress", "event": "succeed", "to": "completed" },
    { "from": "in_progress", "event": "fail", "to": "failed" },
    { "from": "in_progress", "event": "requeue", "to": "pending" },
    { "from": "completed", "event": "requeue", "to": "pending" },
    { "from": "completed", "event": "finalize_success", "to": "completed_finalized" },
    { "from": "completed", "event": "archive", "to": "archived" },
    { "from": "failed", "event": "requeue", "to": "pending" },
    { "from": "failed", "event": "finalize_failure", "to": "failed_blocked" },
    { "from": "failed", "event": "archive", "to": "archived" }
  ],
  "invariants": [
    { "id": "type_ok", "quint": "TypeOK", "description": "Model variables remain inside declared state and event sets." },
    { "id": "terminal_closure", "quint": "TerminalClosure", "description": "Finalized/archived terminal states cannot transition to another status." },
    { "id": "illegal_transitions_preserve_state", "quint": "IllegalTransitionsPreserveState", "description": "Rejected transitions are state preserving." },
    {
      "id": "finalize_success_requires_completed",
      "quint": "FinalizeSuccessRequiresCompleted",
      "description": "A success finalization is only valid from the completed state.",
      "expression": "not(isValid(status, FinalizeSuccess)) or status == Completed"
    },
    {
      "id": "finalize_failure_requires_failed",
      "quint": "FinalizeFailureRequiresFailed",
      "description": "A failure finalization is only valid from the failed state.",
      "expression": "not(isValid(status, FinalizeFailure)) or status == Failed"
    }
  ],
  "traces": [
    {
      "name": "happy_completion",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "succeed", "want": "completed", "wantError": false },
        { "event": "finalize_success", "want": "completed_finalized", "wantError": false }
      ]
    },
    {
      "name": "failure_block",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "fail", "want": "failed", "wantError": false },
        { "event": "finalize_failure", "want": "failed_blocked", "wantError": false }
      ]
    },
    {
      "name": "requeue_from_progress",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "requeue", "want": "pending", "wantError": false }
      ]
    },
    {
      "name": "recycle_from_completed",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "succeed", "want": "completed", "wantError": false },
        { "event": "requeue", "want": "pending", "wantError": false }
      ]
    },
    {
      "name": "terminal_rejects_event",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "succeed", "want": "completed", "wantError": false },
        { "event": "finalize_success", "want": "completed_finalized", "wantError": false },
        { "event": "start", "want": "completed_finalized", "wantError": true }
      ]
    },
    {
      "name": "illegal_finalize_from_pending",
      "initial": "pending",
      "steps": [
        { "event": "finalize_success", "want": "pending", "wantError": true }
      ]
    },
    {
      "name": "archive_completed",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "succeed", "want": "completed", "wantError": false },
        { "event": "archive", "want": "archived", "wantError": false }
      ]
    },
    {
      "name": "archive_failed",
      "initial": "pending",
      "steps": [
        { "event": "start", "want": "in_progress", "wantError": false },
        { "event": "fail", "want": "failed", "wantError": false },
        { "event": "archive", "want": "archived", "wantError": false }
      ]
    }
  ],
  "runtime": {
    "go": {
      "package": "flow",
      "statusType": "Status",
      "eventType": "Event",
      "constantPrefix": "Lifecycle"
    }
  },
  "replay": {
    "transition": {
      "function": "TransitionLifecycle",
      "stateType": "State",
      "statusField": "Status"
    }
  }
}
