{
  "metadata": {
    "name": "desktop-verdict-journey",
    "description": "Open a desktop verdict review and read its ordered journey-step surface when producer evidence is available.",
    "requirement": "DM-EVIDENCE-DESKTOP-JOURNEY",
    "version": "1",
    "labels": { "reset": "none", "purpose": "desktop-evidence-review", "safety": "read-only" },
    "execution_mode": "observer"
  },
  "settings": { "viewport_width": 1440, "viewport_height": 900 },
  "nodes": [
    { "id": "open-evidence", "action": { "type": "ACTION_TYPE_NAVIGATE", "navigate": { "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO", "scenario": "deployment-manager", "scenario_path": "/evidence", "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE", "timeout_ms": 30000 }, "metadata": { "label": "Open desktop evidence review" } } },
    { "id": "assert-step-surface", "action": { "type": "ACTION_TYPE_ASSERT", "assert": { "selector": "@selector/evidence.heading", "mode": "ASSERTION_MODE_TEXT_CONTAINS", "expected": { "stringValue": "Evidence review" }, "timeout_ms": 10000, "failure_message": "Desktop verdict review surface did not render" }, "metadata": { "label": "Journey review surface is available" } } }
  ],
  "edges": [ { "source": "open-evidence", "target": "assert-step-surface" } ]
}
