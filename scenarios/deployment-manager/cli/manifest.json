  "measures": {
    "omitted": [
      {
        "domain": "deployment_approvals",
        "reason": "Approval rows are release-gate workflow state; the supported analytical surface is the gate decision itself, not a historical count measure."
      },
      {
        "domain": "deployment_evidence_refs",
        "reason": "Artifact references are child evidence metadata returned with their owning verdict; the supported analytical measure counts verdicts and does not double-count child artifacts."
      },
      {
        "domain": "profile_lpbs_release_config",
        "reason": "LPBS release configuration is singleton operational configuration and has no independent historical measure."
      },
      {
        "domain": "profile_versions",
        "reason": "Profile versions are retrieved as deployment artifacts; version history is evidence for a profile rather than an independent analytical measure."
      },
      {
        "domain": "profiles",
        "reason": "Profiles are deployment configuration records; their operational lifecycle is exposed through profile and release operations rather than a standalone historical measure."
      },
      {
        "domain": "releases",
        "reason": "Release rows are the deployment workflow record consumed through release status and evidence review; no separate count measure is exposed."
      }
