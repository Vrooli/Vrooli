  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "qualityWorkbench.surfaceCard": {
      "description": "Surface breakdown card by discovered surface id",
      "selectorPattern": "[data-testid=\"quality-workbench-surface-${id}\"]",
      "testIdPattern": "quality-workbench-surface-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "qualityWorkbench.findingRow": {
      "description": "Finding row by stable finding id",
      "selectorPattern": "[data-testid=\"quality-workbench-finding-${id}\"]",
      "testIdPattern": "quality-workbench-finding-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "qualityWorkbench.autofixCandidate": {
      "description": "Autofix candidate by rule id",
      "selectorPattern": "[data-testid=\"quality-workbench-autofix-${ruleId}\"]",
      "testIdPattern": "quality-workbench-autofix-${ruleId}",
      "params": [
        {
          "name": "ruleId",
          "type": "string"
        }
      ]
    }
  },
