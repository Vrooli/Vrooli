{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "scenario-completeness-scoring status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "measures_count_fleet_below_rung",
      "path": "/vrooli.scenario_completeness_scoring.v1.measures.MeasuresService/CountFleetBelowRung",
      "method": "POST",
      "summary": "Count scenarios below a maturity rung",
      "description": "Counts latest score snapshots per scenario inside a time window whose working rung is below the requested threshold.",
      "category": "measures"
    },
    {
      "id": "measures_average_composite",
      "path": "/vrooli.scenario_completeness_scoring.v1.measures.MeasuresService/AverageComposite",
      "method": "POST",
      "summary": "Average fleet composite score",
      "description": "Averages the latest composite score per scenario inside a time window.",
      "category": "measures"
    },
    {
      "id": "measures_score_series",
      "path": "/vrooli.scenario_completeness_scoring.v1.measures.MeasuresService/ScoreSeries",
      "method": "POST",
      "summary": "Fleet score series",
      "description": "Returns a daily fleet-average completeness score series over persisted score snapshots.",
      "category": "measures"
    },
    {
      "id": "measures_declarations",
      "path": "/measures/declarations",
      "method": "GET",
      "summary": "List declared measures",
      "description": "Measures-go registry declarations harvested by measures-health and search-hub.",
      "category": "measures",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "measures-go serves a framework-neutral harvest endpoint consumed without a generated client."
      }
    },
    {
      "id": "measures_execute",
      "path": "/measures/execute",
      "method": "POST",
      "summary": "Execute a declared measure",
      "description": "Measures-go registry execution endpoint used by measures-health behavioral probes and search-hub federation.",
      "category": "measures",
      "rest_exception": {
        "reason": "ops_probe",
        "note": "measures-go serves a uniform JSON execution endpoint shared across scenarios."
      }
    },
    {
      "id": "scoring_get",
      "path": "/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/GetScore",
      "method": "POST",
      "summary": "Get a scenario's completeness score",
      "description": "Computes the cached-artifact status payload for one scenario: maturity rung (as of tree digest), 0-100 composite with classification and breakdown, prioritized recommendations with point impact, action plan, and per-phase freshness verdicts with a refresh command. Filesystem-only; <1s warm.",
      "category": "scoring",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string (required, scenario directory name)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "action_plan": "array<ActionPhase>",
          "calculated_at": "Timestamp",
          "category": "string",
          "composite": "CompositeScore",
          "degradations": "array<CollectorDegradation>",
          "freshness": "FreshnessBlock",
          "maturity": "MaturityHeadline",
          "recommendations": "array<Recommendation>",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown scenario name"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Score assembly failure"
        }
      ],
      "examples": [
        {
          "name": "Score a scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/GetScore -H 'Content-Type: application/json' -d '{\"scenario\":\"cli-health\"}'"
        }
      ],
      "cli_mapping": {
        "command": "scenario-completeness-scoring score get",
        "args": [
          "<scenario>"
        ]
      }
    },
    {
      "id": "scoring_trend",
      "path": "/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/GetScoreTrend",
      "method": "POST",
      "summary": "Get a scenario's score trend",
      "description": "Reads digest-deduplicated score snapshots for one scenario from the persisted score history store, newest first.",
      "category": "scoring",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (optional)",
          "scenario": "string (required, scenario directory name)",
          "since": "Timestamp (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "scenario": "string",
          "snapshots": "array<ScoreSnapshot>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Trend read failure"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Snapshot repository unavailable"
        }
      ],
      "examples": [
        {
          "name": "Trend for a scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/GetScoreTrend -H 'Content-Type: application/json' -d '{\"scenario\":\"cli-health\",\"limit\":10}'"
        }
      ],
      "cli_mapping": {
        "command": "scenario-completeness-scoring score trend",
        "args": [
          "<scenario>"
        ]
      }
    },
    {
      "id": "scoring_list",
      "path": "/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/ListScores",
      "method": "POST",
      "summary": "List latest scenario scores",
      "description": "Reads the latest persisted score snapshot per scenario with server-side sort, filter, and pagination. This path is O(query) over score_snapshots and never recomputes the fleet.",
      "category": "scoring",
      "request": {
        "type": "object",
        "properties": {
          "category": "string (optional)",
          "max_score": "int32 (optional)",
          "min_score": "int32 (optional)",
          "order": "SortOrder",
          "page_size": "int32",
          "page_token": "string",
          "recompute": "bool (optional, page-bounded later phase)",
          "rung": "string (optional)",
          "sort_by": "ScoreSortBy"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "next_page_token": "string",
          "scores": "array<ScoreRow>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Bad page_token"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "List read failure"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Snapshot repository unavailable"
        }
      ],
      "examples": [
        {
          "name": "List lowest scores",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_completeness_scoring.v1.scoring.ScoreService/ListScores -H 'Content-Type: application/json' -d '{\"sort_by\":\"SCORE_SORT_BY_COMPOSITE\",\"order\":\"SORT_ORDER_ASC\",\"page_size\":10}'"
        }
      ],
      "cli_mapping": {
        "command": "scenario-completeness-scoring score list"
      }
    }
  ],
  "cli_commands": [
    {
      "name": "configure",
      "description": "View or update CLI settings (api_base, token)",
      "endpoint_id": ""
    },
    {
      "name": "score get",
      "description": "Get the full status payload for a scenario (rung as of tree digest, 0-100 composite, recommendations, action plan, per-phase freshness)",
      "endpoint_id": "scoring_get"
    },
    {
      "name": "score list",
      "description": "List latest persisted scenario scores with server-side sort, filter, and pagination",
      "endpoint_id": "scoring_list"
    },
    {
      "name": "score trend",
      "description": "Get persisted score history for a scenario",
      "endpoint_id": "scoring_trend"
    },
    {
      "name": "status",
      "description": "Check API health",
      "endpoint_id": "health"
    }
  ]
}
