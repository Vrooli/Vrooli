  "dynamicSelectors": {
    "scoring.freshnessPhaseRow": {
      "description": "Freshness verdict row by required-phase name",
      "selectorPattern": "[data-testid=\"scoring-freshness-phase-${phase}\"]",
      "testIdPattern": "scoring-freshness-phase-${phase}",
      "params": [
        {
          "name": "phase",
          "type": "string"
        }
      ]
    },
    "scoring.compositeGroup": {
      "description": "Composite score group section by stable group id",
      "selectorPattern": "[data-testid=\"scoring-composite-group-${id}\"]",
      "testIdPattern": "scoring-composite-group-${id}",
      "params": [
        {
          "name": "id",
          "type": "enum",
          "values": [
            "quality",
            "coverage",
            "quantity",
            "ui"
          ]
        }
      ]
    },
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.navLink": {
      "description": "App shell navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-link-${key}\"]",
      "testIdPattern": "layout-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    }
  },
