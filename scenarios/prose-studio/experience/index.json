      "path": "pages/variation-board.json",
      "title": "Variation Board",
      "status": "active"
    },
    {
      "id": "style-library",
      "path": "pages/style-library.json",
      "title": "Style Library",
      "status": "active"
    },
    {
      "id": "document-workspace",
      "path": "pages/document-workspace.json",
      "title": "Document Workspace",
      "status": "active"
    },
    {
      "id": "declaration-registry",
      "path": "pages/declaration-registry.json",
      "title": "Declaration Registry",
      "status": "active"
    },
    {
      "id": "settings",
      "path": "pages/settings.json",
      "title": "Settings",
      "status": "active"
    },
    {
      "id": "notes",
      "path": "pages/notes.json",
      "title": "Notes",
      "status": "active"
    }
  ],
  "journeys": [
    {
      "id": "blog-post-from-declared-style",
