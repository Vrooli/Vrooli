      "status": "active"
    },
    {
      "id": "diagnose-a-refused-profile",
      "path": "journeys/diagnose-a-refused-profile.json",
      "title": "Diagnose why a profile will not generate",
      "status": "active"
    },
    {
      "id": "converge-a-single-passage",
      "path": "journeys/converge-a-single-passage.json",
      "title": "Converge one passage without ranking by taste",
      "status": "active"
    }
  ]
}
