{
  "metadata": {
    "name": "experience-document-workspace-spec-smoke",
    "description": "Observer smoke for the long-form document workspace.",
    "requirement": "OT-P0-019",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "document-workspace",
      "surface": "experience-document-workspace"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-document",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "prose-studio",
          "scenario_path": "/document",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Document Workspace" }
      }
    },
    {
      "id": "wait-document-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.document",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Document Workspace visible" }
      }
    }
  ]
}
