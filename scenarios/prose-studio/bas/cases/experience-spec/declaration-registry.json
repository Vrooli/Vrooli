{
  "metadata": {
    "name": "experience-declaration-registry-spec-smoke",
    "description": "Observer smoke for the consumer declaration registry.",
    "requirement": "OT-P0-025",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "declaration-registry",
      "surface": "experience-declaration-registry"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-declarations",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "prose-studio",
          "scenario_path": "/declarations",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Declaration Registry" }
      }
    },
    {
      "id": "wait-declarations-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.declarations",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Declaration Registry visible" }
      }
    }
  ]
}
