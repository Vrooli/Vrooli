{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.prose_studio.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.prose_studio.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "jobs_list_openings",
      "path": "/api/v1/jobs/openings",
      "method": "GET",
      "summary": "List saved job openings",
      "description": "Returns persisted openings with category, status, source, and role details.",
      "category": "jobs",
      "response": {
        "type": "Response",
        "properties": {
          "openings": "array<Opening>"
        }
      },
      "rest_exception": {
        "reason": "browser_surface",
        "note": "Browser UI JSON API for the job application pipeline; the UI contract is intentionally exposed as REST and has no generated Connect procedure or proto payload counterpart."
      }
    },
    {
      "id": "jobs_create_opening",
      "path": "/api/v1/jobs/openings",
      "method": "POST",
      "summary": "Save a job opening",
      "description": "Persists a job opening for tracking in the application pipeline.",
      "category": "jobs",
      "request": {
        "type": "Opening",
        "properties": {
          "category": "string",
          "company": "string",
          "description": "string",
          "location": "string",
          "source": "string",
          "source_id": "string",
          "status": "string",
          "title": "string",
          "url": "string"
        }
      },
      "response": {
        "type": "Response",
        "properties": {
          "opening": "Opening"
        }
      },
      "rest_exception": {
        "reason": "browser_surface",
        "note": "Browser UI JSON API for the job application pipeline; the UI contract is intentionally exposed as REST and has no generated Connect procedure or proto payload counterpart."
      }
    },
    {
      "id": "jobs_update_opening",
      "path": "/api/v1/jobs/openings/{id}",
      "method": "PATCH",
      "summary": "Update an opening",
      "description": "Updates opening details, including its pipeline status or category.",
      "category": "jobs",
      "request": {
        "type": "OpeningPatch",
        "properties": {
          "category": "string",
          "company": "string",
          "description": "string",
          "location": "string",
          "source": "string",
          "source_id": "string",
          "status": "string",
          "title": "string",
          "url": "string"
        }
      },
      "response": {
        "type": "Response",
        "properties": {
          "opening": "Opening"
        }
      },
      "rest_exception": {
        "reason": "browser_surface",
        "note": "Browser UI JSON API for the job application pipeline; the UI contract is intentionally exposed as REST and has no generated Connect procedure or proto payload counterpart."
      }
    },
    {
      "id": "jobs_list_facts",
