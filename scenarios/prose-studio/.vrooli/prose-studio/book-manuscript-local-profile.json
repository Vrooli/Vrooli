{
  "schema_version": "1",
  "kind": "profile",
  "key": "prose-studio/book-manuscript-local",
  "created_by": "prose-studio",
  "record": {
    "style_refs": ["prose-studio/blog"],
    "sampler": {"kind": "direct", "k": 1, "temperature_stance": "ignored", "max_output_tokens": 2048},
    "selection_policy": "take_first",
    "gateway_role": "write.default",
    "locality": "local_only",
    "budget": {"max_output_tokens": 2048, "max_session_cost_micros": 0},
    "context_policy": {"full_text_token_budget": 1024, "summarize_beyond": 1024, "always_full_previous": false},
    "constraints": {"max_words": 8800, "required_format": "rich_prose"},
    "composition": {
      "target_section_words": 550,
      "min_sections": 4,
      "max_sections": 16,
      "section_word_tolerance": 0.2,
      "section_format": "rich_prose",
      "section_max_output_tokens": 2048,
      "max_repair_rounds": 1
    }
  }
}
