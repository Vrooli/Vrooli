{
  "kind": "openapi-catalog",
  "services": [
    {
      "id": "synthetic-task-sheet",
      "document": {
        "openapi": "3.0.3",
        "info": {
          "title": "Synthetic task spreadsheet",
          "version": "1"
        },
        "servers": [
          {
            "url": "https://sheets.synthetic.invalid"
          }
        ],
        "paths": {
          "/v1/tasks/read": {
            "get": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": [
                        {
                          "row_number": 2,
                          "taskName": "Prepare synthetic release notes",
                          "priority": "high",
                          "category": "Operations",
                          "dueDate": "2026-11-13",
                          "status": "pending",
                          "createdAt": "2026-11-12T10:00:00Z"
                        },
                        {
                          "row_number": 3,
                          "taskName": "Review synthetic onboarding copy",
                          "priority": "medium",
                          "category": "Content",
                          "dueDate": "2026-11-14",
                          "status": "pending",
                          "createdAt": "2026-11-12T10:05:00Z"
                        }
                      ]
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.googleSheets",
              "x-n8n-resource": "sheet",
              "x-n8n-operation": "read"
            }
          },
          "/v1/tasks/append": {
            "post": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "status": "recorded",
                        "row_number": 4
                      }
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.googleSheets",
              "x-n8n-resource": "sheet",
              "x-n8n-operation": "append"
            }
          },
          "/v1/tasks/update": {
            "put": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "status": "recorded"
                      }
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.googleSheets",
              "x-n8n-resource": "sheet",
              "x-n8n-operation": "update"
            }
          }
        }
      }
    },
    {
