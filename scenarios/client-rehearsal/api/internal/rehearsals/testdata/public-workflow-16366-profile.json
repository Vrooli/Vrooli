                          {
                            "content": [
                              {
                                "text": "Synthetic summary: prioritize release notes, then review onboarding copy."
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              },
              "x-n8n-node-type": "@n8n/n8n-nodes-langchain.openAi",
