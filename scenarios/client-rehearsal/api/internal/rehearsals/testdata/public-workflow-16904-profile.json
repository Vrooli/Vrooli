{
  "kind": "openapi-catalog",
  "services": [
    {
      "id": "synthetic-attendance-sheet",
      "document": {
        "openapi": "3.0.3",
        "info": { "title": "Synthetic attendance sheet", "version": "1" },
        "servers": [{ "url": "https://sheets.synthetic.invalid" }],
        "paths": {
          "/v1/attendees/read": {
            "get": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": [{ "email": "prior@synthetic.invalid" }]
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.googleSheets",
              "x-n8n-resource": "sheet",
              "x-n8n-operation": "read"
            }
          },
          "/v1/attendees/append": {
            "post": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": { "status": "recorded", "rowId": "synthetic-row-1" }
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.googleSheets",
              "x-n8n-resource": "sheet",
              "x-n8n-operation": "append"
            }
          }
        }
      }
    },
    {
      "id": "synthetic-attendance-mail",
      "document": {
        "openapi": "3.0.3",
        "info": { "title": "Synthetic attendance mail", "version": "1" },
        "servers": [{ "url": "https://mail.synthetic.invalid" }],
        "paths": {
          "/v1/messages": {
            "post": {
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": { "id": "synthetic-message-1", "status": "recorded" }
                    }
                  }
                }
              },
              "x-n8n-node-type": "n8n-nodes-base.gmail",
              "x-n8n-resource": "message",
              "x-n8n-operation": "send"
            }
          }
        }
      }
    }
  ]
}
