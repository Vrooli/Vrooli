{
  "kind": "openapi-catalog",
  "services": [
    {
      "id": "notion",
      "document": {
        "openapi": "3.0.3",
        "info": {
          "title": "Synthetic Notion Pages",
          "version": "1"
        },
        "servers": [
          {
            "url": "https://notion.synthetic.invalid"
          }
        ],
        "paths": {
          "/v1/create": {
            "post": {
              "x-n8n-node-type": "n8n-nodes-base.notion",
              "x-n8n-resource": "databasePage",
              "x-n8n-operation": "create",
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "id": "page-synthetic-001",
                        "url": "https://notion.synthetic.invalid/page-synthetic-001",
                        "status": "created"
                      }
                    }
                  }
                }
              }
            }
          },
          "/v1/getAll": {
            "get": {
              "x-n8n-node-type": "n8n-nodes-base.notion",
              "x-n8n-resource": "databasePage",
              "x-n8n-operation": "getAll",
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": [
                        {
                          "id": "page-synthetic-001",
                          "url": "https://notion.synthetic.invalid/page-synthetic-001",
                          "status": "active"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "/v1/update": {
            "patch": {
              "x-n8n-node-type": "n8n-nodes-base.notion",
              "x-n8n-resource": "page",
              "x-n8n-operation": "update",
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "id": "page-synthetic-001",
                        "status": "updated"
                      }
                    }
                  }
                }
              }
            }
          },
          "/v1/archive": {
            "post": {
              "x-n8n-node-type": "n8n-nodes-base.notion",
              "x-n8n-resource": "page",
              "x-n8n-operation": "archive",
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "id": "page-synthetic-001",
                        "status": "archived"
                      }
                    }
                  }
                }
              }
            }
          },
          "/v1/database-pages-update": {
            "patch": {
              "x-n8n-node-type": "n8n-nodes-base.notion",
              "x-n8n-resource": "databasePage",
              "x-n8n-operation": "update",
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "example": {
                        "id": "page-synthetic-001",
                        "status": "updated"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
