    {
      "id": "62df7b6f-b648-46f6-82b7-c27bbded760c",
      "name": "Combine Pages and Posts",
      "type": "n8n-nodes-base.code",
      "position": [
        320,
        4480
      ],
      "parameters": {
        "jsCode": "function flattenItems(nodeName) {\n  const items = $(nodeName).all().map(it => it.json);\n  let flat = [];\n  for (const it of items) {\n    if (Array.isArray(it)) { flat = flat.concat(it); }\n    else if (it && typeof it === 'object' && it.id != null) { flat.push(it); }\n  }\n  return flat;\n}\nconst pagesArr = flattenItems('Fetch Static Pages');\nconst postsArr = flattenItems('Fetch Blog Posts');\nconst out = [];\nfor (const p of pagesArr) { out.push({ json: { kind: 'page', id: p.id, modified: p.modified } }); }\nfor (const p of postsArr) { out.push({ json: { kind: 'post', id: p.id, modified: p.modified } }); }\nreturn out;"
      },
      "typeVersion": 2
    },
