        "jsCode": "// Attach AI draft to lead data\nconst leadData = $('Is New Lead?').first().json;\nconst aiResponse = $input.first().json;\n\nconst emailDraft = aiResponse.message?.content || aiResponse.choices?.[0]?.message?.content || 'Draft unavailable — please write a personalised intro.';\n\nreturn [{\n  json: {\n    ...leadData,\n    emailDraft\n  }\n}];"
