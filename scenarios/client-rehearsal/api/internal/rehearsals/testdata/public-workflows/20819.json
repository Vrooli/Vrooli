    {
      "id": "ba5334cc-7b51-4d22-b8b7-71cea7d374ac",
      "name": "Create Failure Alert Message",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Escape text so Telegram's HTML parse mode shows it literally\nconst h = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// The error record built just before the sheet write\nconst E = $('Prepare Error Record').item.json;\n\n// Alert lines, top to bottom\nconst text = [\n  '❌ <b>Synthetic</b> · Workflow-level failure at ' + h(E.error_node || E.stage),\n  h(E.summary),\n  'Error: ' + h(E.error_message),\n  'Next: open the execution and fix ' + h(E.error_node || 'the failing node') + '; if an item did not reach its destination, correct it and replay the synthetic fixture.',\n  '#synthetic · run <code>' + h(E.correlation_id) + '</code> · ' + h(E.execution_url),\n].join('\\n');\n\nreturn { json: { ...$json, text } };"
      },
      "typeVersion": 2
    },
    {
      "id": "263eb3dc-ce4c-40f6-8cb8-e6fa39f8556c",
      "name": "Send Failure Alert to Telegram",
      "type": "n8n-nodes-base.telegram",
      "maxTries": 3,
      "position": [
        944,
        0
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "chatId": "",
        "resource": "message",
        "operation": "sendMessage",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "retryOnFail": true,
      "typeVersion": 1.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "208dc4d4-e832-46fe-bb7b-6d3ee0f2347a",
      "name": "Create Sheet Down Alert Message",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        368
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Escape text so Telegram's HTML parse mode shows it literally\nconst h = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// The error record built just before the sheet write\nconst E = $('Prepare Error Record').item.json;\n\n// Same alert, plus a line saying the sheet write failed\nconst text = [\n  '❌ <b>Synthetic</b> · Workflow-level failure at ' + h(E.error_node || E.stage) + ' (Error Log row NOT written)',\n  h(E.summary),\n  'Error: ' + h(E.error_message),\n  '⚠️ Error Log row not written: ' + h($json.error?.message ?? $json.error),\n  'Next: open the execution and fix ' + h(E.error_node || 'the failing node') + '; if an item did not reach its destination, correct it and replay the synthetic fixture.',\n  '#synthetic · run <code>' + h(E.correlation_id) + '</code> · ' + h(E.execution_url),\n].join('\\n');\n\nreturn { json: { ...$json, text } };"
      },
      "typeVersion": 2
    },
    {
      "id": "2c2c70fe-09cb-4edb-8515-b9bd899d5e66",
      "name": "Send Sheet Down Alert to Telegram",
