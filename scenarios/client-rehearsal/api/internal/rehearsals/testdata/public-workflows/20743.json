{"name":"Extract invoice data with AI and sync it to your accounting software","nodes":[{"name":"Invoice Webhook","type":"n8n-nodes-base.webhook","position":[0,420],"parameters":{"path":"synthetic-path","options":{},"httpMethod":"POST","responseMode":"responseNode"},"typeVersion":2,"id":"synthetic-node-1"},{"name":"CONFIG - Invoices","type":"n8n-nodes-base.set","position":[260,420],"parameters":{"include":"all","options":{},"assignments":{"assignments":[{"name":"owner_email","type":"string","value":"synthetic-recipient@example.invalid"},{"name":"log_sheet_id","type":"string","value":"synthetic-sheet-document"},{"name":"accounting_note","type":"string","value":"Edit 'Post to Accounting - HTTP' with your QuickBooks/Xero endpoint + auth"}]},"includeOtherFields":true},"typeVersion":3.4,"id":"synthetic-node-2"},{"name":"Validate File Type - Code","type":"n8n-nodes-base.code","position":[520,420],"parameters":{"jsCode":"const out = [];\nfor (const item of $input.all()) {\n  const bin = item.binary && item.binary.data;\n  const mime = (bin && bin.mimeType) || '';\n  const ok = /pdf|jpeg|png|tiff/.test(mime);\n  out.push({ json: { valid: ok, mime, reason: ok ? '' : 'Unsupported file type: ' + mime },\n             binary: item.binary, pairedItem: item.pairedItem });\n}\nreturn out;"},"typeVersion":2,"id":"synthetic-node-3"},{"name":"IF - File Valid?","type":"n8n-nodes-base.if","position":[780,420],"parameters":{"options":{"looseTypeValidation":true},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.valid }}","rightValue":""}]}},"typeVersion":2.2,"id":"synthetic-node-4"},{"name":"Extract Text - PDF","type":"n8n-nodes-base.extractFromFile","position":[1040,420],"parameters":{"operation":"pdf","binaryPropertyName":"data"},"typeVersion":1,"id":"synthetic-node-5"},{"name":"Extract Fields - Info Extractor","type":"@n8n/n8n-nodes-langchain.informationExtractor","position":[1300,420],"parameters":{"text":"={{ $json.text }}","options":{"systemPromptTemplate":"Extract invoice fields. Dates as YYYY-MM-DD. Note anything uncertain in confidence_notes."},"schemaType":"fromJson","jsonSchemaExample":"{ \"vendor_name\": \"string\", \"invoice_number\": \"string\", \"invoice_date\": \"string\", \"due_date\": \"string\", \"total_amount\": \"number\", \"currency\": \"string\", \"line_items\": [{ \"description\": \"string\", \"quantity\": \"number\", \"unit_price\": \"number\" }], \"confidence_notes\": \"string\" }"},"typeVersion":1,"id":"synthetic-node-6"},{"name":"Chat Model - Invoices","type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","position":[1040,620],"parameters":{"model":{"__rl":true,"mode":"list","value":"gpt-4o-mini","cachedResultName":"GPT-4O-MINI"},"options":{}},"typeVersion":1.2,"id":"synthetic-node-7"},{"name":"Check Duplicates - Sheets","type":"n8n-nodes-base.googleSheets","position":[1560,420],"parameters":{"options":{},"resource":"sheet","operation":"read","sheetName":{"__rl":true,"mode":"name","value":"Invoices"},"documentId":{"__rl":true,"mode":"id","value":"synthetic-sheet-document"}},"typeVersion":4.2,"id":"synthetic-node-8"},{"name":"Find Duplicates - Code","type":"n8n-nodes-base.code","position":[1820,420],"parameters":{"jsCode":"const inv = $('Extract Fields - Info Extractor').first().json;\nconst rows = $input.all().map(i => i.json);\nconst dup = rows.some(r => String(r.invoice_number) === String(inv.invoice_number)\n  && String(r.vendor_name).toLowerCase() === String(inv.vendor_name).toLowerCase());\nreturn [{ json: { ...inv, is_duplicate: dup } }];"},"typeVersion":2,"id":"synthetic-node-9"},{"name":"IF - Duplicate?","type":"n8n-nodes-base.if","position":[2080,420],"parameters":{"options":{"looseTypeValidation":true},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.is_duplicate }}","rightValue":""}]}},"typeVersion":2.2,"id":"synthetic-node-10"},{"name":"Flag Duplicate - Gmail","type":"n8n-nodes-base.gmail","position":[2340,420],"parameters":{"sendTo":"synthetic-recipient@example.invalid","message":"Invoice {{ $json.invoice_number }} from {{ $json.vendor_name }} ({{ $json.total_amount }} {{ $json.currency }}) looks like a duplicate already in the log. It was NOT posted.","options":{},"subject":"Duplicate invoice blocked: {{ $json.invoice_number }}","resource":"message","emailType":"text","operation":"send"},"typeVersion":2.1,"id":"synthetic-node-11"},{"name":"Validate Totals - Code","type":"n8n-nodes-base.code","position":[2600,420],"parameters":{"jsCode":"const d = $input.first().json;\nconst items = d.line_items || [];\nconst sum = items.reduce((a, li) => a + Number(li.quantity || 0) * Number(li.unit_price || 0), 0);\nconst total = Number(d.total_amount || 0);\nconst mismatch = items.length > 0 && Math.abs(sum - total) > 0.05;\nconst lowConfidence = /uncertain|unclear|illegible/i.test(d.confidence_notes || '');\nreturn [{ json: { ...d,\n  needs_review: mismatch || lowConfidence,\n  review_reason: mismatch ? 'Line items do not add up to the total'\n    : (lowConfidence ? 'Low extraction confidence' : '') } }];"},"typeVersion":2,"id":"synthetic-node-12"},{"name":"IF - Needs Review?","type":"n8n-nodes-base.if","position":[2860,420],"parameters":{"options":{"looseTypeValidation":true},"conditions":{"options":{"version":2,"leftValue":"","caseSensitive":true,"typeValidation":"strict"},"combinator":"and","conditions":[{"operator":{"type":"boolean","operation":"true","singleValue":true},"leftValue":"={{ $json.needs_review }}","rightValue":""}]}},"typeVersion":2.2,"id":"synthetic-node-13"},{"name":"Queue for Review - Gmail","type":"n8n-nodes-base.gmail","position":[3120,420],"parameters":{"sendTo":"synthetic-recipient@example.invalid","message":"Vendor: {{ $json.vendor_name }}\nTotal: {{ $json.total_amount }} {{ $json.currency }}\nReason: {{ $json.review_reason }}\n\nIt was logged with status 'review' and NOT posted.","options":{},"subject":"Invoice needs review: {{ $json.invoice_number }}","resource":"message","emailType":"text","operation":"send"},"typeVersion":2.1,"id":"synthetic-node-14"},{"name":"Post to Accounting - HTTP","type":"n8n-nodes-base.httpRequest","position":[3380,420],"parameters":{"url":"https://accounting.synthetic.invalid/v1/invoices","method":"POST","options":{"timeout":15000},"jsonBody":"={{ JSON.stringify({ vendor: $json.vendor_name, docNumber: $json.invoice_number, txnDate: $json.invoice_date, dueDate: $json.due_date, total: $json.total_amount, currency: $json.currency, lines: $json.line_items }) }}","sendBody":true,"specifyBody":"json","authentication":"none"},"typeVersion":4.2,"id":"synthetic-node-15"},{"name":"Log Invoice - Sheets","type":"n8n-nodes-base.googleSheets","position":[3640,420],"parameters":{"columns":{"value":{"date":"={{ $now.toISO() }}","status":"={{ $json.needs_review ? 'review' : 'posted' }}","currency":"={{ $json.currency }}","vendor_name":"={{ $json.vendor_name }}","total_amount":"={{ $json.total_amount }}","invoice_number":"={{ $json.invoice_number }}"},"schema":[],"mappingMode":"defineBelow","matchingColumns":[]},"options":{},"resource":"sheet","operation":"append","sheetName":{"__rl":true,"mode":"name","value":"Invoices"},"documentId":{"__rl":true,"mode":"id","value":"synthetic-sheet-document"}},"typeVersion":4.2,"id":"synthetic-node-16"},{"name":"Respond Received","type":"n8n-nodes-base.respondToWebhook","position":[3900,420],"parameters":{"options":{},"respondWith":"json","responseBody":"={{ JSON.stringify({ status: 'received' }) }}"},"typeVersion":1.1,"id":"synthetic-node-17"},{"name":"Schedule - Daily 8AM","type":"n8n-nodes-base.scheduleTrigger","position":[0,1000],"parameters":{"rule":{"interval":[{"field":"days","daysInterval":1,"triggerAtHour":8,"triggerAtMinute