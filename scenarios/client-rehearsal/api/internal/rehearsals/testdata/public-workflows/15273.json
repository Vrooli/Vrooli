            },
            {
              "name": "failure_reason",
              "value": "={{$json.body?.data?.object?.last_payment_error?.message || 'Unknown'}}"
            },
            {
              "name": "gateway",
              "value": "={{$json.body?.type?.includes('stripe') ? 'stripe' : 'stripe'}}"
            },
            {
              "name": "currency",
              "value": "={{$json.body?.data?.object?.currency || 'USD'}}"
            },
