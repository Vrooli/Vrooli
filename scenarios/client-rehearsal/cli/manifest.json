{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "client-rehearsal",
  "description": "Stable command surface for importing, rehearsing, and reviewing synthetic workflows.",
  "groups": [
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.notes.NotesService",
            "method": "ListNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Note title"
            },
            {
              "name": "body",
              "description": "Note body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.notes.NotesService",
            "method": "CreateNote"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Note id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.notes.NotesService",
            "method": "GetNote"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            {
              "name": "window",
              "default": "this_week",
              "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)",
              "bind_waiver": "CLI resolves the canonical time-window token into the structured TimeWindow RPC message."
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.notes.NotesService",
            "method": "CountNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    },
    {
      "name": "rehearsals",
      "description": "Import, simulate, and review workflow rehearsals",
      "commands": [
        {
          "name": "create-and-run",
          "description": "Import a sanitized n8n export and run it against a simulator profile",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Rehearsal title"
            },
            {
              "name": "workflow-json",
              "required": true,
              "description": "n8n workflow export JSON"
            },
            {
              "name": "trigger-node-id",
              "description": "Select one imported trigger when the workflow has multiple trigger nodes"
            },
            {
              "name": "simulator-source-json",
              "description": "OpenAPI or recorded-exchange JSON; omitted uses the synthetic CRM/Sheets catalog"
            },
            {
              "name": "inject-seeded-fault",
              "description": "Inject one synthetic transient fault and exercise retry repair"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.rehearsals.RehearsalService",
            "method": "CreateAndRunRehearsal"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "List recent rehearsals and their review states",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum records, capped by the API"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.rehearsals.RehearsalService",
            "method": "ListRehearsals"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "get",
          "description": "Show a rehearsal trace and handoff",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Rehearsal id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.rehearsals.RehearsalService",
            "method": "GetRehearsal"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "review",
          "description": "Explicitly approve a handoff or request changes",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Rehearsal id"
            }
          ],
          "flags": [
            {
              "name": "decision",
              "required": true,
              "description": "approve or request_changes"
            },
            {
              "name": "note",
              "description": "Human review note"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "vrooli.client_rehearsal.v1.rehearsals.RehearsalService",
            "method": "RecordReview"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "notes",
        "stateful": true,
        "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier."
      }
    ]
  },
  "exceptions": [
    {
      "command": "notes attach",
      "class": "upload",
      "reason": "Multipart file upload is exposed through the notes REST attachment endpoint, while cli-manifest/v1 only models Connect-RPC bindings."
    }
  ],
  "omitted": [
    {
      "service": "vrooli.client_rehearsal.v1.shared.CapabilitiesService",
      "method": "DescribeCapabilities",
      "reason": "The optional system capability snapshot is API-only; it is consumed by machine integrations and is not an operator CLI workflow."
    }
  ]
}
