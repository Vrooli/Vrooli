{
  "name": "app-monitor-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Matrix-themed monitoring dashboard for Vrooli scenarios",
  "scripts": {
    "dev": "vrooli lifecycle protect -- vite",
    "build": "vite build",
    "build:profile": "vite build --mode profile",
    "preview": "vite preview",
    "start": "vrooli lifecycle protect -- node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "debug": "vrooli lifecycle protect -- vite --debug --force",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:coverage:strict": "vitest run --coverage --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:watch": "vitest --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:related": "vitest related --run --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000"
  },
  "dependencies": {
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "axios": "^1.21.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "react-use-websocket": "^4.5.0",
    "ws": "^8.22.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
