{
  "name": "app-monitor-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Matrix-themed monitoring dashboard for Vrooli scenarios",
  "scripts": {
    "dev": "VITE_PORT=${VITE_PORT} vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "debug": "VITE_PORT=${VITE_PORT} vite --debug --force",
    "clean": "rm -rf dist node_modules .vite",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:watch": "vitest --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000",
    "test:related": "vitest related --run --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism --testTimeout=10000 --hookTimeout=10000"
  },
  "dependencies": {
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "axios": "^1.15.2",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "react-use-websocket": "^4.5.0",
    "ws": "^8.14.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
