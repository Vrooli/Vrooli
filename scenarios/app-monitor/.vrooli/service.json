{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "app-monitor",
    "displayName": "App Monitor",
    "description": "Dashboard to monitor and control all running scenarios with real-time health checks and performance metrics",
    "version": "1.0.0",
    "tags": [
      "business-application",
      "monitoring",
      "maintenance",
      "dashboard",
      "docker",
      "health-check",
      "app-management",
      "metrics",
      "automation",
      "nodejs-ui",
      "go-api",
      "postgres-storage",
      "redis-cache",
      "ollama-ai"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/app-monitor"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "range": "15000-19999",
      "description": "App monitoring coordination API port"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 20000,
      "description": "Swarm Manager UI port"
    },
    "vite": {
      "env_var": "VITE_PORT",
      "range": "21800-21899",
      "description": "Vite dev server port (development)"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "App Monitor health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    },
    "setup": {
      "description": "Initialize App Monitor with database schema and automation workflows",
      "steps": [
        {
          "name": "generate-embeddings",
          "exec": [
            "vrooli",
            "resource",
            "qdrant",
            "embeddings",
            "refresh",
            "--force"
          ],
          "on_error": "continue",
          "description": "Generate code embeddings for AI assistance"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "purpose": "Store app metadata, monitoring data, status logs, and metrics"
      },
      "redis": {
        "type": "redis",
        "enabled": true,
        "required": false,
        "purpose": "Optional real-time event fan-out. The websocket handler guards every Redis call behind an explicit nil check and serves a working no-Redis branch, so the scenario runs without a Redis server."
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": false,
        "purpose": "AI-powered analysis for unhealthy apps and performance optimization recommendations"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "description": "Auto-detected via analyzer (heuristic)"
      }
    },
    "scenarios": {
      "swarm-manager": {
        "required": true,
        "version": "1.0.0",
        "versionRange": ">=1.0.0",
        "description": "Creates and reads scenario fix backlog items"
      },
      "scenario-auditor": {
        "required": true,
        "version": "1.0.0",
        "versionRange": ">=1.0.0",
        "description": "Auto-detected dependency via scenario_port_cli"
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "app-monitor",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "app-monitor"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui",
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator. The scenario opens a client when Redis is reachable and serves a working no-Redis path when it is not."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
