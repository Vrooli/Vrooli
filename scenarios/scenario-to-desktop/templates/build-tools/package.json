{
  "name": "scenario-to-desktop-build-tools",
  "version": "1.0.0",
  "description": "Build tools and template generator for scenario-to-desktop",
  "main": "dist/template-generator.js",
  "bin": {
    "generate-desktop-app": "./dist/template-generator.js"
  },
  "scripts": {
    "build": "tsc && node write-build-stamp.js",
    "typecheck": "tsc --noEmit",
    "dev": "vrooli lifecycle protect -- ts-node template-generator.ts",
    "test": "node --test test/build-stamp.test.cjs && jest --passWithNoTests",
    "test:stamp": "node --test test/build-stamp.test.cjs",
    "verify:build": "node write-build-stamp.js --check",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@electron/notarize": "^2.2.0",
    "fs-extra": "^11.1.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
