{
  // =============================================================================
  // PRODUCTION TSCONFIG FOR GENERATED DESKTOP APPS
  // =============================================================================
  // This config is used when building generated Electron apps for distribution.
  // All source files live in src/ after generation (main.ts, preload.ts, modules).
  //
  // NOTE: For template DEVELOPMENT (testing modules in templates/vanilla/),
  // use tsconfig.dev.json instead, which has rootDir: "." to include test files.
  // =============================================================================
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": true,
    "allowSyntheticDefaultImports": true
  },
  // Only include src/ - all app code (main.ts, preload.ts, modules) lives there.
  // Do NOT add "*.ts" here - that would match dev-only files like vitest.config.ts
  // which shouldn't be compiled (and would fail since they're outside rootDir).
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "ts-node": {
    "esm": true
  }
}