version: '3'
info:
  companyName: {{AUTHOR}}
  productName: {{APP_DISPLAY_NAME}}
  productIdentifier: {{APP_ID}}
  description: {{APP_DESCRIPTION}}
  copyright: {{COPYRIGHT}}
  comments: "Generated by scenario-to-desktop"
  version: {{VERSION}}
dev_mode:
  root_path: .
  log_level: warn
  debounce: 1000
  ignore:
    dir: [frontend, bin]
    file: ["*_test.go"]
    watched_extension: ["*.go"]
    git_ignore: true
  executes: []
