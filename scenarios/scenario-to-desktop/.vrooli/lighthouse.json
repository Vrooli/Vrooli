{
  "$schema": "../../../../scenarios/test-genie/schemas/lighthouse.schema.json",
  "version": "1.0.0",
  "service": "scenario-to-desktop",
  "description": "Lighthouse performance and accessibility audits for the Scenario to Desktop UI",
  "enabled": true,
  "pages": [
    {
      "id": "home",
      "path": "/",
      "thresholds": {
        "performance": { "error": 0.5, "warn": 0.7 },
        "accessibility": { "error": 0.7, "warn": 0.9 },
        "best-practices": { "error": 0.7, "warn": 0.85 },
        "seo": { "error": 0.6, "warn": 0.8 }
      }
    }
  ],
  "lighthouse": {
    "enabled": true,
    "url": "http://localhost:${UI_PORT}",
    "thresholds": {
      "performance": { "error": 0.5, "warn": 0.7 },
      "accessibility": { "error": 0.7, "warn": 0.9 },
      "best-practices": { "error": 0.7, "warn": 0.85 },
      "seo": { "error": 0.6, "warn": 0.8 }
    },
    "budgets": [
      { "resourceType": "script", "budget": 500 },
      { "resourceType": "stylesheet", "budget": 100 },
      { "resourceType": "total", "budget": 1000 }
    ]
  },
  "reporting": {
    "formats": ["json", "html"],
    "fail_on_error": true
  },
  "global_options": {
    "chrome_flags": ["--headless", "--no-sandbox", "--disable-gpu"],
    "timeout_ms": 60000,
    "retries": 1
  }
}
