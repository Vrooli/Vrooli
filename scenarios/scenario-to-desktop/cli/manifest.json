{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "scenario-to-desktop",
  "description": "Scenario to Desktop authoritative CLI contract. Pipeline, signing, bundle, and system commands are implemented through generated Connect clients so transport parity is governed rather than inferred.",
  "groups": [
    {
      "name": "build",
      "description": "Inspect desktop build status",
      "commands": [
        {
          "name": "get",
          "binding": {
            "kind": "connect-rpc",
            "service": "BuildService",
            "method": "GetBuild"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "domain": "build",
            "intent": "Inspect durable desktop build status by build identifier.",
            "questions": [
              "What is the status of this desktop build?",
              "Show the durable build record for this desktop package."
            ],
            "result": {
              "kind": "table",
              "value_field": "status",
              "unit": "build status",
              "summary_template": "Desktop build status is {status}."
            }
          },
          "positionals": [
            {
              "name": "build",
              "required": true,
              "description": "Build ID"
            }
          ]
        }
      ]
    },
    {
      "name": "pipeline",
      "description": "Create and inspect desktop packaging pipelines",
      "commands": [
        {
          "name": "run",
          "description": "Start a desktop packaging pipeline for a scenario",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario name"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "PipelineService",
            "method": "Run"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "status",
