          "binding": {
            "kind": "connect-rpc",
            "service": "PipelineService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "positionals": [
            {
              "name": "pipeline",
              "required": true,
              "description": "Pipeline ID"
            }
          ]
        },
        {
          "name": "resume",
