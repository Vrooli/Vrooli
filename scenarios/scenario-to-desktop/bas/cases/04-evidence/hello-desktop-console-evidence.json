  "edges":[{"id":"e1","source":"navigate","target":"assert-scenario"},{"id":"e2","source":"assert-scenario","target":"assert-generate"},{"id":"e3","source":"assert-generate","target":"assert-build"},{"id":"e4","source":"assert-build","target":"assert-smoke"},{"id":"e5","source":"assert-smoke","target":"capture"}]
