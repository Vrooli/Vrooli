    {"id":"assert-smoke","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"@selector/generator.smokeTestSection","mode":"ASSERTION_MODE_EXISTS","timeout_ms":10000},"metadata":{"label":"Smoke evidence surface is available"}}},
