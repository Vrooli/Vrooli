{
  "metadata": {
    "name": "validation-workspace-unavailable-artifact",
    "description": "Given a selected scenario without a discoverable packaged artifact, when an operator runs the matrix, then the unavailable disposition and release-gate blocker remain visible with an actionable reason.",
    "labels": {
      "reset": "none",
      "requirements_json": "[\"STD-E2E-GENERATION\"]",
      "purpose": "validation-workspace-unavailable-artifact",
      "requires_confirmation": "true",
      "routed_isolation": "true"
    },
    "execution_mode": "mutating"
  },
  "settings": {"viewport_width": 1440, "viewport_height": 900},
  "nodes": [
    {"id":"navigate","action":{"type":"ACTION_TYPE_NAVIGATE","navigate":{"destination_type":"NAVIGATE_DESTINATION_TYPE_SCENARIO","scenario":"scenario-to-desktop","scenario_path":"/?view=validation&scenario=scenario-to-desktop","wait_until":"NAVIGATE_WAIT_EVENT_NETWORKIDLE","timeout_ms":30000},"metadata":{"label":"Open the desktop validation workspace"}}},
    {"id":"scenario","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/validation.scenarioName","clear_first":true,"value":"scenario-to-desktop"},"metadata":{"label":"Select the valid desktop scenario catalog"}}},
    {"id":"artifact","action":{"type":"ACTION_TYPE_INPUT","input":{"selector":"@selector/validation.artifactDigest","clear_first":true,"value":"artifact-not-discovered"},"metadata":{"label":"Record the unavailable artifact reference"}}},
    {"id":"create","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/validation.createMatrix"},"metadata":{"label":"Create the immutable validation matrix"}}},
    {"id":"wait-cell","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/validation.matrixCell","timeout_ms":15000},"metadata":{"label":"Wait for the unavailable matrix cell"}}},
    {"id":"run","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/validation.startRun"},"metadata":{"label":"Run the selected matrix"}}},
    {"id":"wait-run","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/validation.waitRun"},"metadata":{"label":"Wait for the server-owned run"}}},
    {"id":"assert-cell","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"@selector/validation.matrixCell","mode":"ASSERTION_MODE_TEXT_CONTAINS","expected":{"stringValue":"unavailable"},"timeout_ms":30000},"metadata":{"label":"Unavailable disposition remains explicit"}}},
    {"id":"assert-gate","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"@selector/validation.gateSummary","mode":"ASSERTION_MODE_EXISTS","timeout_ms":10000},"metadata":{"label":"Release-gate blocker remains visible"}}},
    {"id":"capture","action":{"type":"ACTION_TYPE_SCREENSHOT","screenshot":{"full_page":true},"metadata":{"label":"Capture unavailable artifact evidence"}}}
  ],
  "edges":[
    {"id":"e1","source":"navigate","target":"scenario"},
    {"id":"e2","source":"scenario","target":"artifact"},
    {"id":"e3","source":"artifact","target":"create"},
    {"id":"e4","source":"create","target":"wait-cell"},
    {"id":"e5","source":"wait-cell","target":"run"},
    {"id":"e6","source":"run","target":"wait-run"},
    {"id":"e7","source":"wait-run","target":"assert-cell"},
    {"id":"e8","source":"assert-cell","target":"assert-gate"},
    {"id":"e9","source":"assert-gate","target":"capture"}
  ]
}
