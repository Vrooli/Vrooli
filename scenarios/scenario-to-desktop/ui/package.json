{
  "name": "scenario-to-desktop-ui",
  "version": "1.0.0",
  "description": "React + Vite front-end for Scenario to Desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vrooli lifecycle protect -- node server.js",
    "dev": "vrooli lifecycle protect -- vite",
    "build": "pnpm selector:manifest && vite build",
    "profile": "pnpm selector:manifest && vite build --mode profile",
    "build:profile": "pnpm selector:manifest && vite build --mode profile",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "pnpm selector:manifest && tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "pnpm selector:manifest && vitest run",
    "test:coverage": "pnpm selector:manifest && vitest run --coverage",
    "selector:manifest": "node ./scripts/generate-selector-manifest.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.3",
    "@vrooli/api-base": "file:../../../packages/api-base",
    "@vrooli/iframe-bridge": "file:../../../packages/iframe-bridge",
    "@vrooli/proto-types": "file:../../../packages/proto/gen/typescript",
    "axe-core": "4.10.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.424.0",
    "picomatch": "2.3.2",
    "prettier": "3.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@9.12.1"
}
