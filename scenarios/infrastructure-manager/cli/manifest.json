{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "infrastructure-manager",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "coverage",
      "description": "Read-only reliability coverage, open-loop and setpoint integrity",
      "commands": [
        {
          "name": "status",
          "description": "Show coverage ratios with denominator confidence",
          "flags": [
            {
              "name": "projection",
              "description": "Optional projection filter",
              "bind": {
                "field": "projections"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "GetCoverage"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "show",
          "description": "Show one projection's cells and bars",
          "positionals": [
            {
              "name": "projection",
              "required": true,
              "description": "Reliability projection"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "GetProjection"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "cells",
          "description": "List reliability cells, optionally filtered by projection and status",
          "flags": [
            {
              "name": "projection",
              "description": "Optional projection filter"
            },
            {
              "name": "status",
              "description": "Optional status filter"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "ListCells"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "open-loop",
          "description": "List every dated MISSING reliability cell",
          "flags": [
            {
              "name": "projection",
              "description": "Optional projection filter"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "ListOpenLoopCells"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "validate",
          "description": "Validate the read-only setpoint and coverage integrity",
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "ValidateSetpoint"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "drift",
          "description": "Show live space and sensor drift findings",
          "flags": [
            {
              "name": "projection",
              "description": "Optional projection filter"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CoverageService",
            "method": "GetDrift"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "condition",
      "description": "Read condition, trust and history evidence",
      "commands": [
        {
          "name": "status",
          "description": "Read condition readings",
          "flags": [
            {
              "name": "projection",
              "description": "Projection filter"
            },
            {
              "name": "cell",
              "description": "Optional cell filter",
              "bind": {
                "field": "cell_ref"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConditionService",
            "method": "GetCondition"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "trust",
          "description": "Read the trust distribution and checked denominator",
          "binding": {
            "kind": "connect-rpc",
            "service": "ConditionService",
            "method": "GetTrustDistribution"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "explain",
          "description": "Explain one condition cell",
          "positionals": [
            {
              "name": "cell",
              "required": true,
              "description": "Condition cell reference",
              "bind": {
                "field": "cell_ref"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConditionService",
            "method": "ExplainCell"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "history",
          "description": "Read condition history or its measurement status",
          "positionals": [
            {
              "name": "cell",
              "required": true,
              "description": "Condition cell reference",
              "bind": {
                "field": "cell_ref"
              }
            }
          ],
          "flags": [
            {
              "name": "limit",
              "description": "Maximum readings"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConditionService",
            "method": "GetHistory"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    },
    {
      "name": "focus",
      "description": "Read ranked reliability findings and efficacy evidence",
      "commands": [
        {
          "name": "next",
          "description": "Read ranked next findings",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum findings"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FocusService",
            "method": "GetNext"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "finding",
          "description": "Read one ranked finding",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Finding id",
              "bind": {
                "field": "finding_id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FocusService",
            "method": "GetFinding"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "sources",
          "description": "Read focus source availability",
          "binding": {
            "kind": "connect-rpc",
            "service": "FocusService",
            "method": "ListSources"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "efficacy",
          "description": "Read finding efficacy evidence",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Finding id",
              "bind": {
                "field": "finding_id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FocusService",
            "method": "GetEfficacy"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "exceptions": [],
  "omitted": []
}
