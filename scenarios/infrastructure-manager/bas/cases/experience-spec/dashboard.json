{
  "metadata": {
    "name": "experience-dashboard-spec-smoke",
    "description": "Generated observer smoke for active experience page dashboard.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "dashboard",
      "surface": "experience-dashboard"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "infrastructure-manager",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Dashboard" }
      }
    },
    {
      "id": "wait-dashboard-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.dashboard",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Dashboard page visible" }
      }
    }
    ,
    {
      "id": "wait-dashboard-confidence-header",
      "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "[data-testid=\"board-confidence-header\"][data-experience-state=\"loading\"], [data-testid=\"board-confidence-header\"][data-experience-state=\"ready\"]", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 15000 }, "metadata": { "label": "Dashboard confidence header" } }
    },
    {
      "id": "wait-dashboard-ranked-findings",
      "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "[data-testid=\"board-ranked-findings\"][data-experience-state=\"loading\"], [data-testid=\"board-ranked-findings\"][data-experience-state=\"ready\"]", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 15000 }, "metadata": { "label": "Dashboard ranked findings" } }
    },
    {
      "id": "wait-dashboard-source-availability",
      "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "[data-testid=\"board-source-availability\"][data-experience-state=\"loading\"], [data-testid=\"board-source-availability\"][data-experience-state=\"ready\"]", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 15000 }, "metadata": { "label": "Dashboard source availability" } }
    }
  ]
}
