{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.go_code_graph.v1.health.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.go_code_graph.v1.errors.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "graph_extract",
      "path": "/vrooli.go_code_graph.v1.graph.GoCodeGraphService/Extract",
      "method": "POST",
      "summary": "Extract a deterministic Go graph",
      "description": "Loads the Go module rooted at module_path and returns the normalized graph + warnings + extraction time + graph hash.",
      "category": "graph",
      "request": {
        "type": "object",
        "properties": {
          "include_vendor": "boolean (default false)",
          "module_path": "string (required, absolute or scenario-relative module root)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "extraction_ms": "int64",
          "graph": "common.v1.CodeGraph",
          "graph_hash": "string (hex sha256 of canonical graph)",
          "warnings": "array<common.v1.CodeGraphWarning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or invalid module_path; no/multiple go.mod"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "module_path unreadable"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "go.work multi-module workspaces are not supported in v1"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Loader failure"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph graph extract",
        "args": [
          "<path>",
          "[--include-vendor]"
        ]
      }
    },
    {
      "id": "graph_list_fixtures",
      "path": "/vrooli.go_code_graph.v1.graph.GoCodeGraphService/ListFixtures",
      "method": "POST",
      "summary": "List golden determinism fixtures",
      "description": "Enumerates the fixture directories under bas/fixtures so the Fixture Validator UI can offer them without reading repo files in the browser.",
      "category": "graph",
      "response": {
        "type": "object",
        "properties": {
          "fixtures": "array<{name:string, path:string, has_expected:bool}>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Fixtures directory unreadable"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph graph list-fixtures"
      }
    },
    {
      "id": "graph_validate_fixture",
      "path": "/vrooli.go_code_graph.v1.graph.GoCodeGraphService/ValidateFixture",
      "method": "POST",
      "summary": "Validate a fixture against its golden graph",
      "description": "Re-runs Extract against a named fixture server-side and byte-compares the canonical JSON against expected-graph.json, returning pass/fail plus a line diff.",
      "category": "graph",
      "request": {
        "type": "object",
        "properties": {
          "name": "string (required, fixture directory name)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "actual_bytes": "int64",
          "diff": "string (line diff; empty on pass)",
          "expected_bytes": "int64",
          "graph_hash": "string (hex sha256 of canonical graph)",
          "passed": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or path-escaping fixture name"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Fixture not found"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Fixture has no expected-graph.json baseline"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Extraction or comparison failure"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph graph validate-fixture",
        "args": [
          "<name>"
        ]
      }
    },
    {
      "id": "rewrite_plan",
      "path": "/vrooli.go_code_graph.v1.graph.GoCodeGraphService/RewritePlan",
      "method": "POST",
      "summary": "Plan a set of rewrite operations",
      "description": "Validates and normalizes a list of FileMove/ImportRewrite operations and returns a plan_id. No filesystem changes.",
      "category": "rewrite",
      "request": {
        "type": "object",
        "properties": {
          "module_path": "string (required)",
          "operations": "array<Operation> (required, ≥1)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "normalized_operations": "array<Operation>",
          "plan_id": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Empty operations list or malformed op"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Plan persistence failure"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph rewrite plan",
        "args": [
          "<ops.json>"
        ]
      }
    },
    {
      "id": "rewrite_apply",
      "path": "/vrooli.go_code_graph.v1.graph.GoCodeGraphService/RewriteApply",
      "method": "POST",
      "summary": "Apply a previously-planned rewrite",
      "description": "Executes the operations associated with plan_id. Caller must set apply=true; apply=false is rejected with InvalidArgument so dry-run callers do not accidentally mutate. X-Dry-Run: true header threads through to a synthetic-OK response without invoking the executor.",
      "category": "rewrite",
      "request": {
        "type": "object",
        "properties": {
          "apply": "boolean (must be true)",
          "module_path": "string (required)",
          "plan_id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "dry_run": "boolean",
          "plan_id": "string",
          "results": "array<OperationResult>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unknown plan_id, apply=false, or malformed input"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Plan was created for a different module_path"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Executor or persistence failure"
        }
      ],
      "cli_mapping": {
        "command": "go-code-graph rewrite apply",
        "args": [
          "<plan_id>",
          "[--dry-run]"
        ]
      }
    }
  ]
}
