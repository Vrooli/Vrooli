{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "name": "notes",
    "displayName": "SmartNotes",
    "description": "Local AI-enabled note-taking with intelligent organization, semantic search, and real-time suggestions",
    "version": "1.0.0",
    "tags": [
      "productivity-application",
      "productivity",
      "notes",
      "markdown",
      "knowledge-base",
      "ai-powered",
      "semantic-search",
      "tagging",
      "organization",
      "javascript-ui",
      "nodejs-ui",
      "go-api",
      "n8n-workflows",
      "postgres-storage",
      "redis-cache",
      "qdrant-vectors",
      "ollama-ai"
    ],
    "parent": "vrooli",
    "type": "scenario",
    "category": "general",
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/notes"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "SmartNotes API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "SmartNotes UI port",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Notes health check configuration",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 5000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": false,
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "timeout": 5000,
      "interval": 30000,
      "startup_grace_period": 10000
    },
    "setup": {
      "description": "Initialize SmartNotes",
      "steps": [
        {
          "name": "generate-embeddings",
          "exec": [
            "vrooli",
            "resource",
            "qdrant",
            "embeddings",
            "refresh",
            "--force"
          ],
          "on_error": "continue",
          "description": "Generate code embeddings for AI assistance"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "postgres": {
        "type": "postgres",
        "enabled": true,
        "required": true,
        "purpose": "Store notes, folders, tags, and user preferences"
      },
      "qdrant": {
        "type": "qdrant",
        "enabled": true,
        "required": true,
        "purpose": "Vector storage for semantic search across notes"
      },
      "redis": {
        "type": "redis",
        "enabled": true,
        "required": false,
        "purpose": "Cache recent notes and real-time collaboration"
      },
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "purpose": "AI-powered note suggestions and summarization",
        "model_roles": [
          "embedding.default"
        ]
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "notes",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "notes"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  },
  "tier_feasibility": {
    "metadata_version": 1,
    "dependencies": {
      "resources": {
        "redis": {
          "resource_type": "hot-state-store",
          "platform_support": {
            "tier-1-local": {
              "supported": true,
              "notes": "Optional accelerator that no Go code in this scenario currently opens. The declaration records intended caching, not a runtime requirement."
            },
            "tier-2-desktop": {
              "supported": false,
              "reason": "No vendorable cross-platform RESP server exists",
              "alternatives": [
                "durable-local"
              ],
              "notes": "The scenario does not require Redis, so the desktop tier simply runs without it rather than shipping a server."
            }
          },
          "swappable_with": [
            {
              "id": "durable-local",
              "relationship": "single-node-equivalent",
              "notes": "A durable local store behind the same Store seam preserves the durability property across restart, but not cross-replica sharing. A deployment running more than one replica still needs a real Redis."
            }
          ]
        }
      }
    }
  }
}
