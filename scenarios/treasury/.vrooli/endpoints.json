      "method": "POST",
      "summary": "Evaluate and reserve a proposed charge",
      "description": "",
      "category": "authorization",
      "request": {
        "type": "ProposeChargeRequest"
      },
      "response": {
        "type": "ProposeChargeResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Malformed proposal"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Fail-closed dependency or persistence failure"
        }
      ]
    },
    {
      "id": "agentspend_get_authorization",
