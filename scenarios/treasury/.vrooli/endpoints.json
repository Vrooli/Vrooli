          "code": "unauthenticated",
          "description": "Operator identity is required"
        },
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Agent-realm or invalid operator credential"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Operator realm is not configured"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Method behavior lands with its owning domain phase"
        }
