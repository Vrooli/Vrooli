      "request": {
        "type": "GetAuthorizationRequest"
      },
      "response": {
        "type": "GetAuthorizationResponse"
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Authorization does not exist"
        }
      ]
    },
    {
      "id": "agentspend_list_mandates",
      "path": "/vrooli.treasury.v1.authorization.AgentSpend/ListMandates",
      "method": "POST",
      "summary": "List mandates visible to the verified agent",
      "description": "",
      "category": "mandate",
      "request": {
        "type": "ListMandatesRequest"
      },
      "response": {
        "type": "ListMandatesResponse"
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Introduced with the governed agent CLI surface"
        }
      ]
    },
    {
      "id": "agentspend_report_outcome",
      "path": "/vrooli.treasury.v1.authorization.AgentSpend/ReportOutcome",
      "method": "POST",
      "summary": "Execute an approved charge once and return its durable rail outcome",
      "description": "",
      "category": "settlement",
      "request": {
        "type": "ReportOutcomeRequest"
      },
      "response": {
        "type": "ReportOutcomeResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid, unauthorized, expired, or idempotency-aliased settlement"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Settlement dependency not found"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Settlement execution or durable outcome recording failed"
        }
      ]
    },
