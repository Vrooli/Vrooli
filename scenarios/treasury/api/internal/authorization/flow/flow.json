  "runtime": {"go": {"package": "flow", "statusType": "AuthorizationStatus", "eventType": "AuthorizationEvent", "constantPrefix": "Authorization"}, "sideEffects": ["Identity verification occurs before policy evaluation.", "Pending and approved states reserve headroom until release, expiry, or settlement."]},
