    {"name": "approval_then_release", "initial": "evaluating", "steps": [{"event": "require_approval", "want": "pending", "wantError": false}, {"event": "approve", "want": "approved", "wantError": false}, {"event": "release", "want": "released", "wantError": false}]},
    {"name": "policy_refusal", "initial": "evaluating", "steps": [{"event": "refuse", "want": "refused", "wantError": false}]}
