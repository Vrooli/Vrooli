  },
  "states": [
    {"id": "evaluating", "quint": "Evaluating", "initial": true},
    {"id": "refused", "quint": "Refused", "terminal": true},
    {"id": "pending", "quint": "Pending"},
    {"id": "approved", "quint": "Approved"},
    {"id": "released", "quint": "Released", "terminal": true},
    {"id": "settled", "quint": "Settled", "terminal": true}
  ],
  "events": [
    {"id": "refuse", "quint": "Refuse"},
