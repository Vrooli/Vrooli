{
  "schemaVersion": 6,
  "kind": "temporal",
  "flowId": "authorization.lifecycle",
  "domain": "authorization",
  "description": "A proposed charge is refused, held pending approval, approved directly, released, or settled without resurrecting closed authority.",
  "model": {
