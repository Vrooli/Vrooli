    "theme.select": {
      "testId": "theme-select",
      "selector": "[data-testid=\"theme-select\"]"
    },
    "pages.approvals": {
      "testId": "page-approvals",
      "selector": "[data-testid=\"page-approvals\"]"
    },
    "pages.settings": {
      "testId": "page-settings",
      "selector": "[data-testid=\"page-settings\"]"
    },
    "approvals.tokenInput": {
      "testId": "approvals-token-input",
      "selector": "[data-testid=\"approvals-token-input\"]"
    },
    "approvals.openQueueButton": {
      "testId": "approvals-open-queue",
      "selector": "[data-testid=\"approvals-open-queue\"]"
    },
    "approvals.queue": {
      "testId": "approvals-queue",
      "selector": "[data-testid=\"approvals-queue\"]"
    },
    "errorBoundary.root": {
      "testId": "error-boundary-root",
      "selector": "[data-testid=\"error-boundary-root\"]"
    },
    "errorBoundary.retryButton": {
      "testId": "error-boundary-retry",
      "selector": "[data-testid=\"error-boundary-retry\"]"
    }
  },
  "dynamicSelectors": {
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "approvals",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "approvals",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "approvals.item": {
      "description": "Pending approval card by approval identifier",
      "selectorPattern": "[data-testid=\"approval-${id}\"]",
      "testIdPattern": "approval-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "approvals.action": {
      "description": "Approval decision button by approval identifier and action",
      "selectorPattern": "[data-testid=\"approval-${id}-${action}\"]",
      "testIdPattern": "approval-${id}-${action}",
      "params": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "action",
          "type": "enum",
          "values": [
            "approve",
            "decline"
          ]
        }
      ]
    }
  }
}
