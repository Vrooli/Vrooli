    "layout.shell": {
      "testId": "layout-shell",
      "selector": "[data-testid=\"layout-shell\"]"
    },
    "layout.topBar": {
      "testId": "layout-top-bar",
      "selector": "[data-testid=\"layout-top-bar\"]"
    },
    "layout.sidebar": {
      "testId": "layout-sidebar",
      "selector": "[data-testid=\"layout-sidebar\"]"
    },
    "layout.bottomNav": {
      "testId": "layout-bottom-nav",
      "selector": "[data-testid=\"layout-bottom-nav\"]"
    },
    "layout.main": {
      "testId": "layout-main",
      "selector": "[data-testid=\"layout-main\"]"
    },
    "theme.switcher": {
      "testId": "theme-switcher",
      "selector": "[data-testid=\"theme-switcher\"]"
