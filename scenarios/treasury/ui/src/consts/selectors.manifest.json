  "dynamicSelectors": {
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "approvals",
            "fund",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "approvals",
            "fund",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "approvals.item": {
      "description": "Pending approval card by approval identifier",
      "selectorPattern": "[data-testid=\"approval-${id}\"]",
      "testIdPattern": "approval-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    },
    "approvals.action": {
      "description": "Approval decision button by approval identifier and action",
      "selectorPattern": "[data-testid=\"approval-${id}-${action}\"]",
      "testIdPattern": "approval-${id}-${action}",
      "params": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "action",
          "type": "enum",
          "values": [
            "approve",
            "decline"
          ]
        }
      ]
    },
    "controls.standingItem": {
      "description": "Standing mandate row by mandate identifier",
      "selectorPattern": "[data-testid=\"controls-standing-${id}\"]",
      "testIdPattern": "controls-standing-${id}",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ]
    }
  },
