          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_bridge.v1.runs.RunsService/ListRuns -H 'Authorization: Bearer <token>' -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "runs_wait_run",
      "path": "/vrooli.vrooli_bridge.v1.runs.RunsService/WaitRun",
      "method": "POST",
      "summary": "Block-once wait for a run to finish",
      "description": "Blocks server-side and returns EXACTLY ONCE when the run reaches a terminal status (no polling). Returns timed_out=true if the wait deadline elapses first. Owner-gated.",
      "category": "runs",
      "request": {
        "type": "object",
        "properties": {
