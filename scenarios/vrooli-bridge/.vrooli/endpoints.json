          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Revoke node",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_bridge.v1.registry.NodeRegistryService/RevokeNode -H 'Authorization: Bearer <token>' -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
