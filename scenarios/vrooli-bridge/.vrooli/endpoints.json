        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Update node",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_bridge.v1.registry.NodeRegistryService/UpdateNode -H 'Authorization: Bearer <token>' -H 'Content-Type: application/json' -d '{\"id\":\"abc123\",\"name\":\"renamed\"}'"
        }
      ]
    },
    {
      "id": "registry_revoke_node",
      "path": "/vrooli.vrooli_bridge.v1.registry.NodeRegistryService/RevokeNode",
      "method": "POST",
      "summary": "Revoke a node",
