      "env": "BRIDGE_DEVICE_SYNC_DEVICE_TOKEN",
      "label": "Device Sync Hub target device token",
      "description": "Optional token for delivering an artifact to a mapped target device. Obtain it when the target device is paired with Device Sync Hub; it is delegated to the target transport and is never generated by Bridge.",
      "required": false,
      "provisioning": "operator",
      "obtain_url": "https://github.com/Vrooli/Vrooli/tree/master/scenarios/device-sync-hub/docs/QUICKSTART.md"
