  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "5GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      },
      "retention-enforcement-receipt": {
        "rung": "owned",
        "kind": "file",
        "class": "state",
        "subpath": "retention/enforcement-receipt.json",
        "regenerable": false,
        "format": "json",
        "sensitive": false,
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "The receipt is a bounded single JSON state record; the ceiling prevents unbounded audit growth in the state path."
        },
        "rationale": "The retention owner records the latest enforcement outcome as durable state for audit and recovery."
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "retention": {
    "budgets": {
      "audit_records": {
        "target": {
          "kind": "sqlite_table",
          "class": "data",
          "database": "vrooli-bridge.db",
          "table": "audit_records",
          "time_column": "recorded_at"
        },
        "max_age": "90d",
        "max_bytes": "512MiB",
        "pruner": "builtin",
        "rationale": "The audit trail is append-only operational evidence. Ninety days preserves a useful incident-review window while bounding the table that otherwise grows without limit; the byte ceiling is an alarm and backstop for unusually high event volume."
      }
    }
  },
