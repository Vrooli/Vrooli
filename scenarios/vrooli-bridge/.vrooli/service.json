{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "environment": {
    "BRIDGE_DELIVERY_LEASE_SECONDS": "10",
    "BRIDGE_WATCHDOG_INTERVAL_SECONDS": "2",
    "BRIDGE_MAX_DELIVERY_ATTEMPTS": "3",
    "BRIDGE_START_DEADLINE_SECONDS": "30",
    "BRIDGE_PRESENCE_STALE_SECONDS": "45",
    "BRIDGE_DEADLINE_GRACE_SECONDS": "5"
  },
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "vrooli-bridge",
    "displayName": "Vrooli Bridge",
    "description": "Fleet control plane that provisions, updates, and runs allowlisted commands across an owner's trusted Vrooli nodes on every OS",
    "version": "0.0.1",
    "type": "business-application",
    "category": "automation",
    "tags": [
      "react-ui",
      "go-api"
    ]
  },
  "generation": {
    "template": {
      "id": "react-vite",
      "version": "1.1.0"
    },
    "generated_at": "2026-06-18T00:14:20Z",
    "design": {
      "id": "vrooli-default",
      "version": "0.2.0",
      "adapter": "react-vite-tailwind"
    },
    "manifest_sha": "f70bc94203f839ba4825223e7d60f8c5cb8983442653a68a6f7f07d3726f00cd",
    "content_sha": "07c578f32d3ba10c86cc91ce06d830a48959a1fffad8348f97a9858b6313bbc8"
  },
  "cli": {
    "enabled": true,
    "command": "vrooli-bridge",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {},
      "build_metadata": {}
    },
    "invoke": {
      "kind": "installed_command",
      "command": "vrooli-bridge"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server; fixed Bridge control-plane port for LAN admission",
      "port": 18767,
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/vrooli-bridge-api"
            ]
          },
          {
            "type": "cli",
            "command": "vrooli-bridge"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o vrooli-bridge-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./vrooli-bridge-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/vrooli-bridge-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "flow-verifier verify check --root .",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute vrooli-bridge --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    }
  },
  "dependencies": {
    "scenarios": {
      "scenario-authenticator": {
        "type": "scenario",
        "enabled": true,
        "required": true,
        "startup_policy": "try_start",
        "degraded_behavior": "Bridge fails closed for owner-session and protected fleet operations when the authenticator is unavailable.",
        "description": "Owner identity and token validation for Bridge's authenticated control-plane surface."
      }
    }
  },
  "environment": {
    "SQLITE_PATH": "${SCENARIO_DATA_DIR}/vrooli-bridge.db",
    "API_BIND_ADDRESS": "0.0.0.0"
  }
}
