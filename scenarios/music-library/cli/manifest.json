{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "music-library",
  "description": "Manage library notes and the track catalog through the Music Library API.",
  "groups": [
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "ListNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Note title"
            },
            {
              "name": "body",
              "description": "Note body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CreateNote"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Note id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "GetNote"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            {
              "name": "window",
              "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CountNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    },
    {
      "name": "catalog",
      "description": "Manage track judgments and project use",
      "commands": [
        {
          "name": "put",
          "description": "Save a track and explicit listener judgment",
          "flags": [
            {
              "name": "sha256",
              "required": true,
              "description": "Source audio SHA-256"
            },
            {
              "name": "title",
              "required": true,
              "description": "Track title"
            },
            {
              "name": "path",
              "required": true,
              "description": "Read-only source path"
            },
            {
              "name": "take",
              "required": false,
              "description": "Generation take ID"
            },
            {
              "name": "receipt",
              "required": false,
              "description": "Generation receipt path"
            },
            {
              "name": "tags",
              "required": false,
              "description": "Comma-separated tags"
            },
            {
              "name": "approval",
              "required": true,
              "description": "liked, unreviewed or rejected"
            },
            {
              "name": "feedback",
              "required": false,
              "description": "Listener feedback"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "PutTrack"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "Find tracks by tag, project or accepted use",
          "flags": [
            {
              "name": "tag",
              "required": false,
              "description": "Exact tag"
            },
            {
              "name": "unused",
              "required": false,
              "description": "true to exclude accepted uses"
            },
            {
              "name": "project",
              "required": false,
              "description": "Project identifier"
            },
            {
              "name": "approval",
              "required": false,
              "description": "liked, unreviewed or rejected"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "ListTracks"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "use",
          "description": "Record a draft or accepted project use",
          "flags": [
            {
              "name": "sha256",
              "required": true,
              "description": "Source audio SHA-256"
            },
            {
              "name": "project",
              "required": true,
              "description": "Project identifier"
            },
            {
              "name": "revision",
              "required": true,
              "description": "Revision identifier"
            },
            {
              "name": "status",
              "required": true,
              "description": "draft or accepted"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "RecordUse"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "notes",
        "stateful": true,
        "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier."
      }
    ]
  },
  "exceptions": [
    {
      "command": "notes attach",
      "class": "upload",
      "reason": "Multipart file upload is exposed through the notes REST attachment endpoint, while cli-manifest/v1 only models Connect-RPC bindings."
    }
  ],
  "omitted": []
}
