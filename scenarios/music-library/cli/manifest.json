{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "music-library",
  "description": "Manage library notes and the track catalog through the Music Library API.",
  "groups": [
    {
      "name": "releases",
      "description": "Create immutable local release drafts and inspect rights-aware showcase evidence",
      "commands": [
        {
          "name": "list",
          "description": "List bounded latest release revisions",
          "flags": [
            {"name":"limit","description":"Page size from 1 to 50 (default 20)"},
            {"name":"cursor","description":"Opaque next cursor returned by the prior page"}
          ],
          "needs_api": true,
          "binding": {"kind":"local","handler":"release-list"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "create",
          "description": "Create a release draft from one JSON edition file",
          "flags": [{"name":"file","required":true,"description":"Path to an edition JSON object with exact catalog hashes and provenance fields"}],
          "needs_api": true,
          "binding": {"kind":"local","handler":"release-create"},
          "governance": {"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "get",
          "description": "Read the latest release revision and its property-by-property eligibility report",
          "positionals": [{"name":"release_id","required":true,"description":"Stable release identifier"}],
          "flags": [{"name":"revision","description":"Optional immutable edition revision"}],
          "needs_api": true,
          "binding": {"kind":"local","handler":"release-get"},
          "governance": {"effect":"read","run_eligible":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "rights",
          "description": "Append an operator rights decision for one exact track hash, immutable release revision and pinned catalog receipt",
          "positionals": [{"name":"release_id","required":true,"description":"Stable release identifier"}],
          "flags": [
            {"name":"revision","required":true,"description":"Exact immutable release revision"},
            {"name":"decision-id","required":true,"description":"Unique rights decision event id"},
            {"name":"track-hash","required":true,"description":"Exact catalog track SHA-256"},
            {"name":"source-license","required":true,"description":"License reviewed from the pinned source receipt"},
            {"name":"usage-scope","required":true,"values":["personal_only","commercial","blocked"],"description":"Operator-approved use scope"},
            {"name":"decision","required":true,"values":["confirmed","denied"],"description":"Operator decision after inspecting the source receipt"},
            {"name":"evidence-ref","required":true,"description":"Exact catalog receipt reference for this track hash"},
            {"name":"note","description":"Optional rights review note"}
          ],
          "needs_api": true,
          "binding": {"kind":"local","handler":"release-rights"},
          "governance": {"effect":"write","run_eligible":false,"requires_confirmation":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"action"}
        },
        {
          "name": "review",
          "description": "Append the operator's one-batch EP decision after eligibility checks",
          "positionals": [{"name":"release_id","required":true,"description":"Stable release identifier"}],
          "flags": [
            {"name":"revision","required":true,"description":"Exact immutable revision reviewed"},
            {"name":"review-id","required":true,"description":"Unique review event id"},
            {"name":"all-tracks-heard","required":true,"values":["yes"],"description":"Confirm that every ordered exact-hash track was heard before this decision"},
            {"name":"decision","required":true,"values":["approved","changes_requested"],"description":"Operator's decision after listening to the assembled EP"},
            {"name":"note","description":"Optional review note"}
          ],
          "needs_api": true,
          "binding": {"kind":"local","handler":"release-review"},
          "governance": {"effect":"write","run_eligible":false,"requires_confirmation":true,"permissions":["network:internal"]},
          "architecture": {"primitive":"action"}
        }
      ]
    },
    {
      "name": "taste",
      "description": "Inspect and steer the durable taste profile, compare tracks, and explain recommendations",
      "commands": [
        {"name":"profile","description":"Read taste controls, learned weights, uncertainty, and judgments","flags":[{"name":"context","description":"Taste context (default when omitted)"}],"binding":{"kind":"connect-rpc","service":"TasteService","method":"GetProfile"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"control","description":"Set an explicit taste attribute control","flags":[{"name":"context","description":"Taste context"},{"name":"attribute","required":true,"description":"Attribute identifier such as tag:syncopated"},{"name":"mode","required":true,"description":"boost, suppress, pin, or ban"},{"name":"value","required":true,"description":"Control value from -1 to 1"}],"binding":{"kind":"connect-rpc","service":"TasteService","method":"SetControl"},"governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_mutation"}},
        {"name":"pair","description":"Select the next informative comparison (or measurable random baseline)","flags":[{"name":"context","description":"Taste context"},{"name":"random","description":"Set true for random-baseline selection"},{"name":"seed","description":"Deterministic random seed for baseline comparisons"}],"binding":{"kind":"connect-rpc","service":"TasteService","method":"SelectPair"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}},
        {"name":"judge","description":"Append a provenance-bound operator comparison","flags":[{"name":"context","description":"Taste context"},{"name":"left","required":true,"description":"Exact left catalog track SHA-256"},{"name":"right","required":true,"description":"Exact right catalog track SHA-256"},{"name":"choice","required":true,"description":"left, right, tie, neither, or skip"},{"name":"reason","description":"Optional operator reason"},{"name":"attribute-scope","description":"Optional attribute being compared"},{"name":"reverses","description":"Prior judgment ID being corrected"}],"binding":{"kind":"connect-rpc","service":"TasteService","method":"RecordJudgment"},"governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_mutation"}},
        {"name":"recommend","description":"Rank catalog tracks from a seed and produce an MQ2-ready brief","flags":[{"name":"context","description":"Taste context"},{"name":"seed","required":true,"description":"Seed catalog track SHA-256"}],"binding":{"kind":"connect-rpc","service":"TasteService","method":"Recommend"},"governance":{"effect":"read","run_eligible":true,"permissions":["network:internal"]},"architecture":{"primitive":"proto_list"}}
      ]
    },
    {
      "name": "notes",
      "description": "Manage notes (CRUD reference)",
      "commands": [
        {
          "name": "list",
          "description": "List all notes",
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "ListNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a note",
          "flags": [
            {
              "name": "title",
              "required": true,
              "description": "Note title"
            },
            {
              "name": "body",
              "description": "Note body"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CreateNote"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "get",
          "description": "Get a note by id",
          "positionals": [
            {
              "name": "id",
              "required": true,
              "description": "Note id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "GetNote"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "count",
          "description": "Count notes created in a time window (the reference measure)",
          "flags": [
            {
              "name": "window",
              "description": "Time window token (this_week, last_7d, last_30d, this_month, last_month, this_quarter)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "NotesService",
            "method": "CountNotes"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          },
          "measure": {
            "intent": "How many notes were created in a given time window.",
            "questions": [
              "how many notes were created this week",
              "notes created last month",
              "how many notes did we add in the last 7 days"
            ],
            "params": {
              "window": {
                "type": "time_window",
                "default": "this_week"
              }
            },
            "result": {
              "kind": "scalar",
              "value_field": "count",
              "unit": "notes",
              "summary_template": "{count} notes created ({window})"
            }
          }
        }
      ]
    },
    {
      "name": "catalog",
      "description": "Manage track judgments and project use",
      "commands": [
        {
          "name": "put",
          "description": "Save a track and explicit listener judgment",
          "flags": [
            {
              "name": "sha256",
              "required": true,
              "description": "Source audio SHA-256"
            },
            {
              "name": "title",
              "required": true,
              "description": "Track title"
            },
            {
              "name": "path",
              "required": true,
              "description": "Read-only source path"
            },
            {
              "name": "take",
              "required": false,
              "description": "Generation take ID"
            },
            {
              "name": "receipt",
              "required": false,
              "description": "Generation receipt path"
            },
            {
              "name": "tags",
              "required": false,
              "description": "Comma-separated tags"
            },
            {
              "name": "purposes",
              "required": false,
              "description": "Comma-separated approved bank purposes"
            },
            {
              "name": "priority",
              "required": false,
              "description": "Bank order (1 is preferred; default 100)"
            },
            {
              "name": "approval",
              "required": true,
              "description": "liked, unreviewed or rejected"
            },
            {
              "name": "feedback",
              "required": false,
              "description": "Listener feedback"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "PutTrack"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "list",
          "description": "Find tracks by tag, project or accepted use",
          "flags": [
            {
              "name": "tag",
              "required": false,
              "description": "Exact tag"
            },
            {
              "name": "purpose",
              "required": false,
              "description": "Exact bank purpose"
            },
            {
              "name": "unused",
              "required": false,
              "description": "true to exclude accepted uses"
            },
            {
              "name": "project",
              "required": false,
              "description": "Project identifier"
            },
            {
              "name": "approval",
              "required": false,
              "description": "liked, unreviewed or rejected"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "ListTracks"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "use",
          "description": "Record a draft or accepted project use",
          "flags": [
            {
              "name": "sha256",
              "required": true,
              "description": "Source audio SHA-256"
            },
            {
              "name": "project",
              "required": true,
              "description": "Project identifier"
            },
            {
              "name": "revision",
              "required": true,
              "description": "Revision identifier"
            },
            {
              "name": "status",
              "required": true,
              "description": "draft or accepted"
            }
            ,{
              "name": "purpose",
              "required": false,
              "description": "Purpose of the project use"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CatalogService",
            "method": "RecordUse"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "reserve",
          "description": "Lease one unused approved bank track for a film revision",
          "flags": [
            {"name":"purpose","required":true,"description":"Bank purpose such as launch-video"},
            {"name":"project","required":true,"description":"Film/project identifier"},
            {"name":"revision","required":true,"description":"Film revision identifier"},
            {"name":"consumer","required":true,"description":"Stable consumer/run identifier"},
            {"name":"sha256","required":false,"description":"Exact liked track to intentionally reuse"},
            {"name":"lease-seconds","required":false,"description":"Reservation lifetime (30–3600; default 900)"}
          ],
          "binding":{"kind":"connect-rpc","service":"CatalogService","method":"ReserveTrack"},
          "governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture":{"primitive":"proto_mutation"}
        },
        {
          "name": "release",
          "description": "Release an active bank track lease",
          "flags": [
            {"name":"reservation","required":true,"description":"Reservation identity returned by reserve"},
            {"name":"consumer","required":true,"description":"Same consumer/run identifier used to reserve"}
          ],
          "binding":{"kind":"connect-rpc","service":"CatalogService","method":"ReleaseReservation"},
          "governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture":{"primitive":"proto_mutation"}
        },
        {
          "name": "commit",
          "description": "Bind a reservation to its film as draft or accepted use",
          "flags": [
            {"name":"reservation","required":true,"description":"Reservation identity returned by reserve"},
            {"name":"consumer","required":true,"description":"Same consumer/run identifier used to reserve"},
            {"name":"status","required":true,"description":"draft or accepted"}
          ],
          "binding":{"kind":"connect-rpc","service":"CatalogService","method":"CommitReservation"},
          "governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture":{"primitive":"proto_mutation"}
        },
        {
          "name": "rollback",
          "description": "Undo a committed draft use when the film cut is abandoned",
          "flags": [
            {"name":"reservation","required":true,"description":"Reservation identity returned by reserve"},
            {"name":"consumer","required":true,"description":"Same consumer/run identifier used to reserve"}
          ],
          "binding":{"kind":"connect-rpc","service":"CatalogService","method":"RollbackReservation"},
          "governance":{"effect":"write","run_eligible":true,"permissions":["network:internal"]},
          "architecture":{"primitive":"proto_mutation"}
        }
      ]
    }
  ],
  "measures": {
    "domains": [
      {
        "domain": "notes",
        "stateful": true,
        "reason": "Notes are countable persisted rows; the notes count measure covers this domain at full tier."
      }
    ]
  },
  "exceptions": [
    {
      "command": "notes attach",
      "class": "upload",
      "reason": "Multipart file upload is exposed through the notes REST attachment endpoint, while cli-manifest/v1 only models Connect-RPC bindings."
    }
  ],
  "omitted": []
}
