{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "workflow-health",
  "description": "Workflow Health CLI surface for validating, fixing, and inspecting scenario-owned BAS workflow assets.",
  "groups": [
    {
      "name": "validate",
      "description": "Validate workflow assets through the shared scenario-validation provider contract",
      "commands": [
        {
          "name": "scenario",
          "description": "Validate a scenario's BAS workflow catalog and optional execution evidence",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id to validate"
            }
          ],
          "flags": [
            {
              "name": "path",
              "description": "Explicit scenario directory path"
            },
            {
              "name": "include-execution",
              "bool": true,
              "description": "Execute validation cases through BAS after static validation"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "ValidateScenario"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        }
      ]
    },
    {
      "name": "fix",
      "description": "Preview or apply deterministic workflow metadata fixes",
      "commands": [
        {
          "name": "preview",
          "description": "Preview deterministic workflow fixes",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id to fix"
            }
          ],
          "flags": [
            {
              "name": "path",
              "description": "Explicit scenario directory path"
            },
            {
              "name": "rule",
              "description": "Comma-separated rule ids to fix"
            },
            {
              "name": "apply",
              "bool": true,
              "description": "Apply the previewed fixes instead of reporting only"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "PreviewFix"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        },
        {
          "name": "apply",
          "description": "Apply deterministic workflow fixes",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario id to fix"
            }
          ],
          "flags": [
            {
              "name": "path",
              "description": "Explicit scenario directory path"
            },
            {
              "name": "rule",
              "description": "Comma-separated rule ids to fix"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "ApplyFix"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read",
              "filesystem:write"
            ]
          }
        }
      ]
    },
    {
      "name": "workflows",
      "description": "Inspect and search scenario-owned BAS workflow assets",
      "commands": [
        {
          "name": "search",
          "description": "Search typed workflow leaves for agent and validation intents",
          "positionals": [
            {
              "name": "query",
              "required": true,
              "description": "Natural-language workflow intent"
            }
          ],
          "flags": [
            {
              "name": "scenario",
              "description": "Scenario id to search"
            },
            {
              "name": "path",
              "description": "Explicit scenario directory path"
            },
            {
              "name": "type",
              "description": "Comma-separated leaf types: workflow.flow, workflow.test, workflow.fragment"
            },
            {
              "name": "include-fragments",
              "bool": true,
              "description": "Include workflow.fragment dependency leaves when no explicit type filter is supplied"
            },
            {
              "name": "limit",
              "description": "Maximum number of results"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "WorkflowSearchService",
            "method": "SearchWorkflows"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:read"
            ]
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "omitted": []
}
