{
  "$schema": "https://vrooli.dev/schemas/test-genie-phase-descriptor.schema.json",
  "schemaVersion": "1.0.0",
  "scenario": "workflow-health",
  "phase": "workflow",
  "displayName": "Workflow",
  "description": "Validates BAS workflow assets and safe execution through workflow-health.",
  "source": "validation-provider",
  "orderHint": 12,
  "timeout": "900s",
  "findingSource": "workflow",
  "validation": {
    "contract": "scenario-validation/v1",
    "deliveryMode": "durable-run",
    "execution": true,
    "runService": "scenario-validation/v1.DurableValidationRunService"
  },
  "applicability": {
    "default": "applies"
  },
  "policy": {
    "selection": "default_when_applicable",
    "providerReadiness": "required_when_applicable",
    "providerLifecycle": "start_if_needed",
    "freshness": "require_live_contract",
    "resultGating": "gating",
    "unavailable": "fail"
  },
  "runnability": {
    "needsUI": true,
    "mutatesLifecycle": true,
    "lifecycleDecisionDeferred": true,
    "dbIsolation": "routed",
    "requiredResources": [
      "browser-automation-studio"
    ]
  },
  "docs": {
    "path": "scenarios/test-genie/docs/phases/workflow/README.md"
  },
  "maturity": {
    "version": "2.0.0",
    "levels": [
      {
        "id": "L0",
        "name": "No workflow surface",
        "status_label": "Unavailable",
        "description": "No scenario-owned BAS workflow surface can be scanned.",
        "entry_criteria": [],
        "exit_criteria": [
          "At least one BAS case, flow, action, seed, or registry entry is discoverable."
        ],
        "capability_summary": "Workflow Health cannot find a usable workflow surface.",
        "next_unlock": "A discoverable BAS workflow catalog."
      },
      {
        "id": "L1",
        "name": "Discoverable catalog",
        "status_label": "Cataloged",
        "description": "Workflow assets can be discovered and parsed into stable catalog records.",
        "entry_criteria": [
          "Catalog scanner returns deterministic asset IDs and roles."
        ],
        "exit_criteria": [
          "Validation cases are linked to requirements and registry facts are current."
        ],
        "capability_summary": "Workflow assets are discoverable.",
        "next_unlock": "Requirement-traceable validation cases."
      },
      {
        "id": "L2",
        "name": "Traceable workflows",
        "status_label": "Traceable",
        "description": "Validation cases have requirement evidence and workflow metadata is complete enough to explain intent.",
        "entry_criteria": [
          "Validation cases carry requirement links.",
          "Core metadata is present."
        ],
        "exit_criteria": [
          "Subflows resolve and mutating workflows declare safety metadata."
        ],
        "capability_summary": "Workflow validation evidence is traceable.",
        "next_unlock": "Safe workflow execution posture."
      },
      {
        "id": "L3",
        "name": "Safe workflows",
        "status_label": "Safe",
        "description": "Mutating workflows fail closed unless reset, confirmation, seed, and routed-isolation metadata are declared.",
        "entry_criteria": [
          "Mutating workflows declare fail-closed safety metadata."
        ],
        "exit_criteria": [
          "Validation cases are executable through BAS with artifact evidence."
        ],
        "capability_summary": "Workflow safety posture is explicit.",
        "next_unlock": "Executable workflow evidence."
      },
      {
        "id": "L4",
        "name": "Executable workflows",
        "status_label": "Executable",
        "description": "Validation cases can run through BAS and return artifact evidence.",
        "entry_criteria": [
          "BAS-backed execution can run selected cases safely."
        ],
        "exit_criteria": [
          "Runs publish rich operational evidence and search leaves."
        ],
        "capability_summary": "Workflow cases can produce execution evidence.",
        "next_unlock": "Operationally rich workflow intelligence."
      },
      {
        "id": "L5",
        "name": "Operational workflow intelligence",
        "status_label": "Operational",
        "description": "Workflow runs, artifacts, fixes, and search leaves are integrated for operators and agents.",
        "entry_criteria": [
          "Workflow Health exposes provider, execution, fix, search, and UI evidence."
        ],
        "exit_criteria": [],
        "capability_summary": "Workflow Health is an operational workflow intelligence provider."
      }
    ],
