{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.workflow_health.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.workflow_health.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate scenario workflow health",
      "description": "Scans scenario-owned BAS cases, flows, actions, seeds, and registry metadata, optionally executes validation cases through BAS, and returns the shared scenario-validation response.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "metrics": "common.v1.ExecutionMetrics",
          "native_detail": "google.protobuf.Any<google.protobuf.Struct>",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario/path is missing, cannot be resolved, or workflow execution cannot reach BAS"
        }
      ],
      "examples": [
        {
          "name": "Validate workflow assets",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"workflow-health\"}'"
        }
      ]
    },
    {
      "id": "validation_start_run",
      "path": "/vrooli.scenario_validation.v1.DurableValidationRunService/StartValidationRun",
      "method": "POST",
      "summary": "Start a durable workflow validation run",
      "description": "Persists a provider-owned execution run and returns promptly with static evidence and a reattachable handle.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "idempotency_key": "string",
          "parent_run_id": "string",
          "path": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "run": "scenario_validation.v1.ValidationRun"
        }
      }
    },
    {
      "id": "validation_get_run",
      "path": "/vrooli.scenario_validation.v1.DurableValidationRunService/GetValidationRun",
      "method": "POST",
      "summary": "Get a durable workflow validation run",
      "description": "Reads persisted provider-owned run state for reattachment or recovery.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "run_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "run": "scenario_validation.v1.ValidationRun"
        }
      }
    },
    {
      "id": "validation_wait_run",
      "path": "/vrooli.scenario_validation.v1.DurableValidationRunService/WaitValidationRun",
      "method": "POST",
      "summary": "Wait for a durable workflow validation run",
      "description": "Blocks on provider-owned lifecycle notifications without cancelling provider work on caller timeout or disconnect.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "run_id": "string",
          "timeout": "google.protobuf.Duration"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "run": "scenario_validation.v1.ValidationRun"
        }
      }
    },
    {
      "id": "validation_abort_run",
      "path": "/vrooli.scenario_validation.v1.DurableValidationRunService/AbortValidationRun",
      "method": "POST",
      "summary": "Abort a durable workflow validation run",
      "description": "Records an explicit cancellation request and asks the provider worker to stop.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "reason": "string",
          "run_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "run": "scenario_validation.v1.ValidationRun"
        }
      }
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview deterministic workflow fixes",
      "description": "Returns candidate edits for mechanical workflow fixes such as registry rebuilds, metadata stubs, execution-mode normalization, and legacy reset normalization.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario/path is missing or cannot be resolved"
        }
      ]
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply deterministic workflow fixes",
      "description": "Applies workflow-health's deterministic mechanical fixes and reports the edits written to disk.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario/path is missing or cannot be resolved"
        }
      ]
    },
    {
      "id": "workflows_search",
      "path": "/vrooli.workflow_health.v1.workflows.WorkflowSearchService/SearchWorkflows",
      "method": "POST",
      "summary": "Search scenario workflow assets",
      "description": "Scans scenario-owned BAS workflow assets and returns typed workflow.flow, workflow.test, and workflow.fragment leaves with deterministic ranking and safety guardrails.",
      "category": "workflows",
      "request": {
        "type": "object",
        "properties": {
          "include_fragments": "bool",
          "limit": "int32",
          "path": "string",
          "query": "string",
          "scenario": "string",
          "types": "[]string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "query": "string",
          "results": "[]WorkflowSearchResult",
          "scenario": "string",
          "total": "int32"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Scenario/path is missing or cannot be resolved"
        }
      ],
      "examples": [
        {
          "name": "Search safe flows",
          "curl": "curl http://localhost:${API_PORT}/vrooli.workflow_health.v1.workflows.WorkflowSearchService/SearchWorkflows -H 'Content-Type: application/json' -d '{\"scenario\":\"workflow-health\",\"query\":\"run workflow\",\"types\":[\"workflow.flow\"]}'"
        }
      ]
    }
  ]
}
