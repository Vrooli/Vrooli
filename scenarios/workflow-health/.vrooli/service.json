{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "5GiB",
          "rationale": "Durable storage is bounded by the workload byte ceiling; it is alarm-only because the data is not regenerable."
        }
      },
      "run_artifacts": {
        "rung": "owned",
        "kind": "dir",
        "class": "state",
        "subpath": "run-artifacts",
        "regenerable": false,
        "rationale": "Workflow execution summaries (latest.json, the checksummed evidence reference) and full BAS timelines keyed by target scenario and validation run. Owner retention removes only timeline.json of finished runs that are older than 3 days, not among the newest 2 per workflow, not active, not pinned with .retain, and not cited by run ID under docs/ or .vrooli/work/; summaries are never removed.",
        "budget": {
          "max_bytes": "6GiB",
          "rationale": "Timelines are dominated by per-step DOM snapshots (2-20 MB per case). The owner trims oldest-first down to 6 GiB but never removes a timeline younger than 24h or a protected one, so heavy delivery days can still alarm."
        },
        "reclaim": {
          "pruner": "custom"
        }
      },
      "run_artifacts_retention_receipt": {
        "rung": "owned",
        "kind": "file",
        "class": "state",
        "format": "json",
        "subpath": "retention/run-artifacts-receipt.json",
        "regenerable": true,
        "rationale": "Detailed last-cycle receipt of run-artifact timeline retention: every pruned path, bytes, reason, and protection counts.",
        "budget": {
          "max_bytes": "64MiB",
          "rationale": "Replaced each cycle; the first backlog cycle lists tens of thousands of pruned paths."
        }
      },
      "retention": {
        "rung": "owned",
        "kind": "file",
        "class": "state",
        "format": "json",
        "subpath": "retention/enforcement-receipt.json",
        "regenerable": true,
        "rationale": "Shared storage retention enforcement receipt for the run-artifact owner pruner.",
        "budget": {
          "max_bytes": "1MiB",
          "max_age": "30d",
          "rationale": "The receipt is bounded regenerable operational state replaced on each cycle."
        }
      }
    },
    "rationale": "Storage surfaces include durable scenario data and the owner-scoped workflow run store, keyed by target scenario."
  },
