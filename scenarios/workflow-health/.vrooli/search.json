{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "workflow-health.workflows",
      "provider_group": "workflow-health",
      "bucket": "BUCKET_DO",
      "type": "workflow.flow",
      "description": "Scenario-owned BAS workflow assets exposed by workflow-health: runnable flows, validation cases, and reusable fragments with safety metadata, requirement links, selectors, routes, and guardrails. Route here to find workflow journeys, workflow tests, or workflow fragments before hand-rolling browser automation.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/vrooli.workflow_health.v1.workflows.WorkflowSearchService/SearchWorkflows",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scenario\":\"workflow-health\",\"query\":\"{{query}}\",\"types\":[\"{{type}}\"],\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "title",
        "score_field": "score",
        "snippet_field": "snippet",
        "path_field": "path",
        "score_scale": "SCORE_SCALE_RAW"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "rerank_enabled": false
      },
      "tests": {
        "name": "workflow-health workflows - primary golden corpus",
        "description": "Starter rank-centric corpus for the workflow-health workflow provider. The provider is deterministic and scans the workflow-health BAS catalog through WorkflowSearchService.",
        "cases": [
          {
            "id": "performance-flow",
            "query": "find a performance workflow flow",
            "tags": [
              "strong",
              "workflow.flow"
            ],
            "expect_ids": [
              "workflow-health:bas/flows/perf-example-scroll.json"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "junk-gibberish",
            "query": "florbnax qwop zxcv workflow nonsense",
            "tags": [
              "gibberish"
            ],
            "expect_no_strong_hit": true,
            "expect_max_score": 4.5
          }
        ],
        "coverage": {
          "required_tag_groups": [
            {
              "id": "workflow-assets",
              "description": "Runnable flows and validation cases surfaced from the BAS catalog.",
              "tags": [
                "workflow.flow",
                "workflow.test"
              ],
              "min_reviewed_positive": 1
            }
          ]
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/health",
          "method": "HTTP_METHOD_GET",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      }
    },
    {
      "provider_id": "workflow-health.tests",
      "provider_group": "workflow-health",
      "bucket": "BUCKET_REUSE",
      "type": "workflow.test",
      "description": "Scenario-owned BAS validation cases indexed by workflow-health. Route here to find workflow evidence that proves scenario behavior or requirement coverage.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/vrooli.workflow_health.v1.workflows.WorkflowSearchService/SearchWorkflows",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scenario\":\"workflow-health\",\"query\":\"{{query}}\",\"types\":[\"{{type}}\"],\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "title",
        "score_field": "score",
        "snippet_field": "snippet",
        "path_field": "path",
        "score_scale": "SCORE_SCALE_RAW"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "rerank_enabled": false
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/health",
          "method": "HTTP_METHOD_GET",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "tests": {
        "name": "workflow-health tests — primary golden corpus",
        "description": "Reviewed corpus for BAS validation cases indexed by workflow-health.",
        "coverage": {
          "required_tags": [
            "workflow.test"
          ]
        },
        "cases": [
          {
            "id": "routed-database-case",
            "query": "test case for routed database pool isolation",
            "tags": [
              "strong",
              "workflow.test"
            ],
            "expect_ids": [
              "workflow-health:bas/cases/routed-database/proves-test-pool-routing.json"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "junk-gibberish",
            "query": "florbnax qwop zxcv workflow test nonsense",
            "tags": [
              "gibberish"
            ],
            "expect_no_strong_hit": true,
            "expect_max_score": 6.5
          }
        ]
      }
    },
    {
      "provider_id": "workflow-health.fragments",
      "provider_group": "workflow-health",
      "bucket": "BUCKET_REUSE",
      "type": "workflow.fragment",
      "description": "Scenario-owned BAS action fragments indexed by workflow-health. Route here to find reusable browser automation fragments and dependency building blocks, not top-level autonomous workflows.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/vrooli.workflow_health.v1.workflows.WorkflowSearchService/SearchWorkflows",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scenario\":\"workflow-health\",\"query\":\"{{query}}\",\"types\":[\"{{type}}\"],\"includeFragments\":true,\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "id",
        "title_field": "title",
        "score_field": "score",
        "snippet_field": "snippet",
        "path_field": "path",
        "score_scale": "SCORE_SCALE_RAW"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "rerank_enabled": false
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "workflow-health",
          "path": "/health",
          "method": "HTTP_METHOD_GET",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "tests": {
        "name": "workflow-health fragments — honest empty-readiness corpus",
        "description": "Reviewed corpus for reusable BAS action fragments indexed by workflow-health.",
        "cases": [
          {
            "id": "drag-horizontal-fragment",
            "query": "reusable fragment to drag a horizontal resize handle",
            "tags": [
              "strong",
              "workflow.fragment"
            ],
            "expect_ids": [
              "workflow-health:bas/actions/perf-drag-horizontal.json"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "scroll-ancestor-fragment",
            "query": "reusable fragment to scroll nearest ancestor",
            "tags": [
              "weak-real",
              "workflow.fragment"
            ],
            "expect_ids": [
              "workflow-health:bas/actions/perf-scroll-ancestor.json"
            ],
            "expect_within_top_k": 3
          },
          {
            "id": "fragment-junk-gibberish",
            "query": "florbnax qwop zxcv workflow fragment nonsense",
            "tags": [
              "gibberish"
            ],
            "expect_no_strong_hit": true,
            "expect_max_score": 0.3
          }
        ],
        "coverage": {
          "required_tags": [
            "workflow.fragment"
          ]
        }
      }
    }
  ]
}
