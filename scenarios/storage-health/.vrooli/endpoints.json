{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.storage_health.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.storage_health.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "advisor_analyze_migrations",
      "path": "/vrooli.storage_health.v1.advisor.AdvisorService/AnalyzeMigrations",
      "method": "POST",
      "summary": "Grade migration hygiene against deploy stage",
      "description": "Analyzes each requested scenario's (or every discovered scenario's) migration posture against its deploy stage — greenfield expects schema-as-desired-state; brownfield expects idempotent, ALTER-free, per-domain schema with a forward-migration path — and returns per-scenario hygiene plus stage-aware debt notes.",
      "category": "advisor",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "debt_count": "int32",
          "entries": "array<MigrationHygiene>",
          "errors": "array<AdvisorScanError>",
          "scenario_count": "int32",
          "with_migrations_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Migration analysis failure"
        }
      ],
      "examples": [
        {
          "name": "Analyze fleet migrations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.advisor.AdvisorService/AnalyzeMigrations -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "advisor_advise_engines",
      "path": "/vrooli.storage_health.v1.advisor.AdvisorService/AdviseEngines",
      "method": "POST",
      "summary": "Rank Postgres→SQLite migration candidates",
      "description": "Scores each requested scenario's (or every discovered scenario's) engine fitness and returns a ranked list of Postgres→SQLite migration candidates with rationale, fitness score, and any blockers. Vrooli is local-first; a single-node scenario carrying Postgres usually pays an external-service cost it does not need.",
      "category": "advisor",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "candidates": "array<EngineCandidate>",
          "errors": "array<AdvisorScanError>",
          "scenario_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Engine advisor failure"
        }
      ],
      "examples": [
        {
          "name": "Advise engine migrations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.advisor.AdvisorService/AdviseEngines -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "fleet_scan_fleet",
      "path": "/vrooli.storage_health.v1.fleet.FleetService/ScanFleet",
      "method": "POST",
      "summary": "Scan the fleet's storage inventory",
      "description": "Classifies the requested scenarios (or every discovered scenario) by engine, isolation-readiness, namespace adoption, deploy stage, and backup readiness, persists the snapshot, and rolls up fleet-wide distributions + offender counts.",
      "category": "fleet",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "data_dir_over_budget_count": "int32",
          "engine_distribution": "array<EngineCount>",
          "entries": "array<FleetScenarioEntry>",
          "errors": "array<FleetScanError>",
          "finding_count": "int32",
          "isolation_unready_count": "int32",
          "no_backup_count": "int32",
          "scanned_at": "string",
          "scenario_count": "int32",
          "stage_distribution": "array<StageCount>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Fleet scan failure"
        }
      ],
      "examples": [
        {
          "name": "Scan whole fleet",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.fleet.FleetService/ScanFleet -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "fleet_get_inventory",
      "path": "/vrooli.storage_health.v1.fleet.FleetService/GetInventory",
      "method": "POST",
      "summary": "Read the latest persisted fleet snapshot",
      "description": "Returns the most recent persisted fleet inventory snapshot without re-scanning. An empty snapshot (scenario_count 0) means ScanFleet has not run yet.",
      "category": "fleet",
      "request": {
        "type": "object"
      },
      "response": {
        "type": "object",
        "properties": {
          "entries": "array<FleetScenarioEntry>",
          "scanned_at": "string",
          "scenario_count": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Snapshot read failure"
        }
      ],
      "examples": [
        {
          "name": "Read snapshot",
          "curl": "curl http://localhost:${API_PORT}/vrooli.storage_health.v1.fleet.FleetService/GetInventory -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's storage judgment",
      "description": "Detects the target scenario's storage surface (engines + API language) and runs the applicable static storage analyzers, returning the shared scenario-validation response with findings in the maturity assessment.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string (required, scenario id)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "native_detail": "google.protobuf.Any",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id or scenario not found under scenarios/"
        }
      ],
      "examples": [
        {
          "name": "Validate scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-health\"}'"
        }
      ]
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview the deterministic storage autofixes for a scenario",
      "description": "Shared ScenarioValidationService Fix RPC. Returns the candidate edits the storage-health autofix registry would apply (DB_ROWS_NOT_CLOSED, ENSURE_SCHEMAS_NOT_WIRED) without writing anything. Optional rule_ids restricts the preview to specific finding codes.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id/path or scenario directory not resolvable"
        }
      ],
      "examples": [
        {
          "name": "Preview storage fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-health\"}'"
        }
      ]
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply the deterministic storage autofixes for a scenario",
      "description": "Shared ScenarioValidationService Fix RPC. Applies the storage-health autofix registry's deterministic edits (DB_ROWS_NOT_CLOSED, ENSURE_SCHEMAS_NOT_WIRED) and reports what changed. Idempotent: a second apply over an already-fixed tree is a no-op.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string",
          "rule_ids": "[]string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "bool",
          "candidates": "[]scenario_validation.v1.FixCandidate",
          "messages": "[]string",
          "scenario": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario id/path or scenario directory not resolvable"
        }
      ],
      "examples": [
        {
          "name": "Apply storage fixes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix -H 'Content-Type: application/json' -d '{\"scenario\":\"storage-health\"}'"
        }
      ]
    }
  ]
}
