{
  "metadata": {
    "description": "Generated observer smoke for active experience page triggers.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "triggers",
      "surface": "experience-triggers"
    },
    "name": "experience-triggers-spec-smoke",
    "requirement": "OT-P0-003",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Triggers"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "offer-desk",
          "scenario_path": "/triggers",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-triggers"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.triggerDryRunVerdict",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-triggers-primary-binding"
    },
    {
      "action": {
        "metadata": { "label": "Dry-run action visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.triggerDryRun",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-triggers-dry-run-action"
    },
    {
      "action": {
        "metadata": { "label": "Trigger declaration action visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.triggerDeclare",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-triggers-declare-action"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
