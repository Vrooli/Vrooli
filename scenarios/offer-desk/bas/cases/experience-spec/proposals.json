{
  "metadata": {
    "description": "Generated observer smoke for active experience page proposals.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "proposals",
      "surface": "experience-proposals"
    },
    "name": "experience-proposals-spec-smoke",
    "requirement": "OT-P0-005",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Proposals"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "offer-desk",
          "scenario_path": "/proposals",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-proposals"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.proposalProposer",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-proposals-primary-binding"
    },
    {
      "action": {
        "metadata": { "label": "Proposal accept action visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.proposalAccept",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-proposals-accept-action"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
