{
  "metadata": {
    "description": "Generated observer smoke for active experience page offers.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "offers",
      "surface": "experience-offers"
    },
    "name": "experience-offers-spec-smoke",
    "requirement": "OT-P0-001",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Offers"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "offer-desk",
          "scenario_path": "/offers",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-offers"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.offerGraph",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-offers-primary-binding"
    },
    {
      "action": {
        "metadata": { "label": "Grouped catalog view visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.catalogGroupedView",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-offers-grouped-view"
    },
    {
      "action": {
        "click": { "selector": "@selector/pages.catalogViewToggle" },
        "metadata": { "label": "Reach flat catalog table" },
        "type": "ACTION_TYPE_CLICK"
      },
      "id": "click-offers-flat-view"
    },
    {
      "action": {
        "metadata": { "label": "Flat offer table visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.offerTable",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-offers-table"
    },
    {
      "action": {
        "metadata": { "label": "Offer creation action visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.offerCreateNode",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-offers-create-action"
    },
    {
      "action": {
        "metadata": { "label": "Grouped and flat view toggle visible" },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.catalogViewToggle",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-offers-view-toggle"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
