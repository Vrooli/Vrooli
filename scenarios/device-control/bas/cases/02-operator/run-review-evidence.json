{
  "metadata": {
    "name": "device-control-run-review-evidence",
    "description": "Verify that run review renders retained evidence metadata and an inline retained capture when the run produces one.",
    "requirement": "DVC-P1-008",
    "version": "1",
    "labels": { "reset": "none", "surface": "run-review", "requires_confirmation": "true", "routed_isolation": "true" },
    "execution_mode": "EXECUTION_MODE_MUTATING"
  },
  "id": "c31d94f5-cf45-4e5a-a2d5-74ae75622a27",
  "project_id": "device-control",
  "name": "device-control-run-review-evidence",
  "folder_path": "/bas/cases/02-operator",
  "description": "A completed flow exposes chapter results and the retained capture to the operator.",
  "version": 1,
  "flow_definition": {
    "settings": { "viewport_width": 1440, "viewport_height": 900 },
    "nodes": [
      { "id": "open-flows", "action": { "type": "ACTION_TYPE_NAVIGATE", "navigate": { "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO", "scenario": "@scenario/self", "scenario_path": "/flows", "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE", "timeout_ms": 30000 }, "metadata": { "label": "Open flow authoring" } } },
      { "id": "wait-run", "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "@selector/pages.flowRun", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 20000 }, "metadata": { "label": "Run control renders" } } },
      { "id": "run", "action": { "type": "ACTION_TYPE_CLICK", "click": { "selector": "@selector/pages.flowRun" }, "metadata": { "label": "Run capture flow" } } },
      { "id": "wait-review", "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "@selector/pages.flowRunReview", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 30000 }, "metadata": { "label": "Run review renders" } } },
      { "id": "wait-capture", "action": { "type": "ACTION_TYPE_WAIT", "wait": { "selector": "@selector/pages.flowEvidenceImage", "state": "WAIT_STATE_VISIBLE", "timeout_ms": 30000 }, "metadata": { "label": "Retained capture renders inline" } } }
    ],
    "edges": [
      { "source": "open-flows", "target": "wait-run" },
      { "source": "wait-run", "target": "run" },
      { "source": "run", "target": "wait-review" },
      { "source": "wait-review", "target": "wait-capture" }
    ]
  }
}
