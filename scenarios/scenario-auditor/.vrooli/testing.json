{
  "$schema": "https://vrooli.com/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for scenario-auditor",
    "last_updated": "2025-11-08T17:17:00Z"
  },
  "version": "1.0.0",
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    },
    "ignore": [
      "coverage",
      "data",
      "docs",
      "initialization",
      "logs",
      "prompts"
    ]
  },
  "unit": {
    "languages": {
      "go": {
        "coverage": {
          "warn_threshold": 70,
          "error_threshold": 50
        }
      }
    }
  },
  "business": {
    "checks": {
      "endpoints": {
        "enabled": true
      },
      "cli_commands": {
        "enabled": true
      },
      "websockets": {
        "enabled": false
      }
    }
  }
}
