{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {"entries":{},"rationale":"No scenario-owned persistent directory was found in the canonical repository storage paths; the scenario uses external storage, generated test paths, or ephemeral runtime state."},
  "maturity": "greenfield",
  "service": {
    "parent": "vrooli",
    "name": "hello-desktop",
    "displayName": "Hello Desktop",
    "description": "Minimal self-contained fixture for verifying the Vrooli desktop delivery pipeline.",
    "version": "0.1.0",
    "type": "helper",
    "category": "deployment",
    "capabilities": ["desktop-delivery-fixture"]
  },
  "runtime": {
    "kind": "long_running",
    "auto_restart_default": false
  },
  "cli": {
    "enabled": true,
    "command": "hello-desktop",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "hello-desktop"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Hello Desktop API",
      "range": "23100-23200"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "Hello Desktop UI",
      "range": "23201-23300"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Hello Desktop API health check",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 5000
    },
    "setup": {
      "description": "Build the Hello Desktop API used by the fixture and generated desktop artifact",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/hello-desktop-api"
            ]
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go build -o hello-desktop-api .",
          "description": "Build the Hello Desktop API"
        },
        {
          "name": "build-ui",
          "run": "cd ui && pnpm run build",
          "description": "Build the Hello Desktop UI",
          "condition": {
            "file_exists": "ui/package.json"
          }
        }
      ]
    },
    "develop": {
      "description": "Launch the Hello Desktop API",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./hello-desktop-api",
          "background": true,
          "condition": {
            "file_exists": "api/hello-desktop-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.mjs",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "test": {}
  },
  "dependencies": {
    "resources": {}
  },
  "deployment": {
    "dependencies": {
      "resources": {}
    }
  }
}
