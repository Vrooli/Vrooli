{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "code-facts status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.code_facts.v1.health.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.code_facts.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "facts_describe",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/DescribeCodeFacts",
      "method": "POST",
      "summary": "Describe code facts",
      "description": "Returns a selective Code Facts report for a path, scenario, module, project, or repo target.",
      "category": "facts",
      "request": {
        "type": "object",
        "properties": {
          "include": "array<FactFamily>",
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache": "CacheMetadata",
          "facts": "array<GenericFact>",
          "parse_units": "array<ParseUnit>",
          "surfaces": "array<Surface>",
          "target": "TargetContext",
          "warnings": "array<Warning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "examples": [
        {
          "name": "Describe this scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.code_facts.v1.facts.CodeFactsService/DescribeCodeFacts -H 'Content-Type: application/json' -d '{\"target\":{\"kind\":\"TARGET_KIND_SCENARIO\",\"scenario\":\"code-facts\"},\"include\":[\"FACT_FAMILY_SURFACES\"]}'"
        }
      ],
      "cli_mapping": {
        "command": "code-facts facts describe",
        "args": [
          "<target>",
          "--include",
          "<families>"
        ]
      }
    },
    {
      "id": "facts_surfaces",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/ListSurfaces",
      "method": "POST",
      "summary": "List target surfaces",
      "description": "Returns the scenario or generic target surface inventory portion of a Code Facts report.",
      "category": "facts",
      "request": {
        "type": "object",
        "properties": {
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache": "CacheMetadata",
          "surfaces": "array<Surface>",
          "target": "TargetContext",
          "warnings": "array<Warning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts facts surfaces",
        "args": [
          "<target>"
        ]
      }
    },
    {
      "id": "facts_fleet_imports",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/DescribeFleetImports",
      "method": "POST",
      "summary": "Describe fleet import facts",
      "description": "Returns FACT_FAMILY_IMPORTS reports for many or all scenarios without resolving imports to scenario dependencies.",
      "category": "facts",
      "request": {
        "type": "object",
        "properties": {
          "language_filter": "array<string>",
          "limit": "integer (optional, 0 means no limit, max 500)",
          "repo_root": "string",
          "scenarios": "array<string> (optional, empty means all scenarios)",
          "use_cache": "bool"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "results": "array<CodeFactsResult>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid limit or scenario enumeration failure"
        }
      ],
      "cli_mapping": {
        "command": "code-facts facts fleet-imports",
        "args": [
          "--scenario",
          "<name>",
          "--json"
        ]
      }
    },
    {
      "id": "facts_proto_adoption",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/CheckProtoAdoption",
      "method": "POST",
      "summary": "Check proto adoption evidence",
      "description": "Returns generated proto adoption proof evidence for selected API, CLI, and UI surfaces.",
      "category": "facts",
      "request": {
        "type": "object",
        "properties": {
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache": "CacheMetadata",
          "evidence": "array<Evidence>",
          "facts": "array<GenericFact>",
          "family": "FactFamily",
          "target": "TargetContext",
          "warnings": "array<Warning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts facts proto-adoption",
        "args": [
          "<target>"
        ]
      }
    },
    {
      "id": "facts_endpoint_proof",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/CheckEndpointProof",
      "method": "POST",
      "summary": "Check endpoint implementation evidence",
      "description": "Returns static REST exception endpoint proof evidence for selected endpoint ids.",
      "category": "facts",
      "request": {
        "type": "object",
        "properties": {
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache": "CacheMetadata",
          "evidence": "array<Evidence>",
          "facts": "array<GenericFact>",
          "family": "FactFamily",
          "target": "TargetContext",
          "warnings": "array<Warning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts facts endpoint-proof",
        "args": [
          "<target>",
          "--endpoint",
          "<id>"
        ]
      }
    },
    {
      "id": "facts_cache_status",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/GetCacheStatus",
      "method": "POST",
      "summary": "Get cache status",
      "description": "Returns inspectable cache metadata for a target/options tuple.",
      "category": "cache",
      "request": {
        "type": "object",
        "properties": {
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache_key": "string",
          "entries": "int64"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts cache status",
        "args": [
          "<target>"
        ]
      }
    },
    {
      "id": "facts_cache_inspect",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/InspectCache",
      "method": "POST",
      "summary": "Inspect cache entries",
      "description": "Returns matching cache entries with key, freshness hash, analyzer, and scope metadata.",
      "category": "cache",
      "request": {
        "type": "object",
        "properties": {
          "cache_key": "string",
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache_key": "string",
          "entries": "int64",
          "entries_metadata": "array<CacheMetadata>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts cache inspect",
        "args": [
          "<target>",
          "--cache-key",
          "<key>"
        ]
      }
    },
    {
      "id": "facts_cache_clear",
      "path": "/vrooli.code_facts.v1.facts.CodeFactsService/ClearCache",
      "method": "POST",
      "summary": "Clear cache entries",
      "description": "Plans or clears cache entries for a target/options tuple.",
      "category": "cache",
      "request": {
        "type": "object",
        "properties": {
          "dry_run": "bool",
          "target": "CodeTarget (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cache_key": "string",
          "cleared_entries": "int64",
          "dry_run": "bool",
          "matched_entries": "int64"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Target kind or target identifier is missing"
        }
      ],
      "cli_mapping": {
        "command": "code-facts cache clear",
        "args": [
          "<target>",
          "--dry-run"
        ]
      }
    }
  ]
}
