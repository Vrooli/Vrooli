{
  "id": "f4235e5f-63f9-43ee-8324-fe2b69c21e54",
  "project_id": "10d4c288-8990-4bde-96df-87368dbd0b9a",
  "name": "evidence-workspace-readiness",
  "folder_path": "/bas/flows",
  "version": 1,
  "last_change_source": "CHANGE_SOURCE_MANUAL",
  "last_change_description": "Initial workflow creation",
  "created_at": "2026-08-21T02:22:13.025782824Z",
  "updated_at": "2026-08-21T02:22:13.025782824Z",
  "flow_definition": {
    "metadata": {
      "name": "evidence-workspace-readiness",
      "description": "Prove that index trust, bounded search controls, corpus readiness, and the evidence report are visible without documentation.",
      "labels": {
        "requirements_json": "[\"CF-P0-021\"]",
        "reset": "none"
      },
      "version": "1",
      "requirement": "CF-P0-021"
    },
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "navigate-facts",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "code-facts",
            "scenario_path": "/facts"
          },
          "metadata": {
            "label": "Open the evidence workspace"
          }
        }
      },
      {
        "id": "wait-workspace",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/facts.searchWorkspace",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for the showcase workspace"
          }
        }
      },
      {
        "id": "assert-index-trust",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/facts.indexStatus",
            "mode": "ASSERTION_MODE_VISIBLE",
            "failure_message": "Index trust must be visible beside search",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Index trust is visible"
          }
        }
      },
      {
        "id": "assert-report",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/facts.workbench",
            "mode": "ASSERTION_MODE_VISIBLE",
            "failure_message": "The evidence report must remain available",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Evidence report is visible"
          }
        }
      },
      {
        "id": "capture-readiness",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": true
          },
          "metadata": {
            "label": "Capture the complete evidence workspace"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "navigate-facts",
        "target": "wait-workspace"
      },
      {
        "source": "wait-workspace",
        "target": "assert-index-trust"
      },
      {
        "source": "assert-index-trust",
        "target": "assert-report"
      },
      {
        "source": "assert-report",
        "target": "capture-readiness"
      }
    ]
  }
}