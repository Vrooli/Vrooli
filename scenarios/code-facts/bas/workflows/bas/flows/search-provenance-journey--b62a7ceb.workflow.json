{
  "id": "b62a7ceb-9a1f-46b4-b785-cfb36e807bcd",
  "project_id": "10d4c288-8990-4bde-96df-87368dbd0b9a",
  "name": "search-provenance-journey",
  "folder_path": "/bas/flows",
  "version": 1,
  "last_change_source": "CHANGE_SOURCE_MANUAL",
  "last_change_description": "Initial workflow creation",
  "created_at": "2026-08-21T02:22:13.106674061Z",
  "updated_at": "2026-08-21T02:22:13.106674061Z",
  "flow_definition": {
    "metadata": {
      "name": "search-provenance-journey",
      "description": "Search for a concrete behavior, select ranked evidence, and prove that source provenance and bounded relationships are available.",
      "labels": {
        "requirements_json": "[\"CF-P0-015\",\"CF-P0-021\"]",
        "reset": "none"
      },
      "version": "1",
      "requirement": "CF-P0-021"
    },
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "navigate-facts",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
            "scenario": "code-facts",
            "scenario_path": "/facts"
          },
          "metadata": {
            "label": "Open the evidence workspace"
          }
        }
      },
      {
        "id": "wait-search",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/facts.searchButton",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for bounded search"
          }
        }
      },
      {
        "id": "run-search",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/facts.searchButton"
          },
          "metadata": {
            "label": "Search for provider demotion"
          }
        }
      },
      {
        "id": "wait-result",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/facts.resultCard",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Wait for ranked evidence"
          }
        }
      },
      {
        "id": "select-result",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/facts.resultCard"
          },
          "metadata": {
            "label": "Inspect the highest ranked evidence"
          }
        }
      },
      {
        "id": "assert-provenance",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/facts.provenancePanel",
            "mode": "ASSERTION_MODE_VISIBLE",
            "failure_message": "Selected evidence must expose provenance and relationships",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Provenance panel is visible"
          }
        }
      },
      {
        "id": "capture-evidence",
        "action": {
          "type": "ACTION_TYPE_SCREENSHOT",
          "screenshot": {
            "full_page": true
          },
          "metadata": {
            "label": "Capture ranked evidence with provenance"
          }
        }
      }
    ],
    "edges": [
      {
        "source": "navigate-facts",
        "target": "wait-search"
      },
      {
        "source": "wait-search",
        "target": "run-search"
      },
      {
        "source": "run-search",
        "target": "wait-result"
      },
      {
        "source": "wait-result",
        "target": "select-result"
      },
      {
        "source": "select-result",
        "target": "assert-provenance"
      },
      {
        "source": "assert-provenance",
        "target": "capture-evidence"
      }
    ]
  }
}