  "dynamicSelectors": {
    "locale.toggle": {
      "description": "Locale toggle button by language code",
      "selectorPattern": "[data-testid=\"locale-toggle-${code}\"]",
      "testIdPattern": "locale-toggle-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    },
    "layout.sidebarLink": {
      "description": "Sidebar navigation link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-sidebar-link-${key}\"]",
      "testIdPattern": "layout-sidebar-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "fleet",
            "settings"
          ]
        }
      ]
    },
    "layout.bottomNavLink": {
      "description": "Bottom-nav link by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-bottom-nav-link-${key}\"]",
      "testIdPattern": "layout-bottom-nav-link-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "fleet",
            "settings"
          ]
        }
      ]
    },
    "fleet.row": {
      "description": "Fleet coverage table row by scenario id",
      "selectorPattern": "[data-testid=\"fleet-row-${scenario}\"]",
      "testIdPattern": "fleet-row-${scenario}",
      "params": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    "fleet.rowVerdict": {
      "description": "Fleet coverage row verdict badge by scenario id",
      "selectorPattern": "[data-testid=\"fleet-row-verdict-${scenario}\"]",
      "testIdPattern": "fleet-row-verdict-${scenario}",
      "params": [
        {
          "name": "scenario",
          "type": "string"
        }
      ]
    },
    "fleet.domainRow": {
      "description": "Scenario drill-down domain row by domain name",
      "selectorPattern": "[data-testid=\"fleet-domain-${domain}\"]",
      "testIdPattern": "fleet-domain-${domain}",
      "params": [
        {
          "name": "domain",
          "type": "string"
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Theme choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-theme-${choice}\"]",
      "testIdPattern": "page-settings-theme-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "light",
            "dark",
            "system"
          ]
        }
      ]
    },
    "settingsPage.localeOption": {
      "description": "Locale choice radio button on the settings page",
      "selectorPattern": "[data-testid=\"page-settings-locale-${code}\"]",
      "testIdPattern": "page-settings-locale-${code}",
      "params": [
        {
          "name": "code",
          "type": "enum",
          "values": [
            "en",
            "ja",
            "ar"
          ]
        }
      ]
    }
  },
