{
  "metadata": {
    "description": "Generated observer smoke for active experience page memory.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "memory",
      "surface": "experience-memory"
    },
    "name": "experience-memory-spec-smoke",
    "requirement": "OT-P0-001",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": {
          "label": "Open Memory Metrics"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "system-monitor",
          "scenario_path": "/metrics/memory",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-memory"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/memory",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-memory-primary-binding"
    }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
