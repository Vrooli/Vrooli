{
  "$schema": "../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Scenario-owned durable data observed in the canonical data directory.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    },
    "rationale": "Storage surfaces are declared from observed canonical scenario directories; external resource databases are not claimed by this scenario."
  },
  "service": {
    "parent": "vrooli",
    "name": "system-monitor",
    "displayName": "System Monitor",
    "description": "Real-time system monitoring with AI-driven anomaly investigations and reporting.",
    "version": "1.0.0",
    "type": "business-application",
    "category": "monitoring",
    "tags": [
      "monitoring",
      "observability",
      "anomaly-detection",
      "investigations",
      "reports",
      "react-ui",
      "go-api",
      "sqlite",
      "ollama"
    ],
    "capabilities": [
      "system-monitor-cpu",
      "system-monitor-memory",
      "system-monitor-disk",
      "system-monitor-network",
      "system-monitor-process",
      "system-monitor-gpu"
    ],
    "platform_capabilities": {
      "system-monitor-cpu": {
        "linux": {
          "status": "supported",
          "mechanism": "procfs"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "host_statistics"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "windows_performance_counters"
        }
      },
      "system-monitor-memory": {
        "linux": {
          "status": "supported",
          "mechanism": "procfs"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "host_statistics64"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "global_memory_status_ex"
        }
      },
      "system-monitor-disk": {
        "linux": {
          "status": "supported",
          "mechanism": "statfs_procfs"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "getmntinfo"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "get_disk_free_space_ex"
        }
      },
      "system-monitor-network": {
        "linux": {
          "status": "supported",
          "mechanism": "procfs_sysfs"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "if_data"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "get_if_table_2"
        }
      },
      "system-monitor-process": {
        "linux": {
          "status": "supported",
          "mechanism": "procfs"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "sysctl_proc_list"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "windows_toolhelp"
        }
      },
      "system-monitor-gpu": {
        "linux": {
          "status": "supported",
          "mechanism": "hostinventory"
        },
        "macos": {
          "status": "unsupported",
          "mechanism": "ioreg"
        },
        "windows": {
          "status": "unsupported",
          "mechanism": "dxdiag"
        }
      }
    },
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/system-monitor"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "System Monitor API port",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "port": 21232,
      "description": "Web UI dashboard port"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI"
    },
    "develop": {
      "description": "Launch API and UI server"
    }
  },
  "dependencies": {
    "resources": {
      "ollama": {
        "type": "ollama",
        "enabled": true,
        "required": true,
        "description": "AI analysis for anomaly investigations"
      }
    },
    "scenarios": {
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": true,
        "description": "Agent orchestration layer for investigations and anomaly checks",
        "config": {
          "declarations": {
            "reconcile": true,
            "profileMode": "update_if_unmodified",
            "sources": [
              ".vrooli/agent-manager/default.json"
            ]
          }
        }
      },
      "vrooli-autoheal": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Optional autoheal proxy for the forensics page; degrades gracefully when offline"
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "system-monitor",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "system-monitor"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        ".vrooli/service.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "components": {
    "api": {
      "role": "api",
      "build": {
        "kind": "go_module",
        "dir": "api"
      },
      "run": {
        "argv": [
          "{{bin.api}}"
        ],
        "port": "api",
        "cwd": "api"
      }
    },
    "ui": {
      "role": "ui",
      "build": {
        "kind": "pnpm_vite",
        "dir": "ui"
      },
      "run": {
        "argv": [
          "node",
          "server.js"
        ],
        "cwd": "ui",
        "port": "ui"
      }
    }
  }
}
