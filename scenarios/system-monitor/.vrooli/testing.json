{
  "$schema": "https://vrooli.com/schemas/testing.schema.json",
  "_metadata": {
    "description": "Testing configuration for system-monitor",
    "last_updated": "2025-11-08T00:00:00Z"
  },
  "business": {
    "checks": {
      "cli_commands": {
        "enabled": true
      },
      "endpoints": {
        "enabled": true
      },
      "websockets": {
        "enabled": false
      }
    }
  },
  "lint": {
    "handlers": {
      "go_module": {
        "enabled": true,
        "strict": true
      },
      "node_package": {
        "enabled": true,
        "strict": true
      }
    }
  },
  "performance": {
    "checks": {
      "bundle_size": {
        "enabled": true
      },
      "lighthouse": {
        "enabled": true
      }
    }
  },
  "structure": {
    "additional_dirs": [
      "ui"
    ]
  },
  "unit": {
    "languages": {
      "go": {},
      "node": {}
    }
  },
  "version": "1.0.0"
}
