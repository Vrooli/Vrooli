{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "providers": [
    {
      "bucket": "BUCKET_KNOW",
      "class": "local_live",
      "description": "Durable shared coding-agent memory: prior implementation decisions, validated work outcomes, operational facts, and compacted context from every supported agent harness. Route here when a question asks what an agent previously learned, decided, fixed, or recorded across harnesses.",
      "endpoint": {
        "http_json": {
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {
            "Content-Type": "application/json"
          },
          "method": "HTTP_METHOD_POST",
          "path": "/vrooli.vrooli_memory.v1.recall.RecallService/Recall",
          "scenario_id": "vrooli-memory"
        }
      },
      "performance": {
        "degraded_rate_max": 0.1,
        "minimum_samples": 2,
        "p95_ms": 1500,
        "telemetry_required": true
      },
      "provider_group": "vrooli-memory",
      "provider_id": "vrooli-memory.memories",
      "result_mapping": {
        "id_field": "entryId",
        "results_path": "hits",
        "score_field": "score",
        "score_scale": "SCORE_SCALE_COSINE_0_1",
        "snippet_field": "text",
        "title_field": "facetId"
      },
      "scope": "SCOPE_PROJECT",
      "scoring": {
        "deep_k": 50,
        "mrr_at": 3,
        "recall_at": 5,
        "recall_target": 0.8
      },
      "status_endpoint": {
        "http_json": {
          "headers": {
            "Content-Type": "application/json"
          },
          "method": "HTTP_METHOD_GET",
          "path": "/health",
          "scenario_id": "vrooli-memory"
        }
      },
      "tests": {
        "cases": [
          {
            "expect_ids": [
              "b64be0e6-c42e-47b8-92f4-89834d9dde94"
            ],
            "expect_within_top_k": 5,
            "id": "memory-work-record",
            "query": "what did a previous coding agent validate or implement",
            "scope": "global",
            "status": "reviewed",
            "tags": [
              "reviewed",
              "work-record"
            ]
          },
          {
            "expect_max_score": 0.6,
            "expect_no_strong_hit": true,
            "id": "memory-junk-negative",
            "note": "The dense local-live scorer returns weak background similarity on a non-empty corpus; 0.60 is the measured no-strong-hit ceiling.",
            "query": "zxqv unrelated synthetic nonsense",
            "scope": "global",
            "status": "reviewed",
            "tags": [
              "junk",
              "gibberish"
            ]
          }
        ],
        "description": "Small reviewed corpus proving memory-shaped routing and rejection of unrelated junk.",
        "name": "Vrooli Memory — reviewed federated recall corpus",
        "suite_id": "vrooli-memory.memories.primary"
      },
      "tuning": {
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": true,
        "engine": "dense",
        "floor": {
          "hard_floor": 0,
          "max_gap": 0
        },
        "rerank_blend": false,
        "rerank_enabled": false,
        "rerank_shortlist": 50
      },
      "type": "record"
    },
