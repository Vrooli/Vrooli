{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "vrooli-memory.memories",
      "provider_group": "vrooli-memory",
      "bucket": "BUCKET_KNOW",
      "type": "record",
      "description": "Durable shared coding-agent memory: prior implementation decisions, validated work outcomes, operational facts, and compacted context from every supported agent harness. Route here when a question asks what an agent previously learned, decided, fixed, or recorded across harnesses.",
      "scope": "SCOPE_PROJECT",
      "class": "local_live",
      "performance": {"p95_ms": 1500, "degraded_rate_max": 0.10, "telemetry_required": true, "minimum_samples": 2},
      "endpoint": {
        "http_json": {
          "scenario_id": "vrooli-memory",
          "path": "/vrooli.vrooli_memory.v1.recall.RecallService/Recall",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}}}",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "vrooli-memory",
          "path": "/health",
          "method": "HTTP_METHOD_GET",
          "headers": {"Content-Type": "application/json"}
        }
      },
      "result_mapping": {
        "results_path": "hits",
        "id_field": "entryId",
        "title_field": "facetId",
        "score_field": "score",
        "snippet_field": "text",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": true,
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 50,
        "floor": {"max_gap": 0, "hard_floor": 0}
      },
      "scoring": {"recall_at": 5, "recall_target": 0.8, "mrr_at": 3, "deep_k": 50},
      "tests": {
        "suite_id": "vrooli-memory.memories.primary",
        "name": "Vrooli Memory — reviewed federated recall corpus",
        "description": "Small reviewed corpus proving memory-shaped routing and rejection of unrelated junk.",
        "cases": [
          {"id": "memory-work-record", "query": "what did a previous coding agent validate or implement", "scope": "global", "status": "reviewed", "tags": ["reviewed", "work-record"], "expect_ids": ["b64be0e6-c42e-47b8-92f4-89834d9dde94"], "expect_within_top_k": 5},
          {"id": "memory-junk-negative", "query": "zxqv unrelated synthetic nonsense", "scope": "global", "status": "reviewed", "tags": ["junk", "gibberish"], "expect_no_strong_hit": true, "expect_max_score": 0.60, "note": "The dense local-live scorer returns weak background similarity on a non-empty corpus; 0.60 is the measured no-strong-hit ceiling."}
        ]
      }
    }
  ]
}
