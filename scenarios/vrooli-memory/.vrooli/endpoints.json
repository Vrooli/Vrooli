    },
    {
      "id": "facets_set_pin",
      "path": "/vrooli.vrooli_memory.v1.facets.FacetsService/SetPin",
      "method": "POST",
      "summary": "Set operator pin state",
      "description": "",
      "category": "facets"
    },
    {
      "id": "facets_list_pin_proposals",
      "path": "/vrooli.vrooli_memory.v1.facets.FacetsService/ListPinProposals",
      "method": "POST",
      "summary": "List pin proposals",
      "description": "",
      "category": "facets"
    },
    {
      "id": "facets_resolve_pin_proposal",
      "path": "/vrooli.vrooli_memory.v1.facets.FacetsService/ResolvePinProposal",
      "method": "POST",
      "summary": "Resolve pin proposal",
      "description": "",
      "category": "facets"
    },
    {
      "id": "facets_mark_superseded",
      "path": "/vrooli.vrooli_memory.v1.facets.FacetsService/MarkSuperseded",
      "method": "POST",
      "summary": "Append supersession mark",
      "description": "",
      "category": "facets"
    },
    {
      "id": "recall_query",
      "path": "/vrooli.vrooli_memory.v1.recall.RecallService/Recall",
      "method": "POST",
      "summary": "Recall semantic memory",
      "description": "",
      "category": "recall"
    },
    {
      "id": "recall_wake",
      "path": "/vrooli.vrooli_memory.v1.recall.RecallService/Wake",
      "method": "POST",
      "summary": "Render bounded wake context",
      "description": "",
      "category": "recall"
    },
    {
      "id": "recall_zoom",
      "path": "/vrooli.vrooli_memory.v1.recall.RecallService/Zoom",
      "method": "POST",
      "summary": "Zoom into a memory node",
      "description": "",
      "category": "recall"
    },
    {
      "id": "recall_siblings",
      "path": "/vrooli.vrooli_memory.v1.recall.RecallService/ListSiblingEvents",
      "method": "POST",
      "summary": "List sibling events",
      "description": "",
      "category": "recall"
    },
    {
      "id": "harness_import",
      "path": "/vrooli.vrooli_memory.v1.harness.HarnessService/RunImport",
      "method": "POST",
      "summary": "Start harness memory import",
      "description": "",
      "category": "harness"
    },
    {
      "id": "harness_import_status",
      "path": "/vrooli.vrooli_memory.v1.harness.HarnessService/GetImportStatus",
      "method": "POST",
      "summary": "Read durable import status",
      "description": "",
      "category": "harness"
    },
    {
      "id": "harness_project",
      "path": "/vrooli.vrooli_memory.v1.harness.HarnessService/RefreshProjection",
      "method": "POST",
      "summary": "Refresh memory projection",
      "description": "",
      "category": "harness"
    },
    {
      "id": "harness_prompt",
      "path": "/vrooli.vrooli_memory.v1.harness.HarnessService/InstallPromptBlock",
      "method": "POST",
      "summary": "Install memory prompt block",
      "description": "",
      "category": "harness"
    },
    {
      "id": "harness_capture",
      "path": "/vrooli.vrooli_memory.v1.harness.HarnessService/CaptureWrite",
      "method": "POST",
      "summary": "Capture native memory write",
      "description": "",
      "category": "harness"
    },
    {
      "id": "notes_list",
      "path": "/vrooli.vrooli_memory.v1.notes.NotesService/ListNotes",
      "method": "POST",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at through the generated Connect-RPC Notes service.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_memory.v1.notes.NotesService/ListNotes -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "notes_create",
      "path": "/vrooli.vrooli_memory.v1.notes.NotesService/CreateNote",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required and validated by notes.Service; body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "body": "string",
          "title": "string (required, non-whitespace)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or whitespace-only title"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_memory.v1.notes.NotesService/CreateNote -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ]
    },
    {
      "id": "notes_get",
      "path": "/vrooli.vrooli_memory.v1.notes.NotesService/GetNote",
      "method": "POST",
      "summary": "Get a note by id",
      "description": "Returns the note matching the request id through the generated Connect-RPC Notes service.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_memory.v1.notes.NotesService/GetNote -H 'Content-Type: application/json' -d '{\"id\":\"abc123\"}'"
        }
      ]
    },
    {
      "id": "notes_count",
      "path": "/vrooli.vrooli_memory.v1.notes.NotesService/CountNotes",
      "method": "POST",
      "summary": "Count notes in a time window",
      "description": "Counts notes created within the requested canonical time window. Bound to the `notes count` measure (read-only, run-eligible) so search-hub can answer analytical questions like \"how many notes were created this week\".",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "window": "TimeWindow (vrooli.measures.v1; e.g. {\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"})"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "count": "int64 (notes created in the window)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Unresolvable or malformed time window"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Count this week",
          "curl": "curl http://localhost:${API_PORT}/vrooli.vrooli_memory.v1.notes.NotesService/CountNotes -H 'Content-Type: application/json' -d '{\"window\":{\"token\":\"TIME_WINDOW_TOKEN_THIS_WEEK\"}}'"
        }
      ]
    },
    {
      "id": "notes_attach",
      "path": "/api/v1/notes/{id}/attachments",
      "method": "POST",
      "summary": "Upload a note attachment",
      "description": "Uploads opaque file bytes through the documented REST multipart exception and returns proto-typed attachment metadata.",
      "category": "notes",
      "request": {
        "type": "multipart/form-data",
        "properties": {
          "file": "file (required)"
        }
      },
      "response": {
        "type": "UploadAttachmentResponse",
        "properties": {
          "attachment": "Attachment"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing file or invalid multipart upload"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "BlobStore or metadata persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Attach file",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes/abc123/attachments -F file=@./example.png"
        }
      ],
      "rest_exception": {
        "reason": "multipart_upload",
        "note": "Multipart/form-data request transport cannot be expressed in proto. The response payload is still the proto-typed UploadAttachmentResponse message.",
        "proto_payloads": {
          "request": {
            "transport": "multipart/form-data",
            "conformance": "transport_only"
          },
          "response": {
            "proto_full_name": "vrooli.vrooli_memory.v1.notes.UploadAttachmentResponse",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.vrooli_memory.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "journal_append",
      "path": "/vrooli.vrooli_memory.v1.journal.JournalService/AppendEntry",
      "method": "POST",
      "summary": "Append an immutable memory entry",
      "description": "",
      "category": "journal",
      "request": {
        "type": "AppendEntryRequest"
      },
      "response": {
        "type": "AppendEntryResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing body"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Persistence failure"
        }
      ]
    },
    {
      "id": "journal_get",
      "path": "/vrooli.vrooli_memory.v1.journal.JournalService/GetEntry",
      "method": "POST",
      "summary": "Get an immutable memory entry",
      "description": "",
      "category": "journal",
      "request": {
        "type": "GetEntryRequest"
      },
      "response": {
        "type": "GetEntryResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Entry does not exist"
        }
      ]
    },
    {
      "id": "journal_list",
      "path": "/vrooli.vrooli_memory.v1.journal.JournalService/ListEntries",
      "method": "POST",
      "summary": "List immutable memory entries",
      "description": "",
      "category": "journal",
      "request": {
        "type": "ListEntriesRequest"
      },
      "response": {
        "type": "ListEntriesResponse"
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid limit"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Persistence failure"
        }
      ]
    }
  ]
}
