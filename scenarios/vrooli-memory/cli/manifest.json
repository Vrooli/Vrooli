          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "MarkSuperseded"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "resolve-thread",
          "description": "Resolve a thread so it leaves ambient frontier",
          "positionals": [
            {
              "name": "entry-id",
              "required": true,
              "description": "Thread entry id"
            }
          ],
          "flags": [
            {
              "name": "scope",
              "description": "Ledger scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FacetsService",
            "method": "ResolveThread"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "rules",
      "description": "Manage declarative facet classification rules",
      "commands": [
        {
          "name": "list",
          "description": "List classification rules",
          "flags": [
            {
              "name": "scope",
              "description": "Policy scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClassificationRulesService",
            "method": "ListRules"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "create",
          "description": "Create a disabled classification rule",
          "flags": [
            {
              "name": "id",
              "description": "Rule id"
            },
            {
              "name": "scope",
              "description": "Policy scope",
