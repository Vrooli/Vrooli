          "positionals": [
            {
              "name": "rule-id",
              "required": true,
              "description": "Rule id"
            }
          ],
          "flags": [
            {
              "name": "scope",
              "description": "Policy scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClassificationRulesService",
            "method": "EnableRule"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "revert",
          "description": "Append prior assignments for entries decided by a rule",
          "positionals": [
            {
              "name": "rule-id",
              "required": true,
              "description": "Rule id"
            }
          ],
          "flags": [
            {
              "name": "scope",
              "description": "Policy scope",
              "default": "agent-memory"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ClassificationRulesService",
            "method": "RevertRule"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "refacet",
          "description": "Re-facet the immutable corpus using current rules and classifier",
