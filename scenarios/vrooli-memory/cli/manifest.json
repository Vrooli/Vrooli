{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "vrooli-memory",
  "description": "Template scenario CLI surface. Single source of truth for the `notes` domain: schema-validated against cli-manifest/v1 and cross-validated against the NotesService proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "journal",
      "description": "Write durable shared memories",
      "commands": [
        {
          "name": "note",
          "description": "Append an immutable memory entry",
          "positionals": [
            {
              "name": "body",
              "required": true,
              "description": "Memory prose"
            }
          ],
          "flags": [
            {
              "name": "kind",
              "description": "Entry kind"
            },
            {
              "name": "trigger",
              "description": "Work-record trigger"
            },
            {
              "name": "approach",
              "description": "Work-record approach"
            },
            {
              "name": "evidence",
              "description": "Work-record evidence"
            },
            {
              "name": "outcome",
              "description": "Work-record outcome"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "AppendEntry"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "retry-classifications",
          "description": "Replay queued classification failures through append-only facet assignments",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum queue items (up to 500)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "ProcessClassificationRetries"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "retry-embeddings",
          "description": "Replay queued embedding failures",
          "flags": [
            {
              "name": "limit",
              "description": "Maximum queue items (up to 500)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "JournalService",
            "method": "ProcessEmbeddingRetries"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "harness",
      "description": "Import and inspect coding-agent memory",
      "commands": [
        {
          "name": "import",
          "description": "Start an observable, replay-safe harness import",
          "flags": [
            {
              "name": "runtime",
              "description": "Harness runtime",
              "default": "claude-code"
            },
            {
              "name": "dry-run",
              "description": "Read and validate sources without writing journal entries"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HarnessService",
            "method": "RunImport"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "import-status",
          "description": "Show persisted import progress or final result",
          "flags": [
            {
              "name": "run-id",
              "description": "Specific import run ID"
            },
            {
              "name": "runtime",
              "description": "Harness runtime",
              "default": "claude-code"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HarnessService",
            "method": "GetImportStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "project",
          "description": "Render or refresh a one-directional harness memory projection",
          "flags": [
            {
              "name": "harness",
              "description": "Harness runtime",
              "default": "claude-code"
            },
            {
              "name": "dry-run",
              "description": "Render without writing the harness file"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HarnessService",
            "method": "RefreshProjection"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "capture",
          "description": "Capture a native harness memory write",
          "flags": [
            {
              "name": "runtime",
              "description": "Harness runtime",
              "default": "claude-code"
            },
            {
              "name": "source-path",
              "description": "Native source path"
            },
            {
              "name": "content",
              "description": "Native memory content"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HarnessService",
            "method": "CaptureWrite"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "install-prompt",
          "description": "Install native-memory guidance in a harness convention file",
          "flags": [
            {
              "name": "runtime",
              "description": "Harness runtime",
              "default": "claude-code"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "HarnessService",
            "method": "InstallPromptBlock"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "forest",
      "description": "Operate the derived compaction forest",
      "commands": [
        {
          "name": "compact",
          "description": "Compact eligible memory frontier",
          "binding": {
            "kind": "connect-rpc",
            "service": "ForestService",
            "method": "RunCompactionPass"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        },
        {
          "name": "rebuild-forest",
          "description": "Rebuild derived memory forest",
          "binding": {
            "kind": "connect-rpc",
            "service": "ForestService",
            "method": "RebuildForest"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_mutation"
          }
        }
      ]
    },
    {
      "name": "recall",
      "description": "Retrieve shared memories",
      "commands": [
        {
          "name": "recall",
          "description": "Semantically recall memories",
          "positionals": [
            {
              "name": "query",
              "required": true,
              "description": "Semantic query"
            }
          ],
          "flags": [
            {
              "name": "limit",
              "description": "Maximum hits"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecallService",
            "method": "Recall"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "wake",
          "description": "Render bounded ambient memory",
          "flags": [
            {
              "name": "budget",
              "description": "Line budget"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecallService",
            "method": "Wake"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        },
        {
          "name": "siblings",
          "description": "List memories from the same agent run",
          "positionals": [
            {
              "name": "entry-id",
              "required": true,
              "description": "Memory entry id"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "RecallService",
            "method": "ListSiblingEvents"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          },
          "architecture": {
            "primitive": "proto_list"
          }
        }
      ]
    }
  ],
  "measures": {
    "domains": []
  },
  "exceptions": [
    {
      "command": "note",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound journal note command; preserves the agent-facing write contract without requiring group topology."
    },
    {
      "command": "retry-classifications",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound journal retry command so durable enrichment recovery is directly operable."
    },
    {
      "command": "retry-embeddings",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound journal retry command so durable enrichment recovery is directly operable."
    },
    {
      "command": "import",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound harness import command; import is a primary migration workflow."
    },
    {
      "command": "import-status",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound harness status command; exposes durable import progress without group topology."
    },
    {
      "command": "project",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound projection command."
    },
    {
      "command": "capture",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound native-memory capture command."
    },
    {
      "command": "install-prompt",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound prompt installation command."
    },
    {
      "command": "compact",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound forest compaction command."
    },
    {
      "command": "rebuild-forest",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound forest rebuild command."
    },
    {
      "command": "recall",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound recall command; semantic recall is the primary agent read workflow."
    },
    {
      "command": "wake",
      "class": "passthrough",
      "reason": "Root alias for the manifest-bound recall wake command; ambient projection is intentionally topology-free."
    },
    {
      "command": "siblings",
      "class": "passthrough",
      "reason": "Root alias for same-run memory event inspection."
    }
  ],
  "omitted": [
    {
      "service": "JournalService",
      "method": "GetEntry",
      "reason": "Entry inspection is an API capability until the recall and zoom CLI surface is introduced."
    },
    {
      "service": "JournalService",
      "method": "ListEntries",
      "reason": "Timeline browsing is introduced with the agent and operator surfaces, not as a raw journal command."
    },
    {
      "service": "FacetsService",
      "method": "ListFacets",
      "reason": "The operator facet command group is introduced with the agent surface phase."
    },
    {
      "service": "FacetsService",
      "method": "AssignFacet",
      "reason": "Operator re-faceting is exposed after the write and recall command surface exists."
    },
    {
      "service": "FacetsService",
      "method": "SetPin",
      "reason": "Pin curation is intentionally deferred to the operator surface phase."
    },
    {
      "service": "FacetsService",
      "method": "ListPinProposals",
      "reason": "Pin proposal review belongs to the later operator surface."
    },
    {
      "service": "FacetsService",
      "method": "ResolvePinProposal",
      "reason": "Pin proposal review belongs to the later operator surface."
    },
    {
      "service": "FacetsService",
      "method": "MarkSuperseded",
      "reason": "Supersession is an API capability until the operator correction surface is delivered."
    },
    {
      "service": "ForestService",
      "method": "RunCompactionPass",
      "reason": "Compaction has no safe operator surface until the forest domain is implemented."
    },
    {
      "service": "ForestService",
      "method": "GetFrontier",
      "reason": "Frontier inspection is deferred to the operator tree surface."
    },
    {
      "service": "ForestService",
      "method": "GetNode",
      "reason": "Node inspection is deferred to the operator tree surface."
    },
    {
      "service": "SearchControlService",
      "method": "Reindex",
      "reason": "Federation is not yet implemented and reindex remains API-only."
    },
    {
      "service": "SearchControlService",
      "method": "WriteConfig",
      "reason": "Search configuration is not exposed to agents until federation governance is implemented."
    },
    {
      "service": "RecallService",
      "method": "Zoom",
      "reason": "Tree exploration is introduced with the operator surface phase."
    },
    {
      "service": "HarnessService",
      "method": "RefreshProjection",
      "reason": "Projection is implemented after import to preserve the corpus source."
    },
    {
      "service": "HarnessService",
      "method": "InstallPromptBlock",
      "reason": "Prompt-block installation is implemented with native capture integration."
    },
    {
      "service": "HarnessService",
      "method": "CaptureWrite",
      "reason": "Native write capture is implemented after projection and hooks are ready."
    }
  ]
}
