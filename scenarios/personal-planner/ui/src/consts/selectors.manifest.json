  "dynamicSelectors": {
    "layout.navLink": {
      "description": "Primary navigation link by canonical nav key; the phone tab derives `-tab` from the same id",
      "selectorPattern": "[data-testid=\"layout-nav-${key}\"]",
      "testIdPattern": "layout-nav-${key}",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "plan",
            "goals",
            "focus",
            "review",
            "settings"
          ]
        }
      ]
    },
    "layout.navTab": {
      "description": "Phone tab-bar item by canonical nav key",
      "selectorPattern": "[data-testid=\"layout-nav-${key}-tab\"]",
      "testIdPattern": "layout-nav-${key}-tab",
      "params": [
        {
          "name": "key",
          "type": "enum",
          "values": [
            "dashboard",
            "plan",
            "goals",
            "focus",
            "review",
            "settings"
          ]
        }
      ]
    },
    "settingsPage.themeOption": {
      "description": "Appearance choice by canonical theme value",
      "selectorPattern": "[data-testid=\"page-settings-theme-option-${choice}\"]",
      "testIdPattern": "page-settings-theme-option-${choice}",
      "params": [
        {
          "name": "choice",
          "type": "enum",
          "values": [
            "auto",
            "day",
            "night"
          ]
        }
      ]
    }
  },
