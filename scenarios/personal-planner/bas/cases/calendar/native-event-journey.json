    },
    {
      "id": "e22",
      "source": "assert-reopened-revision",
      "target": "close-reopened-event"
    },
    {
      "id": "e23",
      "source": "close-reopened-event",
      "target": "navigate-to-november"
    },
    {
      "id": "e24",
      "source": "navigate-to-november",
      "target": "open-november-first-date"
    },
    {
      "id": "e25",
      "source": "open-november-first-date",
      "target": "switch-to-timed-event"
    },
    {
      "id": "e26",
      "source": "switch-to-timed-event",
      "target": "fill-timed-title"
    },
    {
      "id": "e27",
      "source": "fill-timed-title",
      "target": "fill-dst-start"
    },
    {
      "id": "e28",
      "source": "fill-dst-start",
      "target": "fill-dst-end"
    },
    {
      "id": "e29",
      "source": "fill-dst-end",
      "target": "create-timed-event"
    },
    {
      "id": "e30",
      "source": "create-timed-event",
      "target": "assert-timed-saved"
    },
    {
      "id": "e31",
      "source": "assert-timed-saved",
      "target": "reopen-timed-event"
    },
    {
      "id": "e32",
      "source": "reopen-timed-event",
      "target": "assert-timed-fields-reopened"
    },
    {
      "id": "e33",
      "source": "assert-timed-fields-reopened",
      "target": "edit-timed-title"
    },
    {
      "id": "e34",
      "source": "edit-timed-title",
