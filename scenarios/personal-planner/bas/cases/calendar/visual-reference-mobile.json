{
  "metadata": {
    "name": "visual-reference-mobile",
    "description": "Given the routed Planner test store is isolated and may be empty, when Plan Month opens at narrow width in Day and Night, then each explicit appearance resolves and the calendar surface is captured.",
    "requirement": "PLAN-P0-002",
    "version": "1",
    "labels": {
      "reset": "none",
      "routed_isolation": "true",
      "safety": "fixture-only",
      "requires_confirmation": "true"
    },
    "execution_mode": "mutating"
  },
  "settings": {
    "viewport_width": 390,
    "viewport_height": 844
  },
  "nodes": [
    { "id": "navigate-day", "action": { "type": "ACTION_TYPE_NAVIGATE", "navigate": { "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO", "scenario": "personal-planner", "scenario_path": "/plan?appearance=day", "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE", "timeout_ms": 30000 }, "metadata": { "label": "Open narrow Plan in explicit Day appearance" } } },
    { "id": "open-more-day", "action": { "type": "ACTION_TYPE_CLICK", "click": { "selector": "@selector/calendarMonth.mobileMore" }, "metadata": { "label": "Open compact view menu in Day appearance" } } },
    { "id": "select-month-day", "action": { "type": "ACTION_TYPE_CLICK", "click": { "selector": "@selector/calendarMonth.monthView" }, "metadata": { "label": "Open narrow Month in Day appearance" } } },
    { "id": "assert-grid-day", "action": { "type": "ACTION_TYPE_ASSERT", "assert": { "selector": "@selector/calendarMonth.grid", "mode": "ASSERTION_MODE_EXISTS", "timeout_ms": 15000, "failure_message": "Narrow Day Plan Month grid should render" }, "metadata": { "label": "Verify narrow Day calendar grid" } } },
    { "id": "record-day-browser-context", "action": { "type": "ACTION_TYPE_EVALUATE", "evaluate": { "expression": "(() => JSON.stringify({appearance:'day', devicePixelRatio:window.devicePixelRatio, viewport:{width:window.innerWidth,height:window.innerHeight}}))()" }, "metadata": { "label": "Record actual narrow Day browser DPR and viewport" } } },
    { "id": "capture-day", "action": { "type": "ACTION_TYPE_SCREENSHOT", "screenshot": { "full_page": true }, "metadata": { "label": "Capture narrow Plan Month Day routed test state" } } },
    { "id": "navigate-night", "action": { "type": "ACTION_TYPE_NAVIGATE", "navigate": { "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO", "scenario": "personal-planner", "scenario_path": "/plan?appearance=night", "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE", "timeout_ms": 30000 }, "metadata": { "label": "Open narrow Plan in explicit Night appearance" } } },
    { "id": "open-more-night", "action": { "type": "ACTION_TYPE_CLICK", "click": { "selector": "@selector/calendarMonth.mobileMore" }, "metadata": { "label": "Open compact view menu in Night appearance" } } },
    { "id": "select-month-night", "action": { "type": "ACTION_TYPE_CLICK", "click": { "selector": "@selector/calendarMonth.monthView" }, "metadata": { "label": "Open narrow Month in Night appearance" } } },
    { "id": "assert-grid-night", "action": { "type": "ACTION_TYPE_ASSERT", "assert": { "selector": "@selector/calendarMonth.grid", "mode": "ASSERTION_MODE_EXISTS", "timeout_ms": 15000, "failure_message": "Narrow Night Plan Month grid should render" }, "metadata": { "label": "Verify narrow Night calendar grid" } } },
    { "id": "record-night-browser-context", "action": { "type": "ACTION_TYPE_EVALUATE", "evaluate": { "expression": "(() => JSON.stringify({appearance:'night', devicePixelRatio:window.devicePixelRatio, viewport:{width:window.innerWidth,height:window.innerHeight}}))()" }, "metadata": { "label": "Record actual narrow Night browser DPR and viewport" } } },
    { "id": "capture-night", "action": { "type": "ACTION_TYPE_SCREENSHOT", "screenshot": { "full_page": true }, "metadata": { "label": "Capture narrow Plan Month Night routed test state" } } }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-day", "target": "open-more-day", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e2", "source": "open-more-day", "target": "select-month-day", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e3", "source": "select-month-day", "target": "assert-grid-day", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4", "source": "assert-grid-day", "target": "record-day-browser-context", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4b", "source": "record-day-browser-context", "target": "capture-day", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e5", "source": "capture-day", "target": "navigate-night", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e6", "source": "navigate-night", "target": "open-more-night", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e7", "source": "open-more-night", "target": "select-month-night", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e8", "source": "select-month-night", "target": "assert-grid-night", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e9", "source": "assert-grid-night", "target": "record-night-browser-context", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e9b", "source": "record-night-browser-context", "target": "capture-night", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
