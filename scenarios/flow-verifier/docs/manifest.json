{
  "version": "2.0.0",
  "title": "Flow Verifier Documentation",
  "description": "Documentation contract for the scenario generated from the react-vite template",
  "defaultDocument": "START-HERE.md",
  "contract": {
    "kind": "scenario-docs",
    "template": "react-vite",
    "schema": "scenario-docs-manifest/v2",
    "maturityValues": ["missing", "stub", "draft", "active", "not-applicable", "deferred", "retired"],
    "stages": ["generated", "oriented", "implemented", "validated", "deployable", "monetizable"],
    "extensionRule": "Every durable scenario document should be registered here. Use docs/concepts/ for product and system concepts, docs/guides/ for task procedures, docs/reference/ for stable lookup material, docs/internal/ for developer and agent memory, docs/operations/ for runtime operations, docs/business/ for commercial strategy, and docs/domains/<domain>/ for domain-specific depth that would overload DOMAINS.md."
  },
  "sections": [
    {
      "id": "getting-started",
      "title": "Getting Started",
      "icon": "rocket",
      "description": "First-touch experience, scenario identity, and local startup flow",
      "purpose": "Help users, operators, developers, and agents understand what the scenario is, where to begin, and how to run it.",
      "extensionPolicy": "Add only entrypoint-level documents here. Task-specific procedures belong in guides; durable architecture or product concepts belong in concepts.",
      "documents": [
        {
          "path": "../README.md",
          "docType": "readme",
          "title": "README",
          "aliases": ["overview", "summary"],
          "description": "Top-level scenario summary and primary human entrypoint",
          "audience": ["users", "operators", "developers", "agents"],
          "canonicalFor": ["scenario-summary", "entrypoint"],
          "maturity": "active",
          "requiredBy": ["generated"],
          "completion": "required",
          "validation": {
            "requiredHeadings": ["What You Get", "Documentation Map", "Customize Safely"],
            "forbiddenPlaceholders": ["[TODO]", "[Summarize]"]
