      ]
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "range": "20000-24999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "critical": true,
          "timeout": 10000,
          "interval": 30000
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000
        }
      ],
      "startup_grace_period": 15000
    },
    "setup": {
      "description": "Build API and UI assets declared by the manifest-driven lifecycle contract",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": [
              "api/flow-verifier-api"
            ]
          },
          {
            "type": "cli",
            "command": "flow-verifier"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o flow-verifier-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm install --ignore-workspace || pnpm install --ignore-workspace); else echo 'ui/ not present yet'; fi",
          "description": "Install UI dependencies",
          "condition": {
            "file_exists": "ui/package.json"
          }
        },
        {
          "name": "build-ui",
          "run": "if [ -f ui/package.json ]; then cd ui && (corepack pnpm --ignore-workspace run build || pnpm --ignore-workspace run build); else echo 'ui/ not present yet'; fi",
          "description": "Build production UI bundle"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./flow-verifier-api",
          "description": "Start Go API server in background",
          "background": true,
          "condition": {
            "file_exists": "api/flow-verifier-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "description": "Serve production UI bundle",
          "background": true,
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        }
      ]
    },
    "build": {},
    "deploy": {},
    "clean": {},
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "check-temporal-models",
          "run": "cd cli && go run . verify check --root ..",
          "description": "Verify formal flow artifacts via the flow-verifier scenario CLI"
        },
        {
          "name": "run-tests",
          "run": "test-genie execute flow-verifier --preset comprehensive",
          "description": "Run all test phases via test-genie"
        }
      ]
    },
    "backup": {},
    "restore": {},
    "production": {},
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "stop-api",
          "run": "pkill -f 'flow-verifier-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {},
