{
  "$schema": "../../../.vrooli/schemas/search.schema.json",
  "version": "1.0.0",
  "providers": [
    {
      "provider_id": "ui-health.surfaces",
      "provider_group": "ui-health",
      "bucket": "BUCKET_REUSE",
      "type": "surface",
      "description": "UI surfaces across every scenario — components, pages, features, and hooks — searchable by what each surface is or does (for example \"settings page\", \"date picker component\", \"health dashboard overview\"). Route here to find an existing UI building block to reuse rather than rebuild.",
      "scope": "SCOPE_PROJECT",
      "class": "local_index",
      "endpoint": {
        "http_json": {
          "scenario_id": "ui-health",
          "path": "/vrooli.ui_health.v1.search.SearchService/Search",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"query\":\"{{query}}\",\"limit\":{{limit}},\"mode\":\"MODE_AI\"}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "status_endpoint": {
        "http_json": {
          "scenario_id": "ui-health",
          "path": "/vrooli.ui_health.v1.search.SearchService/Status",
          "method": "HTTP_METHOD_POST",
          "body_template": "{}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "reindex_endpoint": {
        "http_json": {
          "scenario_id": "ui-health",
          "path": "/vrooli.ui_health.v1.reindex.ReindexService/Reindex",
          "method": "HTTP_METHOD_POST",
          "body_template": "{\"scenario\":\"\",\"dry_run\":false}",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      },
      "result_mapping": {
        "results_path": "results",
        "id_field": "filePath",
        "title_field": "displayName",
        "score_field": "score",
        "snippet_field": "description",
        "path_field": "filePath",
        "score_scale": "SCORE_SCALE_COSINE_0_1"
      },
      "tuning": {
        "engine": "dense",
        "embed_model": "nomic-embed-text",
        "embed_task_prefix": false,
        "rerank_enabled": false,
        "rerank_blend": false,
        "rerank_shortlist": 50,
        "floor": {
          "max_gap": 0,
          "hard_floor": 0
        }
      },
      "tests": {
        "name": "ui-health surfaces — starter baseline",
        "description": "STARTER rank-centric baseline for the ui-health surfaces corpus: a few intent->surface queries plus a junk-rejection negative. Positives assert the expected deterministic surface ids within the top results (the dense ScoreThreshold of 0.55 already trims noise); the gibberish negative feeds the junk-rejection constraint, never the recall objective.",
        "cases": [
          {
            "id": "settings-surface",
            "query": "where do I change settings",
            "tags": [
              "strong",
              "settings"
            ],
            "expect_ids": [
              "ui/src/pages/SettingsPage.tsx"
            ],
            "expect_within_top_k": 5
          },
          {
            "id": "search-surface",
            "query": "search page",
            "tags": [
              "strong",
              "search"
            ],
            "expect_ids": [
              "ui/src/pages/SearchPage.tsx"
            ],
            "expect_within_top_k": 5
          },
          {
            "id": "dashboard-surface",
            "query": "health dashboard overview",
            "tags": [
              "strong",
              "dashboard"
            ],
            "expect_ids": [
              "ui/src/pages/DashboardPage.tsx"
            ],
            "expect_within_top_k": 5
          },
          {
            "id": "gibberish-1",
            "query": "asdfqwer zxcvbnm qwertyuiop florbnax",
            "tags": [
              "gibberish"
            ],
            "expect_no_strong_hit": true,
            "expect_max_score": 0.6
          }
        ],
        "coverage": {
          "required_tag_groups": [
            {
              "id": "core-surfaces",
              "description": "Core reusable UI surfaces the provider promises to locate.",
              "tags": [
                "settings",
                "search",
                "dashboard"
              ],
              "min_reviewed_positive": 3
            }
          ]
        }
      },
      "config_writable": false,
      "config_pinned_reason": "ui-health surface indexing currently uses fixed provider tuning; Search Hub may reindex but cannot write sweep winners back."
    }
  ]
}
