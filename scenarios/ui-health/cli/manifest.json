{
  "$schema": "../../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "ui-health",
  "description": "Single source of truth for the ui-health CLI command surface. Schema-validated against cli-manifest/v1; cross-validated against each domain's Connect-RPC proto descriptor at test time. Loaded by cli/main.go via cliapp.LoadFromManifest.",
  "groups": [
    {
      "name": "validate",
      "description": "Run ui-health validators against a scenario's UI manifest, slot directories, and overlay rules",
      "commands": [
        {
          "name": "scenario",
          "description": "Validate a single scenario by id",
          "positionals": [
            {
              "name": "name",
              "required": true,
              "description": "Scenario id (directory name under scenarios/)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "ValidateScenario"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "search",
      "description": "Search UI surfaces across scenarios (AI-first with text fallback)",
      "commands": [
        {
          "name": "query",
          "description": "Search the indexed corpus by natural-language text",
          "positionals": [
            {
              "name": "text",
              "required": true,
              "description": "Natural-language query"
            }
          ],
          "flags": [
            {
              "name": "limit",
              "default": "10",
              "description": "Maximum results to return"
            },
            {
              "name": "mode",
              "description": "Force a retrieval mode: ai | text (default lets the server choose)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SearchService",
            "method": "Search"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "status",
          "description": "Report search backend availability (ollama, qdrant, indexed count)",
          "binding": {
            "kind": "connect-rpc",
            "service": "SearchService",
            "method": "Status"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "reindex",
      "description": "Reconcile the UI-surface corpus: rebuild Qdrant points from per-framework InventoryService scans",
      "commands": [
        {
          "name": "run",
          "description": "Start a reindex job",
          "flags": [
            {
              "name": "scenario",
              "description": "Limit to a single scenario; empty means all"
            },
            {
              "name": "dry-run",
              "bool": true,
              "description": "Compute planned upserts/deletes without writing"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ReindexService",
            "method": "Reindex"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "status",
          "description": "Poll a reindex job's progress",
          "positionals": [
            {
              "name": "job_id",
              "required": true,
              "description": "Job id returned by `reindex run`"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ReindexService",
            "method": "ReindexStatus"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "cancel",
          "description": "Request cooperative cancellation of an in-flight reindex job",
          "positionals": [
            {
              "name": "job_id",
              "required": true,
              "description": "Job id returned by `reindex run`"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ReindexService",
            "method": "ReindexCancel"
          },
          "governance": {
            "effect": "write",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "fix",
      "description": "Preview or apply ui-health's deterministic UI auto-fixes for a scenario's auto-fixable findings",
      "commands": [
        {
          "name": "run",
          "description": "Preview (or, with --apply, apply) deterministic UI fixes for a scenario's auto-fixable findings",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario slug to repair"
            }
          ],
          "flags": [
            {
              "name": "rule",
              "description": "Restrict fixes to one or more finding codes (repeatable / comma-separated)"
            },
            {
              "name": "path",
              "description": "Filesystem path to repair instead of a scenario slug"
            },
            {
              "name": "apply",
              "description": "Apply the fixes (default is a dry-run preview)"
            },
            {
              "name": "json",
              "description": "Emit JSON output"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "PreviewFix"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "filesystem:read",
              "filesystem:write",
              "network:internal"
            ]
          }
        },
        {
          "name": "apply",
          "description": "Apply deterministic UI fixes for a scenario's auto-fixable findings",
          "positionals": [
            {
              "name": "scenario",
              "required": true,
              "description": "Scenario slug to repair"
            }
          ],
          "flags": [
            {
              "name": "rule",
              "description": "Restrict fixes to one or more finding codes (repeatable / comma-separated)"
            },
            {
              "name": "path",
              "description": "Filesystem path to repair instead of a scenario slug"
            },
            {
              "name": "json",
              "description": "Emit JSON output"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ScenarioValidationService",
            "method": "ApplyFix"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "filesystem:read",
              "filesystem:write",
              "network:internal"
            ]
          }
        }
      ]
    }
  ],
  "omitted": [
    {
      "service": "InventoryService",
      "method": "ScanScenario",
      "reason": "Scan is exposed transitively via ReindexService.Reindex (which calls the reconciler that internally runs ScanScenario per scenario). No standalone CLI surface — UI uses the Connect client directly for ad-hoc per-scenario inventory views."
    }
  ]
}
