{
  "metadata": {
    "name": "reindex-trigger",
    "description": "Submits a scoped dry-run reindex and verifies a tracked job row appears in the jobs list.",
    "labels": {
      "reset": "none",
      "navigation_spec": "ui-health.app.ui"
    },
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-reindex",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "ui-health",
          "scenario_path": "/reindex",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Navigate to /reindex" }
      }
    },
    {
      "id": "wait-reindex-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='page-reindex']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": { "label": "Reindex page visible" }
      }
    },
    {
      "id": "type-scenario",
      "action": {
        "type": "ACTION_TYPE_TYPE",
        "type": {
          "selector": "[data-testid='reindex-scenario-input']",
          "text": "ui-health"
        },
        "metadata": { "label": "Scope to ui-health" }
      }
    },
    {
      "id": "toggle-dry-run",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='reindex-dry-run-input']" },
        "metadata": { "label": "Enable dry-run" }
      }
    },
    {
      "id": "submit",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": { "selector": "[data-testid='reindex-submit']" },
        "metadata": { "label": "Trigger reindex" }
      }
    },
    {
      "id": "wait-jobs-list",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid='reindex-jobs-list']",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Jobs list populated" }
      }
    },
    {
      "id": "capture-final",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": { "full_page": true },
        "metadata": { "label": "Capture job row" }
      }
    }
  ]
}
