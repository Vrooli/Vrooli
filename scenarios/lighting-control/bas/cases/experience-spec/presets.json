{
  "metadata": {
    "name": "experience-presets-spec-smoke",
    "description": "Given the saved policy is available, when the operator opens Presets, then the selected preset editor and separate draft/use actions are visible.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "presets",
      "surface": "experience-presets"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-presets",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "lighting-control",
          "scenario_path": "/presets",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Presets" }
      }
    },
    {
      "id": "wait-presets-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.presets",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Preset editor visible" }
      }
    },
    {
      "id": "assert-preset-editor-and-actions",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.presets",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": { "stringValue": "Save draft" },
          "case_sensitive": true,
          "timeout_ms": 10000
        },
        "metadata": { "label": "Draft action remains visible" }
      }
    }
  ]
}
