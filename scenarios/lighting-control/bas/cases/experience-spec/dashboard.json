{
  "metadata": {
    "name": "experience-dashboard-spec-smoke",
    "description": "Given OpenRGB is disabled, when the operator opens Overview, then the saved Off policy and empty controller state are explicit.",
    "requirement": "OT-P0-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "spec_entry_id": "dashboard",
      "surface": "experience-dashboard"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "lighting-control",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Dashboard" }
      }
    },
    {
      "id": "wait-dashboard-page",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/pages.dashboard",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Dashboard page visible" }
      }
    },
    {
      "id": "assert-empty-controller-state",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/pages.dashboard",
          "mode": "ASSERTION_MODE_TEXT_CONTAINS",
          "expected": { "stringValue": "No controllers have been discovered" },
          "case_sensitive": true,
          "timeout_ms": 10000
        },
        "metadata": { "label": "No-device state explained" }
      }
    }
  ]
}
