        "port": "ui"
      }
    }
  },
  "dependencies": {
    "resources": {},
    "scenarios": {
      "agent-manager": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Supplies current active-run counts for the optional work and combined lighting presets.",
        "startup_policy": "try_start",
        "degraded_behavior": "When unavailable or stale, the policy marks agent evidence unavailable and uses its configured static fallback."
      },
      "system-monitor": {
        "type": "scenario",
        "enabled": true,
        "required": false,
        "description": "Supplies measured CPU/GPU usage and memory-pressure evidence for load and health lighting presets.",
        "startup_policy": "try_start",
        "degraded_behavior": "When unavailable, stale, or missing measured metrics, the policy records degraded evidence and uses its configured static fallback."
      },
      "infrastructure-manager": {
        "degraded_behavior": "Expose unavailable or stale host evidence and use the configured static fallback; fresh independent memory pressure can still surface warning or failure.",
        "description": "Reads trusted host/substrate condition evidence for optional Health and Combined presets.",
        "enabled": true,
        "required": false,
        "runtime_only": true,
        "runtime_only_rationale": "Read-only runtime discovery; never start Infrastructure Manager or enable its health team from Light Desk.",
        "startup_policy": "ignore",
        "type": "scenario"
      }
    }
  },
