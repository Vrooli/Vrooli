{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "storage": {
    "entries": {
      "data": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Host-local SQLite persistence for controller enrollment, desired state, policy configuration and reconciliation state, plus lifecycle-owned deployment metadata.",
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "Observed footprint was 28672 bytes on 2026-11-10; 1MiB leaves room for device enrollment and SQLite sidecars while keeping this configuration store bounded."
        }
      },
      "retention": {
        "rung": "owned",
        "kind": "file",
        "class": "state",
        "format": "json",
        "subpath": "retention/enforcement-receipt.json",
        "regenerable": true,
        "rationale": "Storage Manager writes the latest compact retention enforcement receipt in this scenario's state namespace.",
        "budget": {
          "max_bytes": "1MiB",
          "max_age": "30d",
          "rationale": "This compact receipt is replaceable operational state and is refreshed by each retention enforcement run."
        }
      }
    }
  },
  "branding": {
