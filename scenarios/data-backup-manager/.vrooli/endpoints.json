    {
      "id": "targets_register",
      "path": "/vrooli.data_backup_manager.v1.targets.TargetsService/RegisterTarget",
      "method": "POST",
      "summary": "Register (upsert) a backup target",
      "description": "Idempotently registers a backup source keyed by (owner, name). Re-registering with the same spec is a no-op; a changed spec updates in place. Scenarios call this at their lifecycle.",
      "category": "targets",
      "request": {
        "type": "object",
        "properties": {
          "locator": "string (required)",
          "name": "string (required)",
          "owner": "string (required)",
          "source_kind": "SourceKind (required, non-unspecified)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "target": "Target"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing owner/name/locator or unspecified source kind"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Register a filesystem target",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.targets.TargetsService/RegisterTarget -H 'Content-Type: application/json' -d '{\"owner\":\"prompt-manager\",\"name\":\"store\",\"sourceKind\":\"SOURCE_KIND_FILESYSTEM\",\"locator\":\"store/teams\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager targets register",
        "args": [
          "--owner",
          "<owner>",
          "--name",
          "<name>",
          "--kind",
          "<kind>",
          "--locator",
          "<locator>"
        ]
      }
    },
