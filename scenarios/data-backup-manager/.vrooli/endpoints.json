{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "destinations_create",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/CreateDestination",
      "method": "POST",
      "summary": "Create a backup destination",
      "description": "Provisions a new kopia repository (filesystem or S3). Encryption is always on; the repository passphrase is generated and stored in vault. A filesystem destination must not point under the protected root.",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "backend_kind": "BackendKind (required, non-unspecified)",
          "cap_bytes": "int64 (optional, 0 = no cap)",
          "cap_policy": "CapPolicy (optional, defaults to ALERT_BLOCK)",
          "location": "string (required)",
          "name": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "destination": "Destination"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing name/location, unspecified backend, or separate-root violation"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository creation failure"
        }
      ],
      "examples": [
        {
          "name": "Create a filesystem destination",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/CreateDestination -H 'Content-Type: application/json' -d '{\"name\":\"local-backup\",\"backendKind\":\"BACKEND_KIND_FILESYSTEM\",\"location\":\"/mnt/backup\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations create",
        "args": [
          "--name",
          "<name>",
          "--backend",
          "<backend>",
          "--location",
          "<location>"
        ]
      }
    },
    {
      "id": "destinations_get",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/GetDestination",
      "method": "POST",
      "summary": "Get a destination by id",
      "description": "Returns the destination matching the request id.",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "destination": "Destination"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No destination with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get a destination",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/GetDestination -H 'Content-Type: application/json' -d '{\"id\":\"dst-1\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "destinations_list",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/ListDestinations",
      "method": "POST",
      "summary": "List backup destinations",
      "description": "Lists registered destinations ordered by name with cursor pagination.",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "page_size": "int32",
          "page_token": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "destinations": "array<Destination>",
          "next_page_token": "string"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List all destinations",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/ListDestinations -H 'Content-Type: application/json' -d '{}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations list"
      }
    },
    {
      "id": "destinations_update",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/UpdateDestination",
      "method": "POST",
      "summary": "Update a destination's cap settings",
      "description": "Updates cap_bytes and/or cap_policy for the given destination. Other fields are immutable after creation.",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "cap_bytes": "int64 (0 = no cap)",
          "cap_policy": "CapPolicy",
          "id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "destination": "Destination"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No destination with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Set a 10 GiB cap",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/UpdateDestination -H 'Content-Type: application/json' -d '{\"id\":\"dst-1\",\"capBytes\":10737418240}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations update",
        "args": [
          "<id>",
          "--cap-bytes",
          "<bytes>"
        ]
      }
    },
    {
      "id": "destinations_delete",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/DeleteDestination",
      "method": "POST",
      "summary": "Delete a destination",
      "description": "Removes the destination catalog row. Does NOT delete the underlying kopia repository unless delete_repository is explicitly set (v1: repository deletion is not implemented).",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "delete_repository": "bool (reserved, not implemented in v1)",
          "id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "removed": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository delete failure"
        }
      ],
      "examples": [
        {
          "name": "Delete a destination",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/DeleteDestination -H 'Content-Type: application/json' -d '{\"id\":\"dst-1\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations delete",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "destinations_get_usage",
      "path": "/vrooli.data_backup_manager.v1.destinations.DestinationsService/GetDestinationUsage",
      "method": "POST",
      "summary": "Get destination usage",
      "description": "Returns current usage bytes, cap, usage state (WITHIN/NEAR/OVER), and cap policy for the given destination.",
      "category": "destinations",
      "request": {
        "type": "object",
        "properties": {
          "id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cap_bytes": "int64",
          "cap_policy": "CapPolicy",
          "usage_bytes": "int64",
          "usage_state": "UsageState"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No destination with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Engine stats failure"
        }
      ],
      "examples": [
        {
          "name": "Get destination usage",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.destinations.DestinationsService/GetDestinationUsage -H 'Content-Type: application/json' -d '{\"id\":\"dst-1\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager destinations usage",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "plans_create",
      "path": "/vrooli.data_backup_manager.v1.plans.PlansService/CreatePlan",
      "method": "POST",
      "summary": "Create a backup plan",
      "description": "Creates a new plan binding targets to destinations with a schedule and retention policy.",
      "category": "plans",
      "request": {
        "type": "object",
        "properties": {
          "destination_ids": "array<string> (required, ≥1)",
          "name": "string (required)",
          "retention": "RetentionPolicy (optional)",
          "schedule": "string (duration, optional)",
          "target_ids": "array<string> (required, ≥1)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "plan": "Plan"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing name, target_ids, or destination_ids"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create a nightly plan",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.plans.PlansService/CreatePlan -H 'Content-Type: application/json' -d '{\"name\":\"nightly\",\"targetIds\":[\"tgt-1\"],\"destinationIds\":[\"dst-1\"],\"schedule\":\"24h\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager plans create",
        "args": [
          "--name",
          "<name>",
          "--targets",
          "<ids>",
          "--destinations",
          "<ids>"
        ]
      }
    },
