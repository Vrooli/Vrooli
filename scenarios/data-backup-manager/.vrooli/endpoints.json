      "method": "POST",
      "summary": "Verify a snapshot's restorability",
      "description": "Test-restores a snapshot to a scratch directory, checksums the result, records last-verified-at on success, and cleans up scratch. The verify gate must pass before committed runtime data is removed.",
      "category": "restores",
      "request": {
        "type": "object",
        "properties": {
          "destination_id": "string (required)",
          "snapshot_id": "string (required)",
          "target_id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "restore": "Restore"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing required field"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown target or destination"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Engine or persistence failure"
        }
      ],
      "examples": [
        {
          "name": "Verify a snapshot",
          "curl": "curl http://localhost:${API_PORT}/vrooli.data_backup_manager.v1.restores.RestoresService/VerifyTarget -H 'Content-Type: application/json' -d '{\"targetId\":\"t-1\",\"destinationId\":\"dst-1\",\"snapshotId\":\"snap-1\"}'"
        }
      ],
      "cli_mapping": {
        "command": "data-backup-manager restores verify",
        "args": [
          "--target",
          "<id>",
          "--destination",
          "<id>",
          "--snapshot",
          "<id>"
        ]
      }
    },
