{
  "$schema": "../../../../.vrooli/schemas/service.schema.json",
  "version": "1.0.0",
  "service": {
    "parent": "vrooli",
    "name": "web-console",
    "displayName": "Web Console",
    "description": "Standalone browser terminal with pane-based workspaces, PTY-backed session durability, AI command generation, configurable launch shortcuts, and mobile-first floating toolbar",
    "version": "0.0.1",
    "type": "business-application",
    "category": "ai_tools",
    "tags": [
      "react-ui",
      "go-api"
    ],
    "maintainers": [
      {
        "name": "Vrooli Team",
        "email": "support@vrooli.com",
        "url": "https://github.com/Vrooli"
      }
    ],
    "repository": {
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli",
      "directory": "/scenarios/web-console"
    },
    "license": "MIT",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "documentation": "https://github.com/Vrooli/Vrooli/tree/master/docs",
    "support": {
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    }
  },
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
    },
    "ui": {
      "env_var": "UI_PORT",
      "description": "React UI",
      "port": 36233
    },
    "websocket": {
      "env_var": "WS_PORT",
      "description": "WebSocket channel",
      "range": "25000-29999"
    }
  },
  "lifecycle": {
    "version": "2.0.0",
    "health": {
      "description": "Standard API/UI health checks",
      "endpoints": {
        "api": "/health",
        "ui": "/health"
      },
      "startup_grace_period": 15000,
      "checks": [
        {
          "name": "api_endpoint",
          "type": "http",
          "target": "http://localhost:${API_PORT}/health",
          "timeout": 10000,
          "interval": 30000,
          "critical": true
        },
        {
          "name": "ui_endpoint",
          "type": "http",
          "target": "http://localhost:${UI_PORT}/health",
          "timeout": 5000,
          "interval": 30000,
          "critical": false
        }
      ]
    },
    "setup": {
      "description": "Build API & UI, install CLI",
      "condition": {
        "checks": [
          {
            "type": "binaries",
            "targets": ["api/web-console-api"]
          },
          {
            "type": "cli",
            "command": "web-console"
          },
          {
            "type": "ui-bundle",
            "bundle_path": "ui/dist/index.html",
            "source_dir": "ui/src"
          }
        ]
      },
      "steps": [
        {
          "name": "install-cli",
          "run": "cd cli && ./install.sh",
          "description": "Install CLI into ~/.vrooli/bin"
        },
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go mod download && GOWORK=off go build -o web-console-api .",
          "description": "Build Go API server"
        },
        {
          "name": "install-ui-deps",
          "run": "cd ui && pnpm install --ignore-workspace",
          "description": "Install UI dependencies"
        },
        {
          "name": "build-ui",
          "run": "cd ui && pnpm run build",
          "description": "Build production UI bundle"
        },
        {
          "name": "show-urls",
          "run": "echo \"API: http://localhost:${API_PORT}\" && echo \"UI: http://localhost:${UI_PORT}\"",
          "description": "Display access URLs"
        }
      ]
    },
    "develop": {
      "description": "Launch API and Vite dev server",
      "steps": [
        {
          "name": "start-api",
          "run": "cd api && ./web-console-api",
          "background": true,
          "description": "Start Go API server in background",
          "condition": {
            "file_exists": "api/web-console-api"
          }
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle",
          "condition": {
            "file_exists": "ui/dist/index.html"
          }
        },
        {
          "name": "register-tts-hook",
          "run": "bash -c 'source lib/tts-hooks.sh && wc::register_tts_hook' 2>/dev/null || true",
          "description": "Register Claude Code Stop hook for auto-TTS"
        },
        {
          "name": "show-urls",
          "run": "echo \"API: http://localhost:${API_PORT}\" && echo \"UI: http://localhost:${UI_PORT}\"",
          "description": "Display access URLs"
        }
      ]
    },
    "test": {
      "description": "Execute phased test suite via test-genie",
      "steps": [
        {
          "name": "run-tests",
          "run": "test-genie execute web-console --preset comprehensive",
          "description": "Run all test phases via test-genie"
        },
        {
          "name": "sync-validation",
          "run": "scripts/sync-validation-results.sh",
          "description": "Sync requirement validations to phase-results for scoring"
        }
      ]
    },
    "production": {
      "description": "Build and run production services",
      "steps": [
        {
          "name": "build-api",
          "run": "cd api && GOWORK=off go build -o web-console-api .",
          "description": "Build Go API binary"
        },
        {
          "name": "build-ui",
          "run": "cd ui && pnpm run build",
          "description": "Build production UI bundle"
        },
        {
          "name": "start-api",
          "run": "cd api && ./web-console-api",
          "background": true,
          "description": "Start Go API server"
        },
        {
          "name": "start-ui",
          "run": "cd ui && node server.js",
          "background": true,
          "description": "Serve production UI bundle"
        },
        {
          "name": "register-tts-hook",
          "run": "bash -c 'source lib/tts-hooks.sh && wc::register_tts_hook' 2>/dev/null || true",
          "description": "Register Claude Code Stop hook for auto-TTS"
        }
      ]
    },
    "stop": {
      "description": "Stop background processes",
      "steps": [
        {
          "name": "deregister-tts-hook",
          "run": "bash -c 'source lib/tts-hooks.sh && wc::deregister_tts_hook' 2>/dev/null || true",
          "description": "Deregister Claude Code Stop hook before shutdown"
        },
        {
          "name": "stop-api",
          "run": "pkill -f 'web-console-api' || true",
          "description": "Stop Go API"
        },
        {
          "name": "stop-ui",
          "run": "pkill -f 'node server.js' || true",
          "description": "Stop UI server"
        }
      ]
    }
  },
  "dependencies": {
    "resources": {
      "sqlite": {
        "type": "sqlite",
        "enabled": true,
        "required": true,
        "description": "Portable storage for workspace layout, shortcuts, and AI provider config"
      },
      "kokoro": {
        "type": "kokoro",
        "enabled": false,
        "required": false,
        "description": "Text-to-speech synthesis for voice output"
      },
      "whisper": {
        "type": "whisper",
        "enabled": false,
        "required": false,
        "description": "Speech-to-text transcription for voice input"
      }
    }
  }
}
