  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "ai_generate",
      "path": "/vrooli.web_console.v1.ai.AIService/Generate",
      "method": "POST",
      "summary": "Generate a shell command from natural language",
      "description": "Runs the provider chain (Ollama -> OpenRouter) to produce a single shell command for the given prompt.",
      "category": "ai",
      "request": {
        "type": "object",
        "properties": {
          "context": "string",
          "prompt": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "command": "string",
          "provider": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Prompt missing"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "All AI providers failed"
        }
      ]
    },
    {
      "id": "ai_suggest",
      "path": "/vrooli.web_console.v1.ai.AIService/Suggest",
      "method": "POST",
      "summary": "Suggest 1-3 candidate shell commands",
      "description": "Runs the provider chain to produce 1-3 shell-command suggestions for the given prompt.",
      "category": "ai",
      "request": {
        "type": "object",
        "properties": {
          "context": "string",
          "prompt": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "commands": "[]string",
          "provider": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Prompt missing"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "All AI providers failed"
        }
      ]
    },
    {
      "id": "ai_config_get",
      "path": "/vrooli.web_console.v1.ai.AIService/GetConfig",
      "method": "POST",
      "summary": "Get AI provider configuration and health",
      "description": "Returns the persisted provider configs plus runtime health snapshot.",
      "category": "ai",
      "response": {
        "type": "object",
        "properties": {
          "health": "[]ProviderHealth",
          "providers": "[]ProviderConfig"
        }
      }
    },
