    {
      "id": "sessions_recover",
      "path": "/vrooli.web_console.v1.sessions.SessionsService/Recover",
      "method": "POST",
      "summary": "Recover an orphaned session",
      "description": "Spawns a fresh persistent pane, copies CODEX_HOME for codex agents, and pastes the resume command. Idempotent via X-Idempotency-Key.",
      "category": "sessions",
      "response": {
        "type": "object",
        "properties": {
          "agent_type": "string",
          "codex_home_copied": "bool",
          "command_sent": "string",
          "new_session_id": "string",
          "old_session_id": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No such session row"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Session is not awaiting_recovery, or no agent identity recorded"
        },
        {
          "status": 429,
          "code": "resource_exhausted",
          "description": "Session limit reached while spawning replacement"
        }
      ]
    },
    {
