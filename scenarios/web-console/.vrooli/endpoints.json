      "id": "ai_config_update",
      "path": "/vrooli.web_console.v1.ai.AIService/UpdateConfig",
      "method": "POST",
      "summary": "Update an AI provider's configuration",
      "description": "Applies a partial update to one provider's config. Only fields with has_* = true are applied.",
      "category": "ai",
      "response": {
        "type": "object",
        "properties": {
