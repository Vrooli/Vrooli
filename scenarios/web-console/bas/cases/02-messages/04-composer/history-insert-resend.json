{
  "id": "c586164d-c6e1-4fc2-94fc-7a78184a36e7",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "history-insert-resend",
  "folder_path": "/bas/cases/02-messages/04-composer",
  "description": "Send a line from the composer, open the sent-message history from the expanded composer, and insert the line back into the draft",
  "metadata": {
    "name": "history-insert-resend",
    "description": "Send a line from the composer, open the sent-message history from the expanded composer, and insert the line back into the draft",
    "execution_mode": "mutating",
    "reset": "none",
    "labels": {
      "reset": "none",
      "requires_confirmation": "true",
      "routed_isolation": "true",
      "requirements_json": "[\"REQ-P0-017f\"]"
    }
  },
  "tags": [
    "reset:none",
    "requirements_json:[\"REQ-P0-017f\"]"
  ],
  "version": 1,
  "created_at": "2026-09-11T09:00:00Z",
  "updated_at": "2026-09-11T09:00:00Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          },
          "metadata": {
            "label": "Open workspace"
          }
        }
      },
      {
        "id": "hydrate-wait",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 1500
          },
          "metadata": {
            "label": "Allow sessions + conversation to hydrate"
          }
        }
      },
      {
        "id": "activate-messages-session",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const sleep = (ms) => new Promise((r) => setTimeout(r, ms)); const tabs = Array.from(document.querySelectorAll('[data-testid^=\"tab-\"]')).filter((el) => { const id = el.getAttribute('data-testid') || ''; return id !== 'tab-bar' && id !== 'tab-bar-new' && !id.startsWith('tab-group-') && !id.startsWith('tab-rename-input-'); }); let found = false; for (const tab of tabs) { tab.click(); await sleep(400); const toggle = document.querySelector('[data-testid=\"workspace-toggle-view\"]'); if (toggle instanceof HTMLElement) { found = true; break; } } document.body.setAttribute('data-nav-seed-session-active', found ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Activate the seeded messages-capable session"
          }
        }
      },
      {
        "id": "assert-messages-session",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-nav-seed-session-active='true']",
            "failure_message": "Expected a seeded session that supports the Messages view (seed.sh hook seeding may be unavailable)",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify a messages-capable session is active"
          }
        }
      },
      {
        "id": "switch-to-messages",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/workspace.toggleView"
          },
          "metadata": {
            "label": "Switch active pane to Messages view"
          }
        }
      },
      {
        "id": "assert-messages-pane",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid^=\"messages-pane-\"]",
            "failure_message": "Expected the Messages pane to render after toggling view",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify Messages pane rendered"
          }
        }
      },
      {
        "id": "type-draft",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "[data-testid=\"mobile-command-input\"]",
            "value": "echo wc-history-probe",
            "clear_first": true
          },
          "metadata": {
            "label": "Type a harmless line into the composer"
          }
        }
      },
      {
        "id": "tap-send",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"mobile-command-submit\"]"
          },
          "metadata": {
            "label": "Send it (typed, never followed by Enter)"
          }
        }
      },
      {
        "id": "assert-draft-cleared",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/messages.echoRow",
            "failure_message": "Expected the acknowledged send (its echo row) before opening history",
            "timeout_ms": 8000
          },
          "metadata": {
            "label": "Wait for the send to settle"
          }
        }
      },
      {
        "id": "expand-composer",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"expand-toggle\"]"
          },
          "metadata": {
            "label": "Open the expanded composer"
          }
        }
      },
      {
        "id": "assert-composer-open",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid=\"composer-open-history\"]",
            "failure_message": "Expected the expanded composer with its History button",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify the expanded composer opened"
          }
        }
      },
      {
        "id": "open-history",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/messages.composerHistory"
          },
          "metadata": {
            "label": "Open the sent-message history from the expanded composer"
          }
        }
      },
      {
        "id": "assert-history-open",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid=\"sent-history-sheet\"]",
            "failure_message": "Expected the sent-message history to open",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify the history opened"
          }
        }
      },
      {
        "id": "insert-latest",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"sent-history-row\"]:first-of-type [data-testid=\"sent-history-insert\"]"
          },
          "metadata": {
            "label": "Insert the latest send into the draft"
          }
        }
      },
      {
        "id": "check-draft",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const input = document.querySelector('[data-testid=\"composer-input\"]'); const ok = input instanceof HTMLTextAreaElement && input.value.includes('wc-history-probe'); document.body.setAttribute('data-history-inserted', ok ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Read the draft"
          }
        }
      },
      {
        "id": "assert-inserted",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-history-inserted='true']",
            "failure_message": "Expected Insert to put the sent line back into the draft",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify the draft holds the inserted line"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "open-workspace",
        "target": "hydrate-wait",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "hydrate-wait",
        "target": "activate-messages-session",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "activate-messages-session",
        "target": "assert-messages-session",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "assert-messages-session",
        "target": "switch-to-messages",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e5",
        "source": "switch-to-messages",
        "target": "assert-messages-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e6",
        "source": "assert-messages-pane",
        "target": "type-draft",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e7",
        "source": "type-draft",
        "target": "tap-send",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e8",
        "source": "tap-send",
        "target": "assert-draft-cleared",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e9",
        "source": "assert-draft-cleared",
        "target": "expand-composer",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e10",
        "source": "expand-composer",
        "target": "assert-composer-open",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e11",
        "source": "assert-composer-open",
        "target": "open-history",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e12",
        "source": "open-history",
        "target": "assert-history-open",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e13",
        "source": "assert-history-open",
        "target": "insert-latest",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e14",
        "source": "insert-latest",
        "target": "check-draft",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e15",
        "source": "check-draft",
        "target": "assert-inserted",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
