{
  "id": "7d9b14ad-14a8-495c-904d-5cf6f766f874",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "send-echo-and-enter",
  "folder_path": "/bas/cases/02-messages/04-composer",
  "description": "Send a line from the Messages composer, see its echo row, see it reported as typed but not submitted, and press Enter from the echo without leaving Messages",
  "metadata": {
    "name": "send-echo-and-enter",
    "description": "Send a line from the Messages composer, see its echo row, see it reported as typed but not submitted, and press Enter from the echo without leaving Messages",
    "execution_mode": "mutating",
    "reset": "none",
    "labels": {
      "reset": "none",
      "requires_confirmation": "true",
      "routed_isolation": "true",
      "requirements_json": "[\"REQ-P0-017f\"]"
    }
  },
  "tags": [
    "reset:none",
    "requirements_json:[\"REQ-P0-017f\"]"
  ],
  "version": 1,
  "created_at": "2026-09-11T09:00:00Z",
  "updated_at": "2026-09-11T09:00:00Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 390,
      "viewport_height": 844
    },
    "nodes": [
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          },
          "metadata": {
            "label": "Open workspace"
          }
        }
      },
      {
        "id": "hydrate-wait",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 1500
          },
          "metadata": {
            "label": "Allow sessions + conversation to hydrate"
          }
        }
      },
      {
        "id": "activate-messages-session",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const sleep = (ms) => new Promise((r) => setTimeout(r, ms)); const tabs = Array.from(document.querySelectorAll('[data-testid^=\"tab-\"]')).filter((el) => { const id = el.getAttribute('data-testid') || ''; return id !== 'tab-bar' && id !== 'tab-bar-new' && !id.startsWith('tab-group-') && !id.startsWith('tab-rename-input-'); }); let found = false; for (const tab of tabs) { tab.click(); await sleep(400); const toggle = document.querySelector('[data-testid=\"workspace-toggle-view\"]'); if (toggle instanceof HTMLElement) { found = true; break; } } document.body.setAttribute('data-nav-seed-session-active', found ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Activate the seeded messages-capable session"
          }
        }
      },
      {
        "id": "assert-messages-session",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-nav-seed-session-active='true']",
            "failure_message": "Expected a seeded session that supports the Messages view (seed.sh hook seeding may be unavailable)",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify a messages-capable session is active"
          }
        }
      },
      {
        "id": "switch-to-messages",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/workspace.toggleView"
          },
          "metadata": {
            "label": "Switch active pane to Messages view"
          }
        }
      },
      {
        "id": "assert-messages-pane",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid^=\"messages-pane-\"]",
            "failure_message": "Expected the Messages pane to render after toggling view",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify Messages pane rendered"
          }
        }
      },
      {
        "id": "type-draft",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "[data-testid=\"mobile-command-input\"]",
            "value": "echo wc-echo-probe",
            "clear_first": true
          },
          "metadata": {
            "label": "Type a harmless line into the composer"
          }
        }
      },
      {
        "id": "tap-send",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"mobile-command-submit\"]"
          },
          "metadata": {
            "label": "Tap Send (types the line, never presses Enter)"
          }
        }
      },
      {
        "id": "assert-echo-row",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/messages.echoRow",
            "failure_message": "Expected an echo row for the acknowledged send",
            "timeout_ms": 8000
          },
          "metadata": {
            "label": "Verify the send shows as an echo row in Messages"
          }
        }
      },
      {
        "id": "assert-unsubmitted",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid=\"msg-echo-row\"][data-state=\"unsubmitted\"]",
            "failure_message": "Expected the echo to report the line typed into the terminal but not submitted",
            "timeout_ms": 8000
          },
          "metadata": {
            "label": "Verify the echo reports typed-not-submitted"
          }
        }
      },
      {
        "id": "press-enter",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/messages.echoEnter"
          },
          "metadata": {
            "label": "Press Enter from the echo row"
          }
        }
      },
      {
        "id": "enter-wait",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 800
          },
          "metadata": {
            "label": "Allow Enter to reach the terminal"
          }
        }
      },
      {
        "id": "assert-still-messages",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid^=\"messages-pane-\"]",
            "failure_message": "Expected the pane to stay in Messages after sending and pressing Enter",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify the pane never flipped to the terminal"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "open-workspace",
        "target": "hydrate-wait",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "hydrate-wait",
        "target": "activate-messages-session",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "activate-messages-session",
        "target": "assert-messages-session",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "assert-messages-session",
        "target": "switch-to-messages",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e5",
        "source": "switch-to-messages",
        "target": "assert-messages-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e6",
        "source": "assert-messages-pane",
        "target": "type-draft",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e7",
        "source": "type-draft",
        "target": "tap-send",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e8",
        "source": "tap-send",
        "target": "assert-echo-row",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e9",
        "source": "assert-echo-row",
        "target": "assert-unsubmitted",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e10",
        "source": "assert-unsubmitted",
        "target": "press-enter",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e11",
        "source": "press-enter",
        "target": "enter-wait",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e12",
        "source": "enter-wait",
        "target": "assert-still-messages",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
