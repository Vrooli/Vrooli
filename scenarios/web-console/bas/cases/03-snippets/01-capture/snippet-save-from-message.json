      {"id":"e5","source":"open-save","target":"assert-save","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e6","source":"assert-save","target":"name","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e7","source":"name","target":"submit","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e8","source":"submit","target":"settle-save","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e9","source":"settle-save","target":"settings","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e10","source":"settings","target":"snippets-tab","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e11","source":"snippets-tab","target":"find-captured","type":"WORKFLOW_EDGE_TYPE_DEFAULT"},
      {"id":"e12","source":"find-captured","target":"assert-captured","type":"WORKFLOW_EDGE_TYPE_DEFAULT"}
    ]
  }
