      { "id": "e5", "source": "picker", "target": "grabber", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e6", "source": "grabber", "target": "dismiss", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e7", "source": "dismiss", "target": "inspect", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e8", "source": "inspect", "target": "assert", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e9", "source": "assert", "target": "reopen", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e10", "source": "reopen", "target": "escape", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e11", "source": "escape", "target": "inspect-escape", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" },
      { "id": "e12", "source": "inspect-escape", "target": "assert-escape", "type": "WORKFLOW_EDGE_TYPE_DEFAULT" }
    ]
  }
