  "description": "Dismiss the mobile snippet picker nested over the full-screen composer without selecting a snippet or closing the composer.",
  "metadata": { "name": "nested-snippet-picker-dismissal", "description": "Dismiss the mobile snippet picker nested over the full-screen composer without selecting a snippet or closing the composer.", "execution_mode": "mutating", "reset": "full", "labels": { "reset": "full", "requires_confirmation": "true", "routed_isolation": "true", "seed": "seed", "requirements_json": "[\"REQ-P0-015c\",\"REQ-P0-015h\"]" } },
  "tags": ["reset:full", "requirements_json:[\"REQ-P0-015c\",\"REQ-P0-015h\"]"],
