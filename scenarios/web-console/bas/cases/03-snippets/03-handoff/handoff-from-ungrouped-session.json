    {"id":"inspect-sections","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(() => { const hasTargets=!!document.querySelector('[data-testid^=\\\"handoff-target-\\\"]'); const hasGroup=!!document.querySelector('[data-testid=\\\"handoff-section-group\\\"]'); const hasReach=!!document.querySelector('[data-testid=\\\"handoff-section-other\\\"], [data-testid=\\\"handoff-section-new\\\"]'); document.body.setAttribute('data-bas-ungrouped-sections',hasTargets&&!hasGroup&&hasReach?'true':'false');})()"},"metadata":{"label":"Inspect target sections"}}},
