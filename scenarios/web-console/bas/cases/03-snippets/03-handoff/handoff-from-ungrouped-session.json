    {"id":"handoff","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(() => { const panes=Array.from(document.querySelectorAll('[data-testid=\\\"terminal-pane\\\"][data-session-id]')); const pane=panes[panes.length-1]; const id=pane?.getAttribute('data-session-id'); const trigger=id?document.querySelector('[data-testid=\\\"handoff-pane-header-'+id+'\\\"]'):null; if(trigger instanceof HTMLElement) trigger.click(); document.body.setAttribute('data-bas-ungrouped-handoff',trigger?'true':'false');})()"},"metadata":{"label":"Open handoff from ungrouped session"}}},
