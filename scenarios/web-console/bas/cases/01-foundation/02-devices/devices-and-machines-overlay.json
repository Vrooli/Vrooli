{
  "id": "6c34cbb3-7b04-4726-a2ac-b7f91e1fd3c6",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "devices-and-machines-overlay",
  "folder_path": "/bas/cases/01-foundation/02-devices",
  "description": "Render the Machines & screens surface from Settings → Devices with both horizontal population rails, machines first",
  "metadata": {
    "name": "devices-and-machines-overlay",
    "description": "Render the Machines & screens surface from Settings → Devices with both horizontal population rails, machines first",
    "execution_mode": "mutating",
    "labels": {
      "requires_confirmation": "true",
      "routed_isolation": "true",
      "seed": "seed",
      "spec_entry_id": "workspace",
      "requirements_json": "[\"REQ-P1-013c\"]"
    }
  },
  "tags": [
    "requirements_json:[\"REQ-P1-013c\"]"
  ],
  "version": 1,
  "flow_definition": {
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "ensure-session",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/ensure-session.json"
          },
          "metadata": {
            "label": "Ensure terminal session"
          }
        }
      },
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          }
        }
      },
      {
        "id": "open-settings",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid='toolbar-settings']"
          },
          "metadata": {
            "label": "Open settings"
          }
        }
      },
      {
        "id": "open-devices-tab",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid='settings-tab-devices']"
          },
          "metadata": {
            "label": "Open the Devices tab"
          }
        }
      },
      {
        "id": "assert-settings-modal",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "[data-testid='settings-modal']",
            "timeout_ms": 10000,
            "failure_message": "Expected the settings surface hosting the Devices tab"
          }
        }
      },
      {
        "id": "assert-screens-rail",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/fleet.railScreens",
            "timeout_ms": 10000,
            "failure_message": "Expected the Screens rail"
          }
        }
      },
      {
        "id": "assert-machine-rail",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/fleet.railMachines",
            "timeout_ms": 10000,
            "failure_message": "Expected the Machines rail"
          }
        }
      },
      {
        "id": "assert-shelf-order",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const machines = document.querySelector('[data-testid=\"fleet-rail-machines\"]'); const screens = document.querySelector('[data-testid=\"fleet-rail-screens\"]'); const ok = !!machines && !!screens && (machines.compareDocumentPosition(screens) & Node.DOCUMENT_POSITION_FOLLOWING) !== 0; document.body.setAttribute('data-fleet-shelf-order', ok ? 'true' : 'false'); })()"
          }
        }
      },
      {
        "id": "verify-shelf-order",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-fleet-shelf-order='true']",
            "timeout_ms": 5000,
            "failure_message": "Expected the machines shelf to lead the screens shelf"
          }
        }
      },
      {
        "id": "assert-overlay-copy",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const text = document.body.textContent || ''; const ok = text.includes('What you can work on, and where you are working from.'); document.body.setAttribute('data-fleet-overlay-copy', ok ? 'true' : 'false'); })()"
          }
        }
      },
      {
        "id": "verify-overlay-copy",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-fleet-overlay-copy='true']",
            "timeout_ms": 5000,
            "failure_message": "Expected the fleet surface explanatory subtitle"
          }
        }
      },
      {
        "id": "assert-device-artwork",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/fleet.deviceSilhouette",
            "timeout_ms": 10000,
            "failure_message": "Expected a connected screen card with device artwork"
          }
        }
      },
      {
        "id": "assert-machine-artwork",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "@selector/fleet.machineSilhouette",
            "timeout_ms": 10000,
            "failure_message": "Expected a machine card with machine artwork"
          }
        }
      },
      {
        "id": "assert-population-artwork",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const devices = [...document.querySelectorAll('[data-testid^=\"fleet-card-device-\"]')]; const machines = [...document.querySelectorAll('[data-testid^=\"fleet-card-machine-\"]')]; const clean = devices.length > 0 && machines.length > 0 && devices.every((card) => !card.querySelector('[data-testid=\"machine-silhouette\"]')) && machines.every((card) => !card.querySelector('[data-testid=\"device-silhouette\"]')); document.body.setAttribute('data-fleet-population-artwork', clean ? 'true' : 'false'); })()"
          }
        }
      },
      {
        "id": "verify-population-artwork",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-fleet-population-artwork='true']",
            "timeout_ms": 5000,
            "failure_message": "Device and machine cards must keep their artwork populations distinct"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "ensure-session",
        "target": "open-workspace",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "open-workspace",
        "target": "open-settings",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "open-settings",
        "target": "open-devices-tab",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "open-devices-tab",
        "target": "assert-settings-modal",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e5",
        "source": "assert-settings-modal",
        "target": "assert-screens-rail",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e6",
        "source": "assert-screens-rail",
        "target": "assert-machine-rail",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e7",
        "source": "assert-machine-rail",
        "target": "assert-shelf-order",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e8",
        "source": "assert-shelf-order",
        "target": "verify-shelf-order",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e9",
        "source": "verify-shelf-order",
        "target": "assert-overlay-copy",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e10",
        "source": "assert-overlay-copy",
        "target": "verify-overlay-copy",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e11",
        "source": "verify-overlay-copy",
        "target": "assert-device-artwork",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e12",
        "source": "assert-device-artwork",
        "target": "assert-machine-artwork",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e13",
        "source": "assert-machine-artwork",
        "target": "assert-population-artwork",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e14",
        "source": "assert-population-artwork",
        "target": "verify-population-artwork",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
