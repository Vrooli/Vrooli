        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e9",
        "source": "assert-waiting-role-rendered",
        "target": "count-sessions-before-start",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e10",
        "source": "count-sessions-before-start",
        "target": "assert-one-waiting",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e11",
        "source": "assert-one-waiting",
        "target": "start-the-waiting-role",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e12",
        "source": "start-the-waiting-role",
        "target": "settle-after-start",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e13",
        "source": "settle-after-start",
        "target": "count-sessions-after-start",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e14",
        "source": "count-sessions-after-start",
        "target": "assert-second-session",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e15",
        "source": "assert-second-session",
        "target": "teardown",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}