{
  "metadata": {
    "name": "interactive-stdin-roundtrip",
    "description": "Launch empty shell, send stdin via keyboard, and verify stdout round-trip in terminal pane",
    "labels": {
      "reset": "full",
      "requirements_json": "[\"REQ-P0-002b\"]"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "open-workspace",
      "action": {
        "type": "ACTION_TYPE_SUBFLOW",
        "subflow": {
          "workflow_path": "actions/open-workspace.json"
        },
        "metadata": {
          "label": "Open workspace"
        }
      }
    },
    {
      "id": "reset-sessions",
      "action": {
        "type": "ACTION_TYPE_SUBFLOW",
        "subflow": {
          "workflow_path": "actions/reset-sessions-best-effort.json"
        },
        "metadata": {
          "label": "Reset sessions (best effort)"
        }
      }
    },
    {
      "id": "click-new-terminal",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/workspace.newTerminalButton"
        },
        "metadata": {
          "label": "Open launcher"
        }
      }
    },
    {
      "id": "wait-launcher",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/launcher.dialog",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for launcher"
        }
      }
    },
    {
      "id": "launch-empty-shell",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/launcher.emptyShell"
        },
        "metadata": {
          "label": "Launch empty shell"
        }
      }
    },
    {
      "id": "wait-terminal-pane",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/terminal.pane",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": {
          "label": "Wait for terminal pane"
        }
      }
    },
    {
      "id": "click-terminal-pane",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane']"
        },
        "metadata": {
          "label": "Activate terminal pane"
        }
      }
    },
    {
      "id": "focus-xterm-textarea",
      "action": {
        "type": "ACTION_TYPE_FOCUS",
        "focus": {
          "selector": "[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane'] .xterm-helper-textarea",
          "timeout_ms": 5000
        },
        "metadata": {
          "label": "Focus xterm input element"
        }
      }
    },
    {
      "id": "send-stdin-command",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": {
          "keys": [
            "e",
            "c",
            "h",
            "o",
            "Space",
            "b",
            "a",
            "s",
            "s",
            "t",
            "d",
            "i",
            "n",
            "l",
            "i",
            "v",
            "e",
            "o",
            "k",
            "Enter"
          ]
        },
        "metadata": {
          "label": "Type command via keyboard"
        }
      }
    },
    {
      "id": "wait-output-render",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "duration_ms": 1200
        },
        "metadata": {
          "label": "Wait for command output"
        }
      }
    },
    {
      "id": "evaluate-stdin-roundtrip",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(async () => { let markerSeen = false; let disconnected = false; const deadline = Date.now() + 8000; while (Date.now() < deadline) { const activePane = document.querySelector('[data-testid=\"terminal-pane-container\"].border-wc-accent [data-testid=\"terminal-pane\"][data-session-id]'); const fallbackPane = document.querySelector('[data-testid=\"terminal-pane\"][data-session-id]'); const pane = activePane || fallbackPane; const sessionId = pane ? (pane.getAttribute('data-session-id') || '') : ''; const paneText = pane ? (pane.textContent || '') : ''; const outputMap = window.__bas_ws_output || {}; const wsText = sessionId ? (outputMap[sessionId] || '') : ''; markerSeen = paneText.includes('basstdinliveok') || wsText.includes('basstdinliveok'); disconnected = paneText.includes('[Connection lost]') || paneText.includes('open a new terminal to reconnect'); if (markerSeen) break; await new Promise((resolve) => setTimeout(resolve, 100)); } document.body.setAttribute('data-stdin-roundtrip-ok', markerSeen ? 'true' : 'false'); document.body.setAttribute('data-terminal-disconnected', disconnected ? 'true' : 'false'); })()"
        },
        "metadata": {
          "label": "Check stdin->stdout marker"
        }
      }
    },
    {
      "id": "assert-terminal-connected",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "body[data-terminal-disconnected='false']",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Terminal disconnected during stdin roundtrip test"
        },
        "metadata": {
          "label": "Verify terminal remained connected"
        }
      }
    },
    {
      "id": "assert-stdin-roundtrip",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "body[data-stdin-roundtrip-ok='true']",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Expected keyboard stdin command to produce visible stdout marker"
        },
        "metadata": {
          "label": "Verify keyboard stdin path"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "open-workspace",
      "target": "reset-sessions",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "reset-sessions",
      "target": "click-new-terminal",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e3",
      "source": "click-new-terminal",
      "target": "wait-launcher",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e4",
      "source": "wait-launcher",
      "target": "launch-empty-shell",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e5",
      "source": "launch-empty-shell",
      "target": "wait-terminal-pane",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e6",
      "source": "wait-terminal-pane",
      "target": "click-terminal-pane",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e7",
      "source": "click-terminal-pane",
      "target": "focus-xterm-textarea",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e8",
      "source": "focus-xterm-textarea",
      "target": "send-stdin-command",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e9",
      "source": "send-stdin-command",
      "target": "wait-output-render",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e10",
      "source": "wait-output-render",
      "target": "evaluate-stdin-roundtrip",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e11",
      "source": "evaluate-stdin-roundtrip",
      "target": "assert-terminal-connected",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e12",
      "source": "assert-terminal-connected",
      "target": "assert-stdin-roundtrip",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
