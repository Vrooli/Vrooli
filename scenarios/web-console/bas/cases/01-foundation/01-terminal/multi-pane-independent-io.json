{
  "metadata": {
    "name": "multi-pane-independent-io",
    "description": "Launch two panes, run distinct stdin commands, and verify output stays isolated per pane",
    "labels": {
      "reset": "full",
      "requirements_json": "[\"REQ-P0-001b\", \"REQ-P0-002b\"]"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {"id":"open-workspace","action":{"type":"ACTION_TYPE_SUBFLOW","subflow":{"workflow_path":"actions/open-workspace.json"},"metadata":{"label":"Open workspace"}}},
    {"id":"launch-pane-one","action":{"type":"ACTION_TYPE_SUBFLOW","subflow":{"workflow_path":"cases/01-foundation/01-terminal/interactive-stdin-roundtrip.json"},"metadata":{"label":"Seed first interactive pane"}}},
    {"id":"click-new-terminal","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/workspace.newTerminalButton"},"metadata":{"label":"Open launcher for second pane"}}},
    {"id":"wait-launcher","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/launcher.dialog","state":"WAIT_STATE_VISIBLE","timeout_ms":10000},"metadata":{"label":"Wait for launcher"}}},
    {"id":"launch-empty-shell","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/launcher.emptyShell"},"metadata":{"label":"Launch second empty shell"}}},
    {"id":"wait-second-pane","action":{"type":"ACTION_TYPE_WAIT","wait":{"duration_ms":1000},"metadata":{"label":"Wait for second pane render"}}},
    {
      "id": "focus-second-pane",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const panes = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane-container\"][data-session-id]')); const second = panes[1]; if (second instanceof HTMLElement) second.click(); })()"
        },
        "metadata": {
          "label": "Activate second pane"
        }
      }
    },
    {"id":"focus-xterm-second","action":{"type":"ACTION_TYPE_FOCUS","focus":{"selector":"[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane'] .xterm-helper-textarea","timeout_ms":5000},"metadata":{"label":"Focus second pane input"}}},
    {
      "id": "send-second-pane-command",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": {
          "keys": ["e","c","h","o","Space","p","a","n","e","2","o","k","Enter"]
        },
        "metadata": {
          "label": "Emit second pane marker"
        }
      }
    },
    {"id":"wait-markers","action":{"type":"ACTION_TYPE_WAIT","wait":{"duration_ms":1200},"metadata":{"label":"Wait for marker output"}}},
    {
      "id": "evaluate-pane-isolation",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(async () => { let countOk = false; let isolated = false; const deadline = Date.now() + 8000; while (Date.now() < deadline) { const panes = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane\"][data-session-id]')); const texts = panes.map((pane) => (pane.textContent || '').toLowerCase()); countOk = panes.length >= 2; const pane1Hits = texts.filter((t) => t.includes('basstdinliveok')).length; const pane2Hits = texts.filter((t) => t.includes('pane2ok')).length; isolated = pane1Hits === 1 && pane2Hits === 1; if (countOk && isolated) break; await new Promise((resolve) => setTimeout(resolve, 100)); } document.body.setAttribute('data-multipane-count-ok', countOk ? 'true' : 'false'); document.body.setAttribute('data-multipane-isolation-ok', isolated ? 'true' : 'false'); })()"
        },
        "metadata": {
          "label": "Check per-pane output isolation"
        }
      }
    },
    {"id":"assert-pane-count","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"body[data-multipane-count-ok='true']","mode":"ASSERTION_MODE_EXISTS","timeout_ms":5000,"failure_message":"Expected at least two terminal panes"},"metadata":{"label":"Verify pane count"}}},
    {"id":"assert-pane-isolation","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"body[data-multipane-isolation-ok='true']","mode":"ASSERTION_MODE_EXISTS","timeout_ms":5000,"failure_message":"Expected each marker in exactly one pane"},"metadata":{"label":"Verify I/O isolation"}}}
  ],
  "edges": [
    {"id":"e1","source":"open-workspace","target":"launch-pane-one","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e2","source":"launch-pane-one","target":"click-new-terminal","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e3","source":"click-new-terminal","target":"wait-launcher","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e4","source":"wait-launcher","target":"launch-empty-shell","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e5","source":"launch-empty-shell","target":"wait-second-pane","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e6","source":"wait-second-pane","target":"focus-second-pane","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e7","source":"focus-second-pane","target":"focus-xterm-second","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e8","source":"focus-xterm-second","target":"send-second-pane-command","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e9","source":"send-second-pane-command","target":"wait-markers","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e10","source":"wait-markers","target":"evaluate-pane-isolation","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e11","source":"evaluate-pane-isolation","target":"assert-pane-count","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e12","source":"assert-pane-count","target":"assert-pane-isolation","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"}
  ]
}
