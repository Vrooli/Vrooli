  "flow_definition": {
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          },
          "metadata": {
            "label": "Open workspace"
          }
        }
      },
      {
        "id": "reset-sessions",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/capture-session-baseline.json"
          },
          "metadata": {
            "label": "Capture session baseline"
          }
        }
      },
      {
        "id": "capture-baseline-session-ids",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const ids = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane\"][data-session-id]')).map((pane) => pane.getAttribute('data-session-id') || '').filter(Boolean); localStorage.setItem('bas.multipane.baselineSessionIds', JSON.stringify(ids)); })()"
          },
          "metadata": {
            "label": "Capture baseline session IDs"
          }
        }
      },
      {
        "id": "launch-pane-one",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "cases/01-foundation/01-terminal/interactive-stdin-roundtrip.json"
          },
          "metadata": {
            "label": "Seed first interactive pane"
          }
        }
      },
      {
        "id": "click-new-terminal",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"new-terminal-button\"], [data-testid=\"toolbar-new\"]"
          },
          "metadata": {
            "label": "Open launcher for second pane"
          }
        }
      },
      {
        "id": "wait-launcher",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/launcher.dialog",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Wait for launcher"
          }
        }
      },
      {
        "id": "launch-empty-shell",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/launcher.emptyShell"
          },
          "metadata": {
            "label": "Launch second empty shell"
          }
        }
      },
      {
        "id": "wait-second-pane",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 1000
          },
          "metadata": {
            "label": "Wait for second pane render"
          }
        }
      },
      {
        "id": "resolve-target-session-wait-second-pane",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const listIds = async () => { try { const res = await fetch('/vrooli.web_console.v1.sessions.SessionsService/List', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}', cache: 'no-store' }); if (!res.ok) return null; const body = await res.json(); const rows = Array.isArray(body) ? body : (body && body.sessions) || []; return rows.map((s) => s && s.id).filter(Boolean); } catch { return null; } }; const readBaseline = () => { try { const raw = sessionStorage.getItem('__bas_baseline_sessions'); if (!raw) return null; const parsed = JSON.parse(raw); return Array.isArray(parsed) ? parsed : null; } catch { return null; } }; const baseline = new Set(readBaseline() || []); const deadline = Date.now() + 10000; let target = ''; while (Date.now() < deadline) { const ids = await listIds();  if (ids) { const fresh = ids.filter((id) => !baseline.has(id));   if (fresh.length > 0) { target = fresh[fresh.length - 1]; break; } }  await new Promise((r) => setTimeout(r, 150)); } window.__bas_target_session = target; document.body.setAttribute('data-bas-target-session', target); document.body.setAttribute('data-bas-target-resolved', target ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Resolve the session this case created"
          }
        }
      },
      {
        "id": "assert-target-resolved-wait-second-pane",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-bas-target-resolved='true']",
            "failure_message": "Could not identify the session this case created; refusing to type into an unknown pane",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Verify target session resolved"
          }
        }
      },
      {
        "id": "focus-target-pane-wait-second-pane",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const id = window.__bas_target_session || ''; document.body.setAttribute('data-bas-focus-ok', 'false'); if (!id) return; const deadline = Date.now() + 10000; while (Date.now() < deadline) {  const pane = document.querySelector('[data-testid=\"terminal-pane\"][data-session-id=\"' + id + '\"]');  const area = pane && pane.querySelector('.xterm-helper-textarea');  if (area) { const container = pane.closest('[data-testid=\"terminal-pane-container\"]');   if (container) container.click(); area.focus();   if (document.activeElement === area) { document.body.setAttribute('data-bas-focus-ok', 'true'); return; } }  await new Promise((r) => setTimeout(r, 150)); } })()"
          },
          "metadata": {
            "label": "Focus the created session's terminal"
          }
        }
      },
      {
        "id": "assert-focus-ok-wait-second-pane",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-bas-focus-ok='true']",
            "failure_message": "Could not focus the created session's terminal; input would have gone to another pane",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Verify focus landed on the created session"
          }
        }
      },
      {
        "id": "capture-new-session-ids",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const baseline = new Set(JSON.parse(localStorage.getItem('bas.multipane.baselineSessionIds') || '[]')); const currentIds = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane\"][data-session-id]')).map((pane) => pane.getAttribute('data-session-id') || '').filter(Boolean); const newIds = currentIds.filter((id) => !baseline.has(id)); localStorage.setItem('bas.multipane.newSessionIds', JSON.stringify(newIds)); document.body.setAttribute('data-multipane-new-count-ok', newIds.length >= 2 ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Capture newly-created session IDs"
          }
        }
      },
      {
        "id": "assert-new-session-count",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-multipane-new-count-ok='true']",
            "failure_message": "Expected at least two new sessions for this test",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify isolated session set"
          }
        }
      },
      {
        "id": "send-second-pane-command",
        "action": {
          "type": "ACTION_TYPE_KEYBOARD",
          "keyboard": {
            "keys": [
              "e",
              "c",
              "h",
              "o",
              "Space",
              "p",
              "a",
              "n",
              "e",
              "2",
              "o",
              "k",
              "Enter"
            ]
          },
          "metadata": {
            "label": "Emit second pane marker"
          }
        }
      },
      {
        "id": "wait-markers",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 1200
          },
          "metadata": {
            "label": "Wait for marker output"
          }
        }
      },
      {
        "id": "evaluate-pane-isolation",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { let countOk = false; let isolated = false; const newIds = JSON.parse(localStorage.getItem('bas.multipane.newSessionIds') || '[]'); const deadline = Date.now() + 8000; while (Date.now() < deadline) { const texts = newIds.map((id) => { const pane = document.querySelector(`[data-testid=\"terminal-pane\"][data-session-id=\"${id}\"]`); return (pane?.textContent || '').toLowerCase(); }); countOk = newIds.length >= 2; const pane1Hits = texts.filter((t) => t.includes('basstdinliveok')).length; const pane2Hits = texts.filter((t) => t.includes('pane2ok')).length; isolated = pane1Hits === 1 && pane2Hits === 1; if (countOk && isolated) break; await new Promise((resolve) => setTimeout(resolve, 100)); } document.body.setAttribute('data-multipane-count-ok', countOk ? 'true' : 'false'); document.body.setAttribute('data-multipane-isolation-ok', isolated ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Check per-pane output isolation"
          }
        }
      },
      {
        "id": "assert-pane-count",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-multipane-count-ok='true']",
            "failure_message": "Expected at least two terminal panes",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify pane count"
          }
        }
      },
      {
        "id": "assert-pane-isolation",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-multipane-isolation-ok='true']",
            "failure_message": "Expected each marker in exactly one pane",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify I/O isolation"
          }
        }
      },
      {
        "id": "teardown-test-sessions",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/teardown-test-sessions.json"
          },
          "metadata": {
            "label": "Delete sessions created by this case"
          }
        }
      }
    ],
