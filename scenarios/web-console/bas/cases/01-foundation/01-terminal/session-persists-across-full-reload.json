        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "click-new-terminal",
        "target": "wait-launcher",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e5",
        "source": "wait-launcher",
        "target": "launch-empty-shell",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e6",
        "source": "launch-empty-shell",
        "target": "wait-terminal-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e7",
        "source": "wait-terminal-pane",
        "target": "click-terminal-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e8",
        "source": "click-terminal-pane",
        "target": "focus-xterm-textarea",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e9",
        "source": "focus-xterm-textarea",
        "target": "send-marker-command",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e10",
        "source": "send-marker-command",
        "target": "wait-marker-output",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e11",
        "source": "wait-marker-output",
        "target": "capture-session-before-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e12",
        "source": "capture-session-before-reload",
        "target": "assert-marker-before-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e13",
        "source": "assert-marker-before-reload",
        "target": "trigger-full-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e14",
        "source": "trigger-full-reload",
        "target": "wait-workspace-after-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e15",
        "source": "wait-workspace-after-reload",
        "target": "evaluate-session-after-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e16",
        "source": "evaluate-session-after-reload",
        "target": "assert-session-after-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e17",
        "source": "assert-session-after-reload",
        "target": "assert-marker-after-reload",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}