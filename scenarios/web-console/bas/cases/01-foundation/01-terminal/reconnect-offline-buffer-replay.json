{
  "id": "23ac9f76-8015-4dec-9991-ee4cae3ddebf",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "reconnect-offline-buffer-replay",
  "folder_path": "/bas/cases/01-foundation/01-terminal",
  "description": "Force websocket disconnect, reload, and verify buffered terminal output replays",
  "tags": [
    "reset:full",
    "requirements_json:[\"REQ-P0-003b\", \"REQ-P0-003b-i\"]"
  ],
  "version": 1,
  "created_at": "2026-07-12T19:31:13.437678793Z",
  "updated_at": "2026-07-12T19:31:13.437678793Z",
  "flow_definition": {
    "settings": {
      "viewport_width": 1440,
      "viewport_height": 900
    },
    "nodes": [
      {
        "id": "navigate-workspace-root",
        "action": {
          "type": "ACTION_TYPE_NAVIGATE",
          "navigate": {
            "timeout_ms": 30000,
            "wait_until": "NAVIGATE_WAIT_EVENT_UNSPECIFIED",
            "destination_type": "NAVIGATE_DESTINATION_TYPE_UNSPECIFIED",
            "scenario": "web-console",
            "scenario_path": "/#/workspace"
          },
          "metadata": {
            "label": "Open workspace route"
          }
        }
      },
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          },
          "metadata": {
            "label": "Open workspace"
          }
        }
      },
      {
        "id": "reset-sessions",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/reset-sessions-best-effort.json"
          },
          "metadata": {
            "label": "Reset sessions (best effort)"
          }
        }
      },
      {
        "id": "click-new-terminal",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"new-terminal-button\"], [data-testid=\"toolbar-new\"]"
          },
          "metadata": {
            "label": "Open launcher"
          }
        }
      },
      {
        "id": "wait-launcher",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/launcher.dialog",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Wait for launcher"
          }
        }
      },
      {
        "id": "launch-empty-shell",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/launcher.emptyShell"
          },
          "metadata": {
            "label": "Launch empty shell"
          }
        }
      },
      {
        "id": "wait-terminal-pane",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/terminal.pane",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for terminal pane"
          }
        }
      },
      {
        "id": "click-terminal-pane",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane']"
          },
          "metadata": {
            "label": "Activate terminal pane"
          }
        }
      },
      {
        "id": "focus-xterm-textarea",
        "action": {
          "type": "ACTION_TYPE_FOCUS",
          "focus": {
            "selector": "[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane'] .xterm-helper-textarea",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Focus xterm input"
          }
        }
      },
      {
        "id": "send-delayed-command",
        "action": {
          "type": "ACTION_TYPE_KEYBOARD",
          "keyboard": {
            "keys": [
              "e",
              "c",
              "h",
              "o",
              "Space",
              "b",
              "a",
              "s",
              "r",
              "e",
              "p",
              "l",
              "a",
              "y",
              "a",
              "r",
              "m",
              "e",
              "d",
              "Space",
              "&",
              "&",
              "Space",
              "s",
              "l",
              "e",
              "e",
              "p",
              "Space",
              "2",
              "Space",
              "&",
              "&",
              "Space",
              "e",
              "c",
              "h",
              "o",
              "Space",
              "b",
              "a",
              "s",
              "r",
              "e",
              "p",
              "l",
              "a",
              "y",
              "o",
              "k",
              "Enter"
            ]
          },
          "metadata": {
            "label": "Send command that emits delayed output"
          }
        }
      },
      {
        "id": "capture-session-before-disconnect",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const activePane = document.querySelector('[data-testid=\"terminal-pane-container\"].border-wc-accent [data-testid=\"terminal-pane\"][data-session-id]'); const fallbackPane = document.querySelector('[data-testid=\"terminal-pane\"][data-session-id]'); const pane = activePane || fallbackPane; const sessionId = pane ? (pane.getAttribute('data-session-id') || '') : ''; if (sessionId) localStorage.setItem('bas.replay.sessionId', sessionId); document.body.setAttribute('data-replay-session-id', sessionId); })()"
          },
          "metadata": {
            "label": "Capture active session id"
          }
        }
      },
      {
        "id": "disconnect-tracked-sockets",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const list = Array.isArray(window.__bas_ws_instances) ? window.__bas_ws_instances : []; list.forEach((ws) => { if (ws && ws.readyState === 1) ws.close(1000, 'bas-test-disconnect'); }); document.body.setAttribute('data-bas-disconnected', 'true'); })()"
          },
          "metadata": {
            "label": "Close tracked websocket connections"
          }
        }
      },
      {
        "id": "wait-output-while-offline",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "duration_ms": 2600
          },
          "metadata": {
            "label": "Wait while disconnected"
          }
        }
      },
      {
        "id": "reload-workspace-to-reconnect",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { window.location.reload(); })()"
          },
          "metadata": {
            "label": "Reload workspace"
          }
        }
      },
      {
        "id": "wait-workspace-after-reload",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "[data-testid=\"new-terminal-button\"], [data-testid=\"toolbar-new\"]",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 20000
          },
          "metadata": {
            "label": "Wait for workspace after reload"
          }
        }
      },
      {
        "id": "activate-restored-pane",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const sessionId = localStorage.getItem('bas.replay.sessionId') || ''; const bySession = sessionId ? document.querySelector(`[data-testid=\"terminal-pane-container\"][data-session-id=\"${sessionId}\"]`) : null; const fallback = document.querySelector('[data-testid=\"terminal-pane-container\"][data-session-id]'); const pane = bySession || fallback; if (pane instanceof HTMLElement) pane.click(); })()"
          },
          "metadata": {
            "label": "Activate restored terminal pane"
          }
        }
      },
      {
        "id": "focus-xterm-after-reconnect",
        "action": {
          "type": "ACTION_TYPE_FOCUS",
          "focus": {
            "selector": "[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane'] .xterm-helper-textarea",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Focus xterm after reconnect"
          }
        }
      },
      {
        "id": "send-post-reconnect-command",
        "action": {
          "type": "ACTION_TYPE_KEYBOARD",
          "keyboard": {
            "keys": [
              "e",
              "c",
              "h",
              "o",
              "Space",
              "b",
              "a",
              "s",
              "r",
              "e",
              "p",
              "l",
              "a",
              "y",
              "p",
              "o",
              "s",
              "t",
              "o",
              "k",
              "Enter"
            ]
          },
          "metadata": {
            "label": "Send stdin after reconnect"
          }
        }
      },
      {
        "id": "evaluate-replay-after-reconnect",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const sessionId = localStorage.getItem('bas.replay.sessionId') || ''; let paneSeen = false; let armed = false; let replayOk = false; let postReconnectOk = false; const deadline = Date.now() + 10000; while (Date.now() < deadline) { const pane = sessionId ? document.querySelector(`[data-testid=\"terminal-pane\"][data-session-id=\"${sessionId}\"]`) : document.querySelector('[data-testid=\"terminal-pane\"][data-session-id]'); const text = pane ? (pane.textContent || '') : ''; if (pane) paneSeen = true; if (text.includes('basreplayarmed')) armed = true; if (text.includes('basreplayok')) replayOk = true; if (text.includes('basreplaypostok')) postReconnectOk = true; if (replayOk && postReconnectOk) break; await new Promise((resolve) => setTimeout(resolve, 100)); } document.body.setAttribute('data-replay-pane-present', paneSeen ? 'true' : 'false'); document.body.setAttribute('data-replay-armed-after', armed ? 'true' : 'false'); document.body.setAttribute('data-replay-ok', replayOk ? 'true' : 'false'); document.body.setAttribute('data-replay-post-reconnect-ok', postReconnectOk ? 'true' : 'false'); })()"
          },
          "metadata": {
            "label": "Check replay markers after reconnect"
          }
        }
      },
      {
        "id": "assert-session-pane-restored",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-replay-pane-present='true']",
            "failure_message": "Expected original terminal session pane after reconnect",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify pane restored"
          }
        }
      },
      {
        "id": "assert-replay-armed-seen",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-replay-armed-after='true']",
            "failure_message": "Expected first marker after reconnect",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify first marker"
          }
        }
      },
      {
        "id": "assert-replay-success",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-replay-ok='true']",
            "failure_message": "Expected delayed marker replay after reconnect",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify replay success"
          }
        }
      },
      {
        "id": "assert-post-reconnect-stdin",
        "action": {
          "type": "ACTION_TYPE_ASSERT",
          "assert": {
            "selector": "body[data-replay-post-reconnect-ok='true']",
            "failure_message": "Expected post-reconnect stdin command marker to confirm interactive terminal",
            "timeout_ms": 5000
          },
          "metadata": {
            "label": "Verify post-reconnect stdin"
          }
        }
      }
    ],
