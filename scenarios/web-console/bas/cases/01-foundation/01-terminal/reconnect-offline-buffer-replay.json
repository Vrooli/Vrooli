{
  "metadata": {
    "name": "reconnect-offline-buffer-replay",
    "description": "Force websocket disconnect, reload, and verify buffered terminal output replays",
    "labels": {
      "reset": "full",
      "requirements_json": "[\"REQ-P0-003b\", \"REQ-P0-003b-i\"]"
    }
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {"id":"open-workspace","action":{"type":"ACTION_TYPE_SUBFLOW","subflow":{"workflow_path":"actions/open-workspace.json"},"metadata":{"label":"Open workspace"}}},
    {"id":"click-new-terminal","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/workspace.newTerminalButton"},"metadata":{"label":"Open launcher"}}},
    {"id":"wait-launcher","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/launcher.dialog","state":"WAIT_STATE_VISIBLE","timeout_ms":10000},"metadata":{"label":"Wait for launcher"}}},
    {"id":"launch-empty-shell","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"@selector/launcher.emptyShell"},"metadata":{"label":"Launch empty shell"}}},
    {"id":"wait-terminal-pane","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/terminal.pane","state":"WAIT_STATE_VISIBLE","timeout_ms":15000},"metadata":{"label":"Wait for terminal pane"}}},
    {"id":"click-terminal-pane","action":{"type":"ACTION_TYPE_CLICK","click":{"selector":"[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane']"},"metadata":{"label":"Activate terminal pane"}}},
    {"id":"focus-xterm-textarea","action":{"type":"ACTION_TYPE_FOCUS","focus":{"selector":"[data-testid='terminal-pane-container'].border-wc-accent [data-testid='terminal-pane'] .xterm-helper-textarea","timeout_ms":5000},"metadata":{"label":"Focus xterm input"}}},
    {
      "id": "send-delayed-command",
      "action": {
        "type": "ACTION_TYPE_KEYBOARD",
        "keyboard": {
          "keys": [
            "e","c","h","o","Space","b","a","s","r","e","p","l","a","y","a","r","m","e","d",
            "Space","&","&","Space",
            "s","l","e","e","p","Space","2",
            "Space","&","&","Space",
            "e","c","h","o","Space","b","a","s","r","e","p","l","a","y","o","k",
            "Enter"
          ]
        },
        "metadata": {
          "label": "Send command that emits delayed output"
        }
      }
    },
    {
      "id": "capture-session-before-disconnect",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const pane = document.querySelector('[data-testid=\"terminal-pane\"][data-session-id]'); const sessionId = pane ? (pane.getAttribute('data-session-id') || '') : ''; if (sessionId) localStorage.setItem('bas.replay.sessionId', sessionId); document.body.setAttribute('data-replay-session-id', sessionId); })()"
        },
        "metadata": {
          "label": "Capture active session id"
        }
      }
    },
    {
      "id": "disconnect-tracked-sockets",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { const list = Array.isArray(window.__bas_ws_instances) ? window.__bas_ws_instances : []; list.forEach((ws) => { if (ws && ws.readyState === 1) ws.close(1000, 'bas-test-disconnect'); }); document.body.setAttribute('data-bas-disconnected', 'true'); })()"
        },
        "metadata": {
          "label": "Close tracked websocket connections"
        }
      }
    },
    {"id":"wait-output-while-offline","action":{"type":"ACTION_TYPE_WAIT","wait":{"duration_ms":2600},"metadata":{"label":"Wait while disconnected"}}},
    {"id":"reload-workspace-to-reconnect","action":{"type":"ACTION_TYPE_EVALUATE","evaluate":{"expression":"(() => { window.location.reload(); })()"},"metadata":{"label":"Reload workspace"}}},
    {"id":"wait-workspace-after-reload","action":{"type":"ACTION_TYPE_WAIT","wait":{"selector":"@selector/workspace.newTerminalButton","state":"WAIT_STATE_VISIBLE","timeout_ms":20000},"metadata":{"label":"Wait for workspace after reload"}}},
    {
      "id": "evaluate-replay-after-reconnect",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(async () => { const sessionId = localStorage.getItem('bas.replay.sessionId') || ''; let paneSeen = false; let armed = false; let ok = false; const deadline = Date.now() + 10000; while (Date.now() < deadline) { const pane = sessionId ? document.querySelector(`[data-testid=\"terminal-pane\"][data-session-id=\"${sessionId}\"]`) : document.querySelector('[data-testid=\"terminal-pane\"][data-session-id]'); const text = pane ? (pane.textContent || '') : ''; if (pane) paneSeen = true; if (text.includes('basreplayarmed')) armed = true; if (text.includes('basreplayok')) { ok = true; break; } await new Promise((resolve) => setTimeout(resolve, 100)); } document.body.setAttribute('data-replay-pane-present', paneSeen ? 'true' : 'false'); document.body.setAttribute('data-replay-armed-after', armed ? 'true' : 'false'); document.body.setAttribute('data-replay-ok', ok ? 'true' : 'false'); })()"
        },
        "metadata": {
          "label": "Check replay markers after reconnect"
        }
      }
    },
    {"id":"assert-session-pane-restored","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"body[data-replay-pane-present='true']","mode":"ASSERTION_MODE_EXISTS","timeout_ms":5000,"failure_message":"Expected original terminal session pane after reconnect"},"metadata":{"label":"Verify pane restored"}}},
    {"id":"assert-replay-armed-seen","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"body[data-replay-armed-after='true']","mode":"ASSERTION_MODE_EXISTS","timeout_ms":5000,"failure_message":"Expected first marker after reconnect"},"metadata":{"label":"Verify first marker"}}},
    {"id":"assert-replay-success","action":{"type":"ACTION_TYPE_ASSERT","assert":{"selector":"body[data-replay-ok='true']","mode":"ASSERTION_MODE_EXISTS","timeout_ms":5000,"failure_message":"Expected delayed marker replay after reconnect"},"metadata":{"label":"Verify replay success"}}}
  ],
  "edges": [
    {"id":"e1","source":"open-workspace","target":"click-new-terminal","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e2","source":"click-new-terminal","target":"wait-launcher","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e3","source":"wait-launcher","target":"launch-empty-shell","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e4","source":"launch-empty-shell","target":"wait-terminal-pane","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e5","source":"wait-terminal-pane","target":"click-terminal-pane","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e6","source":"click-terminal-pane","target":"focus-xterm-textarea","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e7","source":"focus-xterm-textarea","target":"send-delayed-command","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e8","source":"send-delayed-command","target":"capture-session-before-disconnect","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e9","source":"capture-session-before-disconnect","target":"disconnect-tracked-sockets","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e10","source":"disconnect-tracked-sockets","target":"wait-output-while-offline","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e11","source":"wait-output-while-offline","target":"reload-workspace-to-reconnect","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e12","source":"reload-workspace-to-reconnect","target":"wait-workspace-after-reload","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e13","source":"wait-workspace-after-reload","target":"evaluate-replay-after-reconnect","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e14","source":"evaluate-replay-after-reconnect","target":"assert-session-pane-restored","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e15","source":"assert-session-pane-restored","target":"assert-replay-armed-seen","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"},
    {"id":"e16","source":"assert-replay-armed-seen","target":"assert-replay-success","type":"WORKFLOW_EDGE_TYPE_SMOOTHSTEP"}
  ]
}
