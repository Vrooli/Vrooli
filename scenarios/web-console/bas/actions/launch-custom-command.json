{
  "id": "a795f698-df2b-469a-be65-6c64d5749694",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "launch-custom-command",
  "folder_path": "/bas/actions",
  "description": "Open launcher and create a terminal session with a custom command",
  "tags": [
    "reset:none",
    "parameters_json:[{\"name\":\"command\",\"type\":\"string\",\"required\":true,\"description\":\"Shell command to execute immediately after session launch\"}]"
  ],
  "version": 1,
  "created_at": "2026-07-12T19:31:13.432049968Z",
  "updated_at": "2026-07-12T19:31:13.432049968Z",
  "flow_definition": {
    "settings": {},
    "nodes": [
      {
        "id": "click-new-terminal",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "[data-testid=\"new-terminal-button\"], [data-testid=\"toolbar-new\"]"
          },
          "metadata": {
            "label": "Open terminal launcher"
          }
        }
      },
      {
        "id": "ensure-launcher-open",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(async () => { const deadline = Date.now() + 10000; while (Date.now() < deadline) { if (document.querySelector('[data-testid=\"terminal-launcher\"]')) return; const button = document.querySelector('[data-testid=\"new-terminal-button\"], [data-testid=\"toolbar-new\"]'); if (button instanceof HTMLElement) button.click(); await new Promise((resolve) => setTimeout(resolve, 250)); } throw new Error('Terminal launcher did not appear'); })()"
          },
          "metadata": {
            "label": "Ensure launcher dialog is open"
          }
        }
      },
      {
        "id": "input-command",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/launcher.customInput",
            "value": "${@params/command}",
            "clear_first": true
          },
          "metadata": {
            "label": "Enter custom command"
          }
        }
      },
      {
        "id": "click-launch",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const launch = document.querySelector('[data-testid=\"launcher-custom-launch\"]'); if (!(launch instanceof HTMLButtonElement)) throw new Error('launcher custom launch button not found'); launch.click(); })()"
          },
          "metadata": {
            "label": "Launch terminal session"
          }
        }
      },
      {
        "id": "wait-terminal-pane",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/terminal.pane",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for terminal pane mount"
          }
        },
        "execution_settings": {
          "wait_after_ms": 1000
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "click-new-terminal",
        "target": "ensure-launcher-open",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "ensure-launcher-open",
        "target": "input-command",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "input-command",
        "target": "click-launch",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "click-launch",
        "target": "wait-terminal-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}