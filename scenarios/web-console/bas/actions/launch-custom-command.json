{
  "id": "a795f698-df2b-469a-be65-6c64d5749694",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "launch-custom-command",
  "folder_path": "/bas/actions",
  "description": "Open launcher and create a terminal session with a custom command",
  "metadata": {
    "name": "launch-custom-command",
    "description": "Open launcher and create a terminal session with a custom command",
    "execution_mode": "mutating",
    "reset": "none",
    "labels": {
      "reset": "none",
      "requires_confirmation": "true",
      "routed_isolation": "true"
    }
  },
  "tags": [
    "reset:none",
    "parameters_json:[{\"name\":\"command\",\"type\":\"string\",\"required\":true,\"description\":\"Shell command to execute immediately after session launch\"}]"
  ],
  "version": 1,
  "created_at": "2026-07-12T19:31:13.432049968Z",
  "updated_at": "2026-07-12T19:31:13.432049968Z",
  "flow_definition": {
    "settings": {},
    "nodes": [
      {
        "id": "click-new-terminal",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/launcher.open"
          },
          "metadata": {
            "label": "Open terminal launcher"
          }
        }
      },
      {
        "id": "ensure-launcher-open",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/launcher.dialog",
            "state": "WAIT_STATE_VISIBLE",
            "timeout_ms": 10000
          },
          "metadata": {
            "label": "Wait for terminal launcher dialog"
          }
        }
      },
      {
        "id": "choose-shell-input-command",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/launcher.modeShell"
          },
          "metadata": {
            "label": "Choose the Shell session type"
          }
        }
      },
      {
        "id": "input-command",
        "action": {
          "type": "ACTION_TYPE_INPUT",
          "input": {
            "selector": "@selector/launcher.customInput",
            "value": "${@params/command}",
            "clear_first": true
          },
          "metadata": {
            "label": "Enter custom command"
          }
        }
      },
      {
        "id": "click-launch",
        "action": {
          "type": "ACTION_TYPE_CLICK",
          "click": {
            "selector": "@selector/launcher.launch"
          },
          "metadata": {
            "label": "Launch terminal session"
          }
        }
      },
      {
        "id": "wait-terminal-pane",
        "action": {
          "type": "ACTION_TYPE_WAIT",
          "wait": {
            "selector": "@selector/terminal.visiblePane",
            "state": "WAIT_STATE_UNSPECIFIED",
            "timeout_ms": 15000
          },
          "metadata": {
            "label": "Wait for terminal pane mount"
          }
        },
        "execution_settings": {
          "wait_after_ms": 1000
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "click-new-terminal",
        "target": "ensure-launcher-open",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "ensure-launcher-open",
        "target": "choose-shell-input-command",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "input-command",
        "target": "click-launch",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "click-launch",
        "target": "wait-terminal-pane",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e-choose-shell-input-command",
        "source": "choose-shell-input-command",
        "target": "input-command",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}
