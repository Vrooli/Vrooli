{
  "id": "ee011dd5-f45f-4b6b-a9f3-b8b4924cc1a9",
  "project_id": "0c037e4d-dd01-4c3b-a23b-0e6a9e3ac9ff",
  "name": "terminal-command-smoke",
  "folder_path": "/bas/flows",
  "description": "Open workspace and run a command in a newly launched terminal",
  "metadata": {
    "name": "terminal-command-smoke",
    "description": "Open workspace and run a command in a newly launched terminal",
    "execution_mode": "mutating",
    "reset": "full",
    "labels": {
      "reset": "full",
      "requires_confirmation": "true",
      "routed_isolation": "true",
      "seed": "seed"
    }
  },
  "tags": [
    "parameters_json:[{\"name\":\"command\",\"type\":\"string\",\"required\":true,\"description\":\"Command to execute in the launched terminal\"}]",
    "reset:none"
  ],
  "version": 1,
  "created_at": "2026-07-12T19:31:13.443204767Z",
  "updated_at": "2026-07-12T19:31:13.443204767Z",
  "flow_definition": {
    "settings": {},
    "nodes": [
      {
        "id": "open-workspace",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/open-workspace.json"
          },
          "metadata": {
            "label": "Open workspace"
          }
        }
      },
      {
        "id": "reset-sessions",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/capture-session-baseline.json"
          },
          "metadata": {
            "label": "Capture session baseline"
          }
        }
      },
      {
        "id": "capture-baseline-session-ids",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const ids = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane\"][data-session-id]')).map((pane) => pane.getAttribute('data-session-id') || '').filter(Boolean); localStorage.setItem('bas.terminalSmoke.baselineSessionIds', JSON.stringify(ids)); })()"
          },
          "metadata": {
            "label": "Capture baseline session IDs"
          }
        }
      },
      {
        "id": "launch-command",
        "action": {
          "type": "ACTION_TYPE_SUBFLOW",
          "subflow": {
            "workflow_path": "actions/launch-custom-command.json",
            "args": {
              "command": {
                "string_value": "${@params/command}"
              }
            }
          },
          "metadata": {
            "label": "Launch custom command"
          }
        }
      },
      {
        "id": "capture-launched-session-id",
        "action": {
          "type": "ACTION_TYPE_EVALUATE",
          "evaluate": {
            "expression": "(() => { const baseline = new Set(JSON.parse(localStorage.getItem('bas.terminalSmoke.baselineSessionIds') || '[]')); const ids = Array.from(document.querySelectorAll('[data-testid=\"terminal-pane\"][data-session-id]')).map((pane) => pane.getAttribute('data-session-id') || '').filter(Boolean); const created = ids.filter((id) => !baseline.has(id)); const selected = created[created.length - 1] || ''; if (selected) { localStorage.setItem('bas.terminalSmoke.sessionId', selected); document.body.setAttribute('data-terminal-smoke-session-id-captured', 'true'); return; } localStorage.removeItem('bas.terminalSmoke.sessionId'); document.body.setAttribute('data-terminal-smoke-session-id-captured', 'false'); })()"
          },
          "metadata": {
            "label": "Capture launched session ID"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "open-workspace",
        "target": "reset-sessions",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e2",
        "source": "reset-sessions",
        "target": "capture-baseline-session-ids",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e3",
        "source": "capture-baseline-session-ids",
        "target": "launch-command",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      },
      {
        "id": "e4",
        "source": "launch-command",
        "target": "capture-launched-session-id",
        "type": "WORKFLOW_EDGE_TYPE_DEFAULT"
      }
    ]
  }
}