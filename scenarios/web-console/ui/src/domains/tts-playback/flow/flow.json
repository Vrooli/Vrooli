  "invariants": [
    { "id": "type_ok", "quint": "TypeOK", "description": "Model variables remain inside declared state and event sets." },
    { "id": "illegal_transitions_preserve_state", "quint": "IllegalTransitionsPreserveState", "description": "Rejected transitions are state preserving." },
    {
      "id": "paused_swallows_auto_advance",
      "quint": "PausedSwallowsAutoAdvance",
      "description": "When paused, TrackEnded does not advance to idle and therefore cannot trigger queue auto-advance.",
      "expression": "status != Paused or nextStatus(status, TrackEnded) == Paused"
    },
    {
      "id": "stale_completion_is_ignored",
      "quint": "StaleCompletionIsIgnored",
      "description": "LoadResolved, LoadFailed, TrackStarted, and TrackEnded are status-preserving outside the state where they are expected, so stale provider callbacks cannot corrupt transport state.",
      "expression": "(status == Loading or nextStatus(status, LoadResolved) == status) and (status == Loading or nextStatus(status, LoadFailed) == status) and (status == Playing or status == Loading or nextStatus(status, TrackStarted) == status) and (status == Playing or nextStatus(status, TrackEnded) == status)"
    }
  ],
