  "model": {
    "module": "PlaybackTransportWorkflow",
    "seed": "2026051301",
    "maxSteps": 8,
    "traceCount": 16,
    "verify": {
      "invariants": [
        "TypeOK",
        "IllegalTransitionsPreserveState",
        "PausedSwallowsAutoAdvance",
        "StaleCompletionIsIgnored"
      ]
    }
  },
  "states": [
    { "id": "idle", "quint": "Idle", "initial": true },
    { "id": "loading", "quint": "Loading" },
    { "id": "playing", "quint": "Playing" },
    { "id": "paused", "quint": "Paused" },
    { "id": "error", "quint": "Errored" }
  ],
  "events": [
    { "id": "play", "quint": "Play" },
    { "id": "loadResolved", "quint": "LoadResolved" },
    { "id": "loadFailed", "quint": "LoadFailed" },
    { "id": "trackStarted", "quint": "TrackStarted" },
    { "id": "trackEnded", "quint": "TrackEnded" },
    { "id": "pause", "quint": "Pause" },
    { "id": "resume", "quint": "Resume" },
    { "id": "stop", "quint": "Stop" },
    { "id": "playbackError", "quint": "PlaybackError" }
  ],
  "transitionDefaults": {
    "invalid": { "to": "self", "wantError": false }
  },
  "transitions": [
