    { "from": "paused", "event": "resume", "to": "playing" },
    { "from": "paused", "event": "stop", "to": "idle" },
    { "from": "paused", "event": "playbackError", "to": "error" },
    { "from": "error", "event": "stop", "to": "idle" },
    { "from": "error", "event": "loadResolved", "to": "error" },
    { "from": "error", "event": "loadFailed", "to": "error" },
