{
  "$schema": "../../../.vrooli/schemas/cli-manifest.schema.json",
  "name": "web-console",
  "description": "Web Console CLI surface. Single source of truth for the proto-bound domains (ai, capabilities, conversation, events, metrics, session, settings, shortcuts, target, workspace): schema-validated against cli-manifest/v1 and cross-validated against the Connect-RPC service descriptors at gen-endpoints time. Loaded by each domain's Register via cliapp.LoadFromManifest. The audio_admin, audio_runtime, and terminal Connect services have no CLI command today and are declared in omitted[].",
  "groups": [
    {
      "name": "ai",
      "description": "AI command generation, suggestions, provider config, and health",
      "commands": [
        {
          "name": "generate",
          "description": "Generate a shell command (--body-file PATH)",
          "flags": [
            {
              "name": "body-file",
              "description": "Path to a JSON request body (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AIService",
            "method": "Generate"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "suggest",
          "description": "Get AI suggestions (--body-file PATH)",
          "flags": [
            {
              "name": "body-file",
              "description": "Path to a JSON request body (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AIService",
            "method": "Suggest"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "config-get",
          "description": "Show AI provider config",
          "binding": {
            "kind": "connect-rpc",
            "service": "AIService",
            "method": "GetConfig"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "config-set",
          "description": "Update AI provider config (--body-file PATH)",
          "flags": [
            {
              "name": "body-file",
              "description": "Path to JSON body with provider config (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "AIService",
            "method": "UpdateConfig"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "health",
          "description": "Check configured AI providers",
          "binding": {
            "kind": "connect-rpc",
            "service": "AIService",
            "method": "GetHealth"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "capabilities",
      "description": "Inspect runtime capabilities (use --liveness for a cheap probe)",
      "commands": [
        {
          "name": "capabilities",
          "description": "Inspect runtime capabilities (use --liveness for a cheap probe)",
          "flags": [
            {
              "name": "liveness",
              "bool": true,
              "description": "Use the cheap liveness probe instead of the full snapshot",
              "local_only": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "CapabilitiesService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "conversation",
      "description": "Conversation history, cursors, summarization, and file references",
      "commands": [
        {
          "name": "get",
          "description": "Get a session's conversation history",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)",
              "bind": {
                "field": "session_id"
              }
            },
            {
              "name": "since",
              "description": "Only return events with sequence > since",
              "bind": {
                "field": "since_sequence"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "cursor-set",
          "description": "Update a session's read/listened cursor (--body-file PATH)",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)"
            },
            {
              "name": "body-file",
              "description": "Path to JSON body with cursor fields (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationService",
            "method": "UpdateCursor"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "summarize",
          "description": "Summarize one assistant event for TTS",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)"
            },
            {
              "name": "event",
              "required": true,
              "description": "Event ID (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ConversationService",
            "method": "SummarizeEvent"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "file-preview",
      "description": "Resolve local file references into preview targets, read bounded text content, and list directories",
      "commands": [
        {
          "name": "resolve",
          "description": "Resolve a path into a preview target (kind, mime, size, preview id, blob url)",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)",
              "bind": {
                "field": "session_id"
              }
            },
            {
              "name": "path",
              "required": true,
              "description": "Path to resolve (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FilePreviewService",
            "method": "Resolve"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "text",
          "description": "Read bounded UTF-8 text content for a resolved preview id",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)",
              "bind": {
                "field": "session_id"
              }
            },
            {
              "name": "preview-id",
              "required": true,
              "description": "Preview id from file-preview resolve (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FilePreviewService",
            "method": "GetTextContent"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "ls",
          "description": "List one page of a resolved directory preview id",
          "flags": [
            {
              "name": "session",
              "required": true,
              "description": "Session ID (required)",
              "bind": {
                "field": "session_id"
              }
            },
            {
              "name": "preview-id",
              "required": true,
              "description": "Directory preview id from file-preview resolve (required)"
            },
            {
              "name": "sort",
              "required": false,
              "description": "Ordering: dirs_first_name (default), name, size_desc, mtime_desc"
            },
            {
              "name": "show-hidden",
              "bool": true,
              "required": false,
              "description": "Include dot-prefixed entries"
            },
            {
              "name": "page-size",
              "required": false,
              "description": "Entries per page (default 200, max 1000)"
            },
            {
              "name": "page-token",
              "required": false,
              "description": "Continuation token from a previous page"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "FilePreviewService",
            "method": "ListDirectory"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "events",
      "description": "Show recent lifecycle events from the in-memory ring buffer",
      "commands": [
        {
          "name": "events",
          "description": "Show recent lifecycle events from the in-memory ring buffer",
          "flags": [
            {
              "name": "limit",
              "default": "50",
              "description": "Maximum events to return (max 1000)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "EventsService",
            "method": "List"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "metrics",
      "description": "Show runtime metrics (active sessions, totals, TTS/voice counters)",
      "commands": [
        {
          "name": "metrics",
          "description": "Show runtime metrics (active sessions, totals, TTS/voice counters)",
          "binding": {
            "kind": "connect-rpc",
            "service": "MetricsService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "target",
      "description": "Inspect local and remote terminal locations",
      "commands": [
        {
          "name": "list",
          "description": "List terminal locations and readiness state",
          "binding": {
            "kind": "connect-rpc",
            "service": "TargetCatalogService",
            "method": "List"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "get",
          "description": "Show one terminal location",
          "positionals": [
            {
              "name": "target-id",
              "required": true,
              "description": "Target catalog ID",
              "bind": {"field": "id"}
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "TargetCatalogService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "doctor",
          "description": "Explain target readiness and recovery action",
          "positionals": [
            {
              "name": "target-id",
              "required": true,
              "description": "Target catalog ID",
              "bind": {"field": "id"}
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "TargetCatalogService",
            "method": "Doctor"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "terminal",
      "description": "Read and drive terminal sessions through the structured terminal service",
      "commands": [
        {
          "name": "screen",
          "description": "Print the decoded screen of a session",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID",
              "bind": {"field": "session_id"}
            }
          ],
          "flags": [
            {
              "name": "include-scrollback",
              "bool": true,
              "description": "Include scrollback lines in the plain-text rendering",
              "local_only": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "TerminalService",
            "method": "GetScreen"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "send-text",
          "description": "Send literal text to a session",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID",
              "bind": {"field": "session_id"}
            },
            {
              "name": "text",
              "required": true,
              "repeated": true,
              "description": "Text words to join and send",
              "local_only": true
            }
          ],
          "flags": [
            {
              "name": "paste",
              "bool": true,
              "description": "Deliver as bracketed paste",
              "local_only": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "TerminalService",
            "method": "SendInput"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": ["network:internal"]
          }
        },
        {
          "name": "wait-idle",
          "description": "Block until a session is idle",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID",
              "bind": {"field": "session_id"}
            }
          ],
          "flags": [
            {
              "name": "quiet-window",
              "description": "Quiet duration before the session counts as idle",
              "local_only": true
            },
            {
              "name": "timeout",
              "description": "Maximum total wait duration",
              "local_only": true
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "TerminalService",
            "method": "WaitIdle"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": ["network:internal"]
          }
        }
      ]
    },
    {
      "name": "session",
      "description": "Manage PTY terminal sessions",
      "commands": [
        {
          "name": "list",
          "description": "List active sessions",
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "List"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "get",
          "description": "Show one session",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID",
              "bind": {
                "field": "id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "Get"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "create",
          "description": "Create a session (optionally --body-file PATH)",
          "flags": [
            {
              "name": "shell",
              "description": "Shell to run (default: user shell)"
            },
            {
              "name": "cols",
              "description": "Initial columns"
            },
            {
              "name": "rows",
              "description": "Initial rows"
            },
            {
              "name": "backend",
              "description": "Backend id (e.g. pty, tmux)"
            },
            {
              "name": "origin",
              "description": "Provenance: ui|programmatic|remote (default: programmatic)"
            },
            {
              "name": "owner",
              "description": "Free-form provenance tag, e.g. agent-manager"
            },
            {
              "name": "label",
              "description": "Human-facing label for the sidebar"
            },
            {
              "name": "target",
              "description": "Target catalog ID (local by default; use `target list` to discover remote nodes)"
            },
            {
              "name": "working-dir",
              "description": "Working directory on the selected target"
            },
            {
              "name": "launch-command",
              "description": "Command staged (or executed) in the new session"
            },
            {
              "name": "execute-launch-command",
              "bool": true,
              "description": "Run the launch command immediately instead of only staging it"
            },
            {
              "name": "idempotency-key",
              "description": "Stable retry key for replay-safe session creation"
            },
            {
              "name": "body-file",
              "description": "Path to a JSON body (overrides individual flags)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "Create"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "delete",
          "description": "Terminate a session",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "Delete"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "policy-get",
          "description": "Show the expiration policy for a session",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID",
              "bind": {
                "field": "id"
              }
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "GetPolicy"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "policy-set",
          "description": "Set the expiration policy (--mode, optional --duration)",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID"
            }
          ],
          "flags": [
            {
              "name": "mode",
              "description": "Policy mode (required)"
            },
            {
              "name": "duration",
              "description": "Optional duration (e.g. 1h, 30m)"
            },
            {
              "name": "body-file",
              "description": "Path to a JSON body (overrides --mode/--duration)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "UpdatePolicy"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list-recoverable",
          "description": "List orphaned persistent sessions awaiting recovery",
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "ListRecoverable"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "recover",
          "description": "Recover an orphaned persistent session into a fresh pane",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "Recover"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "dismiss",
          "description": "Permanently dismiss an orphaned session row (preserves on-disk state)",
          "positionals": [
            {
              "name": "session-id",
              "required": true,
              "description": "Session ID"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "DismissRecoverable"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "archive-retention",
          "description": "Show archive retention policy and measured storage",
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "GetArchiveRetention"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "archive-prune",
          "description": "Preview archive retention; pass --apply to perform the reported actions",
          "flags": [
            {
              "name": "apply",
              "bool": true,
              "description": "Apply the reported prune actions (default is dry-run)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SessionsService",
            "method": "PruneArchive"
          },
          "governance": {
            "effect": "destructive",
            "run_eligible": false,
            "permissions": [
              "network:internal",
              "filesystem:write"
            ],
            "requires_confirmation": true
          }
        }
      ]
    },
    {
      "name": "settings",
      "description": "Inspect and update web-console settings",
      "commands": [
        {
          "name": "session-defaults-get",
          "description": "Show default values applied to new sessions",
          "binding": {
            "kind": "connect-rpc",
            "service": "SettingsService",
            "method": "GetSessionDefaults"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "session-defaults-set",
          "description": "Update default session settings (--body-file PATH)",
          "flags": [
            {
              "name": "body-file",
              "description": "Path to a JSON body with session defaults (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "SettingsService",
            "method": "UpdateSessionDefaults"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        }
      ]
    },
    {
      "name": "shortcuts",
      "description": "Inspect and manage shortcut profiles",
      "commands": [
        {
          "name": "effective",
          "description": "Show the effective shortcut list",
          "binding": {
            "kind": "connect-rpc",
            "service": "ShortcutsService",
            "method": "GetEffective"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "list",
          "description": "List all shortcut profiles",
          "binding": {
            "kind": "connect-rpc",
            "service": "ShortcutsService",
            "method": "ListProfiles"
          },
          "governance": {
            "effect": "read",
            "run_eligible": true,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "upsert",
          "description": "Create or update a shortcut profile (--body-file PATH)",
          "flags": [
            {
              "name": "body-file",
              "description": "Path to a JSON profile body (required)"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ShortcutsService",
            "method": "UpsertProfile"
          },
          "governance": {
            "effect": "write",
            "run_eligible": false,
            "permissions": [
              "network:internal"
            ]
          }
        },
        {
          "name": "delete",
          "description": "Delete a shortcut profile",
          "positionals": [
            {
              "name": "profile-id",
              "required": true,
              "description": "Profile ID"
            }
          ],
          "binding": {
            "kind": "connect-rpc",
            "service": "ShortcutsService",
            "method": "DeleteProfile"
          },
          "governance": {
