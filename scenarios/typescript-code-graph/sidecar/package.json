{
  "name": "@vrooli/typescript-code-graph-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Node sidecar hosting ts-morph for the typescript-code-graph scenario API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "esbuild": "0.24.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
