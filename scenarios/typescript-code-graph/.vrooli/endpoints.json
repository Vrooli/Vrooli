{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.typescript_code_graph.v1.health.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.typescript_code_graph.v1.errors.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "graph_extract",
      "path": "/vrooli.typescript_code_graph.v1.graph.TypeScriptCodeGraphService/Extract",
      "method": "POST",
      "summary": "Extract a deterministic TypeScript graph",
      "description": "Loads the TypeScript project selected by project_path via the Node sidecar (ts-morph) and returns the normalized graph + warnings + extraction time + graph hash. Declaration nodes carry their leading_comments[] verbatim — REQ-P0-003.",
      "category": "graph",
      "request": {
        "type": "object",
        "properties": {
          "project_path": "string (required, absolute path to the project root or tsconfig.json)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "extraction_ms": "int64",
          "graph": "common.v1.CodeGraph",
          "graph_hash": "string (hex sha256 of canonical graph)",
          "sidecar_request_id": "string (uuid of the originating sidecar IPC request)",
          "warnings": "array<common.v1.CodeGraphWarning>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or non-absolute project_path; no/multiple tsconfig.json"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "project_path unreadable"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "pnpm/yarn workspaces are not supported in v1"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Node sidecar is unhealthy or permanently failed"
        },
        {
          "status": 504,
          "code": "deadline_exceeded",
          "description": "Sidecar call exceeded its deadline"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Unexpected sidecar or normalization failure"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph graph extract",
        "args": [
          "<path>"
        ]
      }
    },
    {
      "id": "graph_list_fixtures",
      "path": "/vrooli.typescript_code_graph.v1.graph.TypeScriptCodeGraphService/ListFixtures",
      "method": "POST",
      "summary": "List golden determinism fixtures",
      "description": "Enumerates the fixture directories under bas/fixtures so the Fixture Validator UI can offer them without reading repo files in the browser.",
      "category": "graph",
      "response": {
        "type": "object",
        "properties": {
          "fixtures": "array<{name:string, path:string, has_expected:bool}>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Fixtures directory unreadable"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph graph list-fixtures"
      }
    },
    {
      "id": "graph_validate_fixture",
      "path": "/vrooli.typescript_code_graph.v1.graph.TypeScriptCodeGraphService/ValidateFixture",
      "method": "POST",
      "summary": "Validate a fixture against its golden graph",
      "description": "Re-runs Extract against a named fixture server-side (through the sidecar) and byte-compares the canonical JSON against expected-graph.json, returning pass/fail plus a line diff.",
      "category": "graph",
      "request": {
        "type": "object",
        "properties": {
          "name": "string (required, fixture directory name)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "actual_bytes": "int64",
          "diff": "string (line diff; empty on pass)",
          "expected_bytes": "int64",
          "graph_hash": "string (hex sha256 of canonical graph)",
          "passed": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing or path-escaping fixture name"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Fixture not found"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Fixture has no expected-graph.json baseline"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Extraction or comparison failure"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph graph validate-fixture",
        "args": [
          "<name>"
        ]
      }
    },
    {
      "id": "rewrite_plan",
      "path": "/vrooli.typescript_code_graph.v1.graph.TypeScriptCodeGraphService/RewritePlan",
      "method": "POST",
      "summary": "Plan a TypeScript rewrite",
      "description": "Validates and normalizes a list of FileMove / ImportRewrite operations and returns a deterministic plan_id. Identical normalized inputs produce identical plan_ids; the (project_path, plan_id) composite scopes plans per project.",
      "category": "rewrite",
      "request": {
        "type": "object",
        "properties": {
          "operations": "array<rewrite.v1.Operation> (>=1; each must set exactly one of file_move / import_rewrite)",
          "project_path": "string (required, absolute path to project root or tsconfig.json)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "normalized_operations": "array<rewrite.v1.Operation>",
          "plan_id": "string (sha256-hex of normalized operations)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing project_path, empty operations, absolute/parent path, or both/neither oneof arm set"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Plan store save failed"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph rewrite plan",
        "args": [
          "<ops.json>"
        ]
      }
    },
    {
      "id": "rewrite_apply",
      "path": "/vrooli.typescript_code_graph.v1.graph.TypeScriptCodeGraphService/RewriteApply",
      "method": "POST",
      "summary": "Apply a TypeScript rewrite plan",
      "description": "Executes the operations recorded under plan_id against the project at project_path. The apply flag must be true; X-Dry-Run: true header short-circuits before the sidecar call and returns synthetic OK results.",
      "category": "rewrite",
      "request": {
        "type": "object",
        "properties": {
          "apply": "bool (must be true; false is rejected with InvalidArgument)",
          "plan_id": "string (required, returned by RewritePlan)",
          "project_path": "string (required, absolute path; must match the planned project)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "dry_run": "bool (true when the request rode in with X-Dry-Run: true)",
          "plan_id": "string",
          "results": "array<rewrite.v1.OperationResult> (1:1 with normalized operations)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing project_path / plan_id, or apply=false"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Plan not found for this project (mismatched project_path or unknown plan_id)"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Node sidecar is unhealthy or permanently failed"
        },
        {
          "status": 504,
          "code": "deadline_exceeded",
          "description": "Sidecar call exceeded its deadline"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Unexpected sidecar or plan store failure"
        }
      ],
      "cli_mapping": {
        "command": "typescript-code-graph rewrite apply",
        "args": [
          "<plan_id>"
        ]
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "graph extract",
      "description": "Extract a deterministic TypeScript graph for the project at <path>.",
      "endpoint_id": "graph_extract"
    },
    {
      "name": "graph list-fixtures",
      "description": "List the golden determinism fixtures shipped with the scenario.",
      "endpoint_id": "graph_list_fixtures"
    },
    {
      "name": "graph validate-fixture",
      "description": "Re-extract a fixture and byte-compare against its expected-graph.json.",
      "endpoint_id": "graph_validate_fixture"
    },
    {
      "name": "rewrite plan",
      "description": "Plan a TypeScript rewrite from <ops.json>.",
      "endpoint_id": "rewrite_plan"
    },
    {
      "name": "rewrite apply",
      "description": "Apply the rewrite plan identified by <plan_id>.",
      "endpoint_id": "rewrite_apply"
    }
  ]
}
