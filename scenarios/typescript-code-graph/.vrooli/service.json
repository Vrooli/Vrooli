        "setup"
      ],
      "notes": "Honours pnpm-lock.yaml via --frozen-lockfile for reproducible builds."
    }
  ],
  "ports": {
    "api": {
      "env_var": "API_PORT",
      "description": "Go API server",
      "range": "15000-19999"
