{
  "metadata": {
    "name": "token-resolution-broken",
    "description": "CALIBRATION: plants a surface with a required custom property resolving to the initial value.",
    "requirement": "OVERLAY-COMPOSITION",
    "version": "1",
    "labels": {
      "reset": "none",
      "surface": "overlay-composition-calibration",
      "calibration": "expected-failure",
      "assertion_class": "token-resolution-broken",
      "requirements_json": "[\"OVERLAY-COMPOSITION\"]"
    },
    "execution_mode": "EXECUTION_MODE_OBSERVER"
  },
  "settings": {
    "viewport_width": 390,
    "viewport_height": 844
  },
  "nodes": [
    {
      "id": "navigate",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "react-component-library",
          "scenario_path": "/",
          "wait_until": "NAVIGATE_WAIT_EVENT_DOMCONTENTLOADED",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Open calibration host"
        }
      }
    },
    {
      "id": "plant-broken-fixture",
      "action": {
        "type": "ACTION_TYPE_EVALUATE",
        "evaluate": {
          "expression": "(() => { document.documentElement.style.removeProperty('--required-overlay-token'); document.body.innerHTML='<div id=\"surface\" style=\"background:var(--required-overlay-token)\">surface</div>'; const value=getComputedStyle(document.querySelector('#surface')).backgroundColor; document.body.dataset.calibrationOk=value&&value!=='rgba(0, 0, 0, 0)'?'yes':'no'; return {resolved:value||'initial'}; })()",
          "store_result": "plantedEvidence"
        },
        "metadata": {
          "label": "Plant the deliberately broken fixture"
        }
      }
    },
    {
      "id": "assert-calibration",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "body[data-calibration-ok=\"yes\"]",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 1000,
          "failure_message": "EXPECTED CALIBRATION FAILURE: the planted required overlay token resolves to an initial/transparent value."
        },
        "metadata": {
          "label": "Expected failure discriminator"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "navigate",
      "target": "plant-broken-fixture",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    },
    {
      "id": "e2",
      "source": "plant-broken-fixture",
      "target": "assert-calibration",
      "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP"
    }
  ]
}
