{
  "metadata": {
    "name": "component-harness-experience",
    "description": "Opens the standalone Button component harness and proves the real story renders at the top-level preview route.",
    "requirement": "PR-001",
    "version": "1",
    "labels": {
      "reset": "none",
      "surface": "component-harness",
      "spec_entry_id": "component-harness",
      "requirements_json": "[\"PR-001\"]"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "open-button-harness",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "react-component-library",
          "scenario_path": "/preview/react-component-library:Button/harness.html?story=primary&version=2.0.0",
          "wait_until": "NAVIGATE_WAIT_EVENT_DOMCONTENTLOADED",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open Button@2.0.0 standalone harness" }
      }
    },
    {
      "id": "wait-harness-lifecycle",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-experience-surface=\"component-harness\"][data-experience-state=\"loading\"], [data-experience-surface=\"component-harness\"][data-experience-state=\"ready\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Harness exposes its loading or ready lifecycle" }
      }
    },
    {
      "id": "wait-button-render",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-testid=\"component-harness-root\"][data-experience-surface=\"component-harness\"][data-experience-state=\"loading\"] button, [data-testid=\"component-harness-root\"][data-experience-surface=\"component-harness\"][data-experience-state=\"ready\"] button",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": { "label": "Wait for harness lifecycle or the real Button story" }
      }
    },
    {
      "id": "wait-harness-ready",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "[data-experience-surface=\"component-harness\"][data-experience-state=\"ready\"]",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 20000
        },
        "metadata": { "label": "Harness reaches ready after story checks" }
      }
    },
    {
      "id": "assert-harness-ready",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "[data-experience-surface=\"component-harness\"][data-experience-state=\"ready\"]",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 20000,
          "failure_message": "The component harness did not reach its ready lifecycle state."
        },
        "metadata": { "label": "Harness reports ready" }
      }
    },
    {
      "id": "assert-button-name",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/components.harness.root button",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 5000,
          "failure_message": "The standalone component harness did not render the real Button story."
        },
        "metadata": { "label": "Button story is visible" }
      }
    }
  ],
  "edges": [
    { "id": "edge-open-lifecycle", "source": "open-button-harness", "target": "wait-harness-lifecycle", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "edge-lifecycle-button", "source": "wait-harness-lifecycle", "target": "wait-button-render", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "edge-button-ready", "source": "wait-button-render", "target": "wait-harness-ready", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "edge-ready-assert", "source": "wait-harness-ready", "target": "assert-harness-ready", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "edge-assert-button", "source": "assert-harness-ready", "target": "assert-button-name", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
