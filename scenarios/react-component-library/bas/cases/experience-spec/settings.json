{
  "metadata": {
    "description": "Generated observer smoke for active experience page settings.",
    "execution_mode": "observer",
    "labels": {
      "reset": "none",
      "spec_entry_id": "settings",
      "surface": "experience-settings"
    },
    "name": "experience-settings-spec-smoke",
    "requirement": "OT-P0-005",
    "version": "1"
  },
  "nodes": [
    {
      "action": {
        "metadata": { "label": "Workspace preferences region asserted" },
        "assert": {
          "mode": "ASSERTION_MODE_VISIBLE",
          "selector": "[data-testid=\"settings-page\"]",
          "timeout_ms": 15000
        },
        "type": "ACTION_TYPE_ASSERT"
      },
      "id": "assert-workspace-preferences-region"
    },
    {
      "action": {
        "metadata": {
          "label": "Open Workspace preferences"
        },
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "react-component-library",
          "scenario_path": "/settings",
          "timeout_ms": 30000,
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE"
        },
        "type": "ACTION_TYPE_NAVIGATE"
      },
      "id": "navigate-settings"
    },
    {
      "action": {
        "metadata": {
          "label": "Primary binding visible"
        },
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/settings",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        }
      },
      "id": "wait-settings-primary-binding"
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-settings", "target": "wait-settings-primary-binding" },
    { "id": "e2", "source": "wait-settings-primary-binding", "target": "assert-workspace-preferences-region" }
  ],
  "settings": {
    "viewport_height": 800,
    "viewport_width": 1280
  }
}
