{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "bounded-meter",
    "title": "BoundedMeter",
    "purpose": "Share one bounded-value surface across score, measurement, and budget views.",
    "storyRef": "../../library/components/BoundedMeter/versions/1.0.9/story.json"
  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "A bounded value and its label are visible."
    },
    {
      "id": "warning",
      "example": "default",
      "description": "A threshold-adjacent value remains explicit without color."
    }
  ],
  "elements": [
    {
      "id": "surface",
      "role": "region",
      "description": "The bounded metric surface."
    }
  ],
  "claims": [
    { "id": "review-readable-context", "type": "manual-review", "statement": "A reviewer confirms the metric remains understandable with its surrounding context.", "tier": "manual", "states": ["default", "warning"] },
    {
      "id": "surface-present",
      "type": "element-present",
      "statement": "The bounded metric surface is present in every state.",
      "tier": "machine",
      "elements": ["surface"],
      "states": ["default", "warning"]
    }
  ],
  "bindings": { "elements": { "surface": { "selector": "[data-rcl-bounded-meter]" } } }
}
