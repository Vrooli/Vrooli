{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "bottom-nav",
    "title": "BottomNav",
    "purpose": "Present compact primary navigation with current-page semantics, stable item geometry, and safe-area support.",
    "storyRef": "../../library/components/BottomNav/versions/1.3.0/story.json"
  },
  "states": [
    { "id": "mobile-primary", "example": "mobile-primary", "description": "Primary compact navigation." },
    { "id": "disabled-item", "example": "disabled-item", "description": "Navigation with an unavailable item." },
    { "id": "long-labels", "example": "long-labels", "description": "Navigation with labels that need careful fitting." }
  ],
  "elements": [
    { "id": "navigation", "role": "navigation", "description": "The compact navigation landmark." },
    { "id": "item", "role": "link", "description": "A navigation destination." }
  ],
  "claims": [
    {
      "id": "active-indicator",
      "type": "custom",
      "statement": "The active destination is communicated through semantic current-page state and a motion-safe indicator.",
      "tier": "manual",
      "elements": ["navigation", "item"],
      "states": ["mobile-primary"]
    },
    {
      "id": "viewport-stable",
      "type": "custom",
      "statement": "Item geometry and safe-area treatment remain stable across compact viewport widths.",
      "tier": "manual",
      "elements": ["navigation"],
      "states": ["mobile-primary", "long-labels"]
    }
  ],
  "bindings": {
    "elements": {
      "navigation": { "selector": "[data-rcl-bottom-nav]" },
      "item": { "selector": "[data-rcl-bottom-nav-item]" }
    }
  }
}
