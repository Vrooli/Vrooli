{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "asset-detail-shell",
    "title": "AssetDetailShell",
    "purpose": "Keep the primary asset task, supporting activity, actions, and metadata in a clear responsive hierarchy.",
    "storyRef": "../../library/components/AssetDetailShell/versions/1.1.0/story.json"
  },
  "states": [
    { "id": "ready-detail", "example": "ready-detail", "description": "The primary detail is usable." },
    { "id": "activity-partial", "example": "activity-partial", "description": "Supporting activity is incomplete without replacing the primary task." },
    { "id": "activity-loading", "example": "activity-loading", "description": "Activity is loading in its own region." },
    { "id": "activity-empty", "example": "activity-empty", "description": "Activity is empty while detail remains available." },
    { "id": "activity-error", "example": "activity-error", "description": "Activity reports an error without hiding the detail." }
  ],
  "elements": [
    { "id": "preview", "role": "region", "description": "The primary asset preview." },
    { "id": "metadata", "role": "complementary", "description": "Supporting asset metadata." },
    { "id": "activity", "role": "region", "description": "Supporting activity lifecycle region." }
  ],
  "claims": [
    {
      "id": "hierarchical-detail",
      "type": "custom",
      "statement": "Preview, actions, activity, and metadata remain distinct regions across desktop and mobile layouts.",
      "tier": "manual",
      "elements": ["preview", "metadata", "activity"],
      "states": ["ready-detail", "activity-partial", "activity-loading", "activity-empty", "activity-error"]
    },
    {
      "id": "responsive-detail",
      "type": "custom",
      "statement": "Metadata moves below the primary task at narrow widths without clipping long content.",
      "tier": "manual",
      "elements": ["metadata"],
      "states": ["ready-detail"]
    }
  ],
  "bindings": {
    "elements": {
      "preview": { "selector": "[data-rcl-asset-detail-preview]" },
      "metadata": { "selector": "[data-rcl-asset-detail-metadata]" },
      "activity": { "selector": ".rcl-asset-detail-activity" }
    }
  }
}
