{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "evidence-carousel",
    "title": "EvidenceCarousel",
    "purpose": "Keep machine evidence references visible and selectable in the testing surface.",
    "storyRef": "../../library/components/EvidenceCarousel/versions/1.0.14/story.json"
  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "Available and missing evidence differ by text."
    },
    {
      "id": "empty",
      "example": "default",
      "description": "No capture is explicit."
    }
  ],
  "elements": [
    {
      "id": "surface",
      "role": "region",
      "description": "The evidence reference surface."
    }
  ],
  "claims": [
    {
      "id": "surface-present",
      "type": "element-present",
      "statement": "The evidence surface is present in every state.",
      "tier": "machine",
      "elements": ["surface"],
      "states": ["default", "empty"]
    }
  ],
  "bindings": { "elements": { "surface": { "selector": "[data-rcl-asset]" } } }
}
