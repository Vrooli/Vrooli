{
  "$schema": "../../../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "app-shell",
    "title": "AppShell",
    "purpose": "A responsive application frame with named navigation, a skip link, and scroll-safe main content.",
    "storyRef": "../../library/components/AppShell/versions/1.0.0/story.json"
  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "The application frame is available."
    },
    {
      "id": "long-content",
      "example": "long-content",
      "description": "Long content stays inside the main region without forcing the shell wider than its viewport."
    }
  ],
  "elements": [
    {
      "id": "navigation",
      "role": "complementary",
      "description": "The named application navigation region."
    },
    {
      "id": "main",
      "role": "main",
      "description": "The scroll-safe routed content region."
    },
    {
      "id": "skip-link",
      "role": "link",
      "description": "The keyboard skip-navigation control."
    }
  ],
  "claims": [
    {
      "id": "landmarks",
      "type": "element-present",
      "statement": "The shell exposes complementary navigation and a named main region.",
      "tier": "machine",
      "elements": ["navigation", "main"],
      "states": ["default", "long-content"]
    },
    {
      "id": "skip-navigation",
      "type": "element-present",
      "statement": "Keyboard users can skip directly to the main region.",
      "tier": "machine",
      "elements": ["skip-link", "main"],
      "states": ["default", "long-content"]
    },
    {
      "id": "viewport-fill",
      "type": "viewport-fill",
      "statement": "The shell fills the captured viewport while its content columns remain min-width safe.",
      "tier": "machine",
      "states": ["default", "long-content"]
    },
    {
      "id": "chrome-pinned",
      "type": "chrome-pinned",
      "statement": "Navigation and header chrome remain inside the viewport while main content scrolls.",
      "tier": "machine",
      "states": ["default", "long-content"]
    },
    {
      "id": "single-line-chrome",
      "type": "single-line-chrome",
      "statement": "Shell chrome labels remain single-line controls at every captured viewport.",
      "tier": "machine",
      "states": ["default", "long-content"]
    }
  ],
  "bindings": {
    "elements": {
      "navigation": { "selector": "[role='complementary']" },
      "main": { "selector": "[role='main']" },
      "skip-link": { "selector": "[role='link']" }
    }
  }
}
