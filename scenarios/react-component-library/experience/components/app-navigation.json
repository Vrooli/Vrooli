  "contract": { "kind": "rcl-component-experience-contract", "schema": "scenario-experience-spec/v1", "provenance": "react-component-library:AppNavigation@1.0.0" },
  "component": { "id": "app-navigation", "title": "AppNavigation", "purpose": "One navigation model changes presentation with viewport while preserving its content and capability parity.", "storyRef": "../../library/components/AppNavigation/versions/1.0.0/story.json" },
  "states": [
    { "id": "desktop", "example": "desktop", "description": "Persistent sidebar presentation." },
