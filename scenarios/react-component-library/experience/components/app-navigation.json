  "elements": [
    { "id": "sidebar", "role": "complementary", "description": "Persistent desktop navigation." },
    { "id": "drawer", "role": "complementary", "description": "Constrained-viewport drawer navigation." },
    { "id": "bottom-navigation", "role": "navigation", "description": "Compact-viewport bottom navigation." }
