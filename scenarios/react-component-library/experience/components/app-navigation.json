{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "contract": {
    "kind": "rcl-component-experience-contract",
    "schema": "scenario-experience-spec/v1",
    "provenance": "react-component-library:AppNavigation@1.0.0"
  },
  "component": {
    "id": "app-navigation",
    "title": "AppNavigation",
    "purpose": "One navigation model changes presentation with viewport while preserving its content and capability parity.",
    "storyRef": "../../library/components/AppNavigation/versions/1.0.0/story.json"
  },
  "states": [
    {
      "id": "desktop",
      "example": "desktop",
      "description": "Persistent sidebar presentation."
    },
    {
      "id": "tablet",
      "example": "tablet",
      "description": "Drawer presentation for constrained workspaces."
    },
    {
      "id": "mobile",
      "example": "mobile",
      "description": "Bottom-navigation presentation for compact viewports."
    }
  ],
  "elements": [
    {
      "id": "navigation",
      "role": "navigation",
      "description": "The semantic navigation landmark in the current presentation."
    }
  ],
  "claims": [
    {
      "id": "navigation-present",
      "type": "element-present",
      "statement": "Each presentation exposes a semantic navigation landmark.",
      "tier": "machine",
      "elements": ["navigation"],
      "states": ["desktop", "tablet", "mobile"]
    },
    {
      "id": "responsive-presentation",
      "type": "custom",
      "statement": "The same navigation model changes presentation across desktop, tablet, and mobile without losing destinations.",
      "tier": "manual",
      "elements": ["navigation"],
      "states": ["desktop", "tablet", "mobile"]
    }
  ],
  "bindings": {
    "elements": {
      "navigation": { "selector": "navigation" }
    }
  }
}
