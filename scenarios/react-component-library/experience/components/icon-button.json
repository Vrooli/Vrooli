{
  "contract": {
    "kind": "rcl-component-experience-contract",
    "schema": "scenario-experience-spec/v1",
    "provenance": "react-component-library/IconButton@2.0.0"
  },
  "component": {
    "id": "icon-button",
    "title": "IconButton",
    "purpose": "Provide an icon-only action with an explicit accessible name and the shared control size contract."
  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "Named icon-only action."
    }
  ],
  "elements": [
    {
      "id": "control",
      "role": "button",
      "description": "The native icon button."
    }
  ],
  "claims": [
    {
      "id": "named-action",
      "type": "element-present",
      "statement": "The icon button exposes a named action.",
      "tier": "machine",
      "elements": ["control"],
      "states": ["default"]
    }
  ],
  "bindings": { "elements": { "control": { "selector": "button" } } }
