  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "Default specimen."
    },
    {
      "id": "composed-regions",
      "example": "composed-regions",
      "description": "Composed regions specimen."
    },
    {
      "id": "mobile-navigation",
      "example": "mobile-navigation",
      "description": "Mobile selection and Back specimen."
    },
    {
      "id": "detail-actions",
      "example": "detail-actions",
      "description": "Reply beside selected detail specimen."
    },
    {
      "id": "contextual-flows",
      "example": "contextual-flows",
