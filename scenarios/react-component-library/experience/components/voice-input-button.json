{
  "$schema": "../../../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "voice-input-button",
    "title": "VoiceInputButton",
    "purpose": "Provide a stable, accessible voice capture control across idle, recording, transcription, and recovery states.",
    "storyRef": "../../library/components/VoiceInputButton/versions/4.3.1/story.json"
  },
  "states": [
    { "id": "idle", "example": "idle", "description": "The control is ready to begin capture." },
    { "id": "recording", "example": "recording", "description": "The control communicates active recording." },
    { "id": "transcribing", "example": "transcribing", "description": "The captured input is being converted to text." },
    { "id": "error", "example": "recovering", "description": "Recovery is available when capture or transcription fails." }
  ],
  "elements": [
    { "id": "control", "role": "button", "description": "The voice capture action." }
  ],
  "claims": [
    {
      "id": "control-present",
      "type": "element-present",
      "statement": "Each voice lifecycle state exposes a named capture control.",
      "tier": "machine",
      "elements": ["control"],
      "states": ["idle", "recording", "transcribing", "error"]
    },
    {
      "id": "recovery-actionable",
      "type": "manual-review",
      "statement": "The error state explains recovery without relying on color alone.",
      "tier": "manual",
      "states": ["error"]
    }
  ],
  "bindings": {
    "elements": {
      "control": { "selector": "button" }
    }
  }
}
