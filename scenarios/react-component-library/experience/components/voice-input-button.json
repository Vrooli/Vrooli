{
  "$schema": "../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "voice-input-button",
    "title": "VoiceInputButton",
    "purpose": "Expose an accessible microphone control whose visual level, timeout, and always-on states communicate capture state.",
    "storyRef": "../../library/components/VoiceInputButton/versions/1.0.0/story.json",
    "prd_refs": ["OT-P0-008"]
  },
  "priorities": [{ "statement": "The control always communicates whether voice input can start, is preparing, is recording, or has failed." }],
  "states": [
    { "id": "idle", "example": "idle", "description": "Ready to start voice input." },
    { "id": "recording-low", "example": "recording-level-low", "description": "Recording with a low audio level." },
    { "id": "recording-high", "example": "recording-level-high", "description": "Recording with a high audio level." },
    { "id": "timeout", "example": "recording-timeout", "description": "Recording with visible timeout progress." },
    { "id": "always-on", "example": "recording-always-on", "description": "Always-on listening mode." },
    { "id": "error", "example": "error", "description": "Terminal connection error." }
  ],
  "elements": [{ "id": "voice-control", "role": "button", "description": "The accessible microphone control." }],
  "claims": [{
    "id": "voice-input-action",
    "type": "element-present",
    "statement": "The idle specimen exposes a named action to start voice input.",
    "tier": "machine",
    "elements": ["voice-control"],
    "states": ["idle"]
  }],
  "bindings": { "elements": { "voice-control": { "selector": "button" } } }
}
