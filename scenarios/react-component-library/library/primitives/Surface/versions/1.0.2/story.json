{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "flat",
        "kind": "enum",
        "label": "Elevation",
        "options": [
          "flat",
          "raised",
          "floating",
          "overlay"
        ],
        "path": "elevation"
      },
      {
        "default": "solid",
        "kind": "enum",
        "label": "Variant",
        "options": [
          "solid",
          "translucent"
        ],
        "path": "variant"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "elevation": "flat",
        "variant": "solid"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "SurfaceAnatomy"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Component specimen",
          "role": "region"
        }
      ],
      "id": "elevation-flat",
      "mode": "live",
      "name": "elevation flat",
      "role": "anatomy"
    },
    {
      "args": {
        "elevation": "raised",
        "variant": "solid"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "SurfaceElevationMatrix"
        }
      },
      "id": "elevation-raised",
      "mode": "live",
      "name": "elevation raised",
      "expect": [
        {
          "kind": "visible",
          "selector": "body"
        }
      ],
      "role": "axis",
      "axis": "elevation",
      "covers": {
        "elevation": [
          "flat",
          "raised",
          "floating",
          "overlay"
        ]
      }
    },
    {
      "args": {
        "elevation": "floating",
        "variant": "translucent"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "SurfaceVariantMatrix"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Translucent surface"
        }
      ],
      "id": "elevation-floating",
      "mode": "live",
      "name": "elevation floating",
      "role": "axis",
      "axis": "variant",
      "covers": {
        "variant": [
          "solid",
          "translucent"
        ]
      }
    }
  ],
  "title": "Surface"
}
