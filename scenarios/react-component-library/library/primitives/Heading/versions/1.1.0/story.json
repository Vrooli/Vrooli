          "display",
          "title",
          "heading",
          "body",
          "label",
          "caption",
          "code",
          "overline"
        ]
      },
      {
        "path": "level",
        "label": "Document level",
        "kind": "number",
        "default": 2,
        "minimum": 1,
        "maximum": 6
      }
