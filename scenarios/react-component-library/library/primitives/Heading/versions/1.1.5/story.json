      "expect": [
        {
          "kind": "role",
          "name": "Meaning and visual scale stay independent.",
          "role": "heading"
        },
        {
          "attribute": "data-heading-level",
          "kind": "attribute",
          "selector": "[data-heading-level]",
          "value": "3"
