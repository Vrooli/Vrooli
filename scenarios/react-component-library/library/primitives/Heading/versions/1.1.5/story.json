          "display",
          "title",
          "heading",
          "body",
          "label",
          "caption",
          "code",
          "overline"
        ],
        "path": "textStyle"
      },
      {
        "default": 2,
        "kind": "number",
        "label": "Document level",
        "maximum": 6,
        "minimum": 1,
        "path": "level"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
