      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Semantic heading",
      "role": "anatomy"
    },
    {
      "args": {
        "level": 1,
        "textStyle": "display"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
