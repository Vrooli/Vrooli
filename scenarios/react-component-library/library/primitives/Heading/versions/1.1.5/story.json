      "covers": {
        "textStyle": [
          "display",
          "title",
          "heading",
          "body",
          "label",
          "caption",
          "code",
          "overline"
        ]
      }
    },
    {
      "args": {
        "level": 3,
        "textStyle": "title"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "HeadingBoundary"
