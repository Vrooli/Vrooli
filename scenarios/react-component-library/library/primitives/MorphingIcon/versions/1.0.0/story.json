{
  "schemaVersion": 3,
  "kind": "component",
  "title": "MorphingIcon",
  "args": {
    "fields": [
      {
        "path": "icon",
        "label": "Current icon",
        "kind": "enum",
        "default": "check",
        "options": [
          "check",
          "close",
          "send",
          "arrowEnd"
        ]
      },
      {
        "path": "from",
        "label": "Starting icon",
        "kind": "enum",
        "default": "send",
        "options": [
          "check",
          "close",
          "send",
          "arrowEnd"
        ]
      },
      {
        "path": "strategy",
        "label": "Transition strategy",
        "kind": "enum",
        "default": "auto",
        "options": [
          "auto",
          "morph",
          "transform",
          "crossfade"
        ]
      },
      {
        "path": "label",
        "label": "Accessible label",
        "kind": "text",
        "default": "Sent"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "toggle",
      "name": "Interactive state change",
      "harness": "ToggleMorphingIcon",
      "args": {
        "icon": "send",
        "from": "send",
        "label": "Send"
      },
      "expect": [
        {
          "kind": "role",
          "role": "img",
          "name": "Sent"
        }
      ],
      "interactions": [
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Send message"
          }
        },
        {
          "kind": "waitFor",
          "text": "280"
        }
      ],
      "mode": "live"
    },
    {
      "id": "copy-button",
      "name": "Copy button success state",
      "harness": "CopyMorphingIcon",
      "args": {},
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Copy value"
        }
      ],
      "interactions": [
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Copy value"
          }
        },
        {
          "kind": "waitFor",
          "text": "Copied"
        }
      ],
      "mode": "live"
    }
  ]
}
