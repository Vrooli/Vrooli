{
  "contract": {
    "kind": "rcl-component-experience-contract",
    "schema": "scenario-experience-spec/v1",
    "provenance": "react-component-library:Progress@1.0.0"
  },
  "component": {
    "id": "primitives.progress",
    "title": "Progress",
    "purpose": "Communicates determinate and indeterminate work without layout shift or color-only status."
  },
  "states": [
    {
      "id": "default",
      "example": "determinate",
      "description": "A task with measurable completion."
    },
    {
      "id": "loading",
      "example": "indeterminate",
      "description": "A task whose completion time is unknown."
    },
    {
      "id": "success",
      "example": "success",
      "description": "A task completed successfully."
    },
    {
      "id": "request-error",
      "example": "error",
      "description": "A task paused with recoverable progress."
    }
  ],
  "claims": [
    {
      "id": "accessible-value",
      "type": "manual-review",
      "statement": "Determinate progress exposes an accessible numeric value and a stable label.",
      "tier": "manual",
      "states": ["default", "success", "request-error"]
    },
    {
      "id": "motion-policy",
      "type": "manual-review",
      "statement": "Indeterminate motion respects reduced-motion preference.",
      "tier": "manual",
      "states": ["loading"]
    },
    {
      "id": "stable-geometry",
      "type": "manual-review",
      "statement": "Changing progress state preserves the progress track dimensions.",
      "tier": "manual",
      "states": ["default", "loading", "success", "request-error"]
    }
  ]
}
