{
  "schemaVersion": 3,
  "kind": "component",
  "title": "Avatar",
  "args": {
    "fields": [
      {
        "path": "name",
        "label": "Name",
        "kind": "text",
        "required": true,
        "default": "Maya Chen",
        "minLength": 1,
        "format": "plain-text"
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "enum",
        "default": "lg",
        "options": ["xs", "sm", "md", "lg", "xl"]
      },
      {
        "path": "shape",
        "label": "Shape",
        "kind": "enum",
        "default": "circle",
        "options": ["circle", "rounded", "square"]
      },
      {
        "path": "presence",
        "label": "Presence",
        "kind": "enum",
        "default": "online",
        "options": ["online", "away", "busy", "offline"]
      },
      {
        "path": "presenceLabel",
        "label": "Presence label",
        "kind": "text",
        "format": "plain-text"
      },
      {
        "path": "imageState",
        "label": "Image state",
        "kind": "enum",
        "default": "loaded",
        "options": ["loading", "loaded", "error"]
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "default",
      "name": "Named identity",
      "description": "A named person with an image, accessible presence, and a calm status treatment.",
      "harness": "Default",
      "args": {
        "name": "Maya Chen",
        "size": "lg",
        "shape": "circle",
        "presence": "online",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Maya Chen" },
        { "kind": "role", "role": "status", "name": "Maya Chen is online" }
      ],
      "mode": "live"
    },
    {
      "id": "presence-cycle",
      "name": "Presence transition",
      "description": "The status indicator can change without changing the identity surface around it.",
      "harness": "PresenceCycle",
      "args": {
        "name": "Maya Chen",
        "size": "lg",
        "shape": "circle",
        "presence": "online",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "status", "name": "Maya Chen is away" }
      ],
      "interactions": [
        {
          "kind": "click",
          "target": { "role": "button", "name": "Cycle status" }
        },
        { "kind": "settle" }
      ],
      "mode": "live"
    },
    {
      "id": "loading",
      "name": "Loading image",
      "description": "The reserved image frame stays stable while the image is still resolving.",
      "harness": "Loading",
      "args": {
        "name": "Maya Chen",
        "size": "lg",
        "shape": "circle",
        "presence": "away",
        "imageState": "loading"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Maya Chen" },
        { "kind": "attribute", "selector": "[data-rcl-progressive-image]", "attribute": "aria-busy", "value": "true" }
      ],
      "mode": "live"
    },
    {
      "id": "request-error",
      "name": "Request error fallback",
      "description": "A failed image request preserves initials and announces the failure surface.",
      "harness": "RequestError",
      "args": {
        "name": "Maya Chen",
        "size": "lg",
        "shape": "circle",
        "presence": "busy",
        "imageState": "error"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Maya Chen" },
        { "kind": "role", "role": "alert" }
      ],
      "mode": "live"
    },
    {
      "id": "scale-and-shape",
      "name": "Scale and shape",
      "description": "Small and non-circular identities remain legible in dense lists and compact surfaces.",
      "harness": "Default",
      "args": {
        "name": "Ada Lovelace",
        "size": "xs",
        "shape": "rounded",
        "presence": "offline",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Ada Lovelace" },
        { "kind": "role", "role": "status", "name": "Ada Lovelace is offline" }
      ],
      "mode": "live"
    },
    {
      "id": "compact",
      "name": "Compact identity",
      "description": "A small avatar preserves the same semantics when space is constrained.",
      "harness": "Default",
      "args": {
        "name": "Ravi Shah",
        "size": "sm",
        "shape": "circle",
        "presence": "online",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Ravi Shah" }
      ],
      "mode": "live"
    },
    {
      "id": "large",
      "name": "Large identity",
      "description": "The largest size gives image-led profiles enough presence without changing the API.",
      "harness": "Default",
      "args": {
        "name": "Noah Williams",
        "size": "xl",
        "shape": "square",
        "presence": "offline",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "img", "name": "Noah Williams" }
      ],
      "mode": "live"
    },
    {
      "id": "group",
      "name": "Group overflow",
      "description": "A group keeps the people count and overflow affordance understandable at a glance.",
      "harness": "Group",
      "args": {
        "name": "Maya Chen",
        "size": "md",
        "shape": "circle",
        "presence": "online",
        "imageState": "loaded"
      },
      "expect": [
        { "kind": "role", "role": "group", "name": "Reviewers" },
        { "kind": "role", "role": "img", "name": "+1 more people" },
        { "kind": "layout", "selector": "[data-rcl-avatar-group]", "noOverflow": true }
      ],
      "mode": "live"
    }
  ]
}
