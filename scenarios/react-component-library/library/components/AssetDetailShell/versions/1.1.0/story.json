{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Release artifact",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": "Content",
        "kind": "structured",
        "label": "Preview",
        "path": "preview"
      },
      {
        "default": "dl",
        "kind": "structured",
        "label": "Metadata",
        "path": "metadata"
      },
      {
        "default": "Content",
        "kind": "structured",
        "label": "Activity",
        "path": "activity"
      },
      {
        "default": "ready",
        "kind": "text",
        "label": "Activity State",
        "path": "activityState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "activitySurfaceId": "asset-activity",
        "metadata": "dl",
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "role",
          "role": "main"
        },
        {
          "kind": "text",
          "value": "Validated by 12 checks."
        },
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "ready"
        }
      ],
      "id": "ready-detail",
      "mode": "pinned",
      "name": "Ready asset detail",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ReadyDetail"
        }
      },
      "role": "anatomy"
    },
    {
      "args": {
        "activityState": "partial",
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Some information is unavailable.",
          "role": "status"
        }
      ],
      "id": "activity-partial",
      "mode": "pinned",
      "name": "Partial activity",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ActivityPartial"
        }
      },
      "role": "boundary"
    },
    {
      "args": {
        "activityState": "loading",
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "loading"
        }
      ],
      "id": "activity-loading",
      "mode": "pinned",
      "name": "Loading activity",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ActivityLoading"
        }
      },
      "role": "boundary"
    },
    {
      "args": {
        "activityState": "empty",
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "empty"
        }
      ],
      "id": "activity-empty",
      "mode": "pinned",
      "name": "Empty activity",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ActivityEmpty"
        }
      },
      "role": "boundary"
    },
    {
      "args": {
        "activityState": "error",
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "error"
        }
      ],
      "id": "activity-error",
      "mode": "pinned",
      "name": "Activity error",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ActivityError"
        }
      },
      "role": "boundary"
    }
  ],
  "title": "AssetDetailShell"
}
