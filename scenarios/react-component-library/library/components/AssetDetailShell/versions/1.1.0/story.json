{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Release artifact",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": {
          "$text": "div"
        },
        "kind": "structured",
        "label": "Preview",
        "path": "preview"
      },
      {
        "default": {
          "$text": "dl"
        },
        "kind": "structured",
        "label": "Metadata",
        "path": "metadata"
      },
      {
        "default": {
          "$text": "p"
        },
        "kind": "structured",
        "label": "Activity",
        "path": "activity"
      },
      {
        "default": "ready",
        "kind": "text",
        "label": "Activity State",
        "path": "activityState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "activity": {
          "$text": "p"
        },
        "activitySurfaceId": "asset-activity",
        "metadata": {
          "$text": "dl"
        },
        "preview": {
          "$text": "div"
        },
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "role",
          "role": "main"
        },
        {
          "kind": "text",
          "value": "Validated by 12 checks."
        },
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "ready"
        }
      ],
      "id": "ready-detail",
      "mode": "pinned",
      "name": "Ready asset detail"
    },
    {
      "args": {
        "activityState": "partial",
        "metadata": {
          "$text": "p"
        },
        "preview": {
          "$text": "div"
        },
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Some information is unavailable.",
          "role": "status"
        }
      ],
      "id": "activity-partial",
      "mode": "pinned",
      "name": "Partial activity"
    },
    {
      "args": {
        "activityLoading": {
          "$text": "p"
        },
        "activityState": "loading",
        "metadata": {
          "$text": "p"
        },
        "preview": {
          "$text": "div"
        },
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "loading"
        }
      ],
      "id": "activity-loading",
      "mode": "pinned",
      "name": "Loading activity"
    },
    {
      "args": {
        "activityEmpty": {
          "$text": "p"
        },
        "activityState": "empty",
        "metadata": {
          "$text": "p"
        },
        "preview": {
          "$text": "div"
        },
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "empty"
        }
      ],
      "id": "activity-empty",
      "mode": "pinned",
      "name": "Empty activity"
    },
    {
      "args": {
        "activityError": {
          "$text": "p"
        },
        "activityState": "error",
        "metadata": {
          "$text": "p"
        },
        "preview": {
          "$text": "div"
        },
        "title": "Release artifact"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"asset-activity\"]",
          "value": "error"
        }
      ],
      "id": "activity-error",
      "mode": "pinned",
      "name": "Activity error"
    }
  ],
  "title": "AssetDetailShell"
}
