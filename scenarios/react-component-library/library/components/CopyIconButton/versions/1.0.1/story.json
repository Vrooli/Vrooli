  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "A ghost icon button named for what it copies.",
      "expect": [
        {
          "kind": "role",
          "name": "Copy command",
          "role": "button"
        },
        {
          "attribute": "data-rcl-copy-state",
          "kind": "attribute",
          "selector": "[data-rcl-copy-button]",
          "value": "idle"
        },
        {
          "attribute": "data-rcl-surface",
          "kind": "attribute",
          "selector": "[data-rcl-copy-button]",
          "value": "ghost"
        }
      ],
      "id": "default",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Copy, at rest",
      "role": "anatomy"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "A press copies, and the icon morphs to a check in the success colour.",
      "expect": [
        {
          "attribute": "data-rcl-copy-state",
          "kind": "attribute",
          "selector": "[data-rcl-copy-button]",
          "value": "copied"
        }
