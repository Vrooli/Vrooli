      "id": "success",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Copy command",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Copied",
      "role": "boundary"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Failed",
          "module": "./story.tsx"
        }
      },
      "description": "A write that fails shows a cross in the danger colour and announces the failure.",
      "expect": [
        {
          "attribute": "data-rcl-copy-state",
          "kind": "attribute",
          "selector": "[data-rcl-copy-button]",
          "value": "failed"
        }
      ],
      "id": "request-error",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Copy command",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Copy failed",
      "role": "boundary"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Controlled",
          "module": "./story.tsx"
        }
      },
      "description": "Shown as copied without a press here, as when a menu row copied the same text.",
      "expect": [
        {
          "attribute": "data-rcl-copy-state",
          "kind": "attribute",
          "selector": "[data-rcl-copy-button]",
          "value": "copied"
        }
      ],
      "id": "controlled",
      "mode": "pinned",
      "name": "Copied elsewhere",
      "role": "boundary"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "SizeXSmall",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "attribute": "data-rcl-size",
          "kind": "attribute",
