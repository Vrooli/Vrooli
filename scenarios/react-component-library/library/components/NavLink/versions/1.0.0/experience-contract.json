{
  "$schema": "../../../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "nav-link",
    "title": "NavLink",
    "purpose": "A named navigation link with a stable current-page indicator and bounded label.",
    "storyRef": "../../library/components/NavLink/versions/1.0.0/story.json"
  },
  "states": [
    {
      "id": "default",
      "example": "default",
      "description": "The navigation link is available."
    },
    {
      "id": "long-content",
      "example": "long-content",
      "description": "Long labels remain operable and bounded."
    }
  ],
  "elements": [
    {
      "id": "link",
      "role": "link",
      "description": "The navigation destination."
    }
  ],
  "claims": [
    {
      "id": "link-present",
      "type": "element-present",
      "statement": "The asset exposes a named navigation link.",
      "tier": "machine",
      "elements": ["link"],
      "states": ["default", "long-content"]
    },
    {
      "id": "link-no-overflow",
      "type": "no-document-horizontal-overflow",
      "statement": "Long labels do not create document-level horizontal overflow.",
      "tier": "machine",
      "states": ["default", "long-content"]
    }
  ],
  "bindings": { "elements": { "link": { "selector": "link" } } }
}
