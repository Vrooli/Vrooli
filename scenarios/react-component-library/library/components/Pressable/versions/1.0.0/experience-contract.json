{
  "$schema": "../../../../../../.vrooli/schemas/scenario-experience-spec.schema.json",
  "kind": "experience-component",
  "schemaVersion": "1.1.0",
  "component": {
    "id": "pressable",
    "title": "Pressable",
    "purpose": "Shared press behavior with stable ready and pending geometry.",
    "storyRef": "../../library/components/Pressable/versions/1.0.0/story.json"
  },
  "states": [
    {
      "id": "default",
      "example": "ready",
      "description": "The action is ready."
    },
    {
      "id": "pending",
      "example": "pending",
      "description": "The action is working."
    }
  ],
  "elements": [
    {
      "id": "control",
      "role": "button",
      "description": "The pressable control."
    }
  ],
  "claims": [
    {
      "id": "control-present",
      "type": "element-present",
      "statement": "Pressable exposes an operable named control.",
      "tier": "machine",
      "elements": ["control"],
      "states": ["default", "pending"]
    },
    {
      "id": "pending-contract",
      "type": "custom",
      "statement": "Pressable preserves bounded tone and pending behavior without resizing ready or icon-only controls.",
      "tier": "manual",
      "states": ["default", "pending"]
    }
  ],
  "bindings": {
    "elements": { "control": { "selector": "[data-rcl-pressable]" } }
  }
}
