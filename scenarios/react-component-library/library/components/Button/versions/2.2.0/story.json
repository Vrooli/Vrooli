{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": {
          "$text": "Save changes"
        },
        "format": "renderable-text",
        "kind": "structured",
        "label": "Label",
        "path": "children",
        "required": true
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Disabled",
        "path": "disabled"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$text": "Save changes"
        },
        "variant": "primary"
      },
      "composition": {
        "specimen": {
          "export": "ButtonStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save changes",
          "role": "button"
        }
      ],
      "id": "primary",
      "mode": "live",
      "name": "Primary"
    },
    {
      "args": {
        "children": {
          "$text": "Continue"
        },
        "iconName": "arrowEnd",
        "size": "lg"
      },
      "composition": {
        "specimen": {
          "export": "ButtonStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Continue",
          "role": "button"
        }
      ],
      "id": "start-icon",
      "mode": "live",
      "name": "Governed start icon"
    },
    {
      "args": {
        "children": {
          "$text": "Save changes"
        },
        "disabled": true
      },
      "composition": {
        "specimen": {
          "export": "ButtonStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save changes",
          "role": "button"
        }
      ],
      "id": "disabled-long-label",
      "mode": "live",
      "name": "Disabled"
    },
    {
      "args": {
        "children": {
          "$text": "Save changes"
        },
        "variant": "primary"
      },
      "composition": {
        "harness": {
          "asset": "preview.showcase",
          "config": {
            "detail": "The generic harness supplies context; Button remains the subject.",
            "title": "Primary action"
          },
          "export": "Showcase",
          "version": "1.0.0"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save changes",
          "role": "button"
        }
      ],
      "id": "shared-showcase",
      "mode": "live",
      "name": "Shared showcase harness"
    },
    {
      "args": {
        "children": {
          "$text": "Save changes"
        },
        "variant": "primary"
      },
      "composition": {
        "specimen": {
          "export": "AsyncSaveStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save changes",
          "role": "button"
        },
        {
          "kind": "role",
          "name": "Saving changes status",
          "role": "status"
        },
        {
          "kind": "count",
          "selector": "button",
          "value": "1"
        }
      ],
      "id": "async-save",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Save changes",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Async save pending"
    },
    {
      "args": {
        "children": {
          "$text": "Review and apply all pending workspace configuration changes"
        }
      },
      "composition": {
        "specimen": {
          "export": "LongContentStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Review and apply all pending workspace configuration changes",
          "role": "button"
        },
        {
          "kind": "count",
          "selector": "button",
          "value": "1"
        },
        {
          "kind": "layout",
          "noOverflow": true,
          "selector": "[data-rcl-control]"
        }
      ],
      "id": "long-content",
      "mode": "live",
      "name": "Long content stress"
    },
    {
      "args": {
        "children": {
          "$text": "Try again"
        },
        "variant": "primary"
      },
      "composition": {
        "specimen": {
          "export": "ErrorRecoveryStory",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "role",
          "name": "Saved",
          "role": "button"
        },
        {
          "kind": "count",
          "selector": "button",
          "value": "1"
        }
      ],
      "id": "error-retry",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Try again",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Recoverable save failure"
    }
  ],
  "title": "Button 2.2"
}
