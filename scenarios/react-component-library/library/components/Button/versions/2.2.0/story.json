{
  "schemaVersion": 3,
  "kind": "component",
  "title": "Button 2.2",
  "args": {
    "fields": [
      {
        "path": "children",
        "label": "Label",
        "kind": "structured",
        "required": true,
        "default": { "$text": "Save changes" },
        "format": "renderable-text"
      },
      {
        "path": "disabled",
        "label": "Disabled",
        "kind": "boolean",
        "default": false
      }
    ]
  },
  "environment": { "fixtures": [] },
  "stories": [
    {
      "id": "primary",
      "name": "Primary",
      "harness": "ButtonStory",
      "args": { "children": { "$text": "Save changes" }, "aria-label": "Save changes", "variant": "primary" },
      "expect": [{ "kind": "role", "role": "button", "name": "Save changes" }],
      "mode": "live"
    },
    {
      "id": "start-icon",
      "name": "Governed start icon",
      "harness": "ButtonStory",
      "args": {
        "children": { "$text": "Continue" },
        "iconName": "arrowEnd",
        "size": "lg"
      },
      "expect": [{ "kind": "role", "role": "button", "name": "Continue" }],
      "mode": "live"
    },
    {
      "id": "disabled-long-label",
      "name": "Disabled",
      "harness": "ButtonStory",
      "args": { "children": { "$text": "Save changes" }, "disabled": true },
      "expect": [{ "kind": "role", "role": "button", "name": "Save changes" }],
      "mode": "live"
    },
    {
      "id": "shared-showcase",
      "name": "Shared showcase harness",
      "sharedHarness": {
        "asset": "preview.showcase",
        "version": "1.0.0",
        "export": "Showcase",
        "config": {
          "title": "Primary action",
          "detail": "The generic harness supplies context; Button remains the subject."
        }
      },
      "args": { "children": { "$text": "Save changes" }, "aria-label": "Save changes", "variant": "primary" },
      "expect": [{ "kind": "role", "role": "button", "name": "Save changes" }],
      "mode": "live"
    },
    {
      "id": "async-save",
      "name": "Async save pending",
      "harness": "AsyncSaveStory",
      "args": { "children": { "$text": "Save changes" }, "aria-label": "Save changes", "variant": "primary" },
      "expect": [
        { "kind": "role", "role": "button", "name": "Save changes" },
        { "kind": "role", "role": "status", "name": "Saving changes status" },
        { "kind": "count", "selector": "button", "value": "1" }
      ],
      "interactions": [
        { "kind": "click", "target": { "role": "button", "name": "Save changes" } },
        { "kind": "settle" }
      ],
      "mode": "live"
    },
    {
      "id": "long-content",
      "name": "Long content stress",
      "harness": "LongContentStory",
      "args": { "children": { "$text": "Review and apply all pending workspace configuration changes" }, "aria-label": "Review and apply all pending workspace configuration changes" },
      "expect": [
        { "kind": "role", "role": "button", "name": "Review and apply all pending workspace configuration changes" },
        { "kind": "count", "selector": "button", "value": "1" }
      ],
      "mode": "live"
    }
  ]
}
