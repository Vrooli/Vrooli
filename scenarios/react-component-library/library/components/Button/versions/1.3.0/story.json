{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": {
          "$text": "Save changes"
        },
        "format": "renderable-text",
        "kind": "structured",
        "label": "Children",
        "path": "children",
        "required": true
      },
      {
        "default": "primary",
        "kind": "enum",
        "label": "Variant",
        "options": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ],
        "path": "variant",
        "required": true
      },
      {
        "default": "md",
        "kind": "enum",
        "label": "Size",
        "options": [
          "xs",
          "sm",
          "md",
          "icon"
        ],
        "path": "size",
        "required": true
      },
      {
        "default": {
          "$icon": "Save"
        },
        "kind": "structured",
        "label": "Icon",
        "path": "icon"
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Disabled",
        "path": "disabled"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$text": "Save"
        },
        "size": "xs",
        "variant": "primary"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save",
          "role": "button"
        }
      ],
      "id": "primary-xs",
      "mode": "pinned",
      "name": "Primary extra small"
    },
    {
      "args": {
        "children": {
          "$text": "Cancel"
        },
        "size": "sm",
        "variant": "secondary"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Cancel",
          "role": "button"
        }
      ],
      "id": "secondary-sm",
      "mode": "pinned",
      "name": "Secondary small"
    },
    {
      "args": {
        "children": {
          "$text": "More"
        },
        "size": "md",
        "variant": "ghost"
      },
      "expect": [
        {
          "kind": "role",
          "name": "More",
          "role": "button"
        }
      ],
      "id": "ghost-md",
      "mode": "pinned",
      "name": "Ghost medium"
    },
    {
      "args": {
        "children": {
          "$text": "Delete"
        },
        "icon": {
          "$icon": "Trash2"
        },
        "size": "icon",
        "variant": "danger"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Delete",
          "role": "button"
        }
      ],
      "id": "danger-icon",
      "mode": "pinned",
      "name": "Danger icon"
    }
  ],
  "title": "Button 1.3"
}
