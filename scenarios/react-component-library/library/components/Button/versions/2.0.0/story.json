{
  "schemaVersion": 3,
  "kind": "component",
  "title": "Button 2.0",
  "args": {
    "fields": [
      {
        "path": "children",
        "label": "Children",
        "kind": "structured",
        "required": true,
        "default": {
          "$text": "Save changes"
        },
        "format": "renderable-text"
      },
      {
        "path": "variant",
        "label": "Variant",
        "kind": "enum",
        "required": true,
        "default": "primary",
        "options": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ]
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "enum",
        "required": true,
        "default": "md",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ]
      },
      {
        "path": "density",
        "label": "Density",
        "kind": "enum",
        "required": true,
        "default": "comfortable",
        "options": [
          "comfortable",
          "compact"
        ]
      },
      {
        "path": "shape",
        "label": "Shape",
        "kind": "enum",
        "required": true,
        "default": "square",
        "options": [
          "square",
          "pill"
        ]
      },
      {
        "path": "disabled",
        "label": "Disabled",
        "kind": "boolean",
        "default": false
      },
      {
        "path": "icon",
        "label": "Icon",
        "kind": "structured",
        "default": {
          "$icon": "Save"
        }
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
