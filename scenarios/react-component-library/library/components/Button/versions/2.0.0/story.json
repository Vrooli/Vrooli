      "id": "primary",
      "name": "Primary",
      "harness": "ButtonStory",
      "args": {
        "children": {
          "$text": "Save"
        },
        "variant": "primary"
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Save"
        }
      ],
      "mode": "live"
    },
    {
