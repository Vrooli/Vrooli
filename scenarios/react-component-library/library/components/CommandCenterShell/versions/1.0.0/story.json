{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Operations command center",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": {
          "$text": "nav"
        },
        "kind": "structured",
        "label": "Navigation",
        "path": "navigation"
      },
      {
        "default": [
          {
            "detail": "3 need attention",
            "label": "Active runs",
            "value": "12"
          },
          {
            "label": "Queued",
            "value": "28"
          }
        ],
        "kind": "structured",
        "label": "Metrics",
        "path": "metrics"
      },
      {
        "default": {
          "$text": "button"
        },
        "kind": "structured",
        "label": "Controls",
        "path": "controls"
      },
      {
        "default": {
          "$text": "section"
        },
        "kind": "structured",
        "label": "Children",
        "path": "children"
      },
      {
        "default": "partial",
        "kind": "text",
        "label": "Region State",
        "path": "regionState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$text": "section"
        },
        "controls": {
          "$text": "button"
        },
        "metrics": [
          {
            "detail": "3 need attention",
            "label": "Active runs",
            "value": "12"
          },
          {
            "label": "Queued",
            "value": "28"
          }
        ],
        "navigation": {
          "$text": "nav"
        },
        "regionId": "operations-runs",
        "title": "Operations command center"
      },
      "expect": [
        {
          "kind": "role",
          "role": "main"
        },
        {
          "kind": "text",
          "value": "Recent runs"
        },
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"operations-runs\"]",
          "value": "ready"
        }
      ],
      "id": "ready-workspace",
      "mode": "pinned",
      "name": "Ready workspace"
    },
    {
      "args": {
        "metrics": [
          {
            "label": "Active runs",
            "value": "12"
          }
        ],
        "navigation": {
          "$text": "nav"
        },
        "regionState": "partial",
        "title": "Operations command center"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Some information is unavailable.",
          "role": "status"
        }
      ],
      "id": "partial-workspace",
      "mode": "pinned",
      "name": "Partial workspace"
    },
    {
      "args": {
        "loading": {
          "$text": "p"
        },
        "metrics": [
          {
            "label": "Active runs",
            "value": "12"
          }
        ],
        "navigation": {
          "$text": "nav"
        },
        "regionState": "loading",
        "title": "Operations command center"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"command-center-primary\"]",
          "value": "loading"
        }
      ],
      "id": "loading-workspace",
      "mode": "pinned",
      "name": "Loading workspace"
    },
    {
      "args": {
        "empty": {
          "$text": "p"
        },
        "metrics": [
          {
            "label": "Active runs",
            "value": "0"
          }
        ],
        "navigation": {
          "$text": "nav"
        },
        "regionState": "empty",
        "title": "Operations command center"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"command-center-primary\"]",
          "value": "empty"
        }
      ],
      "id": "empty-workspace",
      "mode": "pinned",
      "name": "Empty workspace"
    },
    {
      "args": {
        "error": {
          "$text": "p"
        },
        "metrics": [
          {
            "label": "Active runs",
            "value": "12"
          }
        ],
        "navigation": {
          "$text": "nav"
        },
        "regionState": "error",
        "title": "Operations command center"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"command-center-primary\"]",
          "value": "error"
        }
      ],
      "id": "error-workspace",
      "mode": "pinned",
      "name": "Workspace error"
    }
  ],
  "title": "CommandCenterShell"
}
