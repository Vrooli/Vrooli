{
  "examples": [
    {
      "name": "full-open",
      "displayName": "Full drawer",
      "props": {
        "open": true,
        "title": "Component details",
        "onClose": { "$handler": "close" },
        "children": { "$text": "Full-page drawer body content" }
      },
      "expect": [
        { "kind": "role", "role": "dialog", "name": "Component details" },
        { "kind": "text", "value": "Full-page drawer body content" }
      ]
    },
    {
      "name": "compact-open",
      "displayName": "Compact drawer",
      "props": {
        "open": true,
        "size": "compact",
        "title": "Appearance",
        "onClose": { "$handler": "close" },
        "children": { "$text": "Compact centered panel" }
      },
      "expect": [
        { "kind": "role", "role": "dialog", "name": "Appearance" },
        { "kind": "text", "value": "Compact centered panel" }
      ]
    },
    {
      "name": "with-header-actions",
      "displayName": "Header actions",
      "props": {
        "open": true,
        "title": "Edit prompt",
        "onClose": { "$handler": "close" },
        "headerActions": { "$node": "button", "props": { "type": "button", "className": "min-h-[44px] min-w-[44px] rounded-control px-2 py-1 text-app-primary" }, "children": [{ "$text": "Save" }] },
        "children": { "$text": "Body with a header action" }
      },
      "expect": [
        { "kind": "role", "role": "button", "name": "Save" },
        { "kind": "text", "value": "Body with a header action" }
      ]
    },
    {
      "name": "with-header-extra",
      "displayName": "Header subtitle",
      "props": {
        "open": true,
        "title": "Session log",
        "onClose": { "$handler": "close" },
        "headerExtra": { "$node": "p", "props": { "className": "mt-1 text-xs text-wc-text-muted" }, "children": [{ "$text": "Updated 2 minutes ago" }] },
        "children": { "$text": "Scrollable log content" }
      },
      "expect": [
        { "kind": "text", "value": "Updated 2 minutes ago" },
        { "kind": "text", "value": "Scrollable log content" }
      ]
    },
    {
      "name": "keyboard-aware",
      "displayName": "Keyboard-aware composer",
      "props": {
        "open": true,
        "title": "Message",
        "avoidKeyboard": true,
        "closeAriaLabel": "Close composer",
        "onClose": { "$handler": "close" },
        "children": { "$text": "Composer body lifted above the keyboard" }
      },
      "expect": [
        { "kind": "role", "role": "button", "name": "Close composer" },
        { "kind": "text", "value": "Composer body lifted above the keyboard" }
      ]
    }
  ]
}
