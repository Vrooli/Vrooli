{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": true,
        "kind": "boolean",
        "label": "Open",
        "path": "open"
      },
      {
        "default": "Component details",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": {
          "$handler": "close"
        },
        "kind": "structured",
        "label": "On Close",
        "path": "onClose"
      },
      {
        "default": {
          "$text": "Full-page drawer body content"
        },
        "kind": "structured",
        "label": "Children",
        "path": "children"
      },
      {
        "default": "compact",
        "kind": "text",
        "label": "Size",
        "path": "size"
      },
      {
        "default": {
          "$text": "button"
        },
        "kind": "structured",
        "label": "Header Actions",
        "path": "headerActions"
      },
      {
        "default": {
          "$text": "p"
        },
        "kind": "structured",
        "label": "Header Extra",
        "path": "headerExtra"
      },
      {
        "default": true,
        "kind": "boolean",
        "label": "Avoid Keyboard",
        "path": "avoidKeyboard"
      },
      {
        "default": "Close composer",
        "kind": "text",
        "label": "Close Aria Label",
        "path": "closeAriaLabel"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$text": "Full-page drawer body content"
        },
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Component details"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Component details",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Full-page drawer body content"
        }
      ],
      "id": "full-open",
      "mode": "pinned",
      "name": "Full drawer"
    },
    {
      "args": {
        "children": {
          "$text": "Compact centered panel"
        },
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "size": "compact",
        "title": "Appearance"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Appearance",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Compact centered panel"
        }
      ],
      "id": "compact-open",
      "mode": "pinned",
      "name": "Compact drawer"
    },
    {
      "args": {
        "children": {
          "$text": "Body with a header action"
        },
        "headerActions": {
          "$text": "button"
        },
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Edit prompt"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Save",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "Body with a header action"
        }
      ],
      "id": "with-header-actions",
      "mode": "pinned",
      "name": "Header actions"
    },
    {
      "args": {
        "children": {
          "$text": "Scrollable log content"
        },
        "headerExtra": {
          "$text": "p"
        },
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Session log"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Updated 2 minutes ago"
        },
        {
          "kind": "text",
          "value": "Scrollable log content"
        }
      ],
      "id": "with-header-extra",
      "mode": "pinned",
      "name": "Header subtitle"
    },
    {
      "args": {
        "avoidKeyboard": true,
        "children": {
          "$text": "Composer body lifted above the keyboard"
        },
        "closeAriaLabel": "Close composer",
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Message"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Close composer",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "Composer body lifted above the keyboard"
        }
      ],
      "id": "keyboard-aware",
      "mode": "pinned",
      "name": "Keyboard-aware composer"
    }
  ],
  "title": "DrawerShell"
}
