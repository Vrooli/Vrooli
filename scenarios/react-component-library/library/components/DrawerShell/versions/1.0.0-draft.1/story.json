{
  "schemaVersion": 3,
  "kind": "component",
  "title": "DrawerShell",
  "args": {
    "fields": [
      {
        "path": "open",
        "label": "Open",
        "kind": "boolean",
        "default": true
      },
      {
        "path": "title",
        "label": "Title",
        "kind": "text",
        "default": "Component details"
      },
      {
        "path": "onClose",
        "label": "On Close",
        "kind": "structured",
        "default": {
          "$handler": "close"
        }
      },
      {
        "path": "children",
        "label": "Children",
        "kind": "structured",
        "default": {
          "$text": "Full-page drawer body content"
        }
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "text",
        "default": "compact"
      },
      {
        "path": "headerActions",
        "label": "Header Actions",
        "kind": "structured",
        "default": {
          "$node": "button",
          "props": {
            "type": "button",
            "className": "min-h-[44px] min-w-[44px] rounded-control px-2 py-1 text-app-primary"
          },
          "children": [
            {
              "$text": "Save"
            }
          ]
        }
      },
      {
        "path": "headerExtra",
        "label": "Header Extra",
        "kind": "structured",
        "default": {
          "$node": "p",
          "props": {
            "className": "mt-1 text-xs text-wc-text-muted"
          },
          "children": [
            {
              "$text": "Updated 2 minutes ago"
            }
          ]
        }
      },
      {
        "path": "avoidKeyboard",
        "label": "Avoid Keyboard",
        "kind": "boolean",
        "default": true
      },
      {
        "path": "closeAriaLabel",
        "label": "Close Aria Label",
        "kind": "text",
        "default": "Close composer"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "full-open",
      "name": "Full drawer",
      "args": {
        "open": true,
        "title": "Component details",
        "onClose": {
          "$handler": "close"
        },
        "children": {
          "$text": "Full-page drawer body content"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "dialog",
          "name": "Component details"
        },
        {
          "kind": "text",
          "value": "Full-page drawer body content"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "compact-open",
      "name": "Compact drawer",
      "args": {
        "open": true,
        "size": "compact",
        "title": "Appearance",
        "onClose": {
          "$handler": "close"
        },
        "children": {
          "$text": "Compact centered panel"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "dialog",
          "name": "Appearance"
        },
        {
          "kind": "text",
          "value": "Compact centered panel"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "with-header-actions",
      "name": "Header actions",
      "args": {
        "open": true,
        "title": "Edit prompt",
        "onClose": {
          "$handler": "close"
        },
        "headerActions": {
          "$node": "button",
          "props": {
            "type": "button",
            "className": "min-h-[44px] min-w-[44px] rounded-control px-2 py-1 text-app-primary"
          },
          "children": [
            {
              "$text": "Save"
            }
          ]
        },
        "children": {
          "$text": "Body with a header action"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Save"
        },
        {
          "kind": "text",
          "value": "Body with a header action"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "with-header-extra",
      "name": "Header subtitle",
      "args": {
        "open": true,
        "title": "Session log",
        "onClose": {
          "$handler": "close"
        },
        "headerExtra": {
          "$node": "p",
          "props": {
            "className": "mt-1 text-xs text-wc-text-muted"
          },
          "children": [
            {
              "$text": "Updated 2 minutes ago"
            }
          ]
        },
        "children": {
          "$text": "Scrollable log content"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Updated 2 minutes ago"
        },
        {
          "kind": "text",
          "value": "Scrollable log content"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "keyboard-aware",
      "name": "Keyboard-aware composer",
      "args": {
        "open": true,
        "title": "Message",
        "avoidKeyboard": true,
        "closeAriaLabel": "Close composer",
        "onClose": {
          "$handler": "close"
        },
        "children": {
          "$text": "Composer body lifted above the keyboard"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Close composer"
        },
        {
          "kind": "text",
          "value": "Composer body lifted above the keyboard"
        }
      ],
      "mode": "pinned"
    }
  ]
}
