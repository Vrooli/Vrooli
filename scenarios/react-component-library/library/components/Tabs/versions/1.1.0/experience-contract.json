{
  "bindings": {
    "elements": {
      "panel": {
        "selector": "[data-rcl-tab-panel]"
      },
      "tabs": {
        "testid": "navigation.tabs"
      },
      "trigger": {
        "selector": "[data-rcl-tab-trigger]"
      }
    }
  },
  "claims": [
    {
      "elements": ["trigger"],
      "id": "tap-target-size",
      "statement": "Every tab trigger meets the comfortable tap target.",
      "tier": "machine",
      "type": "tap-target-size"
    },
    {
      "elements": ["tabs"],
      "id": "content-not-clipped",
      "statement": "An overflowing strip scrolls rather than clipping or wrapping its triggers.",
      "tier": "machine",
      "type": "content-not-clipped"
    },
    {
      "elements": ["trigger"],
      "id": "state-contrast",
      "statement": "The selected tab is distinguishable from the unselected tabs.",
      "tier": "machine",
      "type": "state-contrast"
    },
    {
      "elements": ["trigger"],
      "id": "keyboard-reachable",
      "statement": "Arrow, Home, and End move the selection and the focus together.",
      "tier": "machine",
      "type": "keyboard-reachable"
    }
  ],
  "component": {
    "id": "navigation.tabs",
    "purpose": "A horizontal tab strip that scrolls rather than wraps.",
    "title": "Tabs"
  },
  "contract": {
    "kind": "rcl-component-experience-contract",
    "provenance": "react-component-library:Tabs@1.1.0",
    "schema": "scenario-experience-spec/v1"
  },
  "elements": [
    {
      "description": "The tab strip root.",
      "id": "tabs",
      "role": "generic"
    },
    {
      "description": "One tab trigger.",
      "id": "trigger",
      "role": "tab"
    },
    {
      "description": "The rendered panel for the selected tab.",
      "id": "panel",
      "role": "tabpanel"
    }
  ],
  "states": [
    {
      "description": "A strip that fits its container.",
      "example": "default",
      "id": "default"
    },
    {
      "description": "More tabs than fit, scrolling in place.",
      "example": "overflowing",
      "id": "overflowing"
    },
    {
      "description": "Triggers carrying a glyph and a count.",
      "example": "with-icons-and-badges",
      "id": "with-icons-and-badges"
    },
    {
      "description": "Caller-owned selection rendering a panel.",
      "example": "controlled-with-panels",
      "id": "controlled-with-panels"
    },
    {
      "description": "Caller-supplied automation selectors.",
      "example": "custom-item-test-ids",
      "id": "custom-item-test-ids"
    }
  ]
}
