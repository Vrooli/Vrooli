{
  "claims": [
    {
      "id": "both-bounds-enforced",
      "statement": "Every path into the value — stepper, arrow key, and typing — clamps to both bounds, so a declared maximum cannot be enforced on one path and ignored on another.",
      "states": [
        "typed-over-maximum",
        "at-maximum",
        "at-minimum"
      ],
      "tier": "manual",
      "type": "manual-review"
    },
    {
      "id": "draft-then-commit",
      "statement": "Typing edits a draft and the value commits on blur or Enter, so a half-typed number is never clamped mid-keystroke.",
      "states": [
        "typed-over-maximum",
        "typed-empty"
      ],
      "tier": "manual",
      "type": "manual-review"
    },
    {
      "id": "empty-is-not-zero",
      "statement": "An empty or non-numeric draft reverts to the committed value rather than resolving to zero and committing the floor.",
      "states": [
        "typed-empty"
      ],
      "tier": "manual",
      "type": "manual-review"
    },
    {
      "id": "spinbutton-keyboard",
      "statement": "The value reports the spinbutton role with its range, and the arrow keys that role promises actually step it.",
      "states": [
        "default",
        "arrow-keys"
      ],
      "tier": "aspirational",
      "type": "keyboard-operable"
    },
    {
      "id": "bounds-are-visible",
      "statement": "A stepper at its bound disables itself, so the limit is visible before it is reached rather than expressed as a press that does nothing.",
      "states": [
        "at-maximum",
        "at-minimum"
      ],
      "tier": "manual",
      "type": "manual-review"
    }
  ],
  "component": {
    "id": "forms.number-field",
    "purpose": "One bounded numeric setting — value, unit and steppers — so every numeric surface enforces its range the same way.",
    "title": "Number Field"
  },
  "contract": {
    "kind": "rcl-component-experience-contract",
    "provenance": "react-component-library:NumberField@1.0.2",
    "schema": "scenario-experience-spec/v1"
  },
  "states": [
    {
      "description": "Value, unit and both steppers at rest.",
      "example": "default",
      "id": "default"
    },
    {
      "description": "Incremented by its joined stepper.",
      "example": "increment",
      "id": "increment"
    },
    {
      "description": "Stepped from the keyboard.",
      "example": "arrow-keys",
      "id": "arrow-keys"
    },
    {
      "description": "Held at the declared ceiling.",
      "example": "at-maximum",
      "id": "at-maximum"
    },
    {
      "description": "Held at the declared floor.",
      "example": "at-minimum",
      "id": "at-minimum"
    },
    {
      "description": "A typed value above the ceiling.",
      "example": "typed-over-maximum",
      "id": "typed-over-maximum"
    },
    {
      "description": "A field emptied by typing.",
      "example": "typed-empty",
      "id": "typed-empty"
    },
    {
      "description": "A fractional step ramp.",
      "example": "fractional-step",
      "id": "fractional-step"
    }
  ]
}
