{
  "bindings": {
    "elements": {
      "control": {
        "testid": "voice-input-control"
      }
    }
  },
  "claims": [
    {
      "elements": ["control"],
      "id": "voice-content-not-clipped",
      "statement": "The voice control content remains visible at each documented size.",
