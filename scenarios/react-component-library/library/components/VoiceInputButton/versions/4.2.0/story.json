{
  "schemaVersion": 3,
  "kind": "component",
  "title": "VoiceInputButton",
  "args": {
    "fields": [
      {
        "path": "state",
        "label": "State",
        "kind": "enum",
        "required": true,
        "default": "idle",
        "options": [
          "idle",
          "preparing",
          "recording",
          "recovering",
          "transcribing",
          "unavailable",
          "error"
        ]
      },
      {
        "path": "mode",
        "label": "Mode",
        "kind": "enum",
        "required": true,
        "default": "always-on",
        "options": [
          "always-on",
          "timeout"
        ]
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "enum",
        "required": true,
        "default": "sm",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ]
      },
      {
        "path": "density",
        "label": "Density",
        "kind": "enum",
        "required": true,
        "default": "comfortable",
        "options": [
          "comfortable",
          "compact"
        ]
      },
      {
        "path": "level",
        "label": "Input level",
        "kind": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.65
      },
      {
        "path": "timeoutProgress",
        "label": "Timeout progress",
        "kind": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.5
      }
    ]
  },
  "environment": {
    "fixtures": [
      {
        "key": "voiceInput",
        "adapter": "voice-input",
        "options": [
          "idle",
          "recording",
          "permission-denied"
        ]
      }
    ]
  },
  "stories": [
    {
      "id": "idle",
      "name": "Idle",
      "mode": "live",
      "harness": "Live",
      "args": {
        "state": "idle",
        "size": "sm"
      },
      "environment": {
        "voiceInput": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Start voice input"
        }
      ]
    },
    {
      "id": "preparing",
      "name": "Preparing",
      "harness": "Live",
      "args": {
        "state": "preparing"
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Preparing microphone"
        }
      ],
      "mode": "live"
    },
    {
      "id": "recording",
      "name": "Recording",
      "harness": "Live",
      "args": {
        "state": "recording",
        "mode": "always-on",
        "level": 0.65
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Stop voice input"
        }
      ],
      "mode": "live"
    },
