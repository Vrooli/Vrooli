{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "idle",
        "kind": "enum",
        "label": "State",
        "options": [
          "idle",
          "preparing",
          "recording",
          "recovering",
          "transcribing",
          "unavailable",
          "error"
        ],
        "path": "state",
        "required": true
      },
      {
        "default": "always-on",
        "kind": "enum",
        "label": "Mode",
        "options": [
          "always-on",
          "timeout"
        ],
        "path": "mode",
        "required": true
      },
      {
        "default": "sm",
        "kind": "enum",
        "label": "Size",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ],
        "path": "size",
        "required": true
      },
      {
        "default": "comfortable",
        "kind": "enum",
        "label": "Density",
        "options": [
          "comfortable",
          "compact"
        ],
        "path": "density",
        "required": true
      },
      {
        "default": 0.65,
        "kind": "number",
        "label": "Input level",
        "maximum": 1,
        "minimum": 0,
        "path": "level"
      },
      {
        "default": 0.5,
        "kind": "number",
        "label": "Timeout progress",
        "maximum": 1,
        "minimum": 0,
        "path": "timeoutProgress"
      },
      {
        "default": "Microphone permission was denied.",
        "kind": "text",
        "label": "Error",
        "path": "error"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "size": "sm",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "idle",
      "mode": "pinned",
      "name": "Idle"
    },
    {
      "args": {
        "state": "preparing"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Preparing microphone",
          "role": "button"
        }
      ],
      "id": "preparing",
      "mode": "pinned",
      "name": "Preparing"
    },
    {
      "args": {
        "level": 0.65,
        "mode": "always-on",
        "state": "recording"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "recording",
      "mode": "pinned",
      "name": "Recording"
    },
    {
      "args": {
        "level": 0.35,
        "state": "recovering"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Listening for voice input",
          "role": "button"
        }
      ],
      "id": "recovering",
      "mode": "pinned",
      "name": "Recovering"
    },
    {
      "args": {
        "state": "transcribing"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Transcribing voice input",
          "role": "button"
        }
      ],
      "id": "transcribing",
      "mode": "pinned",
      "name": "Transcribing"
    },
    {
      "args": {
        "state": "unavailable"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Voice input unavailable",
          "role": "button"
        }
      ],
      "id": "unavailable",
      "mode": "pinned",
      "name": "Unavailable"
    },
    {
      "args": {
        "error": "Microphone permission was denied.",
        "state": "error"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Voice input error",
          "role": "button"
        },
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "id": "error",
      "mode": "pinned",
      "name": "Error"
    },
    {
      "args": {
        "mode": "always-on",
        "state": "recording"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "mode-always-on",
      "mode": "pinned",
      "name": "Always-on mode"
    },
    {
      "args": {
        "mode": "timeout",
        "state": "recording",
        "timeoutProgress": 0.7
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "mode-timeout",
      "mode": "pinned",
      "name": "Timeout mode"
    },
    {
      "args": {
        "size": "xs",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-xs",
      "mode": "pinned",
      "name": "XS"
    },
    {
      "args": {
        "size": "sm",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-sm",
      "mode": "pinned",
      "name": "SM"
    },
    {
      "args": {
        "size": "md",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-md",
      "mode": "pinned",
      "name": "MD"
    },
    {
      "args": {
        "size": "lg",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-lg",
      "mode": "pinned",
      "name": "LG"
    },
    {
      "args": {
        "size": "xl",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-xl",
      "mode": "pinned",
      "name": "XL"
    },
    {
      "args": {
        "size": "icon",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-icon",
      "mode": "pinned",
      "name": "Icon"
    },
    {
      "args": {
        "density": "comfortable",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "density-comfortable",
      "mode": "pinned",
      "name": "Comfortable density"
    },
    {
      "args": {
        "density": "compact",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "density-compact",
      "mode": "pinned",
      "name": "Compact density"
    }
  ],
  "title": "VoiceInputButton 3.0"
}
