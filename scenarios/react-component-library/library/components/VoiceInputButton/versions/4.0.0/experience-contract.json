{
  "contract": {
    "kind": "rcl-component-experience-contract",
    "schema": "scenario-experience-spec/v1",
    "provenance": "react-component-library/VoiceInputButton@4.0.0"
  },
  "component": {
    "id": "voice-input-button",
    "title": "VoiceInputButton",
    "purpose": "Expose one fixed-footprint microphone control; consumers own errors and recovery actions."
  },
  "states": [
    {
      "id": "idle",
      "example": "idle",
      "description": "Ready to start voice input."
    },
    {
      "id": "recording",
      "example": "recording",
      "description": "Capturing microphone input."
    },
    {
      "id": "error",
      "example": "error",
      "description": "Error state without an embedded recovery surface."
    }
  ],
  "elements": [
    {
      "id": "voice-control",
      "role": "button",
      "description": "The only rendered control."
    }
  ],
  "claims": [
    {
      "id": "voice-input-action",
      "type": "element-present",
      "statement": "Every state exposes exactly one named microphone control.",
      "tier": "machine",
      "elements": ["voice-control"],
      "states": ["idle", "recording", "error"]
    }
  ],
  "bindings": {
    "elements": { "voice-control": { "testid": "voice-input-control" } }
  }
}
