{
  "examples": [
    { "name": "idle", "displayName": "Idle", "props": { "state": "idle" }, "expect": [{ "kind": "role", "role": "button", "name": "Start voice input" }] },
    { "name": "preparing", "displayName": "Preparing", "props": { "state": "preparing" }, "expect": [{ "kind": "role", "role": "button", "name": "Preparing microphone" }] },
    { "name": "recording-always-on", "displayName": "Listening (always on)", "props": { "state": "recording", "mode": "always-on", "level": 0.8 }, "expect": [{ "kind": "role", "role": "button", "name": "Stop voice input" }] },
    { "name": "recording-level-low", "displayName": "Listening level (low)", "props": { "state": "recording", "mode": "always-on", "level": 0.2 }, "expect": [{ "kind": "role", "role": "button", "name": "Stop voice input" }] },
    { "name": "recording-level-high", "displayName": "Listening level (high)", "props": { "state": "recording", "mode": "always-on", "level": 0.9 }, "expect": [{ "kind": "role", "role": "button", "name": "Stop voice input" }] },
    { "name": "recording-timeout", "displayName": "Recording (timeout)", "props": { "state": "recording", "mode": "timeout", "timeoutProgress": 0.65 }, "expect": [{ "kind": "role", "role": "button", "name": "Stop voice input" }] },
    { "name": "speaker-rejected", "displayName": "Speaker rejected", "props": { "state": "recording", "rejectionReason": "Speaker could not be verified", "onTranscribeAnyway": { "$handler": "continue" } }, "expect": [{ "kind": "text", "value": "Transcribe anyway" }] },
    { "name": "recovering", "displayName": "Recovering", "props": { "state": "recovering" }, "expect": [{ "kind": "role", "role": "button", "name": "Recovering voice input" }] },
    { "name": "unavailable", "displayName": "Unavailable", "props": { "state": "unavailable" }, "expect": [{ "kind": "attribute", "selector": "button", "name": "disabled", "value": "" }] },
    { "name": "error", "displayName": "Terminal error", "props": { "state": "error", "error": "Voice connection interrupted", "onDismissError": { "$handler": "dismiss" } }, "expect": [{ "kind": "role", "role": "button", "name": "Voice input error" }, { "kind": "text", "value": "Voice connection interrupted" }] }
  ]
}
