{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": []
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Remove Project brief",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "You can undo this change"
        }
      ],
      "id": "default",
      "mode": "live",
      "name": "Reversible removal"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Submitting",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "Removing Project brief"
        }
      ],
      "id": "submitting",
      "mode": "live",
      "name": "Removal in progress"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Success",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "Project brief removed"
        }
      ],
      "id": "success",
      "mode": "live",
      "name": "Removal complete"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "RequestError",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "alert"
        },
        {
          "kind": "role",
          "name": "Try again",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "workspace service is temporarily unavailable"
        }
      ],
      "id": "request-error",
      "mode": "live",
      "name": "Retryable removal error"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Project brief restored"
        }
      ],
      "id": "interactive",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Remove Project brief",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        },
        {
          "kind": "click",
          "target": {
            "name": "Undo",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Delete and undo"
    }
