{
  "schemaVersion": 3,
  "kind": "component",
  "title": "EmptyState",
  "args": {
    "fields": [
      {
        "path": "title",
        "label": "Title",
        "kind": "text",
        "default": "No components indexed"
      },
      {
        "path": "description",
        "label": "Description",
        "kind": "text",
        "default": "Run the indexer to discover catalog source."
      },
      {
        "path": "icon",
        "label": "Icon",
        "kind": "structured",
        "default": {
          "$icon": "PackageSearch"
        }
      },
      {
        "path": "actionLabel",
        "label": "Action label",
        "kind": "structured",
        "default": { "$text": "Create adoption" },
        "format": "renderable-text"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "no-components",
      "name": "No Components",
      "args": {
        "title": "No components indexed",
        "description": "Run the indexer to discover catalog source.",
        "icon": {
          "$icon": "PackageSearch"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "No components indexed"
        },
        {
          "kind": "text",
          "value": "Run the indexer"
        },
        {
          "kind": "layout",
          "selector": "[data-rcl-empty-state]",
          "noOverflow": true
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "with-action",
      "name": "With Action",
      "args": {
        "title": "No adoptions yet",
        "description": "Record a scenario adoption to track drift.",
        "icon": {
          "$icon": "GitBranch"
        },
        "actionLabel": { "$text": "Create adoption" }
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Create adoption"
        },
        {
          "kind": "text",
          "value": "No adoptions yet"
        },
        {
          "kind": "layout",
          "selector": "[data-rcl-empty-state]",
          "noOverflow": true
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "compact",
      "name": "Compact",
      "args": {
        "title": "Nothing to review"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Nothing to review"
        },
        {
          "kind": "layout",
          "selector": "[data-rcl-empty-state]",
          "noOverflow": true
        }
      ],
      "mode": "pinned"
    }
  ]
}
