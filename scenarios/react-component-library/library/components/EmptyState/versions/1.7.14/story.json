{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {},
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "description": "Run the indexer to discover catalog source.",
        "title": "No components indexed"
      },
      "composition": {
        "specimen": {
          "export": "NoComponents",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "No components indexed"
        },
        {
          "kind": "text",
          "value": "Run the indexer"
        },
        {
          "kind": "layout",
          "noOverflow": true,
          "selector": "[data-rcl-empty-state]"
        }
      ],
      "id": "no-components",
      "mode": "pinned",
      "name": "No Components",
      "role": "anatomy"
    },
    {
      "args": {
        "actionLabel": "Create adoption",
        "description": "Record a scenario adoption to track drift.",
        "title": "No adoptions yet"
      },
      "composition": {
        "specimen": {
          "export": "WithAction",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Create adoption",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "No adoptions yet"
        },
        {
          "kind": "layout",
          "noOverflow": true,
          "selector": "[data-rcl-empty-state]"
        }
      ],
      "id": "with-action",
      "mode": "pinned",
      "name": "With Action",
      "role": "boundary"
    },
    {
      "args": {
        "title": "Nothing to review"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Nothing to review"
        },
        {
          "kind": "layout",
          "noOverflow": true,
          "selector": "[data-rcl-empty-state]"
        }
      ],
      "id": "compact",
      "mode": "pinned",
      "name": "Compact",
      "role": "boundary"
    },
    {
      "id": "empty",
      "name": "Empty state",
      "args": {"title": "Nothing to review", "description": ""},
      "composition": {"specimen": {"module": "./story.tsx", "export": "NoComponents"}},
      "expect": [{"kind": "visible", "selector": "[data-rcl-empty-state]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "overflow",
      "name": "Overflow description",
      "args": {"title": "Nothing to review", "description": "Review and apply all pending workspace configuration changes before continuing."},
      "composition": {"specimen": {"module": "./story.tsx", "export": "NoComponents"}},
      "expect": [{"kind": "visible", "selector": "[data-rcl-empty-state]"}],
      "role": "boundary",
      "mode": "pinned"
    }
  ],
  "title": "EmptyState"
}
