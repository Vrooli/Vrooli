{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "No components indexed",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": "Run the indexer to discover catalog source.",
        "kind": "text",
        "label": "Description",
        "path": "description"
      },
      {
        "default": {
          "$icon": "PackageSearch"
        },
        "kind": "structured",
        "label": "Icon",
        "path": "icon"
      },
      {
        "default": {
          "$text": "button"
        },
        "kind": "structured",
        "label": "Action",
        "path": "action"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "description": "Run the indexer to discover catalog source.",
        "icon": {
          "$icon": "PackageSearch"
        },
        "title": "No components indexed"
      },
      "expect": [
        {
          "kind": "text",
          "value": "No components indexed"
        },
        {
          "kind": "text",
          "value": "Run the indexer"
        }
      ],
      "id": "no-components",
      "mode": "pinned",
      "name": "No Components"
    },
    {
      "args": {
        "action": {
          "$text": "button"
        },
        "description": "Record a scenario adoption to track drift.",
        "icon": {
          "$icon": "GitBranch"
        },
        "title": "No adoptions yet"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Create adoption",
          "role": "button"
        },
        {
          "kind": "text",
          "value": "No adoptions yet"
        }
      ],
      "id": "with-action",
      "mode": "pinned",
      "name": "With Action"
    },
    {
      "args": {
        "title": "Nothing to review"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Nothing to review"
        }
      ],
      "id": "compact",
      "mode": "pinned",
      "name": "Compact"
    }
  ],
  "title": "EmptyState"
}
