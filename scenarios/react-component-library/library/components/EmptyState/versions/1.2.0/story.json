{
  "schemaVersion": 1,
  "kind": "component",
  "title": "EmptyState",
  "args": {
    "fields": [
      { "path": "title", "label": "Title", "kind": "text", "default": "No components indexed" },
      { "path": "description", "label": "Description", "kind": "text", "default": "Run the indexer to discover catalog source." },
      { "path": "icon", "label": "Icon", "kind": "structured", "default": { "$icon": "PackageSearch" } },
      { "path": "action", "label": "Action", "kind": "structured", "default": { "$node": "button", "props": { "type": "button" }, "children": [{ "$text": "Create adoption" }] } }
    ]
  },
  "environment": { "fixtures": [] },
  "stories": [
    {
      "id": "no-components",
      "name": "No Components",
      "args": { "title": "No components indexed", "description": "Run the indexer to discover catalog source.", "icon": { "$icon": "PackageSearch" } },
      "expect": [{ "kind": "text", "value": "No components indexed" }, { "kind": "text", "value": "Run the indexer" }]
    },
    {
      "id": "with-action",
      "name": "With Action",
      "args": { "title": "No adoptions yet", "description": "Record a scenario adoption to track drift.", "icon": { "$icon": "GitBranch" }, "action": { "$node": "button", "props": { "type": "button" }, "children": [{ "$text": "Create adoption" }] } },
      "expect": [{ "kind": "role", "role": "button", "name": "Create adoption" }, { "kind": "text", "value": "No adoptions yet" }]
    },
    {
      "id": "compact",
      "name": "Compact",
      "args": { "title": "Nothing to review" },
      "expect": [{ "kind": "text", "value": "Nothing to review" }]
    }
  ]
}
