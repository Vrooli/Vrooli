{
  "examples": [
    {
      "name": "no-components",
      "displayName": "No Components",
      "props": {
        "title": "No components indexed",
        "description": "Run the indexer to discover catalog source.",
        "icon": { "$icon": "PackageSearch" }
      },
      "expect": [
        { "kind": "text", "value": "No components indexed" },
        { "kind": "text", "value": "Run the indexer" }
      ]
    },
    {
      "name": "with-action",
      "displayName": "With Action",
      "props": {
        "title": "No adoptions yet",
        "description": "Record a scenario adoption to track drift.",
        "icon": { "$icon": "GitBranch" },
        "action": { "$node": "button", "props": { "type": "button", "className": "rounded-control bg-app-primary px-3 py-2 text-app-primary-foreground" }, "children": [{ "$text": "Create adoption" }] }
      },
      "expect": [
        { "kind": "role", "role": "button", "name": "Create adoption" },
        { "kind": "text", "value": "No adoptions yet" }
      ]
    },
    {
      "name": "compact",
      "displayName": "Compact",
      "props": {
        "title": "Nothing to review",
        "className": "max-w-sm"
      },
      "expect": [
        { "kind": "text", "value": "Nothing to review" }
      ]
    }
  ]
}
