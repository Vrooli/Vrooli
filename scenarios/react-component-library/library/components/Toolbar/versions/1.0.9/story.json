{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": []
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Editor toolbar",
          "role": "toolbar"
        },
        {
          "kind": "role",
          "name": "Bold",
          "role": "button"
        }
      ],
      "id": "default",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Horizontal",
      "role": "anatomy"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Last toolbar action",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "Last action: Bold"
        }
      ],
      "id": "interactive",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Bold",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Interactive",
      "role": "boundary"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Vertical",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Editor toolbar",
          "role": "toolbar"
        }
      ],
      "id": "vertical",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Vertical",
      "role": "boundary"
    },
    {
      "id": "orientation",
      "name": "Orientation axis",
      "axis": "orientation",
      "covers": {"orientation": ["horizontal", "vertical"]},
      "args": {},
      "composition": {"specimen": {"module": "./story.tsx", "export": "Default"}},
      "expect": [{"kind": "role", "role": "toolbar", "name": "Editor toolbar"}],
      "role": "axis",
      "mode": "pinned"
    },
    {
      "id": "size",
      "name": "Size axis",
      "axis": "size",
      "covers": {"size": ["xs", "sm", "md"]},
      "args": {},
      "composition": {"specimen": {"module": "./story.tsx", "export": "Default"}},
      "expect": [{"kind": "role", "role": "toolbar", "name": "Editor toolbar"}],
      "role": "axis",
      "mode": "pinned"
    }
    ,
    {"id":"empty","name":"Empty toolbar","args":{"children":""},"expect":[{"kind":"role","name":"Editor toolbar","role":"toolbar"}],"role":"boundary","mode":"pinned"},
    {"id":"one","name":"One toolbar action","args":{"children":["Save"]},"expect":[{"kind":"role","name":"Editor toolbar","role":"toolbar"}],"role":"boundary","mode":"pinned"},
    {"id":"many","name":"Many toolbar actions","args":{"children":["Save","Undo","Redo","Publish"]},"expect":[{"kind":"role","name":"Editor toolbar","role":"toolbar"}],"role":"boundary","mode":"pinned"},
    {"id":"overflow","name":"Long toolbar action","args":{"children":["A deliberately long toolbar action label that must wrap cleanly"]},"expect":[{"kind":"role","name":"Editor toolbar","role":"toolbar"}],"role":"boundary","mode":"pinned"}
  ],
  "title": "Toolbar"
}
