{
  "schemaVersion": 3,
  "kind": "component",
  "title": "TreeView",
  "args": {
    "fields": [
      {
        "path": "label",
        "kind": "text",
        "default": "Project files"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "default",
      "name": "Expanded project",
      "args": {
        "label": "Project files",
        "items": [
          {
            "id": "src",
            "label": "src",
            "defaultExpanded": true,
            "children": [
              {
                "id": "app",
                "label": "App.tsx"
              },
              {
                "id": "styles",
                "label": "styles.css"
              }
            ]
          },
          {
            "id": "package",
            "label": "package.json"
          }
        ]
      },
      "expect": [
        {
          "kind": "role",
          "role": "tree",
          "name": "Project files"
        },
        {
          "kind": "role",
          "role": "treeitem",
          "name": "src"
        },
        {
          "kind": "role",
          "role": "treeitem",
          "name": "App.tsx"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "collapsed",
      "name": "Collapsed folders",
      "args": {
        "label": "Project files",
        "items": [
          {
            "id": "src",
            "label": "src",
            "children": [
              {
                "id": "app",
                "label": "App.tsx"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "kind": "role",
          "role": "tree",
          "name": "Project files"
        },
        {
          "kind": "attribute",
          "selector": "[role=treeitem]",
          "name": "aria-expanded",
          "value": "false"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "empty",
      "name": "Empty",
      "args": {
        "label": "Project files",
        "items": []
      },
      "expect": [
        {
          "kind": "role",
          "role": "tree",
          "name": "Project files"
        },
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "mode": "pinned"
    }
  ]
}
