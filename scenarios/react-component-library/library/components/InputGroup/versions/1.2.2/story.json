{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "schemaVersion": 5,
  "kind": "component",
  "title": "InputGroup",
  "args": {
    "fields": []
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "default",
      "name": "One control, nothing attached",
      "role": "anatomy",
      "mode": "live",
      "description": "The group renders its own shell and hands the input its geometry, so a bare group is still a usable field.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "Default"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "visible",
          "selector": "[data-rcl-input-group]"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-shape",
          "value": "rounded"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-size",
          "value": "md"
        },
        {
          "kind": "role",
          "role": "textbox",
          "name": "Message"
        }
      ]
    },
    {
      "id": "prefix-and-segment",
      "name": "Prefix and joined segment",
      "role": "boundary",
      "mode": "live",
      "description": "A leading adornment is a real part of the field, and a trailing segment shares the same border rather than sitting beside it.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "PrefixAndSegment"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-rcl-input-group-adornment]",
          "attribute": "data-side",
          "value": "leading"
        },
        {
          "kind": "attribute",
          "selector": "[data-rcl-input-group-adornment]",
          "attribute": "aria-hidden",
          "value": "true"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-launch']",
          "attribute": "data-side",
          "value": "trailing"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-launch']",
          "attribute": "data-emphasis",
          "value": "solid"
        },
        {
          "kind": "count",
          "selector": "[data-rcl-input-group] [data-rcl-input]",
          "value": "1"
        }
      ]
    },
    {
      "id": "composer-actions",
      "name": "Two actions, anchored apart",
      "role": "boundary",
      "mode": "live",
      "description": "On a field that grows, one action holds the top corner and the other holds the bottom. A single centred slot cannot express both.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "ComposerActions"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-expand-slot']",
          "attribute": "data-align",
          "value": "start"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-send-slot']",
          "attribute": "data-align",
          "value": "end"
        },
        {
          "kind": "count",
          "selector": "[data-rcl-input-group-action]",
          "value": "2"
        },
        {
          "kind": "role",
          "role": "button",
          "name": "Send"
        }
      ]
    },
    {
      "id": "joined-steppers",
      "name": "Steppers either side of a value",
      "role": "boundary",
      "mode": "live",
      "description": "Pressing a segment changes the value it is joined to, and the segment disables itself at the bound rather than clamping silently.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "JoinedSteppers"
        }
      },
      "interactions": [
        {
          "kind": "click",
          "target": {
            "selector": "[data-testid='story-increase']"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-value']",
          "attribute": "value",
          "value": "15"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-shape",
          "value": "pill"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-decrease']",
          "attribute": "data-side",
          "value": "leading"
        },
        {
          "kind": "text",
          "value": "px"
        }
      ]
    },
    {
      "id": "invalid",
      "name": "Invalid recolours the shared border",
      "role": "boundary",
      "mode": "live",
      "description": "Validity belongs to the group, so the whole control reads as invalid instead of one child of it.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "Invalid"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-tone",
          "value": "invalid"
        },
        {
          "kind": "attribute",
          "selector": "[data-rcl-input-group] [data-rcl-input]",
          "attribute": "aria-invalid",
          "value": "true"
        }
      ]
    },
    {
      "id": "disabled",
      "name": "Disabled reaches every part",
      "role": "boundary",
      "mode": "live",
      "description": "A disabled group marks itself for assistive technology and disables the segments it owns, without forging disabled state onto controls it does not.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "Disabled"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-disabled",
          "value": "true"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "aria-disabled",
          "value": "true"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-launch']",
          "attribute": "disabled"
        }
      ]
    },
    {
      "id": "grown-actions",
      "name": "Grown, actions take a row",
      "role": "boundary",
      "mode": "live",
      "description": "A fixed action lane is right at one row and wrong at four; grown, the field claims the whole line and the actions drop beneath it.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "GrownActions"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-grown",
          "value": "true"
        },
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-shape",
          "value": "pill"
        },
        {
          "kind": "count",
          "selector": "[data-rcl-input-group-action]",
          "value": "2"
        },
        {
          "kind": "role",
          "role": "button",
          "name": "Send"
        },
        {
          "kind": "role",
          "role": "button",
          "name": "Expand"
        }
      ]
    },
    {
      "id": "pill-at-rest",
      "name": "Pill at rest keeps its lane",
      "role": "boundary",
      "mode": "live",
      "description": "Without the grown flag the actions stay inline, so the shape change and the layout change are independent decisions.",
      "args": {},
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "PillAtRest"
        }
      },
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "attribute",
          "selector": "[data-testid='story-group']",
          "attribute": "data-shape",
          "value": "pill"
        },
        {
          "kind": "count",
          "selector": "[data-rcl-input-group][data-grown]",
          "value": "0"
        },
        {
          "kind": "role",
          "role": "textbox",
          "name": "Message"
        }
      ]
    }
  ]
}
