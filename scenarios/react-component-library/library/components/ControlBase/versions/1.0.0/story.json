      {
        "path": "children",
        "label": "Children",
        "kind": "structured",
        "required": true,
        "default": {
          "$text": "Continue"
        },
        "format": "renderable-text"
      },
      {
        "path": "variant",
        "label": "Variant",
        "kind": "enum",
        "required": true,
        "default": "primary",
        "options": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ]
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "enum",
