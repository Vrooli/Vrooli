          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ]
      },
      {
        "path": "density",
        "label": "Density",
        "kind": "enum",
        "required": true,
        "default": "comfortable",
        "options": [
          "comfortable",
          "compact"
        ]
      },
      {
        "path": "shape",
        "label": "Shape",
        "kind": "enum",
        "required": true,
        "default": "square",
        "options": [
          "square",
          "pill"
        ]
      },
      {
        "path": "disabled",
        "label": "Disabled",
        "kind": "boolean",
        "default": false
      }
    ]
  },
