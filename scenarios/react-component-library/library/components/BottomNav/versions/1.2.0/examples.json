{
  "examples": [
    {
      "name": "mobile-primary",
      "displayName": "Mobile Primary",
      "props": {
        "label": "Primary navigation",
        "items": [
          { "id": "home", "label": "Home", "href": "#home", "active": true, "icon": { "$icon": "Home" } },
          { "id": "tasks", "label": "Tasks", "href": "#tasks", "icon": { "$icon": "ListTodo" } },
          { "id": "settings", "label": "Settings", "href": "#settings", "icon": { "$icon": "Settings" } }
        ]
      },
      "expect": [
        { "kind": "role", "role": "link", "name": "Home" },
        { "kind": "text", "value": "Tasks" },
        { "kind": "attribute", "selector": "nav", "name": "aria-label", "value": "Primary navigation" }
      ]
    },
    {
      "name": "disabled-item",
      "displayName": "Disabled Item",
      "props": {
        "label": "Workspace navigation",
        "items": [
          { "id": "overview", "label": "Overview", "active": true, "icon": { "$icon": "LayoutDashboard" } },
          { "id": "billing", "label": "Billing", "disabled": true, "icon": { "$icon": "CreditCard" } },
          { "id": "team", "label": "Team", "icon": { "$icon": "Users" } }
        ]
      },
      "expect": [
        { "kind": "role", "role": "button", "name": "Billing" },
        { "kind": "text", "value": "Overview" }
      ]
    },
    {
      "name": "long-labels",
      "displayName": "Long Labels",
      "props": {
        "label": "Compact navigation",
        "items": [
          { "id": "activity", "label": "Activity", "active": true, "icon": { "$icon": "Activity" } },
          { "id": "automations", "label": "Automations", "icon": { "$icon": "Workflow" } },
          { "id": "integrations", "label": "Integrations", "icon": { "$icon": "Plug" } }
        ]
      },
      "expect": [
        { "kind": "text", "value": "Automations" },
        { "kind": "text", "value": "Integrations" }
      ]
    }
  ]
}
