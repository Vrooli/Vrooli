{
  "schemaVersion": 1,
  "kind": "component",
  "title": "Select",
  "args": {
    "fields": [
        {
          "path": "placeholder",
          "label": "Placeholder",
          "kind": "text",
          "default": "Choose status"
        },
        {
          "path": "options",
          "label": "Options",
          "kind": "structured",
          "default": [
            {
              "value": "current",
              "label": "Current"
            },
            {
              "value": "behind",
              "label": "Behind"
            }
          ]
        },
        {
          "path": "defaultValue",
          "label": "Default Value",
          "kind": "text",
          "default": "native"
        },
        {
          "path": "disabled",
          "label": "Disabled",
          "kind": "boolean",
          "default": true
        }
      ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "with-placeholder",
      "name": "With Placeholder",
      "args": {
        "placeholder": "Choose status",
        "options": [
          {
            "value": "current",
            "label": "Current"
          },
          {
            "value": "behind",
            "label": "Behind"
          }
        ]
      },
      "expect": [
        {
          "kind": "role",
          "role": "combobox"
        },
        {
          "kind": "text",
          "value": "Choose status"
        }
      ]
    },
    {
      "id": "selected",
      "name": "Selected",
      "args": {
        "defaultValue": "native",
        "options": [
          {
            "value": "native",
            "label": "Native"
          },
          {
            "value": "compatible",
            "label": "Compatible"
          }
        ]
      },
      "expect": [
        {
          "kind": "text",
          "value": "Native"
        },
        {
          "kind": "role",
          "role": "combobox"
        }
      ]
    },
    {
      "id": "disabled",
      "name": "Disabled",
      "args": {
        "disabled": true,
        "defaultValue": "locked",
        "options": [
          {
            "value": "locked",
            "label": "Locked"
          },
          {
            "value": "open",
            "label": "Open"
          }
        ]
      },
      "expect": [
        {
          "kind": "attribute",
          "selector": "select",
          "name": "disabled",
          "value": ""
        },
        {
          "kind": "text",
          "value": "Locked"
        }
      ]
    }
  ]
}
