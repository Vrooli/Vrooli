{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "activity",
        "kind": "text",
        "label": "Surface Id",
        "path": "surfaceId"
      },
      {
        "default": "loading",
        "kind": "text",
        "label": "State",
        "path": "state"
      },
      {
        "default": {
          "$text": "p"
        },
        "kind": "structured",
        "label": "Children",
        "path": "children"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "state": "loading",
        "surfaceId": "activity"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Loading…",
          "role": "status"
        }
      ],
      "id": "loading",
      "mode": "pinned",
      "name": "Loading data"
    },
    {
      "args": {
        "children": {
          "$text": "p"
        },
        "state": "ready",
        "surfaceId": "activity"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Recent activity"
        }
      ],
      "id": "ready",
      "mode": "pinned",
      "name": "Ready data"
    },
    {
      "args": {
        "state": "empty",
        "surfaceId": "activity"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Nothing to show yet."
        }
      ],
      "id": "empty",
      "mode": "pinned",
      "name": "Empty result"
    },
    {
      "args": {
        "state": "partial",
        "surfaceId": "activity"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Some information is unavailable.",
          "role": "status"
        }
      ],
      "id": "partial",
      "mode": "pinned",
      "name": "Partial data"
    },
    {
      "args": {
        "state": "error",
        "surfaceId": "activity"
      },
      "expect": [
        {
          "kind": "role",
          "name": "This section could not be loaded.",
          "role": "status"
        }
      ],
      "id": "error",
      "mode": "pinned",
      "name": "Retryable error"
    }
  ],
  "title": "AsyncPanel"
}
