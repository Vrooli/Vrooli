{
  "examples": [
    {
      "name": "notes",
      "displayName": "Notes",
      "props": {
        "placeholder": "Write release notes",
        "defaultValue": "Improves preview coverage."
      },
      "expect": [
        { "kind": "role", "role": "textbox", "name": "Improves preview coverage." },
        { "kind": "attribute", "selector": "textarea", "name": "placeholder", "value": "Write release notes" }
      ]
    },
    {
      "name": "empty",
      "displayName": "Empty",
      "props": {
        "placeholder": "Describe the component"
      },
      "expect": [
        { "kind": "attribute", "selector": "textarea", "name": "placeholder", "value": "Describe the component" }
      ]
    },
    {
      "name": "disabled",
      "displayName": "Disabled",
      "props": {
        "defaultValue": "Locked by release",
        "disabled": true
      },
      "expect": [
        { "kind": "attribute", "selector": "textarea", "name": "disabled", "value": "" },
        { "kind": "text", "value": "Locked by release" }
      ]
    }
  ]
}
