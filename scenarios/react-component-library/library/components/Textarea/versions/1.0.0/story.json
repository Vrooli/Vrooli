{
  "schemaVersion": 1,
  "kind": "component",
  "title": "Textarea",
  "args": {
    "fields": [
        {
          "path": "placeholder",
          "label": "Placeholder",
          "kind": "text",
          "default": "Write release notes"
        },
        {
          "path": "defaultValue",
          "label": "Default Value",
          "kind": "text",
          "default": "Improves preview coverage."
        },
        {
          "path": "disabled",
          "label": "Disabled",
          "kind": "boolean",
          "default": true
        }
      ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "notes",
      "name": "Notes",
      "args": {
        "placeholder": "Write release notes",
        "defaultValue": "Improves preview coverage.",
        "aria-label": "Release notes"
      },
      "expect": [
        {
          "kind": "role",
          "role": "textbox",
          "name": "Release notes"
        },
        {
          "kind": "attribute",
          "selector": "textarea",
          "name": "placeholder",
          "value": "Write release notes"
        }
      ]
    },
    {
      "id": "empty",
      "name": "Empty",
      "args": {
        "placeholder": "Describe the component",
        "aria-label": "Component description"
      },
      "expect": [
        {
          "kind": "attribute",
          "selector": "textarea",
          "name": "placeholder",
          "value": "Describe the component"
        }
      ]
    },
    {
      "id": "disabled",
      "name": "Disabled",
      "args": {
        "defaultValue": "Locked by release",
        "disabled": true
      },
      "expect": [
        {
          "kind": "attribute",
          "selector": "textarea",
          "name": "disabled",
          "value": ""
        },
        {
          "kind": "text",
          "value": "Locked by release"
        }
      ]
    }
  ]
}
