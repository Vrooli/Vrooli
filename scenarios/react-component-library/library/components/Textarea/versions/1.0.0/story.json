{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Write release notes",
        "kind": "text",
        "label": "Placeholder",
        "path": "placeholder"
      },
      {
        "default": "Improves preview coverage.",
        "kind": "text",
        "label": "Default Value",
        "path": "defaultValue"
      },
      {
        "default": true,
        "kind": "boolean",
        "label": "Disabled",
        "path": "disabled"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "aria-label": "Release notes",
        "defaultValue": "Improves preview coverage.",
        "placeholder": "Write release notes"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Release notes",
          "role": "textbox"
        },
        {
          "kind": "attribute",
          "name": "placeholder",
          "selector": "textarea",
          "value": "Write release notes"
        }
      ],
      "id": "notes",
      "mode": "pinned",
      "name": "Notes",
      "role": "anatomy"
    },
    {
      "args": {
        "placeholder": "Describe the component"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "placeholder",
          "selector": "textarea",
          "value": "Describe the component"
        }
      ],
      "id": "empty",
      "mode": "pinned",
      "name": "Empty",
      "role": "boundary"
    },
    {
      "args": {
        "defaultValue": "Locked by release",
        "disabled": true
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "disabled",
          "selector": "textarea",
          "value": ""
        },
        {
          "kind": "text",
          "value": "Locked by release"
        }
      ],
      "id": "disabled",
      "mode": "pinned",
      "name": "Disabled",
      "role": "boundary"
    }
  ],
  "title": "Textarea"
}
