          "target": {
            "role": "gridcell",
            "name": "Wednesday, August 12, 2026"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "expect": [
        {
          "kind": "text",
          "value": "1 date selected"
        },
        {
          "kind": "text",
          "value": "Wednesday, August 12, 2026"
        }
