{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": []
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "August 2026",
          "role": "grid"
        },
        {
          "kind": "role",
          "name": "Wednesday, August 12, 2026",
          "role": "gridcell"
        }
      ],
      "id": "default",
      "mode": "live",
      "name": "Single date"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Range",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "2 dates selected"
        },
        {
          "kind": "role",
          "name": "Tuesday, August 18, 2026",
          "role": "gridcell"
        }
      ],
      "id": "range",
      "mode": "live",
      "name": "Date range"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Multiple",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "3 dates selected"
        },
        {
          "kind": "role",
          "name": "August 2026",
          "role": "grid"
        }
      ],
      "id": "multiple",
      "mode": "live",
      "name": "Multiple dates"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Constrained",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "August 2026",
          "role": "grid"
        },
        {
          "kind": "text",
          "value": "No date selected"
        }
      ],
      "id": "constrained",
      "mode": "live",
      "name": "Constrained"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "1 date selected"
        },
        {
          "kind": "text",
          "value": "Wednesday, August 12, 2026"
        }
      ],
      "id": "interactive",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Wednesday, August 12, 2026",
            "role": "gridcell"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Interactive selection"
    }
  ],
  "title": "Calendar"
}
