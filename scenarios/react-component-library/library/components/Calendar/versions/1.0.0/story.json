      "name": "Date range",
      "harness": "Range",
      "args": {},
      "expect": [
        {
          "kind": "text",
          "value": "2 dates selected"
        },
        {
          "kind": "role",
          "role": "gridcell",
          "name": "Tuesday, August 18, 2026"
        }
      ],
      "mode": "live"
    },
    {
      "id": "multiple",
      "name": "Multiple dates",
      "harness": "Multiple",
      "args": {},
      "expect": [
        {
          "kind": "text",
          "value": "3 dates selected"
        },
        {
          "kind": "role",
          "role": "grid",
          "name": "August 2026"
        }
      ],
      "mode": "live"
    },
    {
      "id": "constrained",
      "name": "Constrained",
      "harness": "Constrained",
      "args": {},
