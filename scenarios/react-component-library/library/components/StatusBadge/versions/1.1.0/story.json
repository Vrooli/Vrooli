{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "success",
        "kind": "enum",
        "label": "Tone",
        "options": [
          "success",
          "warning",
          "info",
          "danger"
        ],
        "path": "tone",
        "required": true
      },
      {
        "default": "Current",
        "kind": "structured",
        "label": "Label",
        "path": "children",
        "required": true
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "children": "Current",
        "tone": "success"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Current"
        }
      ],
      "id": "success",
      "mode": "pinned",
      "name": "Success",
      "role": "anatomy"
    },
    {
      "args": {
        "children": "Behind",
        "tone": "warning"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Behind"
        }
      ],
      "id": "warning",
      "mode": "pinned",
      "name": "Warning",
      "role": "axis",
      "axis": "tone",
      "covers": {
        "tone": [
          "success",
          "warning",
          "info",
          "danger"
        ]
      }
    },
    {
      "args": {
        "children": "Requires manual review",
        "tone": "info"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Requires manual review"
        }
      ],
      "id": "long-label",
      "mode": "pinned",
      "name": "Long Label",
      "role": "boundary"
    },
    {
      "args": {
        "children": "Blocked",
        "tone": "danger"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Blocked"
        }
      ],
      "id": "danger",
      "mode": "pinned",
      "name": "Danger",
      "role": "boundary"
    }
  ],
  "title": "Status Badge"
}
