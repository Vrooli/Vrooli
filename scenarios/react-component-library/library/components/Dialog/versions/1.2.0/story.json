{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": true,
        "kind": "boolean",
        "label": "Open",
        "path": "open"
      },
      {
        "default": "Archive component",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": "This keeps prior versions available for audit.",
        "kind": "text",
        "label": "Description",
        "path": "description"
      },
      {
        "default": {
          "$text": "Archive Button v1.0.0?"
        },
        "kind": "structured",
        "label": "Children",
        "path": "children"
      },
      {
        "default": {
          "$text": "button"
        },
        "kind": "structured",
        "label": "Footer",
        "path": "footer"
      },
      {
        "default": {
          "$handler": "close"
        },
        "kind": "structured",
        "label": "On Close",
        "path": "onClose"
      },
      {
        "default": "Close dialog",
        "kind": "text",
        "label": "Close Label",
        "path": "closeLabel"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$text": "Archive Button v1.0.0?"
        },
        "closeLabel": "Close dialog",
        "description": "This keeps prior versions available for audit.",
        "footer": {
          "$text": "button"
        },
        "onClose": {
          "$handler": "close"
        },
        "open": false,
        "title": "Archive component"
      },
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Archive component",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Archive Button v1.0.0?"
        }
      ],
      "id": "confirm-open",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Open dialog",
            "role": "button"
          }
        }
      ],
      "mode": "live",
      "name": "Confirm Open"
    },
    {
      "args": {
        "children": {
          "$text": "Used by 14 scenarios"
        },
        "closeLabel": "Close details",
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Component details"
      },
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Used by 14 scenarios"
        },
        {
          "kind": "role",
          "name": "Component details",
          "role": "dialog"
        }
      ],
      "id": "details-open",
      "interactions": [],
      "mode": "live",
      "name": "Details open baseline"
    },
    {
      "args": {
        "children": {
          "$text": "Short confirmation copy"
        },
        "closeLabel": "Close",
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Minimal dialog"
      },
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Minimal dialog",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Short confirmation copy"
        }
      ],
      "id": "minimal-open",
      "interactions": [],
      "mode": "live",
      "name": "Minimal open dialog"
    },
    {
      "args": {
        "children": {
          "$text": "Used by 14 scenarios"
        },
        "closeLabel": "Close details",
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Component details"
      },
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "notVisible",
          "name": "Component details",
          "role": "dialog"
        }
      ],
      "id": "close-details",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Close details",
            "role": "button"
          }
        }
      ],
      "mode": "live",
      "name": "Close button dismisses details"
    },
    {
      "args": {
        "children": {
          "$text": "Short confirmation copy"
        },
        "closeLabel": "Close",
        "onClose": {
          "$handler": "close"
        },
        "open": true,
        "title": "Minimal dialog"
      },
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "notVisible",
          "name": "Minimal dialog",
          "role": "dialog"
        }
      ],
      "id": "escape-close",
      "interactions": [
        {
          "kind": "key",
          "target": {
            "name": "Minimal dialog",
            "role": "dialog"
          },
          "text": "Escape"
        }
      ],
      "mode": "live",
      "name": "Escape dismisses dialog"
    }
  ],
  "title": "Dialog"
}
