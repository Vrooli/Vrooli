{
  "schemaVersion": 3,
  "kind": "component",
  "title": "Dialog",
  "args": {
    "fields": [
      {
        "path": "open",
        "label": "Open",
        "kind": "boolean",
        "default": true
      },
      {
        "path": "title",
        "label": "Title",
        "kind": "text",
        "default": "Archive component"
      },
      {
        "path": "description",
        "label": "Description",
        "kind": "text",
        "default": "This keeps prior versions available for audit."
      },
      {
        "path": "children",
        "label": "Children",
        "kind": "structured",
        "default": {
          "$text": "Archive Button v1.0.0?"
        }
      },
      {
        "path": "footer",
        "label": "Footer",
        "kind": "structured",
        "default": {
          "$node": "button",
          "props": {
            "type": "button",
            "className": "rounded-control bg-app-primary px-3 py-2 text-app-primary-foreground"
          },
          "children": [
            {
              "$text": "Archive"
            }
          ]
        }
      },
      {
        "path": "onClose",
        "label": "On Close",
        "kind": "structured",
        "default": {
          "$handler": "close"
        }
      },
      {
        "path": "closeLabel",
        "label": "Close Label",
        "kind": "text",
        "default": "Close dialog"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "confirm-open",
      "name": "Confirm Open",
      "args": {
        "open": true,
        "title": "Archive component",
        "description": "This keeps prior versions available for audit.",
        "children": {
          "$text": "Archive Button v1.0.0?"
        },
        "footer": {
          "$node": "button",
          "props": {
            "type": "button",
            "className": "rounded-control bg-app-primary px-3 py-2 text-app-primary-foreground"
          },
          "children": [
            {
              "$text": "Archive"
            }
          ]
        },
        "onClose": {
          "$handler": "close"
        },
        "closeLabel": "Close dialog"
      },
      "expect": [
        {
          "kind": "role",
          "role": "dialog",
          "name": "Archive component"
        },
        {
          "kind": "text",
          "value": "Archive Button v1.0.0?"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "details-open",
      "name": "Details Open",
      "args": {
        "open": true,
        "title": "Component details",
        "children": {
          "$text": "Used by 14 scenarios"
        },
        "onClose": {
          "$handler": "close"
        },
        "closeLabel": "Close details"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Used by 14 scenarios"
        },
        {
          "kind": "role",
          "role": "dialog",
          "name": "Component details"
        }
      ],
      "mode": "pinned"
    },
    {
      "id": "minimal-open",
      "name": "Minimal Open",
      "args": {
        "open": true,
        "title": "Minimal dialog",
        "children": {
          "$text": "Short confirmation copy"
        },
        "onClose": {
          "$handler": "close"
        },
        "closeLabel": "Close"
      },
      "expect": [
        {
          "kind": "role",
          "role": "dialog",
          "name": "Minimal dialog"
        },
        {
          "kind": "text",
          "value": "Short confirmation copy"
        }
      ],
      "mode": "pinned"
    }
  ]
}
