{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "#4dabf7",
        "kind": "text",
        "path": "value"
      },
      {
        "default": [
          "#4dabf7",
          "#51cf66",
          "#ff6b6b"
        ],
        "kind": "array",
        "path": "palette"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "palette": [
          "#4dabf7",
          "#51cf66",
          "#ff6b6b"
        ],
        "value": "#4dabf7"
      },
      "composition": {
        "specimen": {
          "export": "ControlledWithRecents",
          "module": "./story.tsx"
        }
      },
      "description": "A compact palette with transparent and custom-color choices.",
      "expect": [
        {
          "kind": "role",
          "name": "#4dabf7",
          "role": "button"
        }
      ],
      "id": "palette",
      "mode": "live",
      "name": "Palette",
      "role": "anatomy"
    },
    {
      "args": {
        "palette": [
          "#4dabf7",
          "#51cf66",
          "#ff6b6b"
        ],
        "value": "#4dabf7"
      },
      "composition": {
        "specimen": {
          "export": "ControlledWithRecents",
          "module": "./story.tsx"
        }
      },
      "description": "A controlled harness exposes the selected color and records committed choices.",
      "expect": [
        {
          "kind": "text",
          "value": "Selected: #51cf66"
        }
      ],
      "id": "controlled-with-recents",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "#51cf66",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Controlled with recents",
      "role": "boundary"
    },
    {
      "args": {
        "palette": [
          "#4dabf7",
          "#51cf66",
          "#ff6b6b"
        ],
        "value": "#4dabf7"
      },
      "composition": {
        "specimen": {
          "export": "RecentsCommitOnBlur",
          "module": "./story.tsx"
        }
      },
      "description": "Native picker changes are committed to recents once when the input loses focus.",
      "expect": [
        {
          "kind": "text",
          "value": "Recent: #ff6b6b"
        }
      ],
      "id": "recents-commit-on-blur",
      "interactions": [
        {
          "kind": "type",
          "target": {
            "selector": "[data-testid='forms.color-picker-color-picker-custom-input']"
          },
          "text": "#ff6b6b"
        },
        {
          "kind": "blur",
          "target": {
            "selector": "[data-testid='forms.color-picker-color-picker-custom-input']"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Custom color records on blur",
      "role": "boundary"
    }
  ]
}
