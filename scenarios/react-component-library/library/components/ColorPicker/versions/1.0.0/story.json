{
  "schemaVersion": 2,
  "kind": "component",
  "args": { "fields": [
    { "path": "value", "kind": "text", "default": "#4dabf7" },
    { "path": "palette", "kind": "array", "default": ["#4dabf7", "#51cf66", "#ff6b6b"] }
  ] },
  "environment": { "fixtures": [] },
  "stories": [
    { "id": "palette", "name": "Palette", "description": "A compact palette with transparent and custom-color choices.", "args": { "value": "#4dabf7", "palette": ["#4dabf7", "#51cf66", "#ff6b6b"] }, "expect": [{ "kind": "role", "role": "button", "name": "#4dabf7" }] },
    { "id": "controlled-with-recents", "name": "Controlled with recents", "description": "A controlled harness exposes the selected color and records committed choices.", "harness": "ControlledWithRecents", "args": { "value": "#4dabf7", "palette": ["#4dabf7", "#51cf66", "#ff6b6b"] }, "interactions": [{ "kind": "click", "target": { "role": "button", "name": "#51cf66" } }, { "kind": "settle" }], "expect": [{ "kind": "text", "value": "Selected: #51cf66" }] },
    { "id": "recents-commit-on-blur", "name": "Custom color records on blur", "description": "Native picker changes are committed to recents once when the input loses focus.", "harness": "RecentsCommitOnBlur", "args": { "value": "#4dabf7", "palette": ["#4dabf7", "#51cf66", "#ff6b6b"] }, "interactions": [{ "kind": "type", "target": { "selector": "[data-testid=color-picker-custom-input]" }, "text": "#ff6b6b" }, { "kind": "blur", "target": { "selector": "[data-testid=color-picker-custom-input]" } }, { "kind": "settle" }], "expect": [{ "kind": "text", "value": "Recent: #ff6b6b" }] }
  ]
}
