{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "path": "selectedCount",
        "kind": "number",
        "default": 8
      },
      {
        "path": "totalCount",
        "kind": "number",
        "default": 24
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "default",
        "actionLabel": "Archive selected"
      },
      "expect": [
        {
          "kind": "text",
          "value": "8 items selected"
        },
        {
          "kind": "role",
          "name": "Archive selected",
          "role": "button"
        }
      ],
      "id": "default",
      "name": "Selection actions",
      "role": "anatomy"
    },
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "submitting",
        "actionLabel": "Archive selected",
        "progress": {
          "completed": 5,
          "total": 8,
          "label": "Archiving 5 of 8 records\u2026"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "5 of 8"
        }
      ],
      "id": "submitting",
      "name": "Submitting",
      "role": "boundary"
    },
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "success",
        "actionLabel": "Archive selected",
        "successMessage": "Eight records were archived."
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "Eight records were archived"
        }
      ],
      "id": "success",
      "name": "Success",
      "role": "boundary"
    },
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "partial",
        "actionLabel": "Archive selected",
        "failedItems": [
          "Untitled release notes",
          "Arabic workspace handoff"
        ],
        "errorMessage": "Six records were updated; these two need attention."
      },
      "expect": [
        {
          "kind": "role",
          "role": "alert"
        },
        {
          "kind": "text",
          "value": "Untitled release notes"
        },
        {
          "kind": "role",
          "name": "Retry failed items",
          "role": "button"
        }
      ],
      "id": "partial",
      "name": "Partial failure",
      "role": "boundary"
    },
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "request-error",
        "actionLabel": "Archive selected",
        "errorMessage": "The archive service did not respond. Nothing was changed."
      },
      "expect": [
        {
          "kind": "role",
          "role": "alert"
        },
        {
          "kind": "role",
          "name": "Retry failed items",
          "role": "button"
        }
      ],
      "id": "request-error",
      "name": "Request error",
      "role": "boundary"
    },
    {
      "args": {
        "selectedCount": 8,
        "totalCount": 24,
        "status": "retry",
        "actionLabel": "Archive selected"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Ready to retry"
        },
        {
          "kind": "role",
          "name": "Retry failed items",
          "role": "button"
        }
      ],
      "id": "retry",
      "name": "Retry",
      "role": "boundary"
    },
    {
      "args": {},
      "composition": {
        "specimen": {
          "export": "Interactive",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        },
        {
          "kind": "text",
          "value": "Eight records were archived."
        }
      ],
      "id": "interactive",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Archive selected",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        },
        {
          "kind": "waitFor",
          "text": "500"
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Interactive lifecycle",
      "role": "boundary"
    },
    {
      "id": "disabled",
      "name": "Disabled",
      "args": {"selectedCount": 8, "totalCount": 24, "disabled": true},
      "expect": [{"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "empty",
      "name": "Empty selection",
      "args": {"selectedCount": 0, "totalCount": 24},
      "expect": [{"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "loading",
      "name": "Loading",
      "args": {"selectedCount": 8, "totalCount": 24, "status": "submitting", "progress": {"completed": 5, "total": 8, "label": "Archiving 5 of 8 records…"}},
      "expect": [{"kind": "role", "role": "status"}, {"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "one",
      "name": "One selected item",
      "args": {"selectedCount": 1, "totalCount": 24},
      "expect": [{"kind": "text", "value": "1 item selected"}, {"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "many",
      "name": "Many selected items",
      "args": {"selectedCount": 240, "totalCount": 240},
      "expect": [{"kind": "text", "value": "240 items selected"}, {"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    },
    {
      "id": "overflow",
      "name": "Long selection copy",
      "args": {"selectedCount": 240, "totalCount": 1000, "description": "This selection contains a deliberately long recovery explanation so the action surface must wrap its copy without losing the decision or its controls."},
      "expect": [{"kind": "visible", "selector": "[data-rcl-bulk-action-bar]"}],
      "role": "boundary",
      "mode": "pinned"
    }
  ],
  "title": "BulkActionBar"
}
