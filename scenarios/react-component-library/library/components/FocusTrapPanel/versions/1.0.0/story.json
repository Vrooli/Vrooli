{
  "schemaVersion": 1,
  "kind": "component",
  "title": "FocusTrapPanel",
  "args": {
    "fields": [
      {"path": "open", "label": "Open", "kind": "boolean", "default": true},
      {"path": "children", "label": "Content", "kind": "structured", "default": {"$text": "Trapped panel content"}}
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "open",
      "name": "Open",
      "args": {"open": true, "children": {"$text": "Trapped panel content"}},
      "expect": [{"kind": "role", "role": "dialog"}, {"kind": "text", "value": "Trapped panel content"}]
    },
    {
      "id": "closed",
      "name": "Closed",
      "args": {"open": false, "children": {"$text": "Trapped panel content"}},
      "expect": [{"kind": "notVisible", "selector": "[role=dialog]"}]
    }
  ]
}
