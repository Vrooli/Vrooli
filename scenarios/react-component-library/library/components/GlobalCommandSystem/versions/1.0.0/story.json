    {
      "id": "interactive",
      "name": "Keyboard execution",
      "harness": "Interactive",
      "args": {},
      "interactions": [
        {
          "kind": "click",
          "target": {
            "role": "button",
            "name": "Open command palette"
          }
        },
        {
          "kind": "settle"
        },
        {
          "kind": "type",
          "target": {
