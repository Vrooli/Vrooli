{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Close panel",
        "kind": "text",
        "label": "Accessible label",
        "path": "aria-label"
      },
      {
        "default": {
          "$icon": "X"
        },
        "kind": "structured",
        "label": "Icon",
        "path": "children"
      },
      {
        "default": "ghost",
        "kind": "enum",
        "label": "Variant",
        "options": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ],
        "path": "variant",
        "required": true
      },
      {
        "default": "icon",
        "kind": "enum",
        "label": "Size",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ],
        "path": "size",
        "required": true
      },
      {
        "default": "comfortable",
        "kind": "enum",
        "label": "Density",
        "options": [
          "comfortable",
          "compact"
        ],
        "path": "density",
        "required": true
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Disabled",
        "path": "disabled"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "children": {
          "$icon": "Play"
        },
        "variant": "primary"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Play",
          "role": "button"
        }
      ],
      "id": "variant-primary",
      "mode": "pinned",
      "name": "Primary"
    },
    {
      "args": {
        "children": {
          "$icon": "Settings"
        },
        "variant": "secondary"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Settings",
          "role": "button"
        }
      ],
      "id": "variant-secondary",
      "mode": "pinned",
      "name": "Secondary"
    },
    {
      "args": {
        "children": {
          "$icon": "X"
        },
        "variant": "ghost"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Close",
          "role": "button"
        }
      ],
      "id": "variant-ghost",
      "mode": "pinned",
      "name": "Ghost"
    },
    {
      "args": {
        "children": {
          "$icon": "Trash2"
        },
        "variant": "danger"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Delete",
          "role": "button"
        }
      ],
      "id": "variant-danger",
      "mode": "pinned",
      "name": "Danger"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "xs"
      },
      "expect": [
        {
          "kind": "role",
          "name": "XS",
          "role": "button"
        }
      ],
      "id": "size-xs",
      "mode": "pinned",
      "name": "XS"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "sm"
      },
      "expect": [
        {
          "kind": "role",
          "name": "SM",
          "role": "button"
        }
      ],
      "id": "size-sm",
      "mode": "pinned",
      "name": "SM"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "md"
      },
      "expect": [
        {
          "kind": "role",
          "name": "MD",
          "role": "button"
        }
      ],
      "id": "size-md",
      "mode": "pinned",
      "name": "MD"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "lg"
      },
      "expect": [
        {
          "kind": "role",
          "name": "LG",
          "role": "button"
        }
      ],
      "id": "size-lg",
      "mode": "pinned",
      "name": "LG"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "xl"
      },
      "expect": [
        {
          "kind": "role",
          "name": "XL",
          "role": "button"
        }
      ],
      "id": "size-xl",
      "mode": "pinned",
      "name": "XL"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "size": "icon"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Icon",
          "role": "button"
        }
      ],
      "id": "size-icon",
      "mode": "pinned",
      "name": "Icon"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "density": "comfortable"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Comfortable",
          "role": "button"
        }
      ],
      "id": "density-comfortable",
      "mode": "pinned",
      "name": "Comfortable"
    },
    {
      "args": {
        "children": {
          "$icon": "Circle"
        },
        "density": "compact"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Compact",
          "role": "button"
        }
      ],
      "id": "density-compact",
      "mode": "pinned",
      "name": "Compact"
    }
  ],
  "title": "IconButton 2.0"
}
