{
  "schemaVersion": 3,
  "kind": "component",
  "title": "IconButton 2.0",
  "args": {
    "fields": [
      {
        "path": "aria-label",
        "label": "Accessible label",
        "kind": "text",
        "default": "Close panel"
      },
      {
        "path": "children",
        "label": "Icon",
        "kind": "structured",
        "default": {
          "$icon": "X"
        }
      },
      {
        "path": "variant",
        "label": "Variant",
        "kind": "enum",
        "required": true,
        "default": "ghost",
        "options": [
          "primary",
          "secondary",
          "ghost",
          "danger"
        ]
      },
      {
        "path": "size",
        "label": "Size",
        "kind": "enum",
        "required": true,
        "default": "icon",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl",
          "icon"
        ]
      },
      {
        "path": "density",
        "label": "Density",
        "kind": "enum",
        "required": true,
        "default": "comfortable",
        "options": [
          "comfortable",
          "compact"
        ]
      },
      {
        "path": "disabled",
        "label": "Disabled",
        "kind": "boolean",
        "default": false
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "stories": [
    {
      "id": "variant-primary",
      "name": "Primary",
      "args": {
        "aria-label": "Play",
        "children": {
          "$icon": "Play"
        },
        "variant": "primary"
      },
      "expect": [
        {
          "kind": "role",
          "role": "button",
          "name": "Play"
        }
      ],
      "mode": "pinned"
    },
    {
