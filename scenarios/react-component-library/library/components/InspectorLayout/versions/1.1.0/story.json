{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Workflow editor",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": {
          "$text": "button"
        },
        "kind": "structured",
        "label": "Toolbar",
        "path": "toolbar"
      },
      {
        "default": {
          "$text": "p"
        },
        "kind": "structured",
        "label": "Canvas",
        "path": "canvas"
      },
      {
        "default": {
          "$text": "p"
        },
        "kind": "structured",
        "label": "Inspector",
        "path": "inspector"
      },
      {
        "default": "ready",
        "kind": "text",
        "label": "Inspector State",
        "path": "inspectorState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "canvas": {
          "$text": "p"
        },
        "inspector": {
          "$text": "p"
        },
        "inspectorSurfaceId": "inspector",
        "title": "Workflow editor",
        "toolbar": {
          "$text": "button"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "main"
        },
        {
          "kind": "text",
          "value": "Workflow canvas"
        },
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"inspector\"]",
          "value": "ready"
        }
      ],
      "id": "ready-inspector",
      "mode": "pinned",
      "name": "Ready inspector"
    },
    {
      "args": {
        "canvas": {
          "$text": "p"
        },
        "inspectorState": "empty",
        "title": "Workflow editor"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Nothing to show yet."
        }
      ],
      "id": "empty-inspector",
      "mode": "pinned",
      "name": "Empty inspector"
    },
    {
      "args": {
        "canvas": {
          "$text": "p"
        },
        "inspector": {
          "$text": "p"
        },
        "inspectorState": "loading",
        "title": "Workflow editor"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"inspector\"]",
          "value": "loading"
        }
      ],
      "id": "loading-inspector",
      "mode": "pinned",
      "name": "Loading inspector"
    },
    {
      "args": {
        "canvas": {
          "$text": "p"
        },
        "inspector": {
          "$text": "p"
        },
        "inspectorState": "partial",
        "title": "Workflow editor"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"inspector\"]",
          "value": "partial"
        }
      ],
      "id": "partial-inspector",
      "mode": "pinned",
      "name": "Partial inspector"
    },
    {
      "args": {
        "canvas": {
          "$text": "p"
        },
        "inspector": {
          "$text": "p"
        },
        "inspectorState": "error",
        "title": "Workflow editor"
      },
      "expect": [
        {
          "kind": "attribute",
          "name": "data-experience-state",
          "selector": "[data-experience-surface=\"inspector\"]",
          "value": "error"
        }
      ],
      "id": "error-inspector",
      "mode": "pinned",
      "name": "Inspector error"
    }
  ],
  "title": "InspectorLayout"
}
