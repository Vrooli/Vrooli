{
 "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
 "schemaVersion": 5,
 "kind": "component",
 "title": "SidebarShell",
 "args": {
  "fields": []
 },
 "environment": {
  "fixtures": []
 },
 "stories": [
  {
   "id": "default",
   "name": "Persistent and resizable",
   "role": "anatomy",
   "mode": "live",
   "description": "The shell owns the seam: no caller-supplied handle, width or handle-width constant.",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "Default"
    }
   },
   "interactions": [
    {
     "kind": "settle"
    }
   ],
   "expect": [
    {
     "kind": "role",
     "role": "complementary",
     "name": "Navigation"
    },
    {
     "kind": "role",
     "role": "separator",
     "name": "Resize Navigation"
    },
    {
     "kind": "attribute",
     "selector": "[data-testid='navigation.sidebar-resize-handle']",
     "attribute": "aria-valuenow",
     "value": "240"
    }
   ]
  },
  {
   "id": "keyboard-resize",
   "name": "Resized from the keyboard",
   "role": "boundary",
   "mode": "live",
   "description": "The sidebar is resizable without a pointer, which is the part a hand-rolled handle invariably skips.",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "KeyboardResize"
    }
   },
   "interactions": [
    {
     "kind": "key",
     "target": {
      "role": "separator",
      "name": "Resize Navigation"
     },
     "text": "ArrowRight"
    },
    {
     "kind": "key",
     "target": {
      "role": "separator",
      "name": "Resize Navigation"
     },
     "text": "ArrowRight"
    },
    {
     "kind": "settle"
    }
   ],
   "expect": [
    {
     "kind": "attribute",
     "selector": "[data-testid='navigation.sidebar-resize-handle']",
     "attribute": "aria-valuenow",
     "value": "256"
    },
    {
     "kind": "attribute",
     "selector": "[data-testid='navigation.sidebar-resize-handle']",
     "attribute": "aria-valuetext",
     "value": "Navigation 256 pixels"
    }
   ]
  },
  {
   "id": "drawer-open",
   "name": "Mobile drawer",
   "role": "boundary",
   "mode": "live",
   "description": "The same shell as a modal drawer, so an adopting scenario never hand-rolls a second one.",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "DrawerOpen"
    }
   },
   "interactions": [
    {
     "kind": "settle"
    }
   ],
   "expect": [
    {
     "kind": "role",
     "role": "dialog",
     "name": "Navigation drawer"
    },
    {
     "kind": "visible",
     "selector": "[data-testid='navigation.sidebar-backdrop']"
    },
    {
     "kind": "visible",
     "selector": "[data-testid='navigation.sidebar-close']"
    }
   ]
  },
  {
   "id": "legacy-handle",
   "name": "Deprecated handle escape hatch",
   "role": "boundary",
   "mode": "live",
   "description": "A caller still supplying its own handle keeps working for one release, at the derived test id.",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "LegacyHandle"
    }
   },
   "interactions": [
    {
     "kind": "settle"
    }
   ],
   "expect": [
    {
     "kind": "visible",
     "selector": "[data-testid='navigation.sidebar-resize-handle']"
    },
    {
     "kind": "count",
     "selector": "[data-rcl-resize-handle]",
     "value": "0"
    }
   ]
  },
  {
   "id": "swipe-drawer",
   "name": "Swipe drawer with inset width",
   "role": "boundary",
   "mode": "live",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "SwipeDrawer"
    }
   },
   "expect": [
    {
     "kind": "visible",
     "selector": "[data-rcl-sidebar-shell][data-swipe='true']"
    }
   ]
  },
  {
   "id": "swipe-disabled",
   "name": "Swipe disabled",
   "role": "boundary",
   "mode": "live",
   "args": {},
   "composition": {
    "specimen": {
     "module": "./story.tsx",
     "export": "SwipeDisabled"
    }
   },
   "expect": [
    {
     "kind": "visible",
     "selector": "[data-rcl-sidebar-shell][data-mode='overlay']:not([data-swipe])"
    }
   ]
  }
 ]
}
