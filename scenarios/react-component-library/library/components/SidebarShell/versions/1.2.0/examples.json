{
  "examples": [
    {
      "name": "persistent",
      "displayName": "Persistent",
      "props": {
        "mode": "persistent",
        "mobileOpen": false,
        "mobileLabel": "Workspace navigation",
        "desktopLabel": "Workspace",
        "closeLabel": "Close navigation",
        "width": 280,
        "children": { "$node": "nav", "props": { "className": "p-3" }, "children": [{ "$text": "Dashboard Components Adoptions" }] }
      },
      "expect": [
        { "kind": "role", "role": "complementary", "name": "Workspace" },
        { "kind": "text", "value": "Dashboard Components Adoptions" }
      ]
    },
    {
      "name": "overlay-open",
      "displayName": "Overlay Open",
      "props": {
        "mode": "overlay",
        "mobileOpen": true,
        "mobileLabel": "Mobile navigation",
        "closeLabel": "Close menu",
        "mobileHeader": { "$node": "strong", "children": [{ "$text": "Menu" }] },
        "onMobileClose": { "$handler": "close" },
        "children": { "$node": "div", "props": { "className": "p-4" }, "children": [{ "$text": "Settings and account" }] }
      },
      "expect": [
        { "kind": "role", "role": "dialog", "name": "Mobile navigation" },
        { "kind": "text", "value": "Settings and account" }
      ]
    },
    {
      "name": "responsive-closed",
      "displayName": "Responsive Closed",
      "props": {
        "mode": "responsive",
        "mobileOpen": false,
        "mobileLabel": "Scenario navigation",
        "desktopLabel": "Scenario",
        "closeLabel": "Close menu",
        "onMobileClose": { "$handler": "close" },
        "children": { "$node": "div", "props": { "className": "p-4" }, "children": [{ "$text": "Scenario links" }] }
      },
      "expect": [
        { "kind": "text", "value": "Scenario links" },
        { "kind": "attribute", "selector": "[data-testid='sidebar-shell']", "name": "data-mode", "value": "responsive" }
      ]
    }
  ]
}
