{
  "examples": [
    {
      "name": "populated",
      "displayName": "Populated",
      "props": {
        "caption": "Scenario adoption table",
        "rows": [
          { "id": "rcl", "name": "React Component Library", "status": "Current", "owner": "Platform" },
          { "id": "web", "name": "Web Console", "status": "Behind", "owner": "Console" }
        ],
        "columns": {
          "$columns": [
            { "id": "name", "header": "Scenario", "field": "name", "sortable": true, "searchable": true },
            { "id": "status", "header": "Status", "field": "status", "sortable": true, "searchable": true, "badge": true },
            { "id": "owner", "header": "Owner", "field": "owner", "searchable": true }
          ]
        },
        "getRowKey": { "$rowKey": "id" },
        "filters": {
          "$filters": [
            { "id": "current", "label": "Current", "field": "status", "equals": "Current" }
          ]
        }
      },
      "expect": [
        { "kind": "text", "value": "React Component Library" },
        { "kind": "role", "role": "table" }
      ]
    },
    {
      "name": "empty",
      "displayName": "Empty",
      "props": {
        "caption": "No rows table",
        "rows": [],
        "columns": {
          "$columns": [
            { "id": "name", "header": "Scenario", "field": "name" },
            { "id": "status", "header": "Status", "field": "status" }
          ]
        },
        "getRowKey": { "$rowKey": "id" },
        "emptyMessage": "No scenarios match"
      },
      "expect": [
        { "kind": "text", "value": "No scenarios match" },
        { "kind": "role", "role": "table" }
      ]
    },
    {
      "name": "filtered",
      "displayName": "Filtered",
      "props": {
        "caption": "Filtered adoption table",
        "rows": [
          { "id": "one", "name": "Planner", "status": "Current" },
          { "id": "two", "name": "Renderer", "status": "Behind" }
        ],
        "columns": {
          "$columns": [
            { "id": "name", "header": "Scenario", "field": "name", "searchable": true },
            { "id": "status", "header": "Status", "field": "status", "searchable": true }
          ]
        },
        "getRowKey": { "$rowKey": "id" },
        "filters": {
          "$filters": [
            { "id": "behind", "label": "Behind", "field": "status", "equals": "Behind" }
          ]
        }
      },
      "expect": [
        { "kind": "text", "value": "Behind" },
        { "kind": "role", "role": "button", "name": "Behind" }
      ]
    }
  ]
}
