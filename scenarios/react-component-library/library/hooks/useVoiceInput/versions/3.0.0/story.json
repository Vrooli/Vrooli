{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": true,
        "kind": "boolean",
        "label": "Enabled",
        "path": "enabled",
        "required": true
      },
      {
        "default": "always-on",
        "kind": "enum",
        "label": "Mode",
        "options": [
          "always-on",
          "timeout"
        ],
        "path": "mode",
        "required": true
      }
    ]
  },
  "environment": {
    "fixtures": [
      {
        "adapter": "voice-input",
        "key": "voiceInput",
        "options": [
          "idle",
          "recording",
          "permission-denied"
        ]
      }
    ]
  },
  "kind": "hook",
  "schemaVersion": 4,
  "stories": [
    {
      "args": {
        "enabled": true,
        "mode": "always-on"
      },
      "environment": {
        "voiceInput": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "id": "idle",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "pinned",
      "name": "Idle shared-core binding"
    },
    {
      "args": {
        "enabled": true,
        "mode": "always-on"
      },
      "environment": {
        "voiceInput": "recording"
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "id": "recording",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "pinned",
      "name": "Recording after fixture action"
    },
    {
      "args": {
        "enabled": true,
        "mode": "timeout"
      },
      "environment": {
        "voiceInput": "permission-denied"
      },
      "expect": [
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "id": "permission-denied",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "pinned",
      "name": "Permission denied"
    }
  ],
  "title": "useVoiceInput 3.0"
}
