    {"id": "timeout", "name": "Timeout fixture returns to idle", "args": {"mode":"timeout"}, "environment": {"voiceInput": "timeout"}, "interactions": [{"kind": "settle"}], "expect": [{"kind":"role","role":"status"}]},
    {"id": "failure", "name": "Denied media fixture enters an error state", "args": {"mode":"always-on"}, "environment": {"voiceInput": "permission-denied"}, "interactions": [{"kind": "click"}, {"kind": "settle"}], "expect": [{"kind":"role","role":"status"}]}
