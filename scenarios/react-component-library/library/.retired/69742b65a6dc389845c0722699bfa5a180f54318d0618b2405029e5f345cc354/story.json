{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": true,
        "kind": "boolean",
        "label": "Open",
        "path": "open"
      },
      {
        "default": "Component details",
        "kind": "text",
        "label": "Title",
        "path": "title"
      },
      {
        "default": "compact",
        "kind": "text",
        "label": "Size",
        "path": "size"
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Avoid Keyboard",
        "path": "avoidKeyboard"
      },
      {
        "default": null,
        "kind": "structured",
        "label": "On Close",
        "path": "onClose"
      },
      {
        "default": "Drawer body content",
        "kind": "structured",
        "label": "Children",
        "path": "children"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "children": "Full-page drawer body content",
        "open": true,
        "title": "Component details"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Component details",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Full-page drawer body content"
        }
      ],
      "id": "full-open",
      "mode": "pinned",
      "name": "Full drawer",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "FullOpen"
        }
      },
      "role": "anatomy"
    },
    {
      "args": {
        "children": "Compact panel content",
        "open": true,
        "size": "compact",
        "title": "Appearance"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Appearance",
          "role": "dialog"
        },
        {
          "kind": "text",
          "value": "Compact panel content"
        }
      ],
      "id": "compact-open",
      "mode": "pinned",
      "name": "Compact centered panel",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "CompactOpen"
        }
      },
      "role": "boundary"
    },
    {
      "args": {
        "children": "Body with supporting context",
        "open": true,
        "title": "Edit prompt"
      },
      "expect": [
        {
          "kind": "text",
          "value": "Updated just now"
        },
        {
          "kind": "text",
          "value": "Body with supporting context"
        }
      ],
      "id": "with-header-content",
      "mode": "pinned",
      "name": "Header content",
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "WithHeaderContent"
        }
      },
      "role": "boundary"
    }
  ],
  "title": "DrawerShell"
}
