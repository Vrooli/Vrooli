{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "idle",
        "kind": "enum",
        "label": "State",
        "options": [
          "idle",
          "preparing",
          "recording",
          "recovering",
          "transcribing",
          "unavailable",
          "error"
        ],
        "path": "state",
        "required": true
      },
      {
        "default": "always-on",
        "kind": "enum",
        "label": "Mode",
        "options": ["always-on", "timeout"],
        "path": "mode",
        "required": true
      },
      {
        "default": "sm",
        "kind": "enum",
        "label": "Size",
        "options": ["xs", "sm", "md", "lg", "xl", "icon"],
        "path": "size",
        "required": true
      },
      {
        "default": "comfortable",
        "kind": "enum",
        "label": "Density",
        "options": ["comfortable", "compact"],
        "path": "density",
        "required": true
      },
      {
        "default": 0.65,
        "kind": "number",
        "label": "Input level",
        "maximum": 1,
        "minimum": 0,
        "path": "level"
      },
      {
        "default": 0.5,
        "kind": "number",
        "label": "Timeout progress",
        "maximum": 1,
        "minimum": 0,
        "path": "timeoutProgress"
      },
      {
        "default": "Microphone permission was denied.",
        "kind": "text",
        "label": "Error",
        "path": "error"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "size": "sm",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "idle",
      "mode": "pinned",
      "name": "Idle",
      "role": "anatomy"
    },
    {
      "args": {
        "state": "preparing"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Preparing microphone",
          "role": "button"
        }
      ],
      "id": "preparing",
      "mode": "pinned",
      "name": "Preparing",
      "role": "axis",
      "axis": "state",
      "covers": {
        "state": [
          "idle",
          "preparing",
          "recording",
          "recovering",
          "transcribing",
          "unavailable",
          "error"
        ]
      }
    },
    {
      "args": {
        "level": 0.65,
        "mode": "always-on",
        "state": "recording"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "recording",
      "mode": "pinned",
      "name": "Recording",
      "role": "axis",
      "axis": "mode",
      "covers": {
        "mode": ["always-on", "timeout"]
      }
    },
    {
      "args": {
        "level": 0.35,
        "state": "recovering"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Listening for voice input",
          "role": "button"
        }
      ],
      "id": "recovering",
      "mode": "pinned",
      "name": "Recovering",
      "role": "axis",
      "axis": "size",
      "covers": {
        "size": ["xs", "sm", "md", "lg", "xl", "icon"]
      }
    },
    {
      "args": {
        "state": "transcribing"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Transcribing voice input",
          "role": "button"
        }
      ],
      "id": "transcribing",
      "mode": "pinned",
      "name": "Transcribing",
      "role": "axis",
      "axis": "density",
      "covers": {
        "density": ["comfortable", "compact"]
      }
    },
    {
      "args": {
        "state": "unavailable"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Voice input unavailable",
          "role": "button"
        }
      ],
      "id": "unavailable",
      "mode": "pinned",
      "name": "Unavailable",
      "role": "boundary"
    },
    {
      "args": {
        "error": "Microphone permission was denied.",
        "state": "error"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Voice input error",
          "role": "button"
        },
        {
          "kind": "role",
          "role": "status"
        }
      ],
      "id": "error",
      "mode": "pinned",
      "name": "Error",
      "role": "boundary"
    },
    {
      "args": {
        "mode": "always-on",
        "state": "recording"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "mode-always-on",
      "mode": "pinned",
      "name": "Always-on mode",
      "role": "boundary"
    },
    {
      "args": {
        "mode": "timeout",
        "state": "recording",
        "timeoutProgress": 0.7
      },
      "expect": [
        {
          "kind": "role",
          "name": "Stop voice input",
          "role": "button"
        }
      ],
      "id": "mode-timeout",
      "mode": "pinned",
      "name": "Timeout mode",
      "role": "boundary"
    },
    {
      "args": {
        "size": "xs",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-xs",
      "mode": "pinned",
      "name": "XS",
      "role": "boundary"
    },
    {
      "args": {
        "size": "sm",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-sm",
      "mode": "pinned",
      "name": "SM",
      "role": "boundary"
    },
    {
      "args": {
        "size": "md",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-md",
      "mode": "pinned",
      "name": "MD",
      "role": "boundary"
    },
    {
      "args": {
        "size": "lg",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-lg",
      "mode": "pinned",
      "name": "LG",
      "role": "boundary"
    },
    {
      "args": {
        "size": "xl",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-xl",
      "mode": "pinned",
      "name": "XL",
      "role": "boundary"
    },
    {
      "args": {
        "size": "icon",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "size-icon",
      "mode": "pinned",
      "name": "Icon",
      "role": "boundary"
    },
    {
      "args": {
        "density": "comfortable",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "density-comfortable",
      "mode": "pinned",
      "name": "Comfortable density",
      "role": "boundary"
    },
    {
      "args": {
        "density": "compact",
        "state": "idle"
      },
      "expect": [
        {
          "kind": "role",
          "name": "Start voice input",
          "role": "button"
        }
      ],
      "id": "density-compact",
      "mode": "pinned",
      "name": "Compact density",
      "role": "boundary"
    }
  ],
  "title": "VoiceInputButton 3.0"
}
