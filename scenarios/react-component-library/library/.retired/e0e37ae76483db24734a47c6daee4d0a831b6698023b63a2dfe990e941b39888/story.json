{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "body",
        "kind": "enum",
        "label": "Style",
        "options": [
          "display",
          "title",
          "heading",
          "body",
          "label",
          "caption",
          "code",
          "overline"
        ],
        "path": "textStyle"
      },
      {
        "default": "default",
        "kind": "enum",
        "label": "Tone",
        "options": ["default", "muted", "accent", "danger"],
        "path": "tone"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "id": "anatomy",
      "name": "Default anatomy",
      "role": "anatomy",
      "args": {
        "textStyle": "body",
        "tone": "default"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "TextAnatomy"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "heading",
          "name": "A clear typographic hierarchy"
        },
        {
          "kind": "text",
          "value": "One component carries the reading rhythm across a surface."
        }
      ]
    },
    {
      "id": "scale",
      "name": "Style scale",
      "role": "axis",
      "axis": "textStyle",
      "covers": {
        "textStyle": [
          "display",
          "title",
          "heading",
          "body",
          "label",
          "caption",
          "code",
          "overline"
        ]
      },
      "args": {
        "textStyle": "body"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "TextScaleMatrix"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "heading",
          "name": "Eight bundled styles"
        }
      ]
    },
    {
      "id": "tone",
      "name": "Semantic tones",
      "role": "axis",
      "axis": "tone",
      "covers": {
        "tone": ["default", "muted", "accent", "danger"]
      },
      "args": {
        "tone": "default"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "TextToneMatrix"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "heading",
          "name": "Four semantic tones"
        }
      ]
    },
    {
      "id": "boundaries",
      "name": "Boundary conditions",
      "role": "boundary",
      "states": ["empty", "truncate", "overflow", "forced-colors"],
      "args": {
        "textStyle": "body"
      },
      "composition": {
        "specimen": {
          "module": "./story.tsx",
          "export": "TextBoundaries"
        }
      },
      "expect": [
        {
          "kind": "role",
          "role": "heading",
          "name": "Boundary conditions"
        }
      ]
    }
  ]
}
