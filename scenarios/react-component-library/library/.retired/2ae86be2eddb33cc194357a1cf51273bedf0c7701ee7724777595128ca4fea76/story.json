{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "loaded",
        "kind": "enum",
        "label": "Display state",
        "options": ["loading", "loaded", "error"],
        "path": "displayState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "displayState": "loaded"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Abstract blue-green Aurora workspace landscape",
          "role": "img"
        }
      ],
      "id": "default",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Loaded image",
      "role": "anatomy"
    },
    {
      "args": {
        "displayState": "loading"
      },
      "composition": {
        "specimen": {
          "export": "Loading",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Abstract loading workspace preview",
          "role": "img"
        },
        {
          "attribute": "aria-busy",
          "kind": "attribute",
          "selector": "[data-rcl-progressive-image]",
          "value": "true"
        }
      ],
      "id": "loading",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Reserved loading frame",
      "role": "axis",
      "axis": "displayState",
      "covers": {
        "displayState": ["loading", "loaded", "error"]
      }
    },
    {
      "args": {
        "displayState": "loaded"
      },
      "composition": {
        "specimen": {
          "export": "ResponsiveSources",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Abstract responsive art-directed landscape",
          "role": "img"
        }
      ],
      "id": "responsive-sources",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Responsive sources",
      "role": "boundary"
    },
    {
      "args": {
        "displayState": "error"
      },
      "composition": {
        "specimen": {
          "export": "ErrorState",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Unavailable workspace preview",
          "role": "img"
        },
        {
          "kind": "role",
          "role": "alert"
        }
      ],
      "id": "error",
      "interactions": [
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Legible error",
      "role": "boundary"
    }
  ],
  "title": "ProgressiveImage"
}
