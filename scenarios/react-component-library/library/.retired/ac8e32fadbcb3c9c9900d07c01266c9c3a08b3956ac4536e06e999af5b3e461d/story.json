{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "Maya Chen",
        "format": "plain-text",
        "kind": "text",
        "label": "Name",
        "minLength": 1,
        "path": "name",
        "required": true
      },
      {
        "default": "lg",
        "kind": "enum",
        "label": "Size",
        "options": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ],
        "path": "size"
      },
      {
        "default": "circle",
        "kind": "enum",
        "label": "Shape",
        "options": [
          "circle",
          "rounded",
          "square"
        ],
        "path": "shape"
      },
      {
        "default": "online",
        "kind": "enum",
        "label": "Presence",
        "options": [
          "online",
          "away",
          "busy",
          "offline"
        ],
        "path": "presence"
      },
      {
        "format": "plain-text",
        "kind": "text",
        "label": "Presence label",
        "path": "presenceLabel"
      },
      {
        "default": "loaded",
        "kind": "enum",
        "label": "Image state",
        "options": [
          "loading",
          "loaded",
          "error"
        ],
        "path": "imageState"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "imageState": "loaded",
        "name": "Maya Chen",
        "presence": "online",
        "shape": "circle",
        "size": "lg"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "A named person with an image, accessible presence, and a calm status treatment.",
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen",
          "role": "img"
        },
        {
          "kind": "role",
          "name": "Maya Chen is online",
          "role": "status"
        }
      ],
      "id": "default",
      "mode": "live",
      "name": "Named identity",
      "role": "anatomy"
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Maya Chen",
        "presence": "online",
        "shape": "circle",
        "size": "xl"
      },
      "composition": {
        "specimen": {
          "export": "IdentityDetails",
          "module": "./story.tsx"
        }
      },
      "description": "Tooltip and Popover compose around the identity without adding nested controls or leaking overlay state into Avatar.",
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen",
          "role": "img"
        },
        {
          "kind": "role",
          "name": "Show details for Maya Chen",
          "role": "button"
        },
        {
          "kind": "role",
          "name": "Open profile card",
          "role": "button"
        }
      ],
      "id": "identity-details",
      "mode": "live",
      "name": "Identity details",
      "role": "axis",
      "axis": "size",
      "covers": {
        "size": [
          "xs",
          "sm",
          "md",
          "lg",
          "xl"
        ]
      }
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Maya Chen",
        "presence": "online",
        "shape": "circle",
        "size": "lg"
      },
      "composition": {
        "specimen": {
          "export": "PresenceCycle",
          "module": "./story.tsx"
        }
      },
      "description": "The status indicator can change without changing the identity surface around it.",
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen is away",
          "role": "status"
        }
      ],
      "id": "presence-cycle",
      "interactions": [
        {
          "kind": "click",
          "target": {
            "name": "Cycle status",
            "role": "button"
          }
        },
        {
          "kind": "settle"
        }
      ],
      "mode": "live",
      "name": "Presence transition",
      "role": "axis",
      "axis": "shape",
      "covers": {
        "shape": [
          "circle",
          "rounded",
          "square"
        ]
      }
    },
    {
      "args": {
        "imageState": "loading",
        "name": "Maya Chen",
        "presence": "away",
        "shape": "circle",
        "size": "lg"
      },
      "composition": {
        "specimen": {
          "export": "Loading",
          "module": "./story.tsx"
        }
      },
      "description": "The reserved image frame stays stable while the image is still resolving.",
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen",
          "role": "img"
        },
        {
          "attribute": "aria-busy",
          "kind": "attribute",
          "selector": "[data-rcl-progressive-image]",
          "value": "true"
        }
      ],
      "id": "loading",
      "mode": "live",
      "name": "Loading image",
      "role": "axis",
      "axis": "presence",
      "covers": {
        "presence": [
          "online",
          "away",
          "busy",
          "offline"
        ]
      }
    },
    {
      "args": {
        "imageState": "error",
        "name": "Maya Chen",
        "presence": "busy",
        "shape": "circle",
        "size": "lg"
      },
      "composition": {
        "specimen": {
          "export": "RequestError",
          "module": "./story.tsx"
        }
      },
      "description": "A failed image request preserves initials and announces the failure surface.",
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen",
          "role": "img"
        },
        {
          "kind": "role",
          "role": "alert"
        }
      ],
      "id": "request-error",
      "mode": "live",
      "name": "Request error fallback",
      "role": "axis",
      "axis": "imageState",
      "covers": {
        "imageState": [
          "loading",
          "loaded",
          "error"
        ]
      }
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Ada Lovelace",
        "presence": "offline",
        "shape": "rounded",
        "size": "xs"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "Small and non-circular identities remain legible in dense lists and compact surfaces.",
      "expect": [
        {
          "kind": "role",
          "name": "Ada Lovelace",
          "role": "img"
        },
        {
          "kind": "role",
          "name": "Ada Lovelace is offline",
          "role": "status"
        }
      ],
      "id": "scale-and-shape",
      "mode": "live",
      "name": "Scale and shape",
      "role": "boundary"
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Ravi Shah",
        "presence": "online",
        "shape": "circle",
        "size": "sm"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "A small avatar preserves the same semantics when space is constrained.",
      "expect": [
        {
          "kind": "role",
          "name": "Ravi Shah",
          "role": "img"
        }
      ],
      "id": "compact",
      "mode": "live",
      "name": "Compact identity",
      "role": "boundary"
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Noah Williams",
        "presence": "offline",
        "shape": "square",
        "size": "xl"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "description": "The largest size gives image-led profiles enough presence without changing the API.",
      "expect": [
        {
          "kind": "role",
          "name": "Noah Williams",
          "role": "img"
        }
      ],
      "id": "large",
      "mode": "live",
      "name": "Large identity",
      "role": "boundary"
    },
    {
      "args": {
        "imageState": "loaded",
        "name": "Maya Chen",
        "presence": "online",
        "shape": "circle",
        "size": "md"
      },
      "composition": {
        "specimen": {
          "export": "Group",
          "module": "./story.tsx"
        }
      },
      "description": "A group keeps the people count and overflow affordance understandable at a glance.",
      "expect": [
        {
          "kind": "role",
          "name": "Reviewers",
          "role": "group"
        },
        {
          "kind": "role",
          "name": "+1 more people",
          "role": "img"
        },
        {
          "kind": "layout",
          "noOverflow": true,
          "selector": "[data-rcl-avatar-group]"
        }
      ],
      "id": "group",
      "mode": "live",
      "name": "Group overflow",
      "role": "boundary"
    }
  ],
  "title": "Avatar"
}
