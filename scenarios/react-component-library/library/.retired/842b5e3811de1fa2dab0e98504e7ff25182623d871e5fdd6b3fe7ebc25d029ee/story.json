{
  "$schema": "../../../../../../.vrooli/schemas/story-contract.schema.json",
  "args": {
    "fields": [
      {
        "default": "More details about this identity",
        "kind": "text",
        "label": "Tooltip label",
        "path": "label",
        "required": true
      },
      {
        "default": "top",
        "kind": "enum",
        "label": "Placement",
        "options": ["top", "bottom", "start", "end"],
        "path": "placement",
        "required": true
      },
      {
        "default": 280,
        "kind": "number",
        "label": "Open delay (ms)",
        "maximum": 2000,
        "minimum": 0,
        "path": "delay"
      },
      {
        "default": 100,
        "kind": "number",
        "label": "Close delay (ms)",
        "maximum": 2000,
        "minimum": 0,
        "path": "closeDelay"
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Open initially",
        "path": "defaultOpen"
      }
    ]
  },
  "environment": {
    "fixtures": []
  },
  "kind": "component",
  "schemaVersion": 5,
  "stories": [
    {
      "args": {
        "label": "More details about this identity",
        "placement": "top"
      },
      "composition": {
        "specimen": {
          "export": "Default",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Show tooltip",
          "role": "button"
        }
      ],
      "id": "default",
      "mode": "pinned",
      "name": "Default",
      "role": "anatomy"
    },
    {
      "args": {
        "defaultOpen": true,
        "delay": 0,
        "label": "Maya Chen · Online"
      },
      "composition": {
        "specimen": {
          "export": "Open",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "role",
          "name": "Maya Chen · Online",
          "role": "tooltip"
        },
        {
          "kind": "role",
          "name": "Show tooltip",
          "role": "button"
        }
      ],
      "id": "open",
      "mode": "pinned",
      "name": "Open on focus",
      "role": "axis",
      "axis": "placement",
      "covers": {
        "placement": ["top", "bottom", "start", "end"]
      }
    },
    {
      "args": {
        "defaultOpen": true,
        "label": "Placement follows the trigger",
        "placement": "bottom"
      },
      "composition": {
        "specimen": {
          "export": "Placements",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Placement follows the trigger"
        }
      ],
      "id": "placements",
      "mode": "pinned",
      "name": "Responsive placements",
      "role": "boundary"
    },
    {
      "args": {
        "defaultOpen": true,
        "label": "Start placement",
        "placement": "start"
      },
      "composition": {
        "specimen": {
          "export": "Placements",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "Start placement"
        }
      ],
      "id": "start",
      "mode": "pinned",
      "name": "Start placement",
      "role": "boundary"
    },
    {
      "args": {
        "defaultOpen": true,
        "label": "End placement",
        "placement": "end"
      },
      "composition": {
        "specimen": {
          "export": "Placements",
          "module": "./story.tsx"
        }
      },
      "expect": [
        {
          "kind": "text",
          "value": "End placement"
        }
      ],
      "id": "end",
      "mode": "pinned",
      "name": "End placement",
      "role": "boundary"
    }
  ],
  "title": "Tooltip"
}
