        "path": "size",
        "required": true
      },
      {
        "default": "comfortable",
        "kind": "enum",
        "label": "Density",
        "options": [
          "comfortable",
          "compact"
        ],
        "path": "density",
        "required": true
      },
      {
        "default": false,
        "kind": "boolean",
        "label": "Disabled",
        "path": "disabled"
      }
    ]
  },
  "environment": {
    "fixtures": []
