{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "data-display.expandable-row",
    "name": "ExpandableRow",
    "kind": "component", "surface": "raised",
    "domain": "data-display",
    "description": "The table or list row revealing structured detail while preserving column alignment, focus, selection, virtualization windows, and animated height.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "motion.collapsible-region",
        "reason": "Height animation and expanded semantics are shared."
      }
    ]
  },
  "requiredCapabilities": [
    "semantic-structure",
    "keyboard-operable",
    "focus-order",
    "accessible-naming",
    "no-horizontal-overflow",
    "content-reflow",
    "responsive-transformation",
    "reading-order-honest",
    "reduced-motion",
    "status-announced"
  ]
}
