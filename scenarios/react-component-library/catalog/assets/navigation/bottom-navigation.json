{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "navigation.bottom-navigation",
    "name": "BottomNavigation",
    "kind": "navigation",
    "domain": "navigation",
    "description": "The compact-viewport navigation surface with safe-area handling, animated active state, badges, route semantics, and an explicit overflow policy for more destinations than fit.",
    "targets": [
      "react-vite"
    ],
    "slot": "layout-shell",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Sizing, spacing, radius, and layer order resolve to declared ramps."
      },
      {
        "asset": "navigation.nav-link",
        "reason": "Items are shared navigation links."
      },
      {
        "asset": "primitives.icon",
        "reason": "Glyphs resolve through the registry."
      }
    ]
  },
  "requiredCapabilities": [
    "safe-area-respected",
    "tap-target-size",
    "accessible-naming",
    "keyboard-operable",
    "focus-order",
    "reduced-motion",
    "mobile-capability-parity"
  ],
  "beauty": {
    "avoid": [
      "icon-without-accessible-name"
    ]
  }
}
