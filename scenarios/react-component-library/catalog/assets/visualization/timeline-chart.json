{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "visualization.timeline-chart",
    "name": "TimelineChart",
    "kind": "component", "surface": "raised",
    "domain": "visualization",
    "description": "The temporal visualization for ranges, events, intervals, milestones, and zoomable periods, with selection and windowing for large series.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "visualization.chart",
        "reason": "Framework, axes, and states are shared."
      }
    ]
  },
  "expects": [
    {
      "capability": "date-time-adapter"
    },
    {
      "capability": "virtualization-adapter",
      "optional": true
    }
  ],
  "requiredCapabilities": [
    "accessible-naming",
    "contrast-floor",
    "non-color-status",
    "dark-parity",
    "forced-colors-legibility",
    "keyboard-operable",
    "status-announced",
    "content-reflow",
    "reduced-motion",
    "text-scale-resilience",
    "gesture-alternative"
  ],
  "qualityGates": [
    "performance"
  ]
}
