{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "controls.checkbox",
    "name": "Checkbox",
    "kind": "component", "surface": "raised",
    "domain": "controls",
    "description": "The binary or indeterminate selection control with animated state marks, validation treatment, group membership, and robust keyboard and screen-reader behavior.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Sizing, spacing, and radius resolve to declared ramps rather than literals."
      },
      {
        "asset": "foundations.visual-recipes",
        "reason": "Variant styling is declared as an enumerable recipe so the implementation is checkable against the catalog."
      },
      {
        "asset": "hooks.use-controllable-state",
        "reason": "Controlled and uncontrolled operation share one contract and one event shape."
      }
    ]
  },
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "tap-target-size",
    "contrast-floor",
    "hover-contrast",
    "cursor-discipline",
    "ramp-conformance",
    "dark-parity",
    "text-scale-resilience",
    "error-association",
    "non-color-status",
    "reduced-motion"
  ],
  "requiredStates": [
    "default",
    "validation-error"
  ]
}
