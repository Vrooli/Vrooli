{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "controls.slider",
    "name": "Slider",
    "kind": "component", "surface": "raised",
    "domain": "controls",
    "description": "The single-value range control with keyboard stepping, snapping, marks, formatted output, touch-friendly hit area, and accessible value text.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Sizing, spacing, and radius resolve to declared ramps rather than literals."
      },
      {
        "asset": "hooks.use-controllable-state",
        "reason": "Controlled and uncontrolled operation share one contract and one event shape."
      },
      {
        "asset": "hooks.use-drag",
        "reason": "Thumb movement keeps frame-by-frame updates outside React rendering."
      }
    ]
  },
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "tap-target-size",
    "contrast-floor",
    "hover-contrast",
    "cursor-discipline",
    "ramp-conformance",
    "dark-parity",
    "text-scale-resilience",
    "gesture-alternative",
    "status-announced"
  ]
}
