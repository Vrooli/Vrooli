      {
        "asset": "feedback.error-state",
        "reason": "Fallback presentation is shared."
      }
    ]
  },
  "expects": [
    {
      "capability": "telemetry-adapter",
      "optional": true
    }
  ],
  "requiredCapabilities": [
    "recovery-path",
    "error-honesty",
    "error-message-usefulness",
    "partial-degradation"
  ],
  "requiredStates": [
    "request-error",
    "retry"
  ]
