{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "feedback.error-boundary",
    "name": "ErrorBoundary",
    "kind": "component", "surface": "raised",
    "domain": "feedback",
