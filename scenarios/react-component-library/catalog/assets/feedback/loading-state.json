{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "api": {
    "variants": {},
    "modes": [],
    "parts": []
  },
  "asset": {
    "id": "feedback.loading-state",
    "name": "LoadingState",
    "kind": "component",
    "surface": "raised",
    "domain": "feedback",
    "description": "The full-region loading composition selecting skeletons, placeholders, or progress based on the expected content structure and the operation's likely duration.",
    "targets": [
      "react-vite"
    ],
    "slot": "ui-primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "primitives.skeleton",
        "reason": "Placeholders reserve the real layout."
      },
      {
        "asset": "primitives.spinner",
        "reason": "Indeterminate work uses the shared indicator."
      },
      {
        "asset": "hooks.use-locale",
        "reason": "User-facing copy resolves through the adopting host locale bridge."
      }
    ]
  },
  "requiredCapabilities": [
    "status-announced",
    "reduced-motion",
    "entrance-restraint",
    "content-reflow",
    "contrast-floor"
  ],
  "requiredStates": [
    "loading"
  ]
}
