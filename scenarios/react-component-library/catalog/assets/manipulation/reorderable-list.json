      {
        "asset": "manipulation.sortable",
        "reason": "Reorder mechanics, keyboard operation, and rollback are shared."
      },
      {
        "asset": "data-display.list",
        "reason": "Row semantics and selection are shared."
      }
    ]
  },
  "requiredCapabilities": [
    "keyboard-operable",
    "focus-visible-indicator",
    "gesture-alternative",
    "status-announced",
    "pointer-independence",
    "reduced-motion",
    "no-layout-animation",
    "optimistic-rollback",
    "empty-state-craft"
