{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "api": {
    "variants": {},
    "modes": [],
    "parts": []
  },
  "asset": {
    "id": "primitives.link",
    "name": "Link",
    "kind": "primitive",
    "domain": "primitives",
    "description": "The router-adaptable link primitive handling external-link treatment, active and pending state, prefetch policy, focus behavior, and disabled semantics.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Every spacing, size, and radius value resolves to a declared ramp rather than a literal."
      }
    ]
  },
  "expects": [
    {
      "capability": "router-adapter"
    }
  ],
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "cursor-discipline",
    "contrast-floor"
  ]
}
