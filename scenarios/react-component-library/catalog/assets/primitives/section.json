{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "primitives.section",
    "name": "Section",
    "kind": "primitive",
    "surface": "base",
    "domain": "primitives",
    "description": "The semantic page-section primitive standardizing vertical rhythm, width, background treatment, and the relationship between a section and its heading.",
    "targets": [
      "react-vite"
    ],
    "slot": "ui-primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified",
      "plannedBy": "2026-12-31"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Every spacing, size, and radius value resolves to a declared ramp rather than a literal."
      }
    ]
  },
  "requiredCapabilities": [
    "ramp-conformance",
    "no-horizontal-overflow",
    "content-reflow",
    "reading-order-honest",
    "heading-hierarchy",
    "semantic-structure"
  ],
  "beauty": {
    "avoid": [
      "card-wrapping-page-sections"
    ]
  }
}
