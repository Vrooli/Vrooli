{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "primitives.inline",
    "name": "Inline",
    "kind": "primitive",
    "domain": "primitives",
    "description": "The horizontal layout primitive handling wrapping, alignment, distribution, responsive spacing, and bidirectional reading order.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Every spacing, size, and radius value resolves to a declared ramp rather than a literal."
      }
    ]
  },
  "requiredCapabilities": [
    "ramp-conformance",
    "no-horizontal-overflow",
    "content-reflow",
    "reading-order-honest"
  ]
}
