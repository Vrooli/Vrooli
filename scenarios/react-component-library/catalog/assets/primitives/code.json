{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "api": {
    "variants": {},
    "modes": [],
    "parts": []
  },
  "asset": {
    "id": "primitives.code",
    "name": "Code",
    "kind": "primitive",
    "surface": "base",
    "domain": "primitives",
    "description": "The code-text primitive for inline and block snippets with preserved whitespace, overflow affordances, language metadata, and optional lazily loaded highlighting.",
    "targets": [
      "react-vite"
    ],
    "slot": "ui-primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Every spacing, size, and radius value resolves to a declared ramp rather than a literal."
      }
    ]
  },
  "requiredCapabilities": [
    "contrast-floor",
    "no-horizontal-overflow",
    "text-scale-resilience"
  ]
}
