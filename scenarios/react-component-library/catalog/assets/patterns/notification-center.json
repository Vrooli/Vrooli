{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "patterns.notification-center",
    "name": "NotificationCenter",
    "kind": "pattern",
    "domain": "patterns",
    "description": "The persistent notification experience with unread state, categories, grouping, actions, pagination, preferences, and a clear separation from ephemeral toasts.",
    "targets": [
      "react-vite"
    ],
    "slot": "pattern",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "data-display.list",
        "reason": "Entries use the shared collection semantics."
      },
      {
        "asset": "services.toast-manager",
        "reason": "Transient delivery is coordinated with the durable record."
      },
      {
        "asset": "feedback.async-boundary",
        "reason": "Every generic state is delegated to the shared boundary rather than reimplemented per workflow."
      }
    ]
  },
  "expects": [
    {
      "capability": "data-source",
      "typeArguments": [
        "TNotification"
      ]
    }
  ],
  "requiredCapabilities": [
    "recovery-path",
    "input-preservation",
    "status-announced",
    "error-honesty",
    "error-message-usefulness",
    "keyboard-operable",
    "focus-order",
    "responsive-transformation",
    "offline-behavior",
    "partial-degradation",
    "freshness-disclosure",
    "empty-state-craft"
  ],
  "requiredStates": [
    "default",
    "loading",
    "refreshing",
    "empty",
    "partial",
    "stale",
    "submitting",
    "success",
    "request-error",
    "permission-denied",
    "offline",
    "retry"
  ],
  "beauty": {
    "avoid": [
      "toast-as-only-error-record"
    ]
  }
}
