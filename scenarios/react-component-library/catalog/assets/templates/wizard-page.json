{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "templates.wizard-page",
    "name": "WizardPage",
    "kind": "page-template",
    "domain": "templates",
    "description": "The multi-step workflow surface with route-backed steps, progress, drafts, conditional branching, per-step validation, back navigation, resumability, and final confirmation.",
    "targets": [
      "react-vite"
    ],
    "slot": "page-template",
    "delivery": "generated",
    "target": {
      "priority": "P1",
      "maturity": "verified",
      "plannedBy": "2026-12-31"
    },
    "kits": [
      "vrooli-default"
    ]
  },
  "dependencies": {
    "requires": [
      {
        "asset": "navigation.page",
        "reason": "Route boundary, metadata, scroll restoration, and focus placement are the shared page."
      },
      {
        "asset": "patterns.multi-step-form-flow",
        "reason": "Step orchestration, drafts, and resumability are the shared workflow."
      },
      {
        "asset": "navigation.step-navigation",
        "reason": "Step state presentation is shared."
      },
      {
        "asset": "feedback.async-boundary",
        "reason": "Every generic state is delegated to the shared boundary."
      }
    ]
  },
  "expects": [
    {
      "capability": "router-adapter"
    },
    {
      "capability": "ui-provider"
    },
    {
      "capability": "design-tokens"
    },
    {
      "capability": "validation-adapter",
      "typeArguments": [
        "TValues"
      ]
    },
    {
      "capability": "storage-adapter",
      "optional": true
    }
  ],
  "requiredCapabilities": [
    "viewport-fill",
    "no-horizontal-overflow",
    "responsive-transformation",
    "mobile-capability-parity",
    "keyboard-operable",
    "focus-order",
    "heading-hierarchy",
    "semantic-structure",
    "entrance-restraint",
    "content-reflow",
    "recovery-path",
    "error-honesty",
    "partial-degradation",
    "offline-behavior",
    "freshness-disclosure",
    "permission-explained",
    "empty-state-craft",
    "status-announced",
    "dark-parity",
    "text-scale-resilience",
    "card-restraint",
    "error-association",
    "input-preservation"
  ],
  "requiredStates": [
    "default",
    "loading",
    "refreshing",
    "empty",
    "partial",
    "stale",
    "request-error",
    "permission-denied",
    "offline",
    "retry",
    "submitting",
    "success",
    "validation-error"
  ],
  "regions": [
    {
      "id": "progress",
      "purpose": "Step state and navigation between completed steps.",
      "required": true,
      "lifecycle": "static"
    },
    {
      "id": "step",
      "purpose": "The current step's content.",
      "required": true,
      "lifecycle": "async",
      "accepts": "forms"
    },
    {
      "id": "actions",
      "purpose": "Back, continue, save-draft, and submit controls.",
      "required": true,
      "lifecycle": "static"
    }
  ]
}
