{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "templates.master-detail-page",
    "name": "MasterDetailPage",
    "kind": "page-template",
    "domain": "templates",
    "description": "The route-aware collection-and-detail surface using adjacent panes on desktop and context-preserving drill-in on compact viewports.",
    "targets": [
      "react-vite"
    ],
    "slot": "page-template",
    "delivery": "generated",
    "target": {
      "priority": "P0",
      "maturity": "verified"
    },
    "kits": [
      "vrooli-default"
    ]
  },
  "dependencies": {
    "requires": [
      {
        "asset": "navigation.page",
        "reason": "Route boundary, metadata, scroll restoration, and focus placement are the shared page."
      },
      {
        "asset": "patterns.master-detail-workspace",
        "reason": "Route synchronization, selection preservation, and drill-in are the shared workspace."
      },
      {
        "asset": "feedback.async-boundary",
        "reason": "Every generic state is delegated to the shared boundary."
      }
    ]
  },
  "expects": [
    {
      "capability": "router-adapter"
    },
    {
      "capability": "ui-provider"
    },
    {
      "capability": "design-tokens"
    },
    {
      "capability": "data-source",
      "typeArguments": [
        "TRecord"
      ]
    }
  ],
  "requiredCapabilities": [
    "viewport-fill",
    "no-horizontal-overflow",
    "responsive-transformation",
    "mobile-capability-parity",
    "keyboard-operable",
    "focus-order",
    "heading-hierarchy",
    "semantic-structure",
    "entrance-restraint",
    "content-reflow",
    "recovery-path",
    "error-honesty",
    "partial-degradation",
    "offline-behavior",
    "freshness-disclosure",
    "permission-explained",
    "empty-state-craft",
    "status-announced",
    "dark-parity",
    "text-scale-resilience",
    "card-restraint"
  ],
  "requiredStates": [
    "default",
    "loading",
    "refreshing",
    "empty",
    "partial",
    "stale",
    "request-error",
    "permission-denied",
    "offline",
    "retry"
  ],
  "regions": [
    {
      "id": "collection",
      "purpose": "The list of records, with query and filter controls.",
      "required": true,
      "lifecycle": "async",
      "accepts": "data-display"
    },
    {
      "id": "detail",
      "purpose": "The selected record's content.",
      "required": false,
      "lifecycle": "async"
    },
    {
      "id": "empty-detail",
      "purpose": "What is shown before anything is selected.",
      "required": false,
      "lifecycle": "static"
    }
  ]
}
