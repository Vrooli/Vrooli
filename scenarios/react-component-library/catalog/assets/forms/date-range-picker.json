{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "forms.date-range-picker",
    "name": "DateRangePicker",
    "kind": "component", "surface": "raised",
