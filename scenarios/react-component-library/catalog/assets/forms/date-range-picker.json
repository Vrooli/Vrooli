    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "forms.date-picker",
        "reason": "Entry, constraints, and timezone policy are shared."
      }
    ]
  },
  "expects": [
    {
      "capability": "date-time-adapter"
    }
  ],
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "error-association",
    "tap-target-size",
    "contrast-floor",
    "ramp-conformance",
    "text-scale-resilience",
    "input-preservation",
    "responsive-transformation",
    "pointer-independence"
  ],
  "requiredStates": [
    "default",
    "validation-error"
  ]
