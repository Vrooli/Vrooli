{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "forms.input",
    "name": "Input",
    "kind": "component",
    "surface": "raised",
    "domain": "forms",
    "description": "The single-line field with prefix and suffix slots, clear action, loading affordance, validation treatment, formatting hooks, autofill compatibility, and layout that does not shift between states.",
    "targets": [
      "react-vite"
    ],
    "slot": "ui-primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "foundations.tokens",
        "reason": "Sizing, spacing, and radius resolve to declared ramps rather than literals."
      },
      {
        "asset": "foundations.visual-recipes",
        "reason": "Variant styling and surface elevation resolve through the shared recipe vocabulary."
      },
      {
        "asset": "hooks.use-controllable-state",
        "reason": "Controlled and uncontrolled operation share one contract and one event shape."
      },
      {
        "asset": "foundations.class-merge",
        "reason": "Consumer class names use the shared Tailwind conflict resolver."
      },
      {
        "asset": "react-component-library:StyleSheet",
        "reason": "The field stylesheet is registered once through the shared stylesheet foundation."
      }
    ]
  },
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "error-association",
    "tap-target-size",
    "contrast-floor",
    "ramp-conformance",
    "text-scale-resilience",
    "input-preservation"
  ],
  "requiredStates": [
    "default",
    "loading",
    "validation-error"
  ],
  "api": {
    "levels": [
      "convenience"
    ],
    "modes": [
      "controlled",
      "uncontrolled"
    ],
    "variants": {
      "size": [
        "sm",
        "md",
        "lg"
      ],
      "tone": [
        "default",
        "invalid"
      ]
    },
    "parts": [
      "prefix",
      "control",
      "suffix"
    ]
  }
}
