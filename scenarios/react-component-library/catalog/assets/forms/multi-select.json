{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "forms.multi-select",
    "name": "MultiSelect",
    "kind": "component",
    "surface": "raised",
    "domain": "forms",
    "description": "The multiple-selection field with search, selected-value chips, bulk selection, limits, async options, keyboard removal, and compact overflow that does not resize the field.",
    "targets": [
      "react-vite"
    ],
    "slot": "ui-primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P1",
      "maturity": "verified"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "forms.combobox",
        "reason": "Search, option loading, and keyboard model are shared."
      },
      {
        "asset": "primitives.chip",
        "reason": "Selected values render as removable chips."
      }
    ]
  },
  "requiredCapabilities": [
    "accessible-naming",
    "keyboard-operable",
    "focus-visible-indicator",
    "error-association",
    "tap-target-size",
    "contrast-floor",
    "ramp-conformance",
    "text-scale-resilience",
    "input-preservation",
    "status-announced",
    "content-reflow"
  ],
  "requiredStates": [
    "default",
    "loading",
    "empty",
    "validation-error",
    "request-error"
  ]
}
