{
  "$schema": "../../../../../.vrooli/schemas/catalog-asset.schema.json",
  "kind": "catalog-asset",
  "schemaVersion": "1.0.0",
  "asset": {
    "id": "forms.validation-summary",
    "name": "ValidationSummary",
    "kind": "component",
    "domain": "forms",
    "description": "The form-level error summary grouping actionable failures, linking to the fields they concern, taking focus at the right moment, and avoiding duplication of every field message.",
    "targets": [
      "react-vite"
    ],
    "slot": "primitive",
    "delivery": "adopted",
    "target": {
      "priority": "P0",
      "maturity": "production-ready"
    }
  },
  "dependencies": {
    "requires": [
      {
        "asset": "primitives.text",
        "reason": "Summary content uses shared text styles."
      },
      {
        "asset": "hooks.use-announce",
        "reason": "The summary is announced once rather than per field."
      }
    ]
  },
  "requiredCapabilities": [
    "error-association",
    "status-announced",
    "focus-order",
    "non-color-status",
    "error-message-usefulness"
  ],
  "requiredStates": [
    "validation-error",
    "request-error"
  ]
}
