{
  "$schema": "https://vrooli.dev/schemas/test-genie-phase-descriptor.schema.json",
  "schemaVersion": "1.0.0",
  "scenario": "react-component-library",
  "phase": "component-tests",
  "displayName": "Component Tests",
  "description": "Runs version-pinned React component and hook contracts through the React Component Library provider.",
  "source": "validation-provider",
  "orderHint": 21,
  "timeout": "1200s",
  "findingSource": "coverage",
  "phaseClass": "capability",
  "runtimeClass": "execution",
  "concurrency": {
    "mode": "parallel-safe"
  },
  "determinism": {
    "default": "observational",
    "reason": "Component gates compare rendered story evidence against the version-pinned catalog held in the provider's own database. Catalog releases and recorded evidence change outside the target scenario's files, so the verdict is not determined by the target's file digest.",
    "capabilities": {
      "graph-reconciled": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "token-vocabulary": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "token-ramp-complete": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "released-version-immutable": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "version-liveness": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "types": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "api": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "unit": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "interaction": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "accessibility": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "responsive": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "visual": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "rtl": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "reduced-motion": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "performance": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "console-clean": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "surface-discipline": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "composition": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "composition-contract": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "documentation": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "examples": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "fixture-adversarial": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "tokens": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "conformance": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "lifecycle": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "i18n": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "selector-coverage": { "mode": "file-determined", "inputs": ["library/**/versions/**", "catalog/config.json"] },
      "restyle-contract": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "story-grammar": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "story-distinctness": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "evidence-freshness": { "mode": "file-determined", "inputs": ["library/**", "ui/**", "catalog/config.json"] },
      "adopter-contracts": { "mode": "file-determined", "inputs": ["ui/**"] }
    }
  },
  "dimensions": [
    "tests"
  ],
  "validation": {
    "contract": "scenario-validation/v1",
    "execution": true
  },
  "targets": {
    "kinds": [
      "scenario"
    ],
    "selection": "enumerate"
  },
  "applicability": {
    "default": "not_applicable",
    "any": [
      {
        "pathGlob": "library/components/*/component.json"
      },
      {
        "pathGlob": "library/hooks/*/component.json"
      },
      {
        "pathGlob": "library/services/*/component.json"
      },
      {
        "pathGlob": "library/primitives/*/component.json"
      },
      {
        "pathGlob": "library/foundations/*/component.json"
      }
    ]
  },
  "policy": {
    "selection": "default_when_applicable",
    "providerReadiness": "required_when_applicable",
    "providerLifecycle": "start_if_needed",
    "freshness": "require_live_contract",
    "resultGating": "gating",
    "unavailable": "fail"
  },
  "runnability": {
    "needsAPI": true
  },
  "docs": {
    "path": "scenarios/test-genie/docs/phases/component-tests/README.md"
  },
  "maturity": {
    "version": "2.0.0",
    "levels": [
      {
        "id": "L0",
        "name": "Contracts unavailable",
        "description": "Catalog contracts cannot be evaluated.",
        "entry_criteria": [
          "A catalog asset exists."
        ],
        "exit_criteria": [
          "Every selected version has a safe contract."
        ]
      },
      {
        "id": "L1",
        "name": "Contracts validated",
        "description": "Versioned component and hook contracts are parsed and checked against declared examples.",
        "entry_criteria": [
          "Contracts parse."
        ],
        "exit_criteria": [
          "No contract failures remain."
        ]
      }
    ],
    "capabilities": [
      {
        "id": "component_contracts",
        "label": "Component Contracts",
        "description": "Version-pinned declarative component and hook behavior contracts.",
        "levels": [
          {
            "id": "L0",
            "name": "Unavailable",
            "status_label": "Unavailable",
            "description": "Contracts cannot be evaluated.",
            "capability_summary": "No validated component contract evidence.",
            "next_unlock": "A valid versioned contract."
          },
          {
            "id": "L1",
            "name": "Validated",
            "status_label": "Ready",
            "description": "Contracts and declared traces are valid.",
            "capability_summary": "Component contract evidence is available.",
            "next_unlock": "No unresolved contract-test findings."
          }
        ]
      }
    ],
    "findings": {
      "COMPONENT_TEST_FAILED": {
        "capability_id": "component_contracts",
        "local_level_impact": "L0",
        "global_impact": "foundation_blocker",
        "dimension": "tests",
        "severity_default": "SEVERITY_ERROR",
        "clean_requirement": "required",
        "fix_class": "manual",
        "reason": "Component behavior needs an authored contract or implementation correction."
      },
      "CATALOG_VALIDATION_FAILED": {
        "capability_id": "component_contracts",
        "local_level_impact": "L0",
        "global_impact": "foundation_blocker",
        "dimension": "tests",
        "severity_default": "SEVERITY_ERROR",
        "clean_requirement": "required",
        "fix_class": "manual",
        "reason": "The desired-state catalog or its cross-registry references are invalid."
      }
    },
    "fallback": {
      "capability_id": "component_contracts",
      "local_level_impact": "L0",
      "global_impact": "foundation_blocker",
      "dimension": "tests",
      "severity_default": "SEVERITY_ERROR",
      "clean_requirement": "required"
    }
  }
}
