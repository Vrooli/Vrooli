{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "adoptions_reconcile",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ReconcileAdoptions",
      "method": "POST",
      "summary": "Backfill adoption records from on-disk provenance",
      "description": "Scans scenario UI source read-only. Dry-run is default; apply writes only RCL adoption records without backlog reporting.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "apply": "boolean"
        }
      },
      "response": {
        "type": "object"
      }
    },
    {
      "id": "adoptions_reconverge",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ReconvergeAdoptions",
      "method": "POST",
      "summary": "Reconverge BEHIND adoptions to the current library version",
      "description": "Batch-reconverges BEHIND adoptions: re-applies CLEAN copies through the validated Reapply path and flags MODIFIED copies for human review without overwriting them. Dry-run is default; apply performs the re-applies. Reports per-adoption and per-file outcomes.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "apply": "boolean",
          "scenario": "string (filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "outcomes": "array<ReconvergeOutcome>"
        }
      }
    },
    {
      "id": "adoptions_list",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ListAdoptions",
      "method": "POST",
      "summary": "List adoption records",
      "description": "Returns adoption records matching optional component_id / scenario / limit filters.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string (filter)",
          "limit": "int32 (max rows, 0 = server default)",
          "scenario": "string (filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoptions": "array<Adoption>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ]
    },
    {
      "id": "adoptions_apply",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ApplyAdoption",
      "method": "POST",
      "summary": "Apply a component to a scenario",
      "description": "Copies a selected component version into a target scenario, stamps provenance, and records the adoption.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "adopted_path": "string",
          "component_id": "string",
          "confirm_overwrite": "bool",
          "override_validation": "bool (explicitly allow a blocking dependency verdict)",
          "replace_existing": "bool (explicitly replace an existing source file)",
          "scenario": "string",
          "version": "string (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoption": "Adoption",
          "import_sites": "array<string>",
          "written_path": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing required field or unknown component_id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ]
    },
    {
      "id": "adoptions_reapply",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ReapplyAdoption",
      "method": "POST",
      "summary": "Reapply an adoption",
      "description": "Overwrites an adopted file from a selected library version. Local modifications require explicit confirmation.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "confirm_local_overwrite": "bool",
          "id": "string",
          "override_validation": "bool (explicitly allow a blocking dependency verdict)",
          "version": "string (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoption": "Adoption",
          "written_path": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing id or local edits without confirmation"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No adoption with that id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository or filesystem failure"
        }
      ]
    },
    {
      "id": "adoptions_delete",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/DeleteAdoption",
      "method": "POST",
      "summary": "Delete an adoption record",
      "description": "Removes the adoption record matching the id.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object"
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No adoption with that id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ]
    },
    {
      "id": "adoptions_refresh",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/RefreshAdoptions",
      "method": "POST",
      "summary": "Refresh drift status for adoption records",
      "description": "Recomputes library-version and local-edit drift statuses for every adoption record, or just those for a single component when component_id is supplied.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string (optional filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoptions": "array<Adoption>",
          "library_behind": "int32",
          "library_current": "int32",
          "local_clean": "int32",
          "local_modified": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository or filesystem failure"
        }
      ]
    },
    {
      "id": "adoptions_resolve_path",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ResolveAdoptionPath",
      "method": "POST",
      "summary": "Resolve the canonical adopted path for a component+scenario",
      "description": "Computes the filesystem path an adoption would land at, using the target scenario's UI manifest (template-manifest source), a heuristic, or a fallback. Read-only.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "feature": "string (optional, when slot requiresFeature)",
          "override_path": "string (optional)",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "path": "string (relative to scenario root)",
          "slot": "string (slot name used)",
          "source": "ResolveSource enum",
          "warnings": "array<string>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing component_id, scenario, or unsubstituted path token"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Resolver not configured (server lacks repo-root wiring)"
        }
      ]
    },
    {
      "id": "adoptions_suggest",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/SuggestAdoptions",
      "method": "POST",
      "summary": "Suggest catalog components a scenario should adopt",
      "description": "Returns non-adopted catalog components using real UI inventory matches, design-style fit, and dependency compatibility. Every candidate carries human-readable reasons; no opaque score is emitted.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (optional)",
          "scenario": "string (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "suggestions": "array<AdoptionSuggestion>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid scenario"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Suggestion dependencies not configured"
        }
      ]
    },
    {
      "id": "adoptions_discover",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/DiscoverAdoptions",
      "method": "POST",
      "summary": "Discover header-less vendored copies by content similarity",
      "description": "Walks scenario UI trees for source files with no @vrooliComponentSource header and scores each against every library component version (Sørensen–Dice line similarity). Read-only: candidates carry similarity evidence for operator review; ConfirmDiscovery performs any write.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (optional)",
          "min_similarity": "double (0 = server default 0.6)",
          "scenario": "string (optional)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "candidates": "array<DiscoveryCandidate>",
          "min_similarity": "double",
          "scanned": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Scanner or repository failure"
        }
      ]
    },
    {
      "id": "adoptions_confirm_discovery",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ConfirmDiscovery",
      "method": "POST",
      "summary": "Confirm a discovery candidate and backfill its provenance",
      "description": "Injects an @vrooliComponentSource header into a header-less scenario file and creates its adoption record, attributed to the named component + version. Refuses files that already carry a header or are already tracked.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "adopted_path": "string",
          "component_id": "string",
          "scenario": "string",
          "version": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoption": "Adoption",
          "similarity": "double",
          "written_path": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing field, file already tagged, or already tracked"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown component_id or version"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository or filesystem failure"
        }
      ]
    },
    {
      "id": "components_list",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/ListComponents",
      "method": "POST",
      "summary": "List components",
      "description": "Returns components matching optional match / tag / limit filters through the generated Connect-RPC ComponentsService.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (max rows, 0 = server default)",
          "match": "string (case-insensitive substring filter)",
          "tag": "string (exact tag filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "components": "array<Component>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ]
    },
    {
      "id": "components_get",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponent",
      "method": "POST",
      "summary": "Get a component by id",
      "description": "Returns the component matching the request id.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ]
    },
    {
      "id": "components_get_by_library_id",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponentByLibraryId",
      "method": "POST",
      "summary": "Get a component by libraryId",
      "description": "Returns the component matching the @libraryId header value.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "library_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that libraryId"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ]
    },
    {
      "id": "components_index",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/IndexComponents",
      "method": "POST",
      "summary": "Re-index components from disk",
      "description": "Walks the configured source root for *.tsx files with @libraryId headers and upserts them into the registry. Removes rows whose files have been deleted.",
      "category": "components",
      "response": {
        "type": "object",
        "properties": {
          "deleted": "int32",
          "errors": "array<string>",
          "indexed": "int32",
          "library_ids": "array<string>",
          "scanned": "int32",
          "skipped": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Walk or upsert failure"
        }
      ]
    },
    {
      "id": "components_initialize",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/InitializeComponent",
      "method": "POST",
      "summary": "Initialize a component",
      "description": "Creates component.json plus an initial version TSX file under the Git-tracked library source root, indexes it, and returns the new registry row.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "description": "string",
          "display_name": "string",
          "file_name": "string",
          "initial_source": "string",
          "initial_version": "string",
          "library_id": "string",
          "slug": "string",
          "tags": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component",
          "manifest_path": "string",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid slug, version, file name, or source header"
        },
        {
          "status": 409,
          "code": "already_exists",
          "description": "Component libraryId or slug already exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem or repository failure"
        }
      ]
    },
    {
      "id": "components_ingest",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/IngestComponent",
      "method": "POST",
      "summary": "Ingest a scenario component",
      "description": "Copies a scenario-local TSX file into an indexed library component, creates a draft working version, and returns static de-scenario-ification findings.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "description": "string",
          "display_name": "string",
          "scenario": "string",
          "slot": "string",
          "slug": "string",
          "source_file": "string",
          "tags": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "checklist_path": "string",
          "component": "Component",
          "draft_version": "string",
          "findings": "array<IngestFinding>",
          "manifest_path": "string",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid scenario, source file, or component metadata"
        },
        {
          "status": 409,
          "code": "already_exists",
          "description": "Component libraryId or slug already exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem or repository failure"
        }
      ]
    },
    {
      "id": "components_version_create",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/CreateComponentVersion",
      "method": "POST",
      "summary": "Create a component version",
      "description": "Creates a new version folder for an existing component, updates component.json latest/draft pointers, indexes the library, and returns the version row.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "changelog_md": "string",
          "component_id": "string",
          "file_name": "string",
          "from_version": "string",
          "intent": "ComponentVersionIntent",
          "source": "string",
          "version": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component",
          "source_path": "string",
          "version": "ComponentVersion"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid version, file name, or source header"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem or repository failure"
        }
      ]
    },
    {
      "id": "components_styles_list",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/ListDesignStyles",
      "method": "POST",
      "summary": "List design styles",
      "description": "Loads canonical design-style metadata from templates/design and returns the style IDs components may reference.",
      "category": "components",
      "response": {
        "type": "object",
        "properties": {
          "styles": "array<DesignStyle>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Design metadata read failure"
        }
      ]
    },
    {
      "id": "components_style_fit_validate",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/ValidateStyleFit",
      "method": "POST",
      "summary": "Validate component design-style fit",
      "description": "Reads the target scenario's .vrooli/service.json generation.design.id and returns a style-fit verdict for the selected component version.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "scenario": "string",
          "version": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "affinity": "DesignAffinity",
          "component_id": "string",
          "detail": "string",
          "kind": "StyleFitVerdictKind",
          "scenario": "string",
          "scenario_style": "string",
          "version": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component or component version with that id/version"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Scenario service.json read or parse failure"
        }
      ]
    },
    {
      "id": "components_manifest_update",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/UpdateComponentManifest",
      "method": "POST",
      "summary": "Update a component manifest",
      "description": "Updates component.json metadata/latest/draft/deprecation fields, re-indexes the library, and returns the refreshed component row.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "deprecated_versions": "array<string>",
          "description": "string",
          "display_name": "string",
          "draft_version": "string",
          "latest_version": "string",
          "tags": "array<string>"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Invalid manifest values"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem or repository failure"
        }
      ]
    },
    {
      "id": "components_content_get",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponentContent",
      "method": "POST",
      "summary": "Read a component's source file",
      "description": "Returns the raw TSX content of the component's source file plus a SHA-256 digest. Path-traversal guard rejects rows whose source_path escapes the configured root.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "content": "string (utf-8 source)",
          "sha256": "string (hex digest)",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Component source_path escapes configured root"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem read failure"
        }
      ]
    },
    {
      "id": "components_content_set",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/UpdateComponentContent",
      "method": "POST",
      "summary": "Write a component's source file",
      "description": "Overwrites the component's TSX file in place. Pass expected_sha256 from a prior read for optimistic concurrency. Re-run `index` afterward if the @libraryId header changed.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "content": "string (utf-8 source)",
          "expected_sha256": "string (optional)",
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "sha256": "string (hex digest of written content)",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Component source_path escapes configured root"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "expected_sha256 did not match on-disk digest"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem write failure"
        }
      ]
    },
    {
      "id": "components_versions_list",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/ListComponentVersions",
      "method": "POST",
      "summary": "List component versions",
      "description": "Returns release and draft artifacts indexed from the component manifest's version folders.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "limit": "int32"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "versions": "array<ComponentVersion>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ]
    },
    {
      "id": "components_version_content_get",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponentVersionContent",
      "method": "POST",
      "summary": "Read component version source",
      "description": "Returns the indexed source body for a specific component version.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "version": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "content": "string",
          "version": "ComponentVersion"
        }
      },
      "errors": [
        {
