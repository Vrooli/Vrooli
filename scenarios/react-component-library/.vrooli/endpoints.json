{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "adoptions_list",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/ListAdoptions",
      "method": "POST",
      "summary": "List adoption records",
      "description": "Returns adoption records matching optional component_id / scenario / limit filters.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string (filter)",
          "limit": "int32 (max rows, 0 = server default)",
          "scenario": "string (filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoptions": "array<Adoption>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library adoptions list"
      }
    },
    {
      "id": "adoptions_create",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/CreateAdoption",
      "method": "POST",
      "summary": "Create an adoption record",
      "description": "Soft-links a library component to a copy of its source under a target scenario. Validates the component exists; captures a sha256 of the adopted file at create time for later drift comparison.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "adopted_path": "string",
          "adopted_version": "string",
          "component_id": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoption": "Adoption"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing required field or unknown component_id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library adoptions create",
        "args": [
          "<component_id>",
          "<scenario>",
          "<adopted_path>"
        ]
      }
    },
    {
      "id": "adoptions_delete",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/DeleteAdoption",
      "method": "POST",
      "summary": "Delete an adoption record",
      "description": "Removes the adoption record matching the id.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object"
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No adoption with that id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library adoptions delete",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "adoptions_refresh",
      "path": "/vrooli.react_component_library.v1.adoptions.AdoptionsService/RefreshAdoptions",
      "method": "POST",
      "summary": "Refresh drift status for adoption records",
      "description": "Recomputes status (current / behind / modified / unknown) for every adoption record, or just those for a single component when component_id is supplied.",
      "category": "adoptions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string (optional filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "adoptions": "array<Adoption>",
          "behind": "int32",
          "current": "int32",
          "modified": "int32",
          "unknown": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository or filesystem failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library adoptions refresh"
      }
    },
    {
      "id": "components_list",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/ListComponents",
      "method": "POST",
      "summary": "List components",
      "description": "Returns components matching optional match / tag / limit filters through the generated Connect-RPC ComponentsService.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32 (max rows, 0 = server default)",
          "match": "string (case-insensitive substring filter)",
          "tag": "string (exact tag filter)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "components": "array<Component>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components list"
      }
    },
    {
      "id": "components_get",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponent",
      "method": "POST",
      "summary": "Get a component by id",
      "description": "Returns the component matching the request id.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "components_get_by_library_id",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponentByLibraryId",
      "method": "POST",
      "summary": "Get a component by libraryId",
      "description": "Returns the component matching the @libraryId header value.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "library_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "component": "Component"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that libraryId"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components get-by-library-id",
        "args": [
          "<libraryId>"
        ]
      }
    },
    {
      "id": "components_index",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/IndexComponents",
      "method": "POST",
      "summary": "Re-index components from disk",
      "description": "Walks the configured source root for *.tsx files with @libraryId headers and upserts them into the registry. Removes rows whose files have been deleted.",
      "category": "components",
      "response": {
        "type": "object",
        "properties": {
          "deleted": "int32",
          "errors": "array<string>",
          "indexed": "int32",
          "library_ids": "array<string>",
          "scanned": "int32",
          "skipped": "int32"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Walk or upsert failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components index"
      }
    },
    {
      "id": "components_content_get",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/GetComponentContent",
      "method": "POST",
      "summary": "Read a component's source file",
      "description": "Returns the raw TSX content of the component's source file plus a SHA-256 digest. Path-traversal guard rejects rows whose source_path escapes the configured root.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "content": "string (utf-8 source)",
          "sha256": "string (hex digest)",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Component source_path escapes configured root"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components content-get",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "components_content_set",
      "path": "/vrooli.react_component_library.v1.components.ComponentsService/UpdateComponentContent",
      "method": "POST",
      "summary": "Write a component's source file",
      "description": "Overwrites the component's TSX file in place. Pass expected_sha256 from a prior read for optimistic concurrency. Re-run `index` afterward if the @libraryId header changed.",
      "category": "components",
      "request": {
        "type": "object",
        "properties": {
          "content": "string (utf-8 source)",
          "expected_sha256": "string (optional)",
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "sha256": "string (hex digest of written content)",
          "source_path": "string"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Component source_path escapes configured root"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "expected_sha256 did not match on-disk digest"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem write failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library components content-set",
        "args": [
          "<id>",
          "<file>"
        ]
      }
    },
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library status"
      },
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client."
      }
    },
    {
      "id": "preview_get_bundle",
      "path": "/vrooli.react_component_library.v1.preview.PreviewService/GetPreviewBundle",
      "method": "POST",
      "summary": "Bundle a component for preview",
      "description": "Transpiles a component's TSX source to an ES module via esbuild. Used by the CLI for diagnostics and by the harness HTML route for iframe rendering. Externals: react, react-dom, react-dom/client.",
      "category": "preview",
      "request": {
        "type": "object",
        "properties": {
          "id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "js": "string (ES module text)",
          "sha256": "string (hex digest of js)",
          "source_path": "string",
          "warnings": "array<string>"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No component with that id"
        },
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Bundler rejected the file (syntax error or unresolved import) or source_path escapes root"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Filesystem read or bundler internal failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library preview bundle",
        "args": [
          "<id>"
        ]
      }
    },
    {
      "id": "versions_list",
      "path": "/vrooli.react_component_library.v1.versions.VersionsService/ListVersions",
      "method": "POST",
      "summary": "List recorded versions for a component",
      "description": "Returns version rows newest-first for the given component_id.",
      "category": "versions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "limit": "int32 (max rows, 0 = server default)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "versions": "array<Version>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library versions list",
        "args": [
          "<component_id>"
        ]
      }
    },
    {
      "id": "versions_get",
      "path": "/vrooli.react_component_library.v1.versions.VersionsService/GetVersion",
      "method": "POST",
      "summary": "Get a specific recorded version",
      "description": "Returns the row matching (component_id, version). Set include_content=true to receive the full recorded body.",
      "category": "versions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "include_content": "bool",
          "version": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "content": "string (populated only when include_content was true)",
          "version": "Version"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No version with that component_id/version pair"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library versions show",
        "args": [
          "<component_id>",
          "<version>"
        ]
      }
    },
    {
      "id": "versions_diff",
      "path": "/vrooli.react_component_library.v1.versions.VersionsService/DiffVersions",
      "method": "POST",
      "summary": "Diff two versions or a version and an adopted copy",
      "description": "Returns paired left/right diff cells (equal/add/remove/empty). `from` and `to` accept either a @version value or `adoption:<id>` to compare against an adopted copy on disk.",
      "category": "versions",
      "request": {
        "type": "object",
        "properties": {
          "component_id": "string",
          "from": "string (version or adoption:<id>)",
          "to": "string (version or adoption:<id>)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "additions": "int32",
          "from_label": "string",
          "removals": "int32",
          "rows": "array<DiffRow>",
          "to_label": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing from/to or invalid adoption reference"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "Referenced version or adoption does not exist"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository or filesystem failure"
        }
      ],
      "cli_mapping": {
        "command": "react-component-library versions diff",
        "args": [
          "<component_id>",
          "<from>",
          "<to>"
        ]
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "adoptions list",
      "description": "List adoption records (--component-id ID, --scenario NAME, --limit N)",
      "endpoint_id": "adoptions_list"
    },
    {
      "name": "adoptions create",
      "description": "Create an adoption record linking a library component to a scenario tree",
      "endpoint_id": "adoptions_create"
    },
    {
      "name": "adoptions delete",
      "description": "Delete an adoption record by id",
      "endpoint_id": "adoptions_delete"
    },
    {
      "name": "adoptions refresh",
      "description": "Recompute drift status for every adoption (or one component's; use --component-id ID)",
      "endpoint_id": "adoptions_refresh"
    },
    {
      "name": "components index",
      "description": "Walk the source root and refresh the components registry",
      "endpoint_id": "components_index"
    },
    {
      "name": "components list",
      "description": "List indexed components (--match SUBSTR, --tag TAG, --tags a,b, --category CAT, --limit N)",
      "endpoint_id": "components_list"
    },
    {
      "name": "components get",
      "description": "Get a component by id",
      "endpoint_id": "components_get"
    },
    {
      "name": "components get-by-library-id",
      "description": "Get a component by its @libraryId header value",
      "endpoint_id": "components_get_by_library_id"
    },
    {
      "name": "components content-get",
      "description": "Read a component's source file",
      "endpoint_id": "components_content_get"
    },
    {
      "name": "components content-set",
      "description": "Write a component's source file (use - to read from stdin)",
      "endpoint_id": "components_content_set"
    },
    {
      "name": "preview bundle",
      "description": "Print the esbuild-transpiled ES module for a component (used by the live-preview iframe and for diagnostics)",
      "endpoint_id": "preview_get_bundle"
    },
    {
      "name": "versions list",
      "description": "List recorded versions for a component (--limit N)",
      "endpoint_id": "versions_list"
    },
    {
      "name": "versions show",
      "description": "Show a specific recorded version (--with-content to include the body)",
      "endpoint_id": "versions_get"
    },
    {
      "name": "versions diff",
      "description": "Diff two versions or a version and an adoption:<id>",
      "endpoint_id": "versions_diff"
    }
  ]
}
