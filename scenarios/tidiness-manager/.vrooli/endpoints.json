{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "status": "string",
          "readiness": "boolean",
          "dependencies": "object"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "tidiness-manager status"
      }
    },
    {
      "id": "scenario-validation",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate scenario tidiness",
      "description": "Runs maintainability checks through the shared ScenarioValidationService contract and packs tidiness-native detail into native_detail",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string",
          "path": "string",
          "include_execution": "boolean"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus",
          "assessment": "common.v1.MaturityAssessment",
          "native_detail": "google.protobuf.Any<tidiness_manager.v1.validation.TidinessScanResponse>"
        }
      },
      "examples": [
        {
          "name": "Validate tidiness",
          "curl": "curl -X POST http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"proto-health\"}'"
        }
      ],
      "cli_mapping": {
        "command": "tidiness-manager scan <scenario> --type tidiness"
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health",
      "endpoint_id": "health"
    },
    {
      "name": "scan",
      "description": "Trigger tidiness, light, or smart scan for a scenario",
      "usage": "tidiness-manager scan <scenario> [--type tidiness|light|smart] [--wait]"
    },
    {
      "name": "issues",
      "description": "List tidiness issues for a scenario",
      "usage": "tidiness-manager issues <scenario> [--category <category>] [--severity <severity>] [--limit <n>]"
    },
    {
      "name": "campaigns",
      "description": "List or manage auto-tidiness campaigns",
      "usage": "tidiness-manager campaigns [list|start|pause|stop] [<scenario>]"
    }
  ]
}
