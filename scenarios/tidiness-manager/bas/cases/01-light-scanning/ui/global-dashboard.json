{
  "metadata": {
    "description": "[REQ:TM-UI-001] Verify global dashboard displays scenario table with key metrics",
    "requirements": [
      "TM-UI-001"
    ],
    "phase": "business",
    "surface": "ui",
    "capability": "01-light-scanning",
    "reset": "none",
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-dashboard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "tidiness-manager",
          "scenario_path": "/dashboard",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to global dashboard"
        }
      }
    },
    {
      "id": "wait-for-table",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/scenarioTable",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for scenario table"
        }
      }
    },
    {
      "id": "assert-name-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/scenarioTableHeader.name",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Scenario name column header should be visible"
        },
        "metadata": {
          "label": "Verify scenario name column header exists"
        }
      }
    },
    {
      "id": "assert-light-issues-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/scenarioTableHeader.lightIssues",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Light issues column header should be visible"
        },
        "metadata": {
          "label": "Verify light issues column header exists"
        }
      }
    },
    {
      "id": "assert-ai-issues-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/scenarioTableHeader.aiIssues",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "AI issues column header should be visible"
        },
        "metadata": {
          "label": "Verify AI issues column header exists"
        }
      }
    },
    {
      "id": "assert-long-files-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/scenarioTableHeader.longFiles",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Long files column header should be visible"
        },
        "metadata": {
          "label": "Verify long files column header exists"
        }
      }
    },
    {
      "id": "assert-scenario-row",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/scenarioTableRow",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "At least one scenario row should be displayed"
        },
        "metadata": {
          "label": "Verify at least one scenario row exists"
        }
      }
    },
    {
      "id": "capture-dashboard",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture dashboard state"
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-dashboard", "target": "wait-for-table", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e2", "source": "wait-for-table", "target": "assert-name-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e3", "source": "assert-name-header", "target": "assert-light-issues-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4", "source": "assert-light-issues-header", "target": "assert-ai-issues-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e5", "source": "assert-ai-issues-header", "target": "assert-long-files-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e6", "source": "assert-long-files-header", "target": "assert-scenario-row", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e7", "source": "assert-scenario-row", "target": "capture-dashboard", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
