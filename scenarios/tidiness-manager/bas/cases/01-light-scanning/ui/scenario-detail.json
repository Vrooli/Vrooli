{
  "metadata": {
    "description": "[REQ:TM-UI-003,TM-UI-004] Verify scenario detail view shows sortable file table",
    "requirements": [
      "TM-UI-003",
      "TM-UI-004"
    ],
    "phase": "business",
    "surface": "ui",
    "capability": "01-light-scanning",
    "reset": "none",
    "version": "1",
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1440,
    "viewport_height": 900
  },
  "nodes": [
    {
      "id": "navigate-detail",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "tidiness-manager",
          "scenario_path": "/scenario/tidiness-manager",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": {
          "label": "Navigate to scenario detail page"
        }
      }
    },
    {
      "id": "wait-for-table",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/fileTable",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 10000
        },
        "metadata": {
          "label": "Wait for file table"
        }
      }
    },
    {
      "id": "assert-path-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/fileTableHeader.path",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "File path column header should be visible"
        },
        "metadata": {
          "label": "Verify file path column exists"
        }
      }
    },
    {
      "id": "assert-lines-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/fileTableHeader.lines",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Line count column header should be visible"
        },
        "metadata": {
          "label": "Verify line count column exists"
        }
      }
    },
    {
      "id": "assert-issues-header",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/fileTableHeader.issues",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "Issue count column header should be visible"
        },
        "metadata": {
          "label": "Verify issue count column exists"
        }
      }
    },
    {
      "id": "click-sort-lines",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/fileTableHeader.lines"
        },
        "metadata": {
          "label": "Click to sort by line count"
        }
      }
    },
    {
      "id": "assert-table-after-sort",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/fileTable",
          "mode": "ASSERTION_MODE_EXISTS",
          "timeout_ms": 5000,
          "failure_message": "File table should remain visible after sorting, even when the current dataset is empty"
        },
        "metadata": {
          "label": "Verify table remains visible after sort"
        }
      }
    },
    {
      "id": "capture-detail",
      "action": {
        "type": "ACTION_TYPE_SCREENSHOT",
        "screenshot": {
          "full_page": true
        },
        "metadata": {
          "label": "Capture scenario detail state"
        }
      }
    }
  ],
  "edges": [
    { "id": "e1", "source": "navigate-detail", "target": "wait-for-table", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e2", "source": "wait-for-table", "target": "assert-path-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e3", "source": "assert-path-header", "target": "assert-lines-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e4", "source": "assert-lines-header", "target": "assert-issues-header", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e5", "source": "assert-issues-header", "target": "click-sort-lines", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e6", "source": "click-sort-lines", "target": "assert-table-after-sort", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" },
    { "id": "e7", "source": "assert-table-after-sort", "target": "capture-detail", "type": "WORKFLOW_EDGE_TYPE_SMOOTHSTEP" }
  ]
}
