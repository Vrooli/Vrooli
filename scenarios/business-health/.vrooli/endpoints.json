{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "Response",
        "properties": {
          "dependencies": "object",
          "readiness": "boolean",
          "status": "string"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "rest_exception": {
        "reason": "ops_probe",
        "note": "Plain GET /health for lifecycle systems, load balancers, and curl probes that cannot use a generated Connect client.",
        "proto_payloads": {
          "request": {
            "transport": "none",
            "conformance": "none"
          },
          "response": {
            "proto_full_name": "vrooli.business_health.v1.shared.Response",
            "transport": "json",
            "conformance": "protojson"
          },
          "error": {
            "proto_full_name": "vrooli.business_health.v1.shared.ErrorEnvelope",
            "transport": "json",
            "conformance": "protojson"
          }
        }
      }
    },
    {
      "id": "fleet_scan",
      "path": "/vrooli.business_health.v1.fleet.FleetService/ScanFleet",
      "method": "POST",
      "summary": "Fleet-wide business-contract debt sweep",
      "description": "Grades every discovered scenario's business contract (starter registries, template laggards, orphaned targets, unproven claims) through the same check engine as per-scenario validation, worst-first with as-of stamps. Compute-on-read; nothing cached.",
      "category": "fleet",
      "request": {
        "type": "object",
        "properties": {
          "scenarios": "array<string> (optional subset; empty = every discovered scenario)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "as_of": "timestamp",
          "entries": "array<FleetScenarioEntry> (worst-first)",
          "errors": "array<FleetScanError>",
          "passing_count": "int",
          "scenario_count": "int"
        }
      },
      "examples": [
        {
          "name": "Scan the fleet",
          "curl": "curl http://localhost:${API_PORT}/vrooli.business_health.v1.fleet.FleetService/ScanFleet -H 'Content-Type: application/json' -d '{}'"
        }
      ]
    },
    {
      "id": "search_query",
      "path": "/vrooli.business_health.v1.search.SearchService/Search",
      "method": "POST",
      "summary": "Search the fleet-wide intent corpus",
      "description": "Semantic (AI) and text-fallback search over every scenario's PRD purpose, operational targets, and requirements — 'which scenario provides capability X' and 'what is Y supposed to deliver'. Pointer-only results (anchors into PRD/requirements).",
      "category": "search",
      "request": {
        "type": "object",
        "properties": {
          "limit": "int32",
          "mode": "Mode",
          "query": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "degraded_reason": "string",
          "mode": "Mode",
          "results": "array<IntentHit>"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "No search backend configured"
        },
        {
          "status": 503,
          "code": "unavailable",
          "description": "Both the AI leg and the text fallback failed"
        }
      ],
      "examples": [
        {
          "name": "Capability query",
          "curl": "curl http://localhost:${API_PORT}/vrooli.business_health.v1.search.SearchService/Search -H 'Content-Type: application/json' -d '{\"query\":\"which scenario resizes images\",\"limit\":5}'"
        }
      ]
    },
    {
      "id": "search_status",
      "path": "/vrooli.business_health.v1.search.SearchService/Status",
      "method": "POST",
      "summary": "Report intent-search backend availability",
      "description": "Reports ollama/qdrant/reranker reachability, indexed doc count, and the live collection.",
      "category": "search",
      "response": {
        "type": "object",
        "properties": {
          "available": "bool",
          "collection": "string",
          "indexed": "int64"
        }
      }
    },
    {
      "id": "searchcontrol_reindex",
      "path": "/vrooli.search_hub.v1.control.SearchControlService/Reindex",
      "method": "POST",
      "summary": "Start a reindex job (token-gated)",
      "description": "Queues a reconcile job that upserts/deletes points in Qdrant. Requires the provider's control token and the enabled control plane.",
      "category": "searchcontrol",
      "request": {
        "type": "object",
        "properties": {
          "control_token": "string (required)",
          "dry_run": "boolean",
          "scope": "string (optional provider sub-scope; empty means the whole corpus)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "dry_run": "boolean",
          "job_id": "string",
          "planned_deletes": "int32",
          "planned_upserts": "int32"
        }
      },
      "errors": [
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Control plane disabled or control token mismatch"
        },
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Returned only when no reindex backend is configured"
        }
      ],
      "examples": [
        {
          "name": "Reindex (dry-run)",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.control.SearchControlService/Reindex -H 'Content-Type: application/json' -d '{\"dry_run\":true,\"control_token\":\"<token>\"}'"
        }
      ]
    },
    {
      "id": "searchcontrol_reindex_status",
      "path": "/vrooli.search_hub.v1.control.SearchControlService/ReindexStatus",
      "method": "POST",
      "summary": "Poll reindex job status (token-gated)",
      "description": "Returns the progress, state, and (on failure) error for a previously-started reindex job.",
      "category": "searchcontrol",
      "request": {
        "type": "object",
        "properties": {
          "control_token": "string (required)",
          "job_id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "error": "string",
          "job_id": "string",
          "processed": "int32",
          "state": "string",
          "total": "int32"
        }
      },
      "errors": [
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Control plane disabled or control token mismatch"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "No reindex job with that id"
        }
      ],
      "examples": [
        {
          "name": "Job status",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.control.SearchControlService/ReindexStatus -H 'Content-Type: application/json' -d '{\"job_id\":\"job-abc\",\"control_token\":\"<token>\"}'"
        }
      ]
    },
    {
      "id": "searchcontrol_reindex_cancel",
      "path": "/vrooli.search_hub.v1.control.SearchControlService/ReindexCancel",
      "method": "POST",
      "summary": "Cancel a reindex job (token-gated)",
      "description": "Requests cooperative cancellation of an in-flight job. Idempotent: cancelling a terminal job returns cancelled=false.",
      "category": "searchcontrol",
      "request": {
        "type": "object",
        "properties": {
          "control_token": "string (required)",
          "job_id": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "cancelled": "boolean",
          "job_id": "string"
        }
      },
      "errors": [
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Control plane disabled or control token mismatch"
        }
      ],
      "examples": [
        {
          "name": "Cancel job",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.control.SearchControlService/ReindexCancel -H 'Content-Type: application/json' -d '{\"job_id\":\"job-abc\",\"control_token\":\"<token>\"}'"
        }
      ]
    },
    {
      "id": "searchcontrol_write_config",
      "path": "/vrooli.search_hub.v1.control.SearchControlService/WriteConfig",
      "method": "POST",
      "summary": "Write a tuning block back to search.json (token-gated)",
      "description": "Validates a new tuning block and atomically rewrites the provider's search.json, triggering a reindex when an index-time factor changed. The search-hub sweep's write-back verb; not an interactive operator command.",
      "category": "searchcontrol",
      "request": {
        "type": "object",
        "properties": {
          "control_token": "string (required)",
          "dry_run": "boolean (validate + diff without writing)",
          "provider_id": "string (required; the leaf whose tuning is rewritten)",
          "tuning": "object (full replacement tuning block)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "effective": "object (tuning now in effect)",
          "reindex_job_id": "string",
          "reindex_triggered": "boolean",
          "written": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing provider_id or invalid tuning factor"
        },
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Control plane disabled or control token mismatch"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "provider_id not present in search.json"
        }
      ],
      "examples": [
        {
          "name": "Write config (dry-run)",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.control.SearchControlService/WriteConfig -H 'Content-Type: application/json' -d '{\"provider_id\":\"business-health.commands\",\"dry_run\":true,\"control_token\":\"<token>\",\"tuning\":{\"engine\":\"dense\"}}'"
        }
      ]
    },
    {
      "id": "searchcontrol_write_corpus",
      "path": "/vrooli.search_hub.v1.control.SearchControlService/WriteCorpus",
      "method": "POST",
      "summary": "Write an evaluation corpus back to search.json (token-gated)",
      "description": "Validates a new evaluation corpus (the tests block, carried as an eval EvalSuite) and atomically rewrites ONLY that block in the provider's search.json — the corpus twin of WriteConfig. The search-hub optimizer's corpus write-back verb (e.g. `evals generate --apply`); not an interactive operator command. Never triggers a reindex.",
      "category": "searchcontrol",
      "request": {
        "type": "object",
        "properties": {
          "control_token": "string (required)",
          "corpus": "object (full replacement tests block, as an eval EvalSuite)",
          "dry_run": "boolean (validate + diff without writing)",
          "provider_id": "string (required; the leaf whose corpus is rewritten)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "effective": "object (corpus now in effect, as an eval EvalSuite)",
          "written": "boolean"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing provider_id or a malformed corpus (case missing id/query, duplicate id)"
        },
        {
          "status": 403,
          "code": "permission_denied",
          "description": "Control plane disabled or control token mismatch"
        },
        {
          "status": 404,
          "code": "not_found",
          "description": "provider_id not present in search.json"
        }
      ],
      "examples": [
        {
          "name": "Write corpus (dry-run)",
          "curl": "curl http://localhost:${API_PORT}/vrooli.search_hub.v1.control.SearchControlService/WriteCorpus -H 'Content-Type: application/json' -d '{\"provider_id\":\"business-health.commands\",\"dry_run\":true,\"control_token\":\"<token>\",\"corpus\":{\"suite_id\":\"business-health.commands.primary\",\"cases\":[]}}'"
        }
      ]
    },
    {
      "id": "validation_validate_scenario",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's business contract (shared mount)",
      "description": "Validates one scenario's PRD.md + requirements/ (template conformance, registry structure, intent linkage, evidence traceability) and returns the shared maturity assessment with execution metrics.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional resolved path)",
          "scenario": "string (required, scenario slug)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "metrics": "common.v1.ExecutionMetrics",
          "native_detail": "google.protobuf.Any (business_health.v1.contract.BusinessContractReport)",
          "scenario": "string",
          "status": "scenario_validation.v1.ValidationStatus"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario slug or unresolvable target"
        }
      ],
      "examples": [
        {
          "name": "Validate a scenario",
          "curl": "curl http://localhost:${API_PORT}/vrooli.scenario_validation.v1.ScenarioValidationService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"image-tools\"}'"
        }
      ]
    },
    {
      "id": "validation_preview_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/PreviewFix",
      "method": "POST",
      "summary": "Preview deterministic business-contract fixes",
      "description": "Dry-run of the deterministic fixers (template-section scaffold, registry creation, status normalization, prd_ref stubs). Fixers register in plan phase 6; until then the registry answers with no candidates.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "rule_ids": "array<string> (optional filter)",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "boolean (always false)",
          "candidates": "array<FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      }
    },
    {
      "id": "validation_apply_fix",
      "path": "/vrooli.scenario_validation.v1.ScenarioValidationService/ApplyFix",
      "method": "POST",
      "summary": "Apply deterministic business-contract fixes",
      "description": "Applies the previewed deterministic fixes. Fixers register in plan phase 6; until then the registry answers with no candidates.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "rule_ids": "array<string> (optional filter)",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "applied": "boolean",
          "candidates": "array<FixCandidate>",
          "messages": "array<string>",
          "scenario": "string"
        }
      }
    },
    {
      "id": "contract_validate_scenario",
      "path": "/vrooli.business_health.v1.contract.ContractService/ValidateScenario",
      "method": "POST",
      "summary": "Validate a scenario's business contract (native detail)",
      "description": "Same validation as the shared mount, answering with the rich native BusinessContractReport (capability rollups, matrix rows, drift entries) beside the shared assessment.",
      "category": "validation",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional resolved path)",
          "scenario": "string (required, scenario slug)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "assessment": "common.v1.MaturityAssessment",
          "report": "BusinessContractReport",
          "scenario": "string",
          "status": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario slug or unresolvable target"
        }
      ],
      "examples": [
        {
          "name": "Native validate",
          "curl": "curl http://localhost:${API_PORT}/vrooli.business_health.v1.contract.ContractService/ValidateScenario -H 'Content-Type: application/json' -d '{\"scenario\":\"image-tools\"}'"
        }
      ]
    },
    {
      "id": "contract_get_matrix",
      "path": "/vrooli.business_health.v1.contract.ContractService/GetMatrix",
      "method": "POST",
      "summary": "Traceability matrix for one scenario",
      "description": "OT × requirement × validation × evidence join. Lands with the evidence domain (plan phase 4); answers Unimplemented until then.",
      "category": "traceability",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "matrix": "array<MatrixRow>",
          "registry": "RegistrySummary"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Matrix lands in plan phase 4"
        }
      ]
    },
    {
      "id": "contract_get_drift",
      "path": "/vrooli.business_health.v1.contract.ContractService/GetDrift",
      "method": "POST",
      "summary": "Evidence drift for one scenario",
      "description": "Stale snapshots, expired manual attestations, unearned statuses, unproven claims. Lands with the evidence domain (plan phase 4); answers Unimplemented until then.",
      "category": "traceability",
      "request": {
        "type": "object",
        "properties": {
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "drift": "array<DriftEntry>"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Drift lands in plan phase 4"
        }
      ]
    },
    {
      "id": "contract_log_manual_validation",
      "path": "/vrooli.business_health.v1.contract.ContractService/LogManualValidation",
      "method": "POST",
      "summary": "Append a manual-validation attestation",
      "description": "Appends to the manual-validations ledger (the one evidence artifact business-health owns). Lands with the evidence domain (plan phase 4); answers Unimplemented until then.",
      "category": "traceability",
      "request": {
        "type": "object",
        "properties": {
          "attested_by": "string",
          "notes": "string",
          "requirement_id": "string",
          "scenario": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "attestation": "ManualAttestation",
          "ledger_path": "string"
        }
      },
      "errors": [
        {
          "status": 501,
          "code": "unimplemented",
          "description": "Ledger lands in plan phase 4"
        }
      ]
    },
    {
      "id": "wizard_start_session",
      "path": "/vrooli.business_health.v1.wizard.WizardService/StartSession",
      "method": "POST",
      "summary": "Start or resume a contract-authoring wizard session",
      "description": "Creates (or resumes) the deterministic interview session for scaffolding a conformant PRD.md + requirements/ skeleton. Question model derives from the same template definitions the validator checks.",
      "category": "wizard",
      "request": {
        "type": "object",
        "properties": {
          "path": "string (optional resolved target)",
          "reset": "boolean (discard the existing session)",
          "scenario": "string (required)"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "answers": "map<string, Answer>",
          "complete": "boolean",
          "hints": "array<CapabilityHint>",
          "questions": "array<Question>",
          "remaining": "array<string>",
          "session_id": "string"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "Missing scenario or unresolvable target"
        }
      ],
      "examples": [
        {
          "name": "Start a session",
          "curl": "curl http://localhost:${API_PORT}/vrooli.business_health.v1.wizard.WizardService/StartSession -H 'Content-Type: application/json' -d '{\"scenario\":\"my-scenario\"}'"
        }
      ]
    },
    {
      "id": "wizard_submit_answers",
      "path": "/vrooli.business_health.v1.wizard.WizardService/SubmitAnswers",
      "method": "POST",
      "summary": "Record wizard answers",
      "description": "Validates and records answers into a session (invalid answers come back with reasons; valid ones persist).",
      "category": "wizard",
      "request": {
        "type": "object",
        "properties": {
          "answers": "array<Answer>",
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "complete": "boolean",
          "remaining": "array<string>"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown session id"
        }
      ]
    },
    {
      "id": "wizard_preview_scaffold",
      "path": "/vrooli.business_health.v1.wizard.WizardService/PreviewScaffold",
      "method": "POST",
      "summary": "Preview the scaffold as diffs (dry-run)",
      "description": "Renders the PRD.md + requirements/ artifacts the current answers produce, as diffs against the target tree. Never writes.",
      "category": "wizard",
      "request": {
        "type": "object",
        "properties": {
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "blocking": "array<string>",
          "files": "array<FileDiff>"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "Unknown session id"
        }
      ]
    },
    {
      "id": "wizard_apply_scaffold",
      "path": "/vrooli.business_health.v1.wizard.WizardService/ApplyScaffold",
      "method": "POST",
      "summary": "Write the previewed scaffold (explicit apply)",
      "description": "Writes the previewed artifacts (requires apply=true and a complete answer set), then re-validates the target — residual_findings is expected empty (the round-trip guarantee).",
      "category": "wizard",
      "request": {
        "type": "object",
        "properties": {
          "apply": "boolean (required true)",
          "session_id": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "residual_findings": "array<string>",
          "written": "array<string>"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_argument",
          "description": "apply=true missing"
        },
        {
          "status": 412,
          "code": "failed_precondition",
          "description": "Required questions unanswered"
        }
      ]
    }
  ]
}
