{
  "metadata": {
    "name": "wizard-happy-path",
    "description": "Contract wizard happy path: opens the wizard, chooses the business-health scenario through the shared scenario picker, starts the interview, and asserts the progress indicator + first question render. Proves StartSession drives the question model into the UI.",
    "requirement": "BH-UX-003",
    "version": "1",
    "labels": {
      "reset": "none",
      "surface": "wizard"
    },
    "execution_mode": "observer"
  },
  "settings": {
    "viewport_width": 1280,
    "viewport_height": 800
  },
  "nodes": [
    {
      "id": "navigate-wizard",
      "action": {
        "type": "ACTION_TYPE_NAVIGATE",
        "navigate": {
          "destination_type": "NAVIGATE_DESTINATION_TYPE_SCENARIO",
          "scenario": "business-health",
          "scenario_path": "/wizard",
          "wait_until": "NAVIGATE_WAIT_EVENT_NETWORKIDLE",
          "timeout_ms": 30000
        },
        "metadata": { "label": "Open the contract wizard" }
      }
    },
    {
      "id": "wait-picker",
      "action": {
        "type": "ACTION_TYPE_WAIT",
        "wait": {
          "selector": "@selector/scenarioPicker.input",
          "state": "WAIT_STATE_VISIBLE",
          "timeout_ms": 15000
        },
        "metadata": { "label": "Scenario picker input visible" }
      }
    },
    {
      "id": "enter-scenario",
      "action": {
        "type": "ACTION_TYPE_INPUT",
        "input": {
          "selector": "@selector/scenarioPicker.input",
          "value": "business-health",
          "clear_first": true
        },
        "metadata": { "label": "Type the scenario slug" }
      }
    },
    {
      "id": "start-session",
      "action": {
        "type": "ACTION_TYPE_CLICK",
        "click": {
          "selector": "@selector/scenarioPicker.submit"
        },
        "metadata": { "label": "Start the wizard session" }
      },
      "execution_settings": { "wait_after_ms": 800 }
    },
    {
      "id": "assert-progress",
      "action": {
        "type": "ACTION_TYPE_ASSERT",
        "assert": {
          "selector": "@selector/wizard.progress",
          "mode": "ASSERTION_MODE_VISIBLE",
          "timeout_ms": 15000,
          "failure_message": "Wizard progress indicator did not render — StartSession did not return a question model (check WizardService.StartSession for business-health)."
        },
        "metadata": { "label": "Assert the interview progress indicator rendered" }
      }
    }
  ]
}
