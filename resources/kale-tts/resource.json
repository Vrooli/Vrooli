{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "kale-tts",
  "display_name": "Kale TTS Nano (experimental)",
  "description": "Experimental local CPU text-to-speech service using the public Apache-2.0 Kale TTS Nano int8 ONNX model; product quality and lifecycle qualification remain open.",
  "storage": {
    "entries": {
      "models": {
        "rung": "pinned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "The experimental runtime uses this pinned model, voice, and tokenizer tree.",
        "subpath": "models/kale-tts-1-nano",
        "reacquisition": {
          "command": "vrooli resource install kale-tts",
          "evidence": "resource.json#/managed_service/data_artifacts pins the model, voices, and tokenizer by revision and SHA-256"
        }
      },
      "runtime-source": {
        "rung": "pinned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "The minimal upstream Python inference wrapper and English frontend assets are acquired by exact URL and SHA-256 at install time.",
        "subpath": "source",
        "reacquisition": {
          "command": "vrooli resource install kale-tts",
          "evidence": "resource.json#/managed_service/data_artifacts pins the inference wrapper, frontend, and licenses by revision and SHA-256"
        }
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "resource-kale-tts",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": { "location": "sibling" },
      "build_metadata": { "location": "sibling" }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-kale-tts_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-kale-tts"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "driver": "managed-service",
  "managed_service": {
    "artifact_role": "managed-service",
    "provenance_class": "upstream-digest",
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/kale-tts",
      "version": "b6ce1887268c3667994fc3b0b2c82887c069915c",
      "layout": "dir",
      "entry_path": "runtime/bin/python3.12",
      "sha256_by_platform": {
        "linux-amd64": "cf38c6dc79ff578c40454b79c12b35356f6c4049de43b013b525d3fb95facb63"
      },
      "bundle_artifact": "kale-tts_${os}_${arch}"
    },
    "acquisition": {
      "kind": "composed",
