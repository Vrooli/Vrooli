{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "stable-audio-3",
  "display_name": "Stable Audio 3 Medium",
  "description": "Pinned offline Medium music generation; native qualification pending.",
  "driver": "managed-service",
  "cli": {
    "enabled": true,
    "command": "resource-stable-audio-3",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-stable-audio-3_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-stable-audio-3"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "server/**",
        "requirements.in",
        "requirements.lock",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/stable-audio-3",
        "field": "huggingface-token",
        "label": "Hugging Face gated model read token",
        "provisioning": "operator",
        "description": "Acquisition-only access to the accepted Stable Audio 3 Medium model gate. Never injected into the inference process.",
        "required": false,
        "obtain_url": "https://huggingface.co/settings/tokens"
      }
    ]
  },
  "storage": {
    "entries": {
      "models": {
        "rung": "pinned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Pinned reacquirable weights require owner-fenced retention using confirmed lifecycle quiescence and pins; generic filesystem-age deletion is unsafe.",
        "budget": {
          "max_age": "30d",
          "rationale": "May be reacquired only while authorized."
        },
        "subpath": "models",
        "reclaim": {
          "pruner": "custom",
          "command": "vrooli resource acquisition model-cache stable-audio-3"
        }
      },
      "outputs": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": true,
        "rationale": "Per-operation audio and receipt retained for caller export; operator-owned bundles outlive transient resource outputs.",
        "subpath": "outputs"
      }
    }
  },
  "managed_service": {
    "artifact_role": "managed-service",
    "provenance_class": "upstream-digest",
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
