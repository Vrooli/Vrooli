{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "cloudflare-ai-gateway",
  "display_name": "Cloudflare AI Gateway",
  "description": "Hosted Cloudflare AI Gateway control plane with a thin Go CLI and provider-specific logic organized under internal cloud-api packages.",
  "cli": {
    "enabled": true,
    "command": "resource-cloudflare-ai-gateway",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-cloudflare-ai-gateway"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "endpoint": "https://api.cloudflare.com/client/v4/accounts",
  "credentials": {
    "env": [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN"
    ],
    "secret_ref": "secret/resources/cloudflare"
  },
  "orchestration": {
    "startup_order": 630,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "portability_tier": "full",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://api.cloudflare.com/client/v4/accounts",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "2"
}
