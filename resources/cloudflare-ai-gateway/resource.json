{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "cloudflare-ai-gateway",
  "display_name": "Cloudflare AI Gateway",
  "description": "Hosted Cloudflare AI Gateway control plane with native credential/status checks and shell-retained gateway configuration actions.",
  "template": "cloud-api",
  "driver": "cloud-api",
  "endpoint": "https://api.cloudflare.com/client/v4/accounts",
  "credentials": {
    "env": [
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN"
    ],
    "secret_ref": "secret/resources/cloudflare"
  },
  "orchestration": {
    "startup_order": 630,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "portability_tier": "full",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://api.cloudflare.com/client/v4/accounts",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "2"
}
