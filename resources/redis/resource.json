{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "redis",
  "display_name": "Redis Cache",
  "description": "Redis event bus and cache layer for project and scenario workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-redis",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-redis"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "storage",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "redis",
      "container": 6379,
      "host": 6380
    }
  ],
  "health_checks": [
    {
      "type": "tcp",
      "target": "127.0.0.1:6380",
      "interval_seconds": 10,
      "timeout_seconds": 5
    }
  ],
  "runtime": {
    "image": "redis:7-alpine",
    "container_name": "vrooli-redis-resource",
    "command": [
      "redis-server",
      "--appendonly",
      "no",
      "--save",
      "900",
      "1",
      "300",
      "10",
      "60",
      "10000",
      "--maxmemory",
      "2gb",
      "--maxmemory-policy",
      "allkeys-lru",
      "--protected-mode",
      "no",
      "--bind",
      "0.0.0.0",
      "--port",
      "6379"
    ],
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/data"
      }
    ]
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Redis dependency settings.",
    "properties": {
      "access_method": {
        "type": "string"
      },
      "fallback": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "REDIS_HOST": "localhost",
      "REDIS_DB": "0"
    },
    "from_ports": {
      "REDIS_PORT": "redis"
    },
    "from_runtime_env": [
      "REDIS_PASSWORD"
    ],
    "derived": {
      "REDIS_URL": {
        "template": "redis://${REDIS_HOST}:${REDIS_PORT}"
      },
      "REDIS_BASE_URL": {
        "template": "${REDIS_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 999,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "2-5s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "critical"
  },
  "lifecycle": {
    "start_timeout_seconds": 15,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2"
}
