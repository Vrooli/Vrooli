{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "reranker",
  "storage": {
    "entries": {
      "model_cache": {
        "rung": "relocatable",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/reranker/model-cache",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/reranker/model-cache",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/reranker/model-cache"
        },
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "relocation": {
          "key": "RESOURCE_DATA_DIR",
          "scope": "container"
        },
        "rationale": "Text Embeddings Inference downloads the model into the bind-mounted /data cache; the model is re-downloadable.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    }
  },
  "display_name": "Reranker",
  "description": "Managed cross-encoder reranking service (HuggingFace Text-Embeddings-Inference serving BAAI/bge-reranker-v2-m3) with a compose-backed lifecycle. Scores query/passage relevance for the second stage of hybrid retrieval; consumed by aisearch-go and search-hub.",
  "cli": {
    "enabled": true,
    "command": "resource-reranker",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-reranker_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-reranker"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "docker/docker-compose.yml",
  "gpu": {
    "probe": "nvidia",
    "compose_overlay": "docker/docker-compose.gpu.yml"
  },
  "capacity": {
    "resource_kind": "vram",
    "gpu_index": 0,
    "preferred_bytes": 1503238553,
    "floor_bytes": 1503238553,
    "priority": "service"
  },
  "category": "ai",
  "requirements": {
    "ram_mb": 3072,
    "disk_mb": 4096,
    "cpu_cores": 2,
    "gpu": true,
    "network": "required",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 80,
      "host": 11453
    }
  ],
  "orchestration": {
    "startup_order": 566,
    "startup_timeout_seconds": 180,
    "startup_time_estimate": "first start pulls ~2.3GB model (1-5 min); warm start 10-30s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "RERANKER_HOST": "localhost",
      "RERANKER_MODEL": "BAAI/bge-reranker-v2-m3"
    },
    "from_ports": {
      "RERANKER_PORT": "http"
    },
    "derived": {
      "RERANKER_URL": {
        "template": "http://${RERANKER_HOST}:${RERANKER_PORT}"
      },
      "RERANKER_BASE_URL": {
        "template": "${RERANKER_URL}"
      },
      "RERANKER_RERANK_ENDPOINT": {
        "template": "${RERANKER_URL}/rerank"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:11453/health",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
