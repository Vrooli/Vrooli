{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "postgis",
  "display_name": "PostGIS",
  "description": "Managed PostGIS spatial database with compose-backed custom image build support and shell-retained GIS workflows.",
  "template": "compose-service",
  "driver": "compose-service",
  "compose_file": "compose.yaml",
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [
    "postgres"
  ],
  "ports": [
    {
      "name": "postgresql",
      "container": 5432,
      "host": 5434
    }
  ],
  "health_checks": [
    {
      "type": "tcp",
      "target": "127.0.0.1:5434",
      "interval_seconds": 10,
      "timeout_seconds": 5
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
