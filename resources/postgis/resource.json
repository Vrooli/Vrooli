{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "postgis",
  "display_name": "PostGIS",
  "description": "Managed PostGIS spatial database with compose-backed custom image build support and shell-retained GIS workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-postgis",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "compose_file": "compose.yaml",
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [
    "postgres"
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific PostGIS dependency settings.",
    "properties": {
      "container": {
        "type": "object",
        "additionalProperties": true
      },
      "database": {
        "type": "object",
        "additionalProperties": true
      },
      "spatial": {
        "type": "object",
        "additionalProperties": true
      },
      "performance": {
        "type": "object",
        "additionalProperties": true
      },
      "storage": {
        "type": "object",
        "additionalProperties": true
      },
      "healthcheck": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "ports": [
    {
      "name": "postgresql",
      "container": 5432,
      "host": 5434
    }
  ],
  "orchestration": {
    "startup_order": 995,
    "startup_timeout_seconds": 35,
    "startup_time_estimate": "8-18s",
    "dependencies": ["postgres"],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "health_checks": [
    {
      "type": "tcp",
      "target": "127.0.0.1:5434",
      "interval_seconds": 10,
      "timeout_seconds": 5
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
