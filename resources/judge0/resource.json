{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "judge0",
  "display_name": "Judge0",
  "description": "Managed Judge0 execution stack for sandboxed code execution with Redis and PostgreSQL sidecars.",
  "cli": {
    "enabled": true,
    "command": "resource-judge0",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-judge0_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-judge0"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module",
      "freshness_inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-engine"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "compose.yaml",
  "portability_tier": "full",
  "category": "development",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 2358,
      "host": 2358
    }
  ],
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 30,
    "startup_time_estimate": "8-15s",
    "dependencies": [
      "postgres",
      "redis"
    ],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "JUDGE0_HOST": "localhost",
      "JUDGE0_API_PREFIX": "/api/v1"
    },
    "from_ports": {
      "JUDGE0_PORT": "http"
    },
    "from_runtime_env": [
      "JUDGE0_API_KEY"
    ],
    "derived": {
      "JUDGE0_BASE_URL": {
        "template": "http://${JUDGE0_HOST}:${JUDGE0_PORT}"
      },
      "JUDGE0_URL": {
        "template": "${JUDGE0_BASE_URL}"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:2358/version",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
