{
  "bundling": "host-required",
  "cli": {
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "command": "resource-openrgb",
    "distribution": {
      "artifact_name": "resource-openrgb_${os}_${arch}",
      "kind": "prebuilt_artifact"
    },
    "enabled": true,
    "freshness": {
      "inputs": [
        "cli/**",
        "README.md",
        "resource.json"
      ]
    },
    "invoke": {
      "command": "resource-openrgb",
      "kind": "installed_command"
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "description": "Opt-in, locally bound OpenRGB SDK backend for enrolled lighting controllers.",
  "display_name": "OpenRGB",
  "driver": "managed-service",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "sdk",
      "container": 6742,
      "host": 6742
    }
  ],
  "health_checks": [
    {
      "type": "openrgb-sdk-v6",
      "kind": "readiness",
      "target": "127.0.0.1:${RESOURCE_PORT_SDK}",
      "interval_seconds": 5,
      "timeout_seconds": 5
    },
    {
      "type": "openrgb-sdk-v6",
      "kind": "liveness",
      "target": "127.0.0.1:${RESOURCE_PORT_SDK}",
      "interval_seconds": 30,
      "timeout_seconds": 5
    }
  ],
  "orchestration": {
    "startup_order": 900,
    "startup_timeout_seconds": 60,
    "recovery_attempts": 1,
    "priority": "low"
  },
  "managed_service": {
    "host_tool_executable": "openrgb",
    "host_tool_version": "1.1",
    "source_selection_required": true,
    "artifact_role": "managed-service",
    "provenance_class": "official-origin-observed-sha256",
    "artifact": {
      "path": "server/openrgb.AppImage",
      "version": "1.1",
      "layout": "file",
      "sha256_by_platform": {
        "linux-amd64": "d556c2273b0ef863dbee7ffdb438304b382add5d685c93c60758b42de3b0268d",
        "linux-arm64": "0fd6806c265f9dbd9b0a8847cf4b4cb172c86baf2e39f52f869f8c5325c6751b",
        "macos-amd64": "5b30d3c97bced335a40593319cb4c045f1ad818a0e0ddefd92350a695a7a6fc4",
        "macos-arm64": "b370d3365eaae8b6a9217e7d1b1ffd5fb6ddffaaff3395fd3cac3673df83191f",
        "windows-amd64": "63291726c6fc84eb479ef2ee752e97e1187f6ce9c49fd27eee40ded588a8172a"
      }
    },
    "acquisition": {
      "kind": "url",
      "license": "GPL-2.0-or-later",
      "provenance": {
        "kind": "none"
      },
      "targets": [
        {
          "when": {
            "os": "linux",
            "arch": "amd64"
          },
          "url": "https://codeberg.org/OpenRGB/OpenRGB/releases/download/release_1.1/OpenRGB_1.1_x86_64_8e16de2.AppImage",
          "sha256": "d556c2273b0ef863dbee7ffdb438304b382add5d685c93c60758b42de3b0268d",
          "layout": "file",
          "bin_path": "OpenRGB.AppImage",
          "mode": "0755"
        },
        {
          "when": {
            "os": "linux",
            "arch": "arm64"
          },
          "url": "https://codeberg.org/OpenRGB/OpenRGB/releases/download/release_1.1/OpenRGB_1.1_arm64_8e16de2.AppImage",
          "sha256": "0fd6806c265f9dbd9b0a8847cf4b4cb172c86baf2e39f52f869f8c5325c6751b",
          "layout": "file",
          "archive": "none",
          "bin_path": "OpenRGB.AppImage",
          "mode": "0755"
        },
        {
          "when": {
            "os": "macos",
            "arch": "amd64"
          },
          "url": "https://codeberg.org/OpenRGB/OpenRGB/releases/download/release_1.1/OpenRGB_1.1_MacOS_Intel_8e16de2.zip",
          "sha256": "5b30d3c97bced335a40593319cb4c045f1ad818a0e0ddefd92350a695a7a6fc4",
          "layout": "file",
          "archive": "none",
          "bin_path": "OpenRGB.AppImage",
          "mode": "0755"
        },
        {
          "when": {
            "os": "macos",
            "arch": "arm64"
          },
          "url": "https://codeberg.org/OpenRGB/OpenRGB/releases/download/release_1.1/OpenRGB_1.1_MacOS_ARM64_8e16de2.zip",
          "sha256": "b370d3365eaae8b6a9217e7d1b1ffd5fb6ddffaaff3395fd3cac3673df83191f",
          "layout": "file",
          "archive": "none",
          "bin_path": "OpenRGB.AppImage",
          "mode": "0755"
        },
        {
          "when": {
            "os": "windows",
            "arch": "amd64"
          },
          "url": "https://codeberg.org/OpenRGB/OpenRGB/releases/download/release_1.1/OpenRGB_1.1_Windows_64_8e16de2.zip",
          "sha256": "63291726c6fc84eb479ef2ee752e97e1187f6ce9c49fd27eee40ded588a8172a",
          "layout": "file",
          "archive": "none",
          "bin_path": "OpenRGB.AppImage",
          "mode": "0755"
        },
        {
          "when": {
            "os": "windows",
            "arch": "arm64"
          },
          "unsupported": "OpenRGB1.1 publishes no Windows ARM64 native release; emulation is not qualified."
        }
      ]
    },
    "provider_policy": {
      "allowed_modes": [
        "managed-private"
      ],
      "external_management": "forbidden",
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      }
    },
    "update_policy": {
      "strategy": "exclusive-stop-start",
      "candidate_port": "sdk"
    },
    "arguments": [
      "--server",
      "--server-host",
      "127.0.0.1",
      "--server-port",
      "${RESOURCE_PORT_SDK}",
      "--config",
      "${RESOURCE_CONFIG_DIR}/OpenRGB"
    ],
    "config": {
      "path": "OpenRGB/OpenRGB.json",
      "content_file": "config/detectors-release_1.1.json"
    },
    "environment": {
      "QT_QPA_PLATFORM": "offscreen",
      "XDG_CONFIG_HOME": "${RESOURCE_CONFIG_DIR}",
      "APPDATA": "${RESOURCE_CONFIG_DIR}"
    }
  },
  "name": "openrgb",
  "privilege": "user",
  "requirements": {
    "class": "developer-tooling",
    "confidence": "low",
    "source": "estimated",
    "weight": 1
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "unsupported",
          "mode": "manual",
          "reason": "OpenRGB is an optional host resource, with maintained native artifact and control-plane lifecycle source. Desktop bundling is not integrated. Native runtime, service-account and device qualification remains target-specific."
        },
        "macos": {
          "support": "unsupported",
          "mode": "manual",
          "reason": "OpenRGB is an optional host resource, with maintained native artifact and control-plane lifecycle source. Desktop bundling is not integrated. Native runtime, service-account and device qualification remains target-specific."
        },
        "windows": {
          "support": "unsupported",
          "mode": "manual",
          "reason": "OpenRGB is an optional host resource, with maintained native artifact and control-plane lifecycle source. Desktop bundling is not integrated. Native runtime, service-account and device qualification remains target-specific."
        }
      }
    }
  }
}
