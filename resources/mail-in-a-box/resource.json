{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "mail-in-a-box",
  "display_name": "Mail-in-a-Box",
  "description": "Managed self-hosted mail stack with native compose-backed lifecycle and shell-retained account, domain, API, and CalDAV workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-mail-in-a-box",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-mail-in-a-box_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-mail-in-a-box"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module",
      "freshness_inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-engine"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "docker-compose.yml",
  "portability_tier": "platform-specific",
  "category": "infrastructure",
  "platforms": {
    "linux": "supported",
    "macos": "unsupported",
    "windows": "unsupported"
  },
  "ports": [
    {
      "name": "smtp",
      "container": 25,
      "host": 25
    },
    {
      "name": "submission",
      "container": 587,
      "host": 587
    },
    {
      "name": "imaps",
      "container": 993,
      "host": 993
    },
    {
      "name": "pop3s",
      "container": 995,
      "host": 995
    },
    {
      "name": "webmail",
      "container": 80,
      "host": 8881
    },
    {
      "name": "caldav",
      "container": 5232,
      "host": 5232
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Mail-in-a-Box dependency settings.",
    "properties": {
      "primary_hostname": {
        "type": "string"
      },
      "admin_email": {
        "type": "string"
      },
      "admin_password": {
        "type": "string"
      },
      "bind_address": {
        "type": "string"
      },
      "ports": {
        "type": "object",
        "additionalProperties": true
      },
      "storage": {
        "type": "object",
        "additionalProperties": true
      },
      "mail_security": {
        "type": "object",
        "additionalProperties": true
      },
      "docker": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 410,
    "startup_timeout_seconds": 90,
    "startup_time_estimate": "30-60s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "health_checks": [
    {
      "type": "tcp",
      "target": "127.0.0.1:25",
      "interval_seconds": 10,
      "timeout_seconds": 5
    },
    {
      "type": "http",
      "target": "http://127.0.0.1:8881/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
