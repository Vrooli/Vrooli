{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "songgen",
  "display_name": "Local Song Models",
  "description": "Pinned MiniMax Music3 NF4 and HeartMuLa song generation with isolated workers and owned model retention.",
  "driver": "managed-service",
  "cli": {
    "enabled": true,
    "command": "resource-songgen",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-songgen_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-songgen"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "server/**",
        "requirements-*.in",
        "requirements-*.lock",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "storage": {
    "entries": {
      "models": {
        "rung": "pinned",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Model bundles are acquired from pinned hashes. Only the owner uses recorded activity, pins and data-lock fencing for whole-bundle retention; generic filesystem-age deletion is unsafe.",
        "budget": {
          "max_bytes": "60GiB",
          "rationale": "Alarm-only bound for the two selected model bundles; retain downloads across requests."
        },
        "subpath": "models"
      },
      "outputs": {
        "rung": "owned",
        "kind": "dir",
        "class": "data",
        "regenerable": true,
        "rationale": "Per-operation scratch and source bundles under the owned data/outputs directory. Music retains exported takes and receipts. The one-day age floor exceeds all bounded worker lifetimes.",
        "budget": {
          "max_age": "1d",
          "rationale": "Age-only expiry exceeds the bounded two-hour worker deadline; no byte-pressure deletion of active operation stages."
        },
        "subpath": "outputs"
      }
    }
  },
  "managed_service": {
    "artifact_role": "managed-service",
    "provenance_class": "upstream-digest",
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/songgen",
      "version": "0.3.0-yue2-score",
      "layout": "dir",
      "entry_path": "runtime/bin/python",
      "bundle_artifact": "resource-songgen_${os}_${arch}",
      "sha256_by_platform": {
        "linux-amd64": "5c4acbe450e1988a42e83b3aedf13a515ffaa438fdc70bd6fb323fc9fe1f4201"
      }
    },
    "acquisition": {
      "kind": "composed",
      "license": "CPython PSF-2.0; pinned dependency licenses retained; Apache-2.0 HeartMuLa code; model terms declared per profile",
      "provenance": {
        "kind": "none"
      },
      "targets": [
        {
          "when": {
            "os": "linux",
            "arch": "amd64",
            "gpu.cuda_compute": ">=8.9"
          },
          "layout": "dir",
          "compose": [
            {
              "role": "runtime",
              "kind": "url",
              "dest": "runtime",
              "bin_path": "python",
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260814/cpython-3.12.14%2B20260814-x86_64-unknown-linux-gnu-install_only.tar.gz",
              "sha256": "3297691ae34f75fed81ac424e040145fccb0bafe8e581cd5cadbddfa1c0766c0",
              "archive": "tar.gz"
            },
            {
              "role": "minimax-wheels",
              "kind": "python-wheels",
              "dest": "wheels/minimax",
              "lockfile": "requirements-minimax.lock",
              "index_url": "https://download.pytorch.org/whl/cu126",
              "extra_index_url": [
                "https://pypi.org/simple"
              ]
            },
            {
              "role": "heartmula-wheels",
              "kind": "python-wheels",
              "dest": "wheels/heartmula",
              "lockfile": "requirements-heartmula.lock",
              "index_url": "https://download.pytorch.org/whl/cu126",
              "extra_index_url": [
                "https://pypi.org/simple"
              ]
            },
            {
              "role": "heartlib",
              "kind": "url",
              "dest": "upstream/heartlib",
              "bin_path": "heartlib-5858ca8f1ffe58d62be7c007ea55f1033c5ca456",
              "url": "https://codeload.github.com/HeartMuLa/heartlib/tar.gz/5858ca8f1ffe58d62be7c007ea55f1033c5ca456",
              "sha256": "1dd055d392f032cbba717e3ff736fd76ee4a76412e1bc67324561db07d96848b",
              "archive": "tar.gz"
            },
            {
              "role": "server.py",
              "kind": "local",
              "source": "server/server.py",
              "dest": "source/server.py"
            },
            {
              "role": "runtime.py",
              "kind": "local",
              "source": "server/runtime.py",
              "dest": "source/runtime.py"
            },
            {
              "role": "worker.py",
              "kind": "local",
              "source": "server/worker.py",
              "dest": "source/worker.py"
            },
            {
              "role": "backends.py",
              "kind": "local",
              "source": "server/backends.py",
              "dest": "source/backends.py"
            },
            {
              "role": "profiles.json",
              "kind": "local",
              "source": "server/profiles.json",
              "dest": "source/profiles.json"
            },
            {
              "role": "audiocpp",
              "kind": "url",
              "dest": "upstream/audiocpp",
              "url": "https://github.com/0xShug0/audio.cpp/releases/download/v0.9.3/audio-v0.9.3-bin-ubuntu-x64-cuda12.8-colab.tar.gz",
              "sha256": "5be3e8d515fb244387de87958668ebb729d9442de6a53df12e4c718ea918419d",
              "archive": "tar.gz"
            },
            {
              "role": "audiocpp-cudart",
              "kind": "url",
              "dest": "upstream/cudart",
              "url": "https://github.com/0xShug0/audio.cpp/releases/download/v0.9.3/audio-v0.9.3-cudart-ubuntu-x64-cuda12.8.tar.gz",
              "sha256": "2fcbaff8078b9eaed47a4a8e879c10dcf1f12fd31f2d52b29214fc9d45cfa198",
              "archive": "tar.gz"
            },
            {
              "role": "yue2.py",
              "kind": "local",
              "source": "server/yue2.py",
              "dest": "source/yue2.py"
            }
          ],
          "artifact_sha256": "5c4acbe450e1988a42e83b3aedf13a515ffaa438fdc70bd6fb323fc9fe1f4201"
        },
        {
          "when": {
            "os": "linux",
            "arch": "arm64"
          },
          "unsupported": "No qualified arm64 CUDA closure."
        },
        {
          "when": {
            "os": "macos"
          },
          "unsupported": "Medium CUDA pilot only."
        },
        {
          "when": {
            "os": "windows"
          },
          "unsupported": "Medium CUDA pilot only."
        }
      ]
    },
