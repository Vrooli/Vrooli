{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "android-sdk",
  "display_name": "Android SDK",
  "description": "Governed Android SDK, JDK 17, Gradle 8.10.2, platform-tools, emulator, system images, and AVD lifecycle for device-control and scenario packaging.",
  "driver": "external-cli",
  "binary": "adb",
  "cli": {
    "enabled": true,
    "command": "resource-android-sdk",
    "adapter": {"kind": "go_module", "module_dir": "cli"},
    "invoke": {"kind": "installed_command", "command": "resource-android-sdk"},
    "distribution": {"kind": "prebuilt_artifact", "artifact_name": "resource-android-sdk_${os}_${arch}"},
    "source_build": {"kind": "go_module"},
    "freshness": {"inputs": ["cli/**", "README.md", "resource.json"]}
  },
  "version_args": ["version"],
  "category": "development",
  "platforms": {"linux":"supported", "macos":"supported", "windows":"supported"},
  "requirements": {"ram_mb":4096,"disk_mb":20000,"cpu_cores":2,"network":"required","bucket":"large","source":"estimated","confidence":"medium","class":"development","weight":3},
  "storage": {"root":"~/.vrooli/resources/android-sdk","byte_budget":20000000000,"retention":"replaceable-sdk-toolchain"},
  "health_checks": [
    {"type":"command","kind":"liveness","command":["adb","version"],"timeout_seconds":15},
    {"type":"command","kind":"liveness","command":["sdkmanager","--version"],"timeout_seconds":30},
    {"type":"command","kind":"liveness","command":["avdmanager","--version"],"timeout_seconds":30},
    {"type":"command","kind":"liveness","command":["emulator","-version"],"timeout_seconds":30},
    {"type":"command","kind":"liveness","command":["javac","-version"],"timeout_seconds":30},
    {"type":"command","kind":"liveness","command":["gradle","--version"],"timeout_seconds":30}
  ],
  "orchestration": {"startup_order":300,"startup_timeout_seconds":30,"startup_time_estimate":"10-60s","dependencies":[],"recovery_attempts":2,"priority":"normal"},
  "install": {"platforms":{"linux":["android-sdk","install-direct"],"macos":["android-sdk","install-direct"],"windows":["android-sdk","install-direct"]}},
  "capabilities":{"supports_logs":true},
  "lifecycle": {
    "avd_create": "resource-android-sdk avd-create",
    "avd_start": "resource-android-sdk avd-start",
    "avd_stop": "resource-android-sdk avd-stop",
    "avd_delete": "resource-android-sdk avd-delete",
    "toolchain_install": "resource-android-sdk toolchain-install"
  },
  "privilege":"user",
  "bundling":"host-required",
  "template_version":"2"
  ,"deployment":{"profiles":{"desktop":{"linux":{"support":"conditional","mode":"native-host-tool","architectures":["amd64","arm64"],"requires":[],"limitations":["Android SDK, JDK 17, Gradle 8.10.2, platform-tools, and emulator images are installed under the governed resource root."],"evidence":["manifest-validation","host-tool-preflight"]},"macos":{"support":"conditional","mode":"native-host-tool","architectures":["amd64","arm64"],"requires":[],"limitations":["Android SDK, JDK 17, Gradle 8.10.2, platform-tools, and emulator images are installed under the governed resource root."],"evidence":["manifest-validation","host-tool-preflight"]},"windows":{"support":"conditional","mode":"native-host-tool","architectures":["amd64","arm64"],"requires":[],"limitations":["Android SDK, JDK 17, Gradle 8.10.2, platform-tools, and emulator images are installed under the governed resource root."],"evidence":["manifest-validation","host-tool-preflight"]}}}}
}
