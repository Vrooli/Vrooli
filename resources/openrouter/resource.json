{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "openrouter",
  "display_name": "OpenRouter API",
  "description": "Hosted OpenRouter API gateway for access to multiple model providers.",
  "template": "cloud-api",
  "driver": "cloud-api",
  "endpoint": "https://openrouter.ai/api/v1/models",
  "credentials": {
    "env": [
      "OPENROUTER_API_KEY"
    ],
    "secret_ref": "secret/openrouter"
  },
  "orchestration": {
    "startup_order": 640,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "OPENROUTER_API_BASE": "https://openrouter.ai/api/v1",
      "OPENROUTER_DEFAULT_MODEL": "openai/gpt-3.5-turbo"
    },
    "from_runtime_env": [
      "OPENROUTER_API_KEY"
    ],
    "derived": {
      "OPENROUTER_URL": {
        "template": "${OPENROUTER_API_BASE}"
      },
      "RESOURCE_OPENROUTER_URL": {
        "template": "${OPENROUTER_API_BASE}"
      }
    }
  },
  "portability_tier": "full",
  "category": "hosted-service",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://openrouter.ai/api/v1/models",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false
  },
  "template_version": "2"
}
