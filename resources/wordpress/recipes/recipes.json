{
  "schemaVersion": 1,
  "recipes": [
    {
      "id": "forms-contact-form-7",
      "version": 1,
      "kind": "forms",
      "title": "Contact intake with Contact Form 7",
      "plugins": [
        "contact-form-7"
      ],
      "site": {
        "title": "K3 Contact Form 7 Ground",
        "language": "en_US",
        "timezone": "UTC",
        "permalinks": "/%postname%/"
      },
      "content": {
        "pages": [
          {
            "slug": "contact",
            "title": "Contact",
            "form": {
              "name": "full-name",
              "email": "email",
              "message": "message",
              "hiddenEventID": {
                "name": "event_id",
                "cssClass": "vrooli-event-id",
                "purpose": "stable idempotency key across retries of this submission",
                "default": ""
              },
              "tag": "[hidden event_id class:vrooli-event-id]"
            }
          }
        ]
      },
      "expectedLevels": [
        "forms.cf7.valid",
        "forms.invalid-email",
        "forms.missing-name",
        "forms.replayed-event",
        "forms.lost-response-replay"
      ]
    },
