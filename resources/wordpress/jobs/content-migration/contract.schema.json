{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.local/contracts/wordpress/content-migration/v1",
  "title": "Vrooli WordPress synthetic content migration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSiteId", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceSiteId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "content", "excerpt", "categories", "tags", "status", "client_type", "outcome_metric", "verified_on", "sourceKey", "contentHash"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "content": { "type": "string", "maxLength": 20000 },
          "excerpt": { "type": "string", "maxLength": 500 },
          "categories": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 &-]{0,62}[A-Za-z0-9])?$" } },
          "tags": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 &-]{0,62}[A-Za-z0-9])?$" } },
          "status": { "enum": ["publish", "draft"] },
          "client_type": { "const": "synthetic" },
          "outcome_metric": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
          "verified_on": { "type": "string", "format": "date" },
          "sourceKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
