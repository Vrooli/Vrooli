{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "vault",
  "display_name": "HashiCorp Vault",
  "description": "Managed Vault service for local secret storage and resource secret validation.",
  "cli": {
    "enabled": true,
    "command": "resource-vault",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-vault_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-vault"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module",
      "freshness_inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-engine"
          ],
          "limitations": [
            "Docker images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "portability_tier": "full",
  "category": "storage",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "hostTools": [
    {
      "name": "yq",
      "required": false,
      "reason": "Parse resource secrets.yaml templates and initialization metadata from retained Vault shell workflows",
      "when": [
        "setup",
        "develop"
      ],
      "notes": "Vault secret helper scripts fall back to basic parsing when yq is unavailable"
    },
    {
      "name": "vault",
      "required": true,
      "reason": "Core CLI for all Vault server operations: inject, status, health, and storage strategy management",
      "when": [
        "setup",
        "develop"
      ]
    }
  ],
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 8200,
      "host": 8200
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8200/v1/sys/health",
      "expected_status": [
        200,
        429,
        472,
        473,
        501,
        503
      ],
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "hashicorp/vault:1.17",
    "container_name": "vault",
    "env": {
      "VAULT_ADDR": "http://0.0.0.0:8200",
      "VAULT_API_ADDR": "http://localhost:8200",
      "VAULT_LOCAL_CONFIG": "{\"storage\":{\"file\":{\"path\":\"/vault/file\"}},\"listener\":[{\"tcp\":{\"address\":\"0.0.0.0:8200\",\"tls_disable\":true}}],\"disable_mlock\":true,\"ui\":true}"
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/vault/file"
      },
      {
        "source": "${RESOURCE_CONFIG_DIR}",
        "target": "/vault/config"
      },
      {
        "source": "${RESOURCE_LOGS_DIR}",
        "target": "/vault/logs"
      }
    ],
    "command": [
      "server"
    ]
  },
  "environment_exports": {
    "static": {
      "VAULT_HOST": "localhost",
      "VAULT_TOKEN": "myroot"
    },
    "from_ports": {
      "VAULT_PORT": "http"
    },
    "derived": {
      "VAULT_URL": {
        "template": "http://${VAULT_HOST}:${VAULT_PORT}"
      },
      "VAULT_ADDR": {
        "template": "${VAULT_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 900,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 5
  },
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2"
}
