{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "questdb",
  "display_name": "QuestDB",
  "description": "Managed QuestDB time-series database with native docker lifecycle and shell-retained SQL/table workflows.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 9000,
      "host": 9009
    },
    {
      "name": "postgresql",
      "container": 8812,
      "host": 8812
    },
    {
      "name": "influxdb-line",
      "container": 9009,
      "host": 9011
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:9009/exec?query=SELECT%201&fmt=json",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "questdb/questdb:8.1.2",
    "container_name": "vrooli-questdb",
    "env": {
      "QDB_PG_USER": "admin",
      "QDB_PG_PASSWORD": "quest"
    },
    "volumes": [
      {
        "source": "${HOME}/.questdb/data",
        "target": "/var/lib/questdb"
      },
      {
        "source": "${HOME}/.questdb/config",
        "target": "/questdb/conf"
      },
      {
        "source": "${HOME}/.questdb/logs",
        "target": "/var/log/questdb"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "QUESTDB_HOST": "localhost",
      "QUESTDB_PG_USER": "admin",
      "QUESTDB_PG_PASSWORD": "quest"
    },
    "from_ports": {
      "QUESTDB_PORT": "http",
      "QUESTDB_HTTP_PORT": "http",
      "QUESTDB_PG_PORT": "postgresql",
      "QUESTDB_ILP_PORT": "influxdb-line"
    },
    "derived": {
      "QUESTDB_URL": {
        "template": "http://${QUESTDB_HOST}:${QUESTDB_HTTP_PORT}"
      },
      "QUESTDB_BASE_URL": {
        "template": "${QUESTDB_URL}"
      },
      "QUESTDB_PG_URL": {
        "template": "postgresql://${QUESTDB_PG_USER}:${QUESTDB_PG_PASSWORD}@${QUESTDB_HOST}:${QUESTDB_PG_PORT}/qdb"
      }
    }
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
