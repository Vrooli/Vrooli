{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "x402-facilitator-local-test",
  "display_name": "X402 Facilitator Local Test",
  "description": "Lifecycle-isolated pinned x402 facilitator for test-key settlement on a loopback Base fork only.",
  "driver": "managed-service",
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/x402-facilitator-local-test",
        "field": "facilitator-private-key",
        "env": "FACILITATOR_PRIVATE_KEY",
        "label": "Generated local-fork facilitator key",
        "provisioning": "generated",
        "description": "Generated local test signer for loopback-only Base fork rehearsals. Never fund this key on a public network.",
        "required": false
      }
    ],
    "consumers": [
      {
        "logical_id": "vrooli/x402-facilitator-local-test",
        "field": "facilitator-private-key",
        "kind": "environment",
        "consumer": "pinned local-test facilitator managed child process",
        "source_ref": "resource.json:credentials.descriptors",
        "required": false
      }
    ]
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "The upstream artifact is a Linux OCI filesystem extracted and supervised natively; no container daemon is required. No payment network is enabled until an operator provisions a facilitator signer and an explicit RPC route."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests",
            "artifact-checksum"
          ]
        },
        "macos": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "No signed upstream macOS x402-facilitator executable or native artifact is published."
          ],
          "evidence": [
            "manifest-validation"
          ],
          "reason": "The upstream release publishes no macOS facilitator executable."
        },
        "windows": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "No signed upstream Windows x402-facilitator executable or native artifact is published."
          ],
          "evidence": [
            "manifest-validation"
          ],
          "reason": "The upstream release publishes no Windows facilitator executable."
        }
      }
    }
  },
  "portability_tier": "build-verified",
  "category": "infrastructure",
  "requirements": {
    "ram_mb": 512,
    "disk_mb": 500,
    "cpu_cores": 1,
    "network": "required",
    "bucket": "medium",
    "source": "estimated",
    "confidence": "medium",
    "class": "infrastructure",
    "weight": 2
  },
  "platforms": {
    "linux": "supported",
    "macos": "unsupported",
    "windows": "unsupported"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 8080,
      "host": 14021,
      "host_ip": "127.0.0.1"
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:14021/health",
      "interval_seconds": 10,
      "timeout_seconds": 5
    },
    {
      "type": "http",
      "kind": "liveness",
      "target": "http://127.0.0.1:14021/health",
      "interval_seconds": 30,
      "timeout_seconds": 5
    }
  ],
  "managed_service": {
    "artifact_role": "managed-service",
    "provenance_class": "upstream-digest",
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/x402-facilitator",
      "version": "1.3.0",
      "layout": "dir",
      "entry_path": "usr/local/bin/x402-facilitator",
      "bundle_artifact": "x402-facilitator_${os}_${arch}",
      "sha256_by_platform": {
        "linux-amd64": "2e0c920a1dd46beb8022fa5977e8baa3bb5e8df3427015f909b75f63089b70ae",
        "linux-arm64": "257f2011bd49ec42c807e14f0d32ad3db6a0b4545956d09b7b959e05e54f7713"
      }
    },
    "acquisition": {
      "kind": "oci-image",
      "license": "Apache-2.0",
      "provenance": {
        "kind": "none"
      },
      "targets": [
        {
          "when": {
            "os": "linux",
            "arch": "amd64"
          },
          "image": "ghcr.io/x402-rs/x402-facilitator@sha256:3a71fd6e3ff5ae00c30bcfbff35e5cf858bb37b9b97de032f46545c18e953d71",
          "layout": "dir",
          "bin_path": "usr/local/bin/x402-facilitator"
        },
        {
          "when": {
            "os": "linux",
            "arch": "arm64"
          },
          "image": "ghcr.io/x402-rs/x402-facilitator@sha256:3a71fd6e3ff5ae00c30bcfbff35e5cf858bb37b9b97de032f46545c18e953d71",
          "layout": "dir",
          "bin_path": "usr/local/bin/x402-facilitator"
        },
        {
          "when": {
            "os": "macos"
          },
          "unsupported": "The upstream x402-rs release publishes no signed macOS facilitator executable."
        },
        {
          "when": {
            "os": "windows"
          },
          "unsupported": "The upstream x402-rs release publishes no signed Windows facilitator executable."
        }
      ]
    },
    "attach_health_path": "/health",
    "arguments": [
      "--config",
      "${RESOURCE_CONFIG_DIR}/config.json"
    ],
    "environment": {
      "HOST": "127.0.0.1",
      "PORT": "${RESOURCE_PORT_HTTP}",
      "RUST_LOG": "info"
    },
    "config": {
      "path": "config.json",
      "content": "{\n  \"port\": ${RESOURCE_PORT_HTTP},\n  \"host\": \"127.0.0.1\",\n  \"chains\": {\n    \"eip155:8453\": {\n      \"eip1559\": true,\n      \"flashblocks\": false,\n      \"signers\": [\n        \"$FACILITATOR_PRIVATE_KEY\"\n      ],\n      \"rpc\": [\n        {\n          \"http\": \"http://127.0.0.1:18545\",\n          \"rate_limit\": 25\n        }\n      ]\n    }\n  },\n  \"schemes\": [\n    {\n      \"id\": \"v2-eip155-exact\",\n      \"chains\": \"eip155:*\"\n    }\n  ]\n}"
    },
    "shutdown": {
      "signal": "terminate"
    }
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for x402-facilitator.",
    "properties": {},
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "X402_FACILITATOR_HOST": "127.0.0.1"
    },
    "from_ports": {
      "X402_FACILITATOR_PORT": "http"
    },
    "from_runtime_env": [],
    "derived": {
      "X402_FACILITATOR_URL": {
        "template": "http://${X402_FACILITATOR_HOST}:${X402_FACILITATOR_PORT}"
      }
    }
  },
  "orchestration": {
    "startup_order": 521,
    "startup_timeout_seconds": 120,
    "startup_time_estimate": "5-15s after the pinned image is present; first pull depends on network throughput",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 120,
    "stop_timeout_seconds": 30,
    "retries": 2
  },
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "vendorable",
  "cli": {
    "enabled": true,
    "command": "resource-x402-facilitator-local-test",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-x402-facilitator-local-test_${os}_${arch}"
    },
    "source_build": {
      "kind": "go_module"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-x402-facilitator-local-test"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  }
}
