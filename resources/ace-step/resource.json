{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "ace-step",
  "display_name": "ACE-Step 1.5",
  "description": "Governed, headless ACE-Step 1.5 text-to-music generation with pinned source, wheels, and model artifacts.",
  "storage": {
    "entries": {
      "models": {
        "rung": "pinned",
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "rationale": "ACE-Step model weights are checksum-verified and can be reacquired from the pinned Hugging Face revisions.",
        "budget": {"max_age": "30d", "rationale": "Model files are regenerable from pinned upstream artifacts."}
      },
      "outputs": {
        "rung": "ephemeral",
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "rationale": "Transient generated audio is owned and retained by music-tools."
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "resource-ace-step",
    "adapter": {"kind": "go_module", "module_dir": "cli"},
    "artifacts": {"manifest": {"location": "sibling"}, "build_metadata": {"location": "sibling"}},
    "distribution": {"kind": "prebuilt_artifact", "artifact_name": "resource-ace-step_${os}_${arch}"},
    "invoke": {"kind": "installed_command", "command": "resource-ace-step"},
    "freshness": {"inputs": ["cli/**", "server/**", "requirements.in", "requirements.lock", "resource.json"]},
    "source_build": {"kind": "go_module"}
  },
  "driver": "managed-service",
  "managed_service": {
    "artifact_role": "managed-service",
    "provenance_class": "upstream-digest",
    "provider_policy": {
      "target_defaults": {"control-plane": "managed-private", "desktop-bundle": "managed-private"},
      "allowed_modes": ["managed-private", "managed-shared", "attach-only", "remote-vrooli", "managed-discovered"],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": ["read-only", "read-write"]
    },
    "artifact": {
      "path": "server/ace-step",
      "version": "1.1.0-ca1e85fe",
      "layout": "dir",
      "entry_path": "runtime/bin/python",
      "sha256_by_platform": {"linux-amd64": "f84cc276ea13a5328bc208340ed7e6b859d57bb62870ee6fda77acf8dca42cc3"},
      "bundle_artifact": "resource-ace-step_${os}_${arch}"
    },
    "acquisition": {
      "kind": "composed",
      "license": "MIT; CPython PSF-2.0; ACE-Step source and model artifacts retain their upstream licenses",
      "provenance": {"kind": "none"},
      "targets": [
        {
          "when": {"os": "linux", "arch": "amd64", "gpu.cuda_compute": ">=8.9"},
          "layout": "dir",
          "artifact_sha256": "f84cc276ea13a5328bc208340ed7e6b859d57bb62870ee6fda77acf8dca42cc3",
          "runtime_env": {"ACE_STEP_DEVICE": "cuda", "ACE_STEP_VARIANT": "acestep-v15-turbo"},
          "compose": [
            {
              "role": "runtime",
              "kind": "url",
              "dest": "runtime",
              "bin_path": "python",
              "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260814/cpython-3.12.14%2B20260814-x86_64-unknown-linux-gnu-install_only.tar.gz",
              "sha256": "3297691ae34f75fed81ac424e040145fccb0bafe8e581cd5cadbddfa1c0766c0",
              "archive": "tar.gz"
            },
            {
              "role": "python-wheels",
              "kind": "python-wheels",
              "dest": "wheels",
              "lockfile": "requirements.lock",
              "index_url": "https://download.pytorch.org/whl/cu128",
              "extra_index_url": ["https://pypi.org/simple"],
              "allow_sdists": true
            },
            {
              "role": "application",
              "kind": "url",
              "dest": "source",
              "bin_path": "ACE-Step-1.5-ca1e85fe9430179831e6bc6be790c332190a3866",
              "url": "https://github.com/ACE-Step/ACE-Step-1.5/archive/ca1e85fe9430179831e6bc6be790c332190a3866.tar.gz",
              "sha256": "b464c11f00af00e1e089a09f58a03962f803c080f116fd0517dbe5ec839706b3",
              "archive": "tar.gz"
            },
            {"role": "server", "kind": "local", "dest": "source/server.py", "source": "server/server.py"}
          ]
        },
        {"when": {"os": "linux", "arch": "arm64"}, "unsupported": "ACE-Step CUDA arm64 is not qualified."},
        {"when": {"os": "macos"}, "unsupported": "ACE-Step native macOS is not qualified."},
        {"when": {"os": "windows"}, "unsupported": "ACE-Step native Windows is not qualified."}
      ]
    },
