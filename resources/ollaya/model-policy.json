{
  "schema_version": "2026-10-30",
  "upstreams": {
    "local": {
      "locality": "local",
      "protocol": "ollaya",
      "description": "The managed Ollaya daemon's native /api/decide endpoint (adds timings and state_truncated to the TypeSafe answer shape)."
    },
    "edenai": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.edenai.run/v3/alpha/decisions",
      "credentials": [
        {
          "env": "EDENAI_API_KEY",
          "logical_id": "vrooli/edenai",
          "field": "api-key",
          "use": "bearer"
        }
      ],
      "description": "Eden AI alpha decisions endpoint serving TypeSafe Jev; the request and response bodies are TypeSafe's System One shape at a different path. Alpha: the shape may change without notice."
    },
    "typesafe": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.typesafe.ai/v1/systemone",
      "credentials": [
        {
          "env": "TYPESAFE_API_KEY",
          "logical_id": "vrooli/typesafe",
          "field": "api-key",
          "use": "bearer"
        }
      ],
      "description": "TypeSafe's own hosted Jev API (waitlisted)."
    },
    "cloudflare": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.cloudflare.com/client/v4/accounts/{account}/ai/run/@cf/cloudflare/clef-flash",
      "envelope": "cloudflare",
      "credentials": [
        {
          "env": "CLOUDFLARE_WORKERS_AI_API_TOKEN",
          "logical_id": "vrooli/cloudflare-workers-ai",
          "field": "api-token",
          "use": "bearer"
        },
        {
          "env": "CLOUDFLARE_WORKERS_AI_ACCOUNT_ID",
          "logical_id": "vrooli/cloudflare-workers-ai",
          "field": "account-id",
          "use": "account"
        }
      ],
      "description": "Cloudflare Workers AI REST run endpoint for @cf/cloudflare/clef-flash; the System One answer is wrapped in Cloudflare's {result, success} envelope."
    }
  },
  "residency": {
    "resident_roles": [],
    "idle_unload_seconds": 300,
    "rationale": "Measured 2026-11-22T07:56Z to 2026-11-23T15:00Z (activity-edge heartbeats, route_events, model-usage.json): 279 decisions in bursts, active in 8 of 1864 minutes (0.4%), with a 22-hour stretch of none. No role has constant traffic, so none stays resident. The longest gap inside a burst was 3.5 minutes (a coba:1b bake-off); bursts were 59 minutes or more apart (hourly laya annotation passes). A 300-second idle unload keeps every burst warm and replays to the same 4 cold loads as the former 30-minute daemon default, while holding 1.3 instead of 4.6 GiB-hours of GPU memory. A model's own placement.keep_alive wins."
  },
  "roles": {
    "decide.local": {
      "upstream": "local",
      "model": "laya",
      "description": "Local CPU/GPU-capable Laya router (laya:en or laya:multilingual by script). Fast and private; Ollaya reports it is weak beyond about 20 options."
    },
    "decide.local.accurate": {
      "upstream": "local",
      "model": "winnow:e4b",
      "description": "Local Winnow-E4B (Gemma 4 fine-tune, Q8_0 GGUF on llama.cpp): Ollaya's recommended open model. Opt-in: an 8 GB pull that needs about 9 GB of free VRAM to run on the GPU."
    },
    "decide.jev.edenai": {
      "upstream": "edenai",
      "model": "typesafe/jev-latest",
      "description": "Hosted TypeSafe Jev through Eden AI."
    },
    "decide.jev.typesafe": {
      "upstream": "typesafe",
      "model": "jev-latest",
      "description": "Hosted TypeSafe Jev through TypeSafe's own API."
    },
    "decide.clef.cloudflare": {
      "upstream": "cloudflare",
      "model": "clef-flash",
      "description": "Hosted Cloudflare Clef-flash (9B decision model) on Workers AI."
    },
    "decide.local.typed": {
      "upstream": "local",
      "model": "laya:typed-decisions",
      "description": "Laya fine-tuned on the typed-decisions workflows (ModernBERT-large, 1024-token context, English). Bake-off candidate."
    },
    "decide.local.nli-modernbert": {
      "upstream": "local",
      "model": "nli:modernbert-large",
      "description": "ModernBERT-large zero-shot NLI: every option is an entailment hypothesis (English). Bake-off candidate; rights unknown."
    },
    "decide.local.nli-deberta": {
      "upstream": "local",
      "model": "nli:deberta-v3-large",
      "description": "DeBERTa-v3-large zero-shot NLI (English). Bake-off candidate; rights unknown."
    },
    "decide.local.pplx": {
      "upstream": "local",
      "model": "pplx-decider:flash",
      "description": "Perplexity pplx-decider-flash v1.2 (Qwen3.5-4B, 255-code readout, multilingual, 8192 tokens). GPU-only bake-off candidate."
    },
    "decide.local.kev": {
      "upstream": "local",
      "model": "kev:4b",
      "description": "Kev 4B (LoRA plus pointer head on Qwen3.5-4B-Base, English, 8192 tokens). GPU-only bake-off candidate."
    },
    "decide.local.credence": {
      "upstream": "local",
      "model": "credence:e4b-calibrated",
      "description": "Credence v1 E4B calibrated (Winnow-E4B/Gemma 4 refinement, Q8_0 GGUF on llama.cpp). GPU-only bake-off candidate; rights unknown."
    },
    "decide.local.coba-400m": {
      "upstream": "local",
      "model": "coba:400m",
      "description": "Coba 400M (Ettin encoder, Laya network distilled from pplx-decider; English, 512 tokens). Bake-off candidate."
    },
    "decide.local.coba-1b": {
      "upstream": "local",
      "model": "coba:1b",
      "description": "Coba 1B (Ettin 1B encoder; English, 512 tokens). Bake-off candidate."
    },
    "decide.local.decima-clean": {
      "upstream": "local",
      "model": "decima:base-clean",
      "description": "Decima-base-clean 1.0 (mmBERT-base late-interaction scorer trained without non-commercial data; multilingual, 512 tokens). Bake-off candidate."
    },
    "decide.local.decima-agent": {
      "upstream": "local",
      "model": "decima:agent",
      "description": "Decima-agent 2.3 (decima-base fine-tuned for coding-agent decisions; 8192 tokens). Bake-off candidate; rights unknown."
    },
    "decide.local.decima-small": {
      "upstream": "local",
      "model": "decima:small",
      "description": "Decima-small 1.1 (multilingual-e5-small late-interaction scorer, 122M). Bake-off candidate; rights unknown."
    },
    "decide.local.largha": {
      "upstream": "local",
      "model": "largha:150m",
      "description": "Largha 150M (Laya network on mmBERT-small; multilingual, 512 tokens). Bake-off candidate."
    }
  },
