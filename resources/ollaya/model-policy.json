{
  "schema_version": "2026-10-30",
  "upstreams": {
    "local": {
      "locality": "local",
      "protocol": "ollaya",
      "description": "The managed Ollaya daemon's native /api/decide endpoint (adds timings and state_truncated to the TypeSafe answer shape)."
    },
    "edenai": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.edenai.run/v3/alpha/decisions",
      "credentials": [
        {
          "env": "EDENAI_API_KEY",
          "logical_id": "vrooli/edenai",
          "field": "api-key",
          "use": "bearer"
        }
      ],
      "description": "Eden AI alpha decisions endpoint serving TypeSafe Jev; the request and response bodies are TypeSafe's System One shape at a different path. Alpha: the shape may change without notice."
    },
    "typesafe": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.typesafe.ai/v1/systemone",
      "credentials": [
        {
          "env": "TYPESAFE_API_KEY",
          "logical_id": "vrooli/typesafe",
          "field": "api-key",
          "use": "bearer"
        }
      ],
      "description": "TypeSafe's own hosted Jev API (waitlisted)."
    },
    "cloudflare": {
      "locality": "remote",
      "protocol": "system-one",
      "endpoint": "https://api.cloudflare.com/client/v4/accounts/{account}/ai/run/@cf/cloudflare/clef-flash",
      "envelope": "cloudflare",
      "credentials": [
        {
          "env": "CLOUDFLARE_WORKERS_AI_API_TOKEN",
          "logical_id": "vrooli/cloudflare-workers-ai",
          "field": "api-token",
          "use": "bearer"
        },
        {
          "env": "CLOUDFLARE_WORKERS_AI_ACCOUNT_ID",
          "logical_id": "vrooli/cloudflare-workers-ai",
          "field": "account-id",
          "use": "account"
        }
      ],
      "description": "Cloudflare Workers AI REST run endpoint for @cf/cloudflare/clef-flash; the System One answer is wrapped in Cloudflare's {result, success} envelope."
    }
  },
  "roles": {
    "decide.local": {
      "upstream": "local",
      "model": "laya",
      "description": "Local CPU/GPU-capable Laya router (laya:en or laya:multilingual by script). Fast and private; Ollaya reports it is weak beyond about 20 options."
    },
    "decide.local.accurate": {
      "upstream": "local",
      "model": "winnow:e4b",
      "description": "Local Winnow-E4B (Gemma 4 fine-tune, Q8_0 GGUF on llama.cpp): Ollaya's recommended open model. Opt-in: an 8 GB pull that needs about 9 GB of free VRAM to run on the GPU."
    },
    "decide.jev.edenai": {
      "upstream": "edenai",
      "model": "typesafe/jev-latest",
      "description": "Hosted TypeSafe Jev through Eden AI."
    },
    "decide.jev.typesafe": {
      "upstream": "typesafe",
      "model": "jev-latest",
      "description": "Hosted TypeSafe Jev through TypeSafe's own API."
    },
    "decide.clef.cloudflare": {
      "upstream": "cloudflare",
      "model": "clef-flash",
      "description": "Hosted Cloudflare Clef-flash (9B decision model) on Workers AI."
    }
  },
