{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "opencode",
  "display_name": "OpenCode",
  "description": "OpenCode CLI resource: a thin Go entrypoint wiring lifecycle, governed permissions, and an upstream update-check; agent-manager invokes the raw opencode binary directly.",
  "cli": {
    "enabled": true,
    "command": "resource-opencode",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": [
          "linux",
          "darwin"
        ],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": [
          "windows"
        ],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-opencode"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "opencode",
  "version_args": [
    "--version"
  ],
  "portability_tier": "partial",
  "category": "development",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "opencode",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "environment_exports": {
    "static": {
      "OPENCODE_PATH": "opencode"
    }
  },
  "orchestration": {
    "startup_order": 390,
    "startup_timeout_seconds": 25,
    "startup_time_estimate": "8-15s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "install": {
    "platforms": {
      "linux": [
        "bash",
        "-lc",
        "source resources/opencode/lib/install.sh && opencode::install::execute"
      ],
      "macos": [
        "bash",
        "-lc",
        "source resources/opencode/lib/install.sh && opencode::install::execute"
      ]
    }
  },
  "durable_data": {
    "base": "$HOME",
    "entries": {
      "config": {
        "path": ".config/opencode",
        "kind": "dir",
        "regenerable": false,
        "rationale": "OpenCode configuration (standalone XDG config home)."
      },
      "storage": {
        "path": ".local/share/opencode/storage",
        "kind": "dir",
        "regenerable": false,
        "rationale": "OpenCode session/message storage (standalone XDG data home)."
      }
    }
  },
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "upstream_cli": {
    "version_command": ["opencode", "--version"],
    "version_pinned": "1.17.9",
    "upstream_release_source": "https://api.github.com/repos/sst/opencode/releases/latest",
    "docs_source": "https://opencode.ai/docs/permissions/",
    "docs_pinned_at": "2026-06-22",
    "schema_version": 1
  },
  "template_version": "2"
}
