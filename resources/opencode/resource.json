{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "opencode",
  "display_name": "OpenCode",
  "description": "OpenCode CLI resource with native binary/install/status handling and shell-retained higher-level workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-opencode",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "opencode",
  "version_args": [
    "--version"
  ],
  "portability_tier": "partial",
  "category": "development",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "opencode",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "environment_exports": {
    "static": {
      "OPENCODE_PATH": "opencode"
    },
    "derived": {
      "OPENCODE_DATA_DIR": {
        "template": "${VROOLI_DATA}/opencode"
      },
      "OPENCODE_XDG_CONFIG_HOME": {
        "template": "${OPENCODE_DATA_DIR}/xdg-config"
      },
      "OPENCODE_XDG_DATA_HOME": {
        "template": "${OPENCODE_DATA_DIR}/xdg-data"
      }
    }
  },
  "orchestration": {
    "startup_order": 390,
    "startup_timeout_seconds": 25,
    "startup_time_estimate": "8-15s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "install": {
    "platforms": {
      "linux": [
        "bash",
        "-lc",
        "source resources/opencode/lib/install.sh && opencode::install::execute"
      ],
      "macos": [
        "bash",
        "-lc",
        "source resources/opencode/lib/install.sh && opencode::install::execute"
      ]
    }
  },
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "2"
}
