{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "qdrant",
  "storage": {
    "entries": {
      "storage": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/qdrant",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/qdrant",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/qdrant"
        },
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "Qdrant collections and WAL data are bind-mounted to /qdrant/storage.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "snapshots": {
        "rung": "pinned",
        "kind": "dir",
        "class": "state",
        "regenerable": false,
        "rationale": "Qdrant snapshots are persisted separately from live collection storage.",
        "subpath": "snapshots",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable state storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "health_log": {
        "rung": "relocatable",
        "kind": "file",
        "class": "state",
        "subpath": "health.log",
        "regenerable": true,
        "budget": {
          "max_age": "30d",
          "rationale": "Qdrant health diagnostics are regenerable and observed in the state root."
        },
        "relocation": {
          "key": "QDRANT_HEALTH_LOG",
          "scope": "process-tree"
        },
        "reclaim": {
          "pruner": "builtin"
        },
        "rationale": "The resource health probe appends diagnostics outside the snapshot directory."
      },
      "managed_service_state": {
        "rung": "owned",
        "kind": "file",
        "class": "state",
        "subpath": "managed-service.json",
        "regenerable": true,
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "The control-plane supervisor owns this small runtime identity record and rewrites it during managed-service lifecycle transitions."
        },
        "rationale": "The managed-service supervisor persists ownership and process identity under the resource state namespace."
      }
    }
  },
  "display_name": "Qdrant Vector Database",
  "description": "Vector database for embeddings and semantic search workloads, supervised from a checksum-verified native binary.",
  "cli": {
    "enabled": true,
    "command": "resource-qdrant",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-qdrant_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-qdrant"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "managed-service",
  "driver": "managed-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "limitations": [
            "Native artifact availability is verified per target architecture."
          ],
          "evidence": [
            "manifest-validation",
            "native-artifact-check"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "limitations": [
            "Native artifact availability is verified per target architecture."
          ],
          "evidence": [
            "manifest-validation",
            "native-artifact-check"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64"
          ],
          "limitations": [
            "Native artifact availability is verified per target architecture."
          ],
          "evidence": [
            "manifest-validation",
            "native-artifact-check"
          ]
        }
      }
    }
  },
  "category": "storage",
  "requirements": {
    "ram_mb": 2048,
    "disk_mb": 8192,
    "cpu_cores": 2,
    "network": "optional",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "storage",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 6333,
      "host": 6333
    },
    {
      "name": "grpc",
      "container": 6334,
      "host": 6334
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:6333/readyz",
      "interval_seconds": 10,
      "timeout_seconds": 5
    }
  ],
  "runtime": {
    "volumes": []
  },
  "managed_service": {
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-shared",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/qdrant",
      "version": "1.15.3",
      "sha256_by_platform": {
        "linux-amd64": "b718cd58cad3ce91fd7ec33f042d873fc3246b004ba90bb9471a7fee557afa1a",
        "linux-arm64": "f8dc09f985d4614c3ebd606e7c533bb9fa4cd61a639f79f94c3fcbaeaf0aa94a",
        "macos-amd64": "67c01e3148a9df8c36b17275d107b08ca28281dd354db1f9b604c6676834c6f8",
        "macos-arm64": "5d56d468e642b9e09394695632e37fac3583d34c7f0ac969154ce4d79490f3ec",
        "windows-amd64": "239b4d868973ff16fc8501be73cac1c6520c9b067abc60deb18d11b53d110925"
      },
      "bundle_artifact": "qdrant_${os}_${arch}"
    },
    "attach_health_path": "/readyz",
    "arguments": [
      "--config-path",
      "${RESOURCE_CONFIG_DIR}/config.yaml"
    ],
    "environment": {
      "QDRANT__STORAGE__STORAGE_PATH": "${RESOURCE_DATA_DIR}",
      "QDRANT__SERVICE__HTTP_PORT": "${RESOURCE_PORT_HTTP}",
      "QDRANT__SERVICE__GRPC_PORT": "${RESOURCE_PORT_GRPC}",
      "QDRANT__SERVICE__HOST": "127.0.0.1"
    },
    "config": {
      "path": "config.yaml",
      "content": "storage:\n  storage_path: ${RESOURCE_DATA_DIR}\nservice:\n  host: 127.0.0.1\n  http_port: ${RESOURCE_PORT_HTTP}\n  grpc_port: ${RESOURCE_PORT_GRPC}\n"
    }
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Qdrant dependency settings.",
    "properties": {
      "collection": {
        "type": "string"
      },
      "dimensions": {
        "type": "integer",
        "minimum": 1
      },
      "distance": {
        "type": "string",
        "enum": [
          "Cosine",
          "Dot",
          "Euclid",
          "Manhattan"
        ]
      },
      "estimated_vectors": {
        "type": "string"
      },
      "fallback": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "QDRANT_HOST": "localhost"
    },
    "from_ports": {
      "QDRANT_PORT": "http",
      "QDRANT_GRPC_PORT": "grpc"
    },
    "from_runtime_env": [
      "QDRANT_API_KEY"
    ],
    "derived": {
      "QDRANT_URL": {
        "template": "http://${QDRANT_HOST}:${QDRANT_PORT}"
      },
      "QDRANT_BASE_URL": {
        "template": "${QDRANT_URL}"
      },
      "QDRANT_GRPC_URL": {
        "template": "grpc://${QDRANT_HOST}:${QDRANT_GRPC_PORT}"
      }
    }
  },
  "orchestration": {
    "startup_order": 850,
    "startup_timeout_seconds": 90,
    "startup_time_estimate": "measured warm start 26-28s with 22 collections; budgeted to 90s with growth headroom",
    "startup_budget": {
      "kind": "qdrant_collection_count",
      "base_seconds": 30,
      "per_unit_seconds": 2,
      "max_seconds": 600
    },
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 90,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
