{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "doc-ocr",
  "display_name": "Doc OCR",
  "description": "Portable local OCR with checksum-verified model data and positioned text runs.",
  "cli": {
    "enabled": true,
    "command": "resource-doc-ocr",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-doc-ocr_${os}_${arch}"
    },
    "source_build": {
      "kind": "go_module"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-doc-ocr"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "native-cli",
  "driver": "native-cli",
  "platforms": {
    "linux": "supported",
    "macos": "build-verified",
    "windows": "build-verified"
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "limitations": [
            "Only declared capabilities are included in the bundle."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum",
            "target-smoke"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "limitations": [
            "Only declared capabilities are included in the bundle."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum",
            "target-smoke"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "limitations": [
            "Only declared capabilities are included in the bundle."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum",
            "target-smoke"
          ]
        }
      }
    }
  },
  "binary": "resource-doc-ocr",
  "version_args": ["version"],
  "portability_tier": "conditional",
  "category": "developer-tooling",
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for doc-ocr.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "1-3s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "requirements": {
    "class": "medium",
    "weight": 1,
    "ram_mb": 512,
    "disk_mb": 32,
    "cpu_cores": 1,
    "network": "none",
    "bucket": "medium",
    "source": "measured",
    "confidence": "high"
  },
  "privilege": "user",
  "bundling": "vendorable",
  "managed_service": {
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": ["managed-private"]
    },
    "artifact": {
      "path": "ocr-model.json",
      "version": "0.1.0",
      "sha256": "98d33ace6e54a09f43eb2671950324f50b49861b53617742269f8e54723482a5"
    },
    "acquisition": {
      "kind": "url",
      "license": "MIT",
      "targets": [
        {
          "url": "https://github.com/vrooli/vrooli/releases/download/doc-ocr-v0.1.0/ocr-model.json",
          "sha256": "98d33ace6e54a09f43eb2671950324f50b49861b53617742269f8e54723482a5",
          "archive": "none",
          "layout": "file"
        }
      ]
    },
    "data_artifacts": [
      {
        "name": "ocr-model",
        "path": "ocr-model.json",
        "acquisition": {
          "kind": "url",
          "license": "MIT",
          "targets": [
            {
              "url": "https://github.com/vrooli/vrooli/releases/download/doc-ocr-v0.1.0/ocr-model.json",
              "sha256": "98d33ace6e54a09f43eb2671950324f50b49861b53617742269f8e54723482a5",
              "archive": "none",
              "layout": "file"
            }
          ]
        }
      }
    ]
  },
  "health_checks": [
    {
      "type": "command",
      "kind": "readiness",
      "command": ["resource-doc-ocr", "health"]
    }
  ],
  "template_version": "2"
}
