        "import os, pathlib, secrets\nconfig = pathlib.Path(os.environ['RESOURCE_CONFIG_DIR']) / 'settings.yml'\nconfig.parent.mkdir(parents=True, exist_ok=True)\nif not config.exists():\n    config.write_text('use_default_settings: true\\ngeneral:\\n    instance_name: Vrooli SearXNG\\n    enable_metrics: true\\nsearch:\\n    formats:\\n        - html\\n        - json\\nserver:\\n    base_url: http://localhost:8280\\n    limiter: false\\n    secret_key: ' + secrets.token_hex(32) + '\\n', encoding='utf-8')\n    config.chmod(0o600)\nmarker = pathlib.Path(os.environ['RESOURCE_DATA_DIR']) / 'bootstrap/initialized'\nmarker.parent.mkdir(parents=True, exist_ok=True)\nmarker.write_text('initialized\\n', encoding='utf-8')"
