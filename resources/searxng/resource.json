{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "searxng",
  "display_name": "SearXNG",
  "description": "Managed SearXNG metasearch service with native docker lifecycle and shell-retained search/configuration workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-searxng",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "search",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "hostTools": [
    {
      "name": "yq",
      "required": false,
      "reason": "Validate and inspect SearXNG YAML configuration from retained shell workflows",
      "when": ["setup", "develop"],
      "notes": "Configuration checks degrade gracefully when yq is unavailable"
    }
  ],
  "dependencies": [
    "redis"
  ],
  "ports": [
    {
      "name": "http",
      "container": 8080,
      "host": 8280
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8280/stats",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "searxng/searxng:2025.1.31-157c9267e",
    "container_name": "searxng",
    "env": {
      "SEARXNG_BASE_URL": "http://localhost:8280",
      "SEARXNG_SECRET": "vrooli-searxng-dev-secret"
    },
    "volumes": [
      {
        "source": "${RESOURCE_CONFIG_DIR}",
        "target": "/etc/searxng"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "SEARXNG_SERVICE_HOST": "localhost"
    },
    "from_ports": {
      "SEARXNG_PORT": "http"
    },
    "from_runtime_env": [
      "SEARXNG_BASE_URL",
      "SEARXNG_SECRET"
    ],
    "derived": {
      "SEARXNG_URL": {
        "template": "http://${SEARXNG_SERVICE_HOST}:${SEARXNG_PORT}"
      },
      "SEARXNG_HOST": {
        "template": "${SEARXNG_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 400,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-15s",
    "dependencies": ["redis"],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
