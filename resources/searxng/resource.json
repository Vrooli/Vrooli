{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "searxng",
  "storage": {
    "entries": {
      "config": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.config/vrooli/resources/searxng",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/searxng",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/searxng"
        },
        "kind": "dir",
        "class": "config",
        "regenerable": false,
        "rationale": "SearXNG settings are bind-mounted to /etc/searxng."
      },
      "cache": {
        "rung": "relocatable",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/searxng",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/searxng",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/searxng"
        },
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "relocation": {
          "key": "RESOURCE_DATA_DIR",
          "scope": "container"
        },
        "rationale": "SearXNG's /var/cache/searxng mount is disposable runtime cache.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    }
  },
  "display_name": "SearXNG",
  "description": "Managed SearXNG metasearch service: one Docker container with Go-native lifecycle, configuration, and diagnostics.",
  "cli": {
    "enabled": true,
    "command": "resource-searxng",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-searxng_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-searxng"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "category": "search",
  "requirements": {
    "ram_mb": 1024,
    "disk_mb": 2048,
    "cpu_cores": 1,
    "network": "required",
    "bucket": "medium",
    "source": "estimated",
    "confidence": "low",
    "class": "search",
    "weight": 2
  },
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "hostTools": [
    {
      "name": "docker",
      "required": true,
      "reason": "SearXNG is intentionally a single-container Docker resource.",
      "when": [
        "setup",
        "develop",
        "runtime"
      ],
      "notes": "Docker must be available before lifecycle commands run."
    }
  ],
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 8080,
      "host": 8280
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:8280/stats",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "ghcr.io/searxng/searxng@sha256:02d441bbb647b7be422d21041420115cddadac4644368f67c7c7f407bbe72e22",
    "container_name": "searxng",
    "env": {
      "SEARXNG_BASE_URL": "http://localhost:8280"
    },
    "volumes": [
      {
        "source": "${RESOURCE_CONFIG_DIR}",
        "target": "/etc/searxng"
      },
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/var/cache/searxng"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "SEARXNG_SERVICE_HOST": "localhost"
    },
    "from_ports": {
      "SEARXNG_PORT": "http"
    },
    "from_runtime_env": [
      "SEARXNG_BASE_URL"
    ],
    "derived": {
      "SEARXNG_URL": {
        "template": "http://${SEARXNG_SERVICE_HOST}:${SEARXNG_PORT}"
      },
      "SEARXNG_HOST": {
        "template": "${SEARXNG_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 400,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-15s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": false
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
