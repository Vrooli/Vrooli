# SearXNG Configuration Template
# Minimal overlay on upstream defaults: with use_default_settings: true, upstream
# engine definitions (and their fixes) flow in on every image bump; we only pin
# what Vrooli needs to differ. Variables are substituted by the Vrooli resource
# management system (lib/config.sh).
use_default_settings: true

# General instance configuration
general:
  debug: false
  instance_name: "${SEARXNG_INSTANCE_NAME}"
  privacypolicy_url: ""
  donation_url: "${SEARXNG_DONATION_URL}"
  contact_url: "${SEARXNG_CONTACT_URL}"
  # Metrics are load-bearing: /stats and /stats/errors back the resource's
  # degraded-engine health detection.
  enable_metrics: ${SEARXNG_ENABLE_METRICS}

# Search behavior configuration
search:
  safe_search: ${SEARXNG_SAFE_SEARCH}
  autocomplete: "${SEARXNG_AUTOCOMPLETE}"
  default_lang: "${SEARXNG_DEFAULT_LANG}"
  # json is load-bearing: web-search and the resource health probe consume
  # /search?format=json
  formats:
    - html
    - json
  # Upstream defaults suspend an engine for 86400s (1 day) on a single 403/CAPTCHA
  # and 3600s on a rate-limit. Far too brutal for a single-user local instance —
  # let engines self-heal quickly instead.
  suspended_times:
    SearxEngineAccessDenied: 1800
    SearxEngineCaptcha: 1800
    SearxEngineTooManyRequests: 900

# Server configuration
# NOTE: since the uWSGI→Granian switch (searxng 2025.7+) the listen host/port are
# controlled by GRANIAN_HOST/GRANIAN_PORT baked into the image (port 8080), not by
# settings.yml.
server:
  base_url: "${SEARXNG_BASE_URL}"
  secret_key: "${SEARXNG_SECRET_KEY}"
  limiter: ${SEARXNG_LIMITER_ENABLED}
  image_proxy: true
  public_instance: ${SEARXNG_ENABLE_PUBLIC_ACCESS}
  default_http_headers:
    X-Content-Type-Options: nosniff
    X-Download-Options: noopen
    X-Robots-Tag: noindex, nofollow
    Referrer-Policy: no-referrer

# Outgoing request configuration
outgoing:
  request_timeout: ${SEARXNG_REQUEST_TIMEOUT}
  max_request_timeout: ${SEARXNG_MAX_REQUEST_TIMEOUT}
  pool_connections: ${SEARXNG_POOL_CONNECTIONS}
  pool_maxsize: ${SEARXNG_POOL_MAXSIZE}
  enable_http2: true
  retries: 1
  max_redirects: 30

# Engine configuration (merged by name into upstream defaults).
# Curated 2026-06: broad general-web coverage across independent backends.
engines:
  - name: google
    disabled: false
    weight: 1.0
  - name: duckduckgo
    disabled: false
    weight: 1.0
  - name: brave
    disabled: false
    weight: 1.0
  - name: startpage
    disabled: false
    weight: 1.0
  - name: mojeek
    disabled: false
    weight: 1.0
  - name: wikipedia
    disabled: false
    weight: 1.0
  - name: wikidata
    disabled: false
    weight: 1.0
  # qwant: permanently disabled — Datadome bot protection blocks server-side
  # scraping; upstream-confirmed unfixable (searxng issue #3929).
  - name: qwant
    disabled: true
  # bing: disabled for relevance junk (keyword-matching navigational noise,
  # searxng issue #4964); upstream disabled it by default too.
  - name: bing
    disabled: true

# UI configuration
ui:
  static_use_hash: false
  default_theme: simple
  center_alignment: false
  results_on_new_tab: false
  advanced_search: false
  query_in_title: false

# Logging configuration
logging:
  level: "${SEARXNG_LOG_LEVEL}"
