# SearXNG application requirements (direct dependencies only).
#
# The resolved, hash-pinned closure lives in requirements.lock and is what the
# control plane installs with `--require-hashes --no-deps`. Regenerate it after
# editing this file:
#
#   uv pip compile resources/searxng/requirements.in \
#     --python-version 3.12 --python-platform x86_64-unknown-linux-gnu \
#     --generate-hashes --index-strategy unsafe-best-match \
#     --output-file resources/searxng/requirements.lock
#
# Changing either file changes the composed tree, so artifact_sha256 must be
# re-derived from a fresh `vrooli resource install searxng --reacquire`.
