{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "neo4j",
  "display_name": "Neo4j",
  "description": "Managed Neo4j graph database service with native docker lifecycle and shell-retained graph operations.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 7474,
      "host": 7474
    },
    {
      "name": "bolt",
      "container": 7687,
      "host": 7687
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:7474/",
      "expected_status": [
        200,
        401
      ],
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "neo4j:5.15.0",
    "container_name": "vrooli-neo4j",
    "env": {
      "NEO4J_AUTH": "none",
      "NEO4J_server_memory_heap_initial__size": "512M",
      "NEO4J_server_memory_heap_max__size": "512M",
      "NEO4J_PLUGINS": "[\"apoc\"]",
      "NEO4J_apoc_export_file_enabled": "true",
      "NEO4J_apoc_import_file_enabled": "true"
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}/data",
        "target": "/data"
      },
      {
        "source": "${RESOURCE_LOGS_DIR}",
        "target": "/logs"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/import",
        "target": "/var/lib/neo4j/import"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/plugins",
        "target": "/plugins"
      }
    ]
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Neo4j dependency settings.",
    "properties": {
      "container": {
        "type": "object",
        "additionalProperties": true
      },
      "ports": {
        "type": "object",
        "additionalProperties": true
      },
      "authentication": {
        "type": "object",
        "additionalProperties": true
      },
      "memory": {
        "type": "object",
        "additionalProperties": true
      },
      "storage": {
        "type": "object",
        "additionalProperties": true
      },
      "plugins": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "startup": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 970,
    "startup_timeout_seconds": 35,
    "startup_time_estimate": "10-20s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
