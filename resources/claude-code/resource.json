{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "claude-code",
  "display_name": "Claude Code CLI",
  "description": "Anthropic's Claude Code CLI for interactive and scripted development workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-claude-code",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-claude-code"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "claude",
  "version_args": [
    "--version"
  ],
  "portability_tier": "partial",
  "category": "developer-tooling",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "claude",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Claude Code dependency settings.",
    "properties": {
      "cli_integration": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string"
      },
      "health_check": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "config": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "CLAUDE_CODE_PATH": "claude",
      "CLAUDE_CODE_URL": "http://localhost:8100"
    }
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": ["litellm"],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "install": {
    "platforms": {
      "linux": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code"
      ],
      "macos": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code"
      ]
    }
  },
  "durable_data": {
    "base": "$HOME/.claude",
    "entries": {
      "history": {
        "path": "history.jsonl",
        "kind": "file",
        "regenerable": false,
        "rationale": "Prompt history across all Claude Code sessions on this host."
      },
      "projects": {
        "path": "projects",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Full per-project conversation transcripts — the primary record for later analysis."
      },
      "file-history": {
        "path": "file-history",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Per-file edit history Claude Code keeps for restore/undo."
      },
      "plans": {
        "path": "plans",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Authored Claude Code plans."
      },
      "credentials": {
        "path": ".credentials.json",
        "kind": "file",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Claude Code OAuth credentials — includes live tokens; back up only deliberately."
      }
    }
  },
  "capabilities": {
    "supports_logs": false
  },
  "template_version": "2"
}
