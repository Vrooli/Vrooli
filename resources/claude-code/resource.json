{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "claude-code",
  "display_name": "Claude Code CLI",
  "description": "Anthropic's Claude Code CLI for interactive and scripted development workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-claude-code",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-claude-code_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-claude-code"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "model-policy.json",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module",
      "freshness_inputs": [
        "cli/**",
        "cli/internal/**",
        "model-policy.json",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "claude"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "claude"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "claude"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        }
      }
    }
  },
  "binary": "claude",
  "version_args": [
    "--version"
  ],
  "portability_tier": "partial",
  "category": "developer-tooling",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "claude",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "environment_exports": {
    "static": {
      "CLAUDE_CODE_PATH": "claude",
      "CLAUDE_CODE_URL": "http://localhost:8100"
    }
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "install": {
    "platforms": {
      "linux": [
        "bash",
        "-lc",
        "source resources/claude-code/lib/install.sh && claude_code::install::execute"
      ],
      "macos": [
        "bash",
        "-lc",
        "source resources/claude-code/lib/install.sh && claude_code::install::execute"
      ]
    }
  },
  "durable_data": {
    "base": "$HOME/.claude",
    "entries": {
      "history": {
        "path": "history.jsonl",
        "kind": "file",
        "regenerable": false,
        "rationale": "Prompt history across all Claude Code sessions on this host."
      },
      "projects": {
        "path": "projects",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Full per-project conversation transcripts — the primary record for later analysis."
      },
      "file-history": {
        "path": "file-history",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Per-file edit history Claude Code keeps for restore/undo."
      },
      "plans": {
        "path": "plans",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Authored Claude Code plans."
      },
      "credentials": {
        "path": ".credentials.json",
        "kind": "file",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Claude Code OAuth credentials — includes live tokens; back up only deliberately."
      }
    }
  },
  "capabilities": {
    "supports_logs": false
  },
  "upstream_cli": {
    "version_command": [
      "claude",
      "--version"
    ],
    "version_pinned": "2.1.185",
    "upstream_release_source": "https://registry.npmjs.org/@anthropic-ai/claude-code/latest",
    "docs_source": "https://code.claude.com/docs/en/permissions",
    "docs_pinned_at": "2026-05-28",
    "schema_version": 1
  },
  "template_version": "2"
}
