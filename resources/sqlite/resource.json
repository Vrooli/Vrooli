{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "sqlite",
  "display_name": "SQLite",
  "description": "Portable Go-based SQLite CLI resource with native binary/install/status handling and binary-retained database operations.",
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "resource-sqlite",
  "version_args": [
    "info"
  ],
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "install": {
    "platforms": {
      "linux": [
        "bash",
        "resources/sqlite/install.sh"
      ],
      "macos": [
        "bash",
        "resources/sqlite/install.sh"
      ],
      "windows": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "resources/sqlite/install.ps1"
      ]
    }
  },
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "1"
}
