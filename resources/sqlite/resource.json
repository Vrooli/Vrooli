{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "sqlite",
  "display_name": "SQLite",
  "description": "Portable Go-based SQLite CLI resource with native binary/install/status handling and binary-retained database operations.",
  "cli": {
    "enabled": true,
    "command": "resource-sqlite",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "resource-sqlite",
  "version_args": [
    "info"
  ],
  "portability_tier": "full",
  "category": "database",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "install": {
    "platforms": {
      "linux": [
        "bash",
        "resources/sqlite/install.sh"
      ],
      "macos": [
        "bash",
        "resources/sqlite/install.sh"
      ],
      "windows": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "resources/sqlite/install.ps1"
      ]
    }
  },
  "orchestration": {
    "startup_order": 100,
    "startup_timeout_seconds": 5,
    "startup_time_estimate": "1-2s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "environment_exports": {
    "static": {
      "SQLITE_CLI_PATH": "resource-sqlite",
      "SQLITE_JOURNAL_MODE": "WAL",
      "SQLITE_SYNCHRONOUS": "NORMAL",
      "SQLITE_TEMP_STORE": "MEMORY"
    },
    "derived": {
      "SQLITE_DATABASE_PATH": {
        "template": "${RESOURCE_DATA_DIR}/databases"
      },
      "SQLITE_BACKUP_PATH": {
        "template": "${RESOURCE_DATA_DIR}/backups"
      },
      "SQLITE_REPLICATION_PATH": {
        "template": "${RESOURCE_DATA_DIR}/replicas"
      },
      "SQLITE_MIGRATION_PATH": {
        "template": "${RESOURCE_DATA_DIR}/migrations"
      },
      "SQLITE_REPLICATION_STATE_PATH": {
        "template": "${RESOURCE_STATE_DIR}/replication"
      }
    }
  },
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "2"
}
