{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "sagemath",
  "display_name": "SageMath",
  "description": "Managed SageMath computation service with native Docker lifecycle and shell-retained notebook, math, GPU, and export workflows.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "partial",
  "category": "science",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "jupyter",
      "container": 8888,
      "host": 8888
    },
    {
      "name": "api",
      "container": 8889,
      "host": 8889
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8888/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "sagemath/sagemath:latest",
    "container_name": "sagemath-main",
    "env": {
      "SAGE_JUPYTER_SERVER": "yes"
    },
    "volumes": [
      {
        "source": "${ROOT}/data/resources/sagemath/scripts",
        "target": "/home/sage/scripts"
      },
      {
        "source": "${ROOT}/data/resources/sagemath/notebooks",
        "target": "/home/sage/notebooks"
      },
      {
        "source": "${ROOT}/data/resources/sagemath/outputs",
        "target": "/home/sage/outputs"
      }
    ],
    "command": [
      "sage",
      "-n",
      "jupyter",
      "--no-browser",
      "--ip=0.0.0.0",
      "--port=8888"
    ]
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
