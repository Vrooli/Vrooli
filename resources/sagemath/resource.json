{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "sagemath",
  "display_name": "SageMath",
  "description": "Managed SageMath computation service with native Docker lifecycle and shell-retained notebook, math, GPU, and export workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-sagemath",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "partial",
  "category": "science",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "jupyter",
      "container": 8888,
      "host": 8888
    },
    {
      "name": "api",
      "container": 8889,
      "host": 8889
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific SageMath dependency settings.",
    "properties": {
      "data_dir": { "type": "string" },
      "scripts_dir": { "type": "string" },
      "notebooks_dir": { "type": "string" },
      "outputs_dir": { "type": "string" },
      "logs_dir": { "type": "string" },
      "jupyter_port": { "type": "integer", "minimum": 1 },
      "api_port": { "type": "integer", "minimum": 1 },
      "container_name": { "type": "string" },
      "image": { "type": "string" },
      "memory_limit": { "type": "string" },
      "cpu_limit": { "type": "string" },
      "enable_gpu": { "type": "boolean" },
      "enable_parallel": { "type": "boolean" },
      "jupyter_token": { "type": "string" },
      "max_calculation_time": { "type": "integer", "minimum": 1 },
      "performance_mode": {
        "type": "string",
        "enum": ["standard", "optimized", "memory_efficient"]
      }
    },
    "additionalProperties": false
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8888/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "sagemath/sagemath:latest",
    "container_name": "sagemath-main",
    "env": {
      "SAGE_JUPYTER_SERVER": "yes"
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}/scripts",
        "target": "/home/sage/scripts"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/notebooks",
        "target": "/home/sage/notebooks"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/outputs",
        "target": "/home/sage/outputs"
      }
    ],
    "command": [
      "sage",
      "-n",
      "jupyter",
      "--no-browser",
      "--ip=0.0.0.0",
      "--port=8888"
    ]
  },
  "orchestration": {
    "startup_order": 290,
    "startup_timeout_seconds": 50,
    "startup_time_estimate": "15-30s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
