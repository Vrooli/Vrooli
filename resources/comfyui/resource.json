{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "comfyui",
  "display_name": "ComfyUI",
  "description": "Managed ComfyUI workflow service with native lifecycle handling and shell-retained workflow, model, and GPU compatibility commands.",
  "cli": {
    "enabled": false
  },
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "partial",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8188,
      "host": 8188
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8188/system_stats",
      "interval_seconds": 10,
      "timeout_seconds": 30
    }
  ],
  "runtime": {
    "image": "zhangp365/comfyui:latest",
    "container_name": "comfyui",
    "env": {
      "WORKSPACE": "/workspace/ComfyUI",
      "CF_QUICK_TUNNELS": "false",
      "WEB_ENABLE_AUTH": "false",
      "SERVERLESS": "false",
      "PUBLIC_KEY": "",
      "CUDA_VISIBLE_DEVICES": ""
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}/models",
        "target": "/workspace/ComfyUI/models"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/custom_nodes",
        "target": "/workspace/ComfyUI/custom_nodes"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/outputs",
        "target": "/workspace/ComfyUI/outputs"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/input",
        "target": "/workspace/ComfyUI/input"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/workflows",
        "target": "/workspace/ComfyUI/workflows"
      },
      {
        "source": "${RESOURCE_DATA_DIR}/user",
        "target": "/workspace/ComfyUI/user"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "COMFYUI_HOST": "localhost"
    },
    "from_ports": {
      "COMFYUI_PORT": "http"
    },
    "derived": {
      "COMFYUI_URL": {
        "template": "http://${COMFYUI_HOST}:${COMFYUI_PORT}"
      },
      "COMFYUI_BASE_URL": {
        "template": "${COMFYUI_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 350,
    "startup_timeout_seconds": 60,
    "startup_time_estimate": "20-40s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "lifecycle": {
    "start_timeout_seconds": 120,
    "stop_timeout_seconds": 30,
    "retries": 5
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
