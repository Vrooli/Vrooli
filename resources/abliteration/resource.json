{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "abliteration",
  "display_name": "Abliteration API",
  "description": "Hosted abliteration.ai models exposed through OpenAI-compatible chat, responses, and model endpoints.",
  "storage": {
    "entries": {},
    "rationale": "No additional host storage is owned by this resource; the explicit empty declaration prevents an implicit-storage assumption."
  },
  "cli": {
    "enabled": true,
    "command": "resource-abliteration",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-abliteration_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-abliteration"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "docs/**",
        "README.md",
        "resource.json",
        "model-policy.json",
        "../../packages/ai-provider-go/**",
        "../../internal/aiproviderapp/**"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "driver": "cloud-api",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an abliteration.ai account and network access.",
            "This provider is not part of the default fleet routing set."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an abliteration.ai account and network access.",
            "This provider is not part of the default fleet routing set."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires an abliteration.ai account and network access.",
            "This provider is not part of the default fleet routing set."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        }
      }
    }
  },
  "endpoint": "https://api.abliteration.ai/v1/models",
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/abliteration",
        "field": "api-key",
        "env": "ABLIT_KEY",
        "label": "Abliteration API Key",
        "provisioning": "operator",
        "description": "Abliteration.ai API key for explicitly authorized research and red-team scenarios.",
        "placeholder": "ak_a1b2c3d4e5f6...",
        "required": true,
        "obtain_url": "https://abliteration.ai/console"
      }
    ],
    "consumers": [
      {
        "logical_id": "vrooli/abliteration",
        "field": "api-key",
        "kind": "environment",
        "consumer": "Abliteration CLI credential resolver",
        "source_ref": "cli/main.go:1",
        "required": true
      }
    ]
  },
  "orchestration": {
    "startup_order": 646,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "environment_exports": {
    "static": {
      "ABLIT_API_BASE": "https://api.abliteration.ai/v1",
      "ABLIT_DEFAULT_ROLE": "chat.default"
    },
    "derived": {
      "ABLITERATION_URL": {
        "template": "${ABLIT_API_BASE}"
      },
      "RESOURCE_ABLITERATION_URL": {
        "template": "${ABLIT_API_BASE}"
      }
    }
  },
  "category": "hosted-service",
  "requirements": {
    "ram_mb": 128,
    "disk_mb": 128,
    "cpu_cores": 0.25,
    "network": "required",
    "bucket": "small",
    "source": "estimated",
    "confidence": "low",
    "class": "hosted-service",
    "weight": 1
  },
  "platforms": {
    "linux": "supported",
    "macos": "build-verified",
    "windows": "build-verified"
  },
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "https://api.abliteration.ai/v1/models",
      "headers": {
        "Authorization": "Bearer ${ABLIT_KEY}"
      },
      "expected_status": [
        200
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": false,
    "supports_ensure": true
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific abliteration.ai dependency settings. Roles only; concrete model slugs are resolved by resource-abliteration.",
    "properties": {
      "model_roles": {
        "type": "array",
        "description": "Logical abliteration.ai roles resolved through resources/abliteration/model-policy.json.",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "configuration": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
