{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "grok",
  "storage": {
    "entries": {
      "home": {
        "rung": "owned",
        "path": "$USER_HOME/.grok",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "sensitive": true,
        "rationale": "The managed Grok CLI sets GROK_DATA_DIR to ~/.grok for sessions, memory, configuration, and authentication.",
        "budget": {
          "max_bytes": "20GiB",
          "rationale": "Durable data storage ceiling is derived from the expected working set and raises an alarm before host capacity is threatened."
        }
      },
      "skills": {
        "rung": "relocatable",
        "path": "$USER_HOME/.grok/skills",
        "kind": "dir",
        "class": "config",
        "regenerable": true,
        "projection": {
          "environment": "GROK_DATA_DIR",
          "project_scope": false
        },
        "rationale": "Native skill discovery directory declared for data-driven Vrooli projection."
      }
    }
  },
  "display_name": "Grok Build CLI",
  "description": "xAI Grok Build coding CLI resource: a thin Go entrypoint wiring lifecycle and an upstream update-check; agent-manager (when later wired) invokes the raw grok binary directly.",
  "execution": {
    "runner_type": "grok",
    "codec": "grok",
    "detection_signal": "GROK_AGENT=1",
    "hook_surface": "native-permissions"
  },
  "cli": {
    "enabled": true,
    "command": "resource-grok",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-grok_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-grok"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "model-policy.json",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "driver": "external-cli",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "grok"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "grok"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "grok"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        }
      }
    }
  },
  "binary": "grok",
  "version_args": [
    "--version"
  ],
  "category": "developer-tooling",
  "requirements": {
    "ram_mb": 1024,
    "disk_mb": 2048,
    "cpu_cores": 1,
    "network": "required",
    "bucket": "medium",
    "source": "estimated",
    "confidence": "low",
    "class": "developer-tooling",
    "weight": 2
  },
  "platforms": {
    "linux": "supported",
    "macos": "build-verified",
    "windows": "build-verified"
  },
  "health_checks": [
    {
      "type": "command",
      "kind": "liveness",
      "command": [
        "grok",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "environment_exports": {
    "static": {
      "GROK_PATH": "grok"
    }
  },
  "orchestration": {
    "startup_order": 540,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "install": {
    "platforms": {
      "linux": [
        "resource-grok",
        "install-direct"
      ],
      "macos": [
        "resource-grok",
        "install-direct"
      ]
    }
  },
  "durable_data": {
    "base": "$HOME/.grok",
    "entries": {
      "sessions": {
        "path": "sessions",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Grok persisted sessions (conversation transcripts, organized by working directory) — the primary conversation record for later analysis."
      },
      "memory": {
        "path": "memory",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Grok cross-session memory files and index carried across sessions."
      },
      "config": {
        "path": "config.toml",
        "kind": "file",
        "regenerable": false,
        "rationale": "Grok main configuration (channel, model preferences, UI hints/opt-outs, marketplace sources)."
      },
      "auth": {
        "path": "auth.json",
        "kind": "file",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Grok authentication credentials (OIDC / legacy sign-in tokens, auto-managed) — live secrets; back up only deliberately."
      }
    }
  },
  "capabilities": {
    "supports_logs": false
  },
  "upstream_cli": {
    "version_command": [
      "grok",
      "--version"
    ],
    "version_pinned": "0.2.72",
    "docs_source": "https://x.ai/cli",
    "docs_pinned_at": "2026-06-28",
    "schema_version": 1
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required",
  "vrooli_memory_targets": [
    {
      "runtime": "grok",
      "path": "$USER_HOME/.grok/memory/MEMORY.md",
      "section": "",
      "byte_cap": 32768,
      "line_cap": 200
    }
  ]
}
