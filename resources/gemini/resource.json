{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "gemini",
  "display_name": "Google Gemini API",
  "description": "Hosted Gemini API integration for multimodal and text generation workloads.",
  "cli": {
    "enabled": true,
    "command": "resource-gemini",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-gemini"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "endpoint": "https://generativelanguage.googleapis.com/v1beta/models",
  "credentials": {
    "env": [
      "GEMINI_API_KEY"
    ],
    "secret_ref": "secret/vrooli/gemini"
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Gemini dependency settings.",
    "properties": {
      "api": {
        "type": "object",
        "additionalProperties": true
      },
      "models": {
        "type": "object",
        "additionalProperties": true
      },
      "rate_limits": {
        "type": "object",
        "additionalProperties": true
      },
      "health_check": {
        "type": "object",
        "additionalProperties": true
      },
      "cache": {
        "type": "object",
        "additionalProperties": true
      },
      "logging": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 100,
    "startup_timeout_seconds": 10,
    "startup_time_estimate": "1-2s",
    "dependencies": [],
    "optional_dependencies": ["vault", "redis"],
    "recovery_attempts": 3,
    "recovery_delay_seconds": 5,
    "priority": "medium"
  },
  "portability_tier": "full",
  "category": "hosted-service",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://generativelanguage.googleapis.com/v1beta/models",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false
  },
  "template_version": "2"
}
