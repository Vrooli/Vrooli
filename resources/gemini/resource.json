{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "gemini",
  "storage": {"entries": {}, "rationale": "No additional host storage is owned by this resource on the supported lifecycle path; the explicit empty declaration prevents an implicit-storage assumption."},
  "display_name": "Google Gemini API",
  "description": "Hosted Gemini API integration for multimodal and text generation workloads.",
  "cli": {
    "enabled": true,
    "command": "resource-gemini",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-gemini_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-gemini"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires a Google AI account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires a Google AI account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "bundled-client",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "Requires a Google AI account and network access."
          ],
          "evidence": [
            "manifest-validation",
            "resource-cli-unit-tests"
          ]
        }
      }
    }
  },
  "endpoint": "https://generativelanguage.googleapis.com/v1beta/models",
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/gemini",
        "field": "api-key",
        "env": "GEMINI_API_KEY",
        "label": "Gemini API Key",
        "description": "Google Gemini multimodal LLM. Required for scenarios that call Gemini directly for text generation, vision, or multimodal reasoning.",
        "required": true,
        "obtain_url": "https://aistudio.google.com/app/apikey"
      }
    ]
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Gemini dependency settings.",
    "properties": {
      "api": {
        "type": "object",
        "additionalProperties": true
      },
      "models": {
        "type": "object",
        "additionalProperties": true
      },
      "rate_limits": {
        "type": "object",
        "additionalProperties": true
      },
      "health_check": {
        "type": "object",
        "additionalProperties": true
      },
      "cache": {
        "type": "object",
        "additionalProperties": true
      },
      "logging": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 100,
    "startup_timeout_seconds": 10,
    "startup_time_estimate": "1-2s",
    "dependencies": [],
    "optional_dependencies": [],
    "recovery_attempts": 3,
    "recovery_delay_seconds": 5,
    "priority": "medium"
  },
  "portability_tier": "full",
  "category": "hosted-service",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "https://generativelanguage.googleapis.com/v1beta/models",
      "expected_status": [
        200,
        400,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
