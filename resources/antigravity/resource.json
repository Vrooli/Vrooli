{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "antigravity",
  "storage": {
    "entries": {
      "home": {
        "rung": "owned",
        "path": "$USER_HOME/.gemini",
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "sensitive": true,
        "rationale": "The Antigravity CLI and desktop app share settings, authentication, conversations, and memory under the documented Gemini home.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "cache": {
        "rung": "relocatable",
        "path": "$USER_CACHE_DIR/antigravity",
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "relocation": {
          "key": "ANTIGRAVITY_STATE_DIR",
          "scope": "process-tree"
        },
        "rationale": "Antigravity's local cache/state is rebuildable and may be redirected independently of durable account data.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage budget measured and governed on 2026-08-05; age is the reclaim ceiling."
        }
      }
    }
  },
  "display_name": "Antigravity CLI",
  "description": "Google Antigravity coding CLI resource (binary `agy`): a thin Go entrypoint wiring lifecycle, an upstream update-check, and shared command-permission governance. Optional external-cli; sudo-free install; on-disk state backed up.",
  "execution": {
    "runner_type": "antigravity",
    "codec": "antigravity",
    "detection_signal": "ANTIGRAVITY_AGENT=1",
    "hook_surface": "native-permissions"
  },
  "cli": {
    "enabled": true,
    "command": "resource-antigravity",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-antigravity_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-antigravity"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "agy"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "agy"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "native-host-tool",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "agy"
          ],
          "limitations": [
            "The upstream executable, licensing, authentication, and version policy are host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "host-tool-preflight"
          ]
        }
      }
    }
  },
  "binary": "agy",
  "version_args": [
    "--version"
  ],
  "category": "developer-tooling",
  "requirements": {
    "ram_mb": 1024,
    "disk_mb": 2048,
    "cpu_cores": 1,
    "network": "required",
    "bucket": "medium",
    "source": "estimated",
    "confidence": "low",
    "class": "developer-tooling",
    "weight": 2
  },
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "health_checks": [
    {
      "type": "command",
      "kind": "liveness",
      "command": [
        "agy",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "environment_exports": {
    "static": {
      "ANTIGRAVITY_PATH": "agy"
    }
  },
  "orchestration": {
    "startup_order": 541,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "install": {
    "platforms": {
      "linux": [
        "resource-antigravity",
        "install-direct"
      ],
      "macos": [
        "resource-antigravity",
        "install-direct"
      ]
    }
  },
  "durable_data": {
    "base": "$HOME/.gemini",
    "entries": {
      "settings": {
        "path": "settings.json",
        "kind": "file",
        "regenerable": false,
        "rationale": "Shared Gemini/Antigravity global settings (selected auth type, preview toggles) read by the agy CLI and the Antigravity 2.0 desktop app."
      },
      "oauth": {
        "path": "oauth_creds.json",
        "kind": "file",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Google OAuth credentials (access/refresh tokens) — live secrets; back up only deliberately. Restoring stale tokens can break auth; re-run `agy` sign-in instead."
      },
      "accounts": {
        "path": "google_accounts.json",
        "kind": "file",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Active/old Google account identifiers bound to the OAuth session — back up deliberately alongside the credentials."
      },
      "cli_settings": {
        "path": "antigravity-cli/settings.json",
        "kind": "file",
        "regenerable": false,
        "rationale": "Antigravity CLI configuration: model, toolPermission mode, trustedWorkspaces, and the native `permissions` allow/deny/ask grants. Hand-tuned operator state."
      },
      "cli_conversations": {
        "path": "antigravity-cli/conversations",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Antigravity CLI conversation transcripts (one SQLite .db per thread) — the primary CLI conversation record for later analysis."
      },
      "cli_memory": {
        "path": "antigravity-cli/brain",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Antigravity CLI cross-session memory and per-conversation transcripts/state (brain/<id>/) carried across sessions."
      },
      "cli_knowledge": {
        "path": "antigravity-cli/knowledge",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Antigravity CLI knowledge base (user knowledge items the agent retrieves across sessions)."
      },
      "desktop_state": {
        "path": "antigravity",
        "kind": "dir",
        "regenerable": false,
        "rationale": "Antigravity 2.0 desktop app agent state under the shared home: conversation transcripts (conversations/*.pb) and memory (brain/). Excludes the sibling antigravity-browser-profile/ (regenerable Chromium cache)."
      }
    }
  },
  "capabilities": {
    "supports_logs": false
  },
  "upstream_cli": {
    "version_command": [
      "agy",
      "--version"
    ],
    "version_pinned": "1.0.13",
    "docs_source": "https://antigravity.google/docs",
    "docs_pinned_at": "2026-06-29",
    "schema_version": 1
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
