{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "adguard-home",
  "storage": {
    "entries": {
      "work": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/adguard-home",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/adguard-home",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/adguard-home"
        },
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "AdGuard Home work data is bind-mounted to /opt/adguardhome/work by the managed resource.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      },
      "config": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.config/vrooli/resources/adguard-home",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/adguard-home",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/adguard-home"
        },
        "kind": "dir",
        "class": "config",
        "regenerable": false,
        "sensitive": true,
        "rationale": "AdGuard Home configuration is bind-mounted to /opt/adguardhome/conf and contains administrative settings."
      }
    }
  },
  "display_name": "AdGuard Home",
  "description": "Managed AdGuard Home DNS filtering and resolver service",
  "cli": {
    "enabled": true,
    "command": "resource-adguard-home",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-adguard-home_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-adguard-home"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "portability_tier": "partial",
  "category": "dns",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/adguard-home",
        "field": "admin-username",
        "env": "ADGUARD_HOME_USERNAME",
        "label": "AdGuard Home admin username",
        "description": "Administrator username used by resource-local diagnostics and Network Manager when checking AdGuard Home.",
        "required": false
      },
      {
        "logical_id": "vrooli/adguard-home",
        "field": "admin-password",
        "env": "ADGUARD_HOME_PASSWORD",
        "label": "AdGuard Home admin password",
        "description": "Administrator password stored through the Vrooli secret flow; never pass this value to Network Manager directly.",
        "required": false
      }
    ]
  },
  "ports": [
    {
      "name": "admin",
      "container": 3000,
      "host": 3000,
      "protocol": "tcp"
    },
    {
      "name": "dns-tcp",
      "host_ip": "192.168.1.173",
      "container": 53,
      "host": 53,
      "protocol": "tcp"
    },
    {
      "name": "dns-udp",
      "host_ip": "192.168.1.173",
      "container": 53,
      "host": 53,
      "protocol": "udp"
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:3000/",
      "expected_status": [
        200,
        302,
        401
      ],
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "adguard/adguardhome@sha256:e6f2b8bcda06064ab055b44933a4f0e983c35558b9cdb8d2e7ab1efcee36d890",
    "container_name": "vrooli-adguard-home-resource",
    "env": {
      "ADGUARD_HOME_BASE_URL": "http://localhost:3000",
      "ADGUARD_HOME_CREDENTIAL_REF": "vrooli/adguard-home"
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/opt/adguardhome/work"
      },
      {
        "source": "${RESOURCE_CONFIG_DIR}",
        "target": "/opt/adguardhome/conf"
      }
    ]
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for adguard-home.",
    "properties": {},
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "ADGUARD_HOME_HOST": "localhost",
      "ADGUARD_HOME_DNS_BIND_IP": "192.168.1.173"
    },
    "from_ports": {
      "ADGUARD_HOME_PORT": "admin",
      "ADGUARD_HOME_DNS_TCP_PORT": "dns-tcp",
      "ADGUARD_HOME_DNS_UDP_PORT": "dns-udp"
    },
    "from_runtime_env": [
      "ADGUARD_HOME_CREDENTIAL_REF"
    ],
    "derived": {
      "ADGUARD_HOME_URL": {
        "template": "http://$ADGUARD_HOME_HOST:$ADGUARD_HOME_PORT"
      },
      "ADGUARD_HOME_BASE_URL": {
        "template": "http://$ADGUARD_HOME_HOST:$ADGUARD_HOME_PORT"
      }
    }
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 30,
    "startup_time_estimate": "5-15s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "lifecycle": {
    "start_timeout_seconds": 30,
    "stop_timeout_seconds": 30,
    "retries": 2
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": false
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
