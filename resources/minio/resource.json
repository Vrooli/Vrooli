{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "minio",
  "display_name": "MinIO",
  "description": "Managed MinIO object storage service with native docker lifecycle and shell-retained S3 administration commands.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "storage",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "api",
      "container": 9000,
      "host": 9000
    },
    {
      "name": "console",
      "container": 9001,
      "host": 9001
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:9000/minio/health/live",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "minio/minio:latest",
    "container_name": "minio",
    "env": {
      "MINIO_ROOT_USER": "minioadmin",
      "MINIO_ROOT_PASSWORD": "minioadmin",
      "MINIO_BROWSER": "on",
      "MINIO_REGION": "us-east-1",
      "GOMAXPROCS": "4",
      "MINIO_API_REQUESTS_MAX": "8000",
      "MINIO_API_REQUESTS_DEADLINE": "10s"
    },
    "volumes": [
      {
        "source": "${HOME}/.minio/data",
        "target": "/data"
      },
      {
        "source": "${HOME}/.minio/config",
        "target": "/root/.minio"
      }
    ],
    "command": [
      "server",
      "/data",
      "--console-address",
      ":9001"
    ]
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
