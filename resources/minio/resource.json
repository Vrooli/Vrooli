{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "minio",
  "display_name": "MinIO",
  "description": "Managed MinIO object storage service with native docker lifecycle and shell-retained S3 administration commands.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "storage",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "api",
      "container": 9000,
      "host": 9000
    },
    {
      "name": "console",
      "container": 9001,
      "host": 9001
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:9000/minio/health/live",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "minio/minio:latest",
    "container_name": "minio",
    "env": {
      "MINIO_ROOT_USER": "minioadmin",
      "MINIO_ROOT_PASSWORD": "minioadmin",
      "MINIO_BROWSER": "on",
      "MINIO_REGION": "us-east-1",
      "GOMAXPROCS": "4",
      "MINIO_API_REQUESTS_MAX": "8000",
      "MINIO_API_REQUESTS_DEADLINE": "10s"
    },
    "volumes": [
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/data"
      },
      {
        "source": "${RESOURCE_CONFIG_DIR}",
        "target": "/root/.minio"
      }
    ],
    "command": [
      "server",
      "/data",
      "--console-address",
      ":9001"
    ]
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific MinIO dependency settings.",
    "properties": {
      "buckets": {
        "type": "object",
        "properties": {
          "default_buckets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "MINIO_HOST": "localhost"
    },
    "from_ports": {
      "MINIO_PORT": "api",
      "MINIO_CONSOLE_PORT": "console"
    },
    "from_runtime_env": [
      "MINIO_ROOT_USER",
      "MINIO_ROOT_PASSWORD",
      "MINIO_BROWSER",
      "MINIO_REGION"
    ],
    "derived": {
      "MINIO_URL": {
        "template": "http://${MINIO_HOST}:${MINIO_PORT}"
      },
      "MINIO_BASE_URL": {
        "template": "${MINIO_URL}"
      },
      "MINIO_ENDPOINT": {
        "template": "${MINIO_HOST}:${MINIO_PORT}"
      },
      "MINIO_CONSOLE_URL": {
        "template": "http://${MINIO_HOST}:${MINIO_CONSOLE_PORT}"
      },
      "MINIO_ACCESS_KEY": {
        "template": "${MINIO_ROOT_USER}"
      },
      "MINIO_SECRET_KEY": {
        "template": "${MINIO_ROOT_PASSWORD}"
      }
    }
  },
  "orchestration": {
    "startup_order": 950,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
