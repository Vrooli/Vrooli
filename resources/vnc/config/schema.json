{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VNC Resource Configuration",
  "description": "Configuration for x11vnc + websockify VNC resource",
  "type": "object",
  "properties": {
    "vnc_port_start": {
      "type": "integer",
      "default": 5900,
      "description": "Start of VNC port range"
    },
    "vnc_port_end": {
      "type": "integer",
      "default": 5999,
      "description": "End of VNC port range"
    },
    "ws_port_start": {
      "type": "integer",
      "default": 6080,
      "description": "Start of WebSocket port range"
    },
    "ws_port_end": {
      "type": "integer",
      "default": 6180,
      "description": "End of WebSocket port range"
    }
  }
}
