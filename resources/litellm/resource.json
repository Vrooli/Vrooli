{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "litellm",
  "display_name": "LiteLLM",
  "description": "Managed LiteLLM proxy service with native docker lifecycle and shell-retained model/config workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-litellm",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "full",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "hostTools": [
    {
      "name": "yq",
      "required": false,
      "reason": "Inspect and summarize retained LiteLLM YAML configuration from shell status workflows",
      "when": ["setup", "develop"],
      "notes": "Status output degrades gracefully when yq is unavailable"
    }
  ],
  "dependencies": [],
  "ports": [
    {
      "name": "http",
      "container": 4000,
      "host": 11435
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:11435/health",
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "ghcr.io/berriai/litellm:main-latest",
    "container_name": "vrooli-litellm",
    "volumes": [
      {
        "source": "${RESOURCE_CONFIG_DIR}/config.yaml",
        "target": "/app/config.yaml"
      },
      {
        "source": "${RESOURCE_CONFIG_DIR}/.env",
        "target": "/app/.env"
      },
      {
        "source": "${RESOURCE_DATA_DIR}",
        "target": "/app/data"
      },
      {
        "source": "${RESOURCE_LOGS_DIR}",
        "target": "/app/logs"
      }
    ],
    "command": [
      "--config",
      "/app/config.yaml",
      "--port",
      "4000",
      "--detailed_debug"
    ]
  },
  "orchestration": {
    "startup_order": 650,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 3,
    "priority": "high"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 3
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
