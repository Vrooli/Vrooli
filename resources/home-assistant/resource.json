{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "home-assistant",
  "display_name": "Home Assistant",
  "description": "Managed Home Assistant service with native compose-backed lifecycle and shell-retained automation, backup, and voice workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-home-assistant",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": { "kind": "prebuilt_artifact", "artifact_name": "resource-home-assistant_${os}_${arch}" },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-home-assistant"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": { "profiles": { "desktop": { "linux": { "support": "conditional", "mode": "docker-desktop", "architectures": ["amd64", "arm64"], "requires": ["docker-engine"], "limitations": ["Compose images, storage, and networking remain host-managed."], "evidence": ["manifest-validation", "docker-preflight"] }, "macos": { "support": "conditional", "mode": "docker-desktop", "architectures": ["amd64", "arm64"], "requires": ["docker-desktop"], "limitations": ["Docker Desktop must be installed and running."], "evidence": ["manifest-validation", "docker-preflight"] }, "windows": { "support": "conditional", "mode": "docker-desktop", "architectures": ["amd64", "arm64"], "requires": ["docker-desktop"], "limitations": ["Docker Desktop must be installed and running."], "evidence": ["manifest-validation", "docker-preflight"] } } } },
  "compose_file": "compose.yaml",
  "portability_tier": "partial",
  "category": "automation",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8123,
      "host": 8123
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Home Assistant dependency settings.",
    "properties": {
      "cli_integration": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string"
      },
      "health_check": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "HOME_ASSISTANT_HOST": "localhost",
      "HOME_ASSISTANT_CONTAINER_NAME": "home-assistant"
    },
    "from_ports": {
      "HOME_ASSISTANT_PORT": "http"
    },
    "from_runtime_env": [
      "HOME_ASSISTANT_TOKEN"
    ],
    "derived": {
      "HOME_ASSISTANT_BASE_URL": {
        "template": "http://${HOME_ASSISTANT_HOST}:${HOME_ASSISTANT_PORT}"
      },
      "HOME_ASSISTANT_URL": {
        "template": "${HOME_ASSISTANT_BASE_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 450,
    "startup_timeout_seconds": 50,
    "startup_time_estimate": "15-30s",
    "dependencies": ["postgres"],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8123/api/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
