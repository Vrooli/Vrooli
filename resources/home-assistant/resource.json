{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "home-assistant",
  "storage": {
    "entries": {
      "config": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.config/vrooli/resources/home-assistant",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/home-assistant",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/home-assistant"
        },
        "kind": "dir",
        "class": "config",
        "regenerable": false,
        "sensitive": true,
        "rationale": "Home Assistant's compose service bind-mounts this directory to /config; it contains the recorder database, integrations, and secrets."
      },
      "backups": {
        "rung": "pinned",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/home-assistant",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/home-assistant",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/home-assistant"
        },
        "kind": "dir",
        "class": "data",
        "regenerable": false,
        "rationale": "The resource stores backup archives beneath its managed data root.",
        "budget": {
          "max_bytes": "1TiB",
          "rationale": "Durable data storage budget measured and governed on 2026-08-05; the byte ceiling prevents unbounded growth without permitting automatic deletion."
        }
      }
    }
  },
  "display_name": "Home Assistant",
  "description": "Managed Home Assistant service with native compose-backed lifecycle and shell-retained automation, backup, and voice workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-home-assistant",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-home-assistant_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-home-assistant"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "credentials": {
    "descriptors": [
      {
        "logical_id": "vrooli/home-assistant",
        "field": "long-lived-token",
        "env": "HOME_ASSISTANT_TOKEN",
        "label": "Home Assistant long-lived token",
        "description": "Optional API token for Home Assistant automation.",
        "required": false
      },
      {
        "logical_id": "vrooli/home-assistant",
        "field": "webhook-secret",
        "env": "HOME_ASSISTANT_WEBHOOK_SECRET",
        "label": "Webhook secret",
        "description": "Optional secret for validating incoming Home Assistant webhooks.",
        "required": false
      },
      {
        "logical_id": "vrooli/home-assistant",
        "field": "github-token",
        "env": "GITHUB_TOKEN",
        "label": "GitHub token",
        "description": "Optional token for HACS and update integrations.",
        "required": false
      },
      {
        "logical_id": "vrooli/home-assistant",
        "field": "openweathermap-api-key",
        "env": "OPENWEATHERMAP_API_KEY",
        "label": "OpenWeatherMap API key",
        "description": "Optional weather integration credential.",
        "required": false
      },
      {
        "logical_id": "vrooli/home-assistant",
        "field": "recorder-database-url",
        "env": "HOME_ASSISTANT_RECORDER_DB_URL",
        "label": "Recorder database URL",
        "description": "Optional recorder database connection credential.",
        "required": false
      },
      {
        "logical_id": "vrooli/home-assistant",
        "field": "mqtt-password",
        "env": "MQTT_PASSWORD",
        "label": "MQTT password",
        "description": "Optional password for a configured MQTT broker.",
        "required": false
      }
    ]
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "compose.yaml",
  "category": "automation",
  "requirements": {
    "ram_mb": 2048,
    "disk_mb": 4096,
    "cpu_cores": 2,
    "network": "required",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "automation",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8123,
      "host": 8123
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Home Assistant dependency settings.",
    "properties": {
      "cli_integration": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string"
      },
      "health_check": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "HOME_ASSISTANT_HOST": "localhost",
      "HOME_ASSISTANT_CONTAINER_NAME": "home-assistant"
    },
    "from_ports": {
      "HOME_ASSISTANT_PORT": "http"
    },
    "from_runtime_env": [
      "HOME_ASSISTANT_TOKEN"
    ],
    "derived": {
      "HOME_ASSISTANT_BASE_URL": {
        "template": "http://${HOME_ASSISTANT_HOST}:${HOME_ASSISTANT_PORT}"
      },
      "HOME_ASSISTANT_URL": {
        "template": "${HOME_ASSISTANT_BASE_URL}"
      }
    }
  },
  "orchestration": {
    "startup_order": 450,
    "startup_timeout_seconds": 50,
    "startup_time_estimate": "15-30s",
    "dependencies": [
      "postgres"
    ],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:8123/manifest.json",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
