{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "home-assistant",
  "display_name": "Home Assistant",
  "description": "Managed Home Assistant service with native compose-backed lifecycle and shell-retained automation, backup, and voice workflows.",
  "template": "compose-service",
  "driver": "compose-service",
  "compose_file": "compose.yaml",
  "portability_tier": "partial",
  "category": "automation",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8123,
      "host": 8123
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8123/api/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
