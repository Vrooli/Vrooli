{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "kokoro",
  "display_name": "Kokoro",
  "description": "Managed Kokoro text-to-speech service with native compose-backed lifecycle and shell-retained voice synthesis workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-kokoro",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-kokoro_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-kokoro"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module",
      "freshness_inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-engine"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker-desktop"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "docker/docker-compose.yml",
  "gpu": {
    "probe": "nvidia",
    "compose_overlay": "docker/docker-compose.gpu.yml",
    "env_overrides": {
      "KOKORO_IMAGE": "ghcr.io/remsky/kokoro-fastapi-gpu:latest"
    }
  },
  "portability_tier": "partial",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8880,
      "host": 8880
    }
  ],
  "orchestration": {
    "startup_order": 560,
    "startup_timeout_seconds": 60,
    "startup_time_estimate": "20-45s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "KOKORO_HOST": "localhost"
    },
    "from_ports": {
      "KOKORO_PORT": "http"
    },
    "derived": {
      "KOKORO_URL": {
        "template": "http://${KOKORO_HOST}:${KOKORO_PORT}"
      },
      "KOKORO_BASE_URL": {
        "template": "${KOKORO_URL}"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8880/v1/audio/voices",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
