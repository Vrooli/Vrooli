{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "kokoro",
  "storage": {
    "entries": {},
    "rationale": "No additional host storage is owned by this resource on the supported lifecycle path; the explicit empty declaration prevents an implicit-storage assumption."
  },
  "display_name": "Kokoro",
  "description": "Managed Kokoro text-to-speech service with native compose-backed lifecycle and shell-retained voice synthesis workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-kokoro",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-kokoro_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-kokoro"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "docker/docker-compose.yml",
  "gpu": {
    "probe": "nvidia",
    "compose_overlay": "docker/docker-compose.gpu.yml",
    "env_overrides": {
      "KOKORO_IMAGE": "ghcr.io/remsky/kokoro-fastapi-gpu@sha256:79d81c41d8883611291c5785e47db2ba00765e9b89dd59de05d9f28e1945f905"
    }
  },
  "capacity": {
    "resource_kind": "vram",
    "gpu_index": 0,
    "preferred_bytes": 2147483648,
    "floor_bytes": 1073741824,
    "priority": "service"
  },
  "category": "ai",
  "requirements": {
    "ram_mb": 4096,
    "disk_mb": 6144,
    "cpu_cores": 2,
    "gpu": true,
    "network": "required",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 8880,
      "host": 8880
    }
  ],
  "orchestration": {
    "startup_order": 560,
    "startup_timeout_seconds": 120,
    "startup_time_estimate": "cold image pull and model load up to 2 min; then 20-45s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "KOKORO_HOST": "localhost"
    },
    "from_ports": {
      "KOKORO_PORT": "http"
    },
    "derived": {
      "KOKORO_URL": {
        "template": "http://${KOKORO_HOST}:${KOKORO_PORT}"
      },
      "KOKORO_BASE_URL": {
        "template": "${KOKORO_URL}"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8880/v1/audio/voices",
      "kind": "readiness",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
