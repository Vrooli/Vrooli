{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "kokoro",
  "storage": {
    "entries": {},
    "rationale": "No additional host storage is owned by this resource on the supported lifecycle path; the explicit empty declaration prevents an implicit-storage assumption."
  },
  "display_name": "Kokoro",
  "description": "Managed Kokoro text-to-speech service with native compose-backed lifecycle and shell-retained voice synthesis workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-kokoro",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-kokoro_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-kokoro"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Compose images, storage, and networking remain host-managed."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "docker-desktop",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "docker"
          ],
          "limitations": [
            "Docker Desktop must be installed and running."
          ],
          "evidence": [
            "manifest-validation",
            "docker-preflight"
          ]
        }
      }
    }
  },
  "compose_file": "docker/docker-compose.yml",
  "acceleration": {
    "backends": [
      "cuda",
      "cpu"
    ],
    "require": "preferred",
    "cuda": {
      "compose_overlay": "docker/docker-compose.gpu.yml",
      "env": {
        "KOKORO_IMAGE": "ghcr.io/remsky/kokoro-fastapi-gpu@sha256:79d81c41d8883611291c5785e47db2ba00765e9b89dd59de05d9f28e1945f905"
      }
    },
    "cpu": {},
    "claim": {
      "resource_kind": "vram",
      "gpu_index": 0,
      "preferred_bytes": 2147483648,
      "floor_bytes": 0,
      "priority": "service",
      "yield_when_idle": true,
      "idle_grace_seconds": 900,
      "profile": {
        "steps": [
          {
            "label": "gpu",
            "amount_bytes": 2147483648
          },
          {
            "label": "cpu",
            "amount_bytes": 0
          }
        ],
        "apply": {
          "verb": "capacity",
          "argv": [
            "degrade",
            "--to",
            "{label}"
          ]
        },
        "upshift": true
      }
    }
  },
  "category": "ai",
  "requirements": {
    "ram_mb": 4096,
    "disk_mb": 6144,
    "cpu_cores": 2,
    "network": "required",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "build-verified",
    "windows": "build-verified"
  },
  "ports": [
    {
      "name": "http",
      "container": 8880,
      "host": 8880
    }
  ],
  "orchestration": {
    "startup_order": 560,
    "startup_timeout_seconds": 120,
    "startup_time_estimate": "cold image pull and model load up to 2 min; then 20-45s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "KOKORO_HOST": "localhost"
    },
    "from_ports": {
      "KOKORO_PORT": "http"
    },
    "derived": {
      "KOKORO_URL": {
        "template": "http://${KOKORO_HOST}:${KOKORO_PORT}"
      },
      "KOKORO_BASE_URL": {
        "template": "${KOKORO_URL}"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8880/v1/audio/voices",
      "kind": "readiness",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required",
  "hostSafeguards": [
    {
      "name": "nvidia_driver",
      "required": false,
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ],
      "reason": "This resource declares an accelerator backend. The safeguard proves the host driver is ready, that the compute device nodes survive a boot with no client attached, and that this user can open them; without all three the resource starts and silently falls back to the CPU.",
      "notes": "No-op on hosts without NVIDIA display hardware. Optional because a CPU fallback is a supported, reported state rather than a start-time failure; a resource that must have an accelerator declares acceleration.require = required instead."
    }
  ]
}
