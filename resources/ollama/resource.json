{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "ollama",
  "display_name": "Ollama",
  "description": "Managed Ollama model-serving runtime for local inference workloads.",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "partial",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "ports": [
    {
      "name": "http",
      "container": 11434,
      "host": 11434
    }
  ],
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:11434/api/tags",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "runtime": {
    "image": "ollama/ollama:0.11.7",
    "container_name": "ollama",
    "env": {
      "OLLAMA_HOST": "0.0.0.0:11434",
      "OLLAMA_NUM_PARALLEL": "16",
      "OLLAMA_MAX_LOADED_MODELS": "3",
      "OLLAMA_FLASH_ATTENTION": "1",
      "OLLAMA_ORIGINS": "*"
    },
    "volumes": [
      {
        "source": "${HOME}/.ollama",
        "target": "/root/.ollama"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "OLLAMA_HOST": "localhost"
    },
    "from_ports": {
      "OLLAMA_PORT": "http"
    },
    "from_runtime_env": [
      "OLLAMA_NUM_PARALLEL",
      "OLLAMA_MAX_LOADED_MODELS",
      "OLLAMA_FLASH_ATTENTION",
      "OLLAMA_ORIGINS"
    ],
    "derived": {
      "OLLAMA_URL": {
        "template": "http://${OLLAMA_HOST}:${OLLAMA_PORT}"
      },
      "OLLAMA_BASE_URL": {
        "template": "${OLLAMA_URL}"
      },
      "OLLAMA_API_TAGS": {
        "template": "${OLLAMA_URL}/api/tags"
      },
      "OLLAMA_API_CHAT": {
        "template": "${OLLAMA_URL}/api/chat"
      },
      "OLLAMA_API_GENERATE": {
        "template": "${OLLAMA_URL}/api/generate"
      },
      "OLLAMA_API_PULL": {
        "template": "${OLLAMA_URL}/api/pull"
      },
      "OLLAMA_API_SHOW": {
        "template": "${OLLAMA_URL}/api/show"
      }
    }
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 5
  },
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "1"
}
