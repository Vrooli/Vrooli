{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "ollama",
  "display_name": "Ollama",
  "description": "Managed Ollama model-serving runtime for local inference workloads.",
  "storage": {
    "entries": {
      "models": {
        "rung": "relocatable",
        "kind": "dir",
        "regenerable": true,
        "budget": {
          "max_bytes": "90423MiB",
          "rationale": "Measured at 62434233666 bytes on 2026-08-15 from Ollama /api/tags; ceiling is two times observed size."
        },
        "relocation": {
          "key": "OLLAMA_MODELS",
          "scope": "process-tree"
        },
        "rationale": "Model weights are large but recoverable from their registry sources. The live model inventory reports each model's name, digest, size, policy reachability, and regeneration rationale; the resource relocates the shared blob store through OLLAMA_MODELS.",
        "class": "data",
        "subpath": "models"
      },
      "cache": {
        "rung": "relocatable",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/cache",
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "budget": {
          "max_age": "30d",
          "rationale": "Model recommendation metadata is regenerable and was observed under the resource data root."
        },
        "relocation": {
          "key": "OLLAMA_MODELS",
          "scope": "process-tree"
        },
        "rationale": "Ollama recommendation cache is not model state and may be reclaimed by age."
      },
      "credentials": {
        "rung": "pinned",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/id_ed25519",
        "kind": "file",
        "class": "config",
        "regenerable": false,
        "sensitive": true,
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "The resource signing key is a small durable credential; the ceiling is intentionally bounded."
        },
        "rationale": "Ollama uses this host credential for model registry access."
      },
      "credentials_public": {
        "rung": "pinned",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/id_ed25519.pub",
        "kind": "file",
        "class": "config",
        "regenerable": true,
        "sensitive": false,
        "budget": {
          "max_age": "30d",
          "rationale": "The public signing key is regenerable metadata with a bounded age."
        },
        "rationale": "Ollama stores the public half beside the signing credential."
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "resource-ollama",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-ollama_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-ollama"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json",
        "model-policy.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "template": "managed-service",
  "driver": "managed-service",
  "managed_service": {
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/ollama",
      "version": "0.30.10",
      "sha256_by_platform": {
        "linux-amd64": "d173d44ec6992090968ddbd20230873a00852ccedcd532bfddd0d307829ebb78",
        "macos-amd64": "88abf6776aa83f8d975a486ddac82a285be61cdadd5705153338a49e0f2c5139",
        "macos-arm64": "88abf6776aa83f8d975a486ddac82a285be61cdadd5705153338a49e0f2c5139"
      },
      "bundle_artifact": "ollama_${os}_${arch}"
    },
    "attach_health_path": "/api/tags",
    "arguments": ["serve"],
    "environment": {
      "OLLAMA_HOST": "127.0.0.1:${RESOURCE_PORT_HTTP}",
      "OLLAMA_MODELS": "${RESOURCE_DATA_DIR}/models",
      "OLLAMA_LIBRARY_PATH": "${RESOURCE_ARTIFACT_DIR}/lib/ollama",
      "OLLAMA_NUM_PARALLEL": "4",
      "OLLAMA_MAX_LOADED_MODELS": "3",
      "OLLAMA_FLASH_ATTENTION": "1",
      "OLLAMA_KEEP_ALIVE": "5m",
      "OLLAMA_CONTEXT_LENGTH": "8192",
      "OLLAMA_ORIGINS": "*"
    }
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": ["amd64"],
          "requires": [],
          "limitations": [
            "The signed native Linux artifact is currently evidenced for amd64; arm64 remains conditional until a matching Vrooli bundle is published."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum",
            "target-smoke"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "bundled-service",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "The pinned upstream macOS application contains a universal Ollama server binary; native target smoke evidence is still pending."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum"
          ]
        },
        "windows": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "The native Windows release is available upstream, but a Vrooli-extracted, checksum-paired server bundle and target smoke evidence have not yet been staged."
          ],
          "evidence": [],
          "reason": "Windows remains unsupported until the signed native server bundle is staged and exercised by the managed-service supervisor."
        }
      }
    }
  },
  "companions": [
    {
      "name": "capacity-sync",
      "command": "resource-ollama",
      "args": [
        "capacity-sync"
      ]
    }
  ],
  "capacity": {
    "resource_kind": "vram",
    "gpu_index": 0,
    "preferred_bytes": 11811160064,
    "floor_bytes": 3221225472,
    "priority": "service",
    "yield_when_idle": true,
    "idle_grace_seconds": 900,
    "profile": {
      "steps": [
        {"label": "qwen3.5:9b", "amount_bytes": 11811160064},
        {"label": "qwen3.5:4b", "amount_bytes": 6442450944},
        {"label": "qwen3:4b", "amount_bytes": 5368709120},
        {"label": "qwen3:1.7b", "amount_bytes": 3221225472}
      ],
      "apply": {
        "verb": "capacity",
        "argv": ["degrade", "--to", "{label}"]
      },
      "upshift": true
    }
  },
  "category": "ai",
  "requirements": {
    "ram_mb": 8192,
    "disk_mb": 12288,
    "cpu_cores": 4,
    "gpu": true,
    "network": "optional",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "unsupported"
  },
  "ports": [
    {
      "name": "http",
      "container": 11434,
      "host": 11434
    }
  ],
  "health_checks": [
    {
      "type": "command",
      "kind": "readiness",
      "command": [
        "resource-ollama",
        "health-ready"
      ],
      "interval_seconds": 10,
      "timeout_seconds": 10
    },
    {
      "type": "command",
      "kind": "liveness",
      "command": [
        "resource-ollama",
        "health-gpu"
      ],
      "interval_seconds": 30,
      "timeout_seconds": 10
    }
  ],
  "gpu": {
    "probe": "nvidia",
    "env_overrides": {
      "NVIDIA_VISIBLE_DEVICES": "all"
    }
  },
  "hostSafeguards": [
    {
      "name": "nvidia_driver",
      "required": true,
      "when": [
        "setup"
      ],
      "platforms": [
        "linux"
      ],
      "reason": "Repair and validate the host NVIDIA kernel driver when NVIDIA hardware is present; GPU containers require a working host driver.",
      "notes": "No-op on hosts without NVIDIA display hardware. On Ubuntu, setup repairs the current-kernel module package and its installed kernel meta package, then reports a required reboot."
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Ollama dependency settings.",
    "properties": {
      "model": {
        "type": "string",
        "description": "Deprecated singular concrete model reference. Prefer model_roles; use models only for documented direct exceptions."
      },
      "model_roles": {
        "type": "array",
        "description": "Logical Ollama model roles resolved through resources/ollama/model-policy.json.",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "models": {
        "type": "array",
        "description": "Concrete model exceptions. Prefer model_roles; object entries should include reason and owner.",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "quantization": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "review_after": {
                  "type": "string",
                  "format": "date"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "configuration": {
        "type": "object",
        "additionalProperties": true
      },
      "cli_integration": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "OLLAMA_HOST": "localhost"
    },
    "from_ports": {
      "OLLAMA_PORT": "http"
    },
    "from_runtime_env": [
      "OLLAMA_NUM_PARALLEL",
      "OLLAMA_MAX_LOADED_MODELS",
      "OLLAMA_FLASH_ATTENTION",
      "OLLAMA_CONTEXT_LENGTH",
      "OLLAMA_ORIGINS"
    ],
    "derived": {
      "OLLAMA_URL": {
        "template": "http://${OLLAMA_HOST}:${OLLAMA_PORT}"
      },
      "OLLAMA_BASE_URL": {
        "template": "${OLLAMA_URL}"
      },
      "OLLAMA_API_TAGS": {
        "template": "${OLLAMA_URL}/api/tags"
      },
      "OLLAMA_API_CHAT": {
        "template": "${OLLAMA_URL}/api/chat"
      },
      "OLLAMA_API_GENERATE": {
        "template": "${OLLAMA_URL}/api/generate"
      },
      "OLLAMA_API_PULL": {
        "template": "${OLLAMA_URL}/api/pull"
      },
      "OLLAMA_API_SHOW": {
        "template": "${OLLAMA_URL}/api/show"
      }
    }
  },
  "orchestration": {
    "startup_order": 700,
    "startup_timeout_seconds": 60,
    "startup_time_estimate": "15-30s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 5
  },
  "capabilities": {
    "supports_logs": true,
    "supports_ensure": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
