{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "ollama",
  "display_name": "Ollama",
  "description": "Managed Ollama model-serving runtime for local inference workloads.",
  "execution": {
    "install_only": true,
    "rationale": "Ollama supplies local models to coding-agent codecs but is not itself an agent-manager coding-agent runner."
  },
  "storage": {
    "entries": {
      "models": {
        "rung": "relocatable",
        "kind": "dir",
        "regenerable": true,
        "budget": {
          "max_bytes": "90423MiB",
          "rationale": "Measured at 62434233666 bytes on 2026-08-15 from Ollama /api/tags; ceiling is two times observed size."
        },
        "relocation": {
          "key": "OLLAMA_MODELS",
          "scope": "process-tree"
        },
        "rationale": "Model weights are large but recoverable from their registry sources. The live model inventory reports each model's name, digest, size, policy reachability, and regeneration rationale; the resource relocates the shared blob store through OLLAMA_MODELS.",
        "class": "data",
        "subpath": "models"
      },
      "cache": {
        "rung": "relocatable",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/cache",
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "budget": {
          "max_age": "30d",
          "rationale": "Model recommendation metadata is regenerable and was observed under the resource data root."
        },
        "relocation": {
          "key": "OLLAMA_MODELS",
          "scope": "process-tree"
        },
        "rationale": "Ollama recommendation cache is not model state and may be reclaimed by age."
      },
      "credentials": {
        "rung": "pinned",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/id_ed25519",
        "kind": "file",
        "class": "config",
        "regenerable": false,
        "sensitive": true,
        "budget": {
          "max_bytes": "1MiB",
          "rationale": "The resource signing key is a small durable credential; the ceiling is intentionally bounded."
        },
        "rationale": "Ollama uses this host credential for model registry access."
      },
      "credentials_public": {
        "rung": "pinned",
        "path": "$USER_DATA_DIR/vrooli/resources/ollama/id_ed25519.pub",
        "kind": "file",
        "class": "config",
        "regenerable": true,
        "sensitive": false,
        "budget": {
          "max_age": "30d",
          "rationale": "The public signing key is regenerable metadata with a bounded age."
        },
        "rationale": "Ollama stores the public half beside the signing credential."
      }
    }
  },
  "cli": {
    "enabled": true,
    "command": "resource-ollama",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-ollama_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-ollama"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json",
        "model-policy.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "driver": "managed-service",
  "managed_service": {
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/ollama",
      "version": "0.30.10",
      "layout": "dir",
      "entry_path": "bin/ollama",
      "sha256_by_platform": {
        "linux-amd64": "6de264e9396f76050d7e52eba55b5f5a3faf36b72bbb40dd1a6bc086ffa17e1d",
        "linux-arm64": "a08ccae5f5bc28f7d0dabf62c8dcdc6edfa560405d1ef21f00a5b449529698f2",
        "macos-amd64": "2977c5b38dfcf6a8293c7c027348bfb77ba2ef519b421b1a748a6285d4fcf7b8",
        "macos-arm64": "2977c5b38dfcf6a8293c7c027348bfb77ba2ef519b421b1a748a6285d4fcf7b8",
        "windows-amd64": "98cd3471b03c9fc382a94ba38682d20770ed711883a0b287b5c4f1834b599401"
      },
      "bundle_artifact": "ollama_${os}_${arch}"
    },
    "process_limits": {
      "memory_high_percent": 60,
      "memory_max_percent": 70,
      "oom_score_adjust": 500
    },
    "acquisition": {
      "kind": "url",
      "license": "MIT",
      "targets": [
        {
          "when": {
            "os": "linux",
            "arch": "amd64"
          },
          "url": "https://github.com/ollama/ollama/releases/download/v0.30.10/ollama-linux-amd64.tar.zst",
          "sha256": "046d8f28e58d58477a49558d8d1bcb2e81ca8b287f93c44b12ff919c10d178dd",
          "archive": "tar.zst",
          "layout": "dir",
          "bin_path": "bin/ollama"
        },
        {
          "when": {
            "os": "linux",
            "arch": "arm64"
          },
          "url": "https://github.com/ollama/ollama/releases/download/v0.30.10/ollama-linux-arm64.tar.zst",
          "sha256": "b626aef722ddb9d64dd20a76eeba9267abc5e9494faabb97839db85462b707d7",
          "archive": "tar.zst",
          "layout": "dir",
          "bin_path": "bin/ollama"
        },
        {
          "when": {
            "os": "macos",
            "arch": "amd64"
          },
          "url": "https://github.com/ollama/ollama/releases/download/v0.30.10/Ollama-darwin.zip",
          "sha256": "18ff2fd66e141595edbb79fa6887806ed2fe6e08fdfe8b91ecc9376a6bfcb29f",
          "archive": "zip",
          "layout": "dir",
          "bin_path": "Ollama.app/Contents/Resources/ollama"
        },
        {
          "when": {
            "os": "macos",
            "arch": "arm64"
          },
          "url": "https://github.com/ollama/ollama/releases/download/v0.30.10/Ollama-darwin.zip",
          "sha256": "18ff2fd66e141595edbb79fa6887806ed2fe6e08fdfe8b91ecc9376a6bfcb29f",
          "archive": "zip",
          "layout": "dir",
          "bin_path": "Ollama.app/Contents/Resources/ollama"
        },
        {
          "when": {
            "os": "windows"
          },
          "arch": "amd64",
          "url": "https://github.com/ollama/ollama/releases/download/v0.30.10/ollama-windows-amd64.zip",
          "sha256": "9606cee7501703a0969682667def313130f99ed73f44a88a7a8efe82d4b565f0",
          "archive": "zip",
          "layout": "dir",
          "bin_path": "ollama.exe"
        }
      ]
    },
    "attach_health_path": "/api/tags",
    "arguments": [
      "serve"
    ],
    "environment": {
      "OLLAMA_HOST": "127.0.0.1:${RESOURCE_PORT_HTTP}",
      "OLLAMA_MODELS": "${RESOURCE_DATA_DIR}/models",
      "OLLAMA_LIBRARY_PATH": "${RESOURCE_ARTIFACT_DIR}/lib/ollama",
      "OLLAMA_NUM_PARALLEL": "4",
      "OLLAMA_MAX_LOADED_MODELS": "3",
      "OLLAMA_FLASH_ATTENTION": "1",
      "OLLAMA_KEEP_ALIVE": "5m",
      "OLLAMA_CONTEXT_LENGTH": "8192",
      "OLLAMA_ORIGINS": "*"
    }
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "manual",
          "architectures": [
            "amd64"
          ],
          "requires": [],
          "limitations": [
            "The signed native Linux artifact is currently evidenced for amd64; arm64 remains conditional until a matching Vrooli bundle is published."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum",
            "target-smoke"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "The pinned upstream macOS application contains a universal Ollama server binary; native target smoke evidence is still pending."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum"
          ]
        },
        "windows": {
          "support": "conditional",
      "mode": "manual",
          "architectures": ["amd64"],
          "requires": [],
          "limitations": [
            "The checksum-pinned standalone Windows server archive is staged for amd64; no real Windows host smoke run has been performed, so this remains build-verified."
          ],
          "evidence": [
            "manifest-validation",
            "artifact-checksum"
          ]
        }
      }
    }
  },
  "companions": [
    {
      "name": "capacity-sync",
      "command": "resource-ollama",
      "args": [
        "capacity-sync"
      ]
    }
  ],
  "acceleration": {
    "backends": [
      "cuda",
      "metal",
      "cpu"
    ],
    "require": "preferred",
    "cuda": {},
    "metal": {
      "verify": {
        "kind": "process-device",
        "device": "metal"
      }
    },
    "cpu": {},
    "claim": {
      "resource_kind": "vram",
      "gpu_index": 0,
      "preferred_bytes": 11811160064,
      "floor_bytes": 3221225472,
      "priority": "service",
      "yield_when_idle": true,
      "idle_grace_seconds": 900,
      "profile": {
        "steps": [
          {
            "label": "qwen3.5:9b",
            "amount_bytes": 11811160064
          },
          {
            "label": "qwen3.5:4b",
            "amount_bytes": 6442450944
          },
          {
            "label": "qwen3:4b",
            "amount_bytes": 5368709120
          },
          {
            "label": "qwen3:1.7b",
            "amount_bytes": 3221225472
          }
        ],
        "apply": {
          "verb": "capacity",
          "argv": [
            "degrade",
            "--to",
            "{label}"
          ]
        },
        "upshift": true
      }
    }
  },
  "category": "ai",
  "requirements": {
    "ram_mb": 8192,
    "disk_mb": 12288,
    "cpu_cores": 4,
    "network": "optional",
    "bucket": "large",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 3
  },
  "platforms": {
    "linux": "supported",
    "macos": "build-verified",
    "windows": "build-verified"
  },
  "ports": [
    {
      "name": "http",
      "container": 11434,
      "host": 11434
    }
  ],
  "health_checks": [
    {
      "type": "command",
      "kind": "readiness",
      "command": [
        "resource-ollama",
        "health-ready"
      ],
      "interval_seconds": 10,
      "timeout_seconds": 10
    },
    {
      "type": "command",
      "kind": "liveness",
      "command": [
        "resource-ollama",
        "health-gpu"
      ],
      "interval_seconds": 30,
      "timeout_seconds": 10
    }
  ],
  "hostSafeguards": [
    {
      "name": "nvidia_driver",
      "required": false,
      "when": [
        "setup",
        "develop"
      ],
      "platforms": [
        "linux"
      ],
      "reason": "This resource declares an accelerator backend. The safeguard proves the host driver is ready, that the compute device nodes survive a boot with no client attached, and that this user can open them; without all three the resource starts and silently falls back to the CPU.",
      "notes": "No-op on hosts without NVIDIA display hardware. Optional because ollama declares acceleration.require = preferred: a CPU fallback is a supported, reported state, and a durability safeguard awaiting an operator sudo run must never stop the resource starting. Strictness is declared in one place, the acceleration block, and enforced by the start-time readiness gate with a typed error."
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Ollama dependency settings.",
    "properties": {
      "model": {
        "type": "string",
        "description": "Deprecated singular concrete model reference. Prefer model_roles; use models only for documented direct exceptions."
      },
      "model_roles": {
        "type": "array",
        "description": "Logical Ollama model roles resolved through resources/ollama/model-policy.json.",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "models": {
        "type": "array",
        "description": "Concrete model exceptions. Prefer model_roles; object entries should include reason and owner.",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "quantization": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "review_after": {
                  "type": "string",
                  "format": "date"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "configuration": {
        "type": "object",
        "additionalProperties": true
      },
      "cli_integration": {
        "type": "boolean"
      },
      "fallback": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "OLLAMA_HOST": "localhost"
    },
    "from_ports": {
      "OLLAMA_PORT": "http"
    },
    "from_runtime_env": [
      "OLLAMA_NUM_PARALLEL",
      "OLLAMA_MAX_LOADED_MODELS",
      "OLLAMA_FLASH_ATTENTION",
      "OLLAMA_CONTEXT_LENGTH",
      "OLLAMA_ORIGINS"
    ],
    "derived": {
      "OLLAMA_URL": {
        "template": "http://${OLLAMA_HOST}:${OLLAMA_PORT}"
      },
      "OLLAMA_BASE_URL": {
        "template": "${OLLAMA_URL}"
      },
      "OLLAMA_API_TAGS": {
        "template": "${OLLAMA_URL}/api/tags"
      },
      "OLLAMA_API_CHAT": {
        "template": "${OLLAMA_URL}/api/chat"
      },
      "OLLAMA_API_GENERATE": {
        "template": "${OLLAMA_URL}/api/generate"
      },
      "OLLAMA_API_PULL": {
        "template": "${OLLAMA_URL}/api/pull"
      },
      "OLLAMA_API_SHOW": {
        "template": "${OLLAMA_URL}/api/show"
      }
    }
  },
  "orchestration": {
    "startup_order": 700,
    "startup_timeout_seconds": 60,
    "startup_time_estimate": "15-30s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "lifecycle": {
    "start_timeout_seconds": 60,
    "stop_timeout_seconds": 30,
    "retries": 5
  },
  "capabilities": {
    "supports_logs": true,
    "supports_ensure": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
