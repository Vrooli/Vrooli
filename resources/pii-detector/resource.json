{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "pii-detector",
  "storage": {
    "entries": {
      "model_cache": {
        "rung": "relocatable",
        "path": {
          "linux": "$USER_HOME/.local/share/vrooli/resources/pii-detector/model-cache",
          "macos": "$USER_HOME/Library/Application Support/vrooli/resources/pii-detector/model-cache",
          "windows": "$USER_HOME/AppData/Local/vrooli/resources/pii-detector/model-cache"
        },
        "kind": "dir",
        "class": "cache",
        "regenerable": true,
        "relocation": {
          "key": "RESOURCE_DATA_DIR",
          "scope": "container"
        },
        "rationale": "The ONNX token-classification model + tokenizer are downloaded/acquired into this bind-mounted cache; re-acquirable from the pinned source.",
        "budget": {
          "max_age": "30d",
          "rationale": "Regenerable storage is retained for 30 days and reclaimed by age; the window is the workload retention requirement."
        }
      }
    }
  },
  "display_name": "PII Detector",
  "description": "Managed CPU ONNX-Runtime service that detects personally-identifiable information in text. Combines a deterministic regex+checksum pass (email, phone, SSN, credit-card via Luhn, IBAN via mod-97) with an NER token-classification model; exposes POST /detect. Consumed via ai-gateway (REQUEST_KIND_DETECT_PII / detect.pii.default) and, as a follow-up, by agent-manager's redact action.",
  "cli": {
    "enabled": true,
    "command": "resource-pii-detector",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "resource-pii-detector_${os}_${arch}"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "resource-pii-detector"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "server/**",
        "docs/**",
        "README.md",
        "resource.json",
        "model-policy.json"
      ]
    },
    "source_build": {
      "kind": "go_module"
    }
  },
  "driver": "managed-service",
  "managed_service": {
    "provider_policy": {
      "target_defaults": {
        "control-plane": "managed-private",
        "desktop-bundle": "managed-private"
      },
      "allowed_modes": [
        "managed-private",
        "managed-shared",
        "attach-only",
        "remote-vrooli",
        "managed-discovered"
      ],
      "shared_reuse_requires_consent": true,
      "external_management": "forbidden",
      "external_access_capabilities": [
        "read-only",
        "read-write"
      ]
    },
    "artifact": {
      "path": "server/dist/resource-pii-detector-server",
      "version": "0.1.0",
      "layout": "dir",
      "entry_path": "server/dist/resource-pii-detector-server",
      "bundle_artifact": "pii_detector_${os}_${arch}",
      "sha256_by_platform": {
        "linux-amd64": "cab40e16f5247d7b81dc3fd5c7fab33966dd7e0eec816ffc71e8a6ac8852c36f"
      }
    },
    "acquisition": {
      "kind": "none",
      "license": "Apache-2.0 (gravitee-io/bert-small-pii-detection; ab-ai/pii_model_based_on_distilbert); Vrooli adapter release artifact",
      "provenance": {
        "kind": "none"
      },
      "targets": [
        {
          "when": {
            "os": "linux",
            "arch": "amd64"
          },
          "unsupported": "TODO(acquire): the regex-only serving binary has a qualified local build, but a signed release artifact + a staged, checksum-pinned ONNX model are not published yet; NER inference is additionally gated on a governed onnxruntime Go-binding dependency approval."
        }
      ]
    },
    "attach_health_path": "/health",
    "arguments": [],
    "environment_file": "active.env",
    "environment": {
      "RESOURCE_LISTEN_ADDR": "127.0.0.1:${RESOURCE_PORT_UPSTREAM}",
      "PII_DETECTOR_MODEL": "gravitee-io/bert-small-pii-detection",
      "PII_DETECTOR_MODEL_CACHE": "${RESOURCE_DATA_DIR}/model-cache"
    }
  },
  "lifecycle": {
    "start_timeout_seconds": 120,
    "stop_timeout_seconds": 30
  },
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64"
          ],
          "requires": [],
          "limitations": [
            "TODO(acquire): no pinned ONNX model artifact or smoke evidence yet. The regex/checksum pass is CPU-pure Go and bundles cleanly, but the NER tier needs a staged ONNX model + the onnxruntime Go binding (governed dependency approval pending)."
          ],
          "reason": "Desktop bundling remains unsupported until a pinned model artifact and target smoke evidence are published."
        },
        "macos": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [],
          "limitations": [
            "TODO(acquire): native macOS bundle + staged model pending."
          ],
          "reason": "Native macOS delivery pending artifact and smoke evidence."
        },
        "windows": {
          "support": "unsupported",
          "mode": "manual",
          "architectures": [
            "amd64"
          ],
          "requires": [],
          "limitations": [
            "TODO(acquire): native Windows bundle + staged model pending."
          ],
          "reason": "Native Windows delivery pending artifact and smoke evidence."
        }
      }
    }
  },
  "acceleration": {
    "backends": [
      "cpu"
    ],
    "require": "none",
    "cpu": {},
    "claim": {
      "resource_kind": "ram",
      "default_preferred_bytes": 134217728,
      "floor_bytes": 0,
      "default_priority": "service",
      "confidence": "estimated",
      "yield_when_idle": true,
      "idle_grace_seconds": 900,
      "profile": {
        "steps": [
          {
            "label": "model",
            "default_amount_bytes": 134217728
          },
          {
            "label": "regex-only",
            "default_amount_bytes": 0
          }
        ],
        "apply": {
          "verb": "capacity",
          "argv": [
            "degrade",
            "--to",
            "{label}"
          ]
        },
        "upshift": true
      }
    }
  },
  "companions": [
    {
      "name": "capacity-sync",
      "command": "resource-pii-detector",
      "args": [
        "capacity-sync"
      ]
    },
    {
      "name": "activity-edge",
      "command": "resource-pii-detector",
      "args": ["activity-edge"],
      "port": 11460,
      "required": true
    }
  ],
  "category": "ai",
  "requirements": {
    "ram_mb": 1024,
    "disk_mb": 1024,
    "cpu_cores": 2,
    "network": "optional",
    "bucket": "medium",
    "source": "estimated",
    "confidence": "low",
    "class": "ai",
    "weight": 2
  },
  "platforms": {
    "linux": "unsupported",
    "macos": "unsupported",
    "windows": "unsupported"
  },
  "ports": [
    {
      "name": "http",
      "container": 11460,
      "host": 11460
    },
    {
      "name": "upstream",
      "container": 21460,
      "host": 21460
    }
  ],
  "orchestration": {
    "startup_order": 567,
    "startup_timeout_seconds": 120,
    "startup_time_estimate": "warm start <5s (regex-only); model load adds seconds once the ONNX artifact is staged",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "PII_DETECTOR_HOST": "localhost"
    },
    "from_ports": {
      "PII_DETECTOR_PORT": "http"
    },
    "derived": {
      "PII_DETECTOR_URL": {
        "template": "http://${PII_DETECTOR_HOST}:${PII_DETECTOR_PORT}"
      },
      "PII_DETECTOR_BASE_URL": {
        "template": "${PII_DETECTOR_URL}"
      },
      "PII_DETECTOR_DETECT_ENDPOINT": {
        "template": "${PII_DETECTOR_URL}/detect"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "kind": "readiness",
      "target": "http://127.0.0.1:${RESOURCE_PORT_HTTP}/health",
      "interval_seconds": 10,
      "timeout_seconds": 10
    },
    {
      "type": "http",
      "target": "http://127.0.0.1:${RESOURCE_PORT_HTTP}/health",
      "kind": "liveness",
      "interval_seconds": 30,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true
  },
  "template_version": "2",
  "privilege": "user",
  "bundling": "host-required"
}
