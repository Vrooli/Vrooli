{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "twilio",
  "display_name": "Twilio",
  "description": "Hosted Twilio API resource with native credential/status checks and shell-retained messaging actions.",
  "cli": {
    "enabled": true,
    "command": "resource-twilio",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-twilio"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "endpoint": "https://api.twilio.com/2010-04-01/Accounts.json",
  "credentials": {
    "env": [
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN"
    ],
    "secret_ref": "secret/resources/twilio"
  },
  "orchestration": {
    "startup_order": 320,
    "startup_timeout_seconds": 10,
    "startup_time_estimate": "2-5s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "low"
  },
  "portability_tier": "full",
  "category": "communications",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "supported"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "https://api.twilio.com/2010-04-01/Accounts.json",
      "expected_status": [
        200,
        401,
        403
      ],
      "timeout_seconds": 15
    }
  ],
  "capabilities": {
    "supports_logs": false,
    "supports_content_ops": true
  },
  "template_version": "2"
}
