{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "codex",
  "display_name": "OpenAI Codex CLI",
  "description": "OpenAI Codex CLI for local code generation and agentic engineering workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-codex",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "codex",
  "version_args": [
    "--version"
  ],
  "portability_tier": "partial",
  "category": "developer-tooling",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "hostTools": [
    {
      "name": "yq",
      "required": false,
      "reason": "Inspect Codex YAML-backed test fixtures from retained resource unit-test workflows",
      "when": ["setup", "test"],
      "notes": "Codex resource unit checks degrade gracefully when yq is unavailable"
    }
  ],
  "health_checks": [
    {
      "type": "command",
      "command": [
        "codex",
        "--version"
      ],
      "timeout_seconds": 15
    }
  ],
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific Codex dependency settings.",
    "properties": {
      "api": {
        "type": "object",
        "additionalProperties": true
      },
      "model": {
        "type": "object",
        "additionalProperties": true
      },
      "storage": {
        "type": "object",
        "additionalProperties": true
      },
      "limits": {
        "type": "object",
        "additionalProperties": true
      },
      "features": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "environment_exports": {
    "static": {
      "CODEX_PATH": "codex"
    }
  },
  "orchestration": {
    "startup_order": 530,
    "startup_timeout_seconds": 20,
    "startup_time_estimate": "5-10s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "install": {
    "platforms": {
      "linux": [
        "npm",
        "install",
        "-g",
        "@openai/codex"
      ],
      "macos": [
        "npm",
        "install",
        "-g",
        "@openai/codex"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@openai/codex"
      ]
    }
  },
  "capabilities": {
    "supports_logs": false
  },
  "template_version": "2"
}
