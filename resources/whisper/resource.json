{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "whisper",
  "display_name": "Whisper",
  "description": "Managed Whisper speech-to-text service with native compose-backed lifecycle and shell-retained transcription workflows.",
  "cli": {
    "enabled": true,
    "command": "resource-whisper",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "resource-whisper"
    },
    "freshness": {
      "inputs": ["cli/**", "cli/internal/**", "docs/**", "README.md", "resource.json"]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "compose_file": "docker/docker-compose.yml",
  "runtime_env_command": {
    "command": "resource-whisper",
    "args": ["recommend-model", "--env", "--budget-pct", "50"],
    "timeout_seconds": 5
  },
  "gpu": {
    "probe": "nvidia",
    "compose_overlay": "docker/docker-compose.gpu.yml",
    "env_overrides": {
      "WHISPER_IMAGE": "onerahmet/openai-whisper-asr-webservice:latest-gpu"
    }
  },
  "capacity": {
    "resource_kind": "vram",
    "gpu_index": 0,
    "preferred_bytes": 8589934592,
    "floor_bytes": 2147483648,
    "priority": "interactive",
    "protected": true,
    "profile": {
      "steps": [
        { "label": "large-v3", "amount_bytes": 8589934592 },
        { "label": "medium", "amount_bytes": 4294967296 },
        { "label": "small", "amount_bytes": 2147483648 }
      ],
      "apply": { "verb": "capacity-degrade", "argv": ["--to", "{label}"] },
      "upshift": true
    }
  },
  "portability_tier": "partial",
  "category": "ai",
  "platforms": {
    "linux": "supported",
    "macos": "partial",
    "windows": "partial"
  },
  "hostTools": [
    {
      "name": "ffmpeg",
      "required": false,
      "reason": "Enable local audio format conversion before transcription when source media is not already Whisper-ready",
      "when": ["setup", "develop"],
      "notes": "Whisper can run without ffmpeg, but conversion workflows are limited"
    }
  ],
  "ports": [
    {
      "name": "http",
      "container": 9000,
      "host": 8090
    }
  ],
  "orchestration": {
    "startup_order": 550,
    "startup_timeout_seconds": 45,
    "startup_time_estimate": "15-30s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "environment_exports": {
    "static": {
      "WHISPER_HOST": "localhost"
    },
    "from_ports": {
      "WHISPER_PORT": "http"
    },
    "derived": {
      "WHISPER_URL": {
        "template": "http://${WHISPER_HOST}:${WHISPER_PORT}"
      },
      "WHISPER_BASE_URL": {
        "template": "${WHISPER_URL}"
      },
      "WHISPER_STT_URL": {
        "template": "${WHISPER_URL}"
      }
    }
  },
  "health_checks": [
    {
      "type": "http",
      "target": "http://127.0.0.1:8090/",
      "interval_seconds": 10,
      "timeout_seconds": 10
    }
  ],
  "capabilities": {
    "supports_logs": true,
    "supports_content_ops": true
  },
  "template_version": "2"
}
