{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vrooli.com/schemas/service.schema.json",
  "title": "Service Configuration Schema",
  "description": "Enhanced service configuration with resource auto-completion support",
  "type": "object",
  "properties": {
    "storage": {
      "$ref": "common.schema.json#/definitions/storageSurface",
      "description": "Portable declaration of the component's on-disk storage surface."
    },
    "retention": {
      "$ref": "common.schema.json#/definitions/retention",
      "description": "Declared storage ceilings for the runtime data this scenario accumulates. Enforced by packages/api-core/retention. Distinct from durable_data, which declares what to back up."
    },
    "$schema": {
      "type": "string",
      "description": "Schema reference"
    },
    "version": {
      "$ref": "common.schema.json#/definitions/semver"
    },
    "mode": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "default": "development",
      "description": "Operational mode for this scenario. 'development' enables dev-only surfaces (test-mode HTTP middleware, RoutingService for test-DB installation). 'production' disables them. Absent or unrecognized values default to 'development'."
    },
    "maturity": {
      "type": "string",
      "enum": [
        "greenfield",
        "pilot",
        "production",
        "sunset"
      ],
      "default": "greenfield",
      "description": "Lifecycle maturity / deploy stage of this scenario, independent of dev/prod 'mode'. 'greenfield' = not yet deployed, so no schema migrations are expected (migration debt is informational, not a failure); 'pilot' = limited live use; 'production' = serving real data (migration hygiene is enforced); 'sunset' = being retired. Consumed by storage-manager to derive storage_stage and gate migration findings. Absent or unrecognized values default to 'greenfield'."
    },
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "const": "vrooli"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Scenario classification (e.g., business-application, helper)"
        },
        "category": {
          "type": "string",
          "description": "High-level scenario category"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Free-form keywords for search and filtering"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true,
          "description": "Stable machine-readable capabilities exposed by this scenario; unlike free-form tags, these support declarative automation."
        },
        "platform_capabilities": {
          "type": "object",
          "description": "Per-host-OS support declarations for capabilities exposed by this service.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "linux": {"$ref": "#/definitions/platformCapability"},
              "macos": {"$ref": "#/definitions/platformCapability"},
              "windows": {"$ref": "#/definitions/platformCapability"}
            }
          }
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "repository": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "default": "git"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "directory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "license": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        },
        "support": {
          "type": "object",
          "properties": {
            "issues": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "system_required": {
          "type": "boolean",
          "default": false,
          "description": "When true, this scenario is part of Vrooli's own operation (e.g. vrooli-onboarding, secrets-manager). Onboarding renders system-required scenarios as enabled and not user-toggleable."
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "$ref": "#/definitions/generationMetadata"
    },
    "cli": {
      "$ref": "#/definitions/cliConfig"
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "env_var": {
            "type": "string"
          },
          "port": {
            "type": [
              "integer",
              "string"
            ]
          },
          "range": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Scenario and resource dependencies",
      "properties": {
        "resources": {
          "$ref": "resource-definitions.json#/resourceCatalog",
          "description": "Resource dependencies keyed by canonical resource identifier as a flat object map"
        },
        "scenarios": {
          "type": "object",
          "description": "Scenario dependencies keyed by canonical scenario identifier as a flat object map",
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "$ref": "#/definitions/scenarioDependency"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trust_signing": {
      "type": "object",
      "description": "Lifecycle-owned trust-signing dependency declaration. It contains only provider routing and credential-file metadata, never raw key material.",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "development",
            "vault-transit"
          ]
        },
        "resource": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "format": "uri"
        },
        "key_name": {
          "type": "string"
        },
        "credential_file": {
          "type": "string"
        },
        "operator_credential_file": {
          "type": "string"
        },
        "operator_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "operator_tls_cert_file": {
          "type": "string"
        },
        "operator_tls_key_file": {
          "type": "string"
        },
        "operator_tls_client_ca_file": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "description": "Scenario-scoped environment variables merged into every lifecycle step's environment. Values may reference declared port names and runtime paths with ${NAME}; internal/ports expands them before the step runs.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hostTools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "hostSafeguards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "runtime": {
      "type": "object",
      "description": "How this scenario or service is meant to be run. Declares the scenario's recommended runtime shape; per-install operator choices (whether to actually keep it running) live in operator-state.json.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "long_running",
            "on_demand",
            "one_shot"
          ],
          "default": "on_demand",
          "description": "'long_running' = process intended to stay up (e.g. an API server, a watcher); 'on_demand' = started when invoked and stopped when idle; 'one_shot' = runs to completion and exits (e.g. a migration tool)."
        },
        "auto_restart_default": {
          "type": "boolean",
          "default": false,
          "description": "Recommended default for the auto-heal toggle in onboarding. Operators can override per-install via operator-state.json. Typically true for long_running scenarios that are part of system operation; false for user applications the operator may prefer to start manually."
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "metadata_version": {
          "type": "integer",
          "minimum": 1
        },
        "tiers": {
          "type": "object",
          "properties": {
            "tier-1-local": {
              "$ref": "#/definitions/deploymentTier"
            },
            "tier-2-desktop": {
              "$ref": "#/definitions/deploymentTier"
            },
            "tier-3-mobile": {
              "$ref": "#/definitions/deploymentTier"
            },
            "tier-4-saas": {
              "$ref": "#/definitions/deploymentTier"
            },
            "tier-5-enterprise": {
              "$ref": "#/definitions/deploymentTier"
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "resources": {
              "$ref": "#/definitions/deploymentDependencyMap"
            },
            "scenarios": {
              "$ref": "#/definitions/deploymentDependencyMap"
            }
          },
          "additionalProperties": false
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/deploymentOverride"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "description": "Lifecycle phases. This schema governs both the root project manifest and scenario manifests, so it admits every phase name the runtime resolves in internal/lifecycle phaseFor. Which phases a given target kind may declare is a narrower policy question enforced by structure-health, not here: a scenario declaring `clean` is valid JSON against a real runtime phase and still a governance violation.",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "setup": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "develop": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "build": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "deploy": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "clean": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "test": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "backup": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "restore": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "production": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "stop": {
          "$ref": "#/definitions/lifecyclePhase"
        },
        "health": {
          "$ref": "#/definitions/healthPhase"
        }
      },
      "additionalProperties": false
    },
    "credentials": {
      "$ref": "common.schema.json#/definitions/credentials"
    },
    "integrations": {
      "type": "array",
      "description": "Declarative external integration requirements. Onboarding reports these requirements but does not create connections.",
      "items": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scopes": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "purpose": {"type": "string"},
          "required": {"type": "boolean", "default": false},
          "multi": {"type": "boolean", "default": false}
        },
        "required": ["connector"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "dependencies"
  ],
  "allOf": [
    {
      "properties": {
        "dependencies": {
          "anyOf": [
            {
              "required": [
                "resources"
              ]
            },
            {
              "required": [
                "scenarios"
              ]
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "platformCapability": {
      "type": "object",
      "required": ["status", "mechanism"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["supported", "partial", "unsupported"]},
        "mechanism": {"type": "string", "minLength": 1}
      }
    },
    "generationMetadata": {
      "type": "object",
      "description": "Durable provenance for scenarios generated from a template.",
      "properties": {
        "template": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "design": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "adapter": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "manifest_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the template manifest this scenario was generated from, used to detect template drift."
        },
        "content_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the generated content, used to detect local divergence from the template output."
        }
      },
      "required": [
        "template"
      ],
      "additionalProperties": false
    },
    "cliConfig": {
      "type": "object",
      "description": "Installed artifact contract for a scenario or resource CLI. Go-module installs produce a binary plus sibling manifest and build metadata files.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "adapter": {
          "$ref": "#/definitions/cliAdapter"
        },
        "artifacts": {
          "$ref": "#/definitions/cliArtifacts"
        },
        "distribution": {
          "$ref": "#/definitions/cliDistribution"
        },
        "source_build": {
          "$ref": "#/definitions/cliSourceBuild"
        },
        "invoke": {
          "$ref": "#/definitions/cliInvoke"
        },
        "freshness": {
          "$ref": "#/definitions/cliFreshness"
        }
      },
      "required": [
        "enabled"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "command",
              "adapter",
              "source_build",
              "invoke",
              "freshness"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "cliAdapter": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "go_module"
          ]
        },
        "module_dir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cliArtifacts": {
      "type": "object",
      "description": "Installed companion artifacts generated beside the CLI binary.",
      "properties": {
        "manifest": {
          "$ref": "#/definitions/cliArtifact"
        },
        "build_metadata": {
          "$ref": "#/definitions/cliArtifact"
        }
      },
      "additionalProperties": false
    },
    "cliArtifact": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "enum": [
            "sibling"
          ],
          "description": "Install the artifact beside the binary using the canonical cli-core naming convention."
        }
      },
      "additionalProperties": false
    },
    "cliDistribution": {
      "type": "object",
      "description": "A signed release artifact consumed by a deployment target; source installs are not target delivery.",
      "required": [
        "kind",
        "artifact_name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "prebuilt_artifact"
          ]
        },
        "artifact_name": {
          "type": "string",
          "pattern": "\\$\\{os\\}.*\\$\\{arch\\}|\\$\\{arch\\}.*\\$\\{os\\}",
          "description": "Platform artifact template, e.g. resource-example_${os}_${arch}."
        }
      },
      "additionalProperties": false
    },
    "cliSourceBuild": {
      "type": "object",
      "description": "Developer/release build inputs. This is never a desktop delivery mechanism.",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "go_module"
          ]
        }
      },
      "additionalProperties": false
    },
    "cliInvoke": {
      "type": "object",
      "description": "How the installed CLI is invoked after installation.",
      "required": [
        "kind",
        "command"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "installed_command"
          ]
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cliFreshness": {
      "type": "object",
      "description": "Source inputs used to determine whether the installed CLI artifact is stale and should be rebuilt.",
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "metadata_file": {
          "type": "string",
          "description": "Optional path to the installed build metadata file used by freshness checks."
        }
      },
      "additionalProperties": false
    },
    "hostRequirement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why this requirement is part of the project floor when required is true."
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        },
        "requires": {
          "type": "object",
          "description": "Hardware-capability gate evaluated against host inventory (GPU/VRAM/arch/RAM). When any condition is unmet the requirement is cleanly skipped (not applicable), never failed.",
          "additionalProperties": false,
          "properties": {
            "gpu": {
              "type": "boolean",
              "description": "Require (true) or forbid (false) a detected GPU"
            },
            "minVramGb": {
              "type": "number",
              "description": "Minimum total VRAM in GiB on at least one detected GPU"
            },
            "arch": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Allowed host architectures (Go GOARCH, e.g. amd64, arm64)"
            },
            "minRamGb": {
              "type": "number",
              "description": "Minimum total system RAM in GiB"
            }
          }
        }
      },
      "required": [
        "name",
        "required",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": ["required"]
          },
          "then": {
            "required": ["rationale"]
          }
        }
      ],
      "additionalProperties": false
    },
    "scenarioDependency": {
      "type": "object",
      "description": "Metadata describing a dependent scenario. `required` describes business importance, while `startup_policy` describes orchestration behavior.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this dependency participates in runtime orchestration. Disabled dependencies are skipped entirely."
        },
        "name": {
          "type": "string",
          "description": "Scenario identifier"
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Whether the dependency is semantically important for correct behavior. When `startup_policy` is omitted, required dependencies default to `must_start`."
        },
        "startup_policy": {
          "type": "string",
          "enum": [
            "must_start",
            "try_start",
            "ignore"
          ],
          "description": "How lifecycle orchestration should treat this dependency during startup. Defaults to `must_start` when `required=true`, otherwise `ignore`."
        },
        "freshness_policy": {
          "type": "string",
          "enum": [
            "restart_when_stale",
            "reuse_running",
            "rebuild_only"
          ],
          "description": "How lifecycle orchestration should treat this dependency when it is running and healthy but its sources have changed (stale). Orthogonal to `startup_policy`. Defaults to `restart_when_stale` (rebuild and restart, gated so a byte-identical rebuild does not restart). `reuse_running` keeps the running process untouched; `rebuild_only` rebuilds the artifact without restarting. Per-edge policy may only reduce disruption on a shared dependency, never increase it. Invalid on `ignore` edges."
        },
        "version": {
          "$ref": "common.schema.json#/definitions/semver",
          "description": "Exact scenario version required"
        },
        "versionRange": {
          "type": "string",
          "description": "Semantic version range that is acceptable"
        },
        "description": {
          "type": "string",
          "description": "Human-readable context for the dependency"
        },
        "runtime_only": {
          "type": "boolean",
          "default": false,
          "description": "Declare true only when this dependency is exercised exclusively through runtime orchestration or an external CLI/service boundary, so import-graph evidence is not expected. Requires runtime_only_rationale."
        },
        "runtime_only_rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete explanation of the runtime-only interaction and why source-level import evidence is intentionally absent."
        },
        "degraded_behavior": {
          "type": "string",
          "description": "Human explanation of the fallback behavior when this dependency is unavailable. Required for intentional degradation patterns such as `required=true` with `startup_policy=try_start`."
        },
        "config": {
          "type": "object",
          "description": "Dependency-specific configuration owned by the declaring scenario and the dependent scenario.",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_only": {
                "const": true
              }
            },
            "required": [
              "runtime_only"
            ]
          },
          "then": {
            "required": [
              "runtime_only_rationale"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "deploymentRequirements": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "ram_mb": {
          "type": "number",
          "minimum": 0
        },
        "disk_mb": {
          "type": "number",
          "minimum": 0
        },
        "cpu_cores": {
          "type": "number",
          "minimum": 0
        },
        "gpu": {
          "type": "object",
          "description": "Optional GPU requirement. An empty object requires a GPU; min_cuda_compute narrows the requirement.",
          "properties": {
            "min_cuda_compute": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "offline"
          ]
        },
        "storage_mb_per_user": {
