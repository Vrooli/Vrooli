{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vrooli.com/schemas/repo-contract.schema.json",
  "title": "Vrooli Repository Contract Schema",
  "description": "Language-agnostic contract for Vrooli's future-state repository structure",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "platform",
    "root",
    "layout",
    "scenario",
    "resource",
    "globs",
    "environment",
    "sandbox",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "schemas/repo-contract.schema.json",
      "description": "Schema reference"
    },
    "version": {
      "$ref": "common.schema.json#/definitions/semver"
    },
    "platform": {
      "type": "object",
      "required": ["mode", "legacy_project_bash_supported"],
      "properties": {
        "mode": {
          "type": "string",
          "const": "cross_platform_go_native"
        },
        "legacy_project_bash_supported": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "required": ["markers"],
      "properties": {
        "markers": {
          "type": "object",
          "required": ["required_dirs", "required_files"],
          "properties": {
            "required_dirs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/slashPath"
              }
            },
            "required_files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/slashPath"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "project_config_dir",
        "scenario_dir",
        "resource_dir",
        "template_dir",
        "package_dir",
        "command_dir",
        "internal_dir",
        "docs_dir"
      ],
      "properties": {
        "project_config_dir": { "$ref": "#/definitions/slashPath" },
        "scenario_dir": { "$ref": "#/definitions/slashPath" },
        "resource_dir": { "$ref": "#/definitions/slashPath" },
        "template_dir": { "$ref": "#/definitions/slashPath" },
        "package_dir": { "$ref": "#/definitions/slashPath" },
        "command_dir": { "$ref": "#/definitions/slashPath" },
        "internal_dir": { "$ref": "#/definitions/slashPath" },
        "docs_dir": { "$ref": "#/definitions/slashPath" }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["required_files", "well_known_paths"],
      "properties": {
        "required_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/slashPath" }
        },
        "well_known_paths": {
          "type": "object",
          "required": ["service", "docs", "docs_manifest", "requirements", "api", "ui", "cli", "cli_manifest", "initialization"],
          "properties": {
            "service": { "$ref": "#/definitions/slashPath" },
            "orientation": { "$ref": "#/definitions/slashPath" },
            "docs": { "$ref": "#/definitions/slashPath" },
            "docs_manifest": { "$ref": "#/definitions/slashPath" },
            "requirements": { "$ref": "#/definitions/slashPath" },
            "api": { "$ref": "#/definitions/slashPath" },
            "ui": { "$ref": "#/definitions/slashPath" },
            "cli": { "$ref": "#/definitions/slashPath" },
            "cli_manifest": { "$ref": "#/definitions/slashPath" },
            "initialization": { "$ref": "#/definitions/slashPath" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["manifest", "well_known_paths"],
      "properties": {
        "manifest": { "$ref": "#/definitions/slashPath" },
        "well_known_paths": {
          "type": "object",
          "required": ["docs", "initialization"],
          "properties": {
            "docs": { "$ref": "#/definitions/slashPath" },
            "initialization": { "$ref": "#/definitions/slashPath" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "globs": {
      "type": "object",
      "required": ["syntax", "root_relative", "case_sensitive", "allow_absolute", "path_format"],
      "properties": {
        "syntax": {
          "type": "string",
          "const": "doublestar"
        },
        "root_relative": {
          "type": "boolean",
          "const": true
        },
        "case_sensitive": {
          "type": "boolean",
          "const": true
        },
        "allow_absolute": {
          "type": "boolean",
          "const": false
        },
        "path_format": {
          "type": "string",
          "const": "slash_normalized"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "object",
          "required": ["repo_root", "source_root", "sandbox_id", "sandbox_merged", "sandbox_scope"],
          "properties": {
            "repo_root": { "$ref": "#/definitions/envVarName" },
            "source_root": { "$ref": "#/definitions/envVarName" },
            "sandbox_id": { "$ref": "#/definitions/envVarName" },
            "sandbox_merged": { "$ref": "#/definitions/envVarName" },
            "sandbox_scope": { "$ref": "#/definitions/envVarName" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "required": ["full_repo_scopes", "scenario_scope_prefix"],
      "properties": {
        "full_repo_scopes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scenario_scope_prefix": {
          "type": "string",
          "const": "scenarios/"
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "required": ["mini_vrooli_bundle"],
      "properties": {
        "mini_vrooli_bundle": {
          "$ref": "#/definitions/profile"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "slashPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "description": "Slash-normalized repository-relative path"
    },
    "slashGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "description": "Slash-normalized repository-relative glob"
    },
    "envVarName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "profile": {
      "type": "object",
      "required": ["description", "parameters", "include", "optional_include", "exclude"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\[\\*\\])?$"
          }
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/slashPath"
          }
        },
        "optional_include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/slashPath"
          }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/slashGlob"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
