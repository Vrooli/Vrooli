{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vrooli.com/schemas/resource.schema.json",
  "title": "Vrooli Resource Manifest",
  "description": "Manifest schema for Go-native resource control plane resources.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "driver",
    "portability_tier"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "driver": {
      "type": "string",
      "enum": [
        "docker-service",
        "compose-service",
        "external-cli",
        "cloud-api",
        "desktop-app",
        "manual"
      ]
    },
    "compose_file": {
      "type": "string"
    },
    "binary": {
      "type": "string"
    },
    "version_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "string"
    },
    "credentials": {
      "type": "object",
      "properties": {
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secret_ref": {
          "type": "string"
        }
      }
    },
    "portability_tier": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "platform-specific"
      ]
    },
    "category": {
      "type": "string"
    },
    "platforms": {
      "type": "object",
      "properties": {
        "linux": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        },
        "macos": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        },
        "windows": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hostTools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "hostSafeguards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "container": {
            "type": "integer",
            "minimum": 0
          },
          "host": {
            "type": "integer",
            "minimum": 0
          },
          "protocol": {
            "type": "string"
          }
        }
      }
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "http",
              "tcp",
              "command"
            ]
          },
          "target": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_status": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "install": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "container_name": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependency_schema": {
      "type": "object",
      "description": "Resource-specific schema fragment for scenario dependency declarations under dependencies.resources.<name>.",
      "additionalProperties": true
    },
    "environment_exports": {
      "type": "object",
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "from_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "from_runtime_env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "startup_order": {
          "type": "integer",
          "minimum": 0
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "startup_time_estimate": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_strategy": {
          "type": "string"
        },
        "recovery_wait_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "health_check_retries": {
          "type": "integer",
          "minimum": 0
        },
        "health_check_delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "template_version": {
      "type": "string"
    }
  },
  "definitions": {
    "hostRequirement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "required",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
