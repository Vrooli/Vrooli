{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vrooli.com/schemas/resource.schema.json",
  "title": "Vrooli Resource Manifest",
  "description": "Manifest schema for manifest-driven resource control plane resources.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "cli",
    "driver",
    "portability_tier",
    "deployment"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cli": {
      "$ref": "service.schema.json#/definitions/cliConfig",
      "description": "Installed artifact contract for the resource CLI, including build/install/invoke/freshness semantics."
    },
    "legacy_repo_data_allowed": {
      "type": "boolean",
      "description": "Temporary escape hatch for retained resources that still rely on repo-local data paths."
    },
    "durable_data": {
      "type": "object",
      "description": "Durable host-filesystem state this resource accumulates that is worth backing up (e.g. an external-cli coding agent's conversation history). HOST-FILESYSTEM ONLY: container/compose resources store volume data captured separately by data-backup-manager's live connectors and MUST NOT declare it here. Consumed by data-backup-manager discovery to surface one-click backup target suggestions; entry contents are never read.",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "description": "Host directory the entries are relative to. Supports a leading $HOME, ~, or %USERPROFILE% token (resolved to the operator's home directory). Defaults to $HOME when omitted. Slash-normalized."
        },
        "host_only": {
          "type": "boolean",
          "default": true,
          "description": "Always true today: durable_data describes host-filesystem state only. Reserved for a future non-host declaration kind."
        },
        "entries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "common.schema.json#/definitions/durableDataEntry" },
          "description": "Durable entries under base, keyed by stable logical name (the key becomes the suggested target name)."
        }
      }
    },
    "template": {
      "type": "string"
    },
    "driver": {
      "type": "string",
      "enum": [
        "docker-service",
        "compose-service",
        "external-cli",
        "cloud-api",
        "desktop-app",
        "manual",
        "native-cli"
      ]
    },
    "compose_file": {
      "type": "string"
    },
    "gpu": {
      "type": "object",
      "description": "Optional GPU probe; when probe succeeds, overlay compose file and env overrides are applied.",
      "properties": {
        "probe": {
          "type": "string",
          "enum": ["nvidia"]
        },
        "compose_overlay": {
          "type": "string",
          "description": "Path to an overlay compose file relative to the resource root (or absolute)."
        },
        "env_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["probe"],
      "additionalProperties": false
    },
    "binary": {
      "type": "string"
    },
    "version_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "string"
    },
    "credentials": {
      "type": "object",
      "description": "Declares the secrets this resource needs at runtime. Each entry in `env` is either a bare environment-variable name (legacy, minimal) or a secretDescriptor (preferred, surfaces label/description/obtain_url to onboarding). `secret_ref` is the canonical Vault path where the value is stored.",
      "properties": {
        "env": {
          "type": "array",
          "description": "Environment variables required at runtime. Strings are accepted for backward compatibility; objects supply the rich descriptor used by onboarding and admin UIs. Mix freely.",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "common.schema.json#/definitions/secretDescriptor" }
            ]
          }
        },
        "secret_ref": {
          "type": "string",
          "description": "Canonical Vault path where the secret values are stored (e.g. 'secret/vrooli/gemini')."
        }
      }
    },
    "portability_tier": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "platform-specific"
      ]
    },
    "category": {
      "type": "string"
    },
    "platforms": {
      "type": "object",
      "properties": {
        "linux": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        },
        "macos": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        },
        "windows": {
          "type": "string",
          "enum": [
            "supported",
            "partial",
            "unsupported"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hostTools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "hostSafeguards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostRequirement"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "host_ip": {
            "type": "string",
            "description": "Optional host interface address for Docker port publishing, rendered as host_ip:host:container. Leave empty to bind all interfaces."
          },
          "container": {
            "type": "integer",
            "minimum": 0
          },
          "host": {
            "type": "integer",
            "minimum": 0
          },
          "protocol": {
            "type": "string"
          }
        }
      }
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "http",
              "tcp",
              "command"
            ]
          },
          "target": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_status": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "install": {
      "type": "object"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "container_name": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_dir": {
          "type": "string"
        },
        "memory_limit": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[bBkKmMgG]?$",
          "description": "Optional cap passed verbatim as `docker run --memory <value>`. Format: positive integer optionally suffixed b/k/m/g (case-insensitive), e.g. \"12g\", \"8192m\", \"536870912\"."
        }
      }
    },
    "dependency_schema": {
      "type": "object",
      "description": "Resource-specific schema fragment for scenario dependency declarations under dependencies.resources.<name>.",
      "additionalProperties": true
    },
    "environment_exports": {
      "type": "object",
      "properties": {
        "static": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "from_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "from_runtime_env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "template": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "startup_order": {
          "type": "integer",
          "minimum": 0
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "startup_time_estimate": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_strategy": {
          "type": "string"
        },
        "recovery_wait_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "health_check_retries": {
          "type": "integer",
          "minimum": 0
        },
        "health_check_delay_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "template_version": {
      "type": "string"
    },
    "deployment": {
      "type": "object",
      "description": "Resource-owned deployment profiles. A supported claim requires declared target evidence and, for bundled modes, a prebuilt CLI artifact contract.",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/deploymentProfile" }
        }
      },
      "additionalProperties": false
    },
    "upstream_cli": {
      "type": "object",
      "description": "External CLI (e.g. claude, codex, opencode) this resource wraps. Records the pinned version and docs source so config adapters can detect upstream schema drift via `permissions doctor` / equivalent surfaces.",
      "additionalProperties": false,
      "required": ["version_command", "version_pinned", "docs_source", "docs_pinned_at", "schema_version"],
      "properties": {
        "version_command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "argv used to report the upstream CLI's version (e.g. [\"claude\", \"--version\"])."
        },
        "version_pinned": {
          "type": "string",
          "minLength": 1,
          "description": "Upstream CLI version the adapter was authored against. doctor warns when the installed version diverges."
        },
        "docs_source": {
          "type": "string",
          "format": "uri",
          "description": "Canonical upstream docs URL the adapter's config schema was derived from."
        },
        "docs_pinned_at": {
          "type": "string",
          "minLength": 1,
          "description": "Date the docs URL was last reviewed (ISO 8601 date)."
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Bumps when the adapter's on-disk state schema changes incompatibly."
        }
      }
    }
  },
  "definitions": {
    "deploymentProfile": {
      "type": "object",
      "required": ["linux", "macos", "windows"],
      "properties": {
        "linux": { "$ref": "#/definitions/deploymentTarget" },
        "macos": { "$ref": "#/definitions/deploymentTarget" },
        "windows": { "$ref": "#/definitions/deploymentTarget" }
      },
      "additionalProperties": false
    },
    "deploymentTarget": {
      "type": "object",
      "required": ["support", "mode"],
      "properties": {
        "support": { "type": "string", "enum": ["supported", "conditional", "degraded", "unsupported"] },
        "mode": { "type": "string", "enum": ["bundled-client", "native-host-tool", "docker-desktop", "remote-service", "manual"] },
        "architectures": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["amd64", "arm64"] } },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fallbacks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "support": { "const": "unsupported" } } }, "then": { "required": ["reason"] } },
        { "if": { "not": { "properties": { "support": { "const": "unsupported" } } } }, "then": { "required": ["architectures", "limitations", "evidence"] } }
      ],
      "additionalProperties": false
    },
    "hostRequirement": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "required",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
