{
  "$schema": "schemas/service.schema.json",
  "hostTools": [
    {
      "name": "git",
      "required": true,
      "reason": "Support repository bootstrap, source operations, and setup-time git configuration",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development",
        "production",
        "minimal"
      ],
      "notes": "Root-owned core tool"
    },
    {
      "name": "curl",
      "required": true,
      "reason": "Support HTTP-based bootstrap, diagnostics, and resource helper flows",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development",
        "production",
        "minimal"
      ],
      "notes": "Root-owned core tool"
    },
    {
      "name": "jq",
      "required": true,
      "reason": "Support JSON parsing. Commonly used by coding agents and scripts",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development",
        "production",
        "minimal"
      ],
      "notes": "Root-owned core tool"
    },
    {
      "name": "yq",
      "required": true,
      "reason": "Support YAML parsing. Commonly used by coding agents and scripts",
      "when": [
        "setup",
        "test"
      ],
      "environments": [
        "development",
        "production",
        "minimal"
      ],
      "notes": "Root-owned core tool"
    },
    {
      "name": "docker",
      "required": true,
      "reason": "Run containerized resources across setup modes",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development",
        "production",
        "minimal"
      ],
      "notes": "Root-owned core tool"
    },
    {
      "name": "go",
      "required": true,
      "reason": "Build and validate native Vrooli tooling during development setup",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development"
      ],
      "notes": "Root-owned development toolchain"
    },
    {
      "name": "node",
      "required": true,
      "reason": "Build and run JavaScript-based workspace tooling during development setup",
      "when": [
        "setup",
        "develop"
      ],
      "environments": [
        "development"
      ],
      "notes": "Root-owned development toolchain"
    },
    {
      "name": "python",
      "required": true,
      "reason": "Support repo validation helpers and Python-based flows during development setup",
      "when": [
        "setup"
      ],
      "environments": [
        "development"
      ],
      "notes": "Root-owned development helper runtime"
    }
  ],
  "hostSafeguards": [
    {
      "name": "remote_session_protection",
      "required": false,
      "reason": "Protect remote Linux GUI sessions when the deployment profile calls for it",
      "when": [
        "setup"
      ],
      "platforms": [
        "linux"
      ],
      "notes": "Native runtime applies managed Linux sysctl and systemd protections for remote sessions"
    }
  ],
  "dependencies": {
    "resources": {
      "browserless": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true
      },
      "claude-code": {
        "description": "Claude Code development assistant",
        "enabled": true,
        "required": true
      },
      "cloudflare-ai-gateway": {
        "enabled": true
      },
      "codex": {
        "description": "AI-powered code generation and completion via OpenAI GPT models",
        "enabled": true,
        "required": false
      },
      "comfyui": {
        "enabled": false,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        }
      },
      "gemini": {
        "description": "Google Gemini AI API integration",
        "enabled": true,
        "required": false
      },
      "home-assistant": {
        "config_dir": "~/.vrooli/home-assistant/config",
        "description": "Open source home automation platform for IoT device control and automation",
        "enabled": true,
        "required": false,
        "timezone": "America/New_York"
      },
      "judge0": {
        "description": "Code execution and testing platform",
        "enabled": true,
        "required": false
      },
      "k6": {
        "description": "Modern load testing tool with JavaScript scripting",
        "enabled": true,
        "health_check": {
          "command": "resource-k6 status --json",
          "interval": 30,
          "timeout": 10
        },
        "healthy": false
      },
      "kokoro": {
        "description": "Text-to-speech synthesis service",
        "enabled": true,
        "required": false
      },
      "litellm": {
        "enabled": true
      },
      "mail-in-a-box": {
        "enabled": true
      },
      "minio": {
        "description": "S3-compatible object storage service",
        "enabled": true,
        "required": false
      },
      "neo4j": {
        "description": "Native property graph database for knowledge graphs and recommendations",
        "docker_image": "neo4j:5.24.0",
        "enabled": true,
        "ports": {
          "bolt": 7687,
          "http": 7474
        },
        "required": false
      },
      "ollama": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true,
        "status": {
          "running": true
        }
      },
      "opencode": {
        "enabled": true
      },
      "openrouter": {
        "description": "Unified API to many model providers for AI access",
        "enabled": true,
        "required": false
      },
      "postgis": {
        "container_name": "postgis-main",
        "data_directory": "${HOME}/.vrooli/postgis",
        "description": "Spatial database extension for PostgreSQL - enables geographic queries and location-based analysis",
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": false,
        "version": "16-3.4"
      },
      "postgres": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true
      },
      "qdrant": {
        "container_name": "qdrant",
        "data_directory": "${HOME}/.qdrant/data",
        "description": "Vector database for embeddings and semantic search",
        "enabled": true,
        "last_updated": "2025-08-13 14:23:53",
        "required": true,
        "status": "installed",
        "version": "unknown"
      },
      "questdb": {
        "description": "High-performance time series database",
        "enabled": true,
        "required": false
      },
      "redis": {
        "description": "Event bus and caching layer",
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "instances": {
          "default": {
            "maxMemory": "2gb",
            "password": "",
            "persistence": "rdb",
            "port": 6380
          }
        },
        "required": true,
        "version": "7"
      },
      "sagemath": {
        "enabled": true
      },
      "searxng": {
        "description": "Privacy-respecting search engine",
        "enabled": true,
        "required": true
      },
      "twilio": {
        "credentials_file": "~/.vrooli/twilio-credentials.json",
        "data_dir": "~/.vrooli/twilio",
        "description": "SMS, voice, and messaging automation via Twilio API",
        "enabled": true,
        "required": false
      },
      "unstructured-io": {
        "description": "Document processing and parsing service",
        "enabled": true,
        "required": false
      },
      "vault": {
        "description": "Secrets management and secure storage",
        "enabled": true,
        "required": true
      },
      "whisper": {
        "description": "Speech-to-text processing service",
        "enabled": true,
        "required": false
      }
    }
  },
  "lifecycle": {
    "clean": {
      "description": "Clean build artifacts and dependencies",
      "steps": [
        {
          "description": "Remove build artifacts and dependencies",
          "name": "run-clean",
          "run": "rm -rf packages/*/dist packages/*/build packages/*/.next node_modules packages/*/node_modules || true"
        }
      ]
    },
    "version": "2.0.2"
  },
  "ports": {
    "api": {
      "description": "Vrooli unified API server for orchestration and resource management",
      "env_var": "VROOLI_API_PORT",
      "port": 8092
    }
  },
  "service": {
    "description": "Development environment for building and testing Vrooli scenarios - self-contained apps that extend the intelligence system",
    "displayName": "Vrooli Development Environment",
    "documentation": "./docs/README.md",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "license": "AGPL-3.0-only",
    "maintainers": [
      {
        "email": "team@vrooli.com",
        "name": "Vrooli Team",
        "url": "https://github.com/Vrooli"
      }
    ],
    "name": "vrooli-dev",
    "repository": {
      "directory": "/",
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli"
    },
    "support": {
      "email": "team@vrooli.com",
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "tags": [
      "development-environment",
      "infrastructure",
      "ai-platform",
      "agent-swarms",
      "recursive-improvement",
      "automation",
      "intelligence-system",
      "self-improving",
      "vrooli-core",
      "ecosystem-manager",
      "capability-builder",
      "semantic-search",
      "multi-resource"
    ],
    "version": "2.0.2"
  },
  "version": "2.0.2"
}