{
  "$schema": "schemas/service.schema.json",
  "dependencies": {
    "resources": {
      "browserless": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true
      },
      "claude-code": {
        "description": "Claude Code development assistant",
        "enabled": true,
        "required": true
      },
      "cloudflare-ai-gateway": {
        "enabled": true
      },
      "codex": {
        "description": "AI-powered code generation and completion via OpenAI GPT models",
        "enabled": true,
        "required": false
      },
      "comfyui": {
        "enabled": false,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        }
      },
      "eclipse-ditto": {
        "enabled": false
      },
      "gemini": {
        "description": "Google Gemini AI API integration",
        "enabled": true,
        "required": false
      },
      "home-assistant": {
        "config_dir": "~/.vrooli/home-assistant/config",
        "description": "Open source home automation platform for IoT device control and automation",
        "enabled": true,
        "required": false,
        "timezone": "America/New_York"
      },
      "judge0": {
        "description": "Code execution and testing platform",
        "enabled": true,
        "required": false
      },
      "k6": {
        "description": "Modern load testing tool with JavaScript scripting",
        "enabled": true,
        "health_check": {
          "command": "resource-k6 status --json",
          "interval": 30,
          "timeout": 10
        },
        "healthy": false
      },
      "kokoro": {
        "description": "Text-to-speech synthesis service",
        "enabled": true,
        "required": false
      },
      "litellm": {
        "enabled": true
      },
      "mail-in-a-box": {
        "enabled": true
      },
      "minio": {
        "description": "S3-compatible object storage service",
        "enabled": true,
        "required": false
      },
      "neo4j": {
        "description": "Native property graph database for knowledge graphs and recommendations",
        "docker_image": "neo4j:5.24.0",
        "enabled": true,
        "ports": {
          "bolt": 7687,
          "http": 7474
        },
        "required": false
      },
      "ollama": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true,
        "status": {
          "running": true
        }
      },
      "opencode": {
        "enabled": true
      },
      "openrouter": {
        "description": "Unified API to many model providers for AI access",
        "enabled": true,
        "required": false
      },
      "parlant": {
        "enabled": false
      },
      "postgis": {
        "container_name": "postgis-main",
        "data_directory": "${HOME}/.vrooli/postgis",
        "description": "Spatial database extension for PostgreSQL - enables geographic queries and location-based analysis",
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": false,
        "version": "16-3.4"
      },
      "postgres": {
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "required": true
      },
      "pybullet": {
        "enabled": false
      },
      "qdrant": {
        "container_name": "qdrant",
        "data_directory": "${HOME}/.qdrant/data",
        "description": "Vector database for embeddings and semantic search",
        "enabled": true,
        "last_updated": "2025-08-13 14:23:53",
        "required": true,
        "status": "installed",
        "version": "unknown"
      },
      "questdb": {
        "description": "High-performance time series database",
        "enabled": true,
        "required": false
      },
      "redis": {
        "description": "Event bus and caching layer",
        "enabled": true,
        "healthCheck": {
          "intervalMs": 60000,
          "timeoutMs": 5000
        },
        "instances": {
          "default": {
            "maxMemory": "2gb",
            "password": "",
            "persistence": "rdb",
            "port": 6380
          }
        },
        "required": true,
        "version": "7"
      },
      "restic": {
        "enabled": false
      },
      "ros2": {
        "enabled": false
      },
      "sagemath": {
        "enabled": true
      },
      "searxng": {
        "description": "Privacy-respecting search engine",
        "enabled": true,
        "required": true
      },
      "segment-anything": {
        "enabled": false
      },
      "simpy": {
        "data_dir": "~/.vrooli/simpy",
        "description": "Discrete event simulation framework for modeling complex systems",
        "enabled": false,
        "required": false
      },
      "sqlite": {
        "enabled": true
      },
      "step-ca": {
        "enabled": false
      },
      "su2": {
        "enabled": false
      },
      "terraform": {
        "enabled": false
      },
      "traccar": {
        "enabled": false
      },
      "twilio": {
        "credentials_file": "~/.vrooli/twilio-credentials.json",
        "data_dir": "~/.vrooli/twilio",
        "description": "SMS, voice, and messaging automation via Twilio API",
        "enabled": true,
        "required": false
      },
      "ultralytics-yolo": {
        "enabled": false
      },
      "unstructured-io": {
        "description": "Document processing and parsing service",
        "enabled": true,
        "required": false
      },
      "vault": {
        "description": "Secrets management and secure storage",
        "enabled": true,
        "required": true
      },
      "virustotal": {
        "enabled": false
      },
      "whisper": {
        "description": "Speech-to-text processing service",
        "enabled": true,
        "required": false
      },
      "wikijs": {
        "enabled": false
      },
      "wireguard": {
        "enabled": false
      },
      "zigbee2mqtt": {
        "enabled": false
      }
    }
  },
  "deployment": {
    "monitoring": {
      "enabled": true,
      "healthChecks": {
        "application": {
          "endpoint": "http://localhost:3000/api/health",
          "interval": "30s",
          "threshold": 3,
          "timeout": "5s",
          "type": "http"
        },
        "database": {
          "interval": "30s",
          "type": "tcp"
        },
        "redis": {
          "interval": "30s",
          "type": "tcp"
        }
      }
    },
    "strategy": "rolling-update",
    "target": "docker",
    "urls": {
      "api": "http://localhost:3000/api",
      "application": "http://localhost:3000",
      "health": "http://localhost:3000/api/health"
    }
  },
  "lifecycle": {
    "build": {
      "description": "Prepare build environment",
      "steps": [
        {
          "description": "Create build and dist directories",
          "name": "create-directories",
          "run": "mkdir -p build dist"
        },
        {
          "description": "Set build environment variables",
          "name": "set-build-env",
          "run": "export BUILD_TIME=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\" \u0026\u0026 export BUILD_ENV=\"${ENVIRONMENT:-development}\" \u0026\u0026 echo \"Build environment: $BUILD_ENV at $BUILD_TIME\""
        }
      ]
    },
    "clean": {
      "description": "Clean build artifacts and dependencies",
      "steps": [
        {
          "description": "Remove build artifacts and dependencies",
          "name": "run-clean",
          "run": "rm -rf packages/*/dist packages/*/build packages/*/.next node_modules packages/*/node_modules || true"
        }
      ]
    },
    "deploy": {
      "description": "Deployment preparation",
      "steps": [
        {
          "description": "Deployment information",
          "name": "show-deploy-info",
          "run": "echo 'Scenarios should be deployed individually from their directories'"
        }
      ]
    },
    "develop": {
      "description": "Prepare development environment",
      "steps": [
        {
          "description": "Load environment variables from .env if exists",
          "name": "load-env",
          "run": "if [[ -f .env ]]; then echo 'Loading .env file' \u0026\u0026 set -a \u0026\u0026 source .env \u0026\u0026 set +a; else echo 'No .env file found'; fi"
        },
        {
          "description": "Start the Vrooli unified API server with built-in scenario management",
          "name": "start-api",
          "run": "if [[ -f api/start.sh ]]; then mkdir -p .vrooli/logs \u0026\u0026 log_file=.vrooli/logs/vrooli-api.log \u0026\u0026 (APP_ROOT=$(pwd) VROOLI_ROOT=$(pwd) VROOLI_API_PORT=${VROOLI_API_PORT:-8092} api/start.sh \u0026\u003e \"$log_file\" \u0026) \u0026\u0026 api_healthy=false \u0026\u0026 for attempt in $(seq 1 30); do if curl -fsS \"http://127.0.0.1:${VROOLI_API_PORT:-8092}/health\" \u003e/dev/null; then api_healthy=true; break; fi; sleep 1; done \u0026\u0026 if [[ \"$api_healthy\" == true ]]; then echo \"🚀 Vrooli API healthy on port ${VROOLI_API_PORT:-8092} with native scenario management\"; else echo \"❌ Vrooli API failed health check on port ${VROOLI_API_PORT:-8092}\"; tail -n 20 \"$log_file\"; exit 1; fi; else echo '⚠️  API not found'; exit 1; fi"
        },
        {
          "background": false,
          "description": "Start orchestrator after API is ready",
          "name": "start-orchestrator",
          "run": "sleep 5 \u0026\u0026 echo '🎬 Starting orchestrator...' \u0026\u0026 vrooli scenario start vrooli-orchestrator"
        }
      ]
    },
    "setup": {
      "condition": {
        "checks": [
          {
            "path": "data",
            "type": "data"
          }
        ]
      },
      "description": "Initialize system for scenario development",
      "steps": [
        {
          "description": "Execute generic setup (e.g. network, system, git)",
          "name": "base-setup",
          "run": "VROOLI_SETUP_MODE=true bash scripts/lib/setup.sh",
          "timeout": "15m"
        },
        {
          "description": "Install Vrooli CLI command",
          "name": "install-cli",
          "run": "if command -v make \u003e/dev/null 2\u003e\u00261 \u0026\u0026 [[ -f Makefile ]]; then make install; else echo '⚠️  make or Makefile not found, skipping CLI install'; fi"
        },
        {
          "description": "Add app data to resources (skipped during setup)",
          "name": "add-data",
          "run": "echo '[INFO] Skipping resource population during setup - resources are ready for manual population when needed'"
        }
      ]
    },
    "version": "2.0.2"
  },
  "ports": {
    "api": {
      "description": "Vrooli unified API server for orchestration and resource management",
      "env_var": "VROOLI_API_PORT",
      "port": 8092
    },
    "health": {
      "description": "Health check and monitoring endpoint",
      "env_var": "HEALTH_PORT",
      "port": 3001
    },
    "orchestrator": {
      "description": "Scenario orchestrator API for managing running scenarios",
      "env_var": "ORCHESTRATOR_PORT",
      "port": 9500
    }
  },
  "service": {
    "description": "Development environment for building and testing Vrooli scenarios - self-contained apps that extend the intelligence system",
    "displayName": "Vrooli Development Environment",
    "documentation": "./docs/README.md",
    "homepage": "https://github.com/Vrooli/Vrooli",
    "license": "AGPL-3.0-only",
    "maintainers": [
      {
        "email": "team@vrooli.com",
        "name": "Vrooli Team",
        "url": "https://github.com/Vrooli"
      }
    ],
    "name": "vrooli-dev",
    "repository": {
      "directory": "/",
      "type": "git",
      "url": "https://github.com/Vrooli/Vrooli"
    },
    "support": {
      "email": "team@vrooli.com",
      "issues": "https://github.com/Vrooli/Vrooli/issues"
    },
    "tags": [
      "development-environment",
      "infrastructure",
      "ai-platform",
      "agent-swarms",
      "recursive-improvement",
      "automation",
      "intelligence-system",
      "self-improving",
      "vrooli-core",
      "ecosystem-manager",
      "capability-builder",
      "semantic-search",
      "multi-resource"
    ],
    "version": "2.0.2"
  },
  "version": "2.0.2"
}
