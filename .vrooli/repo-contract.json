{
  "$schema": "schemas/repo-contract.schema.json",
  "version": "1.2.0",
  "platform": {
    "mode": "cross_platform_go_native",
    "legacy_project_bash_supported": false,
    "platform_conformance_gate": "vrooli capability conformance"
  },
  "root": {
    "markers": {
      "required_dirs": [
        ".vrooli",
        "templates",
        "scenarios",
        "resources",
        "packages",
        "cmd",
        "internal"
      ],
      "required_files": [
        "go.mod"
      ]
    }
  },
  "layout": {
    "project_config_dir": ".vrooli",
    "scenario_dir": "scenarios",
    "resource_dir": "resources",
    "template_dir": "templates",
    "package_dir": "packages",
    "command_dir": "cmd",
    "internal_dir": "internal",
    "docs_dir": "docs",
    "project_config_allowlist": [
      "build",
      "agent-manager",
      "apply-runs",
      "audit",
      "bin",
      "dependencies",
      "generated",
      "capability-vocabulary.json",
      "operator-state.json",
      "repo-contract.json",
      "resources",
      "schemas",
      "service.json",
      "test-companions.json"
    ]
  },
  "targets": {
    "kinds": {
      "scenario": { "roots": ["scenarios/*"], "marker": ".vrooli/service.json" },
      "resource": { "roots": ["resources/*"], "marker": "resource.json" },
      "tool": { "roots": ["internal/tools/*"], "marker": "tool.json" },
      "safeguard": { "roots": ["internal/safeguards/*"], "marker": "safeguard.json" },
      "team": { "roots": ["docs/*"], "marker": "manifest.json" },
      "package": { "roots": ["packages/*"] },
      "control-plane": { "roots": ["cmd", "internal"], "exclude": ["internal/tools/*", "internal/safeguards/*"] },
      "docs": { "roots": ["docs"], "exclude": ["docs/*/manifest.json"] },
      "project": { "roots": ["."], "marker": ".vrooli/repo-contract.json" }
    }
  },
  "runtime_home": {
    "dir_name": ".vrooli",
    "env_overrides": [],
    "entries": {
      "plans": { "path": "plans", "kind": "dir", "regenerable": false, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "state": { "path": "state", "kind": "dir", "regenerable": false, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "config": { "path": "config", "kind": "dir", "regenerable": false, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "data": { "path": "data", "kind": "dir", "regenerable": false, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "runtime_db": { "path": "state/runtime.db", "kind": "file", "regenerable": false, "format": "sqlite", "owner": "control_plane", "protected": true, "cleanup": "never" },
      "secrets": { "path": "secrets.json", "kind": "file", "regenerable": false, "format": "json", "sensitive": true, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "secrets_enc": { "path": "secrets.enc.json", "kind": "file", "regenerable": false, "format": "json", "sensitive": true, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "bin": { "path": "bin", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "30d", "max_bytes": "10GiB", "keep_count": 3, "protect_active": true } },
      "cache": { "path": "cache", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "30d", "max_bytes": "10GiB", "keep_count": 3, "protect_active": true } },
      "logs": { "path": "logs", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "30d", "max_bytes": "10GiB", "keep_count": 3, "protect_active": true } },
      "metrics": { "path": "metrics", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "30d", "max_bytes": "10GiB", "keep_count": 3, "protect_active": true } },
      "processes": { "path": "processes", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "7d", "keep_count": 3, "protect_active": true } },
      "build": { "path": "build", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "14d", "max_bytes": "20GiB", "keep_count": 3, "protect_active": true } },
      "test_runs": { "path": "test-runs", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "30d", "max_bytes": "20GiB", "keep_count": 10, "protect_active": true } },
      "backups": { "path": "backups", "kind": "dir", "regenerable": false, "owner": "control_plane", "protected": true, "cleanup": "never" },
      "artifacts": { "path": "artifacts", "kind": "dir", "regenerable": true, "owner": "control_plane", "cleanup": "storage_manager", "retention": { "max_age": "90d", "max_bytes": "50GiB", "keep_count": 10, "protect_active": true } }
    },
    "scoped": {
      "scenario_secrets": "scenarios/{scenario}/secrets.json",
      "project_state": "state/projects/{project_key}"
    }
  },
  "scenario": {
    "required_files": [
      ".vrooli/service.json"
    ],
    "well_known_paths": {
      "service": ".vrooli/service.json",
      "orientation": ".vrooli/orientation.json",
      "docs": "docs",
      "docs_manifest": "docs/manifest.json",
      "requirements": "requirements",
      "api": "api",
      "ui": "ui",
      "cli": "cli",
      "cli_manifest": "cli/manifest.json"
    }
  },
  "resource": {
    "manifest": "resource.json",
    "well_known_paths": {
      "docs": "docs"
    }
  },
  "globs": {
    "syntax": "doublestar",
    "root_relative": true,
    "case_sensitive": true,
    "allow_absolute": false,
    "path_format": "slash_normalized"
  },
  "environment": {
    "variables": {
      "repo_root": "VROOLI_ROOT",
      "source_root": "VROOLI_SOURCE_ROOT",
      "sandbox_id": "VROOLI_SANDBOX_ID",
      "sandbox_merged": "VROOLI_SANDBOX_MERGED",
      "sandbox_scope": "VROOLI_SANDBOX_SCOPE"
    }
  },
  "sandbox": {
    "full_repo_scopes": [
      "",
      ".",
      "/"
    ],
    "scenario_scope_prefix": "scenarios/"
  },
  "profiles": {
    "mini_vrooli_bundle": {
      "description": "Repo-aware bundle profile for shipping a target scenario with shared Go-native platform code and selected resources.",
      "parameters": [
        "scenario",
        "resources[*]"
      ],
      "include": [
        ".vrooli",
        "cmd",
        "internal",
        "packages",
        "scenarios/{scenario}",
        "resources/{resources[*]}"
      ],
      "optional_include": [
        "docs",
        "go.mod",
        "go.sum",
        "go.work",
        "go.work.sum",
        "Makefile",
        "README.md",
        "LICENSE"
      ],
      "exclude": [
        ".git/**",
        "**/.git/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/data/**",
        ".vrooli/secrets.json",
        "**/.vrooli/secrets.json",
        "cli/**"
      ]
    }
  }
}
