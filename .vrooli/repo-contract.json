{
  "$schema": "schemas/repo-contract.schema.json",
  "version": "1.1.0",
  "platform": {
    "mode": "cross_platform_go_native",
    "legacy_project_bash_supported": false
  },
  "root": {
    "markers": {
      "required_dirs": [
        ".vrooli",
        "templates",
        "scenarios",
        "resources",
        "packages",
        "cmd",
        "internal"
      ],
      "required_files": [
        "go.mod"
      ]
    }
  },
  "layout": {
    "project_config_dir": ".vrooli",
    "scenario_dir": "scenarios",
    "resource_dir": "resources",
    "template_dir": "templates",
    "package_dir": "packages",
    "command_dir": "cmd",
    "internal_dir": "internal",
    "docs_dir": "docs"
  },
  "runtime_home": {
    "dir_name": ".vrooli",
    "env_overrides": [],
    "entries": {
      "plans": { "path": "plans", "kind": "dir", "regenerable": false },
      "state": { "path": "state", "kind": "dir", "regenerable": false },
      "config": { "path": "config", "kind": "dir", "regenerable": false },
      "data": { "path": "data", "kind": "dir", "regenerable": false },
      "runtime_db": { "path": "state/runtime.db", "kind": "file", "regenerable": false, "format": "sqlite" },
      "secrets": { "path": "secrets.json", "kind": "file", "regenerable": false, "format": "json", "sensitive": true },
      "secrets_enc": { "path": "secrets.enc.json", "kind": "file", "regenerable": false, "format": "json", "sensitive": true },
      "bin": { "path": "bin", "kind": "dir", "regenerable": true },
      "cache": { "path": "cache", "kind": "dir", "regenerable": true },
      "logs": { "path": "logs", "kind": "dir", "regenerable": true },
      "metrics": { "path": "metrics", "kind": "dir", "regenerable": true },
      "processes": { "path": "processes", "kind": "dir", "regenerable": true },
      "build": { "path": "build", "kind": "dir", "regenerable": true }
    },
    "scoped": {
      "scenario_secrets": "scenarios/{scenario}/secrets.json",
      "project_state": "state/projects/{project_key}"
    }
  },
  "scenario": {
    "required_files": [
      ".vrooli/service.json"
    ],
    "well_known_paths": {
      "service": ".vrooli/service.json",
      "orientation": ".vrooli/orientation.json",
      "docs": "docs",
      "docs_manifest": "docs/manifest.json",
      "requirements": "requirements",
      "api": "api",
      "ui": "ui",
      "cli": "cli",
      "cli_manifest": "cli/manifest.json",
      "initialization": "initialization"
    }
  },
  "resource": {
    "manifest": "resource.json",
    "well_known_paths": {
      "docs": "docs",
      "initialization": "initialization"
    }
  },
  "globs": {
    "syntax": "doublestar",
    "root_relative": true,
    "case_sensitive": true,
    "allow_absolute": false,
    "path_format": "slash_normalized"
  },
  "environment": {
    "variables": {
      "repo_root": "VROOLI_ROOT",
      "source_root": "VROOLI_SOURCE_ROOT",
      "sandbox_id": "VROOLI_SANDBOX_ID",
      "sandbox_merged": "VROOLI_SANDBOX_MERGED",
      "sandbox_scope": "VROOLI_SANDBOX_SCOPE"
    }
  },
  "sandbox": {
    "full_repo_scopes": [
      "",
      ".",
      "/"
    ],
    "scenario_scope_prefix": "scenarios/"
  },
  "profiles": {
    "mini_vrooli_bundle": {
      "description": "Repo-aware bundle profile for shipping a target scenario with shared Go-native platform code and selected resources.",
      "parameters": [
        "scenario",
        "resources[*]"
      ],
      "include": [
        ".vrooli",
        "cmd",
        "internal",
        "packages",
        "scenarios/{scenario}",
        "resources/{resources[*]}"
      ],
      "optional_include": [
        "docs",
        "go.mod",
        "go.sum",
        "go.work",
        "go.work.sum",
        "Makefile",
        "README.md",
        "LICENSE"
      ],
      "exclude": [
        ".git/**",
        "**/.git/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/data/**",
        ".vrooli/secrets.json",
        "**/.vrooli/secrets.json",
        "cli/**",
        "scripts/lib/**",
        "scripts/manage.sh"
      ]
    }
  }
}
