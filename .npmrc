# Workspace settings: keep scenario installs isolated from workspace linking/lockfiles.
link-workspace-packages=false
shared-workspace-lockfile=false

# Hoist ESLint/Prettier tooling so plugins/resolvers are discoverable.
# Using *eslint* (not eslint*) also matches scoped packages like @eslint/*.
# Keep consistent with existing node_modules/.modules.yaml to avoid PNPM_PUBLIC_HOIST_PATTERN_DIFF.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
