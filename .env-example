# Optional root environment overlay for Vrooli.
#
# This file is intentionally minimal.
# Current setup does NOT require a root .env file.
# The preferred configuration path is manifest-backed:
#   - .vrooli/service.json
#   - scenarios/<name>/.vrooli/service.json
#   - ~/.vrooli/service.json
#
# If you create a root .env, `vrooli develop` will load it when present.
# Leave it absent unless you intentionally need a repo-wide override.
#
# Example optional overrides:
#
# Load secrets from file or Vault-backed flow
# SECRETS_SOURCE=file
# SECRETS_SOURCE=vault
#
# Vault connection settings, if you explicitly choose Vault env overrides
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
#
# One-shot onboarding opt-out for future first-run UX flow
# VROOLI_SKIP_ONBOARDING=1
