{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "{{RESOURCE_CLI_COMMAND}}_${os}_${arch}"
    },
    "source_build": {
      "kind": "go_module"
    },
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "manual-resource",
  "driver": "manual",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": {
          "support": "conditional",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "manual operator setup"
          ],
          "limitations": [
            "Vrooli does not own lifecycle for this resource."
          ],
          "evidence": [
            "manifest-validation",
            "operator-checklist"
          ]
        },
        "macos": {
          "support": "conditional",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "manual operator setup"
          ],
          "limitations": [
            "Vrooli does not own lifecycle for this resource."
          ],
          "evidence": [
            "manifest-validation",
            "operator-checklist"
          ]
        },
        "windows": {
          "support": "conditional",
          "mode": "manual",
          "architectures": [
            "amd64",
            "arm64"
          ],
          "requires": [
            "manual operator setup"
          ],
          "limitations": [
            "Vrooli does not own lifecycle for this resource."
          ],
          "evidence": [
            "manifest-validation",
            "operator-checklist"
          ]
        }
      }
    }
  },
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "manual",
    "dependencies": [],
    "recovery_attempts": 0,
    "priority": "medium"
  },
  "manual_steps_required": true,
  "validation": [
    "document me"
  ],
  "template_version": "2"
}
