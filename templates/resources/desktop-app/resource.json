{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "{{RESOURCE_CLI_COMMAND}}_${os}_${arch}"
    },
    "source_build": { "kind": "go_module", "freshness_inputs": ["cli/**", "resource.json"] },
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "desktop-app",
  "driver": "desktop-app",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": { "support": "conditional", "mode": "native-host-tool", "architectures": ["amd64", "arm64"], "requires": ["{{RESOURCE_NAME}} host application"], "limitations": ["The host application installation and permissions are externally managed."], "evidence": ["manifest-validation", "host-tool-preflight"] },
        "macos": { "support": "conditional", "mode": "native-host-tool", "architectures": ["amd64", "arm64"], "requires": ["{{RESOURCE_NAME}} host application"], "limitations": ["The host application installation and permissions are externally managed."], "evidence": ["manifest-validation", "host-tool-preflight"] },
        "windows": { "support": "conditional", "mode": "native-host-tool", "architectures": ["amd64", "arm64"], "requires": ["{{RESOURCE_NAME}} host application"], "limitations": ["The host application installation and permissions are externally managed."], "evidence": ["manifest-validation", "host-tool-preflight"] }
      }
    }
  },
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "platforms": {
    "linux": "partial",
    "macos": "partial",
    "windows": "partial"
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "manual",
    "dependencies": [],
    "recovery_attempts": 0,
    "priority": "medium"
  },
  "detection": {
    "linux": "",
    "macos": "",
    "windows": ""
  },
  "template_version": "2"
}
