{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "desktop-app",
  "driver": "desktop-app",
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "platforms": {
    "linux": "partial",
    "macos": "partial",
    "windows": "partial"
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "manual",
    "dependencies": [],
    "recovery_attempts": 0,
    "priority": "medium"
  },
  "detection": {
    "linux": "",
    "macos": "",
    "windows": ""
  },
  "template_version": "2"
}
