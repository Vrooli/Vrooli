{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "{{RESOURCE_CLI_COMMAND}}_${os}_${arch}"
    },
    "source_build": { "kind": "go_module", "freshness_inputs": ["cli/**", "resource.json"] },
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "native-cli",
  "driver": "native-cli",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": { "support": "supported", "mode": "bundled-service", "architectures": ["amd64", "arm64"], "limitations": ["Only declared capabilities are included in the bundle."], "evidence": ["manifest-validation", "artifact-checksum", "target-smoke"] },
        "macos": { "support": "supported", "mode": "bundled-service", "architectures": ["amd64", "arm64"], "limitations": ["Only declared capabilities are included in the bundle."], "evidence": ["manifest-validation", "artifact-checksum", "target-smoke"] },
        "windows": { "support": "supported", "mode": "bundled-service", "architectures": ["amd64", "arm64"], "limitations": ["Only declared capabilities are included in the bundle."], "evidence": ["manifest-validation", "artifact-checksum", "target-smoke"] }
      }
    }
  },
  "binary": "{{RESOURCE_CLI_COMMAND}}",
  "version_args": [
    "info"
  ],
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "1-3s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "install": {
    "platforms": {
      "linux": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ],
      "macos": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ],
      "windows": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ]
    }
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "{{RESOURCE_CLI_COMMAND}}",
        "info"
      ]
    }
  ],
  "template_version": "2"
}
