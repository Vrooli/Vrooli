{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "compose.yaml",
        "resource.json"
      ]
    }
  },
  "template": "compose-service",
  "driver": "compose-service",
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "dependencies": [],
  "compose_file": "compose.yaml",
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 30,
    "startup_time_estimate": "5-15s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "docker",
        "compose",
        "ps",
        "--status",
        "running"
      ]
    }
  ],
  "template_version": "2"
}
