{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "artifacts": {
      "manifest": {
        "location": "sibling"
      },
      "build_metadata": {
        "location": "sibling"
      }
    },
    "distribution": {
      "kind": "prebuilt_artifact",
      "artifact_name": "{{RESOURCE_CLI_COMMAND}}_${os}_${arch}"
    },
    "source_build": { "kind": "go_module", "freshness_inputs": ["cli/**", "resource.json"] },
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "cli/internal/**",
        "docs/**",
        "README.md",
        "resource.json"
      ]
    }
  },
  "template": "cloud-api",
  "driver": "cloud-api",
  "deployment": {
    "profiles": {
      "desktop": {
        "linux": { "support": "conditional", "mode": "bundled-client", "architectures": ["amd64", "arm64"], "requires": ["network", "resource credentials"], "limitations": ["No offline capability; provider availability and account policy apply."], "evidence": ["manifest-validation", "resource-cli-unit-tests"] },
        "macos": { "support": "conditional", "mode": "bundled-client", "architectures": ["amd64", "arm64"], "requires": ["network", "resource credentials"], "limitations": ["No offline capability; provider availability and account policy apply."], "evidence": ["manifest-validation", "resource-cli-unit-tests"] },
        "windows": { "support": "conditional", "mode": "bundled-client", "architectures": ["amd64", "arm64"], "requires": ["network", "resource credentials"], "limitations": ["No offline capability; provider availability and account policy apply."], "evidence": ["manifest-validation", "resource-cli-unit-tests"] }
      }
    }
  },
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "endpoint": "{{RESOURCE_ENDPOINT}}",
  "credentials": {
    "env": [
      "{{RESOURCE_CREDENTIAL_ENV}}"
    ],
    "secret_ref": "replace/me"
  },
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "{{RESOURCE_ENDPOINT}}",
      "expected_status": [
        200,
        400,
        401,
        403
      ]
    }
  ],
  "template_version": "2"
}
