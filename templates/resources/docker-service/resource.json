{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "template": "docker-service",
  "driver": "docker-service",
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "platforms": {
    "linux": "supported",
    "macos": "supported",
    "windows": "partial"
  },
  "dependencies": [],
  "ports": [
    {
      "name": "service",
      "container": 0,
      "host": 0
    }
  ],
  "health_checks": [
    {
      "type": "tcp",
      "target": "127.0.0.1:0",
      "interval_seconds": 10
    }
  ],
  "runtime": {
    "image": "replace/me:latest",
    "container_name": "vrooli-{{RESOURCE_NAME}}",
    "env": {},
    "volumes": [
      {
        "source": "./data",
        "target": "/var/lib/{{RESOURCE_NAME}}"
      }
    ]
  },
  "environment_exports": {
    "static": {
      "{{RESOURCE_ENV_PREFIX}}_HOST": "localhost"
    },
    "from_ports": {
      "{{RESOURCE_ENV_PREFIX}}_PORT": "service"
    },
    "from_runtime_env": [],
    "derived": {
      "{{RESOURCE_ENV_PREFIX}}_URL": {
        "template": "http://${{RESOURCE_ENV_PREFIX}}_HOST:${{RESOURCE_ENV_PREFIX}}_PORT"
      }
    }
  },
  "lifecycle": {
    "start_timeout_seconds": 30,
    "stop_timeout_seconds": 30,
    "retries": 2
  }
}
