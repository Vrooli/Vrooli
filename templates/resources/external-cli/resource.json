{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "cli": {
    "enabled": true,
    "command": "{{RESOURCE_CLI_COMMAND}}",
    "adapter": {
      "kind": "go_module",
      "module_dir": "cli"
    },
    "install": [
      {
        "os": ["linux", "darwin"],
        "kind": "command",
        "run": "bash ./cli/install.sh"
      },
      {
        "os": ["windows"],
        "kind": "command",
        "run": "powershell -ExecutionPolicy Bypass -File .\\cli\\install.ps1"
      }
    ],
    "invoke": {
      "kind": "installed_command",
      "command": "{{RESOURCE_CLI_COMMAND}}"
    },
    "freshness": {
      "inputs": [
        "cli/**",
        "resource.json"
      ]
    }
  },
  "template": "external-cli",
  "driver": "external-cli",
  "binary": "{{RESOURCE_BINARY}}",
  "version_args": [
    "--version"
  ],
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "dependency_schema": {
    "type": "object",
    "description": "Scenario-specific dependency settings for {{RESOURCE_NAME}}.",
    "properties": {},
    "additionalProperties": false
  },
  "orchestration": {
    "startup_order": 500,
    "startup_timeout_seconds": 15,
    "startup_time_estimate": "3-8s",
    "dependencies": [],
    "recovery_attempts": 2,
    "priority": "medium"
  },
  "install": {
    "platforms": {
      "linux": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ],
      "macos": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ],
      "windows": [
        "echo",
        "Document installation steps for {{RESOURCE_NAME}}"
      ]
    }
  },
  "health_checks": [
    {
      "type": "command",
      "command": [
        "{{RESOURCE_BINARY}}",
        "--version"
      ]
    }
  ],
  "template_version": "2"
}
