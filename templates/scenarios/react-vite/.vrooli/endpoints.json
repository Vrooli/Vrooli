{
  "$schema": "../../../../scripts/scenarios/schemas/endpoints.schema.json",
  "version": "1.0.0",
  "endpoints": [
    {
      "id": "health",
      "path": "/health",
      "method": "GET",
      "summary": "Service health check",
      "description": "Returns API readiness plus dependency status (also mounted at /api/v1/health for client callers).",
      "category": "system",
      "response": {
        "type": "object",
        "properties": {
          "status": "string",
          "readiness": "boolean",
          "dependencies": "object"
        }
      },
      "examples": [
        {
          "name": "Check health",
          "curl": "curl http://localhost:${API_PORT}/health"
        }
      ],
      "cli_mapping": {
        "command": "{{SCENARIO_ID}} status"
      }
    },
    {
      "id": "notes_list",
      "path": "/api/v1/notes",
      "method": "GET",
      "summary": "List notes",
      "description": "Returns up to 100 notes ordered newest-first by created_at. The wire envelope is the proto-generated ListNotesResponse; an empty list serialises to {} (proto3 default-omission).",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "notes": "array<Note>"
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "List notes",
          "curl": "curl http://localhost:${API_PORT}/api/v1/notes"
        }
      ],
      "cli_mapping": {
        "command": "{{SCENARIO_ID}} notes list"
      }
    },
    {
      "id": "notes_create",
      "path": "/api/v1/notes",
      "method": "POST",
      "summary": "Create a note",
      "description": "Persists a new note. Title is required (validated after whitespace trim by notes.Service); body is optional.",
      "category": "notes",
      "request": {
        "type": "object",
        "properties": {
          "title": "string (required, non-whitespace)",
          "body": "string"
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "invalid_request",
          "description": "Missing or whitespace-only title; malformed JSON; unknown fields rejected by DisallowUnknownFields"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository write failure"
        }
      ],
      "examples": [
        {
          "name": "Create note",
          "curl": "curl -X POST http://localhost:${API_PORT}/api/v1/notes -H 'Content-Type: application/json' -d '{\"title\":\"first\",\"body\":\"hello\"}'"
        }
      ],
      "cli_mapping": {
        "command": "{{SCENARIO_ID}} notes create",
        "args": ["--title", "<title>", "--body", "<body>"]
      }
    },
    {
      "id": "notes_get",
      "path": "/api/v1/notes/{id}",
      "method": "GET",
      "summary": "Get a note by id",
      "description": "Returns the note matching the path id, or a typed not_found envelope.",
      "category": "notes",
      "response": {
        "type": "object",
        "properties": {
          "note": "Note"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "not_found",
          "description": "No note with that id exists"
        },
        {
          "status": 500,
          "code": "internal",
          "description": "Repository read failure"
        }
      ],
      "examples": [
        {
          "name": "Get note",
          "curl": "curl http://localhost:${API_PORT}/api/v1/notes/abc123"
        }
      ],
      "cli_mapping": {
        "command": "{{SCENARIO_ID}} notes get",
        "args": ["<id>"]
      }
    }
  ],
  "cli_commands": [
    {
      "name": "status",
      "description": "Check API and dependency health (auto-provided by cli-core's StandardScenarioApp)",
      "endpoint_id": "health"
    },
    {
      "name": "notes list",
      "description": "List all notes (newest-first, default limit 100)",
      "endpoint_id": "notes_list"
    },
    {
      "name": "notes create",
      "description": "Create a note (--title TITLE [--body BODY])",
      "endpoint_id": "notes_create"
    },
    {
      "name": "notes get",
      "description": "Get a note by id",
      "endpoint_id": "notes_get"
    }
  ]
}
