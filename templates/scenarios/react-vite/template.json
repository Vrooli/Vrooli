{
  "name": "react-vite",
  "displayName": "React + Vite Scenario",
  "description": "Full-stack React/TypeScript UI with Go API, CLI, lifecycle metadata, and requirements seed.",
  "stack": [
    "react",
    "vite",
    "typescript",
    "go",
    "cli"
  ],
  "startDocument": "docs/START-HERE.md",
  "requiredVars": {
    "SCENARIO_ID": {
      "flag": "id",
      "description": "Scenario slug used for folder names, binaries, CLI binary, and module paths"
    },
    "SCENARIO_DISPLAY_NAME": {
      "flag": "display-name",
      "description": "Human-friendly name shown in dashboards and UI shells"
    },
    "SCENARIO_DESCRIPTION": {
      "flag": "description",
      "description": "One-sentence summary that appears in service.json and status output"
    }
  },
  "optionalVars": {
    "SCENARIO_CATEGORY": {
      "flag": "category",
      "description": "Service category used in service.json",
      "default": "ai_tools"
    },
    "AUTHOR": {
      "flag": "author",
      "description": "Initial progress log author",
      "default": "Generator Agent"
    },
    "DATE": {
      "flag": "date",
      "description": "Initial progress log date",
      "default": "{{CURRENT_DATE}}"
    }
  },
  "docs": {
    "generatorGuide": "docs/scenarios/getting-started.md",
    "requirementsGuide": "docs/testing/guides/requirement-tracking-quick-start.md",
    "templateGuide": "templates/scenarios/react-vite/README.md"
  },
  "copyExcludes": [
    "docs/internal/TEMPLATE-GENERATION-CONTRACT.md",
    "docs/internal/TEMPLATE-MAINTENANCE.md"
  ],
  "postHooks": [
    {
      "description": "Install UI dependencies (corepack pnpm install --ignore-workspace)",
      "cmd": "corepack pnpm install --ignore-workspace",
      "cwd": "ui"
    },
    {
      "description": "Sync Go modules (go mod tidy)",
      "cmd": "GOWORK=off go mod tidy",
      "cwd": "api"
    },
    {
      "description": "Format API Go sources (golangci-lint --fix)",
      "cmd": "golangci-lint run --fix ./...",
      "cwd": "api"
    },
    {
      "description": "Format CLI Go sources (gofumpt)",
      "cmd": "gofumpt -w .",
      "cwd": "cli"
    }
  ],
  "relocations": [
    {
      "description": "Relocate proto schemas to packages/proto/ and run codegen",
      "from": "proto/",
      "to": "packages/proto/schemas/{{SCENARIO_ID}}/",
      "post": [
        {
          "description": "Regenerate proto artifacts (Go + TypeScript + Python)",
          "cmd": "make generate",
          "cwd": "packages/proto"
        }
      ]
    }
  ]
}
