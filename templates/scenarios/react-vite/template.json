{
  "name": "react-vite",
  "displayName": "React + Vite Scenario",
  "description": "Full-stack React/TypeScript UI with Go API, CLI, lifecycle metadata, and requirements seed.",
  "stack": [
    "react",
    "vite",
    "typescript",
    "go",
    "cli"
  ],
  "version": "1.0.0",
  "startDocument": "docs/START-HERE.md",
  "design": {
    "adapter": "react-vite-tailwind",
    "default": "vrooli-default",
    "required": true
  },
  "orientation": {
    "version": "1.0.0",
    "copyTo": ".vrooli/orientation.json",
    "startDocument": "docs/START-HERE.md",
    "finalize": {
      "cleanup": [
        ".vrooli/orientation.json"
      ],
      "message": "Initialization complete; use normal scenario lifecycle commands."
    },
    "steps": [
      {
        "id": "scaffold-health",
        "title": "Scaffold health",
        "description": "Confirm the generated scaffold starts from a passing baseline before product work expands.",
        "docs": [
          "docs/START-HERE.md",
          "docs/internal/TESTING.md"
        ],
        "checks": [
          {
            "kind": "command",
            "run": "make test",
            "timeout": "15m"
          }
        ]
      },
      {
        "id": "charter",
        "title": "Scenario charter",
        "description": "Replace the seeded PRD placeholders with scenario-specific users, value promise, operational targets, dependencies, and UX direction.",
        "docs": [
          "docs/START-HERE.md",
          "PRD.md"
        ],
        "checks": [
          {
            "kind": "file_exists",
            "path": "PRD.md"
          },
          {
            "kind": "text_absent",
            "path": "PRD.md",
            "text": "[Summarize the permanent capability this scenario adds]"
          },
          {
            "kind": "text_absent",
            "path": "PRD.md",
            "text": "[Outcome title]"
          }
        ]
      },
      {
        "id": "requirements-registry",
        "title": "Requirements registry",
        "description": "Replace the starter requirements registry with scenario-specific modules generated from the PRD.",
        "docs": [
          "docs/START-HERE.md",
          "requirements/README.md",
          "requirements/index.json"
        ],
        "checks": [
          {
            "kind": "json_path_exists",
            "path": "requirements/index.json",
            "query": "imports"
          },
          {
            "kind": "text_absent",
            "path": "requirements/index.json",
            "text": "01-foundation/module.json"
          }
        ]
      },
      {
        "id": "domain-map",
        "title": "Domain map",
        "description": "Record real bounded contexts before expanding implementation.",
        "docs": [
          "docs/START-HERE.md",
          "docs/concepts/ARCHITECTURE.md"
        ],
        "checks": [
          {
            "kind": "file_exists",
            "path": "docs/concepts/DOMAINS.md"
          }
        ]
      },
      {
        "id": "dependency-decisions",
        "title": "Dependency decisions",
        "description": "Confirm resource and scenario dependencies are intentional and documented.",
        "docs": [
          "docs/START-HERE.md",
          "docs/concepts/ARCHITECTURE.md",
          ".vrooli/service.json"
        ],
        "checks": [
          {
            "kind": "file_exists",
            "path": ".vrooli/service.json"
          },
          {
            "kind": "json_path_exists",
            "path": ".vrooli/service.json",
            "query": "dependencies.resources"
          }
        ]
      },
      {
        "id": "design-language",
        "title": "Design language",
        "description": "Confirm the generated scenario has a root design contract before UI work expands.",
        "docs": [
          "docs/START-HERE.md",
          "DESIGN.md"
        ],
        "checks": [
          {
            "kind": "file_exists",
            "path": "DESIGN.md"
          }
        ]
      },
      {
        "id": "first-real-vertical-slice",
        "title": "First real vertical slice",
        "description": "Build and validate one real scenario domain beside the example before removing the example domain.",
        "docs": [
          "docs/START-HERE.md",
          "docs/concepts/ARCHITECTURE.md",
          "docs/internal/SEAMS.md"
        ],
        "required": false,
        "checks": [
          {
            "kind": "file_exists",
            "path": "docs/concepts/DOMAINS.md"
          }
        ]
      },
      {
        "id": "example-domain-removed",
        "title": "Example domain removed",
        "description": "Remove the notes and attachment reference domain after a real replacement domain is green.",
        "docs": [
          "docs/START-HERE.md",
          "docs/concepts/ARCHITECTURE.md"
        ],
        "checks": [
          {
            "kind": "glob_absent",
            "pattern": "api/internal/notes*"
          },
          {
            "kind": "glob_absent",
            "pattern": "api/handlers/notes*"
          },
          {
            "kind": "glob_absent",
            "pattern": "cli/domains/notes*"
          },
          {
            "kind": "glob_absent",
            "pattern": "ui/src/features/notes*"
          },
          {
            "kind": "file_absent",
            "path": "ui/src/api/notes.ts"
          }
        ]
      },
      {
        "id": "progress-handoff",
        "title": "Progress handoff",
        "description": "Leave durable progress and problem notes for future agents.",
        "docs": [
          "docs/START-HERE.md",
          "docs/internal/PROGRESS.md",
          "docs/internal/PROBLEMS.md"
        ],
        "checks": [
          {
            "kind": "file_exists",
            "path": "docs/internal/PROGRESS.md"
          },
          {
            "kind": "file_exists",
            "path": "docs/internal/PROBLEMS.md"
          }
        ]
      }
    ]
  },
  "requiredVars": {
    "SCENARIO_ID": {
      "flag": "id",
      "description": "Scenario slug used for folder names, binaries, CLI binary, and module paths"
    },
    "SCENARIO_DISPLAY_NAME": {
      "flag": "display-name",
      "description": "Human-friendly name shown in dashboards and UI shells"
    },
    "SCENARIO_DESCRIPTION": {
      "flag": "description",
      "description": "One-sentence summary that appears in service.json and status output"
    }
  },
  "optionalVars": {
    "SCENARIO_CATEGORY": {
      "flag": "category",
      "description": "Service category used in service.json",
      "default": "ai_tools"
    },
    "AUTHOR": {
      "flag": "author",
      "description": "Initial progress log author",
      "default": "Generator Agent"
    },
    "DATE": {
      "flag": "date",
      "description": "Initial progress log date",
      "default": "{{CURRENT_DATE}}"
    }
  },
  "docs": {
    "designGuide": "docs/design/README.md",
    "generatedDesignContract": "DESIGN.md",
    "generatorGuide": "docs/scenarios/getting-started.md",
    "requirementsGuide": "scenarios/test-genie/docs/phases/business/requirements-sync.md",
    "templateGuide": "templates/scenarios/react-vite/README.md"
  },
  "copyExcludes": [
    "CHANGELOG.md",
    "docs/internal/TEMPLATE-GENERATION-CONTRACT.md",
    "docs/internal/TEMPLATE-MAINTENANCE.md"
  ],
  "postHooks": [
    {
      "description": "Install UI dependencies (corepack pnpm install --ignore-workspace)",
      "cmd": "corepack pnpm install --ignore-workspace",
      "cwd": "ui"
    },
    {
      "description": "Sync Go modules (go mod tidy)",
      "cmd": "GOWORK=off go mod tidy",
      "cwd": "api"
    },
    {
      "description": "Format API Go sources (golangci-lint --fix)",
      "cmd": "golangci-lint run --fix ./...",
      "cwd": "api"
    },
    {
      "description": "Format CLI Go sources (gofumpt)",
      "cmd": "gofumpt -w .",
      "cwd": "cli"
    }
  ],
  "relocations": [
    {
      "description": "Relocate proto schemas to packages/proto/ and run codegen",
      "from": "proto/",
      "to": "packages/proto/schemas/{{SCENARIO_ID}}/",
      "post": [
        {
          "description": "Regenerate proto artifacts (Go + TypeScript + Python)",
          "cmd": "make generate",
          "cwd": "packages/proto"
        }
      ]
    }
  ]
}
