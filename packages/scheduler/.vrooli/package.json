{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "scheduler",
    "display_name": "github.com/vrooli/scheduler",
    "description": "Shared scheduling and interval utilities for Vrooli services.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/scheduler"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "scenario_test", "internal_platform"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {"strategy": "restart_running_consumers", "restart_running_consumers": true},
    "docs": ["docs/package-governance.md"]
  }
}
