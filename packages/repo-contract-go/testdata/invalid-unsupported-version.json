{
  "$schema": "schemas/repo-contract.schema.json",
  "version": "2.0.0",
  "platform": {
    "mode": "cross_platform_go_native",
    "legacy_project_bash_supported": false
  },
  "root": {
    "markers": {
      "required_dirs": [".vrooli", "templates", "scenarios", "resources", "packages", "cmd", "internal"],
      "required_files": ["go.mod"]
    }
  },
  "layout": {
    "project_config_dir": ".vrooli",
    "scenario_dir": "scenarios",
    "resource_dir": "resources",
    "template_dir": "templates",
    "package_dir": "packages",
    "command_dir": "cmd",
    "internal_dir": "internal",
    "docs_dir": "docs"
  },
  "scenario": {
    "required_files": [".vrooli/service.json"],
    "well_known_paths": {
      "service": ".vrooli/service.json",
      "docs": "docs",
      "requirements": "requirements",
      "api": "api",
      "ui": "ui",
      "cli": "cli"
    }
  },
  "resource": {
    "manifest": "resource.json",
    "well_known_paths": {
      "docs": "docs"
    }
  },
  "globs": {
    "syntax": "doublestar",
    "root_relative": true,
    "case_sensitive": true,
    "allow_absolute": false,
    "path_format": "slash_normalized"
  },
  "environment": {
    "variables": {
      "repo_root": "VROOLI_ROOT",
      "source_root": "VROOLI_SOURCE_ROOT",
      "sandbox_id": "VROOLI_SANDBOX_ID",
      "sandbox_merged": "VROOLI_SANDBOX_MERGED",
      "sandbox_scope": "VROOLI_SANDBOX_SCOPE"
    }
  },
  "sandbox": {
    "full_repo_scopes": ["", ".", "/"],
    "scenario_scope_prefix": "scenarios/"
  },
  "profiles": {
    "mini_vrooli_bundle": {
      "description": "test",
      "parameters": ["scenario", "resources[*]"],
      "include": ["packages", "scenarios/{scenario}"],
      "optional_include": ["go.mod"],
      "exclude": ["**/coverage/**"]
    }
  }
}
