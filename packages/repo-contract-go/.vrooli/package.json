{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "repo-contract-go",
    "display_name": "github.com/vrooli/repo-contract-go",
    "description": "Internal repo-contract adapter and path resolution helpers.",
    "kind": "schema_or_contract",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/repo-contract-go"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "template_api", "template_cli", "resource_runtime", "internal_platform"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "none",
      "restart_running_consumers": false
    },
    "docs": ["docs/repo-contract.md", "docs/package-governance.md"]
  }
}
