{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vrooli.local/schemas/experience-batch.v1.schema.json",
  "title": "Experience telemetry batch",
  "type": "object",
  "required": ["v", "sessionId", "events"],
  "properties": {
    "v": { "const": 1 },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" },
    "build": { "type": "string", "maxLength": 128 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["type", "ts"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
          "ts": { "type": "number" },
          "seq": { "type": "number" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
