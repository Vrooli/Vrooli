{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "api-base",
    "display_name": "@vrooli/api-base",
    "description": "Shared browser and server API resolution runtime for scenario UIs.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": ["@vrooli/api-base"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_ui", "template_ui"],
      "adoption_modes": ["file_dependency"]
    },
    "lifecycle": {
    "build": [
      {
        "name": "install",
        "run": ["pnpm", "install", "--frozen-lockfile", "--ignore-workspace"],
        "outputs": ["node_modules/.modules.yaml"]
      },
      {
        "name": "build",
          "run": ["pnpm", "build"],
          "outputs": ["dist/**"]
        }
      ]
    },
    "refresh": {
      "strategy": "scenario_setup",
      "restart_running_consumers": true
    },
    "docs": ["packages/api-base/README.md", "docs/package-governance.md"]
  }
}
