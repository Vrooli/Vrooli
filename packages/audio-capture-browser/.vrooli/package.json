{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "audio-capture-browser",
    "display_name": "@vrooli/audio-capture-browser",
    "description": "Governed browser audio protocol client stewarded by audio-tools; audio-tools owns the wire contract this package implements.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": ["@vrooli/audio-capture-browser"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_ui"],
      "adoption_modes": ["file_dependency"]
    },
    "lifecycle": {
    "build": [
      {
        "name": "install",
        "run": ["pnpm", "install", "--frozen-lockfile", "--ignore-workspace"],
        "outputs": ["node_modules/.modules.yaml"]
      },
      {
        "name": "build",
          "run": ["pnpm", "build"],
          "outputs": ["dist/**"]
        }
      ],
      "test": [
        {
          "name": "test",
          "run": ["pnpm", "test"]
        }
      ]
    },
    "refresh": {
      "strategy": "scenario_setup",
      "restart_running_consumers": true
    },
    "docs": ["packages/audio-capture-browser/README.md"]
  }
}
