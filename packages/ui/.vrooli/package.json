{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "ui",
    "display_name": "@vrooli/ui",
    "description": "Provider-neutral browser auth-status display contract for gated scenario UIs; source-only TypeScript.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": [
      "@vrooli/ui"
    ],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": [
        "scenario_ui",
        "template_ui"
      ],
      "adoption_modes": [
        "file_dependency"
      ]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "scenario_setup",
      "restart_running_consumers": false
    },
    "docs": [
      "packages/ui/README.md",
      "docs/package-governance.md"
    ]
  }
}
