{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "flow-runtime",
    "display_name": "@vrooli/flow-runtime",
    "description": "TypeScript runtime helpers for flow execution and verification.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": ["@vrooli/flow-runtime"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_ui", "scenario_api"],
      "adoption_modes": ["file_dependency"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "restart_running_consumers",
      "restart_running_consumers": true
    }
  }
}
