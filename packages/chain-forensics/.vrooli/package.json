{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "chain-forensics",
    "display_name": "github.com/vrooli/chain-forensics",
    "description": "Transport-independent chain evidence contract: exact atomic quantities, occurrence identities, provenance, typed evidence grades, and strict case validation.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/chain-forensics"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "scenario_test"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "none",
      "restart_running_consumers": false
    },
    "docs": ["packages/chain-forensics/README.md", "docs/package-governance.md"]
  }
}
