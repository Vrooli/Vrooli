{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "vitest-requirement-reporter",
    "display_name": "@vrooli/vitest-requirement-reporter",
    "description": "Shared Vitest requirement-reporting plugin for scenario tests.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": ["@vrooli/vitest-requirement-reporter"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_ui", "scenario_test", "template_ui"],
      "adoption_modes": ["file_dependency"]
    },
    "lifecycle": {
      "build": [
        {
          "name": "build",
          "run": ["pnpm", "build"]
        }
      ]
    },
    "refresh": {
      "strategy": "scenario_setup",
      "restart_running_consumers": false
    },
    "docs": ["packages/vitest-requirement-reporter/README.md", "docs/package-governance.md"]
  }
}
