{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "api-core",
    "display_name": "github.com/vrooli/api-core",
    "description": "Go runtime helpers for scenario APIs and shared server plumbing.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/api-core"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "scenario_test", "template_api", "template_cli"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "restart_running_consumers",
      "restart_running_consumers": true
    },
    "docs": ["packages/api-core/README.md", "docs/package-governance.md"]
  }
}
