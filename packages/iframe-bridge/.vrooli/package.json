{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "iframe-bridge",
    "display_name": "@vrooli/iframe-bridge",
    "description": "Shared iframe and spatial-navigation runtime for scenario UIs.",
    "kind": "js_runtime",
    "language": "typescript",
    "module_identifiers": ["@vrooli/iframe-bridge"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_ui", "template_ui"],
      "adoption_modes": ["file_dependency"]
    },
    "lifecycle": {
      "build": [
        {
          "name": "build",
          "run": ["pnpm", "build"]
        }
      ]
    },
    "refresh": {
      "strategy": "scenario_setup",
      "restart_running_consumers": true
    },
    "docs": ["packages/iframe-bridge/README.md", "docs/package-governance.md"]
  }
}
