{
  "name": "@vrooli/iframe-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./child": {
      "import": "./dist/iframeBridgeChild.js",
      "types": "./dist/iframeBridgeChild.d.ts"
    },
    "./shortcut-intent": {
      "import": "./dist/shortcutIntent.js",
      "types": "./dist/shortcutIntent.d.ts"
    },
    "./storage-shim": {
      "import": "./dist/storageShim.js",
      "types": "./dist/storageShim.d.ts"
    },
    "./spatial": {
      "import": "./dist/spatialNavBridge.js",
      "types": "./dist/spatialNavBridge.d.ts"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
