{
  "name": "@vrooli/iframe-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./child": {
      "import": "./dist/iframeBridgeChild.js",
      "types": "./dist/iframeBridgeChild.d.ts"
    },
    "./spatial": {
      "import": "./dist/spatialNavBridge.js",
      "types": "./dist/spatialNavBridge.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
