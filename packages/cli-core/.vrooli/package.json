{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "cli-core",
    "display_name": "github.com/vrooli/cli-core",
    "description": "Go CLI helpers for scenario CLIs and repo-aware command behavior.",
    "kind": "go_cli",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/cli-core"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "template_api", "template_cli"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "rebuild_cli_consumers",
      "restart_running_consumers": false
    },
    "docs": ["packages/cli-core/README.md", "docs/package-governance.md"]
  }
}
