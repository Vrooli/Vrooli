{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "agentbrief-go",
    "display_name": "github.com/vrooli/agentbrief-go",
    "description": "Leaf library for bounded, provenance-marked Vrooli context briefs.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/agentbrief-go"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {"strategy": "restart_running_consumers", "restart_running_consumers": true},
    "docs": ["packages/agentbrief-go/README.md"]
  }
}
