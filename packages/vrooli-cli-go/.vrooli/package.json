{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "vrooli-cli-go",
    "display_name": "github.com/vrooli/vrooli-cli-go",
    "description": "Typed Go client for the vrooli control-plane CLI.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/vrooli-cli-go"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {"strategy": "none", "restart_running_consumers": false},
    "docs": ["packages/vrooli-cli-go/README.md"]
  }
}
