{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "binaryfetch",
    "display_name": "github.com/vrooli/binaryfetch",
    "description": "Governed Go package owned by the Vrooli repository.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/binaryfetch"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "scenario_test", "template_api", "template_cli"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "none",
      "restart_running_consumers": false
    },
    "docs": ["packages/binaryfetch/README.md", "docs/package-governance.md"]
  }
}
