{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "scenarioconfig-go",
    "display_name": "github.com/vrooli/scenarioconfig-go",
    "description": "Schema-backed typed scenario settings.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": ["github.com/vrooli/scenarioconfig-go"],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": ["scenario_api", "scenario_cli", "scenario_test"],
      "adoption_modes": ["go_module_replace"]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "restart_running_consumers",
      "restart_running_consumers": true
    },
    "docs": ["docs/configuration/scenarios.md"]
  }
}
