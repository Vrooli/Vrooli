{
  "$schema": "schemas/package.schema.json",
  "version": "1.0.0",
  "package": {
    "name": "capabilityprobe",
    "display_name": "github.com/vrooli/vrooli/packages/capabilityprobe",
    "description": "Standalone host capability probes, cross-compilable for every supported OS and architecture.",
    "kind": "go_runtime",
    "language": "go",
    "module_identifiers": [
      "github.com/vrooli/vrooli/packages/capabilityprobe"
    ],
    "adoption": {
      "scenario_adoptable": true,
      "allowed_consumers": [
        "scenario_api"
      ],
      "adoption_modes": [
        "go_module_replace"
      ]
    },
    "lifecycle": {},
    "refresh": {
      "strategy": "none",
      "restart_running_consumers": false
    },
    "docs": [
      "packages/capabilityprobe/README.md",
      "docs/package-governance.md"
    ]
  }
}
