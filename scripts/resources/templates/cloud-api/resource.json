{
  "$schema": "../../.vrooli/schemas/resource.schema.json",
  "name": "{{RESOURCE_NAME}}",
  "display_name": "{{RESOURCE_DISPLAY_NAME}}",
  "description": "{{RESOURCE_DESCRIPTION}}",
  "template": "cloud-api",
  "driver": "cloud-api",
  "portability_tier": "{{RESOURCE_PORTABILITY_TIER}}",
  "category": "{{RESOURCE_CATEGORY}}",
  "endpoint": "{{RESOURCE_ENDPOINT}}",
  "credentials": {
    "env": [
      "{{RESOURCE_CREDENTIAL_ENV}}"
    ],
    "secret_ref": "replace/me"
  },
  "health_checks": [
    {
      "type": "http",
      "target": "{{RESOURCE_ENDPOINT}}",
      "expected_status": [
        200,
        400,
        401,
        403
      ]
    }
  ]
}
