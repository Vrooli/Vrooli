{
  "version": "1.0.0",
  "title": "Monetization Plan of Record",
  "description": "Plan-of-record manifest for the monetization team canon",
  "contract": {
    "kind": "team-plan-of-record",
    "schema": "team-plan-of-record/v1",
    "base": "docs/agent-system/team-plan-of-record.manifest.json",
    "team": "monetization"
  },
  "sections": [
    {
      "id": "entrypoint",
      "path": ".",
      "documents": [
        {
          "path": "README.md",
          "docType": "por-readme",
          "required": true,
          "validation": {
            "requiredHeadings": ["Start here for agents", "Folder map", "Organizing principle", "Editing rules", "Cross-references", "Future PoR work"]
          }
        }
      ]
    },
    {
      "id": "operating",
      "path": "operating/",
      "documents": [
        {
          "path": "README.md",
          "docType": "operating-hub",
          "required": true,
          "validation": {
            "requiredHeadings": ["Operating Documents", "Validation"]
          }
        },
        {
          "path": "OPERATING_MODEL.md",
          "docType": "operating-model",
          "required": true
        }
      ]
    },
    {
      "id": "taxonomies",
      "path": "taxonomies/",
      "packages": [
        {
          "id": "monetization-opportunity",
          "path": "monetization-opportunity/",
          "packageType": "taxonomy",
          "requiredFiles": ["README.md", "taxonomy.json"]
        },
        {
          "id": "monetization-validation",
          "path": "monetization-validation/",
          "packageType": "taxonomy",
          "requiredFiles": ["README.md", "taxonomy.json"]
        }
      ]
    },
    {
      "id": "catalogs",
      "path": "catalogs/",
      "documents": [
        {
          "path": "README.md",
          "docType": "catalogs-hub",
          "required": true
        },
        {
          "path": "CATALOG.md",
          "docType": "sku-catalog",
          "required": true
        },
        {
          "path": "scenario-sku-map.json",
          "docType": "scenario-sku-map",
          "required": true
        }
      ],
      "packages": [
        {
          "id": "skus",
          "path": "skus/",
          "packageType": "catalog-registry",
          "requiredFiles": ["base/business.md", "base/lifestyle.md"],
          "entryPattern": "*/*.md",
          "minimumEntries": 1
        },
        {
          "id": "revenue-lines",
          "path": "revenue-lines/",
          "packageType": "catalog-registry",
          "requiredFiles": ["README.md"],
          "entryPattern": "*.md",
          "minimumEntries": 1
        },
        {
          "id": "channels",
          "path": "channels/",
          "packageType": "catalog-registry",
          "requiredFiles": ["README.md"],
          "entryPattern": "*.md",
          "minimumEntries": 1
        }
      ]
    },
    {
      "id": "strategy",
      "path": "strategy/",
      "documents": [
        {
          "path": "README.md",
          "docType": "strategy-hub",
          "required": true,
          "validation": {
            "requiredHeadings": ["Strategy Documents", "Extension Rules"]
          }
        },
        {
          "path": "STRATEGY.md",
          "docType": "monetization-strategy",
          "required": true
        },
        {
          "path": "TIERS.md",
          "docType": "delivery-tiers",
          "required": true
        },
        {
          "path": "PRICING.md",
          "docType": "pricing-strategy",
          "required": true
        },
        {
          "path": "FUNNEL.md",
          "docType": "funnel-strategy",
          "required": true
        }
      ]
    },
    {
      "id": "evidence",
      "path": "evidence/",
      "documents": [
        {
          "path": "README.md",
          "docType": "evidence-hub",
          "required": true
        },
        {
          "path": "FINANCIAL_MODEL.md",
          "docType": "financial-model",
          "required": true
        },
        {
          "path": "BENCHMARKS.md",
          "docType": "benchmarks",
          "required": true
        },
        {
          "path": "TELEMETRY_ROADMAP.md",
          "docType": "telemetry-roadmap",
          "required": true
        }
      ]
    },
    {
      "id": "governance",
      "path": "governance/",
      "documents": [
        {
          "path": "editing.md",
          "docType": "editing-rules",
          "required": true,
          "validation": {
            "requiredHeadings": ["Authority", "Change Flow", "Direct Edits"]
          }
        },
        {
          "path": "adoption-validation.md",
          "docType": "validation-runbook",
          "required": true,
          "validation": {
            "requiredHeadings": ["Validation Commands", "Expected Clean State", "Enforcement Scope"]
          }
        },
        {
          "path": "changelog.md",
          "docType": "por-changelog",
          "required": true,
          "validation": {
            "requiredHeadings": ["Changelog"]
          }
        },
        {
          "path": "HOW_TO_GATHER_INPUTS.md",
          "docType": "operator-input-guidance",
          "required": true
        }
      ]
    }
  ],
  "extensionRule": "Monetization durable canon must live under operating/, taxonomies/, catalogs/, strategy/, evidence/, governance/, or a declared extensions/<extension-id>/ package. Do not add top-level canon files without updating this manifest."
}
