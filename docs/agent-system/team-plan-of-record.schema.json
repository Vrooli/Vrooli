{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrooli.com/schemas/prompt-manager/team-plan-of-record.schema.json",
  "title": "Team Plan of Record Manifest",
  "description": "Manifest contract for prompt-manager team plan-of-record folders.",
  "type": "object",
  "required": ["version", "contract", "sections"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "contract": {
      "type": "object",
      "required": ["kind", "schema"],
      "properties": {
        "kind": {
          "type": "string",
          "const": "team-plan-of-record"
        },
        "schema": {
          "type": "string",
          "const": "team-plan-of-record/v1"
        },
        "base": {
          "$ref": "#/$defs/relativePath"
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "extensionRule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "extensionRule": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "required": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "packageType": {
          "$ref": "#/$defs/packageType"
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "optionalFolders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "docType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "required": {
          "type": "boolean"
        },
        "validation": {
          "$ref": "#/$defs/documentValidation"
        }
      },
      "additionalProperties": false
    },
    "documentValidation": {
      "type": "object",
      "properties": {
        "requiredHeadings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredLinks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "packageType": {
          "$ref": "#/$defs/packageType"
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "optionalFolders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "entryPattern": {
          "type": "string",
          "minLength": 1
        },
        "minimumEntries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "packageType": {
      "type": "string",
      "enum": [
        "taxonomy",
        "method-registry",
        "catalog-registry",
        "strategy-package",
        "evidence-package",
        "extension"
      ]
    }
  }
}
