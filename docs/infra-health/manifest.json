{
  "version": "1.0.0",
  "title": "Infra Health Plan of Record",
  "description": "Plan-of-record manifest for the infra-health team canon",
  "contract": {
    "kind": "team-plan-of-record",
    "schema": "team-plan-of-record/v1",
    "base": "docs/agent-system/team-plan-of-record.manifest.json",
    "team": "infra-health"
  },
  "sections": [
    {
      "id": "entrypoint",
      "path": ".",
      "documents": [
        {
          "path": "README.md",
          "docType": "por-readme",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Start here for agents",
              "Folder map",
              "Organizing principle",
              "Editing rules",
              "Cross-references",
              "Future PoR work"
            ]
          }
        }
      ]
    },
    {
      "id": "operating",
      "path": "operating/",
      "documents": [
        {
          "path": "README.md",
          "docType": "operating-hub",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Operating Documents",
              "Validation"
            ]
          }
        },
        {
          "path": "OPERATING_MODEL.md",
          "docType": "operating-model",
          "required": true
        }
      ]
    },
    {
      "id": "strategy",
      "path": "strategy/",
      "documents": [
        {
          "path": "README.md",
          "docType": "strategy-hub",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Strategy Documents",
              "Extension Rules"
            ]
          }
        }
      ]
    },
    {
      "id": "evidence",
      "path": "evidence/",
      "documents": [
        {
          "path": "README.md",
          "docType": "evidence-hub",
          "required": true
        }
      ]
    },
    {
      "id": "governance",
      "path": "governance/",
      "documents": [
        {
          "path": "editing.md",
          "docType": "editing-rules",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Authority",
              "Change Flow",
              "Direct Edits"
            ]
          }
        },
        {
          "path": "adoption-validation.md",
          "docType": "validation-runbook",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Validation Commands",
              "Expected Clean State",
              "Enforcement Scope"
            ]
          }
        },
        {
          "path": "changelog.md",
          "docType": "por-changelog",
          "required": true,
          "validation": {
            "requiredHeadings": [
              "Changelog"
            ]
          }
        }
      ]
    }
  ],
  "extensionRule": "Infra-health durable canon must live under operating/, evidence/, governance/, or a declared extensions/<extension-id>/ package. Reliability targets, sensor maps, instrumentation gaps and cross-platform debt are owned by the instrument scenario and must not be re-added here. Do not add top-level canon files without updating this manifest.",
  "instrument": {
    "scenario": "infrastructure-manager",
    "role": "The team's instrument. It owns the reliability setpoint, the projection cell grid, trust-qualified readings and the ranked error surface.",
    "readSurfaces": [
      "infrastructure-manager coverage status|cells|open-loop|validate|drift",
      "infrastructure-manager condition status|trust|explain|history",
      "infrastructure-manager focus next|finding|sources|efficacy"
    ],
    "rule": "Durable reliability targets, sensor definitions, instrumentation gaps and cross-platform debt belong to the instrument, not to this plan of record. This folder keeps the operating contract and the governance rules; it does not restate what the instrument or the control plane computes."
  }
}
