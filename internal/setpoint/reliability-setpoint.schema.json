{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reliability Setpoint",
  "description": "The bar every host-pressure sensor grades against. internal/setpoint is the only parser: this schema checks shape; the parser enforces the invariants (unique cell_ref, a reason on every ungradeable bar, a unit and a threshold on every gradeable bar, the authored sustain).",
  "type": "object",
  "required": [
    "schema_version",
    "bars"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "confidence": {
      "type": "object",
      "required": [
        "level",
        "rationale",
        "recorded_on"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "SKETCH",
            "DRAFT",
            "RATIFIED"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "recorded_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "constants": {
      "type": "object"
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell_ref",
          "decision_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cell_ref": {
            "type": "string",
            "pattern": "^[a-z-]+/[A-Z]+[0-9]+$"
          },
          "projection": {
            "type": "string",
            "minLength": 1
          },
          "target_kind": {
            "type": "string",
            "minLength": 1
          },
          "deadband": {
            "type": "string"
          },
          "sustain": {
            "type": "string",
            "minLength": 1
          },
          "actuator": {
            "type": "string",
            "minLength": 1
          },
          "decision_ref": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "gradeable": {
            "type": "boolean"
          },
          "not_gradeable_reason": {
            "type": "string"
          },
          "ratification_note": {
            "type": "string"
          }
        }
      }
    },
    "unmapped": {
      "type": "array"
    }
  }
}
