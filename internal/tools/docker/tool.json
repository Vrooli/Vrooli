{
  "$schema": "../../../.vrooli/schemas/tool.schema.json",
  "name": "docker",
  "description": "Container runtime for running resources and services",
  "commands": ["docker"],
  "versionArgs": ["--version"],
  "defaultPackage": "docker.io",
  "packages": {
    "brew": "docker",
    "winget": "Docker.DockerDesktop",
    "dnf": "docker",
    "pacman": "docker",
    "apk": "docker"
  },
  "installHint": "Install Docker Engine or Docker Desktop",
  "platforms": ["linux", "macos", "windows"],
  "healthCheck": {
    "command": "docker",
    "args": ["info"],
    "expectExitCode": 0
  }
}
