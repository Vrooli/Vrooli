{
  "$schema": "../../../.vrooli/schemas/tool.schema.json",
  "name": "cloudflared",
  "description": "Cloudflare Tunnel client for exposing local services via secure tunnels",
  "commands": [
    "cloudflared"
  ],
  "versionArgs": [
    "--version"
  ],
  "handler": "cloudflared",
  "packages": {
    "brew": "cloudflare/cloudflare/cloudflared",
    "winget": "Cloudflare.cloudflared"
  },
  "installHint": "Install cloudflared from https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "bundling": "host-required"
}
