{
  "$schema": "../../../.vrooli/schemas/tool.schema.json",
  "name": "go",
  "description": "Pinned Go programming language toolchain used to build and validate Vrooli",
  "storage": {
    "entries": {
      "build_cache": {
        "rung": "relocatable",
        "path": "$USER_CACHE_DIR/go-build",
        "kind": "dir",
        "regenerable": true,
        "relocation": {
          "key": "GOCACHE",
          "scope": "process-tree"
        },
        "budget": {
          "max_bytes": "182584MiB",
          "rationale": "Measured at 95726583590 bytes on 2026-08-03; ceiling is two times observed size."
        },
        "rationale": "Rebuildable compiler cache."
      },
      "module_cache": {
        "rung": "relocatable",
        "path": "$USER_HOME/go/pkg/mod",
        "kind": "dir",
        "regenerable": true,
        "relocation": {
          "key": "GOMODCACHE",
          "scope": "process-tree"
        },
        "budget": {
          "max_bytes": "37562MiB",
          "rationale": "Measured at 19693299103 bytes on 2026-08-03; ceiling is two times observed size."
        },
        "rationale": "Go's default module cache is GOPATH/pkg/mod; this declaration describes the default user GOPATH location and can be overridden with GOMODCACHE."
      }
    }
  },
  "commands": [
    "go"
  ],
  "versionArgs": [
    "version"
  ],
  "version": "1.26.0",
  "installHint": "Managed as an exact, checksum-verified Go release in ~/.vrooli/opt/go. It is the workspace Go toolchain source of truth; do not substitute an OS package version.",
  "notes": "The root go.mod toolchain directive and GitHub workflows consume this manifest's exact release. The go directive remains the module language/API compatibility floor.",
  "bundling": "vendorable",
  "capability": "runtime-language",
  "capability_role": "primary",
  "acquisition": {
    "kind": "url",
    "targets": [
      {
        "when": {
          "os": "linux",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.26.0.linux-amd64.tar.gz",
        "sha256": "aac1b08a0fb0c4e0a7c1555beb7b59180b05dfc5a3d62e40e9de90cd42f88235",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "linux",
          "arch": "arm64"
        },
        "url": "https://go.dev/dl/go1.26.0.linux-arm64.tar.gz",
        "sha256": "bd03b743eb6eb4193ea3c3fd3956546bf0e3ca5b7076c8226334afe6b75704cd",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "darwin",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.26.0.darwin-amd64.tar.gz",
        "sha256": "1ca28b7703cbea05a65b2a1d92d6b308610ef92f8824578a0874f2e60c9d5a22",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "darwin",
          "arch": "arm64"
        },
        "url": "https://go.dev/dl/go1.26.0.darwin-arm64.tar.gz",
        "sha256": "b1640525dfe68f066d56f200bef7bf4dce955a1a893bd061de6754c211431023",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "windows",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.26.0.windows-amd64.zip",
        "sha256": "9bbe0fc64236b2b51f6255c05c4232532b8ecc0e6d2e00950bd3021d8a4d07d4",
        "archive": "zip",
        "layout": "dir",
        "bin_path": "go/bin/go.exe",
        "runtime_env": {
          "GOROOT": "go"
        }
      }
    ]
  },
  "platform_status": {
    "linux": {
      "status": "unqualified",
      "evidence": null
    },
    "macos": {
      "status": "unqualified",
      "evidence": null
    },
    "windows": {
      "status": "unqualified",
      "evidence": null
    }
  }
}
