{
  "$schema": "../../../.vrooli/schemas/tool.schema.json",
  "name": "go",
  "description": "Pinned Go programming language toolchain used to build and validate Vrooli",
  "storage": {
    "entries": {
      "build_cache": {
        "rung": "relocatable",
        "path": "$USER_CACHE_DIR/go-build",
        "kind": "dir",
        "regenerable": true,
        "relocation": {
          "key": "GOCACHE",
          "scope": "process-tree"
        },
        "budget": {
          "max_bytes": "182584MiB",
          "rationale": "Measured at 95726583590 bytes on 2026-08-03; ceiling is two times observed size."
        },
        "rationale": "Rebuildable compiler cache."
      },
      "module_cache": {
        "rung": "relocatable",
        "path": "$USER_HOME/go/pkg/mod",
        "kind": "dir",
        "regenerable": true,
        "relocation": {
          "key": "GOMODCACHE",
          "scope": "process-tree"
        },
        "budget": {
          "max_bytes": "37562MiB",
          "rationale": "Measured at 19693299103 bytes on 2026-08-03; ceiling is two times observed size."
        },
        "rationale": "Go's default module cache is GOPATH/pkg/mod; this declaration describes the default user GOPATH location and can be overridden with GOMODCACHE."
      }
    }
  },
  "commands": [
    "go"
  ],
  "versionArgs": [
    "version"
  ],
  "version": "1.25.12",
  "installHint": "Managed as an exact, checksum-verified Go release in ~/.vrooli/opt/go. It is the workspace Go toolchain source of truth; do not substitute an OS package version.",
  "notes": "The root go.mod toolchain directive and GitHub workflows consume this manifest's exact release. The go directive remains the module language/API compatibility floor.",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "bundling": "vendorable",
  "capability": "runtime-language",
  "capability_role": "primary",
  "acquisition": {
    "kind": "url",
    "targets": [
      {
        "when": {
          "os": "linux",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.25.12.linux-amd64.tar.gz",
        "sha256": "234828b7a89e0e303d2556310ee549fbcf253d28de937bac3da13d6294262ac1",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "linux",
          "arch": "arm64"
        },
        "url": "https://go.dev/dl/go1.25.12.linux-arm64.tar.gz",
        "sha256": "8b5884aef89600aef5b0b051fb971f11f49bb996521e911f30f02a66884f7bd2",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "darwin",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.25.12.darwin-amd64.tar.gz",
        "sha256": "00a2e743b82bccec03c51c4b0f7e46d5fec52184075fd6c5183c3bb39ae9fb00",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "darwin",
          "arch": "arm64"
        },
        "url": "https://go.dev/dl/go1.25.12.darwin-arm64.tar.gz",
        "sha256": "fa2c88bbcf64bd3b2aef355f026cfec6d3a4a01c132f999c8f8c964eb767164f",
        "archive": "tar.gz",
        "layout": "dir",
        "bin_path": "go/bin/go",
        "runtime_env": {
          "GOROOT": "go"
        }
      },
      {
        "when": {
          "os": "windows",
          "arch": "amd64"
        },
        "url": "https://go.dev/dl/go1.25.12.windows-amd64.zip",
        "sha256": "d5dc82da351b00e5eedd04f41356817d674cc4308131f0f638a5b14c5c3af4cb",
        "archive": "zip",
        "layout": "dir",
        "bin_path": "go/bin/go.exe",
        "runtime_env": {
          "GOROOT": "go"
        }
      }
    ]
  },
  "platform_status": {
    "linux": {
      "status": "unqualified",
      "evidence": "Manifest-declared applicability; no host-sampled qualification recorded."
    },
    "macos": {
      "status": "unqualified",
      "evidence": "Manifest-declared applicability; no host-sampled qualification recorded."
    },
    "windows": {
      "status": "unqualified",
      "evidence": "Manifest-declared applicability; no host-sampled qualification recorded."
    }
  }
}
