{
  "$schema": "../../../../.vrooli/schemas/safeguard.schema.json",
  "name": "pstore_observability",
  "description": "Export privileged pstore crash artifacts into a Vrooli read-only host-observability directory for unprivileged scenarios",
  "handler": "pstore_observability",
  "platforms": ["linux"],
  "risk": "medium",
  "verificationCheck": {
    "files": [
      "/usr/local/libexec/vrooli/pstore-collector",
      "/etc/systemd/system/vrooli-pstore-collector.service",
      "/etc/systemd/system/vrooli-pstore-collector.timer"
    ]
  }
}

